diff --git a/src/lib/shell/pipe_exec/job_control.rs b/src/lib/shell/pipe_exec/job_control.rs
index 96a8ef71..37e7b7bd 100644
--- a/src/lib/shell/pipe_exec/job_control.rs
+++ b/src/lib/shell/pipe_exec/job_control.rs
@@ -318,7 +318,11 @@ impl<'a> Shell<'a> {
                         } else {
                             let _ = self.handle_signal(signal);
                         }
-                        signaled = Some(PipelineError::Interrupted(pid, signal));
+                        signaled = Some(if signal == Signal::SIGKILL && killed_by_oom(pid) {
+                            PipelineError::OutOfMemory(pid)
+                        } else {
+                            PipelineError::Interrupted(pid, signal)
+                        });
                     }
                 }
                 Ok(WaitStatus::Stopped(pid, signal)) => {
@@ -383,3 +387,26 @@ impl<'a> Shell<'a> {
         status
     }
 }
+
+/// Whether the kernel ended `pid` because memory ran out: Redox lists such
+/// processes in /scheme/proc/oom, one "<seq> <pid> <uid> <name>" line each.
+#[cfg(target_os = "redox")]
+fn killed_by_oom(pid: Pid) -> bool {
+    use std::{io::Read, os::unix::fs::OpenOptionsExt};
+    // One read returns every line kept so far (at most 16), each
+    // "<seq> <pid> <uid> <name>"; the read never waits.
+    let mut buf = [0u8; 4096];
+    let len = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(nix::fcntl::OFlag::O_NONBLOCK.bits())
+        .open("/scheme/proc/oom")
+        .and_then(|mut file| file.read(&mut buf))
+        .unwrap_or(0);
+    let pid = pid.to_string();
+    String::from_utf8_lossy(&buf[..len])
+        .lines()
+        .any(|line| line.split_whitespace().nth(1) == Some(pid.as_str()))
+}
+
+#[cfg(not(target_os = "redox"))]
+fn killed_by_oom(_pid: Pid) -> bool { false }
diff --git a/src/lib/shell/pipe_exec/mod.rs b/src/lib/shell/pipe_exec/mod.rs
index eb03ff22..5bd4002d 100644
--- a/src/lib/shell/pipe_exec/mod.rs
+++ b/src/lib/shell/pipe_exec/mod.rs
@@ -93,6 +93,9 @@ pub enum PipelineError {
     /// A signal interrupted a child process
     #[error("process ({0}) ended by signal {1}")]
     Interrupted(Pid, Signal),
+    /// The kernel ended a child process because memory ran out
+    #[error("Killed: out of memory (process {0})")]
+    OutOfMemory(Pid),
     /// A subprocess had a core dump
     #[error("process ({0}) had a core dump")]
     CoreDump(Pid),
