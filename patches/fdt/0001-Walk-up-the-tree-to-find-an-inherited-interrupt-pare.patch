+static INTERRUPT_PARENT: &[u8] = include_bytes!("../dtb/interrupt-parent.dtb");
 
 #[test]
 fn returns_fdt() {
@@ -491,3 +492,16 @@ fn node_pretty_print() {
 
     assert_eq!(std::string::ToString::to_string(&cpu), expected);
 }
+
+#[test]
+fn inherited_interrupt_parent() {
+    let fdt = Fdt::new_unaligned(INTERRUPT_PARENT).unwrap();
+    let gpio = fdt.find_node("/soc/gpio@2000").unwrap();
+    let interrupts = match gpio.property::<Interrupts<_>>().unwrap() {
+        Interrupts::Legacy(legacy) => legacy,
+        _ => unreachable!(),
+    };
+
+    assert_eq!(interrupts.interrupt_parent().name().name, "interrupt-controller");
+    assert_eq!(interrupts.iter().count(), 2);
+}
