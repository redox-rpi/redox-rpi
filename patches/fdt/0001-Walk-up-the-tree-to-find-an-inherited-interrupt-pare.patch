diff --git a/dtb/interrupt-parent.dts b/dtb/interrupt-parent.dts
new file mode 100644
index 0000000..712658e
--- /dev/null
+++ b/dtb/interrupt-parent.dts
@@ -0,0 +1,29 @@
+/dts-v1/;
+
+/* Interrupt parent inherited through a plain bus node, like on the
+ * Raspberry Pi 3 where `/soc` has no `#interrupt-cells`. */
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&intc>;
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		intc: interrupt-controller@1000 {
+			reg = <0x1000 0x100>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio@2000 {
+			reg = <0x2000 0x100>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <2 17>, <2 18>;
+		};
+	};
+};
diff --git a/src/properties/interrupts.rs b/src/properties/interrupts.rs
index 642a579..d147c8e 100644
--- a/src/properties/interrupts.rs
+++ b/src/properties/interrupts.rs
@@ -355,14 +355,60 @@ impl<'a, P: ParserWithMode<'a>> core::ops::DerefMut for InterruptParent<'a, P> {
 
 impl<'a, P: ParserWithMode<'a>> Property<'a, P> for InterruptParent<'a, P> {
     fn parse(node: FallibleNode<'a, P>, root: FallibleRoot<'a, P>) -> Result<Option<Self>, FdtError> {
-        match node.properties()?.find("interrupt-parent")? {
-            Some(phandle) => match root.resolve_phandle(PHandle(phandle.as_value()?))? {
-                Some(parent) => Ok(Some(Self(parent.alt()))),
-                None => Err(FdtError::MissingPHandleNode(phandle.as_value()?)),
-            },
-            None => Ok(node.parent().map(|n| Self(n.alt()))),
+        // Like Linux's `of_irq_find_parent`: follow `interrupt-parent` links
+        // and devicetree parents until reaching a node with
+        // `#interrupt-cells`. The devicetree parent itself is often a plain
+        // bus node (e.g. `soc`) that only inherits `interrupt-parent` from
+        // further up the tree.
+        let mut current = node;
+        for _ in 0..MAX_INTERRUPT_PARENT_DEPTH {
+            let next = match current.properties()?.find("interrupt-parent")? {
+                Some(phandle) => match root.resolve_phandle(PHandle(phandle.as_value()?))? {
+                    Some(parent) => parent,
+                    None => return Err(FdtError::MissingPHandleNode(phandle.as_value()?)),
+                },
+                None => match current.parent() {
+                    // `parent()` does not know its own parent, so look the
+                    // node up again to be able to keep walking up the tree.
+                    Some(parent) => match find_node_with_parent::<P>(root, parent)? {
+                        Some(parent) => parent,
+                        None => return Ok(None),
+                    },
+                    None => return Ok(None),
+                },
+            };
+
+            if next.property::<InterruptCells>()?.is_some() {
+                return Ok(Some(Self(next.alt())));
+            }
+
+            current = next;
+        }
+
+        Ok(None)
+    }
+}
+
+/// Upper bound for the `interrupt-parent` walk, guards against phandle cycles.
+const MAX_INTERRUPT_PARENT_DEPTH: usize = 64;
+
+fn find_node_with_parent<'a, P: ParserWithMode<'a>>(
+    root: FallibleRoot<'a, P>,
+    target: FallibleNode<'a, P>,
+) -> Result<Option<FallibleNode<'a, P>>, FdtError> {
+    // `all_nodes()` does not yield the root node itself.
+    if core::ptr::eq(root.node.this, target.this) {
+        return Ok(Some(root.node.alt()));
+    }
+
+    for node in root.all_nodes()? {
+        let (_, node) = node?;
+        if core::ptr::eq(node.this, target.this) {
+            return Ok(Some(node));
         }
     }
+
+    Ok(None)
 }
 
