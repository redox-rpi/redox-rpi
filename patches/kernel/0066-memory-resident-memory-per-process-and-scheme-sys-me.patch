+use crate::{
+    context,
+    context::{contexts, memory::AddrSpace},
+    memory::{get_page_info, Frame, RefCount, RmmA, PAGE_SIZE},
+    sync::CleanLockToken,
+    syscall::error::Result,
+};
+use rmm::{Arch, PageTable};
+
+/// Memory of one address space, in bytes.
+#[derive(Clone, Copy, Default)]
+pub struct Usage {
+    /// Resident pages mapped only here.
+    pub private: usize,
+    /// Resident pages also mapped elsewhere: copy on write after fork, shared memory, file pages.
+    pub shared: usize,
+    /// Mapped physical memory with no page frame of its own, such as device registers.
+    pub phys: usize,
+    /// Page tables of the user half.
+    pub tables: usize,
+    /// Size of all grants except physical ones (the old PRIVATE + SHARED).
+    pub virt: usize,
+}
+
+/// Count what the address space has in memory, by walking its page tables.
+pub fn usage(addr_space: &AddrSpace) -> Usage {
+    let mut usage = Usage::default();
+    for (_base, info) in addr_space.grants.iter() {
+        if !matches!(info.provider, context::memory::Provider::PhysBorrowed { .. }) {
+            usage.virt += info.page_count() * PAGE_SIZE;
+        }
+    }
+    // SAFETY: the caller holds the address space lock, so no table is freed during the walk.
+    unsafe { walk(addr_space.table.utable.table(), &mut usage) };
+    usage
+}
+
+unsafe fn walk(table: PageTable<RmmA>, usage: &mut Usage) {
+    usage.tables += PAGE_SIZE;
+    for i in 0..RmmA::PAGE_ENTRIES {
+        match table.entry_base(i) {
+            Some(base) if base.data() < crate::USER_END_OFFSET => {}
+            _ => break,
+        }
+        let Some(entry) = (unsafe { table.entry(i) }) else {
+            break;
+        };
+        if !entry.present() {
+            continue;
+        }
+        if table.level() > 0 {
+            if let Some(next) = unsafe { table.next(i) } {
+                unsafe { walk(next, usage) };
+            }
+            continue;
+        }
+        let Ok(phys) = entry.address() else {
+            continue;
+        };
+        match get_page_info(Frame::containing(phys)).and_then(|info| info.refcount()) {
+            Some(RefCount::One) => usage.private += PAGE_SIZE,
+            Some(_) => usage.shared += PAGE_SIZE,
+            None => usage.phys += PAGE_SIZE,
+        }
+    }
+}
 
