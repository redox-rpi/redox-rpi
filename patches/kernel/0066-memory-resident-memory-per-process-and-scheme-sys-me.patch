new file mode 100644
index 00000000..6105f579
--- /dev/null
+++ b/src/scheme/sys/memory.rs
@@ -0,0 +1,74 @@
+use alloc::vec::Vec;
+
+use super::context::{usage, Usage};
+use crate::{
+    allocator::Allocator,
+    context::contexts,
+    memory::{free_frames, total_frames, used_frames, PAGE_SIZE},
+    sync::CleanLockToken,
+    syscall::error::Result,
+};
+
+/// Where the memory goes, in kB, one "name: value kB" line each.
+pub fn resource(token: &mut CleanLockToken) -> Result<Vec<u8>> {
+    let mut kernel_stacks = 0;
+    let mut sum = Usage::default();
+    let mut processes = 0;
+    let mut seen: Vec<usize> = Vec::new();
+    {
+        let mut contexts = contexts(token.downgrade());
+        let (contexts, mut token) = contexts.token_split();
+        for context_ref in contexts.iter() {
+            let context = context_ref.read(token.token());
+            kernel_stacks += context.kfx.len() + context.kstack.len();
+            let addr_space = context.addr_space().cloned();
+            drop(context);
+            let Ok(addr_space) = addr_space else {
+                continue;
+            };
+            let key = alloc::sync::Arc::as_ptr(&addr_space) as usize;
+            if seen.contains(&key) {
+                continue;
+            }
+            seen.push(key);
+            let guard = addr_space.acquire_read(token.downgrade());
+            let one = usage(&guard);
+            drop(guard);
+            processes += 1;
+            sum.private += one.private;
+            sum.shared += one.shared;
+            sum.phys += one.phys;
+            sum.tables += one.tables;
+            sum.virt += one.virt;
+        }
+    }
+    let (heap_size, heap_used) = Allocator::stats();
+    let kb = |bytes: usize| bytes / 1024;
+    let text = format!(
+        "MemTotal: {} kB\n\
+         MemUsed: {} kB\n\
+         MemFree: {} kB\n\
+         KernelHeap: {} kB\n\
+         KernelHeapUsed: {} kB\n\
+         KernelStacks: {} kB\n\
+         PageTables: {} kB\n\
+         UserPrivate: {} kB\n\
+         UserShared: {} kB\n\
+         UserPhys: {} kB\n\
+         UserVirtual: {} kB\n\
+         AddressSpaces: {}\n",
+        kb(total_frames() * PAGE_SIZE),
+        kb(used_frames() * PAGE_SIZE),
+        kb(free_frames() * PAGE_SIZE),
+        kb(heap_size),
+        kb(heap_used),
+        kb(kernel_stacks),
+        kb(sum.tables),
+        kb(sum.private),
+        kb(sum.shared),
+        kb(sum.phys),
+        kb(sum.virt),
+        processes,
+    );
+    Ok(text.into_bytes())
+}
