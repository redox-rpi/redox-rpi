From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 23 Nov 2026 19:34:04 +0000
Subject: [PATCH] memory: out of memory with only root processes left kills the
 faulting process, not the kernel

Upstream's OOM handler (3637aa20) kills the newest non-root process and
panics with todo!("No more context to kill") when there is none, which
is common on our images (redox-rpi#644). Then it now marks every thread
of the faulting process as SIGKILLed and ends the current thread; a
usercopy inside a syscall fails with EFAULT.

A thread that is being SIGKILLed no longer blocks in a WaitCondition: a
kill that came while the thread was running (e.g. spinning on the pipe
lock the faulting thread held) left it blocked for good, so its process
never ended and its memory stayed in use.
---
 src/memory/mod.rs          | 53 +++++++++++++++++++++++++++++++++++++-
 src/sync/wait_condition.rs | 10 +++++++
 2 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/src/memory/mod.rs b/src/memory/mod.rs
index f99eff08..e047bc54 100644
--- a/src/memory/mod.rs
+++ b/src/memory/mod.rs
@@ -1427,7 +1427,17 @@ pub fn page_fault_handler(
                 Ok(()) => return Ok(()),
                 Err(PfError::Oom) => {
                     let Some(ctx_lock) = find_newest_killable_context(&mut token) else {
-                        todo!("No more context to kill");
+                        // Only root processes are left: end the process that
+                        // faulted, not the kernel (redox-rpi#644).
+                        oom_kill_current_process(&mut token);
+                        if caused_by_kernel {
+                            // A usercopy inside a syscall: the syscall fails
+                            // with EFAULT and the thread exits when it returns.
+                            stack.recover_and_efault();
+                            return Ok(());
+                        }
+                        // A fault in user mode holds no kernel references.
+                        crate::syscall::exit_this_context(None, &mut token);
                     };
                     let mut ctx_guard = ctx_lock.write(token.token());
                     error!(
@@ -1480,6 +1490,47 @@ fn find_newest_killable_context(token: &mut CleanLockToken) -> Option<Arc<Contex
     newest_ctx
 }
 
+/// Mark every thread of the current process as SIGKILLed, as a kill
+/// through the proc scheme does. The other threads exit when they next run;
+/// the caller ends the current thread. Allocates nothing.
+fn oom_kill_current_process(token: &mut CleanLockToken) {
+    let current = context::current();
+    let pid = {
+        let mut guard = current.write(token.token());
+        error!(
+            "OUT OF MEMORY: killing PID {} NAME {} on CPU #{}",
+            guard.pid,
+            guard.name,
+            crate::cpu_id()
+        );
+        guard.being_sigkilled = true;
+        guard.pid
+    };
+    crate::percpu::PercpuBlock::current()
+        .switch_internals
+        .being_sigkilled
+        .set(true);
+
+    let mut contexts_guard = context::contexts(token.downgrade());
+    let (contexts, mut token) = contexts_guard.token_split();
+    for context_ref in contexts.iter() {
+        let context_lock = &context_ref.0;
+        if Arc::ptr_eq(context_lock, &current) {
+            continue;
+        }
+        let cpu_id = {
+            let mut ctxt = context_lock.write(token.token());
+            if ctxt.pid != pid || ctxt.status.is_dead() || ctxt.being_sigkilled {
+                continue;
+            }
+            ctxt.status = context::Status::Runnable;
+            ctxt.being_sigkilled = true;
+            ctxt.cpu_id
+        };
+        context::wakeup_context(context_lock, cpu_id, &mut token.downgrade());
+    }
+}
+
 static THE_ZEROED_FRAME: SyncUnsafeCell<Option<(Frame, &'static PageInfo)>> =
     SyncUnsafeCell::new(None);
 
diff --git a/src/sync/wait_condition.rs b/src/sync/wait_condition.rs
index f1f889ca..10eb83a2 100644
--- a/src/sync/wait_condition.rs
+++ b/src/sync/wait_condition.rs
@@ -80,6 +80,16 @@ impl WaitCondition {
             let mut token = token.token();
             {
                 let context = current_context_ref.upgradeable_read(token.token());
+                // A thread that is being SIGKILLed (by the OOM killer, or a kill
+                // that came while it was not blocked) must not block again: it
+                // would never wake, and its process never ends (redox-rpi#644).
+                if context.being_sigkilled {
+                    crate::percpu::PercpuBlock::current()
+                        .switch_internals
+                        .being_sigkilled
+                        .set(true);
+                    return false;
+                }
                 if let Some((control, pctl, _)) = context.sigcontrol()
                     && control.currently_pending_unblocked(pctl) != 0
                 {
-- 
2.53.0

