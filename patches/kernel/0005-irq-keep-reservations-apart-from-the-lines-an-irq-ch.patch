From f77436fe7107d134cbdf03fc19838ad02278106c Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Tue, 27 Oct 2026 09:28:06 +0100
Subject: [PATCH 5/6] irq: keep reservations apart from the lines an irq chip
 has

All aarch64 irq chips set `used` for each of their lines at init, and
the irq scheme read the same flag as "reserved", so opening any line
through /scheme/irq/phandle-* failed with EEXIST. Track reservations in
their own flag; a line with a kernel handler counts as taken.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dtb/irqchip.rs | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/dtb/irqchip.rs b/src/dtb/irqchip.rs
index b320d1f..f591df3 100644
--- a/src/dtb/irqchip.rs
+++ b/src/dtb/irqchip.rs
@@ -81,7 +81,8 @@ pub struct IrqDescItem {
     pub ic_idx: usize,               //ic idx in irq chip list
     pub child_ic_idx: Option<usize>, //ic idx in irq chip list
     pub ic_irq: u32,                 //hwirq in ic
-    pub used: bool,
+    pub used: bool,                  //exists in its ic
+    pub reserved: bool,              //opened through the irq scheme
 }
 
 pub struct IrqDesc {
@@ -376,6 +377,7 @@ const INIT_IRQ_DESC: IrqDesc = IrqDesc {
         ic_irq: 0,
         child_ic_idx: None,
         used: false,
+        reserved: false,
     },
     handler: INIT_HANDLER,
 };
@@ -409,13 +411,16 @@ pub fn register_irq(virq: u32, handler: Box<dyn InterruptHandler>) {
 
 #[inline]
 pub fn is_reserved(_cpu_id: LogicalCpuId, index: u8) -> bool {
-    unsafe { IRQ_CHIP.irq_desc[index as usize].basic.used }
+    // `used` only says that the line exists: the irq chips set it for all
+    // their lines at init, which made every line look taken.
+    let desc = unsafe { &IRQ_CHIP.irq_desc[index as usize] };
+    !desc.basic.used || desc.basic.reserved || desc.handler.is_some()
 }
 
 #[inline]
 pub fn set_reserved(_cpu_id: LogicalCpuId, index: u8, reserved: bool) {
     unsafe {
-        IRQ_CHIP.irq_desc[index as usize].basic.used = reserved;
+        IRQ_CHIP.irq_desc[index as usize].basic.reserved = reserved;
         if reserved {
             IRQ_CHIP.irq_enable(index as u32);
         } else {
