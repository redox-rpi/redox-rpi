+const LOCAL_MAILBOX_CORE_STRIDE: u32 = 0x10;
 
-const LOCAL_IRQ_CNTPNSIRQ: u32 = 0x1;
+const LOCAL_IRQ_CNTVIRQ: u32 = 0x3;
+const LOCAL_IRQ_MAILBOX0: u32 = 0x4;
 const LOCAL_IRQ_GPU_FAST: u32 = 0x8;
 const LOCAL_IRQ_PMU_FAST: u32 = 0x9;
 const LOCAL_IRQ_LAST: u32 = LOCAL_IRQ_PMU_FAST;
 
+/// Number of cores served by the local interrupt controller.
+const CPU_COUNT: usize = 4;
+
+/// Virtual base address of the controller, 0 until it is initialized.
+static BASE: AtomicUsize = AtomicUsize::new(0);
+
+fn current_cpu() -> u32 {
+    let mpidr: usize;
+    unsafe { asm!("mrs {}, mpidr_el1", out(reg) mpidr) };
+    mpidr as u32 & 0x3
+}
+
+fn read_reg(base: usize, reg: u32) -> u32 {
+    unsafe { read_volatile((base + reg as usize) as *const u32) }
+}
+
+fn write_reg(base: usize, reg: u32, value: u32) {
+    unsafe { write_volatile((base + reg as usize) as *mut u32, value) }
+}
+
+fn active_base() -> Result<usize> {
+    match BASE.load(Ordering::Acquire) {
+        0 => Err(Error::new(ENODEV)),
+        base => Ok(base),
+    }
+}
+
+pub(crate) fn active() -> bool {
+    BASE.load(Ordering::Acquire) != 0
+}
+
+pub(crate) fn cpu_capacity() -> usize {
+    CPU_COUNT
+}
+
+/// Enable IPI delivery to the current core and publish its IPI target mask.
+pub(crate) fn init_current_cpu() -> Result<()> {
+    let base = active_base()?;
+    let cpu = current_cpu();
+    // Discard IPIs that were sent before this core listened.
+    write_reg(
+        base,
+        LOCAL_MAILBOX0_CLR0 + LOCAL_MAILBOX_CORE_STRIDE * cpu,
+        u32::MAX,
+    );
+    write_reg(base, LOCAL_MAILBOX_INT_CONTROL0 + 4 * cpu, 1);
+    crate::percpu::PercpuBlock::current()
+        .misc_arch_info
+        .gic_target_mask
+        .store(1 << cpu, Ordering::Release);
+    Ok(())
+}
+
+/// Route one of the current core's architected timer interrupts to its IRQ.
+pub(crate) fn enable_local_irq(hwirq: u32) -> Result<()> {
+    let base = active_base()?;
+    if hwirq > LOCAL_IRQ_CNTVIRQ {
+        return Err(Error::new(EINVAL));
+    }
+    let reg = LOCAL_TIMER_INT_CONTROL0 + 4 * current_cpu();
+    write_reg(base, reg, read_reg(base, reg) | 1 << hwirq);
+    Ok(())
+}
+
+/// Send IPI number `ipi` through mailbox 0 to every core in `target_mask`,
+/// or to all other cores if no mask is given.
+pub(crate) fn send_ipi(ipi: u8, target_mask: Option<u8>) -> Result<()> {
+    let base = active_base()?;
+    if ipi >= 32 {
+        return Err(Error::new(EINVAL));
+    }
+    let mask = match target_mask {
+        Some(0) => return Err(Error::new(EINVAL)),
+        Some(mask) => mask,
+        None => !(1u8 << current_cpu()),
+    };
+    // Make the data the IPI announces visible before the mailbox write.
+    unsafe { asm!("dsb sy", options(nostack, preserves_flags)) };
+    for cpu in 0..CPU_COUNT as u32 {
+        if mask & (1 << cpu) != 0 {
+            write_reg(
+                base,
+                LOCAL_MAILBOX0_SET0 + LOCAL_MAILBOX_CORE_STRIDE * cpu,
+                1 << ipi,
+            );
+        }
+    }
+    Ok(())
+}
