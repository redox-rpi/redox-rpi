 // PSCI enters the target PE at a physical address with the stage-1 MMU and
-// caches disabled, and passes context_id in x0. This trampoline establishes
+// caches disabled, and passes context_id in x0. Spin-table firmware (Raspberry
+// Pi) jumps to the released address without a context, so CPUs started that
+// way enter at __aarch64_ap_spin_entry, which loads the BootArgs address the
+// BSP stored in the trampoline page right before the release. This trampoline establishes
 // the kernel translation regime and only then enters Rust at a virtual
 // address. Cache invalidation and coherency-domain management belong to the
 // PSCI implementation and are deliberately not duplicated here.
@@ -159,6 +162,17 @@ __aarch64_ap_trampoline_start:
     wfe
     b .Lap_park
 
+    .balign 8
+    .global __aarch64_ap_spin_entry
+__aarch64_ap_spin_entry:
+    ldr x0, __aarch64_ap_spin_args
+    b __aarch64_ap_trampoline_start
+
+    .balign 8
+    .global __aarch64_ap_spin_args
+__aarch64_ap_spin_args:
+    .quad 0
+
     .global __aarch64_ap_trampoline_end
 __aarch64_ap_trampoline_end:
     .previous
@@ -181,12 +195,20 @@ __aarch64_ap_trampoline_end:
 
