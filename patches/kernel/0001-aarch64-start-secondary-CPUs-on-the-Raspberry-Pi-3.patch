     static __aarch64_ap_trampoline_start: u8;
+    static __aarch64_ap_spin_entry: u8;
+    static __aarch64_ap_spin_args: u8;
     static __aarch64_ap_trampoline_end: u8;
 }
 
+/// Offset of a trampoline symbol from the start of the trampoline page.
+fn trampoline_offset(symbol: *const u8) -> usize {
+    symbol as usize - ptr::addr_of!(__aarch64_ap_trampoline_start) as usize
+}
