+/// Release a CPU that firmware parks in a spin-table loop. The CPU wakes on
+/// `sev`, reads its release address and jumps there with the MMU off, so
+/// everything it reads first must be cleaned to the point of coherency.
+fn release_spin_table(resources: &BootResources, slot: &PreparedBootSlot, release_addr: u64) {
+    let trampoline_phys = resources.trampoline.get().base().data();
+    let trampoline_virt = RmmA::phys_to_virt(resources.trampoline.get().base()).data();
+    let args_slot = trampoline_virt + trampoline_offset(ptr::addr_of!(__aarch64_ap_spin_args));
+    unsafe {
+        ptr::write_volatile(args_slot as *mut u64, slot.args.get().base().data() as u64);
+    }
+    clean_data_to_poc(args_slot, size_of::<u64>());
+
+    let entry = trampoline_phys + trampoline_offset(ptr::addr_of!(__aarch64_ap_spin_entry));
+    // The release address lies in memory the firmware reserves for itself,
+    // which is not part of the kernel's linear map.
+    let release_virt = unsafe {
+        crate::memory::map_device_memory(
+            PhysicalAddress::new(release_addr as usize),
+            size_of::<u64>(),
+        )
+    };
+    unsafe {
+        ptr::write_volatile(release_virt.data() as *mut u64, entry as u64);
+        asm!("dsb sy", "sev", options(nostack));
+    }
+}
