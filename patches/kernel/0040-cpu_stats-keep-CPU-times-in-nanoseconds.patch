From fb15c7ebcc88d02acd2358f903671c8aa2df2416 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 30 Oct 2026 07:56:22 +0000
Subject: [PATCH] cpu_stats: keep CPU times in nanoseconds

Each switch added its time in whole milliseconds and dropped the rest, so
a CPU that switches every few microseconds looked almost idle in
sys:stat. Keep nanoseconds and show milliseconds as before. (The first
version of this patch changed only the comments.)

Refs redox-rpi/redox-rpi#23

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/context/switch.rs |  3 +--
 src/cpu_stats.rs      | 27 +++++++++++++++------------
 2 files changed, 16 insertions(+), 14 deletions(-)

diff --git a/src/context/switch.rs b/src/context/switch.rs
index 84013be8..fdd70385 100644
--- a/src/context/switch.rs
+++ b/src/context/switch.rs
@@ -459,8 +459,7 @@ fn schedule(
     // Update per-cpu times
     let percpu_nanos =
         schedule_time.saturating_sub(percpu.switch_internals.schedule_time.get()) as u64;
-    let percpu_ms = percpu_nanos / 1_000_000;
-    let was_idle = percpu.stats.add_time(percpu_ms) == CpuState::Idle as u8;
+    let was_idle = percpu.stats.add_time(percpu_nanos) == CpuState::Idle as u8;
     percpu.switch_internals.schedule_time.set(schedule_time);
 
     let Some((mut next_sched_context, next_address_space)) = select_next_context(
diff --git a/src/cpu_stats.rs b/src/cpu_stats.rs
index aa02fd46..bed5a8d9 100644
--- a/src/cpu_stats.rs
+++ b/src/cpu_stats.rs
@@ -27,13 +27,13 @@ pub enum CpuState {
 /// Per-cpu statistics
 #[derive(Debug, Default)]
 pub struct CpuStats {
-    /// Number of ticks spent on userspace contexts
+    /// Nanoseconds spent on userspace contexts
     user: AtomicU64,
-    /// Number of ticks spent on Niced userspace contexts
+    /// Nanoseconds spent on niced userspace contexts
     nice: AtomicU64,
-    /// Number of ticks spent on kernel contexts
+    /// Nanoseconds spent on kernel contexts
     kernel: AtomicU64,
-    /// Number of ticks spent idle
+    /// Nanoseconds spent idle
     idle: AtomicU64,
     /// Number of times the CPU handled an interrupt
     irq: AtomicU64,
@@ -61,13 +61,13 @@ impl CpuStats {
 }
 
 pub struct CpuStatsData {
-    /// Number of ticks spent on userspace contexts
+    /// Milliseconds spent on userspace contexts
     pub user: u64,
-    /// Number of ticks spent on Niced userspace contexts
+    /// Milliseconds spent on niced userspace contexts
     pub nice: u64,
-    /// Number of ticks spent on kernel contexts
+    /// Milliseconds spent on kernel contexts
     pub kernel: u64,
-    /// Number of ticks spent idle
+    /// Milliseconds spent idle
     pub idle: u64,
     /// Number of times the CPU handled an interrupt
     pub irq: u64,
@@ -148,13 +148,16 @@ impl fmt::Display for CpuStatsData {
     }
 }
 
+/// The times are kept in nanoseconds and shown in milliseconds.
+const NANOS_PER_MS: u64 = 1_000_000;
+
 impl From<&CpuStats> for CpuStatsData {
     fn from(val: &CpuStats) -> Self {
         CpuStatsData {
-            user: val.user.load(Ordering::Relaxed),
-            nice: val.nice.load(Ordering::Relaxed),
-            kernel: val.kernel.load(Ordering::Relaxed),
-            idle: val.idle.load(Ordering::Relaxed),
+            user: val.user.load(Ordering::Relaxed) / NANOS_PER_MS,
+            nice: val.nice.load(Ordering::Relaxed) / NANOS_PER_MS,
+            kernel: val.kernel.load(Ordering::Relaxed) / NANOS_PER_MS,
+            idle: val.idle.load(Ordering::Relaxed) / NANOS_PER_MS,
             irq: val.irq.load(Ordering::Relaxed),
             context_switches: val.context_switches.load(Ordering::Relaxed),
             syscall_switches: val.syscall_switches.load(Ordering::Relaxed),
-- 
2.53.0

