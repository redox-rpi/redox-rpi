+/// What one interface is doing, for `STATUS`.
+fn set_status(status: &mut BTreeMap<String, String>, iface: &str, text: String) {
+    if status.get(iface) == Some(&text) {
+        return;
+    }
+    status.insert(iface.to_string(), text);
+    let all: String = status.iter().map(|(i, t)| format!("{i}: {t}\n")).collect();
+    let _ = std::fs::write(STATUS, all);
+}
+
+/// One status line per interface (redox-rpi #764, RFC 0004): `no link`,
+/// `asking`, `no answer`, `bound <address> via <router>`, `fixed <address>`.
+const STATUS: &str = "/tmp/dhcpd.status";
+
+/// Undoes a lease when its link went down: removes the address and every
+/// route through the interface (netcfg `addr/rm`). A DHCPRELEASE cannot be
+/// sent without a link, so the server lets the lease run out.
+fn release(iface: &str, lease: &Lease) {
+    match set_iface_cfg_value(iface, "addr/rm", "\n") {
+        Ok(()) => println!(
+            "DHCP: {iface} link down, {}/{} and its routes removed",
+            fmt_ip(lease.addr),
+            lease.mask_len
+        ),
+        Err(err) => eprintln!("dhcpd: {iface}: {err}"),
+    }
+}
+
+/// No lease is left: the name server goes back to the image's
+/// `/etc/net/dns` (what netstack starts with), the domain is cleared.
+fn clear_default(verbose: bool) {
+    let dns = std::fs::read_to_string("/etc/net/dns")
+        .ok()
+        .and_then(|d| parse_ip(&d))
+        .unwrap_or([8, 8, 8, 8]);
+    let _ = set_cfg_value("resolv/nameserver", &fmt_ip(dns));
+    let _ = set_cfg_value("resolv/domain", "\n");
+    if verbose {
+        println!("DHCP: no lease, name server {}", fmt_ip(dns));
+    }
+}
+
+/// Waits for netcfg: a new interface (`ifaces`) or a link that went up or
+/// down (`ifaces/<name>/link`), and for the next DHCP retry while a link is
+/// up without a lease. With no link there is no timer at all.
+#[cfg(target_os = "redox")]
+struct Events {
+    queue: event::RawEventQueue,
+    timer: File,
+    /// Kept open: netcfg posts events on these handles.
+    watched: BTreeMap<String, File>,
+}
+
+#[cfg(target_os = "redox")]
+impl Events {
+    fn new() -> Result<Self, String> {
+        use std::os::fd::AsRawFd;
+        let queue = event::RawEventQueue::new().map_err(|e| format!("event queue: {e:?}"))?;
+        // CLOCK_MONOTONIC
+        let timer = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open("/scheme/time/1")
+            .map_err(|e| format!("/scheme/time/1: {e}"))?;
+        queue
+            .subscribe(timer.as_raw_fd() as usize, 0, event::EventFlags::READ)
+            .map_err(|e| format!("timer events: {e:?}"))?;
+        let mut events = Events { queue, timer, watched: BTreeMap::new() };
+        events.watch("ifaces")?;
+        Ok(events)
+    }
+
+    /// Subscribes to a netcfg file once.
+    fn watch(&mut self, path: &str) -> Result<(), String> {
+        use std::os::fd::AsRawFd;
+        if self.watched.contains_key(path) {
+            return Ok(());
+        }
+        let file = File::open(format!("/scheme/netcfg/{path}")).map_err(|e| format!("{path}: {e}"))?;
+        self.queue
+            .subscribe(file.as_raw_fd() as usize, 1, event::EventFlags::READ)
+            .map_err(|e| format!("{path} events: {e:?}"))?;
+        self.watched.insert(path.to_string(), file);
+        Ok(())
+    }
+
+    /// Blocks until an event, or until `deadline` if one is given.
+    fn wait(&mut self, deadline: Option<Instant>) {
+        if let Some(deadline) = deadline {
+            let left = deadline.saturating_duration_since(Instant::now());
+            if left.is_zero() {
+                return;
+            }
+            // TimeSpec: i64 seconds, i32 nanoseconds, padding.
+            let mut now = [0u8; 16];
+            if self.timer.read(&mut now).ok() != Some(16) {
+                thread::sleep(left);
+                return;
+            }
+            let sec = i64::from_ne_bytes(now[0..8].try_into().unwrap());
+            let nsec = i32::from_ne_bytes(now[8..12].try_into().unwrap()) as i64;
+            let at = sec * 1_000_000_000 + nsec + left.as_nanos() as i64;
+            let mut spec = [0u8; 16];
+            spec[0..8].copy_from_slice(&(at / 1_000_000_000).to_ne_bytes());
+            spec[8..12].copy_from_slice(&((at % 1_000_000_000) as i32).to_ne_bytes());
+            if self.timer.write(&spec).ok() != Some(16) {
+                thread::sleep(left);
+                return;
+            }
+        }
+        if self.queue.next_event().is_err() {
+            thread::sleep(SCAN);
+        }
+    }
+}
+
+/// Elsewhere (unit tests on the build host): ask again every `SCAN`.
+#[cfg(not(target_os = "redox"))]
+struct Events;
+
+#[cfg(not(target_os = "redox"))]
+impl Events {
+    fn new() -> Result<Self, String> {
+        Ok(Events)
+    }
+    fn watch(&mut self, _path: &str) -> Result<(), String> {
+        Ok(())
+    }
+    fn wait(&mut self, deadline: Option<Instant>) {
+        let left = deadline.map_or(SCAN, |d| d.saturating_duration_since(Instant::now()));
+        thread::sleep(left.min(SCAN));
+    }
+}
+
