-            self.take(result);
-            return;
-        }
-        // Without a transaction translator: take the result of the packet
-        // started at the last poll, then start the next one. A report
-        // reaches inputd one poll later, at most 10 ms.
-        if let Some(started) = self.pending {
-            match self.hc.interrupt_in_result(CHANNEL, phase.len) {
-                Some(result) => {
-                    self.pending = None;
