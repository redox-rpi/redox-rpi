-        self.pending = Some(now);
-    }
-
-    /// Handle the result of one packet from the interrupt endpoint.
-    fn take(&mut self, result: Result<Option<(usize, u32)>, Error>) {
-        match result {
-            Ok(Some((len, next_pid))) => {
-                self.pid = next_pid;
-                if len >= 3 {
-                    let mut report = [0; 8];
-                    report[..len].copy_from_slice(&self.buf[..len]);
-                    if report != self.report {
-                        self.last_change = Instant::now();
-                    }
-                    self.update(report);
-                }
+        let buf = &self.buf;
+        let read = |len: usize| {
+            let mut report = [0; 8];
+            report[..len.min(8)].copy_from_slice(&buf[..len.min(8)]);
+            (len, report)
+        };
+        if let Some((len, report)) = self.poll.poll(&self.hc, CHANNEL, phase, self.f.tt, &mut self.pid, read) {
+            if len >= 3 {
+                self.update(report);
             }
-            Ok(None) | Err(_) => {}
         }
     }
 
@@ -283,6 +369,9 @@ impl Keyboard {
         let Some(scancode) = scancode(usage) else {
             return;
         };
+        if self.log {
