 drivers/usb/dwc2d/src/hid.rs   | 199 ++++++++++++++++++++++++---------
 drivers/usb/dwc2d/src/main.rs  |   5 +-
 drivers/usb/dwc2d/src/mouse.rs |  13 ++-
 4 files changed, 163 insertions(+), 63 deletions(-)

