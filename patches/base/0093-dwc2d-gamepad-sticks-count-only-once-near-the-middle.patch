+/// Pads whose buttons are not in the Xbox order: (vendor, product, name,
+/// HID button to orbclient button). By position, as SDL's game controller
+/// database maps them (A bottom, B right, X left, Y top).
+const QUIRKS: &[(u16, u16, &str, &[(u16, u16)])] = &[(
+    // SNES-style pad (DragonRise): HID 1 is the top face button (X on the
+    // pad), 2 right (A), 3 bottom (B), 4 left (Y), 9 Select, 10 Start
+    // (redox-rpi Pi test row 416). SDL: a:b2, b:b1, x:b3, y:b0, back:b8,
+    // start:b9.
+    0x0079,
+    0x0011,
+    "DragonRise SNES-style pad",
+    &[(1, 4), (2, 2), (3, 1), (4, 3), (5, 5), (6, 6), (9, 7), (10, 8)],
+)];
+
 impl PadLayout {
     /// The first joystick or gamepad report of a descriptor.
     pub fn parse(desc: &[u8]) -> Option<Self> {
         let items = items(desc)?;
         let id = items.iter().find(|i| is_pad(i))?.report_id;
         let mut layout =
-            Self { report_id: id, axes: Vec::new(), buttons: Vec::new(), hat: None, cross_x: Vec::new(), cross_y: Vec::new() };
+            Self {
+                report_id: id,
+                axes: Vec::new(),
+                buttons: Vec::new(),
+                hat: None,
+                cross_x: Vec::new(),
+                cross_y: Vec::new(),
+                button_map: None,
+                quirk: None,
+            };
         for item in items.iter().filter(|i| i.report_id == id && is_pad(i)) {
             match (item.page, item.usage) {
                 (PAGE_GENERIC_DESKTOP, usage @ USAGE_X..=USAGE_RZ) => {
                     if let Some(axis) = (usage..=USAGE_RZ).find(|a| !layout.axes.iter().any(|(b, _)| b == a)) {
+                        let index = layout.axes.len();
                         layout.axes.push((axis, item.field));
-                    }
-                    match usage {
-                        USAGE_X => layout.cross_x.push(item.field),
-                        USAGE_Y => layout.cross_y.push(item.field),
-                        _ => {}
+                        match usage {
+                            USAGE_X => layout.cross_x.push(index),
+                            USAGE_Y => layout.cross_y.push(index),
+                            _ => {}
+                        }
                     }
                 }
                 (PAGE_GENERIC_DESKTOP, USAGE_HAT) => layout.hat = layout.hat.or(Some(item.field)),
@@ -274,12 +303,30 @@ impl PadLayout {
         (!layout.axes.is_empty() || !layout.buttons.is_empty() || layout.hat.is_some()).then_some(layout)
     }
 
+    /// The button order of a known pad (`QUIRKS`), from its USB ids.
+    pub fn for_device(mut self, vendor: u16, product: u16) -> Self {
+        if let Some(&(_, _, name, map)) = QUIRKS.iter().find(|q| q.0 == vendor && q.1 == product) {
+            self.button_map = Some(map);
+            self.quirk = Some(name);
+        }
+        self
+    }
+
+    /// The orbclient button for HID button `n`, if any.
+    fn button(&self, n: u16) -> Option<u16> {
+        match self.button_map {
+            Some(map) => map.iter().find(|m| m.0 == n).map(|m| m.1),
+            None => (1..=LAST_BUTTON).contains(&n).then_some(n),
+        }
+    }
+
     pub fn describe(&self) -> String {
         format!(
-            "gamepad, {} axis(es), {} button(s){}",
+            "gamepad, {} axis(es), {} button(s){}{}",
             self.axes.len(),
             self.buttons.len(),
-            if self.hat.is_some() { ", hat" } else { "" }
+            if self.hat.is_some() { ", hat" } else { "" },
+            self.quirk.map(|q| format!(", buttons as {q}")).unwrap_or_default()
         )
     }
 }
