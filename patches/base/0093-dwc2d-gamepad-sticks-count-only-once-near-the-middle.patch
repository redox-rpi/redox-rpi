+    /// The same pad as it may really rest: the first X at 0x01 (one end),
+    /// which must neither hold LEFT nor show as a stick pushed left.
+    #[test]
+    fn dragonrise_unused_x_at_one_end() {
+        let mut pad = Pad::new(PadLayout::parse(DRAGONRISE).unwrap());
+        let rest = [0x01, 0x7F, 0x7F, 0x7F, 0x7F, 0x0F, 0x00, 0x00];
+        let first = pad.update(&rest);
+        assert!(!first.contains(&PadEvent::Button(DPAD_LEFT, true)), "{first:?}");
+        // At rest every stick reads 0 (dead zone; the first X is not armed).
+        // (0x32, the third X, is read as a trigger: 0..255.)
+        assert!(first.iter().all(|e| matches!(e, PadEvent::Axis(0x32, 127) | PadEvent::Axis(_, 0))), "{first:?}");
+        let events = pad.update(&[0x01, 0x7F, 0x7F, 0x00, 0x7F, 0x0F, 0x00, 0x00]);
+        assert_eq!(events, vec![PadEvent::Axis(0x33, -32767), PadEvent::Button(DPAD_LEFT, true)]);
+        let events = pad.update(&rest);
+        assert_eq!(events, vec![PadEvent::Axis(0x33, 0), PadEvent::Button(DPAD_LEFT, false)]);
+        // RIGHT and UP work as before.
+        let events = pad.update(&[0x01, 0x7F, 0x7F, 0xFF, 0x00, 0x0F, 0x00, 0x00]);
+        assert_eq!(
+            events,
+            vec![
+                PadEvent::Axis(0x33, 32767),
+                PadEvent::Axis(0x34, 32767),
+                PadEvent::Button(DPAD_UP, true),
+                PadEvent::Button(DPAD_RIGHT, true)
+            ]
+        );
+    }
+
+    /// 0079:0011 buttons by position: HID 3 (bottom) is A, 1 (top) is Y,
+    /// 9 and 10 are BACK and START (row 416 had them as LS and RS).
+    #[test]
+    fn dragonrise_button_order() {
+        let layout = PadLayout::parse(DRAGONRISE).unwrap().for_device(0x0079, 0x0011);
+        assert_eq!(layout.quirk, Some("DragonRise SNES-style pad"));
+        let mut pad = Pad::new(layout);
+        pad.update(&[0x7F, 0x7F, 0x7F, 0x7F, 0x7F, 0x0F, 0x00, 0x00]);
+        // Buttons 1..10 start at bit 4 of byte 5: HID 1 = 0x10, 3 = 0x40.
+        assert_eq!(pad.update(&[0x7F, 0x7F, 0x7F, 0x7F, 0x7F, 0x1F, 0x00, 0x00]), vec![PadEvent::Button(4, true)]);
+        assert_eq!(
+            pad.update(&[0x7F, 0x7F, 0x7F, 0x7F, 0x7F, 0x4F, 0x00, 0x00]),
+            vec![PadEvent::Button(1, true), PadEvent::Button(4, false)]
+        );
+        // HID 9 = byte 6 bit 4, HID 10 = byte 6 bit 5.
+        assert_eq!(
+            pad.update(&[0x7F, 0x7F, 0x7F, 0x7F, 0x7F, 0x0F, 0x30, 0x00]),
+            vec![PadEvent::Button(1, false), PadEvent::Button(7, true), PadEvent::Button(8, true)]
+        );
+        // Another pad keeps the Xbox order.
+        let other = PadLayout::parse(DRAGONRISE).unwrap().for_device(0x0079, 0x0006);
+        assert_eq!(other.quirk, None);
+        assert_eq!(other.button(10), Some(10));
+    }
+
