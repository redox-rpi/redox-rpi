+/// Percent from the middle within which a stick value arms.
+const ARM_PERCENT: i32 = 25;
+/// Stick values this close to the middle are sent as 0: the middle of
+/// 0..255 is 127.5, so a pad at rest sent -129 (Pi test row 416).
+const DEAD_ZONE: i32 = 1024;
+
+fn is_trigger(axis: u16) -> bool {
+    matches!(axis, 0x32 | 0x35)
+}
