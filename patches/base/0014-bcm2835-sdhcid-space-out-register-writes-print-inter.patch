+        } else {
+            EMMC_BASE_CLOCK / d
+        };
 
         let mut h = 0;
         if self.host_spec_ver > HOST_SPEC_V2 {
@@ -474,9 +525,11 @@ impl SdHostCtrl {
         d = ((d & 0xff) << 8) | h;
         reg_val = regs.control1.read() & 0xffff_003f;
         regs.control1.write(reg_val | d);
+        settle(self.sd_clock);
         wait_msec(10);
         reg_val = regs.control1.read();
         regs.control1.write(reg_val | C1_CLK_EN);
+        settle(self.sd_clock);
         wait_msec(10);
 
         reg_val = regs.control1.read() & C1_CLK_STABLE;
@@ -519,8 +572,11 @@ impl SdHostCtrl {
         let regs = self.regs.get_mut().unwrap();
         let mut reg_val = regs.interrupt.read();
         regs.interrupt.write(reg_val);
+        settle(self.sd_clock);
         regs.arg1.write(arg);
+        settle(self.sd_clock);
         regs.cmdtm.write(code);
+        settle(self.sd_clock);
 
         if code == CMD_SEND_OP_COND {
             wait_msec(1000);
@@ -623,10 +679,13 @@ impl SdHostCtrl {
         let err = reg_val & (INT_CMD_TIMEOUT | INT_DATA_TIMEOUT | INT_ERROR_MASK);
 
         if cnt <= 0 || err != 0 {
+            println!("bcm2835-sdhcid: interrupt flags 0x{:08x} (waiting for 0x{:08x})", reg_val, mask);
             regs.interrupt.write(reg_val);
+            settle(self.sd_clock);
             return Err(Error::new(EINVAL));
         } else {
             regs.interrupt.write(mask);
+            settle(self.sd_clock);
             return Ok(());
         }
     }
@@ -650,6 +709,7 @@ impl SdHostCtrl {
             }
             let regs = self.regs.get_mut().unwrap();
             regs.blksizecnt.write((num) << 16 | 512);
+            settle(self.sd_clock);
             if num == 1 {
                 self.sd_cmd(CMD_READ_SINGLE, lba)?;
             } else {
@@ -658,6 +718,7 @@ impl SdHostCtrl {
         } else {
             let regs = self.regs.get_mut().unwrap();
             regs.blksizecnt.write(1 << 16 | 512);
+            settle(self.sd_clock);
         }
 
         let mut cnt = 0;
@@ -673,6 +734,7 @@ impl SdHostCtrl {
 
             let regs = self.regs.get_mut().unwrap();
             regs.blksizecnt.write(1 << 16 | 512);
+            settle(self.sd_clock);
             for d in 0..128 {
                 buf[(128 * cnt + d) as usize] = regs.data.read();
             }
@@ -705,6 +767,7 @@ impl SdHostCtrl {
             }
             let regs = self.regs.get_mut().unwrap();
             regs.blksizecnt.write((num) << 16 | 512);
+            settle(self.sd_clock);
             if num == 1 {
                 self.sd_cmd(CMD_WRITE_SINGLE, lba)?;
             } else {
@@ -713,6 +776,7 @@ impl SdHostCtrl {
         } else {
             let regs = self.regs.get_mut().unwrap();
             regs.blksizecnt.write(1 << 16 | 512);
+            settle(self.sd_clock);
         }
 
         let mut cnt = 0;
@@ -728,6 +792,7 @@ impl SdHostCtrl {
 
             let regs = self.regs.get_mut().unwrap();
             regs.blksizecnt.write(1 << 16 | 512);
+            settle(self.sd_clock);
             for d in 0..128 {
                 regs.data.write(buf[(128 * cnt + d) as usize]);
             }
@@ -753,17 +818,20 @@ impl SdHostCtrl {
     pub unsafe fn recover(&mut self) {
         let regs = self.regs.get_mut().unwrap();
         regs.interrupt.write(0xffff_ffff);
+        settle(self.sd_clock);
         let _ = self.sd_cmd(CMD_STOP_TRANS, 0);
 
         let regs = self.regs.get_mut().unwrap();
         let reg_val = regs.control1.read();
         regs.control1.write(reg_val | C1_SRST_CMD | C1_SRST_DATA);
+        settle(self.sd_clock);
         let mut cnt = 100;
         while cnt > 0 && regs.control1.read() & (C1_SRST_CMD | C1_SRST_DATA) != 0 {
             wait_msec(1);
             cnt -= 1;
         }
         regs.interrupt.write(0xffff_ffff);
+        settle(self.sd_clock);
     }
 }
 
