From 27f6d25c499e3fd79baaa596ea5bf96d90d4217b Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 26 Oct 2026 15:42:42 +0100
Subject: [PATCH 14/15] bcm2835-sdhcid: space out register writes, print
 interrupt flags on errors

The Arasan controller may drop a register write that follows another
within two SD clock cycles. Wait four cycles after each register write.
Print the interrupt register when a command or transfer fails.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/storage/bcm2835-sdhcid/src/sd/mod.rs | 68 ++++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/drivers/storage/bcm2835-sdhcid/src/sd/mod.rs b/drivers/storage/bcm2835-sdhcid/src/sd/mod.rs
index cb4db51..a4d1115 100644
--- a/drivers/storage/bcm2835-sdhcid/src/sd/mod.rs
+++ b/drivers/storage/bcm2835-sdhcid/src/sd/mod.rs
@@ -45,6 +45,40 @@ pub(crate) unsafe fn wait_msec(mut n: usize) {
     }
 }
 
+#[cfg(target_arch = "aarch64")]
+#[inline(always)]
+pub(crate) unsafe fn wait_usec(n: usize) {
+    use core::arch::asm;
+
+    let f: usize;
+    let start: usize;
+    let mut now: usize;
+    asm!("mrs {0}, cntfrq_el0", out(reg) f);
+    asm!("mrs {0}, cntpct_el0", out(reg) start);
+    let ticks = (f / 1_000_000) * n;
+    loop {
+        asm!("mrs {0}, cntpct_el0", out(reg) now);
+        if now - start >= ticks {
+            break;
+        }
+    }
+}
+
+#[cfg(not(target_arch = "aarch64"))]
+#[inline(always)]
+pub(crate) unsafe fn wait_usec(n: usize) {
+    thread::sleep(Duration::from_micros(n as u64));
+}
+
+/// Wait after a register write. The BCM2835's Arasan controller may lose a
+/// register write that follows another within two SD clock cycles (a clock
+/// domain crossing problem, see Linux' sdhci-iproc). Waiting four cycles of
+/// the current SD clock keeps writes apart.
+#[inline(always)]
+unsafe fn settle(sd_clock: u32) {
+    unsafe { wait_usec((4_000_000 / sd_clock.max(1)) as usize + 1) };
+}
+
