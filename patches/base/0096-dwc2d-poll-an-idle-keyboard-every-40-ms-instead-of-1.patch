From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Thu, 12 Nov 2026 20:38:01 +0000
Subject: [PATCH] dwc2d: poll an idle keyboard every 40 ms instead of 10 ms
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A poll of a low-speed keyboard behind the hub spins about 130 µs on the
split transactions, data or not (#214). While a key is held and for 3 s
after the last change of the report, the keyboard is still polled every
10 ms; otherwise every 40 ms. A keyboard that refuses SET_IDLE is logged.
---
 drivers/usb/dwc2d/src/hid.rs      | 22 ++++++++---
 drivers/usb/dwc2d/src/main.rs     |  1 +
 drivers/usb/dwc2d/src/pollrate.rs | 65 +++++++++++++++++++++++++++++++
 3 files changed, 82 insertions(+), 6 deletions(-)
 create mode 100644 drivers/usb/dwc2d/src/pollrate.rs

diff --git a/drivers/usb/dwc2d/src/hid.rs b/drivers/usb/dwc2d/src/hid.rs
index 66ce54b8..5df02088 100644
--- a/drivers/usb/dwc2d/src/hid.rs
+++ b/drivers/usb/dwc2d/src/hid.rs
@@ -9,6 +9,7 @@ use orbclient::KeyEvent;
 
 use crate::dwc2::{Dwc2, Error, Phase, Speed};
 use crate::enumerate::{Bus, Device};
+use crate::pollrate;
 use crate::regs::*;
 
 const CLASS_HID: u8 = 0x03;
@@ -26,7 +27,6 @@ const PROTOCOL_BOOT: u16 = 0;
 /// The host channel for keyboard reports; 0 does control transfers, the
 /// network adapters use 1 and 2.
 const CHANNEL: usize = 3;
-const POLL_INTERVAL: Duration = Duration::from_millis(10);
 /// Auto-repeat of a held key, as keyboards in the boot protocol leave it to
 /// the host.
 const REPEAT_DELAY: Duration = Duration::from_millis(500);
@@ -99,8 +99,11 @@ pub fn init(bus: &mut Bus, f: &KeyboardFunction) -> Result<(), Error> {
     let index = u16::from(f.interface);
     bus.request(f.address, f.max_packet0, f.speed, 0x00, REQ_SET_CONFIGURATION, u16::from(f.configuration), 0, 0)?;
     bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_PROTOCOL, PROTOCOL_BOOT, index, 0)?;
-    // Report only on changes. Optional: some keyboards stall it.
-    let _ = bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_IDLE, 0, index, 0);
+    // Report only on changes. Optional: some keyboards stall it and then
+    // send a report on every poll, which costs about as much as a NAK.
+    if let Err(err) = bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_IDLE, 0, index, 0) {
+        println!("dwc2d: keyboard at address {}: SET_IDLE refused ({err:?}), reports on every poll", f.address);
+    }
     Ok(())
 }
 
@@ -113,6 +116,8 @@ pub struct Keyboard {
     report: [u8; 8],
     input: Input,
     next_poll: Instant,
+    /// When the report last changed: polls are fast for a while after it.
+    changed: Instant,
     /// The key that repeats while held and when it repeats next.
     repeat: Option<(u8, Instant)>,
 }
@@ -130,6 +135,7 @@ impl Keyboard {
             report: [0; 8],
             input,
             next_poll: Instant::now(),
+            changed: Instant::now(),
             repeat: None,
         })
     }
@@ -138,8 +144,6 @@ impl Keyboard {
         self.f.address
     }
 
-    /// Fetch a report when the poll interval has passed and send the key
-    /// changes. Errors are dropped: the next poll tries again.
     /// Poll the keyboard and repeat a held key when due. Returns the time
     /// until the next call is due.
     pub fn poll(&mut self) -> Duration {
@@ -162,7 +166,6 @@ impl Keyboard {
         if now < self.next_poll {
             return;
         }
-        self.next_poll = now + POLL_INTERVAL;
 
         let phase = Phase {
             dev_addr: self.f.address,
@@ -186,9 +189,16 @@ impl Keyboard {
             }
             Ok(None) | Err(_) => {}
         }
+        // Fast while keys are down or were just used, slower otherwise.
+        let now = Instant::now();
+        let held = pollrate::held(&self.report);
+        self.next_poll = now + pollrate::interval(held, now.saturating_duration_since(self.changed));
     }
 
     fn update(&mut self, report: [u8; 8]) {
+        if report != self.report {
+            self.changed = Instant::now();
+        }
         // Too many keys at once: every key slot says "rollover error".
         if report[2..].contains(&0x01) {
             return;
