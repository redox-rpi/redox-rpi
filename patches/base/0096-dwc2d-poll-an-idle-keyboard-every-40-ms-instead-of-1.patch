diff --git a/drivers/usb/dwc2d/src/pollrate.rs b/drivers/usb/dwc2d/src/pollrate.rs
new file mode 100644
index 00000000..d30d2baa
--- /dev/null
+++ b/drivers/usb/dwc2d/src/pollrate.rs
@@ -0,0 +1,65 @@
+//! How often to poll a keyboard (#214). A poll of a low-speed keyboard
+//! behind a hub costs about 130 µs of spinning on the split transactions,
+//! whether it brings a report or not, so polling less while nobody types
+//! is the main saving at idle.
+
+use std::time::Duration;
+
+/// While a key is held and shortly after the last change: fast typing and
+/// short taps between two keys need every poll.
+pub const ACTIVE: Duration = Duration::from_millis(10);
+/// While no key is held. A press and its release both between two polls
+/// would be lost; keys stay down 50 ms or more even in fast typing, and the
+/// first key after a pause switches to `ACTIVE`.
+pub const IDLE: Duration = Duration::from_millis(40);
+/// How long `ACTIVE` lasts after the last change of the report.
+pub const HOLD: Duration = Duration::from_secs(3);
+
+/// The interval to the next poll: `held` is whether the last report had a
+/// key or modifier down, `since_change` the time since the report changed.
+pub fn interval(held: bool, since_change: Duration) -> Duration {
+    if held || since_change < HOLD {
+        ACTIVE
+    } else {
+        IDLE
+    }
+}
+
+/// Whether a boot protocol report has a key or modifier down.
+pub fn held(report: &[u8; 8]) -> bool {
+    report[0] != 0 || report[2..].iter().any(|&key| key != 0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn idle_after_hold() {
+        assert_eq!(interval(false, Duration::ZERO), ACTIVE);
+        assert_eq!(interval(false, HOLD - Duration::from_millis(1)), ACTIVE);
+        assert_eq!(interval(false, HOLD), IDLE);
+        assert_eq!(interval(false, Duration::from_secs(3600)), IDLE);
+    }
+
+    #[test]
+    fn held_key_stays_active() {
+        assert_eq!(interval(true, Duration::from_secs(3600)), ACTIVE);
+    }
+
+    #[test]
+    fn held_reports() {
+        assert!(!held(&[0; 8]));
+        assert!(held(&[0x02, 0, 0, 0, 0, 0, 0, 0]));
+        assert!(held(&[0, 0, 0x04, 0, 0, 0, 0, 0]));
+        // Rollover error counts as held: keys are down.
+        assert!(held(&[0, 0, 1, 1, 1, 1, 1, 1]));
+        // The reserved byte is not a key.
+        assert!(!held(&[0, 0xff, 0, 0, 0, 0, 0, 0]));
+    }
+
+    #[test]
+    fn idle_saves_three_quarters() {
+        assert_eq!(IDLE.as_millis() / ACTIVE.as_millis(), 4);
+    }
+}
