+
+        // netstack removed these, with their addresses and routes.
+        held.retain(|name, _| {
+            let here = ifaces.contains(name);
+            if !here {
+                println!("DHCP: {name} is gone");
+            }
+            here
+        });
+        failed.retain(|name, _| ifaces.contains(name));
+
+        let due: Vec<String> = held
+            .iter()
+            .filter(|(_, h)| h.next.is_some_and(|t| Instant::now() >= t))
+            .map(|(n, _)| n.clone())
+            .collect();
+        for iface in due {
+            let h = held.get_mut(&iface).unwrap();
+            match renew(&iface, &h.lease, REPLY_TIMEOUT, verbose) {
+                Ok(lease) => {
+                    let secs = lease.times.map_or(0, |t| t.lease);
+                    println!("DHCP: {iface} renewed {} for {secs} s", fmt_ip(lease.addr));
+                    *h = Held::new(lease);
+                }
+                Err(err) if err.contains("NAK") || err.contains("instead") => {
+                    println!("DHCP: {iface} lost its lease: {err}");
+                    held.remove(&iface);
+                }
+                Err(err) => {
+                    eprintln!("dhcpd: {iface}: renewal: {err}");
+                    if h.expired() {
+                        println!("DHCP: {iface} lease of {} ended", fmt_ip(h.lease.addr));
+                        held.remove(&iface);
+                    } else {
+                        h.next = Some(Instant::now() + RENEW_RETRY);
+                    }
+                }
+            }
+        }
+        update_default(&held, &mut default, verbose);
+
