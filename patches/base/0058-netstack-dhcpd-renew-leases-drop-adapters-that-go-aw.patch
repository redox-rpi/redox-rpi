-/// Gets a lease on every interface, also those that appear later, and keeps
-/// one default route: the first wired interface with a lease, else Wi-Fi.
+/// A lease and when to act on it.
+struct Held {
+    lease: Lease,
+    /// When the lease was got or last renewed.
+    since: Instant,
+    /// Next renewal attempt.
+    next: Option<Instant>,
+}
+
+impl Held {
+    fn new(lease: Lease) -> Self {
+        let since = Instant::now();
+        let next = lease
+            .times
+            .map(|t| since + Duration::from_secs(t.renew.into()));
+        Held { lease, since, next }
+    }
+
+    fn expired(&self) -> bool {
+        self.lease
+            .times
+            .is_some_and(|t| self.since.elapsed() >= Duration::from_secs(t.lease.into()))
+    }
+}
+
+/// What the default route depends on: interface, router and name server.
+type DefaultKey = (String, Option<[u8; 4]>, Option<[u8; 4]>);
+
+/// Points the default route at the preferred interface with a lease, or
+/// removes it when no interface has a router any more.
+fn update_default(held: &BTreeMap<String, Held>, default: &mut Option<DefaultKey>, verbose: bool) {
+    let leases: BTreeMap<String, Lease> =
+        held.iter().map(|(n, h)| (n.clone(), h.lease.clone())).collect();
+    let want = preferred(&leases).map(|(n, l)| (n.clone(), l.router, l.dns));
+    if want == *default {
+        return;
+    }
+    match &want {
+        Some((name, _, _)) => {
+            if let Err(err) = apply_default(name, &leases[name], verbose) {
+                eprintln!("dhcpd: {err}");
+                return;
+            }
+        }
+        None => {
+            let _ = set_cfg_value("route/rm", "0.0.0.0/0");
+            println!("DHCP: no default route");
+        }
+    }
+    *default = want;
+}
+
+/// How long to wait before asking again after a renewal got no answer.
+const RENEW_RETRY: Duration = Duration::from_secs(30);
+
+/// Gets a lease on every interface, also those that appear later, renews
+/// it in time, and keeps one default route: the first wired interface with
+/// a lease, else Wi-Fi. An interface that goes away, or whose lease ends,
+/// gives the default route to the next one.
