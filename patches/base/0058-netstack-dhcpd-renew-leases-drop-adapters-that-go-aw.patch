+
+impl LeaseTimes {
+    /// From options 51 and 58; T1 defaults to half the lease (RFC 2131
+    /// section 4.4.5). An infinite lease (0xffffffff) or none: None.
+    fn from_reply(reply: &Reply) -> Option<LeaseTimes> {
+        let lease = reply.lease_time.filter(|&t| t != u32::MAX)?;
+        let renew = reply.renew_time.filter(|&t| t < lease).unwrap_or(lease / 2);
+        Some(LeaseTimes { lease, renew })
+    }
 }
 
