+
+/// Asks to extend `lease` of `iface` (RFC 2131 section 4.4.5). The request
+/// is broadcast, as when rebinding, so any server can answer; a server that
+/// does not know the lease answers with a NAK.
+fn renew(iface: &str, lease: &Lease, timeout: Duration, verbose: bool) -> Result<Lease, String> {
+    let mac = MacAddr::from_str(get_iface_cfg_value(iface, "mac")?.trim());
+    let tid = new_tid(&mac)?;
+    let socket = client_socket(timeout)?;
+    // DHCP Message Type (Request), End; the address goes in ciaddr.
+    try_fmt!(
+        send(&socket, &message_from(&mac, tid, lease.addr, &[53, 1, 3, 255])),
+        "failed to send request"
+    );
+    if verbose {
+        println!("DHCP: {iface} sent Request to renew {}", fmt_ip(lease.addr));
+    }
+    let ack = receive(&socket, tid, &mac, 5, timeout, verbose)?;
+    if ack.yiaddr != lease.addr && ack.yiaddr != [0; 4] {
+        return Err(format!("server gave {} instead", fmt_ip(ack.yiaddr)));
+    }
+    Ok(Lease {
+        times: LeaseTimes::from_reply(&ack),
+        ..lease.clone()
     })
 }
 
