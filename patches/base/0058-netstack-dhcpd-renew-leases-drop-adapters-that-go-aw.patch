+        let opts = [53, 1, 5, 51, 4, 0, 0, 0, 120, 255];
+        let r = parse_reply(&reply(2, 7, mac.bytes, &opts), 7, &mac, false).unwrap();
+        assert_eq!(r.lease_time, Some(120));
+        assert_eq!(LeaseTimes::from_reply(&r), Some(LeaseTimes { lease: 120, renew: 60 }));
+        // T1 given.
+        let opts = [53, 1, 5, 51, 4, 0, 0, 0, 120, 58, 4, 0, 0, 0, 30, 255];
+        let r = parse_reply(&reply(2, 7, mac.bytes, &opts), 7, &mac, false).unwrap();
+        assert_eq!(LeaseTimes::from_reply(&r), Some(LeaseTimes { lease: 120, renew: 30 }));
+        // Infinite lease, or none: never renewed.
+        let opts = [53, 1, 5, 51, 4, 255, 255, 255, 255, 255];
+        let r = parse_reply(&reply(2, 7, mac.bytes, &opts), 7, &mac, false).unwrap();
+        assert_eq!(LeaseTimes::from_reply(&r), None);
+        let r = parse_reply(&reply(2, 7, mac.bytes, &[53, 1, 5, 255]), 7, &mac, false).unwrap();
+        assert_eq!(LeaseTimes::from_reply(&r), None);
+        let held = Held::new(Lease { times: Some(LeaseTimes { lease: 0, renew: 0 }), ..Lease::default() });
+        assert!(held.expired());
+        assert!(!Held::new(Lease::default()).expired());
