diff --git a/drivers/usb/dwc2d/src/dwc2.rs b/drivers/usb/dwc2d/src/dwc2.rs
index dfc5d19a..4e26ae53 100644
--- a/drivers/usb/dwc2d/src/dwc2.rs
+++ b/drivers/usb/dwc2d/src/dwc2.rs
@@ -1,7 +1,6 @@
 //! DWC2 host controller in buffer DMA mode, driven by polling.
 
 use std::ptr::{read_volatile, write_volatile};
-use std::thread::sleep;
 use std::time::{Duration, Instant};
 
 use common::dma::Dma;
@@ -12,6 +11,20 @@ use crate::regs::*;
 /// aliased (uncached) at 0xC000_0000. QEMU's raspi machines alias it there too.
 const DMA_BUS_OFFSET: usize = 0xC000_0000;
 
+/// Wait for `d` by giving the CPU away until the time has passed, instead of
+/// `sleep`. A `nanosleep` in dwc2d sometimes never returns: the main loop
+/// then waits for good without using the CPU, and netstack waits for it
+/// (#151, Pi tests 326 and 342: the 1 s link check of the LAN7800 polls with
+/// 1 ms sleeps; dwc2d's main thread sat in `US` with its CPU time frozen).
+/// Before that, 50 µs sleeps hung it in QEMU, and on the Pi it stopped right
+/// after a hub dropped off (test 168).
+pub fn delay(d: Duration) {
+    let start = Instant::now();
+    while start.elapsed() < d {
+        std::thread::yield_now();
+    }
+}
