From 25a8721d7483305d322b9af10426d6a05d81a222 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 26 Oct 2026 09:50:45 +0100
Subject: [PATCH 06/11] dwc2d: no output from the network poll loop

After boot nobody may read the stdout of initfs daemons, so printing
can block the adapter for good.
---
 drivers/usb/dwc2d/src/ecm.rs  | 16 ++++++++++++----
 drivers/usb/dwc2d/src/main.rs |  2 ++
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/usb/dwc2d/src/ecm.rs b/drivers/usb/dwc2d/src/ecm.rs
index e93a5f8..d748e55 100644
--- a/drivers/usb/dwc2d/src/ecm.rs
+++ b/drivers/usb/dwc2d/src/ecm.rs
@@ -126,6 +126,8 @@ pub struct Ecm {
     tx: Dma<[u8; BUF_SIZE]>,
     rx_armed: bool,
     rx_ready: Option<usize>,
+    rx_frames: u64,
+    tx_frames: u64,
 }
 
 /// Activate the function: select its configuration and the data interface
@@ -169,6 +171,8 @@ impl Ecm {
             tx: Dma::new([0; BUF_SIZE]).expect("dwc2d: DMA allocation failed"),
             rx_armed: false,
             rx_ready: None,
+            rx_frames: 0,
+            tx_frames: 0,
         };
         ecm.arm_rx();
         ecm
@@ -212,16 +216,18 @@ impl Ecm {
                     self.arm_rx();
                 }
             }
-            Some(Err(err)) => {
-                println!("dwc2d: ecm receive failed: {err:?}");
-                self.arm_rx();
-            }
+            Some(Err(_)) => self.arm_rx(),
         }
     }
 
     pub fn mac(&self) -> [u8; 6] {
         self.mac
     }
+
+    /// Frames received and sent so far.
+    pub fn counters(&self) -> (u64, u64) {
+        (self.rx_frames, self.tx_frames)
+    }
 }
 
 impl NetworkAdapter for Ecm {
@@ -241,12 +247,14 @@ impl NetworkAdapter for Ecm {
         };
         let len = len.min(buf.len());
         buf[..len].copy_from_slice(&self.rx[..len]);
+        self.rx_frames += 1;
         self.arm_rx();
         Ok(Some(len))
     }
 
     fn write_packet(&mut self, buf: &[u8]) -> SysResult<usize> {
         let len = buf.len().min(BUF_SIZE);
+        self.tx_frames += 1;
         self.tx[..len].copy_from_slice(&buf[..len]);
         let timeout = Duration::from_millis(100);
         let phase = self.phase(false, len);
diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index 53a518b..80609f6 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -89,6 +89,8 @@ fn daemon(daemon: daemon::Daemon) -> ! {
         "network.usb_ecm".to_string(),
     );
     // No interrupts yet: poll for received frames and scheme requests.
+    // No output from here on: after boot nobody may read our stdout, and a
+    // full pipe would block the whole adapter.
     loop {
         scheme.tick().expect("dwc2d: network scheme failed");
         std::thread::sleep(std::time::Duration::from_millis(1));
-- 
