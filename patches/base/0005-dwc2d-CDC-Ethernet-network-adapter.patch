--- /dev/null
+++ b/drivers/usb/dwc2d/src/ecm.rs
@@ -0,0 +1,269 @@
+//! USB CDC Ethernet (ECM) network adapter.
+//!
+//! The simplest USB Ethernet protocol: raw Ethernet frames over a bulk IN and
+//! a bulk OUT endpoint. QEMU's `usb-net` speaks it, which makes it the test
+//! bed for the whole network path in QEMU; real chips like the LAN7800 add
+//! their own framing on the same transfers.
+
+use std::time::Duration;
+
+use common::dma::Dma;
+use driver_network::NetworkAdapter;
+use syscall::error::{Error as SysError, Result as SysResult, EIO};
+
+use crate::dwc2::{Dwc2, Phase, Speed};
+use crate::enumerate::{Bus, Device};
+use crate::regs::{EPTYPE_BULK, PID_DATA0};
+
+const CLASS_COMM: u8 = 0x02;
+const CLASS_CDC_DATA: u8 = 0x0A;
+const SUBCLASS_ETHERNET: u8 = 0x06;
+const CS_INTERFACE: u8 = 0x24;
+const CDC_ETHERNET_FUNCTIONAL: u8 = 0x0F;
+
+const REQ_GET_DESCRIPTOR: u8 = 0x06;
+const REQ_SET_CONFIGURATION: u8 = 0x09;
+const REQ_SET_INTERFACE: u8 = 0x0B;
+const DESC_CONFIGURATION: u8 = 0x02;
+const DESC_STRING: u8 = 0x03;
+
+const RX_CHANNEL: usize = 1;
+const TX_CHANNEL: usize = 2;
+/// Large enough for a full Ethernet frame, a multiple of every bulk max
+/// packet size.
+const BUF_SIZE: usize = 2048;
+
+/// Where a CDC Ethernet function lives on a device.
+pub struct EcmFunction {
+    pub address: u8,
+    pub speed: Speed,
+    configuration: u8,
+    data_interface: u8,
+    data_alt: u8,
+    ep_in: u8,
+    ep_out: u8,
+    max_packet_in: u16,
+    max_packet_out: u16,
+    mac_string: u8,
+}
+
+/// Search the configurations of a device for a CDC Ethernet function.
+pub fn find(bus: &mut Bus, device: &Device) -> Option<EcmFunction> {
+    for index in 0..device.configurations {
+        let config = bus
+            .request(
+                device.address,
+                device.max_packet,
+                device.speed,
+                0x80,
+                REQ_GET_DESCRIPTOR,
+                u16::from(DESC_CONFIGURATION) << 8 | u16::from(index),
+                0,
+                512,
+            )
+            .ok()?;
+
+        let mut function = None::<EcmFunction>;
+        let mut is_ethernet = false;
+        // Current interface: (class, number, alternate setting)
+        let mut interface = (0u8, 0u8, 0u8);
+        let mut pos = 0;
+        while pos + 2 <= config.len() && config[pos] >= 2 {
+            let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+            match desc[1] {
+                4 if desc.len() >= 9 => {
+                    interface = (desc[5], desc[2], desc[3]);
+                    if desc[5] == CLASS_COMM && desc[6] == SUBCLASS_ETHERNET {
+                        is_ethernet = true;
+                    }
+                }
+                CS_INTERFACE if desc.len() >= 4 && desc[2] == CDC_ETHERNET_FUNCTIONAL && is_ethernet => {
+                    function = Some(EcmFunction {
+                        address: device.address,
+                        speed: device.speed,
+                        configuration: config[5],
+                        data_interface: 0,
+                        data_alt: 0,
+                        ep_in: 0,
+                        ep_out: 0,
+                        max_packet_in: 0,
+                        max_packet_out: 0,
+                        mac_string: desc[3],
+                    });
+                }
+                5 if desc.len() >= 7 && interface.0 == CLASS_CDC_DATA && desc[3] & 3 == 2 => {
+                    if let Some(f) = function.as_mut() {
+                        f.data_interface = interface.1;
+                        f.data_alt = interface.2;
+                        let max_packet = u16::from_le_bytes([desc[4], desc[5]]) & 0x7FF;
+                        if desc[2] & 0x80 != 0 {
+                            f.ep_in = desc[2] & 0xF;
+                            f.max_packet_in = max_packet;
+                        } else {
+                            f.ep_out = desc[2] & 0xF;
+                            f.max_packet_out = max_packet;
+                        }
+                    }
+                }
+                _ => {}
+            }
+            pos += desc.len();
+        }
+        if let Some(f) = function.filter(|f| f.ep_in != 0 && f.ep_out != 0) {
+            return Some(f);
+        }
+    }
+    None
+}
+
+pub struct Ecm {
+    hc: Dwc2,
+    function: EcmFunction,
+    mac: [u8; 6],
+    in_pid: u32,
+    out_pid: u32,
+    rx: Dma<[u8; BUF_SIZE]>,
+    tx: Dma<[u8; BUF_SIZE]>,
+    rx_armed: bool,
+    rx_ready: Option<usize>,
+}
+
+/// Activate the function: select its configuration and the data interface
+/// setting with the bulk endpoints, and read the MAC address.
+pub fn activate(bus: &mut Bus, max_packet: u16, function: &EcmFunction) -> Result<[u8; 6], crate::dwc2::Error> {
+        let (a, speed) = (function.address, function.speed);
+        bus.request(a, max_packet, speed, 0x00, REQ_SET_CONFIGURATION, u16::from(function.configuration), 0, 0)?;
+        bus.request(
+            a,
+            max_packet,
+            speed,
+            0x01,
+            REQ_SET_INTERFACE,
+            u16::from(function.data_alt),
+            u16::from(function.data_interface),
+            0,
+        )?;
+
+        // The MAC address is a string descriptor of 12 hex digits.
+        let s = bus.request(a, max_packet, speed, 0x80, REQ_GET_DESCRIPTOR, u16::from(DESC_STRING) << 8 | u16::from(function.mac_string), 0x0409, 64)?;
+        let digits: Vec<u8> = s.get(2..).unwrap_or_default().iter().step_by(2).copied().collect();
+        let mut mac = [0u8; 6];
+        for (byte, pair) in mac.iter_mut().zip(digits.chunks_exact(2)) {
+            *byte = std::str::from_utf8(pair)
+                .ok()
+                .and_then(|hex| u8::from_str_radix(hex, 16).ok())
+                .unwrap_or(0);
+        }
+        Ok(mac)
+}
+
+impl Ecm {
+    pub fn new(hc: Dwc2, function: EcmFunction, mac: [u8; 6]) -> Self {
+        let mut ecm = Self {
+            hc,
+            function,
+            mac,
+            in_pid: PID_DATA0,
+            out_pid: PID_DATA0,
+            rx: Dma::new([0; BUF_SIZE]).expect("dwc2d: DMA allocation failed"),
+            tx: Dma::new([0; BUF_SIZE]).expect("dwc2d: DMA allocation failed"),
+            rx_armed: false,
+            rx_ready: None,
+        };
+        ecm.arm_rx();
+        ecm
+    }
+
+    fn phase(&self, dir_in: bool, len: usize) -> Phase {
+        let f = &self.function;
+        Phase {
+            dev_addr: f.address,
+            endpoint: if dir_in { f.ep_in } else { f.ep_out },
+            dir_in,
+            ep_type: EPTYPE_BULK,
+            max_packet: if dir_in { f.max_packet_in } else { f.max_packet_out },
+            low_speed: false,
+            pid: if dir_in { self.in_pid } else { self.out_pid },
+            buf_phys: if dir_in { self.rx.physical() } else { self.tx.physical() },
+            len,
+        }
+    }
+
+    /// Keep a bulk IN transfer pending; the controller retries the device's
+    /// NAKs until a frame arrives.
+    fn arm_rx(&mut self) {
+        let phase = self.phase(true, BUF_SIZE);
+        self.hc.start(RX_CHANNEL, &phase);
+        self.rx_armed = true;
+    }
+
+    fn poll_rx(&mut self) {
+        if !self.rx_armed || self.rx_ready.is_some() {
+            return;
+        }
+        match self.hc.poll(RX_CHANNEL, BUF_SIZE) {
+            None => {}
+            Some(Ok((len, next_pid))) => {
+                self.in_pid = next_pid;
+                self.rx_armed = false;
+                if len > 0 {
+                    self.rx_ready = Some(len);
+                } else {
+                    self.arm_rx();
+                }
+            }
+            Some(Err(err)) => {
+                println!("dwc2d: ecm receive failed: {err:?}");
+                self.arm_rx();
+            }
+        }
+    }
+
+    pub fn mac(&self) -> [u8; 6] {
+        self.mac
+    }
+}
+
+impl NetworkAdapter for Ecm {
+    fn mac_address(&mut self) -> [u8; 6] {
+        self.mac
+    }
+
+    fn available_for_read(&mut self) -> usize {
+        self.poll_rx();
+        self.rx_ready.unwrap_or(0)
+    }
+
+    fn read_packet(&mut self, buf: &mut [u8]) -> SysResult<Option<usize>> {
+        self.poll_rx();
+        let Some(len) = self.rx_ready.take() else {
+            return Ok(None);
+        };
+        let len = len.min(buf.len());
+        buf[..len].copy_from_slice(&self.rx[..len]);
+        self.arm_rx();
+        Ok(Some(len))
+    }
+
+    fn write_packet(&mut self, buf: &[u8]) -> SysResult<usize> {
+        let len = buf.len().min(BUF_SIZE);
+        self.tx[..len].copy_from_slice(&buf[..len]);
+        let timeout = Duration::from_millis(100);
+        let phase = self.phase(false, len);
+        let (_, next_pid) = self
+            .hc
+            .transfer_on(TX_CHANNEL, &phase, timeout)
+            .map_err(|_| SysError::new(EIO))?;
+        self.out_pid = next_pid;
+        // A frame that fills its last packet ends with a zero-length packet.
+        if len % usize::from(self.function.max_packet_out) == 0 {
+            let phase = self.phase(false, 0);
+            let (_, next_pid) = self
+                .hc
+                .transfer_on(TX_CHANNEL, &phase, timeout)
+                .map_err(|_| SysError::new(EIO))?;
+            self.out_pid = next_pid;
+        }
+        Ok(len)
+    }
+}
