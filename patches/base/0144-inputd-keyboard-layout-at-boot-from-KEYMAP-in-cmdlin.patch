 const HELP: &str = r#"
-inputd [-K keymap|--keymap-file file|-A vt|--keymaps]
+inputd [-K keymap|--keymap-file file|--keymap-boot [file]|--keymap|-A vt|--keymaps]
    -A vt       : set current virtual display
    -K keymap   : set keyboard mapping
    --keymap-file file
                : set the keyboard mapping named in file (e.g. /etc/keymap);
                  nothing if the file does not exist
+   --keymap-boot [file]
+               : set the keyboard mapping from KEYMAP= in the environment or
+                 on the kernel command line (on a Raspberry Pi: cmdline.txt
+                 on the card's FAT partition), else from file (default
+                 /etc/keymap); nothing if neither names one
+   --keymap    : print the active keyboard mapping
    --keymaps   : list available keyboard mappings
 "#;
 
+/// The layout named in `path`: the first line that is not empty and not a
+/// `#` comment.
+fn keymap_from_file(path: &str) -> Option<String> {
+    let text = std::fs::read_to_string(path).ok()?;
+    let name = text
+        .lines()
+        .map(str::trim)
+        .find(|line| !line.is_empty() && !line.starts_with('#'))?;
+    Some(name.to_owned())
+}
+
+/// `KEYMAP` from the environment (the bootloader's), else `KEYMAP=name` on
+/// the kernel command line: the devicetree's `/chosen bootargs`, where the
+/// Raspberry Pi firmware puts `cmdline.txt` (#36). Also says where it came
+/// from.
+fn keymap_from_command_line() -> Option<(String, &'static str)> {
+    if let Ok(name) = std::env::var("KEYMAP") {
+        return Some((name, "the environment"));
+    }
+    let dtb = std::fs::read("/scheme/kernel.dtb").ok()?;
+    let fdt = fdt::Fdt::new(&dtb).ok()?;
+    let bootargs = fdt.find_node("/chosen")?.property("bootargs")?.value;
+    let bootargs = String::from_utf8_lossy(bootargs);
+    let name = bootargs
+        .trim_end_matches('\0')
+        .split_whitespace()
+        .find_map(|word| word.strip_prefix("KEYMAP="))?;
+    Some((name.to_owned(), "the command line"))
+}
+
 fn main() {
     let mut args = std::env::args().skip(1);
 
