--- a/drivers/inputd/src/lib.rs
+++ b/drivers/inputd/src/lib.rs
@@ -150,6 +150,13 @@ impl ControlHandle {
         let cmd = ControlEvent::from(KeymapActivate { keymap });
         self.0.write(unsafe { any_as_u8_slice(&cmd) })
     }
+
+    /// The name of the active keyboard mapping, e.g. "us".
+    pub fn active_keymap(&mut self) -> io::Result<String> {
+        let mut buf = [0; 32];
+        let len = io::Read::read(&mut self.0, &mut buf)?;
+        Ok(String::from_utf8_lossy(&buf[..len]).trim().to_owned())
+    }
 }
 
