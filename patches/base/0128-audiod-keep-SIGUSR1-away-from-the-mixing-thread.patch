     let mut ring = redox_rings::user::Producer::<AudioChunk>::from_fd(shm_fd, false, None)?;
     loop {
         let buffer = {
@@ -42,6 +62,7 @@ fn uring_thread(inner_mutex: Arc<Mutex<AudioSchemeInner>>, pid: usize, shm_fd: F
 }
 
