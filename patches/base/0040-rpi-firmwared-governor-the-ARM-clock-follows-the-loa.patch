index 00000000..a51ab2e4
--- /dev/null
+++ b/drivers/rpi-firmwared/src/governor.rs
@@ -0,0 +1,263 @@
+//! CPU clock governor: the ARM clock follows the load, like Linux's
+//! `ondemand`.
+//!
+//! Every 100 ms it reads the per-CPU times from `sys:stat` and takes the load
+//! of the busiest CPU (all cores share one clock). Above `UP_LOAD` percent it
+//! sets the maximum clock; after `DOWN_SAMPLES` samples in a row below
+//! `DOWN_LOAD` percent it goes back to the minimum. The firmware still lowers
+//! the clock on its own when the SoC gets hot or the voltage drops.
+//!
+//! Reading the governor file starts a program, which is load itself, so
+//! `target` and `load` there mostly show that moment. `time_min_ms` and
+//! `time_max_ms` count how long the clock was at each rate since the
+//! driver started: two reads some seconds apart give the share at the
+//! minimum.
+
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use crate::mbox::*;
+
+const SAMPLE: Duration = Duration::from_millis(100);
+const UP_LOAD: u64 = 50;
+const DOWN_LOAD: u64 = 30;
+/// 2 seconds below `DOWN_LOAD` before the clock goes down.
+const DOWN_SAMPLES: u32 = 20;
+
+#[derive(Clone, Copy, PartialEq)]
+pub enum Mode {
+    /// The clock follows the load.
+    Ondemand,
+    /// Always the maximum.
+    Performance,
+    /// Always the minimum.
+    Powersave,
+    /// A rate written to `arm_clock`; the governor leaves it alone.
+    Fixed,
+}
+
+impl Mode {
+    pub fn parse(name: &str) -> Option<Self> {
+        match name {
+            "ondemand" => Some(Mode::Ondemand),
+            "performance" => Some(Mode::Performance),
+            "powersave" => Some(Mode::Powersave),
+            _ => None,
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Mode::Ondemand => "ondemand",
+            Mode::Performance => "performance",
+            Mode::Powersave => "powersave",
+            Mode::Fixed => "fixed",
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Target {
+    Min,
+    Max,
+}
+
+pub struct Governor {
+    pub mode: Mode,
+    target: Option<Target>,
+    /// Load of the busiest CPU in the last sample, in percent.
+    load: u64,
+    switches: u64,
+    min: u32,
+    max: u32,
+    /// Since when the clock has been at `target`.
+    since: Instant,
+    /// Time at the minimum and at the maximum before `since`.
+    time_min: Duration,
+    time_max: Duration,
+}
+
+impl Governor {
+    pub fn new(mbox: &mut Mailbox) -> Self {
+        let min = mbox.value_of(TAG_GET_MIN_CLOCK_RATE, CLOCK_ARM).unwrap_or(0);
+        let max = mbox.value_of(TAG_GET_MAX_CLOCK_RATE, CLOCK_ARM).unwrap_or(0);
+        Self {
+            mode: Mode::Ondemand,
+            // The driver starts at the maximum (see `arm_clock_max`).
+            target: Some(Target::Max),
+            load: 0,
+            switches: 0,
+            min,
+            max,
+            since: Instant::now(),
+            time_min: Duration::ZERO,
+            time_max: Duration::ZERO,
+        }
+    }
+
+    /// The contents of `/scheme/rpi-firmware/governor`.
+    pub fn status(&self) -> String {
+        let target = match (self.mode, self.target) {
+            (Mode::Fixed, _) | (_, None) => "-",
+            (_, Some(Target::Min)) => "min",
+            (_, Some(Target::Max)) => "max",
+        };
+        let (mut time_min, mut time_max) = (self.time_min, self.time_max);
+        match self.target {
+            Some(Target::Min) => time_min += self.since.elapsed(),
+            Some(Target::Max) => time_max += self.since.elapsed(),
+            None => {}
+        }
+        format!(
+            "mode {}\ntarget {target}\nload {}\nswitches {}\nmin {}\nmax {}\ntime_min_ms {}\ntime_max_ms {}\n",
+            self.mode.name(),
+            self.load,
+            self.switches,
+            self.min,
+            self.max,
+            time_min.as_millis(),
+            time_max.as_millis()
+        )
+    }
+
+    /// Sets the mode; `performance` and `powersave` take effect at once.
+    pub fn set_mode(&mut self, mode: Mode, mbox: &mut Mailbox) -> Result<(), String> {
+        self.mode = mode;
+        match mode {
+            Mode::Performance => self.go(Target::Max, mbox),
+            Mode::Powersave => self.go(Target::Min, mbox),
+            Mode::Fixed => {
+                self.account();
+                self.target = None;
+                Ok(())
+            }
+            Mode::Ondemand => Ok(()),
+        }
+    }
+
+    /// Adds the time since the last change to the current target.
+    fn account(&mut self) {
+        let now = Instant::now();
+        match self.target {
+            Some(Target::Min) => self.time_min += now - self.since,
+            Some(Target::Max) => self.time_max += now - self.since,
+            None => {}
+        }
+        self.since = now;
+    }
+
+    fn go(&mut self, target: Target, mbox: &mut Mailbox) -> Result<(), String> {
+        if self.target == Some(target) {
+            return Ok(());
+        }
+        let rate = match target {
+            Target::Min => self.min,
+            Target::Max => self.max,
+        };
+        mbox.set_clock(CLOCK_ARM, rate)?;
+        self.account();
+        self.target = Some(target);
+        self.switches += 1;
+        Ok(())
+    }
+}
+
+/// Busy and total time per CPU, from the `cpuN user nice kernel idle ...`
+/// lines of `sys:stat` (milliseconds).
+fn cpu_times(stat: &str) -> Vec<(u64, u64)> {
+    stat.lines()
+        .filter_map(|line| {
+            let mut fields = line.split_whitespace();
+            let name = fields.next()?;
+            // "cpu" alone is the sum of all CPUs.
+            name.strip_prefix("cpu")?.parse::<u32>().ok()?;
+            let values: Vec<u64> = fields.take(4).filter_map(|v| v.parse().ok()).collect();
+            let [user, nice, kernel, idle] = values[..] else {
+                return None;
+            };
+            Some((user + nice + kernel, user + nice + kernel + idle))
+        })
+        .collect()
+}
+
+fn read_stat(sys: &libredox::Fd) -> Option<String> {
+    // The kernel builds the text once per open, so open it every time.
+    let fd = sys.openat("stat", libredox::flag::O_RDONLY, 0).ok()?;
+    let mut buf = vec![0u8; 4096];
+    let mut len = 0;
+    loop {
+        if len == buf.len() {
+            buf.resize(len * 2, 0);
+        }
+        match fd.read(&mut buf[len..]) {
+            Ok(0) => break,
+            Ok(n) => len += n,
+            Err(_) => return None,
+        }
+    }
+    buf.truncate(len);
+    String::from_utf8(buf).ok()
+}
+
+/// Runs the governor; `sys` is `/scheme/sys`, opened before the driver left
+/// its namespace.
+pub fn run(sys: libredox::Fd, governor: Arc<Mutex<Governor>>, mbox: Arc<Mutex<Mailbox>>) {
+    let mut last: Vec<(u64, u64)> = Vec::new();
+    let mut quiet = 0;
+    loop {
+        thread::sleep(SAMPLE);
+        let Some(now) = read_stat(&sys).map(|stat| cpu_times(&stat)) else {
+            continue;
+        };
+        let load = now
+            .iter()
+            .zip(&last)
+            .map(|(&(busy, total), &(busy0, total0))| {
+                let total = total.saturating_sub(total0);
+                if total == 0 {
+                    0
+                } else {
+                    busy.saturating_sub(busy0) * 100 / total
+                }
+            })
+            .max()
+            .unwrap_or(0);
+        last = now;
+
+        let mut governor = governor.lock().unwrap();
+        governor.load = load;
+        if governor.mode != Mode::Ondemand {
+            continue;
+        }
+        let target = if load > UP_LOAD {
+            quiet = 0;
+            Target::Max
+        } else {
+            if load < DOWN_LOAD {
+                quiet += 1;
+            } else {
+                quiet = 0;
+            }
+            if quiet >= DOWN_SAMPLES {
+                Target::Min
+            } else {
+                continue;
+            }
+        };
+        if let Err(err) = governor.go(target, &mut mbox.lock().unwrap()) {
+            eprintln!("rpi-firmwared: governor: {err}");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::cpu_times;
+
+    #[test]
+    fn parses_per_cpu_lines() {
+        let stat = "cpu  10 0 5 85 3\ncpu0 4 0 2 44 1 7\ncpu1 6 0 3 41 2 9\nIRQs 3 1 2\nboot_time: 1\n";
+        assert_eq!(cpu_times(stat), vec![(6, 50), (9, 50)]);
+    }
+}
