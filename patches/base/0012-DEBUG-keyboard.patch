From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 26 Oct 2026 12:25:30 +0100
Subject: [PATCH 12/12] DEBUG keyboard

---
 drivers/usb/dwc2d/src/hid.rs | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/dwc2d/src/hid.rs b/drivers/usb/dwc2d/src/hid.rs
index b765485..c203cbd 100644
--- a/drivers/usb/dwc2d/src/hid.rs
+++ b/drivers/usb/dwc2d/src/hid.rs
@@ -160,7 +160,16 @@ impl Keyboard {
             buf_phys: self.buf.physical(),
             len: usize::from(self.f.max_packet).min(8),
         };
-        match self.hc.interrupt_in(CHANNEL, &phase, self.f.tt, Duration::from_millis(5)) {
+        let result = self.hc.interrupt_in(CHANNEL, &phase, self.f.tt, Duration::from_millis(5));
+        // DEBUG: the first results
+        static mut DEBUG: usize = 0;
+        unsafe {
+            if DEBUG < 30 && !matches!(result, Ok(None)) {
+                DEBUG += 1;
+                eprintln!("dwc2d: kbd {:?} {:02x?}", result, &self.buf[..]);
+            }
+        }
+        match result {
             Ok(Some((len, next_pid))) => {
                 self.pid = next_pid;
                 if len >= 3 {
