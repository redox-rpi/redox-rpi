 }
 
+/// How the network starts: which interfaces get DHCP (redox-rpi #622,
+/// docs/network-config.md in redox-rpi). No file: none.
+const CONFIG: &str = "/etc/net/config.toml";
+
+#[derive(Deserialize, Default)]
+#[serde(deny_unknown_fields)]
+struct NetConfig {
+    #[serde(default)]
+    interface: BTreeMap<String, IfaceConfig>,
+}
+
+/// One `[interface.<name>]` section. The keys for a fixed address and IPv6
+/// are part of the format already; dhcpd uses only `boards` and `ipv4`.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+#[allow(dead_code)]
+struct IfaceConfig {
+    /// Only on these boards (init's board names); none: every board.
+    boards: Option<Vec<String>>,
+    /// `dhcp`, `static` or `off`.
+    #[serde(default = "off")]
+    ipv4: String,
+    /// `slaac`, `static` or `off`; not dhcpd's part.
+    #[serde(default = "off")]
+    ipv6: String,
+    address: Option<String>,
+    router: Option<String>,
+    dns: Option<Vec<String>>,
+}
+
+fn off() -> String {
+    "off".into()
+}
+
+/// The interfaces the configuration asks DHCP for on this board. A file
+/// that cannot be read or parsed gives one line and no interface.
+fn dhcp_ifaces() -> BTreeSet<String> {
+    let text = match std::fs::read_to_string(CONFIG) {
+        Ok(text) => text,
+        Err(err) if err.kind() == ErrorKind::NotFound => return BTreeSet::new(),
+        Err(err) => {
+            eprintln!("dhcpd: {CONFIG}: {err}");
+            return BTreeSet::new();
+        }
+    };
+    parse_dhcp_ifaces(&text, option_env!("BOARD"))
+}
+
+fn parse_dhcp_ifaces(text: &str, board: Option<&str>) -> BTreeSet<String> {
+    let config: NetConfig = match toml::from_str(text) {
+        Ok(config) => config,
+        Err(err) => {
+            eprintln!("dhcpd: {CONFIG}: {err}");
+            return BTreeSet::new();
+        }
+    };
+    config
+        .interface
+        .into_iter()
+        .filter(|(_, cfg)| {
+            cfg.boards
+                .as_ref()
+                .is_none_or(|boards| boards.iter().any(|b| Some(b.as_str()) == board))
+        })
+        .filter_map(|(name, cfg)| match cfg.ipv4.as_str() {
+            "dhcp" => Some(name),
+            "off" => None,
+            "static" => {
+                eprintln!("dhcpd: {CONFIG}: {name}: ipv4 = \"static\" is not supported yet");
+                None
+            }
+            other => {
+                eprintln!("dhcpd: {CONFIG}: {name}: ipv4 = {other:?}, expected \"dhcp\", \"static\" or \"off\"");
+                None
+            }
+        })
+        .collect()
+}
+
 /// How long one DHCP exchange waits for each reply.
 const REPLY_TIMEOUT: Duration = Duration::from_secs(5);
 /// How often the interface list is read.
@@ -480,13 +560,14 @@ fn try_lease(iface: &str, verbose: bool) -> Option<Lease> {
 /// with no lease after `ANSWER_WITHIN` it prints one line and then asks
 /// quietly every `RETRY`. A link that goes down and up again (a cable
 /// plugged in again) starts over.
-fn watch(verbose: bool) -> ! {
+fn watch(verbose: bool, wanted: BTreeSet<String>) -> ! {
     let mut leases: BTreeMap<String, Lease> = BTreeMap::new();
     let mut waiting: BTreeMap<String, Waiting> = BTreeMap::new();
     let mut links: BTreeMap<String, bool> = BTreeMap::new();
     let mut default: Option<(String, Lease)> = None;
     loop {
         let mut ifaces = list_ifaces();
+        ifaces.retain(|name| wanted.contains(name));
         ifaces.sort_by_key(|name| iface_order(name));
         for iface in ifaces {
             let up = link_up(&iface);
@@ -566,11 +647,40 @@ fn main() {
         return;
     }
 
-    watch(verbose)
+    // Only the interfaces /etc/net/config.toml asks DHCP for; none: done,
+    // silently (the minimal card has no file, #622).
+    let wanted = dhcp_ifaces();
+    if wanted.is_empty() {
+        return;
+    }
+    watch(verbose, wanted)
 }
 
 #[cfg(test)]
 mod test {
+    #[test]
+    fn config_test() {
+        use super::parse_dhcp_ifaces;
+        let names = |v: &[&str]| v.iter().map(|s| s.to_string()).collect::<std::collections::BTreeSet<_>>();
+        let text = r#"
+[interface.eth0]
+ipv4 = "dhcp"
+
+[interface.eth1]
+boards = ["raspi4b"]
+ipv4 = "dhcp"
+
+[interface.wlan0]
+ipv4 = "off"
+ipv6 = "slaac"
+"#;
+        assert_eq!(parse_dhcp_ifaces(text, Some("raspi3bp")), names(&["eth0"]));
+        assert_eq!(parse_dhcp_ifaces(text, Some("raspi4b")), names(&["eth0", "eth1"]));
+        assert_eq!(parse_dhcp_ifaces("", Some("raspi3bp")), names(&[]));
+        assert_eq!(parse_dhcp_ifaces("[interface.eth0]\nipv4 = \"static\"\naddress = \"10.0.0.2/24\"\n", None), names(&[]));
+        assert_eq!(parse_dhcp_ifaces("[interface.eth0]\nipv4 = \"dhcp\"\nfoo = 1\n", None), names(&[]));
+    }
+
