+    /// Tell netcfg readers when a device's link went up or down. The driver
+    /// keeps the state (it asks the PHY every few seconds); this reads it at
+    /// most every LINK_READ, from the poll that runs at least every
+    /// MAX_CHECK_TIMEOUT anyway, so a busy network costs no extra reads.
+    fn update_links(&mut self) {
+        const LINK_READ: ::std::time::Duration = ::std::time::Duration::from_millis(500);
+        let now_t = ::std::time::Instant::now();
+        if self.links_read.is_some_and(|t| now_t.duration_since(t) < LINK_READ) {
+            return;
+        }
+        self.links_read = Some(now_t);
+        let now: Vec<(Rc<str>, bool)> = self
+            .devices
+            .borrow()
+            .iter()
+            .map(|dev| (dev.name().clone(), dev.link_up()))
+            .collect();
+        for (name, up) in now {
+            if self.links.insert(name.clone(), up).is_some_and(|was| was != up) {
+                self.netcfg_scheme.link_changed(&name, up);
+            }
+        }
+    }
+
     /// Give the link devices the joined multicast groups when they changed.
     fn update_multicast(&mut self) {
         let mut groups: Vec<Ipv4Address> = self
diff --git a/netstack/src/scheme/netcfg/mod.rs b/netstack/src/scheme/netcfg/mod.rs
index 9b99670d..ddfbf219 100644
--- a/netstack/src/scheme/netcfg/mod.rs
+++ b/netstack/src/scheme/netcfg/mod.rs
@@ -323,6 +323,31 @@ fn mk_iface_node(
                             Ok(())
                         }
                     },
+                    // Any write removes the address and every route through
+                    // this interface, also a default route (redox-rpi #764:
+                    // dhcpd on link down).
+                    "rm" => {
+                        wo [iface, notifier, devices, route_table, name] (bool, false)
+                        |cur_value, _line| {
+                            *cur_value = true;
+                            Ok(())
+                        }
+                        |cur_value| {
+                            if mem::take(cur_value) {
+                                if let Some(dev) = devices.borrow_mut().get_mut(&name) {
+                                    if let Some(old_addr) = dev.ip_address() {
+                                        iface.borrow_mut().update_ip_addrs(|addrs| addrs.retain(|addr| *addr != old_addr));
+                                    }
+                                    dev.clear_ip_address();
+                                }
+                                route_table.borrow_mut().remove_device(&name);
+                                notifier.borrow_mut().schedule_notify(&format!("ifaces/{name}/addr/list"));
+                                notifier.borrow_mut().schedule_notify("route/list");
+                            }
+                            prefer_default_source(&iface, &route_table.borrow());
+                            Ok(())
+                        }
+                    },
                 }
     }
 }
@@ -511,6 +536,17 @@ impl NetCfgScheme {
         })
     }
 
+    /// Tells readers of `ifaces/<name>/link` (dhcpd) that the link went up
+    /// or down (redox-rpi #764), so they can wait instead of asking again.
+    pub fn link_changed(&mut self, name: &str, up: bool) {
+        debug!("netcfg: {name} link {}", if up { "up" } else { "down" });
+        self.inner.notifier.borrow_mut().schedule_notify(&format!("ifaces/{name}/link"));
+        let fds_to_notify = self.inner.notifier.borrow_mut().get_notified_fds();
+        for fd in fds_to_notify {
+            let _ = post_fevent(self.handler.socket(), fd, syscall::EVENT_READ.bits());
+        }
+    }
+
     /// Tells readers of `ifaces` (dhcpd) that a device was added.
     pub fn interface_added(&mut self, name: &str) {
         debug!("netcfg: interface {name} added");
