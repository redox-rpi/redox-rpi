 netstack/src/link/mod.rs           |  2 ++
 netstack/src/router/route_table.rs |  6 +++++
 netstack/src/scheme/mod.rs         | 32 ++++++++++++++++++++++++++
 netstack/src/scheme/netcfg/mod.rs  | 36 ++++++++++++++++++++++++++++++
 5 files changed, 80 insertions(+)

