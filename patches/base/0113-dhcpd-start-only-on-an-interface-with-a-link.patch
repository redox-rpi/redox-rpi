diff --git a/dhcpd/src/main.rs b/dhcpd/src/main.rs
index 5729940..25b2058 100644
--- a/dhcpd/src/main.rs
+++ b/dhcpd/src/main.rs
@@ -419,55 +419,113 @@ fn list_ifaces() -> Vec<String> {
         .unwrap_or_default()
 }
 
+/// Whether `iface` has a link (netstack's `ifaces/<name>/link`). An
+/// adapter without a link, or no adapter at all, gets no DHCP and no
+/// console lines. Older netstacks and drivers that cannot tell count as up.
+fn link_up(iface: &str) -> bool {
+    get_iface_cfg_value(iface, "link").map_or(true, |state| state.trim() != "0")
+}
+
 /// How long one DHCP exchange waits for each reply.
 const REPLY_TIMEOUT: Duration = Duration::from_secs(5);
 /// How often the interface list is read.
 const SCAN: Duration = Duration::from_secs(2);
-/// How long to wait before asking again on an interface that got no lease.
+/// After a link comes up, how long dhcpd keeps asking before it says once
+/// that no answer came (#560).
+const ANSWER_WITHIN: Duration = Duration::from_secs(60);
+/// After that, how often it asks again, without console lines.
 const RETRY: Duration = Duration::from_secs(30);
-/// Attempts per interface before waiting `RETRY`.
-const ATTEMPTS: usize = 3;
 
+/// An interface with a link but no lease yet.
+struct Waiting {
+    /// When the link came up (or the interface appeared with one).
+    since: Instant,
+    /// When to ask next.
+    next: Instant,
+    /// The "no DHCP answer" line was printed for this link-up.
+    told: bool,
+}
+
+impl Waiting {
+    fn new() -> Self {
+        let now = Instant::now();
+        Waiting { since: now, next: now, told: false }
+    }
+}
+
+/// One DHCP exchange. Failures are printed only with `-v`; `watch` says
+/// once when no answer came within `ANSWER_WITHIN`.
 fn try_lease(iface: &str, verbose: bool) -> Option<Lease> {
-    for attempt in 1..=ATTEMPTS {
-        match dhcp(iface, REPLY_TIMEOUT, verbose) {
-            Ok(lease) => {
-                println!(
-                    "DHCP: {iface} got {}/{}",
-                    fmt_ip(lease.addr),
-                    lease.mask_len
-                );
-                return Some(lease);
+    match dhcp(iface, REPLY_TIMEOUT, verbose) {
+        Ok(lease) => {
+            println!(
+                "DHCP: {iface} got {}/{}",
+                fmt_ip(lease.addr),
+                lease.mask_len
+            );
+            Some(lease)
+        }
+        Err(err) => {
+            if verbose {
+                eprintln!("dhcpd: {iface}: {err}");
             }
-            Err(err) => eprintln!("dhcpd: {iface}: attempt {attempt}: {err}"),
+            None
         }
     }
-    None
 }
 
-/// Gets a lease on every interface, also those that appear later, and keeps
-/// one default route: the first wired interface with a lease, else Wi-Fi.
+/// Gets a lease on every interface with a link, also those that appear or
+/// get a link later, and keeps one default route: the first wired
+/// interface with a lease, else Wi-Fi. After link-up it asks without pause;
+/// with no lease after `ANSWER_WITHIN` it prints one line and then asks
+/// quietly every `RETRY`. A link that goes down and up again (a cable
+/// plugged in again) starts over.
 fn watch(verbose: bool) -> ! {
     let mut leases: BTreeMap<String, Lease> = BTreeMap::new();
-    let mut failed: BTreeMap<String, Instant> = BTreeMap::new();
+    let mut waiting: BTreeMap<String, Waiting> = BTreeMap::new();
+    let mut links: BTreeMap<String, bool> = BTreeMap::new();
     let mut default: Option<(String, Lease)> = None;
     loop {
         let mut ifaces = list_ifaces();
         ifaces.sort_by_key(|name| iface_order(name));
         for iface in ifaces {
-            if leases.contains_key(&iface) {
+            let up = link_up(&iface);
+            match links.insert(iface.clone(), up) {
+                // Link lost: ask again when it is back, maybe on another
+                // network. Address and route stay until then.
+                Some(true) if !up => {
+                    leases.remove(&iface);
+                    waiting.remove(&iface);
+                }
+                // Link back: start over.
+                Some(false) if up => {
+                    waiting.remove(&iface);
+                }
+                _ => {}
+            }
+            if !up || leases.contains_key(&iface) {
                 continue;
             }
-            if failed.get(&iface).is_some_and(|t| t.elapsed() < RETRY) {
+            let wait = waiting.entry(iface.clone()).or_insert_with(Waiting::new);
+            if Instant::now() < wait.next {
                 continue;
             }
             match try_lease(&iface, verbose) {
                 Some(lease) => {
-                    failed.remove(&iface);
+                    waiting.remove(&iface);
                     leases.insert(iface, lease);
                 }
+                None if wait.since.elapsed() < ANSWER_WITHIN => {}
                 None => {
-                    failed.insert(iface, Instant::now());
+                    if !wait.told {
+                        eprintln!(
+                            "dhcpd: {iface}: no DHCP answer within {} s, asking again every {} s",
+                            ANSWER_WITHIN.as_secs(),
+                            RETRY.as_secs()
+                        );
+                        wait.told = true;
+                    }
+                    wait.next = Instant::now() + RETRY;
                 }
             }
             let want = preferred(&leases).map(|(n, l)| (n.clone(), l.clone()));
