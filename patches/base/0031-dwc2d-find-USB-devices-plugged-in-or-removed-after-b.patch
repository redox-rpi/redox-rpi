+/// Receive frames for `mac`: the address the network stack uses, when the
+/// adapter takes over from another one.
+pub fn set_mac(bus: &mut Bus, f: &Lan78xxFunction, mac: [u8; 6]) -> Result<(), Error> {
+    let mut r = Regs { bus, f };
+    let address_low = u32::from_le_bytes([mac[0], mac[1], mac[2], mac[3]]);
+    let address_high = u32::from(mac[4]) | u32::from(mac[5]) << 8;
