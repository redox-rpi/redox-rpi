+    /// Forget a device and everything behind it if it is a hub; collects the
+    /// addresses in `removed`.
+    fn remove(&mut self, address: u8, removed: &mut Vec<u8>) {
+        let children: Vec<u8> = self
+            .devices
+            .iter()
+            .filter(|d| d.parent.is_some_and(|(hub, _)| hub == address))
+            .map(|d| d.address)
+            .collect();
+        for child in children {
+            self.remove(child, removed);
+        }
+        self.devices.retain(|d| d.address != address);
+        self.hubs.retain(|h| h.address != address);
+        self.tts.remove(&address);
+        self.failed.retain(|p| !p.is_some_and(|(hub, _)| hub == address));
+        removed.push(address);
+    }
