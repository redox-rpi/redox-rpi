+    pub fn scan(&mut self) -> Changes {
+        let mut changes = Changes::default();
+        let before: Vec<u8> = self.devices.iter().map(|d| d.address).collect();
+
+        let root = self.hc.root_connected();
+        let root_device = self.devices.iter().any(|d| d.parent.is_none());
+        if !root && (root_device || self.failed.contains(&None)) {
+            println!("dwc2d: device on root port removed");
+            for address in before.iter().copied() {
+                changes.removed.push(address);
+            }
+            self.devices.clear();
+            self.hubs.clear();
+            self.tts.clear();
+            self.failed.clear();
+        } else if root && !root_device && !self.failed.contains(&None) {
+            if let Err(err) = self.enumerate_root() {
+                println!("dwc2d: root port: {err:?}");
+                self.failed.insert(None);
+            }
+        }
+
+        // Hubs closer to the root first, so the ports of a hub that is gone
+        // are not asked.
+        let mut hubs = self.hubs.clone();
+        hubs.sort_by_key(|h| h.depth);
+        for hub in hubs {
