     }
 
+    /// Stop a channel started with [`Dwc2::start`], e.g. a receive transfer
+    /// to a device that went away, and wait until it halts.
+    pub fn halt(&self, ch: usize) {
+        let value = self.read(hcchar(ch));
+        if value & HCCHAR_CHENA != 0 {
+            self.write(hcchar(ch), value | HCCHAR_CHDIS);
+            let _ = self.wait("channel halt", Duration::from_millis(100), |s| {
+                s.read(hcint(ch)) & HCINT_CH_HLTD != 0
+            });
+        }
+        self.write(hcint(ch), u32::MAX);
+    }
+
+    /// Whether a device is connected to the root port.
+    pub fn root_connected(&self) -> bool {
+        self.read(HPRT0) & HPRT0_CONN_STS != 0
+    }
+
     fn write_port(&self, set: u32, clear: u32) {
         let value = self.read(HPRT0) & !HPRT0_W1C;
         self.write(HPRT0, (value | set) & !clear);
