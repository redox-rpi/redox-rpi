-            self.request(hub, max_packet, speed, 0x23, REQ_CLEAR_FEATURE, C_PORT_RESET, port, 0)?;
-            // Reset recovery time.
-            sleep(Duration::from_millis(20));
-
-            let child_speed = if status & PORT_STAT_LOW_SPEED != 0 {
-                Speed::Low
-            } else if status & PORT_STAT_HIGH_SPEED != 0 {
-                Speed::High
-            } else {
-                Speed::Full
-            };
-            // A high-speed hub translates for full- and low-speed devices on
-            // its ports; deeper down, the translator of the hub applies.
-            let child_tt = if speed == Speed::High && child_speed != Speed::High {
-                Some((hub, port as u8))
-            } else {
-                hub_tt
-            };
-            println!("dwc2d: {indent}hub {hub} port {port}: device connected");
-            if let Err(err) = self.enumerate(child_speed, depth + 1, child_tt) {
-                println!("dwc2d: {indent}hub {hub} port {port}: {err:?}");
             }
         }
+
+        changes.added = self
+            .devices
+            .iter()
+            .map(|d| d.address)
+            .filter(|a| !before.contains(a) || changes.removed.contains(a))
+            .collect();
+        changes
+    }
