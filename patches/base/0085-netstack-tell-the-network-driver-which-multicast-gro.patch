+    /// Give the link devices the joined multicast groups when they changed.
+    fn update_multicast(&mut self) {
+        let mut groups: Vec<Ipv4Address> = self
+            .ip_scheme
+            .multicast_groups()
+            .chain(self.udp_scheme.multicast_groups())
+            .chain(self.tcp_scheme.multicast_groups())
+            .chain(self.icmp_scheme.multicast_groups())
+            .copied()
+            .collect();
+        groups.sort();
+        groups.dedup();
+        if self.multicast.as_ref() == Some(&groups) {
+            return;
+        }
+        for dev in self.devices.borrow_mut().iter_mut() {
+            dev.set_multicast(&groups);
+        }
+        self.multicast = Some(groups);
+    }
+
     fn notify_sockets(&mut self) -> Result<()> {
         self.ip_scheme.notify_sockets()?;
         self.udp_scheme.notify_sockets()?;
@@ -286,6 +314,9 @@ fn ethernet_link(adapter: Adapter) -> EthernetLink {
         File::from_raw_fd(adapter.file.into_raw() as RawFd)
     });
     link.set_mac_address(adapter.mac);
+    if let Some(file) = adapter.multicast {
+        link.set_multicast_file(unsafe { File::from_raw_fd(file.into_raw() as RawFd) });
+    }
     link
 }
 
