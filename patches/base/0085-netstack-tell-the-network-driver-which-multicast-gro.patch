@@ -63,6 +64,7 @@ impl EthernetLink {
         Self {
             name: name.into(),
             network_file,
+            multicast_file: None,
             waiting_packets,
             hardware_address: None,
             ip_address: None,
@@ -73,6 +75,11 @@ impl EthernetLink {
         }
     }
 
+    /// The adapter's `multicast` file, if its driver has one
+    pub fn set_multicast_file(&mut self, file: File) {
+        self.multicast_file = Some(file);
+    }
+
     fn send_to<F>(&mut self, dst: EthernetAddress, size: usize, f: F, proto: EthernetProtocol)
     where
         F: FnOnce(&mut [u8]),
@@ -404,6 +411,21 @@ impl LinkDevice for EthernetLink {
         &self.name
     }
 
+    fn set_multicast(&mut self, groups: &[Ipv4Address]) {
+        let Some(file) = &mut self.multicast_file else {
+            return;
+        };
+        // All-hosts (224.0.0.1) always, then each group's MAC (RFC 1112).
+        let mut list = vec![0x01, 0x00, 0x5e, 0x00, 0x00, 0x01];
+        for group in groups {
+            let [_, b1, b2, b3] = group.octets();
+            list.extend_from_slice(&[0x01, 0x00, 0x5e, b1 & 0x7f, b2, b3]);
+        }
+        if let Err(err) = file.write(&list) {
+            warn!("Failed to set the multicast list on link {}: {}", self.name, err);
+        }
+    }
+
     fn can_recv(&self) -> bool {
         // We don't buffer any packets so we can't receive immediatly
         false
