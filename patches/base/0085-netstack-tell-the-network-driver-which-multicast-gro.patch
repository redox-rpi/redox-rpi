From 38ef3dfa895de468d54f4e645feb22a5e68135ba Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 5 Nov 2026 10:09:57 +0000
Subject: [PATCH] netstack: tell the network driver which multicast groups are
 joined

A new write-only file multicast in the network adapter scheme
(driver-network) takes the multicast Ethernet addresses the stack wants,
six bytes each, the whole list each time (empty: no multicast), or
"all" for all multicast. NetworkAdapter::set_multicast gets Some(list)
or None; by default nothing changes, so a driver that does not filter
keeps receiving what it received before.

netstack opens the file if the adapter has it and writes all-hosts
(01:00:5e:00:00:01) plus the MAC of each joined IPv4 group, at start and
whenever the joined groups change. A driver can then program its
hardware filter instead of passing all multicast (#216).
---
 drivers/net/driver-network/src/lib.rs | 71 +++++++++++++++++++++++++++
 netstack/src/link/ethernet.rs         | 22 +++++++++
 netstack/src/link/mod.rs              |  5 +-
 netstack/src/main.rs                  |  6 ++-
 netstack/src/scheme/mod.rs            | 36 ++++++++++++++
 netstack/src/scheme/socket.rs         |  5 ++
 6 files changed, 143 insertions(+), 2 deletions(-)

diff --git a/drivers/net/driver-network/src/lib.rs b/drivers/net/driver-network/src/lib.rs
index 0df36f5a..685b0358 100644
--- a/drivers/net/driver-network/src/lib.rs
+++ b/drivers/net/driver-network/src/lib.rs
@@ -27,6 +27,15 @@ pub trait NetworkAdapter {
     // FIXME support back pressure on writes by returning EWOULDBLOCK or not
     // returning from the write syscall until there is room.
     fn write_packet(&mut self, buf: &[u8]) -> Result<usize>;
+
+    /// The multicast Ethernet addresses the network stack wants to receive:
+    /// `Some(list)` means only these (an empty list: none, only the own
+    /// address and broadcast), `None` means all multicast. The whole list
+    /// comes each time. The default keeps receiving whatever it received
+    /// before.
+    fn set_multicast(&mut self, _addrs: Option<&[[u8; 6]]>) -> Result<()> {
+        Ok(())
+    }
 }
 
 pub struct NetworkScheme<T: NetworkAdapter> {
@@ -122,6 +131,7 @@ resource_scheme! {
         SchemeRoot(SchemeRoot<T>),
         Data(Data<T>),
         Mac(Mac<T>),
+        Multicast(Multicast<T>),
     }
 }
 
@@ -168,6 +178,10 @@ impl<T: NetworkAdapter> ResourceSync for SchemeRoot<T> {
                 NetworkResource::Mac(Mac(PhantomData)),
                 NewFdFlags::POSITIONED,
             ),
+            "multicast" => (
+                NetworkResource::Multicast(Multicast(PhantomData)),
+                NewFdFlags::empty(),
+            ),
             _ => return Err(Error::new(EINVAL)),
         };
 
@@ -284,3 +298,60 @@ impl<T: NetworkAdapter> ResourceSync for Mac<T> {
         Ok(())
     }
 }
+
+/// Write-only: one write holds the whole list, six bytes per address, or
+/// `all` for all multicast.
+struct Multicast<T>(PhantomData<T>);
+
+impl<T> std::fmt::Debug for Multicast<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("Multicast").finish()
+    }
+}
+
+impl<T: NetworkAdapter> ResourceSync for Multicast<T> {
+    type SchemeData = NetworkSchemeData<T>;
+    type ResourceEnum = NetworkResource<T>;
+
+    fn read(
+        &mut self,
+        _scheme_data: &mut Self::SchemeData,
+        _buf: &mut [u8],
+        _offset: u64,
+        _fcntl_flags: u32,
+    ) -> Result<usize> {
+        Err(Error::new(EINVAL))
+    }
+
+    fn write(
+        &mut self,
+        scheme_data: &mut Self::SchemeData,
+        buf: &[u8],
+        _offset: u64,
+        _fcntl_flags: u32,
+    ) -> Result<usize> {
+        if buf == b"all" {
+            scheme_data.adapter.set_multicast(None)?;
+            return Ok(buf.len());
+        }
+        if buf.len() % 6 != 0 {
+            return Err(Error::new(EINVAL));
+        }
+        let addrs: Vec<[u8; 6]> = buf
+            .chunks_exact(6)
+            .map(|c| c.try_into().unwrap())
+            .collect();
+        scheme_data.adapter.set_multicast(Some(&addrs))?;
+        Ok(buf.len())
+    }
+
+    fn fpath(&mut self, _scheme_data: &mut Self::SchemeData, w: &mut FpathWriter) -> Result<()> {
+        w.push_str("multicast");
+        Ok(())
+    }
+
+    fn fstat(&mut self, _scheme_data: &mut Self::SchemeData, stat: &mut Stat) -> Result<()> {
+        stat.st_mode = MODE_FILE | 0o200;
+        Ok(())
+    }
+}
