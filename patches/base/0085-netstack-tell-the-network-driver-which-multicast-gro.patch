-    fn open(&self, scheme: &str) -> Result<(Fd, EthernetAddress), String> {
+    fn open(&self, scheme: &str) -> Result<(Fd, EthernetAddress, Option<Fd>), String> {
         // As relibc's open(): the scheme root from the namespace, then the
         // path inside the scheme.
         let scheme_root = match &self.ns {
@@ -137,7 +139,9 @@ impl Adapters {
         if n != 6 {
             return Err(format!("{scheme}/mac: {n} bytes"));
         }
-        Ok((file, EthernetAddress::from_bytes(&mac)))
+        // Drivers that filter multicast in hardware take the joined groups here.
+        let multicast = open("multicast", O_WRONLY).ok();
+        Ok((file, EthernetAddress::from_bytes(&mac), multicast))
     }
 }
 
