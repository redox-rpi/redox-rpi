diff --git a/drivers/usb/dwc2d/src/inputs.rs b/drivers/usb/dwc2d/src/inputs.rs
new file mode 100644
index 00000000..20ccb259
--- /dev/null
+++ b/drivers/usb/dwc2d/src/inputs.rs
@@ -0,0 +1,190 @@
+//! Several keyboards, mice and gamepads at the same time (redox-rpi #450).
+//!
+//! Each input function polls its interrupt endpoint on a host channel of
+//! its own. Channel 0 does control transfers and the network adapters use 1
+//! and 2, so input functions take theirs from a pool of the others (the
+//! BCM283x DWC2 has 8). When the pool is empty, a new function is logged and
+//! left out until another one goes. Gamepads get controller ids 0, 1, … in
+//! plug order; a freed id is given again.
+
+use std::time::Duration;
+
+use crate::dwc2::Dwc2;
+use crate::hid::{Keyboard, KeyboardFunction};
+use crate::mouse::{Mouse, MouseFunction};
+
+/// The host channels input functions may use.
+pub const INPUT_CHANNELS: std::ops::RangeInclusive<usize> = 3..=7;
+
+/// Host channels free for input functions.
+#[derive(Debug)]
+pub struct ChannelPool {
+    free: Vec<usize>,
+}
+
+impl ChannelPool {
+    pub fn new(channels: impl IntoIterator<Item = usize>, available: usize) -> Self {
+        // Only channels the controller has (hc.channels()).
+        let mut free: Vec<usize> = channels.into_iter().filter(|&c| c < available).collect();
+        // Take the lowest first: pop from the end.
+        free.sort_unstable_by(|a, b| b.cmp(a));
+        Self { free }
+    }
+
+    pub fn take(&mut self) -> Option<usize> {
+        self.free.pop()
+    }
+
+    pub fn give(&mut self, channel: usize) {
+        if !self.free.contains(&channel) {
+            self.free.push(channel);
+            self.free.sort_unstable_by(|a, b| b.cmp(a));
+        }
+    }
+
+    pub fn free(&self) -> usize {
+        self.free.len()
+    }
+}
+
+/// The lowest controller id not in `used`.
+pub fn lowest_free_id(used: impl IntoIterator<Item = u8>) -> u8 {
+    let used: Vec<u8> = used.into_iter().collect();
+    (0..=u8::MAX).find(|id| !used.contains(id)).unwrap_or(u8::MAX)
+}
+
+/// Every keyboard and pointer or gamepad function in use.
+pub struct Inputs {
+    hc: Dwc2,
+    pool: ChannelPool,
+    pub keyboards: Vec<Keyboard>,
+    pub mice: Vec<Mouse>,
+}
+
+impl Inputs {
+    pub fn new(hc: Dwc2) -> Self {
+        let pool = ChannelPool::new(INPUT_CHANNELS, hc.channels());
+        Self { hc, pool, keyboards: Vec::new(), mice: Vec::new() }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.keyboards.is_empty() && self.mice.is_empty()
+    }
+
+    /// Take the functions of a newly found device, as far as channels last.
+    pub fn add(&mut self, keyboard: Option<KeyboardFunction>, mice: Vec<MouseFunction>) {
+        if let Some(f) = keyboard {
+            let address = f.address();
+            match self.pool.take() {
+                Some(channel) => match Keyboard::new(self.hc.clone(), f, channel) {
+                    Some(k) => {
+                        println!("dwc2d: keyboard at address {address} polls on channel {channel}");
+                        self.keyboards.push(k);
+                    }
+                    None => self.pool.give(channel),
+                },
+                None => println!("dwc2d: keyboard at address {address} left out: no free channel"),
+            }
+        }
+        for f in mice {
+            let address = f.address();
+            let pad_id = f
+                .is_gamepad()
+                .then(|| lowest_free_id(self.mice.iter().filter_map(Mouse::pad_id)));
+            match self.pool.take() {
+                Some(channel) => match Mouse::new(self.hc.clone(), f, channel, pad_id) {
+                    Some(m) => {
+                        match pad_id {
+                            Some(id) => println!("dwc2d: gamepad at address {address} polls on channel {channel}, controller {id}"),
+                            None => println!("dwc2d: mouse at address {address} polls on channel {channel}"),
+                        }
+                        self.mice.push(m);
+                    }
+                    None => self.pool.give(channel),
+                },
+                None => println!("dwc2d: mouse or gamepad at address {address} left out: no free channel"),
+            }
+        }
+    }
+
+    /// Drop every function of the device at `address` and free its channels.
+    pub fn remove(&mut self, address: u8) {
+        let pool = &mut self.pool;
+        self.keyboards.retain(|k| {
+            let keep = k.address() != address;
+            if !keep {
+                println!("dwc2d: keyboard removed (address {address}, channel {})", k.channel());
+                pool.give(k.channel());
+            }
+            keep
+        });
+        self.mice.retain(|m| {
+            let keep = m.address() != address;
+            if !keep {
+                println!("dwc2d: mouse removed (address {address}, channel {})", m.channel());
+                pool.give(m.channel());
+            }
+            keep
+        });
+    }
+
+    /// Poll whatever is due. Returns the time until the next poll is due,
+    /// if anything is there to poll.
+    pub fn poll(&mut self) -> Option<Duration> {
+        let keyboards = self.keyboards.iter_mut().map(Keyboard::poll);
+        let mice = self.mice.iter_mut().map(Mouse::poll);
+        keyboards.chain(mice).collect::<Vec<_>>().into_iter().min()
+    }
+
+    pub fn set_log(&mut self, log: bool) {
+        for m in &mut self.mice {
+            m.log = log;
+        }
+    }
+
+    pub fn first_keyboard(&self) -> Option<u8> {
+        self.keyboards.first().map(Keyboard::address)
+    }
+
+    pub fn first_mouse(&self) -> Option<u8> {
+        self.mice.first().map(Mouse::address)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pool_takes_the_lowest_and_takes_back() {
+        let mut pool = ChannelPool::new(INPUT_CHANNELS, 8);
+        assert_eq!(pool.free(), 5);
+        assert_eq!(pool.take(), Some(3));
+        assert_eq!(pool.take(), Some(4));
+        pool.give(3);
+        assert_eq!(pool.take(), Some(3));
+        assert_eq!(pool.take(), Some(5));
+        assert_eq!(pool.take(), Some(6));
+        assert_eq!(pool.take(), Some(7));
+        assert_eq!(pool.take(), None, "five input functions at most");
+        pool.give(6);
+        pool.give(6);
+        assert_eq!(pool.free(), 1, "a channel given twice is free once");
+    }
+
+    #[test]
+    fn pool_only_has_channels_the_controller_has() {
+        let mut pool = ChannelPool::new(INPUT_CHANNELS, 6);
+        assert_eq!(pool.free(), 3);
+        assert_eq!((pool.take(), pool.take(), pool.take(), pool.take()), (Some(3), Some(4), Some(5), None));
+    }
+
+    #[test]
+    fn pad_ids_in_plug_order_and_reused() {
+        assert_eq!(lowest_free_id([]), 0);
+        assert_eq!(lowest_free_id([0]), 1);
+        assert_eq!(lowest_free_id([0, 1]), 2);
+        assert_eq!(lowest_free_id([1]), 0, "the first pad was unplugged");
+        assert_eq!(lowest_free_id([0, 2]), 1);
+    }
+}
