+    /// Run one transaction phase on channel 0, split through the hub's
+    /// transaction translator for `tt`, and return the bytes moved.
+    pub fn transfer(&self, phase: &Phase, tt: Option<(u8, u8)>) -> Result<usize, Error> {
+        let timeout = Duration::from_secs(1);
+        match tt {
+            Some(tt) => self.split_transfer(0, phase, tt, timeout),
+            None => self.transfer_on(0, phase, timeout).map(|(len, _)| len),
