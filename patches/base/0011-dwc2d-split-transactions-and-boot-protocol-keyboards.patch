+    /// Run a single packet (at most max packet bytes) on a channel, with
+    /// `hcsplt_value` for split transactions, and wait until the channel
+    /// halts. Returns the HCINT bits. Interrupt endpoints go out in the next
+    /// (micro)frame.
+    fn packet(&self, ch: usize, phase: &Phase, hcsplt_value: u32, timeout: Duration) -> Result<u32, Error> {
+        self.write(hcint(ch), u32::MAX);
+        self.write(hcsplt(ch), hcsplt_value);
+        self.write(
+            hctsiz(ch),
+            phase.len as u32 | (1 << HCTSIZ_PKTCNT_SHIFT) | (phase.pid << HCTSIZ_PID_SHIFT),
+        );
+        self.write(hcdma(ch), (phase.buf_phys | DMA_BUS_OFFSET) as u32);
+        let mut value = Self::hcchar_value(phase) | HCCHAR_CHENA;
+        // A periodic channel runs in the (micro)frame whose parity matches
+        // ODDFRM: pick the next one.
+        if phase.ep_type == EPTYPE_INTERRUPT && self.read(HFNUM) & 1 == 0 {
+            value |= HCCHAR_ODDFRM;
         }
-        if phase.low_speed {
-            hcchar_value |= HCCHAR_LSPDDEV;
+        self.write(hcchar(ch), value);
+
+        let start = Instant::now();
+        loop {
+            let status = self.read(hcint(ch));
+            if status & HCINT_CH_HLTD != 0 {
+                self.write(hcint(ch), u32::MAX);
+                return Ok(status);
+            }
+            if start.elapsed() > timeout {
+                let value = self.read(hcchar(ch));
+                self.write(hcchar(ch), value | HCCHAR_CHDIS);
+                return Err(Error::Timeout("channel halt"));
+            }
+            std::hint::spin_loop();
+        }
+    }
+
+    /// Bytes moved by the last transfer on a channel and the data PID for
+    /// the next one.
+    fn moved(&self, ch: usize, len: usize) -> (usize, u32) {
+        let hctsiz_value = self.read(hctsiz(ch));
+        let remaining = (hctsiz_value & 0x7FFFF) as usize;
+        (len.saturating_sub(remaining), (hctsiz_value >> HCTSIZ_PID_SHIFT) & 0x3)
+    }
+
+    /// One packet to or from a full- or low-speed device behind a
+    /// high-speed hub, through the transaction translator of hub `tt.0`,
+    /// port `tt.1` (USB 2.0, 11.14): a start split hands the transaction to
+    /// the hub, complete splits fetch its result. Returns the bytes moved
+    /// and the next data PID, or `None` if an interrupt endpoint had no data.
+    pub fn split_packet(
+        &self,
+        ch: usize,
+        phase: &Phase,
+        tt: (u8, u8),
+        timeout: Duration,
+    ) -> Result<Option<(usize, u32)>, Error> {
+        let periodic = phase.ep_type == EPTYPE_INTERRUPT;
+        let split = HCSPLT_SPLTENA
+            | HCSPLT_XACTPOS_ALL
+            | (u32::from(tt.0) << HCSPLT_HUBADDR_SHIFT)
+            | u32::from(tt.1);
+        let start = Instant::now();
+        let check_time = |what| {
+            if start.elapsed() > timeout {
+                Err(Error::Timeout(what))
+            } else {
+                Ok(())
+            }
+        };
+        'start_split: loop {
+            check_time("start split")?;
+            if periodic {
+                // Leave the hub the rest of the frame for the transaction:
+                // no start split in the last microframes.
+                while self.read(HFNUM) & 7 >= 5 {
+                    std::hint::spin_loop();
+                }
+            }
+            let status = self.packet(ch, phase, split, timeout)?;
+            if status & HCINT_STALL != 0 {
+                return Err(Error::Stall);
+            }
+            if status & HCINT_ACK == 0 {
+                if periodic && status & HCINT_NAK != 0 {
+                    return Ok(None);
+                }
+                // NAK (hub busy) or transaction error: start over.
+                continue;
+            }
+
+            loop {
+                check_time("complete split")?;
+                let status = self.packet(ch, phase, split | HCSPLT_COMPSPLT, timeout)?;
+                if status & HCINT_XFER_COMPL != 0 {
+                    return Ok(Some(self.moved(ch, phase.len)));
+                }
+                if status & HCINT_STALL != 0 {
+                    return Err(Error::Stall);
+                }
+                if status & HCINT_NYET != 0 {
+                    // The hub has no result yet.
+                    continue;
+                }
+                if periodic && status & HCINT_NAK != 0 {
+                    return Ok(None);
+                }
+                // NAK from the device or a transaction error: start over.
+                continue 'start_split;
+            }
+        }
+    }
+
+    /// One packet from an interrupt IN endpoint: through the hub's
+    /// transaction translator for `tt`, directly otherwise. `None` if the
+    /// device had no data.
+    pub fn interrupt_in(
+        &self,
+        ch: usize,
+        phase: &Phase,
+        tt: Option<(u8, u8)>,
+        timeout: Duration,
+    ) -> Result<Option<(usize, u32)>, Error> {
+        if let Some(tt) = tt {
+            return self.split_packet(ch, phase, tt, timeout);
+        }
+        let status = self.packet(ch, phase, 0, timeout)?;
+        if status & HCINT_XFER_COMPL != 0 {
+            Ok(Some(self.moved(ch, phase.len)))
+        } else if status & HCINT_STALL != 0 {
+            Err(Error::Stall)
+        } else if status & HCINT_NAK != 0 {
+            Ok(None)
+        } else {
+            Err(Error::Transfer(status))
+        }
+    }
+
+    /// A transfer of any length as split transactions, packet by packet.
+    fn split_transfer(&self, ch: usize, phase: &Phase, tt: (u8, u8), timeout: Duration) -> Result<usize, Error> {
+        let mps = usize::from(phase.max_packet);
+        let mut done = 0;
+        let mut pid = phase.pid;
+        loop {
+            let len = (phase.len - done).min(mps);
+            let packet = Phase {
+                buf_phys: phase.buf_phys + done,
+                len,
+                pid,
+                ..*phase
+            };
+            let Some((moved, next_pid)) = self.split_packet(ch, &packet, tt, timeout)? else {
+                continue;
+            };
+            done += moved;
+            pid = next_pid;
+            if moved < len || done >= phase.len {
+                return Ok(done);
+            }
         }
-        self.write(hcchar(ch), hcchar_value);
     }
 
