@@ -0,0 +1,296 @@
+//! USB keyboards in the HID boot protocol: polled on their interrupt
+//! endpoint, key changes go to inputd like those of usbhidd.
+
+use std::time::{Duration, Instant};
+
+use common::dma::Dma;
+use inputd::ProducerHandle;
+use orbclient::KeyEvent;
+
+use crate::dwc2::{Dwc2, Error, Phase, Speed};
+use crate::enumerate::{Bus, Device};
+use crate::regs::*;
+
+const CLASS_HID: u8 = 0x03;
+const SUBCLASS_BOOT: u8 = 0x01;
+const PROTOCOL_KEYBOARD: u8 = 0x01;
+
+const REQ_GET_DESCRIPTOR: u8 = 0x06;
+const REQ_SET_CONFIGURATION: u8 = 0x09;
+const DESC_CONFIGURATION: u8 = 0x02;
+// HID class requests (HID 1.11, 7.2)
+const REQ_SET_IDLE: u8 = 0x0A;
+const REQ_SET_PROTOCOL: u8 = 0x0B;
+const PROTOCOL_BOOT: u16 = 0;
+
+/// The host channel for keyboard reports; 0 does control transfers, the
+/// network adapters use 1 and 2.
+const CHANNEL: usize = 3;
+const POLL_INTERVAL: Duration = Duration::from_millis(10);
+/// Auto-repeat of a held key, as keyboards in the boot protocol leave it to
+/// the host.
+const REPEAT_DELAY: Duration = Duration::from_millis(500);
+const REPEAT_INTERVAL: Duration = Duration::from_millis(33);
+
+/// A boot keyboard interface and its interrupt IN endpoint.
+pub struct KeyboardFunction {
+    address: u8,
+    speed: Speed,
+    max_packet0: u16,
+    tt: Option<(u8, u8)>,
+    configuration: u8,
+    interface: u8,
+    endpoint: u8,
+    max_packet: u16,
+}
+
+pub fn find(bus: &mut Bus, device: &Device) -> Option<KeyboardFunction> {
+    let config = bus
+        .request(
+            device.address,
+            device.max_packet,
+            device.speed,
+            0x80,
+            REQ_GET_DESCRIPTOR,
+            u16::from(DESC_CONFIGURATION) << 8,
+            0,
+            512,
+        )
+        .ok()?;
+    let configuration = *config.get(5)?;
+
+    let mut keyboard_interface = None;
+    let mut pos = 0;
+    while pos + 2 <= config.len() && config[pos] >= 2 {
+        let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+        match desc[1] {
+            4 if desc.len() >= 9 => {
+                keyboard_interface = (desc[5] == CLASS_HID
+                    && desc[6] == SUBCLASS_BOOT
+                    && desc[7] == PROTOCOL_KEYBOARD)
+                    .then_some(desc[2]);
+            }
+            5 if desc.len() >= 7 => {
+                // Interrupt IN endpoint of the keyboard interface.
+                if let Some(interface) = keyboard_interface {
+                    if desc[2] & 0x80 != 0 && desc[3] & 3 == 3 {
+                        return Some(KeyboardFunction {
+                            address: device.address,
+                            speed: device.speed,
+                            max_packet0: device.max_packet,
+                            tt: device.tt,
+                            configuration,
+                            interface,
+                            endpoint: desc[2] & 0x0F,
+                            max_packet: u16::from_le_bytes([desc[4], desc[5]]) & 0x7FF,
+                        });
+                    }
+                }
+            }
+            _ => {}
+        }
+        pos += desc.len();
+    }
+    None
+}
+
+/// Configure the keyboard for boot protocol reports.
+pub fn init(bus: &mut Bus, f: &KeyboardFunction) -> Result<(), Error> {
+    let index = u16::from(f.interface);
+    bus.request(f.address, f.max_packet0, f.speed, 0x00, REQ_SET_CONFIGURATION, u16::from(f.configuration), 0, 0)?;
+    bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_PROTOCOL, PROTOCOL_BOOT, index, 0)?;
+    // Report only on changes. Optional: some keyboards stall it.
+    let _ = bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_IDLE, 0, index, 0);
+    Ok(())
+}
+
+pub struct Keyboard {
+    hc: Dwc2,
+    f: KeyboardFunction,
+    buf: Dma<[u8; 8]>,
+    pid: u32,
+    /// The last boot protocol report: modifier bits, reserved, six keys.
+    report: [u8; 8],
+    input: ProducerHandle,
+    next_poll: Instant,
+    /// The key that repeats while held and when it repeats next.
+    repeat: Option<(u8, Instant)>,
+}
+
+impl Keyboard {
+    pub fn new(hc: Dwc2, f: KeyboardFunction) -> Option<Self> {
+        let input = ProducerHandle::new()
+            .inspect_err(|err| println!("dwc2d: cannot open the input scheme: {err}"))
+            .ok()?;
+        Some(Self {
+            hc,
+            f,
+            buf: Dma::new([0; 8]).expect("dwc2d: DMA allocation failed"),
+            pid: PID_DATA0,
+            report: [0; 8],
+            input,
+            next_poll: Instant::now(),
+            repeat: None,
+        })
+    }
+
+    /// Fetch a report when the poll interval has passed and send the key
+    /// changes. Errors are dropped: the next poll tries again.
+    pub fn poll(&mut self) {
+        let now = Instant::now();
+        if let Some((key, at)) = self.repeat {
+            if now >= at {
+                self.send(key, true);
+                self.repeat = Some((key, now + REPEAT_INTERVAL));
+            }
+        }
+        if now < self.next_poll {
+            return;
+        }
+        self.next_poll = now + POLL_INTERVAL;
+
+        let phase = Phase {
+            dev_addr: self.f.address,
+            endpoint: self.f.endpoint,
+            dir_in: true,
+            ep_type: EPTYPE_INTERRUPT,
+            max_packet: self.f.max_packet,
+            low_speed: self.f.speed == Speed::Low,
+            pid: self.pid,
+            buf_phys: self.buf.physical(),
+            len: usize::from(self.f.max_packet).min(8),
+        };
+        match self.hc.interrupt_in(CHANNEL, &phase, self.f.tt, Duration::from_millis(5)) {
+            Ok(Some((len, next_pid))) => {
+                self.pid = next_pid;
+                if len >= 3 {
+                    let mut report = [0; 8];
+                    report[..len].copy_from_slice(&self.buf[..len]);
+                    self.update(report);
+                }
+            }
+            Ok(None) | Err(_) => {}
+        }
+    }
+
+    fn update(&mut self, report: [u8; 8]) {
+        // Too many keys at once: every key slot says "rollover error".
+        if report[2..].contains(&0x01) {
+            return;
+        }
+        let old = self.report;
+        for bit in 0..8 {
+            let (was, is) = (old[0] & (1 << bit) != 0, report[0] & (1 << bit) != 0);
+            if was != is {
+                self.send(0xE0 + bit, is);
+            }
+        }
+        for &key in old[2..].iter().filter(|&&key| key > 3) {
+            if !report[2..].contains(&key) {
+                self.send(key, false);
+                if matches!(self.repeat, Some((k, _)) if k == key) {
+                    self.repeat = None;
+                }
+            }
+        }
+        for &key in report[2..].iter().filter(|&&key| key > 3) {
+            if !old[2..].contains(&key) {
+                self.send(key, true);
+                self.repeat = Some((key, Instant::now() + REPEAT_DELAY));
+            }
+        }
+        self.report = report;
+    }
+
+    fn send(&mut self, usage: u8, pressed: bool) {
+        let Some(scancode) = scancode(usage) else {
+            return;
+        };
+        let event = KeyEvent {
+            character: '\0',
+            scancode,
+            pressed,
+        };
+        let _ = self.input.write_event(event.to_event());
+    }
+}
+
+/// The scancode inputd expects for a key from the HID keyboard usage page,
+/// as in usbhidd.
+fn scancode(usage: u8) -> Option<u8> {
+    use orbclient::*;
+    Some(match usage {
+        0x04..=0x1D => {
+            const LETTERS: [u8; 26] = [
+                K_A, K_B, K_C, K_D, K_E, K_F, K_G, K_H, K_I, K_J, K_K, K_L, K_M, K_N, K_O, K_P,
+                K_Q, K_R, K_S, K_T, K_U, K_V, K_W, K_X, K_Y, K_Z,
+            ];
+            LETTERS[usize::from(usage - 0x04)]
+        }
+        0x1E..=0x27 => {
+            const DIGITS: [u8; 10] = [K_1, K_2, K_3, K_4, K_5, K_6, K_7, K_8, K_9, K_0];
+            DIGITS[usize::from(usage - 0x1E)]
+        }
+        0x28 => K_ENTER,
+        0x29 => K_ESC,
+        0x2A => K_BKSP,
+        0x2B => K_TAB,
+        0x2C => K_SPACE,
+        0x2D => K_MINUS,
+        0x2E => K_EQUALS,
+        0x2F => K_BRACE_OPEN,
+        0x30 => K_BRACE_CLOSE,
+        0x31 => K_BACKSLASH,
+        // Non-US # and ~, where PS/2 keyboards have \ and |
+        0x32 => K_BACKSLASH,
+        0x33 => K_SEMICOLON,
+        0x34 => K_QUOTE,
+        0x35 => K_TICK,
+        0x36 => K_COMMA,
+        0x37 => K_PERIOD,
+        0x38 => K_SLASH,
+        0x39 => K_CAPS,
+        0x3A..=0x45 => {
+            const FKEYS: [u8; 12] = [K_F1, K_F2, K_F3, K_F4, K_F5, K_F6, K_F7, K_F8, K_F9, K_F10, K_F11, K_F12];
+            FKEYS[usize::from(usage - 0x3A)]
+        }
+        0x46 => K_PRTSC,
+        0x47 => K_SCROLL,
+        0x49 => K_INS,
+        0x4A => K_HOME,
+        0x4B => K_PGUP,
+        0x4C => K_DEL,
+        0x4D => K_END,
+        0x4E => K_PGDN,
+        0x4F => K_RIGHT,
+        0x50 => K_LEFT,
+        0x51 => K_DOWN,
+        0x52 => K_UP,
+        0x53 => K_NUM,
+        0x54 => K_NUM_SLASH,
+        0x55 => K_NUM_ASTERISK,
+        0x56 => K_NUM_MINUS,
+        0x57 => K_NUM_PLUS,
+        0x58 => K_NUM_ENTER,
+        0x59..=0x62 => {
+            const NUMPAD: [u8; 10] = [
+                K_NUM_1, K_NUM_2, K_NUM_3, K_NUM_4, K_NUM_5, K_NUM_6, K_NUM_7, K_NUM_8, K_NUM_9,
+                K_NUM_0,
+            ];
+            NUMPAD[usize::from(usage - 0x59)]
+        }
+        // Non-US \ and | (the < > key on German keyboards)
+        0x64 => 0x56,
+        0x65 => K_APP,
+        0x66 => K_POWER,
+        0xE0 => K_LEFT_CTRL,
+        0xE1 => K_LEFT_SHIFT,
+        0xE2 => K_ALT,
+        0xE3 => K_LEFT_SUPER,
+        0xE4 => K_RIGHT_CTRL,
+        0xE5 => K_RIGHT_SHIFT,
+        0xE6 => K_ALT_GR,
+        0xE7 => K_RIGHT_SUPER,
+        _ => return None,
+    })
+}
