From 11f7974ad341e3dd7fa8607b92559f3e2098bf2d Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Wed, 11 Nov 2026 15:27:44 +0000
Subject: [PATCH] netstack, dhcpd: default name server from /etc/net/dns, local
 domain from DHCP

For redox-rpi #290 (relibc reads the name server from netcfg now):
- netstack starts with the name server from /etc/net/dns instead of a
  fixed 8.8.8.8, so resolv/nameserver gives the image default until DHCP
  sets one.
- netcfg has resolv/domain: the local domain, empty when none is known.
- dhcpd asks for options 1, 3, 6 and 15 (Parameter Request List), reads
  the domain name (option 15) and writes it to resolv/domain.
---
 dhcpd/src/main.rs                 | 27 +++++++++++++++++++-
 netstack/src/scheme/netcfg/mod.rs | 42 ++++++++++++++++++++++++++++++-
 2 files changed, 67 insertions(+), 2 deletions(-)

diff --git a/dhcpd/src/main.rs b/dhcpd/src/main.rs
index 1eb4f1d2..57299401 100644
--- a/dhcpd/src/main.rs
+++ b/dhcpd/src/main.rs
@@ -106,6 +106,8 @@ struct Lease {
     mask_len: u32,
     router: Option<[u8; 4]>,
     dns: Option<[u8; 4]>,
+    /// Domain name (option 15), for names without a dot (#290).
+    domain: Option<String>,
 }
 
 /// Options of a DHCP reply that dhcpd uses.
@@ -116,6 +118,7 @@ struct Reply {
     subnet: Option<[u8; 4]>,
     router: Option<[u8; 4]>,
     dns: Option<[u8; 4]>,
+    domain: Option<String>,
     server_id: Option<[u8; 4]>,
 }
 
@@ -123,6 +126,17 @@ fn ipv4(data: &[u8]) -> Option<[u8; 4]> {
     (data.len() >= 4).then(|| [data[0], data[1], data[2], data[3]])
 }
 
+/// A domain name option: ASCII letters, digits, '-' and '.', without the
+/// trailing dot or NUL some servers add; None if empty or anything else.
+fn domain(data: &[u8]) -> Option<String> {
+    let name = std::str::from_utf8(data).ok()?;
+    let name = name.trim_end_matches('\0').trim().trim_end_matches('.');
+    let valid = !name.is_empty()
+        && name.len() <= 253
+        && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'.');
+    valid.then(|| name.to_string())
+}
+
 fn fmt_ip(ip: [u8; 4]) -> String {
     format!("{}.{}.{}.{}", ip[0], ip[1], ip[2], ip[3])
 }
@@ -166,6 +180,7 @@ fn parse_reply(data: &[u8], tid: u32, mac: &MacAddr, verbose: bool) -> Option<Re
                     1 if reply.subnet.is_none() => reply.subnet = ipv4(data),
                     3 if reply.router.is_none() => reply.router = ipv4(data),
                     6 if reply.dns.is_none() => reply.dns = ipv4(data),
+                    15 if reply.domain.is_none() => reply.domain = domain(data),
                     53 if !data.is_empty() => reply.msg_type = data[0],
                     54 => reply.server_id = ipv4(data),
                     _ => (),
@@ -273,7 +288,8 @@ fn dhcp(iface: &str, timeout: Duration, verbose: bool) -> Result<Lease, String>
 
     // DHCP Message Type (Discover), End
     try_fmt!(
-        send(&socket, &message(&mac, tid, &[53, 1, 1, 255])),
+        // Parameter Request List: subnet mask, router, DNS, domain name.
+        send(&socket, &message(&mac, tid, &[53, 1, 1, 55, 4, 1, 3, 6, 15, 255])),
         "failed to send discover"
     );
     if verbose {
@@ -311,6 +327,7 @@ fn dhcp(iface: &str, timeout: Duration, verbose: bool) -> Result<Lease, String>
         53, 1, 3, // DHCP Message Type (Request)
         50, 4, y[0], y[1], y[2], y[3], // Requested IP Address
         54, 4, s[0], s[1], s[2], s[3], // Server Identifier
+        55, 4, 1, 3, 6, 15, // Parameter Request List
         255,
     ];
     try_fmt!(
@@ -334,11 +351,14 @@ fn dhcp(iface: &str, timeout: Duration, verbose: bool) -> Result<Lease, String>
         }
     }
 
+    let domain = ack.domain.or(offer.domain);
+
     Ok(Lease {
         addr: offer.yiaddr,
         mask_len,
         router,
         dns,
+        domain,
     })
 }
 
@@ -379,6 +399,11 @@ fn apply_default(iface: &str, lease: &Lease, verbose: bool) -> Result<(), String
     } else {
         println!("DHCP: {iface}: no DNS resolver");
     }
+    // Always written, so a lease without a domain clears an older one.
+    let domain = lease.domain.as_deref().unwrap_or("");
+    if set_cfg_value("resolv/domain", &format!("{domain}\n")).is_ok() && verbose && !domain.is_empty() {
+        println!("DHCP: domain {domain}");
+    }
     Ok(())
 }
 
diff --git a/netstack/src/scheme/netcfg/mod.rs b/netstack/src/scheme/netcfg/mod.rs
index fcd5d415..dae64a9a 100644
--- a/netstack/src/scheme/netcfg/mod.rs
+++ b/netstack/src/scheme/netcfg/mod.rs
@@ -103,6 +103,37 @@ fn mk_root_node(
                     }
                     Ok(())
                 }
+            },
+            // The local domain from DHCP (option 15), for names without a
+            // dot (redox-rpi #290); empty when none is known.
+            "domain" => {
+                rw [dns_config, notifier] (Option<String>, None)
+                || {
+                    format!("{}\n", dns_config.borrow().domain)
+                }
+                |cur_value, line| {
+                    if cur_value.is_none() {
+                        let domain = line.trim().trim_end_matches('.');
+                        let valid = domain.len() <= 253
+                            && domain
+                                .bytes()
+                                .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'.');
+                        if !valid {
+                            return Err(SyscallError::new(syscall::EINVAL));
+                        }
+                        *cur_value = Some(domain.to_string());
+                        Ok(())
+                    } else {
+                        Err(SyscallError::new(syscall::EINVAL))
+                    }
+                }
+                |cur_value| {
+                    if let Some(domain) = cur_value.clone() {
+                        dns_config.borrow_mut().domain = domain;
+                        notifier.borrow_mut().schedule_notify("resolv/domain");
+                    }
+                    Ok(())
+                }
             }
         },
         "route" => {
@@ -361,6 +392,7 @@ fn prefer_default_source(iface: &Interface, route_table: &RouteTable) {
 
 struct DNSConfig {
     name_server: Ipv4Address,
+    domain: String,
 }
 
 type DNSConfigRef = Rc<RefCell<DNSConfig>>;
@@ -435,8 +467,16 @@ impl NetCfgScheme {
         devices: Rc<RefCell<DeviceList>>,
     ) -> Result<NetCfgScheme> {
         let notifier = Notifier::new_ref();
+        // Until DHCP gives one: the image's /etc/net/dns, so programs
+        // that read resolv/nameserver use the same server as before
+        // (redox-rpi #290).
+        let name_server = super::getcfg("dns")
+            .ok()
+            .and_then(|dns| Ipv4Address::from_str(&dns).ok())
+            .unwrap_or(Ipv4Address::new(8, 8, 8, 8));
         let dns_config = Rc::new(RefCell::new(DNSConfig {
-            name_server: Ipv4Address::new(8, 8, 8, 8),
+            name_server,
+            domain: String::new(),
         }));
         let mut inner = NetCfgSchemeInner {
             handles: HandleMap::new(),
-- 
2.53.0

