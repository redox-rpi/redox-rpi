+fn parse_ip(text: &str) -> Option<[u8; 4]> {
+    text.trim().parse::<std::net::Ipv4Addr>().ok().map(|ip| ip.octets())
+}
+
+/// The lease for `ipv4 = "static"`: `address` as `a.b.c.d/len` (needed),
+/// `router` and the first of `dns` (both optional).
+fn static_lease(cfg: &IfaceConfig) -> Result<Lease, String> {
+    let address = cfg.address.as_deref().ok_or("ipv4 = \"static\" needs address = \"a.b.c.d/len\"")?;
+    let (ip, len) = address
+        .split_once('/')
+        .ok_or_else(|| format!("address = {address:?}, expected \"a.b.c.d/len\""))?;
+    let addr = parse_ip(ip).ok_or_else(|| format!("address = {address:?}: not an IPv4 address"))?;
+    let mask_len = match len.trim().parse::<u32>() {
+        Ok(len) if len <= 32 => len,
+        _ => return Err(format!("address = {address:?}: prefix length must be 0 to 32")),
+    };
+    let router = match cfg.router.as_deref() {
+        Some(r) => Some(parse_ip(r).ok_or_else(|| format!("router = {r:?}: not an IPv4 address"))?),
+        None => None,
+    };
+    let dns = match cfg.dns.as_deref().and_then(|d| d.first()) {
+        Some(d) => Some(parse_ip(d).ok_or_else(|| format!("dns = {d:?}: not an IPv4 address"))?),
+        None => None,
+    };
+    Ok(Lease { addr, mask_len, router, dns, domain: None })
 }
 
