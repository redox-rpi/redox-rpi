+/// Sets a fixed address from the configuration.
+fn set_static(iface: &str, lease: &Lease) -> Result<(), String> {
+    try_fmt!(
+        set_iface_cfg_value(
+            iface,
+            "addr/set",
+            &format!("{}/{}\n", fmt_ip(lease.addr), lease.mask_len)
+        ),
+        "failed to set ip"
+    );
+    println!("DHCP: {iface} fixed address {}/{}", fmt_ip(lease.addr), lease.mask_len);
+    Ok(())
+}
