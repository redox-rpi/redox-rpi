From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Tue, 24 Nov 2026 11:59:37 +0000
Subject: [PATCH] Raspberry Pi: the initfs holds only what mounting root needs

The initfs stays in memory until power-off (redox-rpi#642).

- Its programs are stripped (cookbook strips the package's programs, but
  the initfs is packed before that): about 25 -> 16 MiB.
- On the Pi (BOARD=raspi3bp) it no longer holds ACPI, PCI, NVMe, virtio,
  rtcd, hwd, the Arasan SD driver or PS/2, none of which start there.
- GPIO, I2C, SPI, sound and the DWC2 USB driver start from the root
  filesystem: their programs go to /usr/bin, their units to
  /usr/lib/init.d, and netstack and audiod wait for them.
---
 Makefile | 41 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/Makefile b/Makefile
index 29a06463..664d29f8 100644
--- a/Makefile
+++ b/Makefile
@@ -34,6 +34,27 @@ ifeq ($(TARGET),aarch64-unknown-redox)
 	INITFS_BINS += bcm2835-sdhcid bcm2835-sdhostd dwc2d
 endif
 
+# redox-rpi#642: on the Raspberry Pi (BOARD=raspi3bp) the initfs holds only
+# what mounting the root filesystem needs. Left out: ACPI, PCI, NVMe, virtio,
+# rtcd and hwd (nothing to find on the Pi), the old Arasan SD driver
+# (bcm2835-sdhostd serves the card) and PS/2. GPIO, I2C, SPI, sound and USB
+# start from the root filesystem: their programs go to /usr/bin, their units
+# to /usr/lib/init.d. The initfs stays in memory until power-off, so every
+# byte left out is free memory.
+ifeq ($(BOARD),raspi3bp)
+	PI_ROOT_BINS = bcm2835-gpiod bcm2835-i2cd bcm2835-spid bcm2835-pwmaudiod dwc2d
+	PI_ROOT_UNITS = 40_bcm2835-gpiod.service 41_bcm2835-i2cd.service \
+		41_bcm2835-spid.service 41_bcm2835-pwmaudiod.service 40_dwc2d.service
+	PI_DROP_UNITS = 00_rtcd.service 40_hwd.service 40_pcid-spawner-initfs.service \
+		40_ps2d.service
+	INITFS_BINS := $(filter-out acpid hwd pcid pcid-spawner rtcd bcm2835-sdhcid \
+		$(PI_ROOT_BINS),$(INITFS_BINS))
+	INITFS_DRIVERS_BINS :=
+	BASE_BINS += bcm2835-sdhcid $(PI_ROOT_BINS)
+endif
+
+INITFS_STRIP ?= $(TARGET)-strip
+
 # For testing/benchmarking only
 # BASE_BINS += drawbench
 
@@ -116,10 +137,30 @@ install-base: base $(SYSROOT)/bin/redoxfs
 		cp -v "$(TARGET_DIR)/$$bin" "$(BUILD_DIR)/initfs/lib/drivers"; \
 	done
 	cp "$(SYSROOT)/bin/redoxfs" "$(BUILD_DIR)/initfs/bin"
+# redox-rpi#642: cookbook strips the programs of the package, but the initfs
+# is packed before that; strip its programs here (about 25 -> 16 MiB)
+ifeq ($(COOKBOOK_NOSTRIP),)
+	find "$(BUILD_DIR)/initfs/bin" "$(BUILD_DIR)/initfs/lib/drivers" -type f \
+		-exec $(INITFS_STRIP) --strip-unneeded {} +
+endif
 # Copy initfs config files
 	@mkdir -p "$(BUILD_DIR)/initfs/lib/init.d" "$(BUILD_DIR)/initfs/lib/pcid.d"
 	cp "$(SRC_DIR)/init.initfs.d"/* "$(BUILD_DIR)/initfs/lib/init.d/"
 	cp "$(SRC_DIR)/drivers/initfs.toml" "$(BUILD_DIR)/initfs/lib/pcid.d/initfs.toml"
+# redox-rpi#642: units that start from root or not at all, out of the
+# initfs and out of the targets that list them
+	@for unit in $(PI_ROOT_UNITS); do \
+		mv -v "$(BUILD_DIR)/initfs/lib/init.d/$$unit" "$(DESTDIR)/usr/lib/init.d/"; \
+	done
+	@for unit in $(PI_ROOT_UNITS) $(PI_DROP_UNITS); do \
+		rm -fv "$(BUILD_DIR)/initfs/lib/init.d/$$unit"; \
+		sed -i "/\"$$unit\"/d" "$(BUILD_DIR)/initfs/lib/init.d/"*.target; \
+	done
+	@[ -z "$(PI_DROP_UNITS)" ] || rm -rfv "$(BUILD_DIR)/initfs/lib/pcid.d" "$(BUILD_DIR)/initfs/lib/drivers"
+	@[ -z "$(PI_ROOT_UNITS)" ] || { \
+		sed -i 's/^requires_weak = \[$$/&\n    "40_dwc2d.service",/' "$(DESTDIR)/usr/lib/init.d/10_smolnetd.service"; \
+		sed -i 's/^requires_weak = \[$$/&\n    "41_bcm2835-pwmaudiod.service",/' "$(DESTDIR)/usr/lib/init.d/20_audiod.service"; \
+	}
 # Build initfs
 	$(CARGO_HOST) run --manifest-path "$(SRC_DIR)/initfs/tools/Cargo.toml" --bin redox-initfs-ar -- \
 		"$(BUILD_DIR)/initfs" "$(TARGET_DIR)/bootstrap" -o "$(BUILD_DIR)/initfs.img"
-- 
