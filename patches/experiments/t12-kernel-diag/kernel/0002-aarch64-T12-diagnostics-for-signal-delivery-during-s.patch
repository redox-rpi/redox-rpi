From 3edc2f5b9d7bae66aedd57fc59b6f892baf9ee8f Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Wed, 28 Oct 2026 07:32:58 +0000
Subject: [PATCH] aarch64: T12 diagnostics for signal delivery during syscalls

---
 src/arch/aarch64/interrupt/exception.rs | 24 ++++++++++++++++++++++++
 src/context/signal.rs                   | 10 ++++++++++
 2 files changed, 34 insertions(+)

diff --git a/src/arch/aarch64/interrupt/exception.rs b/src/arch/aarch64/interrupt/exception.rs
index c6ec44b1..7dfb7fc3 100644
--- a/src/arch/aarch64/interrupt/exception.rs
+++ b/src/arch/aarch64/interrupt/exception.rs
@@ -197,6 +197,30 @@ exception_stack!(synchronous_exception_at_el0, |stack| {
                     scratch.x5, &mut token,
                 );
                 stack.scratch.x0 = ret;
+                // Diagnostics (redox-rpi, T12)
+                let nr = stack.scratch.x8;
+                if nr == 158
+                    && stack.scratch.x1 == !0
+                    && (ret != 0 || stack.scratch.x0 != 0 || stack.iret.elr_el1 != elr)
+                {
+                    let regs_addr = {
+                        let context_lock = crate::context::current();
+                        let mut context = context_lock.write(token.token());
+                        context.regs_mut().map_or(0, |r| r as *mut _ as usize)
+                    };
+                    let (x0_now, elr_now) = (stack.scratch.x0, stack.iret.elr_el1);
+                    let frame = stack as *mut _ as usize;
+                    error!(
+                        "t12diag: verify yield ret {:#x} x0 {:#x} elr {:#x} -> {:#x}, frame {:#x}, regs_mut {:#x}",
+                        ret, x0_now, elr, elr_now, frame, regs_addr
+                    );
+                }
+                if nr == 158 && ret != 0 {
+                    error!("t12diag: SYS_YIELD returned {:#x}, elr changed: {}", ret, stack.iret.elr_el1 != elr);
+                }
+                if stack.iret.elr_el1 != elr {
+                    error!("t12diag: handler set up during syscall {} (ret {:#x})", nr, ret);
+                }
                 if stack.iret.elr_el1 != elr {
                     // A signal handler was set up during the syscall.
                     crate::context::signal::set_saved_syscall_ret(ret, &mut token);
diff --git a/src/context/signal.rs b/src/context/signal.rs
index cd6215c6..82e8202c 100644
--- a/src/context/signal.rs
+++ b/src/context/signal.rs
@@ -68,6 +68,7 @@ pub fn signal_handler(token: &mut CleanLockToken) {
     let sigh_instr_ptr = st.user_handler.get();
 
     let mut context = context.upgrade();
+    let ctx_name = context.name.clone();
     let Some(regs) = context.regs_mut() else {
         // TODO: is this even reachable?
         trace!("No registers, returning");
@@ -76,6 +77,15 @@ pub fn signal_handler(token: &mut CleanLockToken) {
 
     let ip = regs.instr_pointer();
     let archdep_reg = regs.sig_archdep_reg();
+    // Diagnostics (redox-rpi, T12)
+    error!(
+        "t12diag: deliver to {}, inside syscall {}, saved ip {:#x} x0 {:#x}, handler {:#x}",
+        ctx_name,
+        crate::percpu::PercpuBlock::current().inside_syscall.get(),
+        ip,
+        archdep_reg,
+        sigh_instr_ptr
+    );
 
     regs.set_instr_pointer(sigh_instr_ptr);
 
-- 
