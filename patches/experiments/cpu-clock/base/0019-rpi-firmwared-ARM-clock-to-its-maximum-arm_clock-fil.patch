From be39134f57e48cb48ee9309252df7946d176390d Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Wed, 28 Oct 2026 09:11:19 +0100
Subject: [PATCH] rpi-firmwared: ARM clock to its maximum, arm_clock file,
 throttle watch

The firmware starts the ARM cores at 600 MHz; the Pi 3B+ runs at up to
1.4 GHz. At start the driver sets the ARM clock to the firmware's maximum,
as Linux's performance governor would; the firmware raises the voltage
and lowers the clock again by itself when the SoC gets hot or the supply
voltage drops.

/scheme/rpi-firmware/arm_clock shows the ARM clock in Hz; writing a rate,
`max` or `min` sets it, for comparisons.

A thread reads the throttling flags every 5 seconds and logs each change
(undervoltage, clock capped, throttled, soft temperature limit) with the
temperature and the ARM clock, like Linux's raspberrypi-hwmon.
---
 drivers/rpi-firmwared/src/main.rs | 148 ++++++++++++++++++++++++++++--
 drivers/rpi-firmwared/src/mbox.rs |  19 ++++
 2 files changed, 157 insertions(+), 10 deletions(-)

diff --git a/drivers/rpi-firmwared/src/main.rs b/drivers/rpi-firmwared/src/main.rs
index 287c0ce..4a7a018 100644
--- a/drivers/rpi-firmwared/src/main.rs
+++ b/drivers/rpi-firmwared/src/main.rs
@@ -13,16 +13,25 @@
 //! - `/scheme/rpi-firmware/clocks`: one line per clock: name, current and
 //!   maximum rate in Hz
 //! - `/scheme/rpi-firmware/board`: one `key value` line per board property
+//! - `/scheme/rpi-firmware/arm_clock`: the ARM clock in Hz; writing a rate
+//!   in Hz, `max` or `min` sets it
+//!
+//! At start it sets the ARM clock to its maximum; the firmware lowers it by
+//! itself when the SoC gets too hot or the supply voltage too low. A thread
+//! checks the throttling flags every few seconds and logs when they change.
 
 use std::fmt::Write as _;
 use std::process;
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::Duration;
 
 use fdt::Fdt;
 use redox_scheme::scheme::SchemeSync;
 use redox_scheme::{CallerCtx, OpenResult, Socket};
 use scheme_utils::{Blocking, FpathWriter, HandleMap};
 use syscall::dirent::{DirEntry, DirentBuf, DirentKind};
-use syscall::error::{Error, Result, EACCES, EBADF, EISDIR, ENOENT, ENOTDIR, EROFS};
+use syscall::error::{Error, Result, EACCES, EBADF, EINVAL, EISDIR, ENOENT, ENOTDIR, EROFS};
 use syscall::schemev2::NewFdFlags;
 use syscall::{MODE_DIR, MODE_FILE, O_WRONLY};
 
@@ -35,24 +44,34 @@ use mbox::*;
 const MBOX_BUS_ADDR: usize = 0x7e00_b880;
 const PAGE_SIZE: usize = 4096;
 
-const FILES: &[&str] = &["board", "clocks", "temperature", "throttled"];
+const FILES: &[&str] = &["arm_clock", "board", "clocks", "temperature", "throttled"];
+/// Files that can be written: settings.
+const WRITABLE: &[&str] = &["arm_clock"];
+
+const THROTTLE_POLL: Duration = Duration::from_secs(5);
 
 enum Handle {
     Root,
     Dir,
     File(Vec<u8>),
+    /// A setting opened for writing, by file name.
+    Setting(&'static str),
 }
 
 struct FirmwareScheme {
-    mbox: Mailbox,
+    mbox: Arc<Mutex<Mailbox>>,
     handles: HandleMap<Handle>,
 }
 
 impl FirmwareScheme {
     fn contents(&mut self, name: &str) -> Result<String> {
         let mut text = String::new();
-        let mbox = &mut self.mbox;
+        let mbox = &mut *self.mbox.lock().unwrap();
         match name {
+            "arm_clock" => {
+                let value = mbox.value_of(TAG_GET_CLOCK_RATE, CLOCK_ARM).map_err(log)?;
+                writeln!(text, "{value}").unwrap();
+            }
             "temperature" => {
                 let value = mbox.value_of(TAG_GET_TEMPERATURE, 0).map_err(log)?;
                 writeln!(text, "{value}").unwrap();
@@ -79,6 +98,80 @@ impl FirmwareScheme {
         }
         Ok(text)
     }
+
+    fn set(&mut self, name: &str, value: &str) -> Result<()> {
+        let mbox = &mut *self.mbox.lock().unwrap();
+        match name {
+            "arm_clock" => {
+                let rate = match value {
+                    "max" => mbox.value_of(TAG_GET_MAX_CLOCK_RATE, CLOCK_ARM).map_err(log)?,
+                    "min" => mbox.value_of(TAG_GET_MIN_CLOCK_RATE, CLOCK_ARM).map_err(log)?,
+                    hz => hz.parse().map_err(|_| Error::new(EINVAL))?,
+                };
+                let rate = mbox.set_clock(CLOCK_ARM, rate).map_err(log)?;
+                println!("rpi-firmwared: ARM clock {} MHz", rate / 1_000_000);
+                Ok(())
+            }
+            _ => Err(Error::new(EROFS)),
+        }
+    }
+}
+
+/// Sets the ARM clock to its maximum and says from what to what.
+fn arm_clock_max(mbox: &mut Mailbox) {
+    let before = mbox.value_of(TAG_GET_CLOCK_RATE, CLOCK_ARM);
+    let result = mbox
+        .value_of(TAG_GET_MAX_CLOCK_RATE, CLOCK_ARM)
+        .and_then(|max| mbox.set_clock(CLOCK_ARM, max));
+    match (before, result) {
+        (Ok(before), Ok(after)) => println!(
+            "rpi-firmwared: ARM clock {} -> {} MHz",
+            before / 1_000_000,
+            after / 1_000_000
+        ),
+        (_, Err(err)) | (Err(err), _) => eprintln!("rpi-firmwared: ARM clock not set: {err}"),
+    }
+}
+
+/// What the low bits of the throttling flags mean.
+const THROTTLE_BITS: &[(u32, &str)] = &[
+    (1 << 0, "undervoltage"),
+    (1 << 1, "ARM clock capped"),
+    (1 << 2, "throttled"),
+    (1 << 3, "soft temperature limit"),
+];
+
+/// Logs every change of the throttling flags, so a weak power supply or a
+/// hot SoC shows up in the boot log instead of as random errors.
+fn watch_throttling(mbox: Arc<Mutex<Mailbox>>) {
+    let mut last = 0;
+    loop {
+        let flags = mbox.lock().unwrap().property(TAG_GET_THROTTLED, &[0], 1);
+        if let Ok([flags]) = flags.as_deref() {
+            let now = flags & 0xf;
+            if now != last {
+                let active: Vec<&str> = THROTTLE_BITS
+                    .iter()
+                    .filter(|(bit, _)| now & bit != 0)
+                    .map(|(_, name)| *name)
+                    .collect();
+                if active.is_empty() {
+                    println!("rpi-firmwared: no longer throttled");
+                } else {
+                    let temperature = mbox.lock().unwrap().value_of(TAG_GET_TEMPERATURE, 0);
+                    let arm = mbox.lock().unwrap().value_of(TAG_GET_CLOCK_RATE, CLOCK_ARM);
+                    println!(
+                        "rpi-firmwared: warning: {} (flags 0x{flags:08x}, {:.1} °C, ARM {} MHz)",
+                        active.join(", "),
+                        temperature.unwrap_or(0) as f32 / 1000.0,
+                        arm.unwrap_or(0) / 1_000_000
+                    );
+                }
+                last = now;
+            }
+        }
+        thread::sleep(THROTTLE_POLL);
+    }
 }
 
 fn log(err: String) -> Error {
@@ -161,10 +254,14 @@ impl SchemeSync for FirmwareScheme {
         let path = path.trim_matches('/');
         let handle = if path.is_empty() {
             Handle::Dir
-        } else {
-            if flags & O_WRONLY != 0 {
-                return Err(Error::new(EROFS));
+        } else if flags & O_WRONLY != 0 {
+            // O_RDWR includes the O_WRONLY bit.
+            match WRITABLE.iter().find(|name| **name == path) {
+                Some(name) => Handle::Setting(name),
+                None if FILES.contains(&path) => return Err(Error::new(EROFS)),
+                None => return Err(Error::new(ENOENT)),
             }
+        } else {
             Handle::File(self.contents(path)?.into_bytes())
         };
         Ok(OpenResult::ThisScheme {
@@ -181,8 +278,10 @@ impl SchemeSync for FirmwareScheme {
         _fcntl_flags: u32,
         _ctx: &CallerCtx,
     ) -> Result<usize> {
-        let Handle::File(data) = self.handles.get(id)? else {
-            return Err(Error::new(EISDIR));
+        let data = match self.handles.get(id)? {
+            Handle::File(data) => data,
+            Handle::Setting(_) => return Err(Error::new(EBADF)),
+            _ => return Err(Error::new(EISDIR)),
         };
         let start = usize::try_from(offset).unwrap_or(usize::MAX).min(data.len());
         let len = buf.len().min(data.len() - start);
@@ -190,6 +289,31 @@ impl SchemeSync for FirmwareScheme {
         Ok(len)
     }
 
+    fn write(
+        &mut self,
+        id: usize,
+        buf: &[u8],
+        _offset: u64,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<usize> {
+        let Handle::Setting(name) = self.handles.get(id)? else {
+            return Err(Error::new(EBADF));
+        };
+        let name = *name;
+        let value = std::str::from_utf8(buf).map_err(|_| Error::new(EINVAL))?.trim();
+        self.set(name, value)?;
+        Ok(buf.len())
+    }
+
+    // Shells truncate a file before writing to it.
+    fn ftruncate(&mut self, id: usize, _len: u64, _ctx: &CallerCtx) -> Result<()> {
+        match self.handles.get(id)? {
+            Handle::Setting(_) => Ok(()),
+            _ => Err(Error::new(EROFS)),
+        }
+    }
+
     fn getdents<'buf>(
         &mut self,
         id: usize,
@@ -217,6 +341,7 @@ impl SchemeSync for FirmwareScheme {
                 stat.st_mode = 0o444 | MODE_FILE;
                 stat.st_size = data.len() as u64;
             }
+            Handle::Setting(_) => stat.st_mode = 0o644 | MODE_FILE,
             Handle::Dir | Handle::Root => stat.st_mode = 0o555 | MODE_DIR,
         }
         Ok(())
@@ -282,8 +407,9 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
             + (phys - page)
     } as *mut u32;
     let mbox = Mailbox::new(regs).expect("rpi-firmwared: failed to allocate the message buffer");
+    let mbox = Arc::new(Mutex::new(mbox));
     let mut scheme = FirmwareScheme {
-        mbox,
+        mbox: mbox.clone(),
         handles: HandleMap::new(),
     };
     match scheme.contents("board") {
@@ -293,6 +419,8 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
         }
         Err(_) => println!("rpi-firmwared: mailbox at 0x{phys:08x} does not answer"),
     }
+    arm_clock_max(&mut mbox.lock().unwrap());
+    thread::spawn(move || watch_throttling(mbox));
 
     let socket = Socket::create().expect("rpi-firmwared: failed to create the rpi-firmware scheme");
     let handler = Blocking::new(Box::new(socket), 16);
diff --git a/drivers/rpi-firmwared/src/mbox.rs b/drivers/rpi-firmwared/src/mbox.rs
index 327a773..737398e 100644
--- a/drivers/rpi-firmwared/src/mbox.rs
+++ b/drivers/rpi-firmwared/src/mbox.rs
@@ -42,6 +42,11 @@ pub const TAG_GET_MAX_CLOCK_RATE: u32 = 0x0003_0004;
 pub const TAG_GET_TEMPERATURE: u32 = 0x0003_0006;
 pub const TAG_GET_MAX_TEMPERATURE: u32 = 0x0003_000a;
 pub const TAG_GET_THROTTLED: u32 = 0x0003_0046;
+pub const TAG_GET_MIN_CLOCK_RATE: u32 = 0x0003_0007;
+pub const TAG_SET_CLOCK_RATE: u32 = 0x0003_8002;
+
+/// Clock id of the ARM cores.
+pub const CLOCK_ARM: u32 = 3;
 
 /// Clocks the firmware knows, by id.
 pub const CLOCKS: &[(u32, &str)] = &[
@@ -62,6 +67,10 @@ pub struct Mailbox {
     buf: Dma<[u32; BUF_WORDS]>,
 }
 
+// The registers are a mapping of this process; the scheme and the throttle
+// watch share the mailbox behind a mutex.
+unsafe impl Send for Mailbox {}
+
 impl Mailbox {
     /// `regs` points at the mailbox block (MAIL0_READ).
     pub fn new(regs: *mut u32) -> syscall::Result<Self> {
@@ -143,4 +152,14 @@ impl Mailbox {
             _ => Err(format!("tag 0x{tag:08x}: short answer")),
         }
     }
+
+    /// Sets a clock and returns the rate the firmware chose. The firmware
+    /// raises the voltage itself when the ARM clock goes above its default
+    /// (it sets "turbo" unless told not to, the third request word).
+    pub fn set_clock(&mut self, id: u32, rate: u32) -> Result<u32, String> {
+        match self.property(TAG_SET_CLOCK_RATE, &[id, rate, 0], 2)?[..] {
+            [_, rate] => Ok(rate),
+            _ => Err(format!("set clock {id}: short answer")),
+        }
+    }
 }
