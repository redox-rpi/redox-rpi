From a224ee99349191ea6f81b75e99cc4fe5ee5d94cb Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Tue, 27 Oct 2026 09:03:49 +0100
Subject: [PATCH] aarch64: deliver BCM2835 interrupts to user space drivers

The BCM2835 interrupt controller only called kernel handlers. Lines
without one were dropped and, being level triggered, fired again at
once. Mask such a line, wake the driver through the irq scheme and
unmask it when the driver acknowledges.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/arch/aarch64/device/irqchip/irq_bcm2835.rs | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/arch/aarch64/device/irqchip/irq_bcm2835.rs b/src/arch/aarch64/device/irqchip/irq_bcm2835.rs
index ed9a9b2..a481d8a 100644
--- a/src/arch/aarch64/device/irqchip/irq_bcm2835.rs
+++ b/src/arch/aarch64/device/irqchip/irq_bcm2835.rs
@@ -7,6 +7,7 @@ use crate::{
         irqchip::{InterruptHandler, IrqCell, IrqDesc, IRQ_CHIP},
         Fdt, FdtNode,
     },
+    scheme::irq::irq_trigger,
     sync::CleanLockToken,
 };
 use fdt::properties::PHandle;
@@ -215,7 +216,11 @@ impl InterruptController for Bcm2835ArmInterruptController {
         }
     }
 
-    fn irq_eoi(&mut self, _irq_num: u32) {}
+    // A line handed to user space is masked until the driver acknowledges
+    // it, because this controller has no active state like the GIC.
+    fn irq_eoi(&mut self, irq_num: u32) {
+        self.irq_enable(irq_num);
+    }
 
     fn irq_enable(&mut self, irq_num: u32) {
         debug!("bcm2835 enable {} {}", irq_num, irq_num & 0x1f);
@@ -296,6 +301,12 @@ impl InterruptHandler for Bcm2835ArmInterruptController {
             {
                 if let Some(handler) = &mut IRQ_CHIP.irq_desc[virq].handler {
                     handler.irq_handler(virq as u32, token);
+                } else if virq < 256 {
+                    // No kernel handler: wake the user space driver. The line
+                    // stays masked until it writes the acknowledgement.
+                    self.irq_disable(irq);
+                    irq_trigger(virq as u8, token);
+                    return;
                 }
             } else {
                 error!("unexpected irq num {}", irq);
