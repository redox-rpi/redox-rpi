@@ -132,6 +133,15 @@ impl Dwc2 {
         Ok(())
     }
 
+    /// Raise the controller's interrupt when channel `ch` halts. Only that
+    /// channel: all other transfers wait for their channel by polling.
+    pub fn enable_rx_interrupt(&self, ch: usize) {
+        self.write(hcintmsk(ch), HCINT_CH_HLTD);
+        self.write(HAINTMSK, 1 << ch);
+        self.write(GINTMSK, GINTSTS_HCHINT);
+        self.write(GAHBCFG, self.read(GAHBCFG) | GAHBCFG_GLBL_INTR_EN);
+    }
+
     fn write_port(&self, set: u32, clear: u32) {
         let value = self.read(HPRT0) & !HPRT0_W1C;
         self.write(HPRT0, (value | set) & !clear);
