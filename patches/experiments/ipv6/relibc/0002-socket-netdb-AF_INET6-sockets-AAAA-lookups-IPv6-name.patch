+fn query_server(server: IpAddr, packet_data: &[u8]) -> Result<Dns, Errno> {
+    let (domain, dest) = match server {
+        IpAddr::V4(addr) => {
+            let mut dest = vec![0_u8; size_of::<sockaddr_in>()];
+            *plain::from_mut_bytes(&mut dest).unwrap() = sockaddr_in {
+                sin_family: u16::try_from(AF_INET).expect("AF_INET is positive and below u16::MAX"),
+                sin_port: htons(53),
+                sin_addr: in_addr {
+                    s_addr: u32::from_ne_bytes(addr.octets()),
+                },
+                ..Default::default()
+            };
+            (AF_INET, dest)
+        }
