 pub fn lookup_host(host: &str) -> Result<LookupHost, Errno> {
+    Ok(lookup_host_family(host, AF_INET)?
+        .into_iter()
+        .filter_map(|addr| match addr {
+            HostAddr::V4(addr) => Some(addr),
+            HostAddr::V6(_) => None,
+        })
+        .collect())
+}
