+/// IPv6 name servers that netstack learned from router advertisements
+/// (RDNSS, RFC 8106), one per line.
+pub fn get_dns_servers_ipv6() -> Vec<core::net::Ipv6Addr> {
+    let mut string = String::new();
+    let Ok(mut file) = File::open(
+        c"/scheme/netcfg/resolv/nameserver6".into(),
+        fcntl::O_RDONLY,
+    ) else {
+        return Vec::new();
+    };
+    if file.read_to_string(&mut string).is_err() {
+        return Vec::new();
+    }
+    string
+        .split_whitespace()
+        .filter_map(|word| word.parse().ok())
+        .collect()
+}
