+/// Looks up `host` with A records for `AF_INET`, AAAA records for
+/// `AF_INET6`, and both (IPv4 first) for anything else.
+pub fn lookup_host_family(host: &str, family: i32) -> Result<Vec<HostAddr>, Errno> {
