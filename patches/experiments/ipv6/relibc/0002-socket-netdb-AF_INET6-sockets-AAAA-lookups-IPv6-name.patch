+    let mut addrs = Vec::new();
+    let mut last_err = None;
+    if family != AF_INET6 {
+        match query(host, TYPE_A) {
+            Ok(response) => addrs.extend(response.answers.into_iter().filter_map(|answer| {
+                let data = <[u8; 4]>::try_from(answer.data.as_slice()).ok()?;
+                (answer.a_type == TYPE_A && answer.a_class == CLASS_IN).then(|| {
+                    HostAddr::V4(in_addr {
+                        s_addr: u32::from_ne_bytes(data),
+                    })
+                })
+            })),
+            Err(err) => last_err = Some(err),
+        }
+    }
+    if family != AF_INET {
+        match query(host, TYPE_AAAA) {
+            Ok(response) => addrs.extend(response.answers.into_iter().filter_map(|answer| {
+                let s6_addr = <[u8; 16]>::try_from(answer.data.as_slice()).ok()?;
+                (answer.a_type == TYPE_AAAA && answer.a_class == CLASS_IN)
+                    .then(|| HostAddr::V6(in6_addr { s6_addr }))
+            })),
+            Err(err) => last_err = Some(err),
+        }
+    }
+
+    match last_err {
+        Some(err) if addrs.is_empty() => Err(err),
+        _ => Ok(addrs),
+    }
