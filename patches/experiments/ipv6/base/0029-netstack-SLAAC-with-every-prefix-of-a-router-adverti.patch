+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MAC: EthernetAddress = EthernetAddress([0xb8, 0x27, 0xeb, 0x08, 0xe0, 0xaa]);
+
+    /// A router advertisement (ICMPv6 header and RA fields) with prefix
+    /// options for the given prefixes and valid lifetimes.
+    fn ra(prefixes: &[([u16; 4], u32)]) -> Vec<u8> {
+        let mut icmp = vec![134, 0, 0, 0, 64, 0, 0x07, 0x08, 0, 0, 0, 0, 0, 0, 0, 0];
+        // source link-layer address option first, as routers send it
+        icmp.extend_from_slice(&[1, 1, 0xb4, 0xfc, 0x7d, 0x53, 0xb2, 0x89]);
+        for (p, valid) in prefixes {
+            icmp.extend_from_slice(&[3, 4, 64, 0xc0]);
+            icmp.extend_from_slice(&valid.to_be_bytes());
+            icmp.extend_from_slice(&valid.to_be_bytes());
+            icmp.extend_from_slice(&[0; 4]);
+            for s in p {
+                icmp.extend_from_slice(&s.to_be_bytes());
+            }
+            icmp.extend_from_slice(&[0; 8]);
+        }
+        icmp
+    }
+
+    #[test]
+    fn global_and_unique_local_prefix() {
+        // The Fritz!Box in tests #47/#55: unique local prefix last.
+        let msg = ra(&[([0x2a02, 0x590, 0x1507, 0xc201], 7200), ([0xfdeb, 0xd4ef, 0xa7ac, 0], 7200)]);
+        let infos = prefix_infos(&msg);
+        assert_eq!(infos.len(), 2);
+        let mut addrs = Vec::new();
+        apply_prefixes(&mut addrs, &infos, MAC);
+        let expect: Vec<Ipv6Cidr> = [
+            "2a02:590:1507:c201:ba27:ebff:fe08:e0aa/64",
+            "fdeb:d4ef:a7ac:0:ba27:ebff:fe08:e0aa/64",
+        ]
+        .iter()
+        .map(|s| s.parse().unwrap())
+        .collect();
+        assert_eq!(addrs, expect);
+        // The same advertisement again changes nothing.
+        apply_prefixes(&mut addrs, &infos, MAC);
+        assert_eq!(addrs, expect);
+    }
+
+    #[test]
+    fn unique_local_first_still_sorted() {
+        let mut addrs = Vec::new();
+        apply_prefixes(&mut addrs, &prefix_infos(&ra(&[([0xfdeb, 0xd4ef, 0xa7ac, 0], 7200)])), MAC);
+        apply_prefixes(&mut addrs, &prefix_infos(&ra(&[([0x2a02, 0x590, 0x1507, 0xc201], 7200)])), MAC);
+        assert_eq!(addrs[0].address().segments()[0], 0x2a02);
+        // A valid lifetime of 0 removes only that prefix's address.
+        apply_prefixes(&mut addrs, &prefix_infos(&ra(&[([0x2a02, 0x590, 0x1507, 0xc201], 0)])), MAC);
+        assert_eq!(addrs.len(), 1);
+        assert_eq!(addrs[0].address().segments()[0], 0xfdeb);
+    }
+
+    #[test]
+    fn router_lifetime_zero_from_another_router() {
+        let fritz = Ipv6Address::new(0xfe80, 0, 0, 0, 0xb6fc, 0x7dff, 0xfe53, 0xb289);
+        let other = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 1);
+        let r = next_router(None, fritz, false);
+        assert_eq!(r, Some(fritz));
+        // An advertisement that only announces a prefix keeps the router.
+        assert_eq!(next_router(r, other, true), Some(fritz));
+        assert_eq!(next_router(r, fritz, true), None);
+    }
+
+    #[test]
+    fn truncated_options() {
+        let mut msg = ra(&[([0x2a02, 0x590, 0x1507, 0xc201], 7200)]);
+        msg.truncate(msg.len() - 4);
+        assert!(prefix_infos(&msg).is_empty());
+        assert!(prefix_infos(&msg[..10]).is_empty());
+    }
+}
