+/// A prefix information option (RFC 4861 4.6.2) of a router advertisement.
+#[derive(Debug, PartialEq)]
+struct PrefixInfo {
+    prefix: Ipv6Address,
+    prefix_len: u8,
+    autonomous: bool,
+    valid_lifetime: u32,
+}
+
+/// Every prefix information option of a router advertisement. smoltcp keeps
+/// only the last one, and routers often send a global and a unique local
+/// prefix together.
+fn prefix_infos(icmp: &[u8]) -> Vec<PrefixInfo> {
+    let mut infos = Vec::new();
+    let Some(mut options) = icmp.get(16..) else {
+        return infos;
+    };
+    while options.len() >= 8 {
+        let len = usize::from(options[1]) * 8;
+        if len == 0 || len > options.len() {
+            break;
+        }
+        if options[0] == 3 && len >= 32 {
+            infos.push(PrefixInfo {
+                prefix_len: options[2],
+                autonomous: options[3] & 0x40 != 0,
+                valid_lifetime: u32::from_be_bytes(options[4..8].try_into().unwrap()),
+                prefix: Ipv6Address::from(<[u8; 16]>::try_from(&options[16..32]).unwrap()),
+            });
+        }
+        options = &options[len..];
+    }
+    infos
+}
+
+/// fc00::/7, unique local addresses: reachable only inside the site.
+fn is_unique_local(addr: Ipv6Address) -> bool {
+    addr.octets()[0] & 0xfe == 0xfc
+}
+
+/// Applies the prefixes of a router advertisement to the SLAAC addresses:
+/// a new address per autonomous /64 prefix, none for a prefix whose valid
+/// lifetime is 0. Global addresses come before unique local ones.
+fn apply_prefixes(addrs: &mut Vec<Ipv6Cidr>, infos: &[PrefixInfo], mac: EthernetAddress) {
+    for info in infos {
+        if !info.autonomous || info.prefix_len != 64 || info.prefix.segments()[0] & 0xffc0 == 0xfe80 {
+            continue;
+        }
+        let cidr = Ipv6Cidr::new(eui64_address(info.prefix, mac), 64);
+        let known = addrs.iter().position(|a| *a == cidr);
+        match (known, info.valid_lifetime) {
+            (Some(i), 0) => {
+                addrs.remove(i);
+            }
+            (None, lifetime) if lifetime != 0 => addrs.push(cidr),
+            _ => {}
+        }
+    }
+    addrs.sort_by_key(|a| is_unique_local(a.address()));
+}
+
+/// The router after an advertisement from `src`: a router lifetime of 0
+/// ends only that router, not one learned from another advertisement.
+fn next_router(current: Option<Ipv6Address>, src: Ipv6Address, lifetime_zero: bool) -> Option<Ipv6Address> {
+    match (current, lifetime_zero) {
+        (_, false) => Some(src),
+        (Some(r), true) if r == src => None,
+        (current, true) => current,
+    }
+}
