+                }
                 info!(
-                    "{}: router advertisement from {}: router {:?}, address {:?}",
-                    self.name, src, self.ipv6.router, self.ipv6.global
+                    "{}: router advertisement from {}: router {:?}, address {:?}, dns {:?}",
