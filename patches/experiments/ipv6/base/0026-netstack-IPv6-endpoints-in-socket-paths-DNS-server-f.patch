+    EthernetAddress, HardwareAddress, IpAddress, IpCidr, IpEndpoint, IpListenEndpoint,
+    Ipv4Address, Ipv6Address, Ipv6Cidr,
 };
 use syscall::data::TimeSpec;
 use syscall::{self, Error as SyscallError};
@@ -370,20 +370,48 @@ fn post_fevent(socket: &Socket, id: usize, flags: usize) -> syscall::error::Resu
 }
 
 fn parse_endpoint(socket: &str) -> IpListenEndpoint {
-    let mut socket_parts = socket.split(':');
-    let host = Ipv4Address::from_str(socket_parts.next().unwrap_or(""))
-        .ok()
-        .filter(|addr| !addr.is_unspecified())
-        .map(IpAddress::Ipv4);
-
-    let port = socket_parts
-        .next()
-        .unwrap_or("")
-        .parse::<u16>()
-        .unwrap_or(0);
+    // IPv6 addresses come in brackets: [fe80::1]:5353
+    let (host, port) = if let Some(rest) = socket.strip_prefix('[') {
+        let (host, rest) = rest.split_once(']').unwrap_or((rest, ""));
+        (
+            Ipv6Address::from_str(host).ok().map(IpAddress::Ipv6),
+            rest.strip_prefix(':').unwrap_or(""),
+        )
+    } else {
+        let (host, port) = socket.split_once(':').unwrap_or((socket, ""));
+        (Ipv4Address::from_str(host).ok().map(IpAddress::Ipv4), port)
+    };
+    let host = host.filter(|addr| !addr.is_unspecified());
+    let port = port.parse::<u16>().unwrap_or(0);
     IpListenEndpoint { addr: host, port }
 }
 
+/// An endpoint as it appears in socket paths: `addr:port`, IPv6 addresses
+/// in brackets, `0.0.0.0` for no address.
+pub struct PathEndpoint(pub Option<IpAddress>, pub u16);
+
+impl From<IpEndpoint> for PathEndpoint {
+    fn from(endpoint: IpEndpoint) -> Self {
+        PathEndpoint(Some(endpoint.addr), endpoint.port)
+    }
+}
+
+impl From<IpListenEndpoint> for PathEndpoint {
+    fn from(endpoint: IpListenEndpoint) -> Self {
+        PathEndpoint(endpoint.addr, endpoint.port)
+    }
+}
+
+impl std::fmt::Display for PathEndpoint {
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        match self.0 {
+            Some(IpAddress::Ipv6(addr)) => write!(f, "[{}]:{}", addr, self.1),
+            Some(addr) => write!(f, "{}:{}", addr, self.1),
+            None => write!(f, "0.0.0.0:{}", self.1),
+        }
+    }
+}
