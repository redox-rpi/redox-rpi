 /// ff02::1:ffXX:XXXX, where NDP asks for the owner of `addr`.
+/// The first name server of the RDNSS option (RFC 8106) in a router
+/// advertisement, `Some(None)` when the option says to stop using it.
+/// smoltcp does not parse this option, so read the raw ICMPv6 message.
+fn rdnss_server(icmp: &[u8]) -> Option<Option<Ipv6Address>> {
+    // type, code, checksum, hop limit, flags, lifetime, reachable, retrans
+    let mut options = icmp.get(16..)?;
+    while options.len() >= 8 {
+        let len = usize::from(options[1]) * 8;
+        if len == 0 || len > options.len() {
+            return None;
+        }
+        if options[0] == 25 && len >= 24 {
+            let lifetime = u32::from_be_bytes(options[4..8].try_into().unwrap());
+            let addr = Ipv6Address::from(<[u8; 16]>::try_from(&options[8..24]).unwrap());
+            return Some((lifetime != 0).then_some(addr));
+        }
+        options = &options[len..];
+    }
+    None
+}
+
 fn solicited_node(addr: Ipv6Address) -> Ipv6Address {
     let a = addr.octets();
     Ipv6Address::from([
@@ -376,9 +399,12 @@ impl EthernetLink {
                         });
                     }
                 }
+                if let Some(dns) = rdnss_server(ip.payload()) {
