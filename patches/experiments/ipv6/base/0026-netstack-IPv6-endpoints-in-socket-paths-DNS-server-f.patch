 netstack/src/link/mod.rs          |  2 ++
 netstack/src/scheme/mod.rs        | 54 +++++++++++++++++++++++--------
 netstack/src/scheme/netcfg/mod.rs | 10 ++++++
 netstack/src/scheme/tcp.rs        | 16 +++------
 netstack/src/scheme/udp.rs        | 22 +++----------
 6 files changed, 91 insertions(+), 44 deletions(-)

