From e0bc8188eb7d2e01f83dd8f0b560a5f054b17bda Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 29 Oct 2026 14:14:19 +0100
Subject: [PATCH] netstack: IPv6 multicast groups for programs

IPV6_JOIN_GROUP and IPV6_LEAVE_GROUP join and leave IPv6 groups on the
interface, counted like the IPv4 ones; smoltcp sends the MLD reports.
Other IPPROTO_IPV6 options are accepted and ignored.
---
 netstack/src/link/ethernet.rs | 14 +++++++++----
 netstack/src/link/mod.rs      |  4 ++--
 netstack/src/scheme/mod.rs    |  6 +++---
 netstack/src/scheme/socket.rs | 39 ++++++++++++++++++++++++++++++-----
 4 files changed, 49 insertions(+), 14 deletions(-)

diff --git a/netstack/src/link/ethernet.rs b/netstack/src/link/ethernet.rs
index 7be1966..84a183f 100644
--- a/netstack/src/link/ethernet.rs
+++ b/netstack/src/link/ethernet.rs
@@ -767,15 +767,21 @@ impl LinkDevice for EthernetLink {
         !matches!(file.read_at(&mut state, 0), Ok(1) if state[0] == b'0')
     }
 
-    fn set_multicast(&mut self, groups: &[Ipv4Address]) {
+    fn set_multicast(&mut self, groups: &[IpAddress]) {
         let Some(file) = &mut self.multicast_file else {
             return;
         };
-        // All-hosts (224.0.0.1) always, then each group's MAC (RFC 1112).
+        // All-hosts (224.0.0.1) always, then each group's MAC: IPv4 RFC 1112,
+        // IPv6 RFC 2464.
         let mut list = vec![0x01, 0x00, 0x5e, 0x00, 0x00, 0x01];
         for group in groups {
-            let [_, b1, b2, b3] = group.octets();
-            list.extend_from_slice(&[0x01, 0x00, 0x5e, b1 & 0x7f, b2, b3]);
+            match group {
+                IpAddress::Ipv4(group) => {
+                    let [_, b1, b2, b3] = group.octets();
+                    list.extend_from_slice(&[0x01, 0x00, 0x5e, b1 & 0x7f, b2, b3]);
+                }
+                IpAddress::Ipv6(group) => list.extend_from_slice(&ipv6_multicast_mac(*group).0),
+            }
         }
         if let Err(err) = file.write(&list) {
             warn!("Failed to set the multicast list on link {}: {}", self.name, err);
diff --git a/netstack/src/link/mod.rs b/netstack/src/link/mod.rs
index 85dab78..f69ccf9 100644
--- a/netstack/src/link/mod.rs
+++ b/netstack/src/link/mod.rs
@@ -4,7 +4,7 @@ pub mod loopback;
 use std::rc::Rc;
 
 use smoltcp::time::Instant;
-use smoltcp::wire::{EthernetAddress, IpAddress, IpCidr, Ipv4Address, Ipv6Address, Ipv6Cidr};
+use smoltcp::wire::{EthernetAddress, IpAddress, IpCidr, Ipv6Address, Ipv6Cidr};
 
 /// IPv6 addresses of a link: its link-local address and what stateless
 /// autoconfiguration learned from router advertisements
@@ -47,7 +47,7 @@ pub trait LinkDevice {
     }
 
     /// The joined IPv4 multicast groups, for devices that filter in hardware
-    fn set_multicast(&mut self, _groups: &[Ipv4Address]) {}
+    fn set_multicast(&mut self, _groups: &[IpAddress]) {}
 
     /// Whether the device has a link; devices that cannot tell say yes
     fn link_up(&self) -> bool {
diff --git a/netstack/src/scheme/mod.rs b/netstack/src/scheme/mod.rs
index 67aca58..8b998c7 100644
--- a/netstack/src/scheme/mod.rs
+++ b/netstack/src/scheme/mod.rs
@@ -74,7 +74,7 @@ pub struct Smolnetd {
     netcfg_scheme: NetCfgScheme,
 
     /// The groups last given to the link devices
-    multicast: Option<Vec<Ipv4Address>>,
+    multicast: Option<Vec<IpAddress>>,
 }
 
 impl Smolnetd {
@@ -365,7 +365,7 @@ impl Smolnetd {
 
     /// Give the link devices the joined multicast groups when they changed.
     fn update_multicast(&mut self) {
-        let mut groups: Vec<Ipv4Address> = self
+        let mut groups: Vec<IpAddress> = self
             .ip_scheme
             .multicast_groups()
             .chain(self.udp_scheme.multicast_groups())
@@ -627,7 +627,7 @@ where
         Ok(result)
     }
 
-    pub fn multicast_groups(&self) -> impl Iterator<Item = &Ipv4Address> {
+    pub fn multicast_groups(&self) -> impl Iterator<Item = &IpAddress> {
         self.scheme.multicast_groups()
     }
 
diff --git a/netstack/src/scheme/socket.rs b/netstack/src/scheme/socket.rs
index 6515b68..bd9a29d 100644
--- a/netstack/src/scheme/socket.rs
+++ b/netstack/src/scheme/socket.rs
@@ -14,7 +14,7 @@ use redox_scheme::scheme::{register_scheme_inner, Op, SchemeSync};
 use redox_scheme::{CallerCtx, OpenResult, Socket};
 use scheme_utils::HandleMap;
 use smoltcp::socket::AnySocket;
-use smoltcp::wire::Ipv4Address;
+use smoltcp::wire::{IpAddress, Ipv4Address, Ipv6Address};
 use syscall::data::TimeSpec;
 use syscall::flag::{EVENT_READ, EVENT_WRITE};
 use syscall::schemev2::NewFdFlags;
@@ -35,12 +35,15 @@ const SO_SNDBUF: usize = 7;
 const IPPROTO_IP: u64 = 0;
 const IP_ADD_MEMBERSHIP: usize = 35;
 const IP_DROP_MEMBERSHIP: usize = 36;
+const IPPROTO_IPV6: u64 = 41;
+const IPV6_JOIN_GROUP: usize = 20;
+const IPV6_LEAVE_GROUP: usize = 21;
 
 pub struct Context {
     pub iface: Interface,
     pub route_table: Rc<RefCell<RouteTable>>,
-    /// Joined IPv4 multicast groups and how many joins each has
-    pub multicast_groups: BTreeMap<Ipv4Address, usize>,
+    /// Joined multicast groups and how many joins each has
+    pub multicast_groups: BTreeMap<IpAddress, usize>,
 }
 
 pub struct NullFile {
@@ -338,8 +341,8 @@ where
         Ok(scheme)
     }
 
-    /// The IPv4 multicast groups joined through this scheme
-    pub fn multicast_groups(&self) -> impl Iterator<Item = &Ipv4Address> {
+    /// The IPv4 and IPv6 multicast groups joined through this scheme
+    pub fn multicast_groups(&self) -> impl Iterator<Item = &IpAddress> {
         self.context.multicast_groups.keys()
     }
 
@@ -517,7 +520,30 @@ where
         if !group.is_multicast() || group.is_broadcast() {
             return Err(SyscallError::new(EINVAL));
         }
+        self.join_or_leave(IpAddress::Ipv4(group), join)
+    }
 
+    /// Socket options of level IPPROTO_IPV6, the same for IPv6 groups;
+    /// smoltcp sends the MLD reports. Other options (IPV6_V6ONLY,
+    /// IPV6_MULTICAST_HOPS, ...) are accepted and ignored.
+    fn set_ipv6_option(&mut self, name: usize, payload: &[u8]) -> SyscallResult<usize> {
+        let join = match name {
+            IPV6_JOIN_GROUP => true,
+            IPV6_LEAVE_GROUP => false,
+            _ => return Ok(0),
+        };
+        // struct ipv6_mreq: the group, then the interface index
+        let Some(group) = payload.get(..16) else {
+            return Err(SyscallError::new(EINVAL));
+        };
+        let group = Ipv6Address::from(<[u8; 16]>::try_from(group).unwrap());
+        if !group.is_multicast() {
+            return Err(SyscallError::new(EINVAL));
+        }
+        self.join_or_leave(IpAddress::Ipv6(group), join)
+    }
+
+    fn join_or_leave(&mut self, group: IpAddress, join: bool) -> SyscallResult<usize> {
         let mut iface = self.context.iface.borrow_mut();
         let groups = &mut self.context.multicast_groups;
         if join {
@@ -560,6 +586,9 @@ where
             SocketCall::SetSockOpt if metadata.get(2) == Some(&IPPROTO_IP) => {
                 self.set_ip_option(metadata[1] as usize, payload)
             }
+            SocketCall::SetSockOpt if metadata.get(2) == Some(&IPPROTO_IPV6) => {
+                self.set_ipv6_option(metadata[1] as usize, payload)
+            }
             SocketCall::SetSockOpt => {
                 // currently not used
                 // self.handle_setsockopt(id, metadata[1] as i32, &payload)
-- 
