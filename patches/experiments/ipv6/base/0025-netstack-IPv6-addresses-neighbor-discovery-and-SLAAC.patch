+/// IPv6 state of the link: the link-local address from the MAC address, and
+/// what stateless address autoconfiguration (RFC 4862) learned from router
+/// advertisements.
+#[derive(Default)]
+struct Ipv6State {
+    link_local: Option<Ipv6Address>,
+    global: Option<Ipv6Cidr>,
+    router: Option<Ipv6Address>,
+    solicitations: u32,
+    next_solicitation: Instant,
