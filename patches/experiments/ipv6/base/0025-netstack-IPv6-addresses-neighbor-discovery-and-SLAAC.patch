+    /// Handles NDP messages (RFC 4861) here, like ARP: smoltcp ignores them
+    /// on an IP medium. Returns false for packets the IP layer should get.
+    fn process_ndisc(&mut self, packet: &[u8], now: Instant) -> bool {
+        let Some(hardware_address) = self.hardware_address else {
+            return false;
+        };
+        let Ok(ip) = Ipv6Packet::new_checked(packet) else {
+            return false;
+        };
+        if ip.next_header() != IpProtocol::Icmpv6 || ip.hop_limit() != 0xff {
+            return false;
+        }
+        let (src, dst) = (ip.src_addr(), ip.dst_addr());
+        let Ok(icmp) = Icmpv6Packet::new_checked(ip.payload()) else {
+            return false;
+        };
+        let Ok(Icmpv6Repr::Ndisc(repr)) =
+            Icmpv6Repr::parse(&src, &dst, &icmp, &ChecksumCapabilities::default())
+        else {
+            return false;
+        };
+        let mac_of = |lladdr: Option<RawHardwareAddress>| {
+            lladdr
+                .filter(|l| l.as_bytes().len() == 6)
+                .map(|l| EthernetAddress::from_bytes(l.as_bytes()))
+                .filter(|m| m.is_unicast())
+        };
+
+        match repr {
+            NdiscRepr::NeighborSolicit { target_addr, lladdr } => {
+                if !self.is_own_ipv6(target_addr) {
+                    return true;
+                }
+                let sender = mac_of(lladdr);
+                if let (Some(mac), false) = (sender, src.is_unspecified()) {
+                    self.learn_neighbor(IpAddress::Ipv6(src), mac, now);
+                }
+                // A solicitation from :: is duplicate address detection; the
+                // answer then goes to all nodes.
+                let (dst_mac, dst_ip, flags) = match sender {
+                    Some(mac) if !src.is_unspecified() => (
+                        mac,
+                        src,
+                        NdiscNeighborFlags::SOLICITED | NdiscNeighborFlags::OVERRIDE,
+                    ),
+                    _ => (
+                        ipv6_multicast_mac(Ipv6Address::new(0xff02, 0, 0, 0, 0, 0, 0, 1)),
+                        Ipv6Address::new(0xff02, 0, 0, 0, 0, 0, 0, 1),
+                        NdiscNeighborFlags::OVERRIDE,
+                    ),
+                };
+                self.send_ndisc(
+                    dst_mac,
+                    target_addr,
+                    dst_ip,
+                    NdiscRepr::NeighborAdvert {
+                        flags,
+                        target_addr,
+                        lladdr: Some(hardware_address.into()),
+                    },
+                );
+            }
+            NdiscRepr::NeighborAdvert {
+                target_addr, lladdr, ..
+            } => {
+                if let Some(mac) = mac_of(lladdr) {
+                    self.learn_neighbor(IpAddress::Ipv6(target_addr), mac, now);
+                }
+            }
+            NdiscRepr::RouterAdvert {
+                router_lifetime,
+                lladdr,
+                prefix_info,
+                ..
+            } => {
+                if src.segments()[0] & 0xffc0 != 0xfe80 {
+                    return true;
+                }
+                if let Some(mac) = mac_of(lladdr) {
+                    self.learn_neighbor(IpAddress::Ipv6(src), mac, now);
+                }
+                self.ipv6.router = (router_lifetime != Duration::ZERO).then_some(src);
+                if let Some(prefix) = prefix_info {
+                    if prefix.flags.contains(NdiscPrefixInfoFlags::ADDRCONF)
+                        && prefix.prefix_len == 64
+                        && prefix.prefix.segments()[0] & 0xffc0 != 0xfe80
+                    {
+                        self.ipv6.global = (prefix.valid_lifetime != Duration::ZERO).then(|| {
+                            Ipv6Cidr::new(eui64_address(prefix.prefix, hardware_address), 64)
+                        });
+                    }
+                }
+                info!(
+                    "{}: router advertisement from {}: router {:?}, address {:?}",
+                    self.name, src, self.ipv6.router, self.ipv6.global
+                );
             }
             _ => {}
         }
+        true
+    }
+
+    fn learn_neighbor(&mut self, ip: IpAddress, mac: EthernetAddress, now: Instant) {
+        self.neighbor_cache.insert(
+            ip,
+            Neighbor {
+                hardware_address: mac,
+                expires_at: now + Self::NEIGHBOR_LIVE_TIME,
+            },
+        );
+        if let ArpState::Discovering { target, .. } = self.arp_state {
+            if target == ip {
+                self.check_waiting_packets(ip, mac, now);
+            }
+        }
+    }
+
+    fn send_router_solicitation(&mut self, now: Instant) {
+        let (Some(mac), Some(link_local)) = (self.hardware_address, self.ipv6.link_local) else {
+            return;
+        };
+        if self.ipv6.router.is_some()
+            || self.ipv6.solicitations >= Self::MAX_ROUTER_SOLICITATIONS
+            || now < self.ipv6.next_solicitation
+        {
+            return;
+        }
+        self.ipv6.solicitations += 1;
+        self.ipv6.next_solicitation = now + Self::ROUTER_SOLICITATION_INTERVAL;
+        let all_routers = Ipv6Address::new(0xff02, 0, 0, 0, 0, 0, 0, 2);
+        self.send_ndisc(
+            ipv6_multicast_mac(all_routers),
+            link_local,
+            all_routers,
+            NdiscRepr::RouterSolicit {
+                lladdr: Some(mac.into()),
+            },
+        );
     }
 
