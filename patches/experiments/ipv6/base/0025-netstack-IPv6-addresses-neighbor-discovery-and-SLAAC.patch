+    /// Sends an NDP message (hop limit 255) from `src` to `dst`.
+    fn send_ndisc(
+        &mut self,
+        dst_mac: EthernetAddress,
+        src: Ipv6Address,
+        dst: Ipv6Address,
+        repr: NdiscRepr,
+    ) {
+        let icmp = Icmpv6Repr::Ndisc(repr);
+        let ip = Ipv6Repr {
+            src_addr: src,
+            dst_addr: dst,
+            next_header: IpProtocol::Icmpv6,
+            payload_len: icmp.buffer_len(),
+            hop_limit: 0xff,
+        };
+        self.send_to(
+            dst_mac,
+            ip.buffer_len() + icmp.buffer_len(),
+            |buf| {
+                let mut packet = Ipv6Packet::new_unchecked(buf);
+                ip.emit(&mut packet);
+                icmp.emit(
+                    &src,
+                    &dst,
+                    &mut Icmpv6Packet::new_unchecked(packet.payload_mut()),
+                    &ChecksumCapabilities::default(),
+                );
+            },
+            EthernetProtocol::Ipv6,
+        );
+    }
