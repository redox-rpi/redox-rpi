From 3de2bc8ffb415197c95e07f0597a600b522ed224 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Wed, 28 Oct 2026 10:30:34 +0000
Subject: [PATCH] Print the memory map of a process on an unhandled exception
 (#1 diagnostics)

---
 src/context/signal.rs | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/context/signal.rs b/src/context/signal.rs
index cd6215c6..e4d4edcb 100644
--- a/src/context/signal.rs
+++ b/src/context/signal.rs
@@ -110,8 +110,22 @@ pub fn excp_handler(excp: syscall::Exception) {
             context.name,
             Arc::as_ptr(&*current),
         );
+        // Diagnostics (redox-rpi, #1): the memory map of the process.
+        let addr_space = context.addr_space().ok().cloned();
         drop(context);
         drop(current);
+        if let Some(addr_space) = addr_space {
+            let guard = addr_space.acquire_read(token.downgrade());
+            for (base, info) in guard.grants.iter() {
+                info!(
+                    "  grant {:#x}..{:#x} {:?} {:?}",
+                    base.start_address().data(),
+                    base.start_address().data() + info.page_count() * crate::memory::PAGE_SIZE,
+                    info.flags(),
+                    info.provider,
+                );
+            }
+        }
         // TODO: Allow exceptions to be caught by tracer etc, without necessarily exiting the
         // context (closing files, dropping AddrSpace, etc)
         crate::syscall::process::exit_this_context(Some(excp), &mut token);
-- 
