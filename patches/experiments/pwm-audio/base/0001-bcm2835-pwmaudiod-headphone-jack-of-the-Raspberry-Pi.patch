new file mode 100644
index 00000000..f3dc2646
--- /dev/null
+++ b/drivers/audio/bcm2835-pwmaudiod/src/pwm.rs
@@ -0,0 +1,268 @@
+//! The PWM block (BCM2835 ARM Peripherals, chapter 9) and its clock from the
+//! clock manager.
+//!
+//! Both channels run in the PWM algorithm mode (not mark-space) with the
+//! same range and read one FIFO in turn: the first word goes to channel 1
+//! (PWM0, GPIO 40), the next to channel 2 (PWM1, GPIO 41).
+
+use std::time::{Duration, Instant};
+
+// PWM registers, as byte offsets.
+const CTL: usize = 0x00;
+const STA: usize = 0x04;
+const DMAC: usize = 0x08;
+const RNG1: usize = 0x10;
+const FIF1: usize = 0x18;
+const RNG2: usize = 0x20;
+
+// CTL
+const PWEN1: u32 = 1 << 0;
+const RPTL1: u32 = 1 << 2;
+const USEF1: u32 = 1 << 5;
+const CLRF1: u32 = 1 << 6;
+const PWEN2: u32 = 1 << 8;
+const RPTL2: u32 = 1 << 10;
+const USEF2: u32 = 1 << 13;
+
+// STA
+const FULL1: u32 = 1 << 0;
+const EMPT1: u32 = 1 << 1;
+/// Write error, read error, gaps on channels 1 to 4, bus error; each bit is
+/// cleared by writing 1.
+pub const STA_ERRORS: u32 = 0x1fc;
+
+// DMAC
+const DMAC_ENAB: u32 = 1 << 31;
+/// The datasheet's reset values for the PANIC and DREQ thresholds.
+const DMAC_THRESHOLDS: u32 = 7 << 8 | 7;
+
+// Clock manager, PWM clock
+const CM_PWMCTL: usize = 0xa0;
+const CM_PWMDIV: usize = 0xa4;
+const CM_PASSWD: u32 = 0x5a << 24;
+const CM_SRC_PLLD: u32 = 6;
+const CM_ENAB: u32 = 1 << 4;
+const CM_KILL: u32 = 1 << 5;
+const CM_BUSY: u32 = 1 << 7;
+
+/// PLLD on the Raspberry Pi 3, as the firmware sets it up.
+pub const PLLD_HZ: u32 = 500_000_000;
+pub const SAMPLE_RATE: u32 = 44_100;
+
+pub struct Pwm {
+    regs: *mut u32,
+    cm: *mut u32,
+    /// Clock ticks per sample; a sample value goes from 0 to `range`.
+    pub range: u32,
+    pub clock_hz: u32,
+}
+
+// The registers belong to this driver alone.
+unsafe impl Send for Pwm {}
+
+impl Pwm {
+    /// `regs` points at the PWM block, `cm` at the clock manager.
+    pub fn new(regs: *mut u32, cm: *mut u32, divisor: u32) -> Self {
+        let clock_hz = PLLD_HZ / divisor;
+        Pwm {
+            regs,
+            cm,
+            range: (clock_hz + SAMPLE_RATE / 2) / SAMPLE_RATE,
+            clock_hz,
+        }
+    }
+
+    /// The middle of the range: silence.
+    pub fn silence(&self) -> u32 {
+        self.range / 2
+    }
+
+    /// Whether the block answers: the range registers keep what is written.
+    /// QEMU does not emulate PWM and reads zero.
+    pub fn present(&self) -> bool {
+        self.write(RNG1, 0x1234);
+        let present = self.read(RNG1) == 0x1234;
+        self.write(RNG1, 0x20);
+        present
+    }
+
+    /// Stop the channels, start the clock from PLLD, set the range and turn
+    /// both channels on, reading the FIFO. With `dma`, the block asks the
+    /// DMA controller for data; without, the CPU fills the FIFO. The outputs
+    /// start at 0 V: the caller ramps up to the middle.
+    pub fn start(&self, dma: bool) -> Result<(), String> {
+        self.write(CTL, 0);
+        self.write(DMAC, 0);
+        spin(Duration::from_micros(10));
+        self.start_clock()?;
+        self.write(RNG1, self.range);
+        self.write(RNG2, self.range);
+        self.write(STA, STA_ERRORS);
+        self.write(CTL, CLRF1);
+        spin(Duration::from_micros(10));
+        if dma {
+            self.write(DMAC, DMAC_ENAB | DMAC_THRESHOLDS);
+        }
+        // Repeat the last word when the FIFO runs empty, so a gap holds the
+        // level instead of dropping to 0 V.
+        self.write(CTL, PWEN1 | USEF1 | RPTL1 | PWEN2 | USEF2 | RPTL2);
+        Ok(())
+    }
+
+    /// Turn the DMA requests on or off without stopping the channels.
+    pub fn set_dma(&self, on: bool) {
+        self.write(DMAC, if on { DMAC_ENAB | DMAC_THRESHOLDS } else { 0 });
+    }
+
+    fn start_clock(&self) -> Result<(), String> {
+        let divisor = PLLD_HZ / self.clock_hz;
+        // Stop the clock and wait until it has stopped; kill it if it hangs.
+        self.write_cm(CM_PWMCTL, CM_PASSWD | (self.read_cm(CM_PWMCTL) & 0xf));
+        if !self.wait_cm(false) {
+            self.write_cm(CM_PWMCTL, CM_PASSWD | CM_KILL);
+            self.write_cm(CM_PWMCTL, CM_PASSWD);
+            if !self.wait_cm(false) {
+                return Err(format!("PWM clock does not stop (CM_PWMCTL 0x{:08x})", self.read_cm(CM_PWMCTL)));
+            }
+        }
+        // Integer divisor in bits 23:12, no fraction, no MASH.
+        self.write_cm(CM_PWMDIV, CM_PASSWD | divisor << 12);
+        self.write_cm(CM_PWMCTL, CM_PASSWD | CM_SRC_PLLD);
+        self.write_cm(CM_PWMCTL, CM_PASSWD | CM_SRC_PLLD | CM_ENAB);
+        if !self.wait_cm(true) {
+            return Err(format!("PWM clock does not start (CM_PWMCTL 0x{:08x})", self.read_cm(CM_PWMCTL)));
+        }
+        Ok(())
+    }
+
+    fn wait_cm(&self, busy: bool) -> bool {
+        let start = Instant::now();
+        while (self.read_cm(CM_PWMCTL) & CM_BUSY != 0) != busy {
+            if start.elapsed() > Duration::from_millis(10) {
+                return false;
+            }
+            std::hint::spin_loop();
+        }
+        true
+    }
+
+    /// Stop both channels; the outputs go to 0 V.
+    pub fn stop(&self) {
+        self.write(DMAC, 0);
+        self.write(CTL, 0);
+    }
+
+    pub fn fifo_full(&self) -> bool {
+        self.read(STA) & FULL1 != 0
+    }
+
+    pub fn fifo_empty(&self) -> bool {
+        self.read(STA) & EMPT1 != 0
+    }
+
+    pub fn push(&self, word: u32) {
+        self.write(FIF1, word);
+    }
+
+    /// The error bits of STA since the last call, cleared.
+    pub fn take_errors(&self) -> u32 {
+        let errors = self.read(STA) & STA_ERRORS;
+        if errors != 0 {
+            self.write(STA, errors);
+        }
+        errors
+    }
+
+    /// Offset of the FIFO register in the block, for the DMA controller.
+    pub const FIFO_OFFSET: usize = FIF1;
+
+    fn read(&self, offset: usize) -> u32 {
+        unsafe { self.regs.add(offset / 4).read_volatile() }
+    }
+
+    fn write(&self, offset: usize, value: u32) {
+        unsafe { self.regs.add(offset / 4).write_volatile(value) }
+    }
+
+    fn read_cm(&self, offset: usize) -> u32 {
+        unsafe { self.cm.add(offset / 4).read_volatile() }
+    }
+
+    fn write_cm(&self, offset: usize, value: u32) {
+        unsafe { self.cm.add(offset / 4).write_volatile(value) }
+    }
+}
+
+/// What a tone played by the CPU did.
+#[derive(Default, Clone)]
+pub struct ToneReport {
+    pub seconds: f64,
+    pub words: u64,
+    /// Times the CPU found the FIFO empty: it was too slow, the output held
+    /// the last value.
+    pub empty: u64,
+    pub sta_errors: u32,
+}
+
+impl ToneReport {
+    /// Frames per second the PWM took from the FIFO.
+    pub fn rate(&self) -> f64 {
+        if self.seconds > 0.0 {
+            self.words as f64 / 2.0 / self.seconds
+        } else {
+            0.0
+        }
+    }
+}
+
+/// Play a sine with the CPU writing every word into the FIFO (stage A1, no
+/// DMA). Busy for the whole time. Starts and ends at the middle of the
+/// range; the caller has the channels running.
+pub fn cpu_tone(pwm: &Pwm, seconds: f64, hz: f64, amplitude: f64) -> ToneReport {
+    let mid = f64::from(pwm.silence());
+    let peak = mid * amplitude.clamp(0.0, 1.0);
+    let total = (seconds * f64::from(SAMPLE_RATE)) as u64;
+    let mut report = ToneReport::default();
+    pwm.take_errors();
+    // Let the FIFO fill up before counting empty moments.
+    let mut frame = 0u64;
+    let mut second_word = None;
+    let start = Instant::now();
+    while frame < total {
+        if pwm.fifo_full() {
+            continue;
+        }
+        if frame > 16 && pwm.fifo_empty() {
+            report.empty += 1;
+        }
+        let word = match second_word.take() {
+            Some(word) => {
+                frame += 1;
+                word
+            }
+            None => {
+                let t = frame as f64 / f64::from(SAMPLE_RATE);
+                // Fade in and out over 10 ms against clicks.
+                let fade = (t / 0.01).min((seconds - t) / 0.01).clamp(0.0, 1.0);
+                let value = (mid + peak * fade * (2.0 * std::f64::consts::PI * hz * t).sin()) as u32;
+                second_word = Some(value);
+                value
+            }
+        };
+        pwm.push(word);
+        report.words += 1;
+    }
+    // Wait until the FIFO has been played.
+    let drained = Instant::now();
+    while !pwm.fifo_empty() && drained.elapsed() < Duration::from_millis(5) {}
+    report.seconds = start.elapsed().as_secs_f64();
+    report.sta_errors = pwm.take_errors();
+    report
+}
+
+fn spin(time: Duration) {
+    let end = Instant::now() + time;
+    while Instant::now() < end {
+        std::hint::spin_loop();
+    }
+}
diff --git a/drivers/audio/bcm2835-pwmaudiod/src/ring.rs b/drivers/audio/bcm2835-pwmaudiod/src/ring.rs
new file mode 100644
index 00000000..585c96c3
--- /dev/null
+++ b/drivers/audio/bcm2835-pwmaudiod/src/ring.rs
@@ -0,0 +1,145 @@
+//! Bookkeeping for the ring of slots the DMA controller plays in a loop:
+//! which slot it plays now, which slots hold new sound, which slot the next
+//! chunk goes into. No hardware here, so it is tested on the build host.
+//!
+//! Slots are counted without wrapping (`u64`); slot `n` lives at index
+//! `n % slots` of the ring. After a slot has been played, the driver fills
+//! it with silence, so when no new chunk arrives in time the ring plays
+//! silence instead of old sound.
+
+/// Frames per slot: one chunk from `audiod`.
+pub const SLOT_FRAMES: usize = 512;
+/// Bytes of one chunk: 512 frames, two channels, s16le.
+pub const CHUNK_BYTES: usize = SLOT_FRAMES * 2 * 2;
+
+pub struct Ring {
+    slots: u64,
+    /// The slot being played.
+    current: u64,
+    /// The next slot to fill. Slots below it and above `current` hold new
+    /// sound.
+    written: u64,
+    /// Played slots that held new sound.
+    pub played_sound: u64,
+    /// Times the ring ran out of new sound (the end of each sound counts too).
+    pub underruns: u64,
+}
+
+impl Ring {
+    /// The ring starts at slot 0; slots below `first_free` hold the start-up
+    /// ramp and must not be written over.
+    pub fn new(slots: usize, first_free: usize) -> Self {
+        assert!(slots >= 4 && first_free < slots);
+        Ring {
+            slots: slots as u64,
+            current: 0,
+            written: first_free as u64,
+            played_sound: 0,
+            underruns: 0,
+        }
+    }
+
+    /// The slot being played, counted without wrapping.
+    pub fn current(&self) -> u64 {
+        self.current
+    }
+
+    /// Slots after the one being played that hold new sound.
+    pub fn queued(&self) -> u64 {
+        self.written.saturating_sub(self.current + 1)
+    }
+
+    /// The controller now plays ring index `index`. Calls `played` with the
+    /// ring index of every slot finished since the last call, so the caller
+    /// can silence it. Must be called at least once per turn of the ring.
+    pub fn advance(&mut self, index: usize, mut played: impl FnMut(usize)) {
+        let index = index as u64 % self.slots;
+        let delta = (index + self.slots - self.current % self.slots) % self.slots;
+        for _ in 0..delta {
+            if self.current < self.written {
+                self.played_sound += 1;
+                if self.current + 1 == self.written {
+                    self.underruns += 1;
+                }
+            }
+            played((self.current % self.slots) as usize);
+            self.current += 1;
+        }
+    }
+
+    /// The ring index for the next chunk, or `None` while the ring is full.
+    pub fn reserve(&mut self) -> Option<usize> {
+        if self.written < self.current + 2 {
+            // Out of sound: start two slots ahead, since the controller may
+            // be about to finish the current one.
+            self.written = self.current + 2;
+        }
+        if self.written >= self.current + self.slots {
+            return None;
+        }
+        let index = (self.written % self.slots) as usize;
+        self.written += 1;
+        Some(index)
+    }
+}
+
+/// A signed 16-bit sample as a PWM value: 0 to `range`, silence at the
+/// middle.
+pub fn to_pwm(sample: i16, range: u32) -> u32 {
+    ((i32::from(sample) + 32768) as u32 * range) >> 16
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pwm_values() {
+        assert_eq!(to_pwm(i16::MIN, 5669), 0);
+        assert_eq!(to_pwm(0, 5668), 2834);
+        assert!(to_pwm(i16::MAX, 5669) < 5669);
+        assert!(to_pwm(i16::MAX, 5669) >= 5668);
+    }
+
+    #[test]
+    fn fills_until_full_then_frees_slots() {
+        let mut ring = Ring::new(8, 2);
+        let got: Vec<_> = std::iter::from_fn(|| ring.reserve()).collect();
+        // Slot 0 plays; 2..=7 are free (0 and 1 hold the ramp, which counts
+        // as sound).
+        assert_eq!(got, vec![2, 3, 4, 5, 6, 7]);
+        assert_eq!(ring.queued(), 7);
+
+        let mut silenced = Vec::new();
+        ring.advance(3, |i| silenced.push(i));
+        assert_eq!(silenced, vec![0, 1, 2]);
+        assert_eq!(ring.played_sound, 3);
+        assert_eq!(ring.reserve(), Some(0));
+        assert_eq!(ring.reserve(), Some(1));
+        assert_eq!(ring.reserve(), Some(2));
+        assert_eq!(ring.reserve(), None);
+    }
+
+    #[test]
+    fn underrun_restarts_two_slots_ahead() {
+        let mut ring = Ring::new(8, 1);
+        assert_eq!(ring.reserve(), Some(2));
+        ring.advance(2, |_| {});
+        ring.advance(6, |_| {});
+        assert_eq!(ring.underruns, 1);
+        assert_eq!(ring.played_sound, 3);
+        assert_eq!(ring.queued(), 0);
+        // Slot 6 plays, 7 may be about to start: the next chunk goes to 0.
+        assert_eq!(ring.reserve(), Some(0));
+    }
+
+    #[test]
+    fn wraps_around() {
+        let mut ring = Ring::new(4, 1);
+        for turn in 0..10u64 {
+            assert!(ring.reserve().is_some());
+            ring.advance(((turn + 1) % 4) as usize, |_| {});
+        }
+        assert_eq!(ring.current(), 10);
+    }
+}
