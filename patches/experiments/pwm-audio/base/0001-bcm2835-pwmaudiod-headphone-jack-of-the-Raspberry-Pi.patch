diff --git a/drivers/audio/bcm2835-pwmaudiod/src/dma.rs b/drivers/audio/bcm2835-pwmaudiod/src/dma.rs
new file mode 100644
index 00000000..807f6340
--- /dev/null
+++ b/drivers/audio/bcm2835-pwmaudiod/src/dma.rs
@@ -0,0 +1,230 @@
+//! The BCM2835 DMA controller playing a ring of slots into the PWM FIFO
+//! (docs/topics/dma.md in redox-rpi, step 1: one fixed channel, uncached
+//! buffers, polling instead of the interrupt).
+//!
+//! Each slot has one control block, and the last block points back to the
+//! first, so the controller plays the ring forever. The PWM paces it
+//! through its DREQ line (5): a word moves only when the FIFO has room.
+//! `CONBLK_AD` says which block, and so which slot, is playing.
+
+use common::dma::Dma;
+use fdt::Fdt;
+
+use crate::ring::SLOT_FRAMES;
+
+/// Bus address of the controller on all BCM283x, if the devicetree has none.
+const DMA_BUS_ADDR: usize = 0x7e00_7000;
+/// The channel this driver owns (docs/topics/dma.md, channel table: 2 and 0
+/// are free for SPI or audio).
+pub const CHANNEL: usize = 2;
+const CHANNEL_SIZE: usize = 0x100;
+/// RAM as the controller sees it when the devicetree has no dma-ranges.
+const RAM_BUS_OFFSET: usize = 0xc000_0000;
+
+// Channel registers, as byte offsets.
+const CS: usize = 0x00;
+const CONBLK_AD: usize = 0x04;
+const DEBUG: usize = 0x20;
+/// Global register: one enable bit per channel.
+const ENABLE: usize = 0xff0;
+
+// CS
+const CS_ACTIVE: u32 = 1 << 0;
+const CS_END: u32 = 1 << 1;
+const CS_INT: u32 = 1 << 2;
+const CS_ERROR: u32 = 1 << 8;
+const CS_WAIT_FOR_OUTSTANDING_WRITES: u32 = 1 << 28;
+const CS_ABORT: u32 = 1 << 30;
+const CS_RESET: u32 = 1 << 31;
+/// AXI priority 8, panic priority 15.
+const CS_PRIORITY: u32 = 8 << 16 | 15 << 20;
+
+// TI, in the control block
+const TI_WAIT_RESP: u32 = 1 << 3;
+const TI_DEST_DREQ: u32 = 1 << 6;
+const TI_SRC_INC: u32 = 1 << 8;
+const TI_PERMAP_SHIFT: u32 = 16;
+/// The PWM's DREQ line.
+const DREQ_PWM: u32 = 5;
+
+// DEBUG; each bit is cleared by writing 1
+const DEBUG_ERRORS: u32 = 0x7;
+
+/// Slots in the ring: 8 × 512 frames, about 93 ms.
+pub const SLOTS: usize = 8;
+/// FIFO words per slot: one per channel and frame.
+pub const SLOT_WORDS: usize = SLOT_FRAMES * 2;
+
+/// One control block; the controller needs them aligned to 32 bytes.
+#[repr(C, align(32))]
+#[derive(Clone, Copy)]
+struct ControlBlock {
+    ti: u32,
+    source: u32,
+    dest: u32,
+    len: u32,
+    stride: u32,
+    next: u32,
+    _reserved: [u32; 2],
+}
+
+pub struct DmaRing {
+    /// The channel's registers.
+    regs: *mut u32,
+    /// The controller's register page, for ENABLE.
+    page: *mut u32,
+    /// Only read by the controller.
+    _cbs: Dma<[ControlBlock; SLOTS]>,
+    buf: Dma<[[u32; SLOT_WORDS]; SLOTS]>,
+    cbs_bus: u32,
+    pub phys: usize,
+}
+
+// The channel and the buffers belong to this driver alone.
+unsafe impl Send for DmaRing {}
+
+impl DmaRing {
+    /// Set up the channel and the ring, not started yet. `fifo_bus` is the
+    /// bus address of the PWM FIFO. Fails if the devicetree does not leave
+    /// the channel free.
+    pub fn new(fdt: &Fdt, fifo_bus: u32) -> Result<Self, String> {
+        let node = fdt.find_compatible(&["brcm,bcm2835-dma"]);
+        let mask = node
+            .and_then(|node| node.property("brcm,dma-channel-mask"))
+            .and_then(|prop| prop.as_usize())
+            .ok_or("no brcm,dma-channel-mask in the devicetree")?;
+        if mask & 1 << CHANNEL == 0 {
+            return Err(format!("DMA channel {CHANNEL} not free (mask 0x{mask:x})"));
+        }
+        let bus_addr = node
+            .and_then(|node| node.reg())
+            .and_then(|mut reg| reg.next())
+            .map(|reg| reg.starting_address as usize)
+            .unwrap_or(DMA_BUS_ADDR);
+        let phys = crate::soc_phys(fdt, bus_addr);
+        let page = unsafe {
+            common::physmap(phys, 0x1000, common::Prot::RW, common::MemoryType::DeviceMemory)
+                .map_err(|err| format!("failed to map the DMA controller: {err:?}"))? as *mut u32
+        };
+        let mut cbs = unsafe {
+            Dma::<[ControlBlock; SLOTS]>::zeroed()
+                .map_err(|err| format!("failed to allocate the control blocks: {err}"))?
+                .assume_init()
+        };
+        let buf = unsafe {
+            Dma::<[[u32; SLOT_WORDS]; SLOTS]>::zeroed()
+                .map_err(|err| format!("failed to allocate the ring: {err}"))?
+                .assume_init()
+        };
+        let offset = ram_bus_offset(fdt);
+        let bus = |phys: usize| (phys + offset) as u32;
+        let cbs_bus = bus(cbs.physical());
+        let buf_bus = bus(buf.physical());
+        for (i, cb) in cbs.iter_mut().enumerate() {
+            *cb = ControlBlock {
+                ti: DREQ_PWM << TI_PERMAP_SHIFT | TI_DEST_DREQ | TI_SRC_INC | TI_WAIT_RESP,
+                source: buf_bus + (i * SLOT_WORDS * 4) as u32,
+                dest: fifo_bus,
+                len: (SLOT_WORDS * 4) as u32,
+                stride: 0,
+                next: cbs_bus + (((i + 1) % SLOTS) * size_of::<ControlBlock>()) as u32,
+                _reserved: [0; 2],
+            };
+        }
+        let ring = DmaRing {
+            regs: unsafe { page.add(CHANNEL * CHANNEL_SIZE / 4) },
+            page,
+            _cbs: cbs,
+            buf,
+            cbs_bus,
+            phys,
+        };
+        let enable = ring.page_reg(ENABLE);
+        ring.set_page_reg(ENABLE, enable | 1 << CHANNEL);
+        ring.reset();
+        Ok(ring)
+    }
+
+    pub fn slot_mut(&mut self, index: usize) -> &mut [u32; SLOT_WORDS] {
+        &mut self.buf[index]
+    }
+
+    /// Start the ring at slot 0.
+    pub fn start(&self) {
+        self.reset();
+        barrier();
+        self.set_reg(CONBLK_AD, self.cbs_bus);
+        self.set_reg(CS, CS_ACTIVE | CS_END | CS_INT | CS_PRIORITY | CS_WAIT_FOR_OUTSTANDING_WRITES);
+    }
+
+    /// Hold or go on (CS.ACTIVE), without losing the place.
+    pub fn set_active(&self, active: bool) {
+        let cs = self.reg(CS) & !(CS_ACTIVE | CS_END | CS_INT);
+        self.set_reg(CS, if active { cs | CS_ACTIVE } else { cs });
+    }
+
+    /// The slot whose control block the controller holds, if any.
+    pub fn position(&self) -> Option<usize> {
+        let cb = self.reg(CONBLK_AD).wrapping_sub(self.cbs_bus) as usize;
+        let size = size_of::<ControlBlock>();
+        (cb % size == 0 && cb / size < SLOTS).then_some(cb / size)
+    }
+
+    /// CS and DEBUG if the channel stopped with an error or is not running.
+    pub fn fault(&self) -> Option<(u32, u32)> {
+        let cs = self.reg(CS);
+        (cs & CS_ERROR != 0 || cs & CS_ACTIVE == 0).then(|| (cs, self.reg(DEBUG)))
+    }
+
+    /// Stop whatever the channel does and clear its errors.
+    pub fn reset(&self) {
+        if self.reg(CS) & CS_ACTIVE != 0 {
+            self.set_reg(CS, CS_ABORT);
+            let start = std::time::Instant::now();
+            while self.reg(CS) & CS_ACTIVE != 0 && start.elapsed() < std::time::Duration::from_millis(10) {}
+        }
+        self.set_reg(CS, CS_RESET);
+        self.set_reg(DEBUG, DEBUG_ERRORS);
+    }
+
+    fn reg(&self, offset: usize) -> u32 {
+        unsafe { self.regs.add(offset / 4).read_volatile() }
+    }
+
+    fn set_reg(&self, offset: usize, value: u32) {
+        unsafe { self.regs.add(offset / 4).write_volatile(value) }
+    }
+
+    fn page_reg(&self, offset: usize) -> u32 {
+        unsafe { self.page.add(offset / 4).read_volatile() }
+    }
+
+    fn set_page_reg(&self, offset: usize, value: u32) {
+        unsafe { self.page.add(offset / 4).write_volatile(value) }
+    }
+}
+
+/// Bus address minus physical address of RAM, from the first entry of
+/// `/soc`'s dma-ranges (one cell each for bus address, physical address and
+/// size on the BCM283x).
+fn ram_bus_offset(fdt: &Fdt) -> usize {
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.property("dma-ranges"))
+        .filter(|prop| prop.value.len() >= 12)
+        .map(|prop| {
+            let cell = |i: usize| u32::from_be_bytes(prop.value[i * 4..i * 4 + 4].try_into().unwrap());
+            (cell(0) as usize).wrapping_sub(cell(1) as usize)
+        })
+        .unwrap_or(RAM_BUS_OFFSET)
+}
+
+/// Make the CPU's writes to the ring visible before the register write that
+/// starts the controller.
+pub fn barrier() {
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!("dsb sy", options(nostack, preserves_flags));
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    std::sync::atomic::fence(std::sync::atomic::Ordering::SeqCst);
+}
diff --git a/drivers/audio/bcm2835-pwmaudiod/src/main.rs b/drivers/audio/bcm2835-pwmaudiod/src/main.rs
new file mode 100644
index 00000000..5ffc78d9
--- /dev/null
+++ b/drivers/audio/bcm2835-pwmaudiod/src/main.rs
@@ -0,0 +1,545 @@
+//! The headphone jack of the Raspberry Pi 3 as the `audiohw` scheme for
+//! `audiod`. Two PWM channels (GPIO 40 and 41) make the right and left
+//! signal; a filter on the board turns them into sound.
+//!
+//! - `/scheme/audiohw`: writes of exactly 2048 bytes, one chunk of 512
+//!   frames, signed 16-bit little endian, stereo, 44.1 kHz (as `ac97d`).
+//!   When the ring is full the write waits, or fails with `EWOULDBLOCK` on
+//!   a non-blocking handle.
+//! - `/scheme/audiohw/stats`: clock, range, ring and error counters.
+//! - `/scheme/audiohw/tone`: writing `<seconds> [<hz>]` plays a sine with
+//!   the CPU filling the FIFO, without DMA (stage A1, a test); the result is
+//!   in `stats`.
+//!
+//! The DMA controller (channel 2) plays a ring of 8 slots of 512 frames
+//! into the PWM FIFO; a timer every 10 ms looks which slot plays, fills
+//! played slots with silence and lets waiting writes in. Without a PWM
+//! block (QEMU) the ring is played by the clock instead, so `audiod` and
+//! the scheme still run.
+
+use std::fmt::Write as _;
+use std::fs::{File, OpenOptions};
+use std::io::{Read, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::os::unix::io::AsRawFd;
+use std::process;
+use std::time::{Duration, Instant};
+
+use event::{user_data, EventQueue};
+use fdt::Fdt;
+use redox_scheme::scheme::SchemeSync;
+use redox_scheme::{CallerCtx, OpenResult, Socket};
+use scheme_utils::{FpathWriter, HandleMap, ReadinessBased};
+use syscall::error::{Error, Result, EACCES, EBADF, EINVAL, EISDIR, ENODEV, ENOENT, EROFS, EWOULDBLOCK};
+use syscall::schemev2::NewFdFlags;
+use syscall::{MODE_DIR, MODE_FILE};
+
+mod dma;
+mod pwm;
+mod ring;
+
+use dma::{DmaRing, SLOTS, SLOT_WORDS};
+use pwm::{Pwm, ToneReport, SAMPLE_RATE};
+use ring::{to_pwm, Ring, CHUNK_BYTES, SLOT_FRAMES};
+
+/// Bus addresses on the BCM283x, if the devicetree has none.
+const PWM_BUS_ADDR: usize = 0x7e20_c000;
+const CPRMAN_BUS_ADDR: usize = 0x7e10_1000;
+const PAGE_SIZE: usize = 4096;
+/// PLLD divided by 2: 250 MHz, a range of 5669 at 44.1 kHz (about 12.5
+/// bits).
+const CLOCK_DIVISOR: u32 = 2;
+/// The pins of the jack, function ALT0 (PWM0 and PWM1).
+const PINS: [u32; 2] = [40, 41];
+/// Slots of the ramp from 0 V up to the middle at start, against the click:
+/// about 46 ms.
+const RAMP_SLOTS: usize = 4;
+const POLL: Duration = Duration::from_millis(10);
+/// The longest tone the `tone` file plays: the driver is busy meanwhile.
+const MAX_TONE_SECONDS: f64 = 10.0;
+/// The tone's amplitude, a quarter of full scale, to spare ears.
+const TONE_AMPLITUDE: f64 = 0.25;
+
+enum Output {
+    Pwm { pwm: Pwm, dma: DmaRing, phys: usize },
+    /// No PWM block (QEMU): slots count as played by the clock.
+    Clock { start: Instant, buf: Vec<[u32; SLOT_WORDS]> },
+}
+
+impl Output {
+    fn slot_mut(&mut self, index: usize) -> &mut [u32; SLOT_WORDS] {
+        match self {
+            Output::Pwm { dma, .. } => dma.slot_mut(index),
+            Output::Clock { buf, .. } => &mut buf[index],
+        }
+    }
+
+    fn position(&self) -> Option<usize> {
+        match self {
+            Output::Pwm { dma, .. } => dma.position(),
+            Output::Clock { start, .. } => {
+                let frames = start.elapsed().as_nanos() * u128::from(SAMPLE_RATE) / 1_000_000_000;
+                Some((frames / SLOT_FRAMES as u128 % SLOTS as u128) as usize)
+            }
+        }
+    }
+}
+
+enum Handle {
+    Root,
+    Pcm,
+    Stats(Vec<u8>),
+    Tone,
+}
+
+struct Driver {
+    out: Output,
+    ring: Ring,
+    range: u32,
+    clock_hz: u32,
+    started: Instant,
+    chunks: u64,
+    dma_faults: u64,
+    last_fault: Option<(u32, u32)>,
+    sta_errors: u64,
+    sta_bits: u32,
+    tone: Option<ToneReport>,
+    handles: HandleMap<Handle>,
+}
+
+impl Driver {
+    fn new(out: Output, range: u32, clock_hz: u32) -> Self {
+        Driver {
+            out,
+            ring: Ring::new(SLOTS, RAMP_SLOTS),
+            range,
+            clock_hz,
+            started: Instant::now(),
+            chunks: 0,
+            dma_faults: 0,
+            last_fault: None,
+            sta_errors: 0,
+            sta_bits: 0,
+            tone: None,
+            handles: HandleMap::new(),
+        }
+    }
+
+    /// Follow the controller: silence the slots it has played, count errors,
+    /// restart the channel after a fault.
+    fn refresh(&mut self) {
+        if let Some(index) = self.out.position() {
+            let silence = self.range / 2;
+            let out = &mut self.out;
+            self.ring.advance(index, |i| out.slot_mut(i).fill(silence));
+        }
+        let (bits, fault) = match &self.out {
+            Output::Pwm { pwm, dma, .. } => (pwm.take_errors(), dma.fault()),
+            Output::Clock { .. } => return,
+        };
+        if bits != 0 {
+            self.sta_errors += 1;
+            self.sta_bits |= bits;
+        }
+        if let Some((cs, debug)) = fault {
+            self.dma_faults += 1;
+            self.last_fault = Some((cs, debug));
+            if self.dma_faults <= 3 {
+                eprintln!("bcm2835-pwmaudiod: DMA stopped (CS 0x{cs:08x}, DEBUG 0x{debug:08x}), restarting");
+            }
+            // Start over at slot 0 with a fresh ring of silence.
+            let silence = self.range / 2;
+            for i in 0..SLOTS {
+                self.out.slot_mut(i).fill(silence);
+            }
+            self.ring = Ring::new(SLOTS, 1);
+            if let Output::Pwm { dma, .. } = &self.out {
+                dma::barrier();
+                dma.start();
+            }
+        }
+    }
+
+    fn play(&mut self, chunk: &[u8]) -> Result<usize> {
+        if chunk.len() != CHUNK_BYTES {
+            return Err(Error::new(EINVAL));
+        }
+        self.refresh();
+        let index = self.ring.reserve().ok_or(Error::new(EWOULDBLOCK))?;
+        let range = self.range;
+        let slot = self.out.slot_mut(index);
+        for (frame, words) in chunk.chunks_exact(4).zip(slot.chunks_exact_mut(2)) {
+            let left = i16::from_le_bytes([frame[0], frame[1]]);
+            let right = i16::from_le_bytes([frame[2], frame[3]]);
+            // Channel 1 (PWM0, GPIO 40) is the right side of the jack.
+            words[0] = to_pwm(right, range);
+            words[1] = to_pwm(left, range);
+        }
+        self.chunks += 1;
+        Ok(chunk.len())
+    }
+
+    fn tone(&mut self, request: &[u8]) -> Result<()> {
+        let text = std::str::from_utf8(request).map_err(|_| Error::new(EINVAL))?;
+        let mut words = text.split_whitespace().map(str::parse::<f64>);
+        let seconds = match words.next() {
+            Some(Ok(s)) if s > 0.0 && s <= MAX_TONE_SECONDS => s,
+            _ => return Err(Error::new(EINVAL)),
+        };
+        let hz = match words.next() {
+            None => 1000.0,
+            Some(Ok(hz)) if hz > 0.0 && hz < f64::from(SAMPLE_RATE) / 2.0 => hz,
+            _ => return Err(Error::new(EINVAL)),
+        };
+        let Output::Pwm { pwm, dma, .. } = &self.out else {
+            return Err(Error::new(ENODEV));
+        };
+        // Hold the ring where it is and let the CPU have the FIFO.
+        dma.set_active(false);
+        pwm.set_dma(false);
+        let report = pwm::cpu_tone(pwm, seconds, hz, TONE_AMPLITUDE);
+        pwm.set_dma(true);
+        dma.set_active(true);
+        println!(
+            "bcm2835-pwmaudiod: tone {hz} Hz, {:.2} s, {} words, {:.0} frames/s, FIFO empty {} times, STA 0x{:03x}",
+            report.seconds,
+            report.words,
+            report.rate(),
+            report.empty,
+            report.sta_errors
+        );
+        self.tone = Some(report);
+        Ok(())
+    }
+
+    fn stats(&mut self) -> String {
+        self.refresh();
+        let mut text = String::new();
+        let uptime = self.started.elapsed().as_secs_f64();
+        let played = self.ring.current();
+        match &self.out {
+            Output::Pwm { phys, .. } => {
+                let _ = writeln!(text, "mode pwm-dma");
+                let _ = writeln!(text, "pwm 0x{phys:08x}");
+                let _ = writeln!(text, "dma_channel {}", dma::CHANNEL);
+            }
+            Output::Clock { .. } => {
+                let _ = writeln!(text, "mode clock (no PWM block)");
+            }
+        }
+        let _ = writeln!(text, "clock_hz {}", self.clock_hz);
+        let _ = writeln!(text, "range {}", self.range);
+        let _ = writeln!(text, "sample_rate {}", self.clock_hz / self.range);
+        let _ = writeln!(text, "slots {SLOTS}x{SLOT_FRAMES}");
+        let _ = writeln!(text, "uptime_s {uptime:.1}");
+        let _ = writeln!(text, "played_slots {played}");
+        // How fast the PWM really takes frames, from the DMA's progress.
+        let rate = if uptime > 0.0 { played as f64 * SLOT_FRAMES as f64 / uptime } else { 0.0 };
+        let _ = writeln!(text, "measured_rate_hz {rate:.0}");
+        let _ = writeln!(text, "chunks {}", self.chunks);
+        let _ = writeln!(text, "sound_slots {}", self.ring.played_sound);
+        let _ = writeln!(text, "underruns {}", self.ring.underruns);
+        let _ = writeln!(text, "queued {}", self.ring.queued());
+        let _ = writeln!(text, "dma_faults {}", self.dma_faults);
+        if let Some((cs, debug)) = self.last_fault {
+            let _ = writeln!(text, "last_fault cs=0x{cs:08x} debug=0x{debug:08x}");
+        }
+        let _ = writeln!(text, "pwm_errors {} bits=0x{:03x}", self.sta_errors, self.sta_bits);
+        if let Some(t) = &self.tone {
+            let _ = writeln!(
+                text,
+                "tone seconds={:.2} words={} rate_hz={:.0} fifo_empty={} sta=0x{:03x}",
+                t.seconds,
+                t.words,
+                t.rate(),
+                t.empty,
+                t.sta_errors
+            );
+        }
+        text
+    }
+}
+
+/// The start of the ring: a ramp from 0 V to the middle, then silence.
+fn fill_ramp(out: &mut Output, silence: u32) {
+    let ramp = (RAMP_SLOTS * SLOT_FRAMES) as u64;
+    for i in 0..SLOTS {
+        let slot = out.slot_mut(i);
+        for (frame, words) in slot.chunks_exact_mut(2).enumerate() {
+            let n = (i * SLOT_FRAMES + frame) as u64;
+            let value = (u64::from(silence) * n.min(ramp) / ramp) as u32;
+            words.fill(value);
+        }
+    }
+}
+
+impl SchemeSync for Driver {
+    fn scheme_root(&mut self) -> Result<usize> {
+        Ok(self.handles.insert(Handle::Root))
+    }
+
+    fn openat(
+        &mut self,
+        dirfd: usize,
+        path: &str,
+        _flags: usize,
+        _fcntl_flags: u32,
+        ctx: &CallerCtx,
+    ) -> Result<OpenResult> {
+        // audiod asks for "audio_shm" on its handle; not offered, so it
+        // falls back to writes.
+        if !matches!(self.handles.get(dirfd)?, Handle::Root) {
+            return Err(Error::new(EACCES));
+        }
+        let handle = match path.trim_matches('/') {
+            "" if ctx.uid == 0 => Handle::Pcm,
+            "tone" if ctx.uid == 0 => Handle::Tone,
+            "" | "tone" => return Err(Error::new(EACCES)),
+            "stats" => Handle::Stats(self.stats().into_bytes()),
+            _ => return Err(Error::new(ENOENT)),
+        };
+        Ok(OpenResult::ThisScheme {
+            number: self.handles.insert(handle),
+            flags: NewFdFlags::POSITIONED,
+        })
+    }
+
+    fn read(
+        &mut self,
+        id: usize,
+        buf: &mut [u8],
+        offset: u64,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<usize> {
+        let data = match self.handles.get(id)? {
+            Handle::Stats(data) => data,
+            Handle::Root => return Err(Error::new(EISDIR)),
+            _ => return Err(Error::new(EBADF)),
+        };
+        let start = usize::try_from(offset).unwrap_or(usize::MAX).min(data.len());
+        let len = buf.len().min(data.len() - start);
+        buf[..len].copy_from_slice(&data[start..start + len]);
+        Ok(len)
+    }
+
+    fn write(
+        &mut self,
+        id: usize,
+        buf: &[u8],
+        _offset: u64,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<usize> {
+        match self.handles.get(id)? {
+            Handle::Pcm => self.play(buf),
+            Handle::Tone => self.tone(buf).map(|()| buf.len()),
+            _ => Err(Error::new(EBADF)),
+        }
+    }
+
+    // Shells truncate a file before writing to it.
+    fn ftruncate(&mut self, id: usize, _len: u64, _ctx: &CallerCtx) -> Result<()> {
+        match self.handles.get(id)? {
+            Handle::Pcm | Handle::Tone => Ok(()),
+            _ => Err(Error::new(EROFS)),
+        }
+    }
+
+    fn fstat(&mut self, id: usize, stat: &mut syscall::Stat, _ctx: &CallerCtx) -> Result<()> {
+        match self.handles.get(id)? {
+            Handle::Stats(data) => {
+                stat.st_mode = 0o444 | MODE_FILE;
+                stat.st_size = data.len() as u64;
+            }
+            Handle::Pcm | Handle::Tone => stat.st_mode = 0o200 | MODE_FILE,
+            Handle::Root => stat.st_mode = 0o555 | MODE_DIR,
+        }
+        Ok(())
+    }
+
+    fn fsize(&mut self, id: usize, _ctx: &CallerCtx) -> Result<u64> {
+        match self.handles.get(id)? {
+            Handle::Stats(data) => Ok(data.len() as u64),
+            _ => Ok(0),
+        }
+    }
+
+    fn fpath(&mut self, id: usize, buf: &mut [u8], _ctx: &CallerCtx) -> Result<usize> {
+        self.handles.get(id).map_err(|_| Error::new(EBADF))?;
+        FpathWriter::with(buf, "audiohw", |_| Ok(()))
+    }
+
+    fn on_close(&mut self, id: usize) {
+        self.handles.remove(id);
+    }
+}
+
+/// The CPU physical address of a device at `bus_addr`, through `/soc`'s
+/// ranges.
+fn soc_phys(fdt: &Fdt, bus_addr: usize) -> usize {
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.ranges())
+        .and_then(|mut ranges| {
+            ranges.find(|r| r.child_bus_address <= bus_addr && bus_addr - r.child_bus_address < r.size)
+        })
+        .map(|r| r.parent_bus_address + (bus_addr - r.child_bus_address))
+        .unwrap_or(bus_addr)
+}
+
+/// Bus address of the first device with one of `compatible`, or `fallback`.
+fn bus_addr(fdt: &Fdt, compatible: &[&str], fallback: usize) -> usize {
+    fdt.find_compatible(compatible)
+        .and_then(|node| node.reg())
+        .and_then(|mut reg| reg.next())
+        .map(|reg| reg.starting_address as usize)
+        .unwrap_or(fallback)
+}
+
+fn map(phys: usize) -> *mut u32 {
+    unsafe {
+        common::physmap(phys, PAGE_SIZE, common::Prot::RW, common::MemoryType::DeviceMemory)
+            .expect("bcm2835-pwmaudiod: failed to map registers") as *mut u32
+    }
+}
+
+/// Set up the PWM, its clock, the DMA ring and the pins, or the clock
+/// stand-in when there is no PWM block.
+fn open_output(fdt: &Fdt) -> (Output, u32, u32) {
+    let pwm_bus = bus_addr(fdt, &["brcm,bcm2835-pwm"], PWM_BUS_ADDR);
+    let pwm_phys = soc_phys(fdt, pwm_bus);
+    let cm_phys = soc_phys(fdt, bus_addr(fdt, &["brcm,bcm2835-cprman"], CPRMAN_BUS_ADDR));
+    let pwm = Pwm::new(map(pwm_phys), map(cm_phys), CLOCK_DIVISOR);
+    let (range, clock_hz) = (pwm.range, pwm.clock_hz);
+
+    if !pwm.present() {
+        println!("bcm2835-pwmaudiod: no PWM block at 0x{pwm_phys:08x} (QEMU?), playing to the clock");
+        let out = Output::Clock {
+            start: Instant::now(),
+            buf: vec![[0; SLOT_WORDS]; SLOTS],
+        };
+        return (out, range, clock_hz);
+    }
+
+    let fifo_bus = (pwm_bus + Pwm::FIFO_OFFSET) as u32;
+    let dma = DmaRing::new(fdt, fifo_bus).unwrap_or_else(|err| {
+        eprintln!("bcm2835-pwmaudiod: {err}");
+        process::exit(1);
+    });
+    let dma_phys = dma.phys;
+    let mut out = Output::Pwm { pwm, dma, phys: pwm_phys };
+    fill_ramp(&mut out, range / 2);
+    let Output::Pwm { pwm, dma, .. } = &out else { unreachable!() };
+    if let Err(err) = pwm.start(true) {
+        eprintln!("bcm2835-pwmaudiod: {err}");
+        process::exit(1);
+    }
+    dma::barrier();
+    dma.start();
+    for pin in PINS {
+        if let Err(err) = std::fs::write(format!("/scheme/gpio/{pin}/mode"), "alt0") {
+            eprintln!("bcm2835-pwmaudiod: GPIO {pin} to alt0: {err}");
+        }
+    }
+    println!(
+        "bcm2835-pwmaudiod: PWM at 0x{pwm_phys:08x}, clock {} MHz (PLLD/{CLOCK_DIVISOR}), range {range} ({} Hz), DMA channel {} at 0x{dma_phys:08x}, {SLOTS} x {SLOT_FRAMES} frames",
+        clock_hz / 1_000_000,
+        clock_hz / range,
+        dma::CHANNEL,
+    );
+    (out, range, clock_hz)
+}
+
+/// A one-shot timer on the monotonic clock, delivered as an event.
+struct Timer(File);
+
+impl Timer {
+    fn new() -> std::io::Result<Self> {
+        OpenOptions::new()
+            .read(true)
+            .write(true)
+            .custom_flags(syscall::O_NONBLOCK as i32)
+            .open(format!("/scheme/time/{}", syscall::CLOCK_MONOTONIC))
+            .map(Self)
+    }
+
+    fn arm(&mut self, after: Duration) {
+        let mut time = syscall::TimeSpec::default();
+        if self.0.read(&mut time).is_err() {
+            return;
+        }
+        let nsec = time.tv_nsec as u64 + u64::from(after.subsec_nanos());
+        time.tv_sec += after.as_secs() as i64 + (nsec / 1_000_000_000) as i64;
+        time.tv_nsec = (nsec % 1_000_000_000) as i32;
+        let _ = self.0.write(&time);
+    }
+
+    /// Consume the event.
+    fn fired(&mut self) {
+        let mut time = syscall::TimeSpec::default();
+        let _ = self.0.read(&mut time);
+    }
+}
+
+user_data! {
+    enum Source {
+        Scheme,
+        Time,
+    }
+}
+
+fn main() {
+    daemon::SchemeDaemon::new(daemon);
+}
+
+fn daemon(daemon: daemon::SchemeDaemon) -> ! {
+    common::init();
+    let dtb = std::fs::read("/scheme/kernel.dtb").unwrap_or_default();
+    let Ok(fdt) = Fdt::new(&dtb) else {
+        eprintln!("bcm2835-pwmaudiod: no devicetree");
+        process::exit(1);
+    };
+    let (out, range, clock_hz) = open_output(&fdt);
+    let mut driver = Driver::new(out, range, clock_hz);
+
+    let mut timer = Timer::new().expect("bcm2835-pwmaudiod: failed to open /scheme/time");
+    let socket = Socket::nonblock().expect("bcm2835-pwmaudiod: failed to create the audiohw scheme");
+    let mut readiness = ReadinessBased::new(Box::new(socket), 16);
+
+    let events = EventQueue::<Source>::new().expect("bcm2835-pwmaudiod: failed to create an event queue");
+    events
+        .subscribe(readiness.socket().inner().raw(), Source::Scheme, event::EventFlags::READ)
+        .expect("bcm2835-pwmaudiod: failed to subscribe to the scheme");
+    events
+        .subscribe(timer.0.as_raw_fd() as usize, Source::Time, event::EventFlags::READ)
+        .expect("bcm2835-pwmaudiod: failed to subscribe to the timer");
+    timer.arm(POLL);
+
+    let _ = daemon.ready_sync_scheme(readiness.socket(), &mut driver);
+    libredox::call::setrens(0, 0).expect("bcm2835-pwmaudiod: failed to enter the null namespace");
+
+    for source in [Source::Scheme]
+        .into_iter()
+        .chain(events.map(|e| e.expect("bcm2835-pwmaudiod: failed to get an event").user_data))
+    {
+        match source {
+            Source::Scheme => {
+                readiness
+                    .read_and_process_requests(&mut driver)
+                    .expect("bcm2835-pwmaudiod: failed to read the scheme");
+            }
+            Source::Time => {
+                timer.fired();
+                timer.arm(POLL);
+                driver.refresh();
+                readiness
+                    .poll_all_requests(&mut driver)
+                    .expect("bcm2835-pwmaudiod: failed to poll requests");
+            }
+        }
+        readiness
+            .write_responses()
+            .expect("bcm2835-pwmaudiod: failed to write to the scheme");
+    }
+    process::exit(0);
+}
