+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+/// redox-rpi frame-diag (test only): per 2 s, frames, how many were drawn
+/// in full (age 0), and the time spent mapping the window, drawing (from
+/// buffer_mut to present) and presenting, printed to stderr.
+struct FrameDiag {
+    since: Option<Instant>,
+    frames: u32,
+    full: u32,
+    copied: u32,
+    map: Duration,
+    draw: Duration,
+    present: Duration,
+    damaged: u64,
+    pixels: u64,
+}
+
+static FRAME_DIAG: Mutex<FrameDiag> = Mutex::new(FrameDiag {
+    since: None,
+    frames: 0,
+    full: 0,
+    copied: 0,
+    map: Duration::ZERO,
+    draw: Duration::ZERO,
+    present: Duration::ZERO,
+    damaged: 0,
+    pixels: 0,
+});
+
+fn frame_diag(map: Duration, draw: Duration, present: Duration, full: bool, copied: bool, size: (u32, u32), damaged: u64) {
+    let mut d = FRAME_DIAG.lock().unwrap();
+    let now = Instant::now();
+    let since = *d.since.get_or_insert(now);
+    d.frames += 1;
+    d.full += u32::from(full);
+    d.copied += u32::from(copied);
+    d.map += map;
+    d.draw += draw;
+    d.present += present;
+    d.damaged += damaged;
+    d.pixels += u64::from(size.0) * u64::from(size.1);
+    if now.duration_since(since) >= Duration::from_secs(2) {
+        eprintln!(
+            "frame-diag: {}x{}: {} frames ({} full, {} copied) in {:.1} s: map {} ms, draw {} ms, present {} ms, damage {:.1} % of the window",
+            size.0,
+            size.1,
+            d.frames,
+            d.full,
+            d.copied,
+            now.duration_since(since).as_secs_f64(),
+            d.map.as_millis(),
+            d.draw.as_millis(),
+            d.present.as_millis(),
+            d.damaged as f64 * 100.0 / d.pixels.max(1) as f64,
+        );
+        *d = FrameDiag { since: Some(now), frames: 0, full: 0, copied: 0, map: Duration::ZERO, draw: Duration::ZERO, present: Duration::ZERO, damaged: 0, pixels: 0 };
+    }
+}
+
