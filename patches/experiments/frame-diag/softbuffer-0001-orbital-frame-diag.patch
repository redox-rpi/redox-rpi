@@ -210,6 +267,10 @@ impl<'a, D: HasDisplayHandle, W: HasWindowHandle> BufferImpl<'a, D, W> {
     }
 
     pub fn present_with_damage(self, damage: &[Rect]) -> Result<(), SoftBufferError> {
+        let presenting = Instant::now();
