+        let copied = matches!(self.pixels, Pixels::Buffer(_));
+        let (map, mapped) = (self.map, self.mapped);
         match self.pixels {
             Pixels::Mapping(mapping) => {
                 drop(mapping);
@@ -234,6 +295,7 @@ impl<'a, D: HasDisplayHandle, W: HasWindowHandle> BufferImpl<'a, D, W> {
                 .expect("failed to sync orbital window");
         }
 
+        frame_diag(map, presenting - mapped, presenting.elapsed(), full, copied, (self.imp.width, self.imp.height));
         Ok(())
     }
 }
