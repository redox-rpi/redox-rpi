Subject: [PATCH] orbital: frame-diag, time to map, draw and present per 2 s
 (test only)

---
 src/orbital.rs | 64 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 63 insertions(+), 1 deletion(-)

diff --git a/src/orbital.rs b/src/orbital.rs
index 50428ab..ea32861 100644
--- a/src/orbital.rs
+++ b/src/orbital.rs
@@ -1,3 +1,56 @@
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+/// redox-rpi frame-diag (test only): per 2 s, frames, how many were drawn
+/// in full (age 0), and the time spent mapping the window, drawing (from
+/// buffer_mut to present) and presenting, printed to stderr.
+struct FrameDiag {
+    since: Option<Instant>,
+    frames: u32,
+    full: u32,
+    copied: u32,
+    map: Duration,
+    draw: Duration,
+    present: Duration,
+}
+
+static FRAME_DIAG: Mutex<FrameDiag> = Mutex::new(FrameDiag {
+    since: None,
+    frames: 0,
+    full: 0,
+    copied: 0,
+    map: Duration::ZERO,
+    draw: Duration::ZERO,
+    present: Duration::ZERO,
+});
+
+fn frame_diag(map: Duration, draw: Duration, present: Duration, full: bool, copied: bool, size: (u32, u32)) {
+    let mut d = FRAME_DIAG.lock().unwrap();
+    let now = Instant::now();
+    let since = *d.since.get_or_insert(now);
+    d.frames += 1;
+    d.full += u32::from(full);
+    d.copied += u32::from(copied);
+    d.map += map;
+    d.draw += draw;
+    d.present += present;
+    if now.duration_since(since) >= Duration::from_secs(2) {
+        eprintln!(
+            "frame-diag: {}x{}: {} frames ({} full, {} copied) in {:.1} s: map {} ms, draw {} ms, present {} ms",
+            size.0,
+            size.1,
+            d.frames,
+            d.full,
+            d.copied,
+            now.duration_since(since).as_secs_f64(),
+            d.map.as_millis(),
+            d.draw.as_millis(),
+            d.present.as_millis(),
+        );
+        *d = FrameDiag { since: Some(now), frames: 0, full: 0, copied: 0, map: Duration::ZERO, draw: Duration::ZERO, present: Duration::ZERO };
+    }
+}
+
 use crate::error::InitError;
 use raw_window_handle::{HasDisplayHandle, HasWindowHandle, OrbitalWindowHandle, RawWindowHandle};
 use std::{cmp, marker::PhantomData, num::NonZeroU32, slice, str};
