--- a/drivers/rpi-firmwared/src/mbox.rs	2026-11-28 11:29:19.635216819 +0000
+++ b/drivers/rpi-firmwared/src/mbox.rs	2026-11-28 11:29:19.646983643 +0000
@@ -27,8 +27,9 @@
 const TAG_RESPONSE: u32 = 1 << 31;
 const TIMEOUT: Duration = Duration::from_secs(1);
 
