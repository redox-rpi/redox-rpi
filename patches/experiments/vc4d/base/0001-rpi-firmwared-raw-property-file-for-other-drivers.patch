+            let mut msg: Vec<u32> =
+                buf.chunks_exact(4).map(|w| u32::from_le_bytes([w[0], w[1], w[2], w[3]])).collect();
+            if let Err(err) = self.mbox.lock().unwrap().call_raw(&mut msg) {
+                eprintln!("rpi-firmwared: property: {err}");
