         // buf[5 + value_words] stays 0: the end tag.
 
+        self.send().map_err(|err| format!("tag 0x{tag:08x}: {err}"))?;
+
+        let buf = &*self.buf;
+        if buf[1] != RESPONSE_OK {
+            return Err(format!("tag 0x{tag:08x}: firmware error 0x{:08x}", buf[1]));
+        }
+        if buf[4] & TAG_RESPONSE == 0 {
+            if !need_answer {
+                return Ok(Vec::new());
+            }
+            return Err(format!("tag 0x{tag:08x}: not supported by the firmware"));
+        }
+        // In bytes; round up to whole words (the board MAC is 6 bytes).
+        let len = ((buf[4] & !TAG_RESPONSE) as usize).div_ceil(4);
+        Ok(buf[5..5 + len.min(value_words)].to_vec())
+    }
+
+    /// A whole message from another driver (`property` file): copied into
+    /// the buffer, sent, and the firmware's answer copied back.
+    pub fn call_raw(&mut self, msg: &mut [u32]) -> Result<(), String> {
+        if msg.len() < 3 || msg.len() > BUF_WORDS {
+            return Err(format!("raw message of {} words", msg.len()));
+        }
+        let buf = &mut *self.buf;
+        buf.fill(0);
+        buf[..msg.len()].copy_from_slice(msg);
+        buf[0] = (msg.len() * 4) as u32;
+        buf[1] = REQUEST;
+        self.send()?;
+        msg.copy_from_slice(&self.buf[..msg.len()]);
+        Ok(())
+    }
+
+    /// Hands the message in the buffer to the firmware and waits for its
+    /// answer, which the firmware writes into the same buffer.
+    fn send(&mut self) -> Result<(), String> {
         let bus = (self.buf.physical() | DMA_BUS_OFFSET) as u32;
         // The buffer is uncached; make sure it is written before the
         // firmware hears about it.
