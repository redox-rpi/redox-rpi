+        if let Handle::Property(_) = self.handles.get(id)? {
+            if buf.len() % 4 != 0 {
+                return Err(Error::new(EINVAL));
+            }
+            let mut msg: Vec<u32> =
+                buf.chunks_exact(4).map(|w| u32::from_le_bytes([w[0], w[1], w[2], w[3]])).collect();
