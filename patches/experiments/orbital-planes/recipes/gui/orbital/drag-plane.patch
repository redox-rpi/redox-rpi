+/// The first overlay plane that can show on `crtc`.
+fn find_overlay_plane(display_handle: &DrmHandle, crtc: crtc::Handle) -> Option<plane::Handle> {
+    let resources = display_handle.resource_handles().ok()?;
+    display_handle.plane_handles().ok()?.iter().copied().find(|&plane| {
+        let Ok(info) = display_handle.get_plane(plane) else {
+            return false;
+        };
+        if !resources.filter_crtcs(info.possible_crtcs()).contains(&crtc) {
+            return false;
+        }
+        let Ok(props) = display_handle.get_properties(plane) else {
+            return false;
+        };
+        props.iter().any(|(&prop, &val)| {
+            display_handle
+                .get_property(prop)
+                .is_ok_and(|prop| prop.name() == c"type" && val == u64::from(DRM_PLANE_TYPE_OVERLAY))
+        })
+    })
+}
