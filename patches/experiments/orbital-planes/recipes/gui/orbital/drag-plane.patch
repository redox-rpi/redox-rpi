+/// A window lifted onto an overlay plane: a display-sized view of its own
+/// buffer, so the window draws into it with the code that composites it.
+pub struct Lifted {
+    /// The display whose overlay plane shows it.
+    display: usize,
+    plane: plane::Handle,
+    view: Display,
+}
+
+impl Lifted {
+    pub fn view(&mut self) -> &mut Display {
+        &mut self.view
+    }
+
+    pub fn rect(&self) -> Rect {
+        self.view.screen_rect()
+    }
+
+    /// Draw the window again (its content changed during the move).
+    pub fn redraw(&mut self, draw: impl FnOnce(&mut Display, Rect)) {
+        let rect = self.view.screen_rect();
+        draw(&mut self.view, rect);
+        self.view.finish_offscreen();
+    }
+}
+
+impl Displays {
+    /// Lift `rect` (in screen coordinates) onto the overlay plane of the
+    /// display it starts on. `draw` draws into the view; None when there
+    /// is no overlay plane or the driver cannot show this buffer on it.
+    pub(super) fn lift(&mut self, rect: Rect, draw: impl FnOnce(&mut Display, Rect)) -> Option<Lifted> {
+        let index = self
+            .displays
+            .iter()
+            .position(|display| display.screen_rect().contains(rect.left(), rect.top()))?;
+        let display = &self.displays[index];
+        let plane = display.overlay?;
+        if rect.is_empty() {
+            return None;
+        }
+        let map = match V2DisplayMap::offscreen(
+            &self.display_handle,
+            display.map.connector,
+            display.map.crtc,
+            (rect.width(), rect.height()),
+        ) {
+            Ok(map) => map,
+            Err(err) => {
+                log::warn!("no buffer for the overlay plane: {err}");
+                return None;
+            }
+        };
+        let mut view = Display {
+            x: rect.left(),
+            y: rect.top(),
+            scale: display.scale,
+            factored_scale: display.factored_scale,
+            map,
+            cursor_map: None,
+            overlay: None,
+        };
+        draw(&mut view, rect);
+        view.finish_offscreen();
+        let mut lifted = Lifted {
+            display: index,
+            plane,
+            view,
+        };
+        if let Err(err) = self.show_lifted(&lifted) {
+            // The driver keeps windows it cannot scan out (vc4d: buffers
+            // not in contiguous memory) to compositing.
+            log::info!("overlay plane refused the window: {err}");
+            self.drop_lifted(lifted);
+            return None;
+        }
+        lifted.view.overlay = Some(plane);
+        Some(lifted)
+    }
+
+    fn show_lifted(&self, lifted: &Lifted) -> io::Result<()> {
+        let display = &self.displays[lifted.display];
+        let (width, height) = lifted.view.map.buffer.buffer().size();
+        self.display_handle.set_plane(
+            lifted.plane,
+            display.map.crtc,
+            Some(lifted.view.map.fb),
+            0,
+            (lifted.view.x - display.x, lifted.view.y - display.y, width, height),
+            (0, 0, width << 16, height << 16),
+        )
+    }
+
+    /// Move a lifted window; only the plane's position changes.
+    pub(super) fn move_lifted(&self, lifted: &mut Lifted, x: i32, y: i32) -> io::Result<()> {
+        lifted.view.x = x;
+        lifted.view.y = y;
+        self.show_lifted(lifted)
+    }
+
+    /// Hide the overlay plane and free the window's buffer.
+    pub(super) fn drop_lifted(&mut self, lifted: Lifted) {
+        let crtc = self.displays[lifted.display].map.crtc;
+        if let Err(err) = self
+            .display_handle
+            .set_plane(lifted.plane, crtc, None, 0, (0, 0, 0, 0), (0, 0, 0, 0))
+        {
+            error!("failed to hide the overlay plane: {err}");
+        }
+        lifted.view.map.destroy(&self.display_handle);
+    }
+}
