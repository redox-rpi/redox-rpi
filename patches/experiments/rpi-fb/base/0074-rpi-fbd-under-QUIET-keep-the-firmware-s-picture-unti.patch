From 839bfebe0d9587d1b7bdcee96bb00489b91f3c50 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Fri, 20 Nov 2026 22:12:06 +0000
Subject: [PATCH] rpi-fbd: under QUIET, keep the firmware's picture until the
 first frame

A quiet boot (QUIET set, any value but empty or 0) shows the firmware's
boot screen and, with redox-rpi's firmware, Redox's boot steps until the
login. rpi-fbd cleared a new framebuffer when the console set its mode,
which put a black frame between that picture and the login. Under QUIET
the switch leaves the new framebuffer as it is, and the first frame is
drawn over the whole screen, so the login replaces the picture in one
go. Later mode changes clear as before. 40_rpi-fbd.service inherits
QUIET.

redox-rpi #517 (quiet boot I5).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/graphics/rpi-fbd/src/main.rs   |  8 ++++++++
 drivers/graphics/rpi-fbd/src/scheme.rs | 12 +++++++++++-
 init.initfs.d/40_rpi-fbd.service       |  1 +
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/drivers/graphics/rpi-fbd/src/main.rs b/drivers/graphics/rpi-fbd/src/main.rs
index 80114c07..5d998766 100644
--- a/drivers/graphics/rpi-fbd/src/main.rs
+++ b/drivers/graphics/rpi-fbd/src/main.rs
@@ -25,6 +25,10 @@
 //! The `RPI_FB*` settings come from the environment or, without typing at
 //! the bootloader menu, from the firmware's command line (`cmdline.txt`).
 //!
+//! With `QUIET` set (quiet boot, any value but empty or `0`), the screen
+//! keeps the firmware's picture until the first frame: a new framebuffer
+//! is not cleared, and the first frame is drawn whole.
+//!
 //! With two buffers it waits for the vertical blank after a flip before
 //! drawing into the buffer that was shown, unless `RPI_FB_VSYNC=off`.
 //!
@@ -227,7 +231,11 @@ fn daemon(daemon: daemon::Daemon) -> ! {
         dma: blit_dma(),
         vsync: !setting("RPI_FB_VSYNC").is_some_and(|v| v == "off"),
         stats: Default::default(),
+        handover: setting("QUIET").is_some_and(|v| !v.is_empty() && v != "0"),
     };
+    if adapter.handover {
+        println!("rpi-fbd: quiet boot: the firmware's picture stays until the first frame");
+    }
     adapter.test_dma();
     let bench = setting("RPI_FB_BENCH").is_some();
     if bench {
diff --git a/drivers/graphics/rpi-fbd/src/scheme.rs b/drivers/graphics/rpi-fbd/src/scheme.rs
index 26b58fee..e3132f46 100644
--- a/drivers/graphics/rpi-fbd/src/scheme.rs
+++ b/drivers/graphics/rpi-fbd/src/scheme.rs
@@ -53,6 +53,11 @@ pub struct RpiAdapter {
     /// firmware does not have the tag.
     pub vsync: bool,
     pub stats: Stats,
+    /// Quiet boot (`QUIET` set): until the first frame, the screen keeps
+    /// what the firmware drew (its boot screen and Redox's boot steps), so
+    /// a new framebuffer is not cleared and the first frame replaces the
+    /// picture in one go, without a black frame in between.
+    pub handover: bool,
 }
 
 /// Blits since the last report.
@@ -202,7 +207,9 @@ impl RpiAdapter {
             syscall::Error::new(syscall::EINVAL)
         })?;
         let mut screen = Screen::map(mode)?;
-        screen.clear();
+        if !self.handover {
+            screen.clear();
+        }
         self.screen = screen;
         Ok(())
     }
@@ -467,6 +474,9 @@ impl GraphicsAdapter for RpiAdapter {
         if new_plane_state.crtc_id.is_none() {
             return Ok(());
         }
+        // The first frame after a quiet boot covers the whole screen, so
+        // nothing of the firmware's picture stays outside its damage.
+        let damage = if std::mem::take(&mut self.handover) { None } else { damage };
         match &new_plane_state.fb {
             Some(buffer) => {
                 self.wait_for_flip();
diff --git a/init.initfs.d/40_rpi-fbd.service b/init.initfs.d/40_rpi-fbd.service
index 470c819a..c7b1aac2 100644
--- a/init.initfs.d/40_rpi-fbd.service
+++ b/init.initfs.d/40_rpi-fbd.service
@@ -18,5 +18,6 @@ inherit_envs = [
     "RPI_FB_DMA",
     "RPI_FB_BENCH",
     "RPI_FB_VSYNC",
+    "QUIET",
 ]
 type = "notify"
-- 
