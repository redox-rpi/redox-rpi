From e0e5146607c75ff137751327964e4038d81790cf Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Sat, 31 Oct 2026 15:19:03 +0000
Subject: [PATCH] rpi-fbd: DMA control block as the Pi Linux framebuffer driver
 has it: lowest priority, no WAIT_RESP, bursts of 2

---
 drivers/graphics/rpi-fbd/src/dma.rs | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/drivers/graphics/rpi-fbd/src/dma.rs b/drivers/graphics/rpi-fbd/src/dma.rs
index 8e343532..5023e516 100644
--- a/drivers/graphics/rpi-fbd/src/dma.rs
+++ b/drivers/graphics/rpi-fbd/src/dma.rs
@@ -41,19 +41,17 @@ const CS_ERROR: u32 = 1 << 8;
 const CS_WAIT_FOR_OUTSTANDING_WRITES: u32 = 1 << 28;
 const CS_ABORT: u32 = 1 << 30;
 const CS_RESET: u32 = 1 << 31;
-/// AXI priority 8, panic priority 15, as Linux uses.
-const CS_PRIORITY: u32 = 8 << 16 | 15 << 20;
 
 // TI, in the control block
 const TI_TDMODE: u32 = 1 << 1;
-const TI_WAIT_RESP: u32 = 1 << 3;
 const TI_DEST_INC: u32 = 1 << 4;
 const TI_DEST_WIDTH: u32 = 1 << 5;
 const TI_SRC_INC: u32 = 1 << 8;
 const TI_SRC_WIDTH: u32 = 1 << 9;
 const TI_BURST_SHIFT: u32 = 12;
-/// Bursts of this many words on the 128-bit bus.
-const BURST: u32 = 4;
+/// Bursts of this many words on the 128-bit bus. Two, as the Pi's Linux
+/// framebuffer driver uses for its 2D blits on any channel but 0.
+const BURST: u32 = 2;
 
 // DEBUG; each bit is cleared by writing 1
 const DEBUG_ERRORS: u32 = 0x7;
@@ -246,8 +244,13 @@ impl BlitDma {
         let width_bits = if wide { TI_SRC_WIDTH | TI_DEST_WIDTH } else { 0 };
         let src_gap = (blit.src_pitch - blit.width) as u16;
         let dst_gap = (blit.dst_pitch - blit.width) as u16;
+        // No TI_WAIT_RESP and the lowest AXI priority, as the Pi's Linux
+        // framebuffer driver has for the same 2D blits into the
+        // framebuffer. With WAIT_RESP and priority 8, panic priority 15
+        // (copied from the SD card driver, whose transfers the card paces),
+        // the first blit of 64 full rows stopped the whole Pi (test 145).
         *self.cb = ControlBlock {
-            ti: TI_TDMODE | TI_SRC_INC | TI_DEST_INC | TI_WAIT_RESP | width_bits | BURST << TI_BURST_SHIFT,
+            ti: TI_TDMODE | TI_SRC_INC | TI_DEST_INC | width_bits | BURST << TI_BURST_SHIFT,
             source: self.bus(blit.src),
             dest: self.bus(blit.dst),
             len: (blit.rows as u32) << 16 | blit.width as u32,
@@ -260,7 +263,7 @@ impl BlitDma {
         // but the writes may still sit in a write buffer.
         barrier();
         self.set_reg(CONBLK_AD, cb_bus);
-        self.set_reg(CS, CS_ACTIVE | CS_END | CS_INT | CS_PRIORITY | CS_WAIT_FOR_OUTSTANDING_WRITES);
+        self.set_reg(CS, CS_ACTIVE | CS_END | CS_INT | CS_WAIT_FOR_OUTSTANDING_WRITES);
 
         let start = Instant::now();
         loop {
