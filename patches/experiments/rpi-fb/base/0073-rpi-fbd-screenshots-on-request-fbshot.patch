+mod shot;
 
 /// When the firmware reports no display size.
 const DEFAULT_SIZE: (u32, u32) = (1024, 768);
 /// How often the EDID is read again, for a monitor turned on later.
 const EDID_POLL: Duration = Duration::from_secs(5);
+/// How often a screenshot request (`shot.rs`) is looked for.
+const TICK: Duration = Duration::from_millis(500);
 /// Double buffering at start only when both screens take at most this part
 /// of the GPU memory; the firmware needs the rest.
 const DOUBLE_SHARE: usize = 2;
 
 fn main() {
+    let args: Vec<String> = env::args().collect();
+    let tool = args.first().is_some_and(|a| a.ends_with("fbshot"));
+    if tool || args.get(1).is_some_and(|a| a == "shot") {
+        let path = args.get(if tool { 1 } else { 2 }).map_or(shot::DEFAULT_PATH, String::as_str);
+        std::process::exit(shot::request(path));
+    }
     common::init();
     daemon::Daemon::new(daemon);
 }
