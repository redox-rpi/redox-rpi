-    now.tv_sec += EDID_POLL.as_secs() as i64;
+    let nanos = now.tv_nsec as i64 + TICK.as_nanos() as i64;
+    now.tv_sec += nanos / 1_000_000_000;
+    now.tv_nsec = (nanos % 1_000_000_000) as i32;
