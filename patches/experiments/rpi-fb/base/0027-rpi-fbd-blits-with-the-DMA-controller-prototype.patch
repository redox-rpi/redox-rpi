@@ -0,0 +1,347 @@
+//! Blits from dumb buffers to the framebuffer with the BCM2835 DMA
+//! controller (redox-rpi docs/topics/graphics.md step 2, a prototype).
+//!
+//! Channel 5 is the framebuffer's in the channel table of
+//! docs/topics/dma.md. One control block in 2D mode moves a damaged
+//! rectangle: a number of rows of the same length, with a gap after each
+//! row in the source and in the destination. Memory to memory needs no DREQ;
+//! the driver polls for the end.
+//!
+//! The register helpers are a copy of bcm2835-sdhostd's dma.rs (#21). They
+//! belong in a common crate once both drivers work on the Pi.
+
+use std::fmt;
+use std::time::{Duration, Instant};
+
+use common::dma::Dma;
+use fdt::Fdt;
+
+/// Bus address of the controller on all BCM283x, if the devicetree has none.
+const DMA_BUS_ADDR: usize = 0x7e00_7000;
+/// The channel this driver owns (docs/topics/dma.md, channel table).
+const CHANNEL: usize = 5;
+const CHANNEL_SIZE: usize = 0x100;
+/// RAM as the controller sees it when the devicetree has no dma-ranges: the
+/// alias that bypasses the VideoCore L2 cache.
+const RAM_BUS_OFFSET: usize = 0xc000_0000;
+
+// Channel registers, as byte offsets.
+const CS: usize = 0x00;
+const CONBLK_AD: usize = 0x04;
+const TXFR_LEN: usize = 0x14;
+const DEBUG: usize = 0x20;
+/// Global register: one enable bit per channel, shared with other drivers.
+const ENABLE: usize = 0xff0;
+
+// CS
+const CS_ACTIVE: u32 = 1 << 0;
+const CS_END: u32 = 1 << 1;
+const CS_INT: u32 = 1 << 2;
+const CS_ERROR: u32 = 1 << 8;
+const CS_WAIT_FOR_OUTSTANDING_WRITES: u32 = 1 << 28;
+const CS_ABORT: u32 = 1 << 30;
+const CS_RESET: u32 = 1 << 31;
+/// AXI priority 8, panic priority 15, as Linux uses.
+const CS_PRIORITY: u32 = 8 << 16 | 15 << 20;
+
+// TI, in the control block
+const TI_TDMODE: u32 = 1 << 1;
+const TI_WAIT_RESP: u32 = 1 << 3;
+const TI_DEST_INC: u32 = 1 << 4;
+const TI_DEST_WIDTH: u32 = 1 << 5;
+const TI_SRC_INC: u32 = 1 << 8;
+const TI_SRC_WIDTH: u32 = 1 << 9;
+const TI_BURST_SHIFT: u32 = 12;
+/// Bursts of this many words on the 128-bit bus.
+const BURST: u32 = 4;
+
+// DEBUG; each bit is cleared by writing 1
+const DEBUG_ERRORS: u32 = 0x7;
+
+/// 2D mode: at most this many rows (14 bits) and bytes per row (16 bits).
+const MAX_ROWS: usize = 0x3fff;
+const MAX_ROW_BYTES: usize = 0xffff;
+/// A full screen at 1920x1200 takes a few milliseconds.
+const TIMEOUT: Duration = Duration::from_millis(500);
+
+/// One control block; the controller needs them aligned to 32 bytes.
+#[repr(C, align(32))]
+struct ControlBlock {
+    ti: u32,
+    source: u32,
+    dest: u32,
+    len: u32,
+    stride: u32,
+    next: u32,
+    _reserved: [u32; 2],
+}
+
+#[derive(Debug)]
+pub enum DmaError {
+    /// CS.ERROR with the DEBUG register.
+    Controller { cs: u32, debug: u32 },
+    Timeout { cs: u32, remaining: u32 },
+}
+
+impl fmt::Display for DmaError {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            DmaError::Controller { cs, debug } => {
+                write!(f, "DMA error (CS 0x{cs:08x}, DEBUG 0x{debug:08x})")
+            }
+            DmaError::Timeout { cs, remaining } => {
+                write!(f, "DMA timeout (CS 0x{cs:08x}, TXFR_LEN 0x{remaining:08x})")
+            }
+        }
+    }
+}
+
+/// A rectangle of 32-bit pixels between two physically contiguous buffers.
+#[derive(Clone, Copy, Debug)]
+pub struct Blit {
+    /// Physical address of the first pixel in the source and destination.
+    pub src: usize,
+    pub dst: usize,
+    /// Bytes from one row to the next.
+    pub src_pitch: usize,
+    pub dst_pitch: usize,
+    /// Bytes per row, and rows.
+    pub width: usize,
+    pub rows: usize,
+}
+
+pub struct BlitDma {
+    /// The channel's registers.
+    regs: *mut u32,
+    /// The controller's register page, for ENABLE.
+    page: *mut u32,
+    cb: Dma<ControlBlock>,
+    /// Added to a physical RAM address to get its bus address.
+    ram_bus_offset: usize,
+    /// Rows the controller moves beyond YLENGTH in 2D mode (0 or 1), found
+    /// by `calibrate`.
+    extra_rows: usize,
+}
+
+// The channel and the control block belong to this driver alone.
+unsafe impl Send for BlitDma {}
+
+impl fmt::Debug for BlitDma {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("BlitDma")
+            .field("ram_bus_offset", &self.ram_bus_offset)
+            .field("extra_rows", &self.extra_rows)
+            .finish()
+    }
+}
+
+impl BlitDma {
+    /// Set up the channel. Fails if the devicetree does not leave it free.
+    pub fn new(fdt: &Fdt) -> Result<Self, String> {
+        let node = fdt.find_compatible(&["brcm,bcm2835-dma"]);
+        let mask = node
+            .and_then(|node| node.property("brcm,dma-channel-mask"))
+            .and_then(|prop| prop.as_usize())
+            .ok_or("no brcm,dma-channel-mask in the devicetree")?;
+        if mask & 1 << CHANNEL == 0 {
+            return Err(format!("channel {CHANNEL} not free (mask 0x{mask:x})"));
+        }
+        let bus_addr = node
+            .and_then(|node| node.reg())
+            .and_then(|mut reg| reg.next())
+            .map(|reg| reg.starting_address as usize)
+            .unwrap_or(DMA_BUS_ADDR);
+        let phys = soc_phys(fdt, bus_addr);
+
+        let page = unsafe {
+            common::physmap(phys, 0x1000, common::Prot::RW, common::MemoryType::DeviceMemory)
+                .map_err(|err| format!("failed to map the controller: {err:?}"))?
+                as *mut u32
+        };
+        let cb = Dma::new(ControlBlock {
+            ti: 0,
+            source: 0,
+            dest: 0,
+            len: 0,
+            stride: 0,
+            next: 0,
+            _reserved: [0; 2],
+        })
+        .map_err(|err| format!("failed to allocate the control block: {err}"))?;
+
+        let mut dma = BlitDma {
+            regs: unsafe { page.add(CHANNEL * CHANNEL_SIZE / 4) },
+            page,
+            cb,
+            ram_bus_offset: ram_bus_offset(fdt),
+            extra_rows: 0,
+        };
+        // Read-modify-write that only sets this channel's bit: other drivers
+        // own the other bits.
+        let enable = dma.page_reg(ENABLE);
+        dma.set_page_reg(ENABLE, enable | 1 << CHANNEL);
+        dma.reset();
+        dma.calibrate()?;
+        println!(
+            "rpi-fbd: DMA channel {CHANNEL} at 0x{phys:08x}, 2D mode moves YLENGTH{} rows",
+            if dma.extra_rows == 0 { "" } else { "+1" }
+        );
+        Ok(dma)
+    }
+
+    /// Whether 2D mode moves YLENGTH or YLENGTH+1 rows: QEMU does the first,
+    /// and it is not clear what the real controller does. A blit of two
+    /// rows between two small buffers shows it.
+    fn calibrate(&mut self) -> Result<(), String> {
+        const ROW: usize = 64;
+        let alloc = || unsafe {
+            Dma::<[u32]>::zeroed_slice(4 * ROW / 4)
+                .map(|dma| dma.assume_init())
+                .map_err(|err| format!("failed to allocate the test buffers: {err}"))
+        };
+        let (mut src, dst) = (alloc()?, alloc()?);
+        src.fill(0x5a5a_5a5a);
+        self.run(Blit {
+            src: src.physical(),
+            dst: dst.physical(),
+            src_pitch: ROW,
+            dst_pitch: ROW,
+            width: ROW,
+            rows: 2,
+        })
+        .map_err(|err| format!("test blit: {err}"))?;
+        let rows = dst.chunks(ROW / 4).filter(|row| row[0] != 0).count();
+        match rows {
+            2 => self.extra_rows = 0,
+            3 => self.extra_rows = 1,
+            _ => return Err(format!("test blit of 2 rows moved {rows}")),
+        }
+        Ok(())
+    }
+
+    /// Copies the rectangle and waits for the end.
+    pub fn blit(&mut self, blit: Blit) -> Result<(), DmaError> {
+        assert!(blit.rows > 0);
+        self.run(Blit { rows: blit.rows - self.extra_rows, ..blit })
+    }
+
+    /// Runs one control block; `blit.rows` is the YLENGTH field.
+    fn run(&mut self, blit: Blit) -> Result<(), DmaError> {
+        assert!(blit.rows <= MAX_ROWS);
+        assert!(blit.width > 0 && blit.width <= MAX_ROW_BYTES && blit.width % 4 == 0);
+        // 128-bit accesses need both addresses and both pitches on 16 bytes.
+        let wide = [blit.src, blit.dst, blit.src_pitch, blit.dst_pitch, blit.width]
+            .iter()
+            .all(|n| n % 16 == 0);
+        let width_bits = if wide { TI_SRC_WIDTH | TI_DEST_WIDTH } else { 0 };
+        let src_gap = (blit.src_pitch - blit.width) as u16;
+        let dst_gap = (blit.dst_pitch - blit.width) as u16;
+        *self.cb = ControlBlock {
+            ti: TI_TDMODE | TI_SRC_INC | TI_DEST_INC | TI_WAIT_RESP | width_bits | BURST << TI_BURST_SHIFT,
+            source: self.bus(blit.src),
+            dest: self.bus(blit.dst),
+            len: (blit.rows as u32) << 16 | blit.width as u32,
+            stride: (dst_gap as u32) << 16 | src_gap as u32,
+            next: 0,
+            _reserved: [0; 2],
+        };
+        let cb_bus = self.bus(self.cb.physical());
+        // The control block and the buffers are uncached or write-combining,
+        // but the writes may still sit in a write buffer.
+        barrier();
+        self.set_reg(CONBLK_AD, cb_bus);
+        self.set_reg(CS, CS_ACTIVE | CS_END | CS_INT | CS_PRIORITY | CS_WAIT_FOR_OUTSTANDING_WRITES);
+
+        let start = Instant::now();
+        loop {
+            let cs = self.reg(CS);
+            if cs & CS_ERROR != 0 {
+                let debug = self.reg(DEBUG);
+                self.reset();
+                return Err(DmaError::Controller { cs, debug });
+            }
+            if cs & CS_END != 0 {
+                self.set_reg(CS, CS_END | CS_INT);
+                barrier();
+                return Ok(());
+            }
+            if start.elapsed() > TIMEOUT {
+                let remaining = self.reg(TXFR_LEN);
+                self.reset();
+                return Err(DmaError::Timeout { cs, remaining });
+            }
+            std::hint::spin_loop();
+        }
+    }
+
+    /// Stop whatever the channel does and clear its errors. Only this
+    /// channel: the global registers are shared.
+    fn reset(&self) {
+        if self.reg(CS) & CS_ACTIVE != 0 {
+            self.set_reg(CS, CS_ABORT);
+            let start = Instant::now();
+            while self.reg(CS) & CS_ACTIVE != 0 && start.elapsed() < Duration::from_millis(10) {}
+        }
+        self.set_reg(CS, CS_RESET);
+        self.set_reg(DEBUG, DEBUG_ERRORS);
+    }
+
+    fn bus(&self, phys: usize) -> u32 {
+        (phys + self.ram_bus_offset) as u32
+    }
+
+    fn reg(&self, offset: usize) -> u32 {
+        unsafe { self.regs.add(offset / 4).read_volatile() }
+    }
+
+    fn set_reg(&self, offset: usize, value: u32) {
+        unsafe { self.regs.add(offset / 4).write_volatile(value) }
+    }
+
+    fn page_reg(&self, offset: usize) -> u32 {
+        unsafe { self.page.add(offset / 4).read_volatile() }
+    }
+
+    fn set_page_reg(&self, offset: usize, value: u32) {
+        unsafe { self.page.add(offset / 4).write_volatile(value) }
+    }
+}
+
+/// The CPU physical address of a peripheral's bus address, through `/soc`'s
+/// ranges.
+fn soc_phys(fdt: &Fdt, bus_addr: usize) -> usize {
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.ranges())
+        .and_then(|mut ranges| {
+            ranges.find(|r| {
+                r.child_bus_address <= bus_addr && bus_addr - r.child_bus_address < r.size
+            })
+        })
+        .map(|r| r.parent_bus_address + (bus_addr - r.child_bus_address))
+        .unwrap_or(bus_addr)
+}
+
+/// Bus address minus physical address of RAM, from the first entry of
+/// `/soc`'s dma-ranges (one cell each for bus address, physical address and
+/// size on the BCM283x).
+fn ram_bus_offset(fdt: &Fdt) -> usize {
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.property("dma-ranges"))
+        .filter(|prop| prop.value.len() >= 12)
+        .map(|prop| {
+            let cell = |i: usize| u32::from_be_bytes(prop.value[i * 4..i * 4 + 4].try_into().unwrap());
+            (cell(0) as usize).wrapping_sub(cell(1) as usize)
+        })
+        .unwrap_or(RAM_BUS_OFFSET)
+}
+
+/// Make the CPU's writes visible before the register write that starts the
+/// controller, and the controller's writes before the CPU goes on.
+fn barrier() {
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!("dsb sy", options(nostack, preserves_flags));
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    std::sync::atomic::fence(std::sync::atomic::Ordering::SeqCst);
+}
