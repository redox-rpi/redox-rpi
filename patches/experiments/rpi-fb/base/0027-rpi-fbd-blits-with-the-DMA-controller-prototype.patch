+/// The DMA controller's framebuffer channel, unless `RPI_FB_DMA=off` or it
+/// is not free.
+fn blit_dma() -> Option<BlitDma> {
+    if env::var("RPI_FB_DMA").is_ok_and(|v| v == "off") {
+        println!("rpi-fbd: blits with the CPU (RPI_FB_DMA=off)");
+        return None;
+    }
+    let dtb = std::fs::read("/scheme/kernel.dtb").unwrap_or_default();
+    let result = Fdt::new(&dtb)
+        .map_err(|err| format!("no devicetree: {err}"))
+        .and_then(|fdt| BlitDma::new(&fdt));
+    match result {
+        Ok(dma) => Some(dma),
+        Err(err) => {
+            println!("rpi-fbd: blits with the CPU: {err}");
+            None
+        }
+    }
+}
+
