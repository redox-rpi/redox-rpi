 /// Sizes offered besides the monitor's own: the firmware scales any size to
@@ -36,6 +40,41 @@ pub struct RpiAdapter {
     pub edid: Option<Vec<u8>>,
     /// Screen off through the firmware (a client set no mode).
     pub blanked: bool,
+    /// Blits with the DMA controller; None copies with the CPU.
+    pub dma: Option<BlitDma>,
+    pub stats: Stats,
+}
+
+/// Blits since the last report.
+#[derive(Debug, Default)]
+pub struct Stats {
+    frames: u32,
+    dma_bytes: usize,
+    dma_time: Duration,
+    cpu_bytes: usize,
+    cpu_time: Duration,
+}
+
+impl Stats {
+    fn add(&mut self, dma: bool, bytes: usize, time: Duration) {
+        if dma {
+            self.dma_bytes += bytes;
+            self.dma_time += time;
+        } else {
+            self.cpu_bytes += bytes;
+            self.cpu_time += time;
+        }
+    }
+}
+
+/// "12.3 MB in 4.5 ms (2733 MB/s)"
+fn rate(bytes: usize, time: Duration) -> String {
+    let mb = bytes as f64 / 1e6;
+    format!(
+        "{mb:.1} MB in {:.1} ms ({:.0} MB/s)",
+        time.as_secs_f64() * 1e3,
+        mb / time.as_secs_f64().max(1e-9)
+    )
 }
 
 /// The framebuffer the firmware scans out, mapped into this process. With
@@ -123,6 +162,73 @@ impl RpiAdapter {
         self.edid = edid;
         true
     }
+
+    /// Prints the blits since the last call, if there were any.
+    pub fn report(&mut self) {
+        let stats = std::mem::take(&mut self.stats);
+        if stats.frames == 0 {
+            return;
+        }
+        let mut line = format!("rpi-fbd: {} frames", stats.frames);
+        if stats.dma_bytes > 0 {
+            line += &format!(", DMA {}", rate(stats.dma_bytes, stats.dma_time));
+        }
+        if stats.cpu_bytes > 0 {
+            line += &format!(", CPU {}", rate(stats.cpu_bytes, stats.cpu_time));
+        }
+        println!("{line}");
+    }
+
+    /// `RPI_FB_BENCH`: full-screen blits and drawing, CPU against DMA, in
+    /// normal (cached) and in DMA (uncached) memory.
+    pub fn bench(&mut self) {
+        const ROUNDS: u32 = 10;
+        let (width, height) = (self.screen.mode.width as usize, self.screen.mode.height as usize);
+        let bytes = width * height * 4 * ROUNDS as usize;
+        let mut buffers = vec![("cached", GraphicScreen::new(width, height, None))];
+        if self.dma.is_some() {
+            match GraphicScreen::new_dma(width, height) {
+                Some(buffer) => buffers.push(("uncached", buffer)),
+                None => println!("rpi-fbd: bench: no DMA memory for {width}x{height}"),
+            }
+        }
+        for (name, buffer) in &mut buffers {
+            // Drawing: fill the screen, then scroll it up by 16 rows as a
+            // console does, both in the dumb buffer.
+            let pixels = unsafe { &mut *buffer.ptr.as_ptr() };
+            let start = Instant::now();
+            for round in 0..ROUNDS {
+                pixels.fill(0x0010_2030 + round);
+            }
+            let fill = start.elapsed();
+            let start = Instant::now();
+            for _ in 0..ROUNDS {
+                pixels.copy_within(16 * width.., 0);
+            }
+            let scroll = start.elapsed();
+            println!(
+                "rpi-fbd: bench {name}: fill {}, scroll {}",
+                rate(bytes, fill),
+                rate(bytes - 16 * width * 4 * ROUNDS as usize, scroll)
+            );
+            for use_dma in [false, true] {
+                if use_dma && buffer.dma.is_none() {
+                    continue;
+                }
+                let mut dma = if use_dma { self.dma.as_mut() } else { None };
+                let start = Instant::now();
+                for _ in 0..ROUNDS {
+                    let _ = buffer.sync(&mut self.screen, 0, None, dma.as_deref_mut(), &mut Stats::default());
+                }
+                println!(
+                    "rpi-fbd: bench {name}: blit with {} {}",
+                    if use_dma { "DMA" } else { "CPU" },
+                    rate(bytes, start.elapsed())
+                );
+            }
+        }
+        self.screen.clear();
