From 091b9da13ae30243586992080f01bdee2393817e Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Sat, 31 Oct 2026 14:55:21 +0000
Subject: [PATCH] rpi-fbd: DMA blits only with RPI_FB_DMA=on

---
 drivers/graphics/rpi-fbd/src/main.rs | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/drivers/graphics/rpi-fbd/src/main.rs b/drivers/graphics/rpi-fbd/src/main.rs
index c43eb854..179639a2 100644
--- a/drivers/graphics/rpi-fbd/src/main.rs
+++ b/drivers/graphics/rpi-fbd/src/main.rs
@@ -17,10 +17,10 @@
 //! makes that size the preferred mode, `RPI_FB=off` leaves the display to
 //! `vesad`.
 //!
-//! Blits from the clients' dumb buffers to the screen go through the DMA
-//! controller when it has a free channel; `RPI_FB_DMA=off` copies with the
-//! CPU, `RPI_FB_BENCH=1` measures both at start and logs the blits every
-//! few seconds.
+//! Blits from the clients' dumb buffers to the screen go through the CPU;
+//! with `RPI_FB_DMA=on` through the DMA controller when it has a free
+//! channel. `RPI_FB_BENCH=1` measures both at start and logs the blits
+//! every few seconds.
 //!
 //! The `RPI_FB*` settings come from the environment or, without typing at
 //! the bootloader menu, from the firmware's command line (`cmdline.txt`).
@@ -112,8 +112,11 @@ fn boot_framebuffer() -> Option<Mode> {
 /// The DMA controller's framebuffer channel, unless `RPI_FB_DMA=off` or it
 /// is not free.
 fn blit_dma() -> Option<BlitDma> {
-    if setting("RPI_FB_DMA").is_some_and(|v| v == "off") {
-        println!("rpi-fbd: blits with the CPU (RPI_FB_DMA=off)");
+    // Off unless asked for: on the Pi (test 145) the first blit of many
+    // rows into the framebuffer stopped the whole machine, which no
+    // timeout here can catch.
+    if !setting("RPI_FB_DMA").is_some_and(|v| v == "on") {
+        println!("rpi-fbd: blits with the CPU (DMA only with RPI_FB_DMA=on)");
         return None;
     }
     let dtb = std::fs::read("/scheme/kernel.dtb").unwrap_or_default();
-- 
