From 02790192265591b697dc4f90ca3f0de72aee100b Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 16 Nov 2026 17:33:18 +0000
Subject: [PATCH] graphical_debug: no boot messages on the screen with QUIET=1

With QUIET set in the kernel environment (any value but empty or 0),
graphical_debug::init does not set up the debug display, so the kernel
draws nothing on the boot framebuffer. The messages still go to the
serial console and the kernel log, and FRAMEBUFFER is still recorded for
the memory map.

redox-rpi #518: on the Raspberry Pi, rpi-boot-stub sets QUIET=1 for the
word "quiet" in the kernel command line.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/devices/graphical_debug/mod.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/devices/graphical_debug/mod.rs b/src/devices/graphical_debug/mod.rs
index b701c9a..8f746af 100644
--- a/src/devices/graphical_debug/mod.rs
+++ b/src/devices/graphical_debug/mod.rs
@@ -18,6 +18,7 @@ pub fn init(env: &[u8]) {
     let mut width = 0;
     let mut height = 0;
     let mut stride = 0;
+    let mut quiet = false;
 
     //TODO: should errors be reported?
     for line in str::from_utf8(env).unwrap_or("").lines() {
@@ -44,6 +45,12 @@ pub fn init(env: &[u8]) {
         if name == "FRAMEBUFFER_STRIDE" {
             stride = usize::from_str_radix(value, 16).unwrap_or(0);
         }
+
+        // QUIET=1 (quiet boot): the boot messages stay off the screen. They
+        // still go to the serial console and the kernel log.
+        if name == "QUIET" {
+            quiet = !value.is_empty() && value != "0";
+        }
     }
 
     *FRAMEBUFFER.lock() = (phys, virt, stride * height * 4);
@@ -58,6 +65,11 @@ pub fn init(env: &[u8]) {
         width, height, stride, phys, virt
     );
 
+    if quiet {
+        println!("QUIET is set: no boot messages on the framebuffer");
+        return;
+    }
+
     let debug_display = DebugDisplay::new(width, height, stride, virt as *mut u32);
     *DEBUG_DISPLAY.lock() = Some(debug_display);
 }
