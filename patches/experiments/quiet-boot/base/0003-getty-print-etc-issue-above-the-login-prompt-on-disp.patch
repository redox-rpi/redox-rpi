From 278fe429c56c4b97e09aa2442bebfe8530a69b2e Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Fri, 20 Nov 2026 22:12:54 +0000
Subject: [PATCH] getty: print /etc/issue above the login prompt on display
 consoles

If /etc/issue exists, getty writes it on a display console (`getty N`,
/scheme/fbcon.N) after clearing the screen and before it starts login,
each time, as getty does on other systems. The text is printed as it is
(no escapes are expanded); line ends become CR LF. The serial console
(`getty /scheme/debug/...`) does not print it: its output also shows on
the active display console, so the text would appear there twice.
Without the file nothing changes.

redox-rpi uses it for the quiet-boot hint "Super+F1: boot messages"
(redox-rpi #517, quiet boot I5).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 getty/src/main.rs | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/getty/src/main.rs b/getty/src/main.rs
index d2f4d277..2599f79b 100644
--- a/getty/src/main.rs
+++ b/getty/src/main.rs
@@ -279,6 +279,16 @@ fn daemon(tty: &mut File, clear: bool, contain: bool, stderr: &mut Stderr) {
             .write(true)
             .open(&pty)
             .expect("getty: failed to open slave stdout");
+        // /etc/issue, if there is one, above the login prompt, as getty
+        // does on other systems (the text as it is, without escapes). Only
+        // on the display consoles: the hint is about their keys.
+        if let Some(issue) = SHOW_ISSUE
+            .load(std::sync::atomic::Ordering::Relaxed)
+            .then(|| std::fs::read_to_string("/etc/issue").ok())
+            .flatten()
+        {
+            let _ = (&slave_stdout).write_all(issue.as_bytes());
+        }
         let slave_stderr = File::options()
             .write(true)
             .open(&pty)
@@ -320,6 +330,9 @@ fn daemon(tty: &mut File, clear: bool, contain: bool, stderr: &mut Stderr) {
     }
 }
 
+/// Set for a display console (`getty <number>`), where /etc/issue is shown.
+static SHOW_ISSUE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
 pub fn main() {
     let mut stderr = io::stderr();
 
@@ -338,6 +351,7 @@ pub fn main() {
 
     let buf: String;
     let vt_path = if vt.parse::<usize>().is_ok() {
+        SHOW_ISSUE.store(true, std::sync::atomic::Ordering::Relaxed);
         buf = format!("/scheme/fbcon.{vt}");
         &*buf
     } else {
