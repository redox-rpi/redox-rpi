+/// Boot steps on our firmware's boot screen (quiet boot, rpi-open-firmware
+/// #43).
+#[derive(Clone, Copy, PartialEq)]
+enum BootSteps {
+    /// QUIET is not set: steps are accepted and dropped.
+    Loud,
+    /// Steps go to the firmware.
+    Sending,
+    /// The last step went out; the firmware draws nothing after it.
+    Done,
+    /// The firmware did not draw a step: none are sent in this boot.
+    Off,
+}
+
+impl BootSteps {
+    fn from_env() -> Self {
+        match std::env::var("QUIET") {
+            Ok(v) if !v.is_empty() && v != "0" => BootSteps::Sending,
+            _ => BootSteps::Loud,
+        }
+    }
+
+    /// One line `PCT [fail] [last] TEXT`.
+    fn send(&mut self, mbox: &mut Mailbox, line: &str) -> Result<()> {
+        match *self {
+            BootSteps::Loud | BootSteps::Done => return Ok(()),
+            BootSteps::Off => return Err(Error::new(EIO)),
+            BootSteps::Sending => {}
+        }
+        let (request, last) = boot_step_request(line).ok_or(Error::new(EINVAL))?;
+        match mbox.property(TAG_BOOT_STEP, &request, 1).as_deref() {
+            Ok([1, ..]) => {
+                if last {
+                    *self = BootSteps::Done;
+                }
+                Ok(())
+            }
+            answer => {
+                let why = match answer {
+                    Ok(words) => format!("answer {words:x?}"),
+                    Err(err) => err.clone(),
+                };
+                println!("rpi-firmwared: the firmware draws no boot steps ({why}), none sent in this boot");
+                *self = BootSteps::Off;
+                Err(Error::new(EIO))
+            }
+        }
+    }
+}
+
+/// The value buffer of tag 0x000f0002 for a line `PCT [fail] [last] TEXT`:
+/// percent (0xFFFFFFFF for `-`), flags (bit 0 failed, bit 1 last), then the
+/// text, ASCII, at most 79 characters and a NUL. Also says whether it is
+/// the last step.
+fn boot_step_request(line: &str) -> Option<([u32; 22], bool)> {
+    let mut words = line.split_whitespace().peekable();
+    let pct = match words.next()? {
+        "-" => u32::MAX,
+        pct => pct.parse::<u32>().ok().filter(|pct| *pct <= 100)?,
+    };
+    let mut flags = 0;
+    while let Some(word) = words.peek() {
+        match *word {
+            "fail" => flags |= 1,
+            "last" => flags |= 2,
+            _ => break,
+        }
+        words.next();
+    }
+    let text: Vec<&str> = words.collect();
+    let mut bytes = [0u8; 80];
+    for (byte, c) in bytes.iter_mut().zip(text.join(" ").chars().take(79)) {
+        *byte = if c.is_ascii() && !c.is_ascii_control() { c as u8 } else { b'?' };
+    }
+    let mut request = [0u32; 22];
+    request[0] = pct;
+    request[1] = flags;
+    for (word, chunk) in request[2..].iter_mut().zip(bytes.chunks(4)) {
+        *word = u32::from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]);
+    }
+    Some((request, flags & 2 != 0))
+}
+
+/// `rpi-firmwared step PCT [fail] [last] TEXT`: one boot step, for init. A
+/// step the firmware does not draw is no error: the boot goes on as before.
+fn step(args: &[String]) {
+    let line = args.join(" ");
+    match std::fs::write(BOOTSTEP_PATH, line.as_bytes()) {
+        Ok(()) => {}
+        Err(err) if err.raw_os_error() == Some(EIO) || err.raw_os_error() == Some(ENOENT) => {}
+        Err(err) => eprintln!("rpi-firmwared: boot step {line:?}: {err}"),
+    }
+}
+
 struct FirmwareScheme {
     mbox: Arc<Mutex<Mailbox>>,
+    boot_steps: BootSteps,
     // Lock order: the governor before the mailbox.
     governor: Arc<Mutex<Governor>>,
     handles: HandleMap<Handle>,
@@ -152,6 +260,7 @@ impl FirmwareScheme {
                 println!("rpi-firmwared: governor {value}");
                 Ok(())
             }
+            "bootstep" => self.boot_steps.send(mbox, value),
             "arm_clock" => {
                 let rate = match value {
                     "max" => mbox.value_of(TAG_GET_MAX_CLOCK_RATE, CLOCK_ARM).map_err(log)?,
@@ -449,6 +558,11 @@ fn mbox_phys(fdt: &Fdt) -> usize {
 }
 
 fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.first().map(String::as_str) == Some("step") {
+        step(&args[1..]);
+        return;
+    }
     daemon::SchemeDaemon::new(daemon);
 }
 
@@ -472,6 +586,7 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
     let governor = Arc::new(Mutex::new(Governor::new(&mut mbox.lock().unwrap())));
     let mut scheme = FirmwareScheme {
         mbox: mbox.clone(),
+        boot_steps: BootSteps::from_env(),
         governor: governor.clone(),
         handles: HandleMap::new(),
     };
