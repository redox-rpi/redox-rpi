+    /// ISIG was switched on again. Input that came while it was off (a line
+    /// editor in raw mode) is still unread; an interrupt character in it
+    /// becomes SIGINT now, as if ISIG had been on when it arrived. Without
+    /// this a Ctrl-C typed right after Enter is read by the next prompt.
+    pub fn isig_enabled(&mut self) {
+        let vintr = self.termios.c_cc[VINTR];
+        if vintr == 0 || vintr == _POSIX_VDISABLE {
+            return;
+        }
+        let pending = self.mosi.iter().flatten().chain(self.cooked.iter());
+        if !pending.clone().any(|&b| b == vintr) {
+            return;
+        }
+        let mut rest: Vec<u8> = pending.copied().collect();
+        let pos = rest.iter().rposition(|&b| b == vintr).expect("found above");
+        rest.drain(..=pos);
+        self.mosi.clear();
+        self.cooked.clear();
+
+        if let Some(fd) = &self.pgrp_handle {
+            let _ = Pty::kill(fd, ProcKillTarget::ThisGroup, libredox::flag::SIGINT as usize);
+        } else if self.pgrp != 0 {
+            let _ = libredox::call::kill(-(self.pgrp as isize) as usize, libredox::flag::SIGINT as _);
+        }
+
+        // What came after the interrupt is input under the new settings.
+        self.input(&rest);
+    }
