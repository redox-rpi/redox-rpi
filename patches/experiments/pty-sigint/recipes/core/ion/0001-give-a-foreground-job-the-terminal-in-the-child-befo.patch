From e5d8894efdac0f2b03a2b254f13a87e8a778fbd5 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Thu, 29 Oct 2026 15:35:08 +0000
Subject: [PATCH] Give a foreground job the terminal in the child before exec

spawn() returns only after the exec, and the shell calls tcsetpgrp only
then. On Redox an exec can take a second or more, and a Ctrl-C typed in
that time reaches the shell, which ignores it, instead of the new job.
The child now calls tcsetpgrp itself right after setpgid, like bash, while
SIGTTOU is still blocked; the parent keeps its call.
---
 src/lib/shell/pipe_exec/mod.rs | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/lib/shell/pipe_exec/mod.rs b/src/lib/shell/pipe_exec/mod.rs
index eb03ff2..64c3d64 100644
--- a/src/lib/shell/pipe_exec/mod.rs
+++ b/src/lib/shell/pipe_exec/mod.rs
@@ -517,10 +517,19 @@ fn spawn_proc(
             command.stderr(stderr.map_or_else(Stdio::inherit, Into::into));
 
             let grp = *group;
+            let grab_tty = shell.opts().grab_tty;
             unsafe {
                 command.pre_exec(move || {
+                    let pgid = grp.unwrap_or_else(Pid::this);
+                    let _ = unistd::setpgid(Pid::this(), pgid);
+                    // Take the terminal here too, not only in the parent after
+                    // spawn() returns: spawn() waits for the exec, and a
+                    // Ctrl-C typed in the meantime would go to the shell.
+                    // SIGTTOU is still blocked at this point.
+                    if grab_tty {
+                        let _ = unistd::tcsetpgrp(nix::libc::STDIN_FILENO, pgid);
+                    }
                     signals::unblock();
-                    let _ = unistd::setpgid(Pid::this(), grp.unwrap_or_else(Pid::this));
                     Ok(())
                 })
             };
