+        // A Ctrl-C between the end of the line and the job taking the
+        // terminal reaches the shell instead of the job. It was meant for
+        // the job: pass it on, or the job runs to its end and the shell
+        // reports the signal as its own afterwards.
+        if signals::PENDING.load(Ordering::SeqCst) as u8 == signals::SIGINT {
+            signals::PENDING.store(0, Ordering::SeqCst);
+            let _ = signal::killpg(group, Signal::SIGINT);
+        }
+
         loop {
             match wait::waitpid(Pid::from_raw(-group.as_raw()), Some(WaitPidFlag::WUNTRACED)) {
