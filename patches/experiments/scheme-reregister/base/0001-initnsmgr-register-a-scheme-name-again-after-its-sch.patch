From edc991799636f5846774c4fd5834b02dc6a81b49 Mon Sep 17 00:00:00 2001
From: zehrer-xyz <stephan@zehrer.net>
Date: Sat, 31 Oct 2026 07:58:02 +0000
Subject: [PATCH] initnsmgr: register a scheme name again after its scheme
 ended

When a scheme daemon ends, its name stays in the namespace: nothing
tells the namespace manager, and it keeps its capability for the dead
scheme, which the kernel answers with ENODEV. Registering the name again
failed with EEXIST, so a restarted driver, or a USB device that came
back, could not get its old name.

On a name that is taken, check the old capability with the fcntl
syscall, F_GETFD. The kernel looks up the scheme for it without sending
the scheme a request, and answers ENODEV if the scheme is gone; then the
new scheme takes the name. Both cases are logged.
---
 bootstrap/src/initnsmgr.rs | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/bootstrap/src/initnsmgr.rs b/bootstrap/src/initnsmgr.rs
index 707b896d..24abf60c 100644
--- a/bootstrap/src/initnsmgr.rs
+++ b/bootstrap/src/initnsmgr.rs
@@ -81,8 +81,21 @@ struct SchemeRegister {
 impl SchemeRegister {
     fn register(&self, fd: FdGuard) -> Result<()> {
         let mut ns = self.target_namespace.borrow_mut();
-        if ns.schemes.contains_key(&self.scheme_name) {
-            return Err(Error::new(EEXIST));
+        if let Some(old) = ns.schemes.get(&self.scheme_name) {
+            // A scheme whose process ended keeps its name: nothing tells the
+            // namespace manager. The kernel then answers calls through the old
+            // capability with ENODEV. For F_GETFD it looks the scheme up without
+            // sending it a request, so a live scheme is not asked anything. (The
+            // raw syscall: redox-rt answers F_GETFD from its own table.)
+            match syscall::fcntl(old.as_raw_fd(), syscall::F_GETFD, 0) {
+                Err(err) if err.errno == ENODEV => {
+                    log::warn!("nsmgr: scheme {} ended, registering it again", self.scheme_name);
+                }
+                res => {
+                    log::warn!("nsmgr: scheme {} is taken ({:?})", self.scheme_name, res);
+                    return Err(Error::new(EEXIST));
+                }
+            }
         }
         ns.schemes.insert(self.scheme_name.clone(), Arc::new(fd));
         Ok(())
-- 
2.53.0

