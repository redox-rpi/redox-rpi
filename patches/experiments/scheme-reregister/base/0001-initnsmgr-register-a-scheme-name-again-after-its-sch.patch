From 7d4e1b8838ffaa03ec6bbf834b852b1d2eb64a1d Mon Sep 17 00:00:00 2001
From: zehrer-xyz <stephan@zehrer.net>
Date: Sat, 31 Oct 2026 07:58:02 +0000
Subject: [PATCH] initnsmgr: register a scheme name again after its scheme
 ended

When a scheme daemon ends, its name stays in the namespace: nothing
tells the namespace manager, and it keeps its capability for the dead
scheme, which the kernel answers with ENODEV. Registering the name again
failed with EEXIST, so a restarted driver, or a USB device that came
back, could not get its old name.

On a name that is taken, check the old scheme with a dup of its
capability (what opening it does too). If the kernel answers ENODEV,
the scheme has ended and the new one takes the name.
---
 bootstrap/src/initnsmgr.rs | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/bootstrap/src/initnsmgr.rs b/bootstrap/src/initnsmgr.rs
index 707b896d..d2b43059 100644
--- a/bootstrap/src/initnsmgr.rs
+++ b/bootstrap/src/initnsmgr.rs
@@ -81,14 +81,25 @@ struct SchemeRegister {
 impl SchemeRegister {
     fn register(&self, fd: FdGuard) -> Result<()> {
         let mut ns = self.target_namespace.borrow_mut();
-        if ns.schemes.contains_key(&self.scheme_name) {
-            return Err(Error::new(EEXIST));
+        if let Some(old) = ns.schemes.get(&self.scheme_name) {
+            if !scheme_ended(old) {
+                return Err(Error::new(EEXIST));
+            }
+            // A driver that was restarted, or a device that came back.
+            log::info!("nsmgr: scheme {} ended, registering it again", self.scheme_name);
         }
         ns.schemes.insert(self.scheme_name.clone(), Arc::new(fd));
         Ok(())
     }
 }
 
+/// Whether the process that served a scheme has ended. The name stays in the
+/// namespace after that, because nothing tells the namespace manager; the
+/// kernel then answers every call to the scheme with ENODEV.
+fn scheme_ended(cap_fd: &FdGuard) -> bool {
+    matches!(cap_fd.dup(&[]), Err(err) if err.errno == ENODEV)
+}
+
 #[derive(Debug, Clone)]
 enum Handle {
     Access(NamespaceAccess),
-- 
2.53.0

