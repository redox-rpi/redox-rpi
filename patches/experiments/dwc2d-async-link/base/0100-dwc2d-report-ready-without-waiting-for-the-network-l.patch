From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Tue, 17 Nov 2026 06:02:45 +0000
Subject: [PATCH] dwc2d: report ready without waiting for the network link

On the Pi 3B+ dwc2d reported ready only after the LAN7800 link came up,
about 3 s of autonegotiation after the chip init (rof#44, pi-tests test
470), and init starts nothing else meanwhile. Now dwc2d reports ready as
soon as a network adapter is up. Until the adapter in use has its link,
frames the network stack sends wait in a queue (at most 32), and the link
is read every 100 ms; when it comes up the queue is sent, so the first
DHCP Discover leaves then instead of into a dead link. After 10 s without
a link the queue is dropped, as before ("no link yet").
---
 drivers/usb/dwc2d/src/main.rs | 106 ++++++++++++++++++++++++++++++----
 1 file changed, 94 insertions(+), 12 deletions(-)

diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index 402a7a3..2f58f99 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -11,6 +11,7 @@ use std::io::{Read, Write};
 use std::os::fd::AsRawFd;
 use std::os::unix::fs::OpenOptionsExt;
 use std::process;
+use std::collections::VecDeque;
 use std::time::{Duration, Instant};
 
 use fdt::Fdt;
@@ -108,6 +109,10 @@ struct UsbNet {
     /// The list changed or another adapter took over: the next
     /// [`UsbNet::apply_multicast`] programs the adapter in use.
     multicast_pending: bool,
+    /// After boot, until the adapter in use has its link: frames the network
+    /// stack sends meanwhile wait here instead of going into a dead link, so
+    /// the first DHCP Discover leaves when the link comes up (#47, rof#44).
+    held: Option<VecDeque<Vec<u8>>>,
 }
 
 impl UsbNet {
@@ -123,6 +128,32 @@ impl UsbNet {
         self.adapters.iter_mut().map(|(a, _)| a).find(|a| a.address() == address)
     }
 
+    /// Whether the adapter in use has its link.
+    fn active_link(&self) -> bool {
+        self.active
+            .and_then(|address| self.adapters.iter().find(|(a, _)| a.address() == address))
+            .is_some_and(|(_, link)| *link)
+    }
+
+    /// End the wait for the link after boot: send the held frames (`send`)
+    /// or drop them.
+    fn release_held(&mut self, send: bool) {
+        let Some(held) = self.held.take() else {
+            return;
+        };
+        let mut sent = 0;
+        if send {
+            if let Some(adapter) = self.active_adapter() {
+                for frame in &held {
+                    if adapter.net().write_packet(frame).is_ok() {
+                        sent += 1;
+                    }
+                }
+            }
+        }
+        println!("dwc2d: {} of {} held frame(s) sent", sent, held.len());
+    }
+
     /// Forget an adapter that was unplugged.
     fn remove(&mut self, address: u8) {
         if self.active == Some(address) {
@@ -226,6 +257,18 @@ impl NetworkAdapter for UsbNet {
     }
 
     fn write_packet(&mut self, buf: &[u8]) -> syscall::Result<usize> {
+        if self.held.is_some() {
+            if self.active_link() {
+                self.release_held(true);
+            } else {
+                let held = self.held.as_mut().unwrap();
+                if held.len() == HELD_MAX {
+                    held.pop_front();
+                }
+                held.push_back(buf.to_vec());
+                return Ok(buf.len());
+            }
+        }
         match self.active_adapter() {
             Some(a) => a.net().write_packet(buf),
             // No adapter: the frame is lost, like on a cable that is out.
@@ -450,6 +493,10 @@ const INPUT_LOG: &str = "/tmp/dwc2d-input-log";
 const BOOT_LINK_WAIT: Duration = Duration::from_secs(10);
 /// How long to look for devices at boot when there is no network adapter.
 const BOOT_CONNECT_WAIT: Duration = Duration::from_secs(1);
+/// How often the link is read after boot while frames wait for it.
+const LINK_WATCH: Duration = Duration::from_millis(100);
+/// Frames held for the link at most; the oldest go first.
+const HELD_MAX: usize = 32;
 
 user_data! {
     enum Source {
@@ -457,6 +504,7 @@ user_data! {
         Scheme,
         Time,
         Hotplug,
+        LinkWatch,
     }
 }
 
@@ -501,6 +549,7 @@ fn daemon(daemon: daemon::Daemon) -> ! {
         active: None,
         multicast: None,
         multicast_pending: false,
+        held: None,
     };
     let mut keyboard = None;
     let mut mouse = None;
@@ -533,29 +582,36 @@ fn daemon(daemon: daemon::Daemon) -> ! {
     };
     let addresses = bus.devices.iter().map(|d| d.address).collect();
     boot_probe(&mut bus, &mut net, &mut keyboard, &mut mouse, addresses);
-    // Wait for a network adapter's link, so DHCP does not start into a dead
-    // cable, or, without an adapter, a moment for devices that connect late
-    // after power-on. Rescans meanwhile take devices that connect now, so
-    // waiting for the link and for the hub ports overlaps (on the Pi 3B+,
-    // the LAN7800's autonegotiation takes 1.7 s).
+    // Report ready once a network adapter is up, without waiting for its
+    // link (on the Pi 3B+ the LAN7800's autonegotiation takes 2-3 s, and
+    // init starts nothing else meanwhile): frames wait for the link in
+    // `UsbNet::held` instead, so DHCP still does not start into a dead
+    // cable. Without an adapter, a moment for devices that connect late
+    // after power-on; rescans meanwhile take devices that connect now.
     let start = Instant::now();
     loop {
         net.refresh_links(&mut bus);
-        if net.adapters.iter().any(|(_, link)| *link) {
+        if !net.adapters.is_empty() {
             break;
         }
-        let wait = if net.adapters.is_empty() { BOOT_CONNECT_WAIT } else { BOOT_LINK_WAIT };
-        if start.elapsed() >= wait {
-            if !net.adapters.is_empty() {
-                println!("dwc2d: no link yet");
-            }
+        if start.elapsed() >= BOOT_CONNECT_WAIT {
             break;
         }
         dwc2::delay(Duration::from_millis(50));
         let changes = bus.scan();
         boot_probe(&mut bus, &mut net, &mut keyboard, &mut mouse, changes.added);
     }
-    println!("dwc2d: devices ready after {} ms", boot_start.elapsed().as_millis());
+    let link_deadline = if !net.adapters.is_empty() && !net.adapters.iter().any(|(_, link)| *link) {
+        net.held = Some(VecDeque::new());
+        Some(Instant::now() + BOOT_LINK_WAIT)
+    } else {
+        None
+    };
+    println!(
+        "dwc2d: devices ready after {} ms{}",
+        boot_start.elapsed().as_millis(),
+        if link_deadline.is_some() { ", link not up yet" } else { "" }
+    );
     // The network stack keeps the address of the adapter it starts with.
     if let Some((adapter, _)) = net.adapters.iter().min_by_key(|(a, link)| a.rank(*link)) {
         if let Some(&(_, mac)) = macs.iter().find(|(a, _)| *a == adapter.address()) {
@@ -612,6 +668,13 @@ fn daemon(daemon: daemon::Daemon) -> ! {
         .subscribe(hotplug.0.as_raw_fd() as usize, Source::Hotplug, event::EventFlags::READ)
         .expect("dwc2d: failed to subscribe to the timer");
     hotplug.arm(HOTPLUG_INTERVAL);
+    let mut link_watch = Timer::new().expect("dwc2d: failed to open /scheme/time");
+    events
+        .subscribe(link_watch.0.as_raw_fd() as usize, Source::LinkWatch, event::EventFlags::READ)
+        .expect("dwc2d: failed to subscribe to the timer");
+    if link_deadline.is_some() {
+        link_watch.arm(LINK_WATCH);
+    }
     aside::spawn_files();
 
     let mut scheme = NetworkScheme::new(move || net, daemon, name.to_string());
@@ -656,6 +719,22 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                     timer.arm(next);
                 }
             }
+            Source::LinkWatch => {
+                link_watch.fired();
+                let net = scheme.adapter_mut();
+                net.refresh_links(&mut bus);
+                net.select(&mut bus);
+                if net.active_link() {
+                    net.release_held(true);
+                } else if link_deadline.is_some_and(|d| Instant::now() >= d) {
+                    println!("dwc2d: no link yet");
+                    net.release_held(false);
+                }
+                if net.held.is_some() {
+                    link_watch.arm(LINK_WATCH);
+                }
+                scheme.tick().expect("dwc2d: network scheme failed");
+            }
             Source::Hotplug => {
                 hotplug.fired();
                 let mut cycled = Vec::new();
@@ -725,6 +804,9 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                 }
                 net.refresh_links(&mut bus);
                 net.select(&mut bus);
+                if net.active_link() {
+                    net.release_held(true);
+                }
                 scheme.tick().expect("dwc2d: network scheme failed");
                 hotplug.arm(HOTPLUG_INTERVAL);
             }
-- 
2.53.0

