From c7cb7ad74ef05dcb2dd54e6d936e075c84a14ff6 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 30 Oct 2026 08:31:12 +0000
Subject: [PATCH] futex: compare and queue up under the FUTEX_WAKE lock, no
 lost wakeups

FUTEX_WAIT compared the word, blocked the context and only then queued
it in FUTEXES. A FUTEX_WAKE on another CPU between the comparison and
the queueing found no waiter and returned 0, and the waiter slept
although the word had changed. Compare again while holding the FUTEXES
lock and block and queue up under it, as Linux does under its hash
bucket lock. The first comparison stays as the fast path.
---
 src/syscall/futex.rs | 48 +++++++++++++++++++++++++++++---------------
 1 file changed, 32 insertions(+), 16 deletions(-)

diff --git a/src/syscall/futex.rs b/src/syscall/futex.rs
index 3389d3a0..36e9e968 100644
--- a/src/syscall/futex.rs
+++ b/src/syscall/futex.rs
@@ -118,7 +118,8 @@ pub fn futex(
             {
                 let context_lock = context::current();
 
-                let (fetched, expected) = if op == FUTEX_WAIT {
+                // The word's kernel address, and whether it is 64 bits wide.
+                let (accessible_addr, wide, expected) = if op == FUTEX_WAIT {
                     // Must be aligned, otherwise it could cross a page boundary and mess up the
                     // (simpler) validation we did in the first place.
                     if !addr.is_multiple_of(4) {
@@ -129,12 +130,7 @@ pub fn futex(
                     // add an atomic usercopy function.
                     let accessible_addr = crate::memory::RmmA::phys_to_virt(target_physaddr).data();
 
-                    (
-                        u64::from(unsafe {
-                            (*(accessible_addr as *const AtomicU32)).load(Ordering::SeqCst)
-                        }),
-                        u64::from(val as u32),
-                    )
+                    (accessible_addr, false, u64::from(val as u32))
                 } else {
                     #[cfg(target_has_atomic = "64")]
                     {
@@ -150,24 +146,45 @@ pub fn futex(
                         let accessible_addr =
                             crate::memory::RmmA::phys_to_virt(target_physaddr).data();
 
-                        (
-                            unsafe {
-                                (*(accessible_addr as *const AtomicU64)).load(Ordering::SeqCst)
-                            },
-                            val as u64,
-                        )
+                        (accessible_addr, true, val as u64)
                     }
                     #[cfg(not(target_has_atomic = "64"))]
                     {
                         return Err(Error::new(crate::syscall::error::EOPNOTSUPP));
                     }
                 };
-                if fetched != expected {
+                let fetch = || -> u64 {
+                    if wide {
+                        #[cfg(target_has_atomic = "64")]
+                        {
+                            use core::sync::atomic::AtomicU64;
+                            return unsafe {
+                                (*(accessible_addr as *const AtomicU64)).load(Ordering::SeqCst)
+                            };
+                        }
+                    }
+                    u64::from(unsafe {
+                        (*(accessible_addr as *const AtomicU32)).load(Ordering::SeqCst)
+                    })
+                };
+                if fetch() != expected {
                     return Err(Error::new(EAGAIN));
                 }
 
                 drop(addr_space_guard);
 
+                // Compare again, block and queue up under the lock FUTEX_WAKE
+                // takes. Otherwise a waker that changes the word and calls
+                // FUTEX_WAKE between the comparison above and the queueing
+                // finds no waiter, and this context sleeps although the word
+                // changed: a lost wakeup (seen with several CPUs).
+                let mut futexes_lock = FUTEXES.lock(token.token());
+                let (futexes_map, mut token) = futexes_lock.token_split();
+
+                if fetch() != expected {
+                    return Err(Error::new(EAGAIN));
+                }
+
                 {
                     let mut context = context_lock.write(token.token());
 
@@ -181,8 +198,7 @@ pub fn futex(
                     context.block("futex");
                 }
 
-                let mut futexes = FUTEXES.lock(token.token());
-                futexes
+                futexes_map
                     .entry(target_physaddr)
                     .or_insert_with(Vec::new)
                     .push(FutexEntry {
