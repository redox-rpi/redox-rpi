index 00000000..aaef7a6a
--- /dev/null
+++ b/randd/src/bcm2835_rng.rs
@@ -0,0 +1,92 @@
+//! Seed from the BCM2835 hardware random number generator (`brcm,bcm2835-rng`),
+//! found in the Raspberry Pi 1 to 3 and the Zero 2 W. Their Cortex-A53 has no
+//! RNDR register.
+//!
+//! Registers as in Linux `drivers/char/hw_random/bcm2835-rng.c`.
+
+use std::time::{Duration, Instant};
+
+use fdt::Fdt;
+
+const RNG_CTRL: usize = 0x0;
+const RNG_STATUS: usize = 0x4;
+const RNG_DATA: usize = 0x8;
+const RNG_INT_MASK: usize = 0x10;
+
+const RNG_RBGEN: u32 = 0x1;
+const RNG_INT_OFF: u32 = 0x1;
+/// The generator throws away this many bits before the first word.
+const RNG_WARMUP_COUNT: u32 = 0x40000;
+
+const PAGE_SIZE: usize = 4096;
+
+/// The CPU physical address of the RNG block, from the devicetree.
+fn rng_phys(fdt: &Fdt) -> Option<usize> {
+    let bus_addr = fdt
+        .find_compatible(&["brcm,bcm2835-rng"])?
+        .reg()?
+        .next()?
+        .starting_address as usize;
+    Some(
+        fdt.find_node("/soc")
+            .and_then(|soc| soc.ranges())
+            .and_then(|mut ranges| {
+                ranges.find(|r| {
+                    r.child_bus_address <= bus_addr && bus_addr - r.child_bus_address < r.size
+                })
+            })
+            .map(|r| r.parent_bus_address + (bus_addr - r.child_bus_address))
+            .unwrap_or(bus_addr),
+    )
+}
+
+/// Fill `seed` from the hardware RNG. False if there is none or it gives no
+/// data within a second.
+pub fn fill(seed: &mut [u8]) -> bool {
+    let Ok(dtb) = std::fs::read("/scheme/kernel.dtb") else {
+        return false;
+    };
+    let Ok(fdt) = Fdt::new(&dtb) else {
+        return false;
+    };
+    let Some(phys) = rng_phys(&fdt) else {
+        return false;
+    };
+    common::init();
+    let page = phys & !(PAGE_SIZE - 1);
+    let base = match unsafe {
+        common::physmap(page, PAGE_SIZE, common::Prot::RW, common::MemoryType::DeviceMemory)
+    } {
+        Ok(virt) => virt as usize + (phys - page),
+        Err(err) => {
+            println!("randd: cannot map the BCM2835 RNG at {phys:#x}: {err}");
+            return false;
+        }
+    };
+    let reg = |off: usize| (base + off) as *mut u32;
+    unsafe {
+        // Mask its interrupt; randd polls.
+        let mask = reg(RNG_INT_MASK).read_volatile();
+        reg(RNG_INT_MASK).write_volatile(mask | RNG_INT_OFF);
+        // Start it unless the firmware already did.
+        if reg(RNG_CTRL).read_volatile() & RNG_RBGEN == 0 {
+            reg(RNG_STATUS).write_volatile(RNG_WARMUP_COUNT);
+            reg(RNG_CTRL).write_volatile(RNG_RBGEN);
+        }
+    }
+    let deadline = Instant::now() + Duration::from_secs(1);
+    for chunk in seed.chunks_mut(4) {
+        // The top byte of STATUS counts the words ready in the FIFO.
+        while unsafe { reg(RNG_STATUS).read_volatile() } >> 24 == 0 {
+            if Instant::now() > deadline {
+                println!("randd: the BCM2835 RNG at {phys:#x} gives no data");
+                return false;
+            }
+            std::thread::sleep(Duration::from_micros(100));
+        }
+        let word = unsafe { reg(RNG_DATA).read_volatile() }.to_le_bytes();
+        chunk.copy_from_slice(&word[..chunk.len()]);
+    }
+    // The mapping stays: randd runs for the whole uptime and maps it once.
+    true
+}
diff --git a/randd/src/main.rs b/randd/src/main.rs
index e286525c..6ca3fce1 100644
--- a/randd/src/main.rs
+++ b/randd/src/main.rs
@@ -1,5 +1,8 @@
 use std::arch::asm;
 
+#[cfg(target_arch = "aarch64")]
+mod bcm2835_rng;
+
 use rand_chacha::ChaCha20Rng;
 use rand_core::RngCore;
 #[cfg(target_arch = "x86_64")]
@@ -27,7 +30,8 @@ const SEED_BYTES: usize = 32;
 
 /// Create a true random seed for the RNG if hardware support is present.
 /// On Intel x64 from rdrand instruction.
-/// On AArch64 from RNDRRS system register.
+/// On AArch64 from RNDRRS system register, or else the BCM2835 hardware RNG
+/// (Raspberry Pi 1 to 3, Zero 2 W).
 /// Will seed with a zero (insecure) if getting support is not present.
 fn create_rdrand_seed() -> [u8; SEED_BYTES] {
     let mut rng = [0; SEED_BYTES];
@@ -73,6 +77,9 @@ fn create_rdrand_seed() -> [u8; SEED_BYTES] {
             }
             have_seeded = !failure;
         }
+        if !have_seeded {
+            have_seeded = bcm2835_rng::fill(&mut rng);
+        }
     } // TODO integrate alternative entropy sources
     if !have_seeded {
         println!("randd: Seeding failed, no entropy source.  Random numbers on this platform are NOT SECURE");
