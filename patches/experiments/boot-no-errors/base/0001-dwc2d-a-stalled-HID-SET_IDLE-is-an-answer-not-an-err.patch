From 01d61d983f1fef2a2da6a730ee35b40fa4462da4 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Wed, 18 Nov 2026 18:50:02 +0000
Subject: [PATCH 1/2] dwc2d: a stalled HID SET_IDLE is an answer, not an error
 (redox-rpi #556)

Keyboards and mice that do not support idle rates stall SET_IDLE, which
the HID spec allows; the callers already ignore the result. dwc2d still
retried it twice and printed "failed: Stall" on every boot with such a
device. Return the stall at once and print nothing.
---
 drivers/usb/dwc2d/src/enumerate.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/usb/dwc2d/src/enumerate.rs b/drivers/usb/dwc2d/src/enumerate.rs
index 5574e170..ce6f5004 100644
--- a/drivers/usb/dwc2d/src/enumerate.rs
+++ b/drivers/usb/dwc2d/src/enumerate.rs
@@ -142,6 +142,12 @@ impl Bus {
                 &mut self.data,
             ) {
                 Ok(len) => return Ok(self.data[..len].to_vec()),
+                // HID SET_IDLE (class request 0x0A to an interface): the HID
+                // spec lets a device stall it when it does not support idle
+                // rates. That is its answer, not an error: no retry, no line.
+                Err(Error::Stall) if request_type == 0x21 && request == 0x0A => {
+                    return Err(Error::Stall);
+                }
                 Err(Error::Stall) if attempt < ATTEMPTS => {
                     attempt += 1;
                     delay(Duration::from_millis(10));
-- 
