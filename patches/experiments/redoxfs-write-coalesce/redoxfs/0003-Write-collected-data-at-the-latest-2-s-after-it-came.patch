From d9400595a333a9393bfff142133ed6ea2b5e7cff Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Thu, 29 Oct 2026 17:12:25 +0000
Subject: [PATCH] Write collected data at the latest 2 s after it came in
 (redox-rpi #16)

A program that writes a little and keeps the file open would otherwise
leave the data in memory until its next request. The scheme socket is
now non-blocking; with no request waiting, redoxfs sleeps on an event
queue with the socket and a monotonic timer set to when the collected
data is due.
---
 src/mount/redox/mod.rs    | 117 +++++++++++++++++++++++++++++++++++---
 src/mount/redox/scheme.rs |  16 +++++-
 2 files changed, 125 insertions(+), 8 deletions(-)

diff --git a/src/mount/redox/mod.rs b/src/mount/redox/mod.rs
index 70156b0..1efff34 100644
--- a/src/mount/redox/mod.rs
+++ b/src/mount/redox/mod.rs
@@ -2,9 +2,16 @@ use redox_scheme::{
     scheme::{Op, SchemeState, SchemeSync},
     RequestKind, Response, SignalBehavior, Socket,
 };
-use std::io;
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::os::fd::AsRawFd;
 use std::path::Path;
 use std::sync::atomic::Ordering;
+use std::time::{Duration, Instant};
+
+use syscall::data::{Event, TimeSpec};
+use syscall::error::EWOULDBLOCK;
+use syscall::flag::EventFlags;
 
 use crate::{Disk, FileSystem, IS_UMT};
 
@@ -13,6 +20,64 @@ use self::scheme::FileScheme;
 pub mod resource;
 pub mod scheme;
 
+/// Collected writes go to the disk at the latest this long after they came
+/// in, also when the program writes nothing more and keeps the file open.
+const FLUSH_AFTER: Duration = Duration::from_secs(2);
+
+/// Sleeping until the next request or until collected writes are due.
+struct Wakeup {
+    queue: File,
+    timer: File,
+    /// When the timer was last set to fire.
+    armed: Option<Instant>,
+}
+
+impl Wakeup {
+    fn open() -> io::Result<Self> {
+        let queue = OpenOptions::new().read(true).write(true).open("/scheme/event")?;
+        let timer = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(format!("/scheme/time/{}", syscall::CLOCK_MONOTONIC))?;
+        let mut wakeup = Self { queue, timer, armed: None };
+        wakeup.watch(wakeup.timer.as_raw_fd() as usize)?;
+        Ok(wakeup)
+    }
+
+    fn watch(&mut self, fd: usize) -> io::Result<()> {
+        let event = Event { id: fd, flags: EventFlags::EVENT_READ, data: 0 };
+        self.queue.write(&event)?;
+        Ok(())
+    }
+
+    /// Let the timer fire at `at`, once.
+    fn arm(&mut self, at: Instant) {
+        if self.armed == Some(at) {
+            return;
+        }
+        let after = at.saturating_duration_since(Instant::now());
+        let mut time = TimeSpec::default();
+        if self.timer.read(&mut time).is_err() {
+            return;
+        }
+        let nsec = time.tv_nsec as u64 + u64::from(after.subsec_nanos());
+        time.tv_sec += after.as_secs() as i64 + (nsec / 1_000_000_000) as i64;
+        time.tv_nsec = (nsec % 1_000_000_000) as i32;
+        if self.timer.write(&time).is_ok() {
+            self.armed = Some(at);
+        }
+    }
+
+    /// Sleep until a request comes, the timer fires or a signal arrives.
+    fn wait(&mut self) -> io::Result<()> {
+        let mut event = Event::default();
+        match self.queue.read(&mut event) {
+            Err(err) if err.kind() != io::ErrorKind::Interrupted => Err(err),
+            _ => Ok(()),
+        }
+    }
+}
+
 //FIXME: mut callback is not mut
 #[allow(unused_mut)]
 
@@ -23,6 +88,14 @@ where
     F: FnOnce(&Path) -> T,
 {
     let mountpoint = mountpoint.as_ref();
+    // Without the timer, collected writes wait for the next request.
+    let mut wakeup = match Wakeup::open() {
+        Ok(wakeup) => Some(wakeup),
+        Err(err) => {
+            log::warn!("no timer for collected writes: {}", err);
+            None
+        }
+    };
     let socket = Socket::create()?;
 
     let scheme_name = format!("{}", mountpoint.display());
@@ -37,10 +110,36 @@ where
         &mut scheme,
     )?;
 
+    // Registering needs a blocking socket; only then may it stop blocking.
+    if let Some(wakeup) = wakeup.as_mut() {
+        let fd = socket.inner().raw();
+        let flags = libredox::call::fcntl(fd, syscall::F_GETFL, 0)?;
+        libredox::call::fcntl(fd, syscall::F_SETFL, flags | syscall::O_NONBLOCK)?;
+        wakeup.watch(fd)?;
+    }
+
     let res = callback(Path::new(&mounted_path));
 
     while IS_UMT.load(Ordering::SeqCst) == 0 {
-        let req = match socket.next_request(SignalBehavior::Restart)? {
+        let next = match socket.next_request(SignalBehavior::Restart) {
+            Err(err) if err.errno == EWOULDBLOCK => {
+                let Some(wakeup) = wakeup.as_mut() else {
+                    return Err(err.into());
+                };
+                if let Some(since) = scheme.pending_since() {
+                    let due = since + FLUSH_AFTER;
+                    if Instant::now() >= due {
+                        scheme.flush_pending();
+                        continue;
+                    }
+                    wakeup.arm(due);
+                }
+                wakeup.wait()?;
+                continue;
+            }
+            next => next?,
+        };
+        let req = match next {
             None => break,
             Some(req) => {
                 match req.kind() {
@@ -82,11 +181,15 @@ where
         let caller = req.caller();
         let response = match req.op() {
             Ok(op) => {
-                let flush = match &op {
-                    Op::Write(_) => false,
-                    Op::Read(read) => scheme.read_needs_flush(read.fd),
-                    _ => true,
-                };
+                let due = scheme
+                    .pending_since()
+                    .is_some_and(|since| since.elapsed() >= FLUSH_AFTER);
+                let flush = due
+                    || match &op {
+                        Op::Write(_) => false,
+                        Op::Read(read) => scheme.read_needs_flush(read.fd),
+                        _ => true,
+                    };
                 if flush {
                     scheme.flush_pending();
                 }
