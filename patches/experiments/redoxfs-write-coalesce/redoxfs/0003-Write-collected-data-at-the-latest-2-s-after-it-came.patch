+use std::time::{Instant, SystemTime, UNIX_EPOCH};
 
 use alloc::borrow::Cow;
 use libredox::Fd;
@@ -98,6 +98,8 @@ struct PendingWrite {
     offset: u64,
     /// Data from `offset - data.len()` on, not yet written.
     data: Vec<u8>,
+    /// When the first byte of `data` came in.
+    since: Instant,
 }
 
 pub struct FileScheme<'sock, D: Disk> {
@@ -175,6 +177,14 @@ impl<'sock, D: Disk> FileScheme<'sock, D> {
         }
     }
 
+    /// When the oldest collected data not yet written came in.
+    pub fn pending_since(&self) -> Option<Instant> {
+        self.pending
+            .as_ref()
+            .filter(|pending| !pending.data.is_empty())
+            .map(|pending| pending.since)
+    }
+
     /// Whether a read of handle `id` has to wait for the collected data:
     /// only a read of the same file does. Copying a file reads the source
     /// between the writes to the copy, and those reads must not cut the
@@ -1027,6 +1037,9 @@ impl<'sock, D: Disk> SchemeSync for FileScheme<'sock, D> {
         let small = (buf.len() as u64) < RECORD_SIZE;
         if let Some(pending) = self.pending.as_mut() {
             if small && pending.id == id && pending.offset == offset {
+                if pending.data.is_empty() {
+                    pending.since = Instant::now();
+                }
                 pending.data.extend_from_slice(buf);
                 pending.offset += buf.len() as u64;
                 // Write when a record is complete or enough has come together.
@@ -1049,6 +1062,7 @@ impl<'sock, D: Disk> SchemeSync for FileScheme<'sock, D> {
                 id,
                 offset: offset + written as u64,
                 data: Vec::new(),
+                since: Instant::now(),
             });
         }
         Ok(written)
