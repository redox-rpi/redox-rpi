+    fn read_ready(&mut self, data: &Self::DataT) -> bool {
+        if data.is_some() {
+            // A listening socket: an accept would not block once a connection
+            // has come in. In the Listen state may_recv() is false, which the
+            // default took for end of stream, so poll() always said readable.
+            self.is_active()
+        } else {
+            smoltcp::socket::tcp::Socket::can_recv(self) || !self.may_recv()
+        }
+    }
