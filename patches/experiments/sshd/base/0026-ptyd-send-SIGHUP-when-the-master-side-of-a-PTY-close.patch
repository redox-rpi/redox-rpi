@@ -342,6 +346,25 @@ impl Pty {
         }
     }
 
+    /// The master side went away (for example an SSH connection dropped):
+    /// send SIGHUP and SIGCONT to the processes on this terminal, like Unix.
+    /// Without it the shell keeps going, gets EOF and EPIPE and panics.
+    pub fn hangup(&self) {
+        eprintln!("ptyd: pty {} hangup, SIGHUP to groups {:?}", self.id, self.seen_pgrps);
+        for &pgrp in &self.seen_pgrps {
+            for sig in [libredox::flag::SIGHUP, libredox::flag::SIGCONT] {
+                let _ = libredox::call::kill(-(pgrp as isize) as usize, sig as _);
+            }
+        }
+    }
+
+    pub fn note_pgrp(&mut self, pgrp: usize) {
+        self.pgrp = pgrp;
+        if pgrp != 0 && !self.seen_pgrps.contains(&pgrp) {
+            self.seen_pgrps.push(pgrp);
+        }
+    }
+
