From 9f56780ec02b8e033264cf6f406f8ab61d6904eb Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Tue, 27 Oct 2026 09:08:22 +0100
Subject: [PATCH] dwc2d: RTL8152 and RTL8153 Ethernet (Pi Zero HATs, USB
 adapters and hubs)

Polled driver for the Realtek RTL8152 (0bda:8152, chip versions 4C00
and 4C10) and RTL8153 (0bda:8153, 5C00-5C30 and RTL8153B 6000/6010),
written with FreeBSD's if_ure (BSD-2-Clause) as reference for the
register map and initialization order. Exposed as network.usb_rtl8152.
A plugged-in RTL815x wins over the onboard LAN7800, so it can be tested
on a Pi 3B+.
---
 drivers/usb/dwc2d/src/main.rs    |   25 +-
 drivers/usb/dwc2d/src/rtl8152.rs | 1030 ++++++++++++++++++++++++++++++
 2 files changed, 1054 insertions(+), 1 deletion(-)
 create mode 100644 drivers/usb/dwc2d/src/rtl8152.rs

diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index 4baf0c0..0b0dd57 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -2,7 +2,7 @@
 //! mode, as found on the Raspberry Pi 1-3 and Zero.
 //!
 //! Brings up the controller, enumerates the devices behind the root port and
-//! hubs, and runs network adapters (CDC Ethernet, LAN7800) and a boot
+//! hubs, and runs network adapters (CDC Ethernet, LAN7800, RTL8152/8153) and a boot
 //! protocol keyboard directly in this process. It does not offer the USB
 //! scheme to class drivers yet.
 
@@ -16,6 +16,7 @@ mod enumerate;
 mod hid;
 mod lan78xx;
 mod regs;
+mod rtl8152;
 
 use driver_network::{NetworkAdapter, NetworkScheme};
 use dwc2::Dwc2;
@@ -23,17 +24,20 @@ use ecm::{Ecm, EcmFunction};
 use enumerate::Bus;
 use hid::Keyboard;
 use lan78xx::{Lan78xx, Lan78xxFunction};
+use rtl8152::{Rtl8152, Rtl8152Function};
 
 /// A network function found during enumeration, already initialized.
 enum NetFunction {
     Ecm(EcmFunction),
     Lan78xx(Lan78xxFunction),
+    Rtl8152(Rtl8152Function),
 }
 
 /// The network adapter running on top of the controller.
 enum UsbNet {
     Ecm(Ecm),
     Lan78xx(Lan78xx),
+    Rtl8152(Rtl8152),
 }
 
 impl NetworkAdapter for UsbNet {
@@ -41,6 +45,7 @@ impl NetworkAdapter for UsbNet {
         match self {
             Self::Ecm(a) => a.mac_address(),
             Self::Lan78xx(a) => a.mac_address(),
+            Self::Rtl8152(a) => a.mac_address(),
         }
     }
 
@@ -48,6 +53,7 @@ impl NetworkAdapter for UsbNet {
         match self {
             Self::Ecm(a) => a.available_for_read(),
             Self::Lan78xx(a) => a.available_for_read(),
+            Self::Rtl8152(a) => a.available_for_read(),
         }
     }
 
@@ -55,6 +61,7 @@ impl NetworkAdapter for UsbNet {
         match self {
             Self::Ecm(a) => a.read_packet(buf),
             Self::Lan78xx(a) => a.read_packet(buf),
+            Self::Rtl8152(a) => a.read_packet(buf),
         }
     }
 
@@ -62,6 +69,7 @@ impl NetworkAdapter for UsbNet {
         match self {
             Self::Ecm(a) => a.write_packet(buf),
             Self::Lan78xx(a) => a.write_packet(buf),
+            Self::Rtl8152(a) => a.write_packet(buf),
         }
     }
 }
@@ -174,11 +182,13 @@ fn daemon(daemon: daemon::Daemon) -> ! {
     let name = match function {
         NetFunction::Ecm(_) => "network.usb_ecm",
         NetFunction::Lan78xx(_) => "network.usb_lan78xx",
+        NetFunction::Rtl8152(_) => "network.usb_rtl8152",
     };
     let mut scheme = NetworkScheme::new(
         move || match function {
             NetFunction::Ecm(f) => UsbNet::Ecm(Ecm::new(hc, f, mac)),
             NetFunction::Lan78xx(f) => UsbNet::Lan78xx(Lan78xx::new(hc, f, mac)),
+            NetFunction::Rtl8152(f) => UsbNet::Rtl8152(Rtl8152::new(hc, f, mac)),
         },
         daemon,
         name.to_string(),
@@ -221,6 +231,19 @@ fn enumerate(
                 let mut network = None;
                 let mut keyboard = None;
                 for device in bus.devices.clone() {
+                    // A plugged-in RTL8152 or RTL8153 wins over the onboard LAN7800.
+                    if !matches!(network, Some((NetFunction::Rtl8152(_), _))) {
+                        if let Some(function) = rtl8152::find(&mut bus, &device) {
+                            println!("dwc2d: RTL815x at address {}", device.address);
+                            match rtl8152::init(&mut bus, &function) {
