+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Chip {
+    Rtl8152,
+    Rtl8153,
+    Rtl8153B,
+}
+
+impl Chip {
+    fn from_version(version: u32) -> Option<Self> {
+        match version {
+            VERSION_4C00 | VERSION_4C10 => Some(Self::Rtl8152),
+            VERSION_5C00 | VERSION_5C10 | VERSION_5C20 | VERSION_5C30 => Some(Self::Rtl8153),
+            VERSION_6000 | VERSION_6010 => Some(Self::Rtl8153B),
+            _ => None,
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Self::Rtl8152 => "RTL8152",
+            Self::Rtl8153 => "RTL8153",
+            Self::Rtl8153B => "RTL8153B",
+        }
+    }
+}
+
+pub struct Rtl8152Function {
+    pub address: u8,
+    pub speed: Speed,
+    max_packet0: u16,
+    configuration: u8,
+    ep_in: u8,
+    ep_out: u8,
+    max_packet_in: u16,
+    max_packet_out: u16,
+}
+
+/// Recognize an RTL8152 or RTL8153 and find the bulk endpoints of its first
+/// configuration (the vendor one; the second is CDC ECM).
+pub fn find(bus: &mut Bus, device: &Device) -> Option<Rtl8152Function> {
+    if device.vendor != VENDOR_REALTEK || !matches!(device.product, PRODUCT_RTL8152 | PRODUCT_RTL8153) {
+        return None;
+    }
+    // Bulk transfers through a transaction translator are not supported.
+    if device.tt.is_some() {
+        println!("dwc2d: RTL815x at address {} is not high speed, skipped", device.address);
+        return None;
+    }
+    let config = bus
+        .request(device.address, device.max_packet, device.speed, 0x80, REQ_GET_DESCRIPTOR, 0x0200, 0, 512)
+        .ok()?;
+    let mut function = Rtl8152Function {
+        address: device.address,
+        speed: device.speed,
+        max_packet0: device.max_packet,
+        configuration: *config.get(5)?,
+        ep_in: 0,
+        ep_out: 0,
+        max_packet_in: 0,
+        max_packet_out: 0,
+    };
+    let mut pos = 0;
+    while pos + 2 <= config.len() && config[pos] >= 2 {
+        let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+        if desc[1] == 5 && desc.len() >= 7 && desc[3] & 3 == 2 {
+            let max_packet = u16::from_le_bytes([desc[4], desc[5]]) & 0x7FF;
+            if desc[2] & 0x80 != 0 {
+                function.ep_in = desc[2] & 0xF;
+                function.max_packet_in = max_packet;
+            } else {
+                function.ep_out = desc[2] & 0xF;
+                function.max_packet_out = max_packet;
+            }
+        }
+        pos += desc.len();
+    }
+    (function.ep_in != 0 && function.ep_out != 0).then_some(function)
+}
+
+/// Register access. The chip reads and writes whole aligned dwords; byte
+/// enables in wIndex select the bytes a write changes.
+struct Regs<'a, 'b> {
+    bus: &'a mut Bus<'b>,
+    f: &'a Rtl8152Function,
+}
+
+impl Regs<'_, '_> {
+    fn read_mem(&mut self, reg: u16, index: u16, len: u16) -> Result<Vec<u8>, Error> {
+        let data = self.bus.request(self.f.address, self.f.max_packet0, self.f.speed, 0xC0, REQ_REGISTER, reg, index, len)?;
+        if data.len() < usize::from(len) {
+            return Err(Error::Timeout("short register read"));
+        }
+        Ok(data)
+    }
+
+    fn write_mem(&mut self, reg: u16, index: u16, data: &[u8]) -> Result<(), Error> {
+        self.bus.request_out(self.f.address, self.f.max_packet0, self.f.speed, 0x40, REQ_REGISTER, reg, index, data)
+    }
+
+    fn read4(&mut self, reg: u16, space: u16) -> Result<u32, Error> {
+        let d = self.read_mem(reg & !3, space, 4)?;
+        Ok(u32::from_le_bytes([d[0], d[1], d[2], d[3]]))
+    }
+
+    fn read2(&mut self, reg: u16, space: u16) -> Result<u32, Error> {
+        Ok(self.read4(reg, space)? >> ((reg & 2) * 8) & 0xFFFF)
+    }
+
+    fn read1(&mut self, reg: u16, space: u16) -> Result<u32, Error> {
+        Ok(self.read4(reg, space)? >> ((reg & 3) * 8) & 0xFF)
+    }
+
+    /// Write `value` into the bytes `enable` selects, shifted to `reg`'s
+    /// place in its dword.
+    fn write_part(&mut self, reg: u16, space: u16, enable: u16, shift: u16, value: u32) -> Result<(), Error> {
+        let value = value << (shift * 8);
+        self.write_mem(reg & !3, space | (enable << shift), &value.to_le_bytes())
+    }
+
+    fn write4(&mut self, reg: u16, space: u16, value: u32) -> Result<(), Error> {
+        self.write_mem(reg, space | BYTE_EN_DWORD, &value.to_le_bytes())
+    }
+
+    fn write2(&mut self, reg: u16, space: u16, value: u32) -> Result<(), Error> {
+        self.write_part(reg, space, BYTE_EN_WORD, reg & 2, value & 0xFFFF)
+    }
+
+    fn write1(&mut self, reg: u16, space: u16, value: u32) -> Result<(), Error> {
+        self.write_part(reg, space, BYTE_EN_BYTE, reg & 3, value & 0xFF)
+    }
+
+    fn set1(&mut self, reg: u16, space: u16, bits: u32) -> Result<(), Error> {
+        let value = self.read1(reg, space)?;
+        self.write1(reg, space, value | bits)
+    }
+
+    fn clear1(&mut self, reg: u16, space: u16, bits: u32) -> Result<(), Error> {
+        let value = self.read1(reg, space)?;
+        self.write1(reg, space, value & !bits)
+    }
+
+    fn set2(&mut self, reg: u16, space: u16, bits: u32) -> Result<(), Error> {
+        let value = self.read2(reg, space)?;
+        self.write2(reg, space, value | bits)
+    }
+
+    fn clear2(&mut self, reg: u16, space: u16, bits: u32) -> Result<(), Error> {
+        let value = self.read2(reg, space)?;
+        self.write2(reg, space, value & !bits)
+    }
+
+    /// Wait until `done` is true for the byte register `reg` in PLA.
+    fn wait1(&mut self, reg: u16, done: impl Fn(u32) -> bool, what: &'static str) -> Result<(), Error> {
+        let start = Instant::now();
+        while !done(self.read1(reg, MCU_TYPE_PLA)?) {
+            if start.elapsed() > Duration::from_secs(1) {
+                return Err(Error::Timeout(what));
+            }
+            sleep(Duration::from_millis(1));
+        }
+        Ok(())
+    }
+
+    /// PHY registers: select the 4 KiB page, then access it at 0xB000.
+    fn ocp_read(&mut self, addr: u16) -> Result<u16, Error> {
+        self.write2(PLA_OCP_GPHY_BASE, MCU_TYPE_PLA, u32::from(addr & 0xF000))?;
+        Ok(self.read2((addr & 0x0FFF) | 0xB000, MCU_TYPE_PLA)? as u16)
+    }
+
+    fn ocp_write(&mut self, addr: u16, value: u16) -> Result<(), Error> {
+        self.write2(PLA_OCP_GPHY_BASE, MCU_TYPE_PLA, u32::from(addr & 0xF000))?;
+        self.write2((addr & 0x0FFF) | 0xB000, MCU_TYPE_PLA, u32::from(value))
+    }
+
+    fn ocp_update(&mut self, addr: u16, clear: u16, set: u16) -> Result<(), Error> {
+        let value = self.ocp_read(addr)?;
+        self.ocp_write(addr, (value & !clear) | set)
+    }
+
+    fn sram_write(&mut self, addr: u16, value: u16) -> Result<(), Error> {
+        self.ocp_write(OCP_SRAM_ADDR, addr)?;
+        self.ocp_write(OCP_SRAM_DATA, value)
+    }
+
+    fn mii_read(&mut self, reg: u16) -> Result<u16, Error> {
+        self.ocp_read(OCP_BASE_MII + reg * 2)
+    }
+
+    fn mii_write(&mut self, reg: u16, value: u16) -> Result<(), Error> {
+        self.ocp_write(OCP_BASE_MII + reg * 2, value)
+    }
+
+    /// Turn off the PHY's link-down power saving (ALDPS).
+    fn disable_aldps(&mut self) -> Result<(), Error> {
+        self.ocp_write(OCP_ALDPS_CONFIG, ENPDNPS | LINKENA | DIS_SDSAVE)?;
+        for _ in 0..20 {
+            sleep(Duration::from_millis(1));
+            if self.ocp_read(OCP_ALDPS_STATE)? & 0x0100 != 0 {
+                break;
+            }
+        }
+        Ok(())
+    }
+
+    fn enable_aldps(&mut self) -> Result<(), Error> {
+        self.ocp_update(OCP_POWER_CFG, 0, EN_ALDPS)
+    }
+
+    /// Wait until the PHY state is `desired`, or for 0 any settled state.
+    /// Like FreeBSD, go on after a timeout.
+    fn wait_phy(&mut self, desired: u16) -> Result<u16, Error> {
+        let start = Instant::now();
+        loop {
+            let state = self.ocp_read(OCP_PHY_STATUS)? & PHY_STAT_MASK;
+            let done = if desired != 0 {
+                state == desired
+            } else {
+                matches!(state, PHY_STAT_LAN_ON | PHY_STAT_PWRDN | PHY_STAT_EXT_INIT)
+            };
+            if done {
+                return Ok(state);
+            }
+            if start.elapsed() > Duration::from_secs(2) {
+                println!("dwc2d: RTL815x PHY state {state}, still waiting for {desired}, going on");
+                return Ok(state);
+            }
+            sleep(Duration::from_millis(10));
+        }
+    }
+
+    /// Wait until the chip has loaded its configuration from the efuse.
+    fn wait_autoload(&mut self) -> Result<(), Error> {
+        let start = Instant::now();
+        while self.read2(PLA_BOOT_CTRL, MCU_TYPE_PLA)? & AUTOLOAD_DONE == 0 {
+            if start.elapsed() > Duration::from_secs(2) {
+                println!("dwc2d: RTL815x autoload not done, going on");
+                break;
+            }
+            sleep(Duration::from_millis(10));
+        }
+        Ok(())
+    }
+
+    /// The USB link power tolerance, six bytes of `value`.
+    fn write_tolerance(&mut self, value: u8) -> Result<(), Error> {
+        self.write_mem(USB_TOLERANCE, MCU_TYPE_USB | BYTE_EN_SIX_BYTES, &[value; 8])
+    }
+
+    fn reset(&mut self) -> Result<(), Error> {
+        self.write1(PLA_CR, MCU_TYPE_PLA, CR_RST)?;
+        self.wait1(PLA_CR, |v| v & CR_RST == 0, "reset")
+    }
+
+    fn nic_reset(&mut self) -> Result<(), Error> {
+        self.set2(PLA_MISC_1, MCU_TYPE_PLA, RXDY_GATED_EN)?;
+
+        // No wake-up offloads.
+        self.clear2(PLA_TEREDO_CFG, MCU_TYPE_PLA, TEREDO_SEL | TEREDO_RS_EVENT_MASK | OOB_TEREDO_EN)?;
+        self.write2(PLA_WDT6_CTRL, MCU_TYPE_PLA, WDT6_SET_MODE)?;
+        self.write2(PLA_REALWOW_TIMER, MCU_TYPE_PLA, 0)?;
+        self.write4(PLA_TEREDO_TIMER, MCU_TYPE_PLA, 0)?;
+
+        let rcr = self.read4(PLA_RCR, MCU_TYPE_PLA)?;
+        self.write4(PLA_RCR, MCU_TYPE_PLA, rcr & !RCR_ACPT_ALL)?;
+
+        self.reset()?;
+        self.write1(PLA_CR, MCU_TYPE_PLA, 0)?;
+        let oob = self.read1(PLA_OOB_CTRL, MCU_TYPE_PLA)?;
+        self.write1(PLA_OOB_CTRL, MCU_TYPE_PLA, oob & !NOW_IS_OOB)?;
+
+        self.clear2(PLA_SFF_STS_7, MCU_TYPE_PLA, MCU_BORW_EN)?;
+        self.wait1(PLA_OOB_CTRL, |v| v & LINK_LIST_READY != 0, "link list")?;
+        self.set2(PLA_SFF_STS_7, MCU_TYPE_PLA, RE_INIT_LL)?;
+        self.wait1(PLA_OOB_CTRL, |v| v & LINK_LIST_READY != 0, "link list reinit")?;
+
+        self.clear2(PLA_CPCR, MCU_TYPE_PLA, CPCR_RX_VLAN)?;
+        self.set2(PLA_TCR0, MCU_TYPE_PLA, TCR0_AUTO_FIFO)?;
+
+        self.write4(PLA_RXFIFO_CTRL0, MCU_TYPE_PLA, RXFIFO_THR1_NORMAL)?;
+        let (fifo1, fifo2) = if self.f.speed == Speed::Full {
+            (RXFIFO_THR2_FULL, RXFIFO_THR3_FULL)
+        } else {
+            (RXFIFO_THR2_HIGH, RXFIFO_THR3_HIGH)
+        };
+        self.write4(PLA_RXFIFO_CTRL1, MCU_TYPE_PLA, fifo1)?;
+        self.write4(PLA_RXFIFO_CTRL2, MCU_TYPE_PLA, fifo2)?;
+        self.write4(PLA_TXFIFO_CTRL, MCU_TYPE_PLA, TXFIFO_THR_NORMAL)
+    }
+
+    /// One-time RTL8152 setup (power, clocks, aggregation), then a NIC reset.
+    fn init_8152(&mut self, version: u32) -> Result<(), Error> {
+        self.disable_aldps()?;
+        if version == VERSION_4C00 {
+            self.clear2(PLA_LED_FEATURE, MCU_TYPE_PLA, LED_MODE_MASK)?;
+        }
+        self.clear2(USB_UPS_CTRL, MCU_TYPE_USB, POWER_CUT)?;
+        self.clear2(USB_PM_CTRL_STATUS, MCU_TYPE_USB, RESUME_INDICATE)?;
+        self.set2(PLA_PHY_PWR, MCU_TYPE_PLA, TX_10M_IDLE_EN | PFM_PWM_SWITCH)?;
+        let power = self.read4(PLA_MAC_PWR_CTRL, MCU_TYPE_PLA)? & !MCU_CLK_RATIO_MASK;
+        self.write4(PLA_MAC_PWR_CTRL, MCU_TYPE_PLA, power | MCU_CLK_RATIO | D3_CLK_GATED_EN)?;
+        self.write2(
+            PLA_GPHY_INTR_IMR,
+            MCU_TYPE_PLA,
+            GPHY_STS_MSK | SPEED_DOWN_MSK | SPDWN_RXDV_MSK | SPDWN_LINKCHG_MSK,
+        )?;
+        // RX aggregation: several frames per bulk IN transfer.
+        self.clear2(USB_USB_CTRL, MCU_TYPE_USB, RX_AGG_DISABLE | RX_ZERO_EN)?;
+        self.disable_aldps()?;
+        self.nic_reset()?;
+        self.write1(USB_TX_AGG, MCU_TYPE_USB, TX_AGG_MAX_THRESHOLD)?;
+        self.write4(USB_RX_BUF_TH, MCU_TYPE_USB, RX_THR_HIGH)?;
+        self.write4(USB_TX_DMA, MCU_TYPE_USB, TEST_MODE_DISABLE | TX_SIZE_ADJUST1)
+    }
+
+    /// One-time RTL8153 setup: USB and PHY power, then a NIC reset.
+    fn init_8153(&mut self, version: u32) -> Result<(), Error> {
+        self.disable_aldps()?;
+        self.write_tolerance(0x00)?;
+        self.wait_autoload()?;
+        let state = self.ocp_read(OCP_PHY_STATUS)? & PHY_STAT_MASK;
+        if state != PHY_STAT_LAN_ON && state != PHY_STAT_PWRDN {
+            self.wait_phy(PHY_STAT_LAN_ON)?;
+        }
+        self.clear2(USB_U2P3_CTRL, MCU_TYPE_USB, U2P3_ENABLE)?;
+
+        if version == VERSION_5C10 {
+            let value = self.read2(USB_SSPHYLINK2, MCU_TYPE_USB)? & !PWD_DN_SCALE_MASK;
+            self.write2(USB_SSPHYLINK2, MCU_TYPE_USB, value | (96 << 1))?;
+            self.set1(USB_USB2PHY, MCU_TYPE_USB, USB2PHY_L1 | USB2PHY_SUSPEND)?;
+        } else if version == VERSION_5C20 {
+            self.clear1(PLA_DMY_REG0, MCU_TYPE_PLA, ECM_ALDPS)?;
+        }
+        if version == VERSION_5C20 || version == VERSION_5C30 {
+            let mut value = self.read1(USB_CSR_DUMMY1, MCU_TYPE_USB)?;
+            if self.read2(USB_BURST_SIZE, MCU_TYPE_USB)? == 0 {
+                value &= !DYNAMIC_BURST;
+            } else {
+                value |= DYNAMIC_BURST;
+            }
+            self.write1(USB_CSR_DUMMY1, MCU_TYPE_USB, value)?;
+        }
+        self.set1(USB_CSR_DUMMY2, MCU_TYPE_USB, EP4_FULL_FC)?;
+        self.clear2(USB_WDT11_CTRL, MCU_TYPE_USB, TIMER11_EN)?;
+        self.clear2(PLA_LED_FEATURE, MCU_TYPE_PLA, LED_MODE_MASK)?;
+
+        // Never super speed behind a DWC2.
+        let timer = if version == VERSION_5C10 { LPM_TIMER_500MS } else { LPM_TIMER_500US };
+        self.write1(USB_LPM_CTRL, MCU_TYPE_USB, timer | FIFO_EMPTY_1FB | ROK_EXIT_LPM)?;
+        let afe = self.read2(USB_AFE_CTRL2, MCU_TYPE_USB)? & !SEN_VAL_MASK;
+        self.write2(USB_AFE_CTRL2, MCU_TYPE_USB, afe | SEN_VAL_NORMAL | SEL_RXIDLE)?;
+        self.write2(USB_CONNECT_TIMER, MCU_TYPE_USB, 0x0001)?;
+        self.clear2(USB_POWER_CUT, MCU_TYPE_USB, PWR_EN | PHASE2_EN)?;
+        self.clear2(USB_MISC_0, MCU_TYPE_USB, PCUT_STATUS)?;
+        self.write_tolerance(0xFF)?;
+
+        self.write2(PLA_MAC_PWR_CTRL, MCU_TYPE_PLA, ALDPS_SPDWN_RATIO)?;
+        self.write2(PLA_MAC_PWR_CTRL2, MCU_TYPE_PLA, EEE_SPDWN_RATIO)?;
+        self.write2(
+            PLA_MAC_PWR_CTRL3,
+            MCU_TYPE_PLA,
+            PKT_AVAIL_SPDWN_EN | SUSPEND_SPDWN_EN | U1U2_SPDWN_EN | L1_SPDWN_EN,
+        )?;
+        self.write2(
+            PLA_MAC_PWR_CTRL4,
+            MCU_TYPE_PLA,
+            PWRSAVE_SPDWN_EN
+                | RXDV_SPDWN_EN
+                | TX10MIDLE_EN
+                | TP100_SPDWN_EN
+                | TP500_SPDWN_EN
+                | TP1000_SPDWN_EN
+                | EEE_SPDWN_EN,
+        )?;
+        self.set_u2p3(version)?;
+        self.write_tolerance(0x00)?;
+
+        self.disable_aldps()?;
+        if matches!(version, VERSION_5C00 | VERSION_5C10 | VERSION_5C20) {
+            self.ocp_write(OCP_ADC_CFG, CKADSEL_L | ADC_EN | EN_EMI_L)?;
+        }
+        if version == VERSION_5C00 {
+            self.ocp_update(OCP_EEE_CFG, CTAP_SHORT_EN, 0)?;
+        }
+        self.ocp_update(OCP_POWER_CFG, 0, EEE_CLKDIV_EN)?;
+        self.ocp_update(OCP_DOWN_SPEED, 0, EN_10M_BGOFF)?;
+        self.ocp_update(OCP_POWER_CFG, 0, EN_10M_PLLOFF)?;
+        self.sram_write(SRAM_IMPEDANCE, 0x0B13)?;
+        self.set2(PLA_PHY_PWR, MCU_TYPE_PLA, PFM_PWM_SWITCH)?;
+        self.sram_write(SRAM_LPF_CFG, 0xF70F)?;
+        self.sram_write(SRAM_10M_AMP1, 0x00AF)?;
+        self.sram_write(SRAM_10M_AMP2, 0x0208)?;
+
+        self.nic_reset()?;
+        self.clear2(USB_USB_CTRL, MCU_TYPE_USB, RX_AGG_DISABLE | RX_ZERO_EN)?;
+        self.set_u2p3(version)?;
+        self.write_tolerance(0xFF)
+    }
+
+    /// USB 2 power saving (U2P3): off on the first two RTL8153 versions.
+    fn set_u2p3(&mut self, version: u32) -> Result<(), Error> {
+        if matches!(version, VERSION_5C00 | VERSION_5C10) {
+            self.clear2(USB_U2P3_CTRL, MCU_TYPE_USB, U2P3_ENABLE)
+        } else {
+            self.set2(USB_U2P3_CTRL, MCU_TYPE_USB, U2P3_ENABLE)
+        }
+    }
+
+    /// One-time RTL8153B setup: no USB power saving, PHY on.
+    fn init_8153b(&mut self) -> Result<(), Error> {
+        self.disable_aldps()?;
+        self.clear2(USB_LPM_CONFIG, MCU_TYPE_USB, LPM_U1U2_EN)?;
+        self.wait_autoload()?;
+        self.wait_phy(0)?;
+        let bmcr = self.mii_read(MII_BMCR)?;
+        if bmcr & BMCR_PDOWN != 0 {
+            self.mii_write(MII_BMCR, bmcr & !BMCR_PDOWN)?;
+        }
+        self.wait_phy(PHY_STAT_LAN_ON)?;
+
+        self.clear2(USB_U2P3_CTRL, MCU_TYPE_USB, U2P3_ENABLE)?;
+        // MSC timer 32760 ms, U1/U2/L1 idle timer 500 us.
+        self.write2(USB_MSC_TIMER, MCU_TYPE_USB, 0x0FFF)?;
+        self.write2(USB_U1U2_TIMER, MCU_TYPE_USB, 500)?;
+        self.clear2(USB_POWER_CUT, MCU_TYPE_USB, PWR_EN)?;
+        self.clear2(USB_MISC_0, MCU_TYPE_USB, PCUT_STATUS)?;
+        self.clear1(USB_POWER_CUT, MCU_TYPE_USB, UPS_EN | USP_PREWAKE)?;
+        self.clear1(0xCFFF, MCU_TYPE_USB, 0x01)?;
+
+        // No wake on queued packets or link changes, no runtime suspend.
+        // FreeBSD reaches these PLA registers through the USB space.
+        self.clear1(PLA_INDICATE_FLAG, MCU_TYPE_USB, UPCOMING_RUNTIME_D3)?;
+        self.clear1(PLA_SUSPEND_FLAG, MCU_TYPE_USB, LINK_CHG_EVENT)?;
+        self.clear2(PLA_EXTRA_STATUS, MCU_TYPE_USB, LINK_CHANGE_FLAG)?;
+        self.write1(PLA_CRWECR, MCU_TYPE_PLA, CRWECR_CONFIG)?;
+        self.clear2(PLA_CONFIG34, MCU_TYPE_USB, LINK_OFF_WAKE_EN)?;
+        self.write1(PLA_CRWECR, MCU_TYPE_PLA, CRWECR_NORMAL)?;
+
+        let mut extra = self.read2(PLA_EXTRA_STATUS, MCU_TYPE_PLA)?;
+        if self.read2(PLA_PHYSTATUS, MCU_TYPE_PLA)? & PHYSTATUS_LINK != 0 {
+            extra |= CUR_LINK_OK;
+        } else {
+            extra &= !CUR_LINK_OK;
+        }
+        self.write2(PLA_EXTRA_STATUS, MCU_TYPE_PLA, extra | POLL_LINK_CHG)?;
+
+        self.set2(PLA_MAC_PWR_CTRL2, MCU_TYPE_USB, MAC_CLK_SPDWN_EN)?;
+        self.clear2(PLA_MAC_PWR_CTRL3, MCU_TYPE_PLA, PLA_MCU_SPDWN_EN)?;
+        self.clear2(USB_USB_CTRL, MCU_TYPE_USB, RX_AGG_DISABLE | RX_ZERO_EN)?;
+        self.set2(PLA_RSTTALLY, MCU_TYPE_USB, TALLY_RESET)
+    }
+
+    fn nic_reset_8153b(&mut self) -> Result<(), Error> {
+        self.clear2(USB_LPM_CONFIG, MCU_TYPE_USB, LPM_U1U2_EN)?;
+        self.clear2(USB_U2P3_CTRL, MCU_TYPE_USB, U2P3_ENABLE)?;
+        self.disable_aldps()?;
+        self.set2(PLA_MISC_1, MCU_TYPE_PLA, RXDY_GATED_EN)?;
+        self.clear2(PLA_TEREDO_CFG, MCU_TYPE_PLA, TEREDO_SEL | TEREDO_RS_EVENT_MASK | OOB_TEREDO_EN)?;
+        self.write2(PLA_WDT6_CTRL, MCU_TYPE_PLA, WDT6_SET_MODE)?;
+        self.write2(PLA_REALWOW_TIMER, MCU_TYPE_PLA, 0)?;
+        self.write4(PLA_TEREDO_TIMER, MCU_TYPE_PLA, 0)?;
+        let rcr = self.read4(PLA_RCR, MCU_TYPE_PLA)?;
+        self.write4(PLA_RCR, MCU_TYPE_PLA, rcr & !RCR_ACPT_ALL)?;
+        self.reset()?;
+
+        // Reset the buffer management unit of both bulk endpoints.
+        self.clear1(USB_BMU_RESET, MCU_TYPE_USB, BMU_RESET_EP_IN | BMU_RESET_EP_OUT)?;
+        self.set1(USB_BMU_RESET, MCU_TYPE_USB, BMU_RESET_EP_IN | BMU_RESET_EP_OUT)?;
+
+        self.clear1(PLA_OOB_CTRL, MCU_TYPE_PLA, NOW_IS_OOB)?;
+        self.clear2(PLA_SFF_STS_7, MCU_TYPE_PLA, MCU_BORW_EN)?;
+        self.wait1(PLA_OOB_CTRL, |v| v & LINK_LIST_READY != 0, "link list")?;
+        self.set2(PLA_SFF_STS_7, MCU_TYPE_PLA, RE_INIT_LL)?;
+        self.wait1(PLA_OOB_CTRL, |v| v & LINK_LIST_READY != 0, "link list reinit")?;
+
+        // No VLAN tag stripping.
+        self.clear2(0xC012, MCU_TYPE_PLA, 0x00C0)?;
+        self.write2(PLA_RMS, MCU_TYPE_PLA, MAX_FRAME_LEN)?;
+        self.write1(PLA_MTPS, MCU_TYPE_PLA, MTPS_JUMBO)?;
+        self.set2(PLA_TCR0, MCU_TYPE_PLA, TCR0_AUTO_FIFO)?;
+        self.reset()?;
+
+        self.write4(PLA_RXFIFO_CTRL0, MCU_TYPE_PLA, RXFIFO_THR1_NORMAL)?;
+        self.write2(PLA_RXFIFO_CTRL1, MCU_TYPE_PLA, RXFIFO_THR2_NORMAL)?;
+        self.write2(PLA_RXFIFO_CTRL2, MCU_TYPE_PLA, RXFIFO_THR3_NORMAL)?;
+        self.write4(USB_RX_BUF_TH, MCU_TYPE_USB, RX_THR_B)?;
+        self.write4(PLA_TXFIFO_CTRL, MCU_TYPE_PLA, TXFIFO_THR_NORMAL2)?;
+        self.clear2(PLA_MAC_PWR_CTRL3, MCU_TYPE_PLA, PLA_MCU_SPDWN_EN)?;
+        self.enable_aldps()
+    }
+}
+
+fn valid_mac(mac: &[u8; 6]) -> bool {
+    mac[0] & 1 == 0 && mac.iter().any(|&b| b != 0)
+}
+
+/// Bring the chip up: chip setup, reset, MAC address, filters, PHY, and
+/// enable receiver and transmitter. Returns the MAC address in use.
+pub fn init(bus: &mut Bus, f: &Rtl8152Function) -> Result<[u8; 6], Error> {
+    bus.request(f.address, f.max_packet0, f.speed, 0x00, REQ_SET_CONFIGURATION, u16::from(f.configuration), 0, 0)?;
+    let mut r = Regs { bus, f };
+
+    let version = r.read2(PLA_TCR1, MCU_TYPE_PLA)? & VERSION_MASK;
+    let Some(chip) = Chip::from_version(version) else {
+        println!("dwc2d: RTL815x chip version {:04x} not supported", version);
+        return Err(Error::Timeout("unsupported RTL815x chip version"));
+    };
+    println!("dwc2d: {} chip version {:04x}", chip.name(), version);
+
+    // The address comes from the chip's efuse.
+    let idr = r.read_mem(PLA_IDR, MCU_TYPE_PLA, 8)?;
+    let mut mac = [idr[0], idr[1], idr[2], idr[3], idr[4], idr[5]];
+    if !valid_mac(&mac) {
+        let backup = r.read_mem(PLA_BACKUP, MCU_TYPE_PLA, 8)?;
+        mac.copy_from_slice(&backup[..6]);
+    }
+    if !valid_mac(&mac) {
+        // Locally administered fallback.
+        mac = [0x02, 0x52, 0x65, 0x64, 0x6F, 0x78];
+    }
+
+    match chip {
+        Chip::Rtl8152 => r.init_8152(version)?,
+        Chip::Rtl8153 => r.init_8153(version)?,
+        Chip::Rtl8153B => r.init_8153b()?,
+    }
+    if chip == Chip::Rtl8153B {
+        r.nic_reset_8153b()?;
+    } else {
+        r.reset()?;
+    }
+
+    let mut idr = [0; 8];
+    idr[..6].copy_from_slice(&mac);
+    r.write1(PLA_CRWECR, MCU_TYPE_PLA, CRWECR_CONFIG)?;
+    r.write_mem(PLA_IDR, MCU_TYPE_PLA | BYTE_EN_SIX_BYTES, &idr)?;
+    r.write1(PLA_CRWECR, MCU_TYPE_PLA, CRWECR_NORMAL)?;
+
+    // RX aggregation on the RTL8153: how long to wait and how much to
+    // collect before a bulk IN transfer ends.
+    let early_size = RX_BUF_SIZE as u32 - (MAX_FRAME_LEN + RX_HEADER_LEN as u32 + RX_ALIGN as u32);
+    match chip {
+        Chip::Rtl8152 => {}
+        Chip::Rtl8153 => {
+            let coalesce = if f.speed == Speed::High { COALESCE_HIGH } else { COALESCE_SLOW };
+            r.write2(USB_RX_EARLY_AGG, MCU_TYPE_USB, coalesce / 8)?;
+            r.write2(USB_RX_EARLY_SIZE, MCU_TYPE_USB, early_size / 4)?;
+        }
+        Chip::Rtl8153B => {
+            r.write2(USB_RX_EARLY_AGG, MCU_TYPE_USB, 158)?;
+            r.write2(USB_RX_EXTRA_AGG_TMR, MCU_TYPE_USB, 1875)?;
+            r.write2(USB_RX_EARLY_SIZE, MCU_TYPE_USB, early_size / 8)?;
+            r.write1(USB_UPT_RXDMA_OWN, MCU_TYPE_USB, OWN_UPDATE | OWN_CLEAR)?;
+        }
+    }
+
+    // Reset the packet filter.
+    r.clear2(PLA_FMC, MCU_TYPE_PLA, FMC_FCR_MCU_EN)?;
+    r.set2(PLA_FMC, MCU_TYPE_PLA, FMC_FCR_MCU_EN)?;
+    r.clear2(PLA_CPCR, MCU_TYPE_PLA, CPCR_RX_VLAN)?;
+
+    let cr = r.read1(PLA_CR, MCU_TYPE_PLA)?;
+    r.write1(PLA_CR, MCU_TYPE_PLA, cr | CR_RE | CR_TE)?;
+    r.clear2(PLA_MISC_1, MCU_TYPE_PLA, RXDY_GATED_EN)?;
+
+    // Own address, broadcast and all multicast (IPv6 neighbor discovery).
+    let rcr = r.read4(PLA_RCR, MCU_TYPE_PLA)? & !RCR_AAP;
+    r.write4(PLA_MAR0, MCU_TYPE_PLA, u32::MAX)?;
+    r.write4(PLA_MAR4, MCU_TYPE_PLA, u32::MAX)?;
+    r.write4(PLA_RCR, MCU_TYPE_PLA, rcr | RCR_APM | RCR_AB | RCR_AM)?;
+
+    // PHY: advertise 10/100 (and 1000 on the RTL8153), autonegotiate.
+    r.mii_write(MII_ANAR, ANAR_ALL)?;
+    if chip != Chip::Rtl8152 {
+        r.mii_write(MII_GTCR, GTCR_ADV_1000)?;
+    }
+    let bmcr = r.mii_read(MII_BMCR)?;
+    r.mii_write(MII_BMCR, bmcr | BMCR_AUTOEN | BMCR_STARTNEG)?;
+
+    // Wait for the link, so DHCP does not start into a dead cable.
+    let start = Instant::now();
+    loop {
+        let status = r.read2(PLA_PHYSTATUS, MCU_TYPE_PLA)?;
+        if status & PHYSTATUS_LINK != 0 {
+            let speed = if status & PHYSTATUS_1000MBPS != 0 {
+                1000
+            } else if status & PHYSTATUS_100MBPS != 0 {
+                100
+            } else {
+                10
+            };
+            println!(
+                "dwc2d: {} link up after {} ms, {} Mbit/s {} duplex",
+                chip.name(),
+                start.elapsed().as_millis(),
+                speed,
+                if status & PHYSTATUS_FDX != 0 { "full" } else { "half" },
+            );
+            break;
+        }
+        if start.elapsed() > Duration::from_secs(5) {
+            println!("dwc2d: {} no link yet", chip.name());
+            break;
+        }
+        sleep(Duration::from_millis(100));
+    }
+    Ok(mac)
+}
+
+pub struct Rtl8152 {
+    hc: Dwc2,
+    f: Rtl8152Function,
+    mac: [u8; 6],
+    in_pid: u32,
+    out_pid: u32,
+    rx: Dma<[u8; RX_BUF_SIZE]>,
+    tx: Dma<[u8; TX_BUF_SIZE]>,
+    rx_armed: bool,
+    frames: VecDeque<Vec<u8>>,
+}
+
+impl Rtl8152 {
+    pub fn new(hc: Dwc2, f: Rtl8152Function, mac: [u8; 6]) -> Self {
+        let mut nic = Self {
+            hc,
+            f,
+            mac,
+            in_pid: PID_DATA0,
+            out_pid: PID_DATA0,
+            rx: Dma::new([0; RX_BUF_SIZE]).expect("dwc2d: DMA allocation failed"),
+            tx: Dma::new([0; TX_BUF_SIZE]).expect("dwc2d: DMA allocation failed"),
+            rx_armed: false,
+            frames: VecDeque::new(),
+        };
+        nic.arm_rx();
+        nic
+    }
+
+    fn phase(&self, dir_in: bool, len: usize) -> Phase {
+        Phase {
+            dev_addr: self.f.address,
+            endpoint: if dir_in { self.f.ep_in } else { self.f.ep_out },
+            dir_in,
+            ep_type: EPTYPE_BULK,
+            max_packet: if dir_in { self.f.max_packet_in } else { self.f.max_packet_out },
+            low_speed: false,
+            pid: if dir_in { self.in_pid } else { self.out_pid },
+            buf_phys: if dir_in { self.rx.physical() } else { self.tx.physical() },
+            len,
+        }
+    }
+
+    fn arm_rx(&mut self) {
+        let phase = self.phase(true, RX_BUF_SIZE);
+        self.hc.start(RX_CHANNEL, &phase);
+        self.rx_armed = true;
+    }
+
+    /// Split a completed bulk IN transfer into frames.
+    fn parse_rx(&mut self, len: usize) {
+        let mut off = 0;
+        while off + RX_HEADER_LEN <= len {
+            let word = u32::from_le_bytes([self.rx[off], self.rx[off + 1], self.rx[off + 2], self.rx[off + 3]]);
+            off += RX_HEADER_LEN;
+            let frame_len = (word & RX_LEN_MASK) as usize;
+            // A bad length means the rest of the transfer cannot be trusted.
+            if frame_len >= RX_LEN_MASK as usize || off + frame_len > len {
+                break;
+            }
+            if frame_len >= ETHER_HDR_LEN + ETHER_CRC_LEN {
+                self.frames.push_back(self.rx[off..off + frame_len - ETHER_CRC_LEN].to_vec());
+            }
+            off = (off + frame_len).next_multiple_of(RX_ALIGN);
+        }
+    }
+
+    fn poll_rx(&mut self) {
+        if !self.rx_armed {
+            return;
+        }
+        match self.hc.poll(RX_CHANNEL, RX_BUF_SIZE) {
+            None => {}
+            Some(Ok((len, next_pid))) => {
+                self.in_pid = next_pid;
+                self.parse_rx(len);
+                self.arm_rx();
+            }
+            Some(Err(_)) => self.arm_rx(),
+        }
+    }
+}
+
+impl NetworkAdapter for Rtl8152 {
+    fn mac_address(&mut self) -> [u8; 6] {
+        self.mac
+    }
+
+    fn available_for_read(&mut self) -> usize {
+        self.poll_rx();
+        self.frames.front().map_or(0, Vec::len)
+    }
+
+    fn read_packet(&mut self, buf: &mut [u8]) -> SysResult<Option<usize>> {
+        self.poll_rx();
+        let Some(frame) = self.frames.pop_front() else {
+            return Ok(None);
+        };
+        let len = frame.len().min(buf.len());
+        buf[..len].copy_from_slice(&frame[..len]);
+        Ok(Some(len))
+    }
+
+    fn write_packet(&mut self, buf: &[u8]) -> SysResult<usize> {
+        let len = buf.len().min(TX_BUF_SIZE - TX_HEADER_LEN);
+        let padded = len.max(ETHER_MIN_LEN);
+        let header = padded as u32 | TX_FS | TX_LS;
+        self.tx[..4].copy_from_slice(&header.to_le_bytes());
+        self.tx[4..8].copy_from_slice(&0u32.to_le_bytes());
+        self.tx[TX_HEADER_LEN..TX_HEADER_LEN + len].copy_from_slice(&buf[..len]);
+        self.tx[TX_HEADER_LEN + len..TX_HEADER_LEN + padded].fill(0);
+        let total = TX_HEADER_LEN + padded;
+        let timeout = Duration::from_millis(100);
+        let phase = self.phase(false, total);
+        let (_, next_pid) = self
+            .hc
+            .transfer_on(TX_CHANNEL, &phase, timeout)
+            .map_err(|_| SysError::new(EIO))?;
+        self.out_pid = next_pid;
+        if total % usize::from(self.f.max_packet_out) == 0 {
+            let phase = self.phase(false, 0);
+            let (_, next_pid) = self
+                .hc
+                .transfer_on(TX_CHANNEL, &phase, timeout)
+                .map_err(|_| SysError::new(EIO))?;
+            self.out_pid = next_pid;
+        }
+        Ok(len)
+    }
+}
