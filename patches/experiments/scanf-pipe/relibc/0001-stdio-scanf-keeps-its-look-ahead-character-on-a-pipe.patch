-        types::{c_char, off_t, wchar_t, wint_t},
+        types::{c_char, wchar_t, wint_t},
     },
 };
 use core::{
@@ -46,25 +46,37 @@ impl<'a, T: Kind> Iterator for BufferReader<'a, T> {
     }
 }
 
+/// Reads characters from a FILE for scanf, leaving the character it
+/// returned last in the stream: that is scanf's look-ahead character, which
+/// the next read on the stream must get when scanf stops at it.
+///
+/// Each character's bytes go back into the FILE's unget buffer (as with
+/// ungetc) and are taken out when the next character is read. Not with
+/// fseek, as before: on a pipe fseek drops the FILE's read buffer and then
+/// fails, so the look-ahead character and all buffered input were lost.
 pub struct FileReader<'a, T: Kind> {
     f: &'a mut FILE,
-    position: off_t,
+    /// Bytes of the character returned last that the next read consumes
+    /// (0 after an invalid multibyte sequence: it is read again, as before).
+    consumed: usize,
     phantom: PhantomData<T>,
 }
 
 impl<'a, T: Kind> FileReader<'a, T> {
-    // Gets the wchar at the current position
+    // Gets the character at the current position: the character, the
+    // bytes read for it and its encoded length.
     #[inline]
-    fn get_curret_char(&mut self) -> Result<Option<(T::Char, usize)>, i32> {
+    fn get_curret_char(
+        &mut self,
+    ) -> Result<Option<(T::Char, [u8; MB_CUR_MAX as usize], usize, usize)>, i32> {
+        let mut buf = [0; MB_CUR_MAX as usize];
         if T::IS_THIN_NOT_WIDE {
-            let mut buf: [u8; 1] = [0];
-            match self.f.read(&mut buf) {
+            match self.f.read(&mut buf[..1]) {
                 Ok(0) => Ok(None),
-                Ok(n) => Ok(Some((T::Char::from(buf[0]), n))),
+                Ok(n) => Ok(Some((T::Char::from(buf[0]), buf, n, n))),
                 Err(_) => Err(-1),
             }
         } else {
-            let buf = &mut [0; MB_CUR_MAX as usize];
             let mut encoded_length = 0;
             let mut bytes_read = 0;
 
@@ -82,7 +94,7 @@ impl<'a, T: Kind> FileReader<'a, T> {
                         el
                     } else {
                         ERRNO.set(EILSEQ);
-                        return Self::get_char_from_wint(WEOF).map(|c| Some((c, 0)));
+                        return Self::get_char_from_wint(WEOF).map(|c| Some((c, buf, 1, 0)));
                     };
                 }
 
@@ -101,7 +113,8 @@ impl<'a, T: Kind> FileReader<'a, T> {
                 );
             }
 
-            Self::get_char_from_wint(wc as wint_t).map(|c| Some((c, encoded_length)))
+            Self::get_char_from_wint(wc as wint_t)
+                .map(|c| Some((c, buf, bytes_read, encoded_length)))
         }
     }
 
@@ -120,12 +133,22 @@ impl<'a, T: Kind> Iterator for FileReader<'a, T> {
     type Item = Result<T::Char, i32>;
 
     fn next(&mut self) -> Option<Self::Item> {
-        unsafe { fseek_locked(self.f, self.position, SEEK_SET) };
+        // Take the character returned last out of the stream.
+        let mut skip = [0; MB_CUR_MAX as usize];
+        let mut skipped = 0;
+        while skipped < self.consumed {
+            match self.f.read(&mut skip[skipped..self.consumed]) {
+                Ok(0) | Err(_) => break,
+                Ok(n) => skipped += n,
+            }
+        }
+        self.consumed = 0;
 
         match self.get_curret_char() {
-            Ok(Some((wc, encoded_length))) => {
-                unsafe { fseek_locked(self.f, self.position, SEEK_SET) };
-                self.position += encoded_length as off_t;
+            Ok(Some((wc, bytes, read, encoded_length))) => {
+                // Back into the stream until the next read.
+                self.f.unget.extend(bytes[..read].iter().rev());
+                self.consumed = encoded_length;
                 Some(Ok(wc))
             }
             Ok(None) => None,
@@ -136,10 +159,9 @@ impl<'a, T: Kind> Iterator for FileReader<'a, T> {
 
 impl<'a, T: Kind> From<&'a mut FILE> for FileReader<'a, T> {
     fn from(f: &'a mut FILE) -> Self {
-        let position = unsafe { ftell_locked(f) } as off_t;
         FileReader {
             f,
-            position,
+            consumed: 0,
             phantom: PhantomData::<T>,
         }
     }
