diff --git a/tests/stdio/fscanf_pipe.c b/tests/stdio/fscanf_pipe.c
new file mode 100644
index 0000000..add0a57
--- /dev/null
+++ b/tests/stdio/fscanf_pipe.c
@@ -0,0 +1,45 @@
+// fscanf on a pipe: the character scanf looks ahead at must stay in the
+// stream, as on a file (fscanf.c), although a pipe cannot seek back.
+#include <stdio.h>
+#include <unistd.h>
+
+#include "test_helpers.h"
+
+int main(void) {
+    int fds[2];
+    int status = pipe(fds);
+    ERROR_IF(pipe, status, == -1);
+
+    const char input[] = "ab12,cd1.5;12345  x7!";
+    ssize_t written = write(fds[1], input, sizeof(input) - 1);
+    ERROR_IF(write, written, == -1);
+    close(fds[1]);
+
+    FILE *f = fdopen(fds[0], "r");
+    ERROR_IF(fdopen, f, == NULL);
+
+    char c;
+    int n = 0, r;
+    double d = 0;
+    // Each line: what fscanf returned, then the next character in the stream.
+    r = fscanf(f, "%c", &c);
+    printf("%%c: %d '%c', next '%c'\n", r, c, fgetc(f));
+    r = fscanf(f, "%d", &n);
+    printf("%%d: %d %d, next '%c'\n", r, n, fgetc(f));
+    r = fscanf(f, "_%lf", &d);
+    printf("_%%lf: %d, next '%c'\n", r, fgetc(f));
+    r = fscanf(f, "%lf", &d);
+    printf("%%lf: %d, next '%c'\n", r, fgetc(f));
+    r = fscanf(f, "%3d", &n);
+    printf("%%3d: %d %d, next '%c'\n", r, n, fgetc(f));
+    r = fscanf(f, " x%d", &n);
+    printf("' x%%d': %d, next '%c'\n", r, fgetc(f));
+    r = fscanf(f, ";%d", &n);
+    printf("';%%d': %d %d, next '%c'\n", r, n, fgetc(f));
+    r = fscanf(f, " x%d", &n);
+    printf("' x%%d': %d %d, next '%c'\n", r, n, fgetc(f));
+    printf("then: %d\n", fgetc(f));
+
+    fclose(f);
+    return 0;
+}
