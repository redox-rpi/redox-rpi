 tests/Makefile.tests.mk                 |  1 +
 tests/expected/stdio/fscanf_pipe.stdout |  9 ++++
 tests/stdio/fscanf_pipe.c               | 45 ++++++++++++++++++++
 4 files changed, 94 insertions(+), 17 deletions(-)
 create mode 100644 tests/expected/stdio/fscanf_pipe.stdout
 create mode 100644 tests/stdio/fscanf_pipe.c

