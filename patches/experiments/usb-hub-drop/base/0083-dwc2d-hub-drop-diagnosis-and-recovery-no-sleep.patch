From aacf8fb314f6005d760af4d488de0490f5c80f00 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Sat, 31 Oct 2026 21:44:29 +0000
Subject: [PATCH] dwc2d: hub drop diagnosis and recovery, no sleep (#151)

A hub port that changed, lost its enable bit, went over current or lost
power is logged with its status and change bits, the change bits are
cleared, and a port without power is switched on again. A port whose
device fails to enumerate gets three more tries. A disabled root port
starts the enumeration over. Channel errors are counted by kind and
written with the port events to /tmp/dwc2d-usbstats after every rescan;
/tmp/dwc2d-step names the hotplug step dwc2d is in.

dwc2d no longer calls sleep: a nanosleep sometimes never returned (50 us
sleeps hung dwc2d in QEMU; on the Pi it stopped right after a hub drop,
test 168). delay() yields until the time has passed.
---
 drivers/usb/dwc2d/src/dwc2.rs      |  43 +++++++++
 drivers/usb/dwc2d/src/enumerate.rs | 101 +++++++++++++++++++--
 drivers/usb/dwc2d/src/main.rs      |   5 ++
 drivers/usb/dwc2d/src/usbdiag.rs   | 135 +++++++++++++++++++++++++++++
 4 files changed, 277 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/dwc2d/src/dwc2.rs b/drivers/usb/dwc2d/src/dwc2.rs
index 4e26ae53..df80181c 100644
--- a/drivers/usb/dwc2d/src/dwc2.rs
+++ b/drivers/usb/dwc2d/src/dwc2.rs
@@ -208,6 +208,42 @@ impl Dwc2 {
         }
     }
 
+    /// Device address and endpoint of a channel's last transfer.
+    fn channel_target(&self, ch: usize) -> (u8, u8) {
+        let value = self.read(hcchar(ch));
+        (((value >> HCCHAR_DEVADDR_SHIFT) & 0x7F) as u8, ((value >> 11) & 0xF) as u8)
+    }
+
+    fn note_error(&self, ch: usize, status: u32) {
+        let (address, endpoint) = self.channel_target(ch);
+        crate::usbdiag::channel_error(status, address, endpoint);
+    }
+
+    fn note_timeout(&self, ch: usize) {
+        let (address, endpoint) = self.channel_target(ch);
+        crate::usbdiag::timeout(address, endpoint);
+    }
+
+    /// HPRT0, after clearing its change bits (connect, enable and over
+    /// current changes); the returned value still has them.
+    pub fn root_port_events(&self) -> u32 {
+        let value = self.read(HPRT0);
+        let changes = value & (HPRT0_CONN_DET | HPRT0_ENA_CHG | HPRT0_OVR_CURR_CHG);
+        if changes != 0 {
+            // Writing 1 to the enable bit would disable the port: keep it 0.
+            self.write(HPRT0, (value & !HPRT0_W1C) | changes);
+        }
+        value
+    }
+
+    pub fn root_port_status(&self) -> u32 {
+        self.read(HPRT0)
+    }
+
+    pub fn gintsts(&self) -> u32 {
+        self.read(GINTSTS)
+    }
+
     /// Whether a device is connected to the root port.
     pub fn root_connected(&self) -> bool {
         self.read(HPRT0) & HPRT0_CONN_STS != 0
@@ -301,11 +337,15 @@ impl Dwc2 {
             let status = self.read(hcint(ch));
             if status & HCINT_CH_HLTD != 0 {
                 self.write(hcint(ch), u32::MAX);
+                if status & (HCINT_STALL | HCINT_AHB_ERR | HCINT_XACT_ERR | HCINT_BBL_ERR | HCINT_DATA_TGL_ERR) != 0 {
+                    self.note_error(ch, status);
+                }
                 return Ok(status);
             }
             if start.elapsed() > timeout {
                 let value = self.read(hcchar(ch));
                 self.write(hcchar(ch), value | HCCHAR_CHDIS);
+                self.note_timeout(ch);
                 return Err(Error::Timeout("channel halt"));
             }
             std::hint::spin_loop();
@@ -448,11 +488,13 @@ impl Dwc2 {
         self.write(hcint(ch), u32::MAX);
 
         if status & HCINT_STALL != 0 {
+            self.note_error(ch, status);
             return Some(Err(Error::Stall));
         }
         if status & HCINT_XFER_COMPL == 0
             || status & (HCINT_AHB_ERR | HCINT_XACT_ERR | HCINT_BBL_ERR | HCINT_DATA_TGL_ERR) != 0
         {
+            self.note_error(ch, status);
             return Some(Err(Error::Transfer(status)));
         }
         let hctsiz_value = self.read(hctsiz(ch));
@@ -474,6 +516,7 @@ impl Dwc2 {
                 // Halt the channel so it can be reused.
                 let value = self.read(hcchar(ch));
                 self.write(hcchar(ch), value | HCCHAR_CHDIS);
+                self.note_timeout(ch);
                 return Err(Error::Timeout("channel halt"));
             }
             std::hint::spin_loop();
diff --git a/drivers/usb/dwc2d/src/enumerate.rs b/drivers/usb/dwc2d/src/enumerate.rs
index 5574e170..495f0848 100644
--- a/drivers/usb/dwc2d/src/enumerate.rs
+++ b/drivers/usb/dwc2d/src/enumerate.rs
@@ -7,6 +7,8 @@ use std::time::{Duration, Instant};
 use common::dma::Dma;
 
 use crate::dwc2::{delay, Dwc2, Error, Speed};
+use crate::regs::{HPRT0_CONN_DET, HPRT0_CONN_STS, HPRT0_ENA, HPRT0_ENA_CHG, HPRT0_OVR_CURR_CHG};
+use crate::usbdiag;
 
 const CLASS_HUB: u8 = 0x09;
 
@@ -26,16 +28,39 @@ const DESC_HUB: u8 = 0x29;
 const PORT_RESET: u16 = 4;
 const PORT_POWER: u16 = 8;
 const C_PORT_CONNECTION: u16 = 16;
+const C_PORT_ENABLE: u16 = 17;
+const C_PORT_SUSPEND: u16 = 18;
+const C_PORT_OVER_CURRENT: u16 = 19;
 const C_PORT_RESET: u16 = 20;
 const PORT_STAT_CONNECTION: u16 = 1 << 0;
 const PORT_STAT_ENABLE: u16 = 1 << 1;
+const PORT_STAT_OVER_CURRENT: u16 = 1 << 3;
 const PORT_STAT_RESET: u16 = 1 << 4;
+const PORT_STAT_POWER: u16 = 1 << 8;
 const PORT_STAT_LOW_SPEED: u16 = 1 << 9;
 const PORT_STAT_HIGH_SPEED: u16 = 1 << 10;
 
 /// Hubs nest at most five deep below the root (USB 2.0, 4.1.1).
 const MAX_HUB_DEPTH: usize = 5;
 
+/// How often a port whose device failed to enumerate is tried again before
+/// it waits for a new plug-in: after a hub drop the device may need a
+/// moment (#151).
+const ATTACH_RETRIES: u8 = 3;
+
+/// A hub port's status and change bits, with names, for the log.
+fn describe(status: u16, change: u16) -> String {
+    let names = |bits: u16, names: &[(u16, &str)]| {
+        let v: Vec<&str> = names.iter().filter(|(b, _)| bits & b != 0).map(|(_, n)| *n).collect();
+        if v.is_empty() { "none".to_string() } else { v.join(" ") }
+    };
+    format!(
+        "status {status:#06x} ({}) change {change:#06x} ({})",
+        names(status, &[(1, "connected"), (2, "enabled"), (4, "suspended"), (8, "over-current"), (16, "reset"), (256, "power")]),
+        names(change, &[(1, "connection"), (2, "enable"), (4, "suspend"), (8, "over-current"), (16, "reset")]),
+    )
+}
+
