--- /dev/null
+++ b/drivers/usb/dwc2d/src/usbdiag.rs
@@ -0,0 +1,135 @@
+//! USB diagnosis for #151 (experiment `usb-hub-drop`): channel errors by
+//! kind, hub and root port events, and the step the hotplug code is in. On
+//! the Pi the USB hub with the network chip dropped off during a download
+//! into the SD card (test 168), and dwc2d stopped right after. These files
+//! say what the controller saw first and where dwc2d was:
+//!
+//! - `/tmp/dwc2d-usbstats`, written after every rescan (once a second);
+//! - `/tmp/dwc2d-step`, written as the hotplug code goes, so it names the
+//!   step dwc2d is stuck in if it stops.
+
+use std::fmt::Write;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+use crate::regs::*;
+
+pub static XACT_ERRORS: AtomicU64 = AtomicU64::new(0);
+pub static BABBLES: AtomicU64 = AtomicU64::new(0);
+pub static STALLS: AtomicU64 = AtomicU64::new(0);
+pub static TOGGLE_ERRORS: AtomicU64 = AtomicU64::new(0);
+pub static AHB_ERRORS: AtomicU64 = AtomicU64::new(0);
+pub static TIMEOUTS: AtomicU64 = AtomicU64::new(0);
+/// Last channel error: HCINT bits, device address << 32, endpoint << 40.
+static LAST_ERROR: AtomicU64 = AtomicU64::new(0);
+static LAST_ERROR_MS: AtomicU64 = AtomicU64::new(0);
+pub static PORT_EVENTS: AtomicU64 = AtomicU64::new(0);
+/// Last hub port event: change << 16 | status, hub << 32, port << 40.
+static LAST_PORT_EVENT: AtomicU64 = AtomicU64::new(0);
+static LAST_PORT_MS: AtomicU64 = AtomicU64::new(0);
+pub static ROOT_EVENTS: AtomicU64 = AtomicU64::new(0);
+static LAST_HPRT0: AtomicU64 = AtomicU64::new(0);
+pub static RECOVERIES: AtomicU64 = AtomicU64::new(0);
+
+static START: OnceLock<Instant> = OnceLock::new();
+
+pub fn now_ms() -> u64 {
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+
+/// A channel halted with an error, or a stall (HCINT bits).
+pub fn channel_error(status: u32, address: u8, endpoint: u8) {
+    for (bit, counter) in [
+        (HCINT_XACT_ERR, &XACT_ERRORS),
+        (HCINT_BBL_ERR, &BABBLES),
+        (HCINT_STALL, &STALLS),
+        (HCINT_DATA_TGL_ERR, &TOGGLE_ERRORS),
+        (HCINT_AHB_ERR, &AHB_ERRORS),
+    ] {
+        if status & bit != 0 {
+            counter.fetch_add(1, Relaxed);
+        }
+    }
+    LAST_ERROR.store(u64::from(status) | u64::from(address) << 32 | u64::from(endpoint) << 40, Relaxed);
+    LAST_ERROR_MS.store(now_ms(), Relaxed);
+}
+
+/// A channel did not halt in time.
+pub fn timeout(address: u8, endpoint: u8) {
+    TIMEOUTS.fetch_add(1, Relaxed);
+    LAST_ERROR.store(1 << 31 | u64::from(address) << 32 | u64::from(endpoint) << 40, Relaxed);
+    LAST_ERROR_MS.store(now_ms(), Relaxed);
+}
+
+/// A hub port reported a change.
+pub fn port_event(hub: u8, port: u16, status: u16, change: u16) {
+    PORT_EVENTS.fetch_add(1, Relaxed);
+    LAST_PORT_EVENT.store(
+        u64::from(status) | u64::from(change) << 16 | u64::from(hub) << 32 | u64::from(port) << 40,
+        Relaxed,
+    );
+    LAST_PORT_MS.store(now_ms(), Relaxed);
+}
+
+/// The root port reported a change (HPRT0).
+pub fn root_event(hprt0: u32) {
+    ROOT_EVENTS.fetch_add(1, Relaxed);
+    LAST_HPRT0.store(u64::from(hprt0), Relaxed);
+}
+
+/// The errors so far in one line, for the serial log when a device drops.
+pub fn summary() -> String {
+    let last = LAST_ERROR.load(Relaxed);
+    format!(
+        "xact {} babble {} stall {} toggle {} ahb {} timeouts {}, last {:#x} at address {} endpoint {}, {} ms ago",
+        XACT_ERRORS.load(Relaxed),
+        BABBLES.load(Relaxed),
+        STALLS.load(Relaxed),
+        TOGGLE_ERRORS.load(Relaxed),
+        AHB_ERRORS.load(Relaxed),
+        TIMEOUTS.load(Relaxed),
+        last & 0xFFFF_FFFF,
+        (last >> 32) & 0xFF,
+        (last >> 40) & 0xFF,
+        now_ms().saturating_sub(LAST_ERROR_MS.load(Relaxed)),
+    )
+}
+
+/// Note the step the hotplug code is in. Errors are ignored: the file is
+/// only for diagnosis.
+pub fn step(what: &str) {
+    let _ = std::fs::write("/tmp/dwc2d-step", format!("{} {what}\n", now_ms()));
+}
+
+/// Write the counters, one `name value` per line.
+pub fn write(hprt0: u32, gintsts: u32) {
+    let mut s = String::new();
+    let _ = writeln!(s, "uptime_ms {}", now_ms());
+    for (name, value) in [
+        ("xact_errors", &XACT_ERRORS),
+        ("babbles", &BABBLES),
+        ("stalls", &STALLS),
+        ("toggle_errors", &TOGGLE_ERRORS),
+        ("ahb_errors", &AHB_ERRORS),
+        ("timeouts", &TIMEOUTS),
+        ("last_error", &LAST_ERROR),
+        ("last_error_ms", &LAST_ERROR_MS),
+        ("port_events", &PORT_EVENTS),
+        ("last_port_event", &LAST_PORT_EVENT),
+        ("last_port_ms", &LAST_PORT_MS),
+        ("root_events", &ROOT_EVENTS),
+        ("last_hprt0", &LAST_HPRT0),
+        ("recoveries", &RECOVERIES),
+    ] {
+        let value = value.load(Relaxed);
+        if name.starts_with("last_") && !name.ends_with("_ms") {
+            let _ = writeln!(s, "{name} {value:#x}");
+        } else {
+            let _ = writeln!(s, "{name} {value}");
+        }
+    }
+    let _ = writeln!(s, "hprt0 {hprt0:#x}");
+    let _ = writeln!(s, "gintsts {gintsts:#x}");
+    let _ = std::fs::write("/tmp/dwc2d-usbstats", s);
+}
