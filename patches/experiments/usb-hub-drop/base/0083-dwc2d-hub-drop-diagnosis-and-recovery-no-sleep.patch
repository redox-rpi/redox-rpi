+/// Wait for `d` by giving the CPU away until the time has passed, instead of
+/// `sleep`. A `nanosleep` in dwc2d sometimes never returned: 50 µs sleeps
+/// hung it in QEMU, and on the Pi it stopped for good right after a hub
+/// dropped off (test 168, #151), where the hotplug code sleeps before it
+/// resets the port again.
+pub fn delay(d: Duration) {
+    let start = Instant::now();
+    while start.elapsed() < d {
+        std::thread::yield_now();
+    }
+}
