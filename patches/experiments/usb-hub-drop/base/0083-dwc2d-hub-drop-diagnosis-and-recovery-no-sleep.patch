         let before: Vec<u8> = self.devices.iter().map(|d| d.address).collect();
 
-        let root = self.hc.root_connected();
-        let root_device = self.devices.iter().any(|d| d.parent.is_none());
+        let hprt0 = self.hc.root_port_events();
+        let root = hprt0 & HPRT0_CONN_STS != 0;
+        let mut root_device = self.devices.iter().any(|d| d.parent.is_none());
+        if hprt0 & (HPRT0_CONN_DET | HPRT0_ENA_CHG | HPRT0_OVR_CURR_CHG) != 0 {
+            usbdiag::root_event(hprt0);
+            println!("dwc2d: root port: HPRT0 {hprt0:#x}");
+        }
+        // The controller disables the root port on a babble or another port
+        // error; everything behind it is gone then, although still
+        // connected. Start over with a port reset.
+        if root && root_device && hprt0 & HPRT0_ENA == 0 {
+            println!("dwc2d: root port disabled (HPRT0 {hprt0:#x}), errors so far: {}", usbdiag::summary());
+            println!("dwc2d: enumerating the root port again");
+            usbdiag::RECOVERIES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            changes.removed.extend(before.iter().copied());
+            for address in before.iter().copied() {
+                self.hc.halt_device(address);
+            }
+            self.devices.clear();
+            self.hubs.clear();
+            self.tts.clear();
+            self.failed.clear();
+            root_device = false;
+        }
         if !root && (root_device || self.failed.contains(&None)) {
             println!("dwc2d: device on root port removed");
             for address in before.iter().copied() {
@@ -522,29 +573,65 @@ impl Bus {
     }
 
     fn scan_port(&mut self, hub: Hub, port: u16, removed: &mut Vec<u8>) -> Result<(), Error> {
-        let (status, change) = self.port_status(hub.address, hub.max_packet, hub.speed, port)?;
+        let (a, mp, sp) = (hub.address, hub.max_packet, hub.speed);
+        let (status, change) = self.port_status(a, mp, sp, port)?;
         let connected = status & PORT_STAT_CONNECTION != 0;
         let changed = change & 1 != 0;
-        let slot = Some((hub.address, port));
+        let slot = Some((a, port));
         let present = self.devices.iter().find(|d| d.parent == slot).map(|d| d.address);
         let failed = self.failed.contains(&slot);
+        if change != 0 {
+            usbdiag::port_event(a, port, status, change);
+        }
+        // The hub disables a port after a babble or an error on it, and on
+        // over current: its device is gone although still connected.
+        let disabled = present.is_some() && connected && status & PORT_STAT_ENABLE == 0;
 
         // Gone, or unplugged and plugged in again between two scans.
-        if (present.is_some() || failed) && (!connected || changed) {
+        if (present.is_some() || failed) && (!connected || changed || disabled) {
             if let Some(address) = present {
-                println!("dwc2d: hub {} port {port}: device at address {address} removed", hub.address);
+                println!("dwc2d: hub {a} port {port}: device at address {address} removed, {}", describe(status, change));
+                println!("dwc2d: hub {a} port {port}: errors so far: {}", usbdiag::summary());
                 self.remove(address, removed);
             }
             self.failed.remove(&slot);
+            self.retries.remove(&slot);
+        } else if change & !1 != 0 {
+            println!("dwc2d: hub {a} port {port}: {}", describe(status, change));
         }
         if changed && !connected {
-            self.request(hub.address, hub.max_packet, hub.speed, 0x23, REQ_CLEAR_FEATURE, C_PORT_CONNECTION, port, 0)?;
+            self.request(a, mp, sp, 0x23, REQ_CLEAR_FEATURE, C_PORT_CONNECTION, port, 0)?;
+        }
+        for (bit, feature) in [(2, C_PORT_ENABLE), (4, C_PORT_SUSPEND), (8, C_PORT_OVER_CURRENT)] {
+            if change & bit != 0 {
+                self.request(a, mp, sp, 0x23, REQ_CLEAR_FEATURE, feature, port, 0)?;
+            }
+        }
+        // A hub switches a port off on over current; switch it on again,
+        // the next scan finds its device.
+        if status & PORT_STAT_POWER == 0 && status & PORT_STAT_OVER_CURRENT == 0 {
+            println!("dwc2d: hub {a} port {port}: no power, switching it on again");
+            usbdiag::RECOVERIES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            self.request(a, mp, sp, 0x23, REQ_SET_FEATURE, PORT_POWER, port, 0)?;
+            return Ok(());
+        }
+        // A device that failed right after a drop gets a few more tries.
+        if connected && self.failed.contains(&slot) {
+            let left = self.retries.entry(slot).or_insert(ATTACH_RETRIES);
+            if *left > 0 {
+                *left -= 1;
+                println!("dwc2d: hub {a} port {port}: trying again ({} left)", *left);
+                self.failed.remove(&slot);
+            }
         }
         let present = self.devices.iter().any(|d| d.parent == slot);
         if connected && !present && !self.failed.contains(&slot) {
             // Debounce, as required by the USB specification.
             delay(Duration::from_millis(100));
             self.attach(hub, port)?;
+            if self.devices.iter().any(|d| d.parent == slot) {
+                self.retries.remove(&slot);
+            }
         }
         Ok(())
     }
