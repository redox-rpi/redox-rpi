+/// Configure the stick or reader and set up each LUN that has a medium.
+/// Waits up to a few seconds for a stick that is not ready yet after it
+/// was plugged in; an empty slot is left out at once.
+pub fn open(bus: &mut Bus, hc: Dwc2, f: StorageFunction) -> Result<Vec<Lun>, Error> {
+    bus.request(f.address, f.max_packet0, f.speed, 0x00, REQ_SET_CONFIGURATION, u16::from(f.configuration), 0, 0)?;
+    let mut bot = Bot {
+        hc,
+        f,
+        tag: 1,
+        in_pid: PID_DATA0,
+        out_pid: PID_DATA0,
+        cbw: Dma::new([0; CBW_LEN]).expect("dwc2d: DMA allocation failed"),
+        csw: Dma::new([0; CSW_LEN]).expect("dwc2d: DMA allocation failed"),
+        data: Dma::new([0; MAX_TRANSFER]).expect("dwc2d: DMA allocation failed"),
+        setup: Dma::new([0; 8]).expect("dwc2d: DMA allocation failed"),
+        control: Dma::new([0; 512]).expect("dwc2d: DMA allocation failed"),
+    };
+    let max_lun = bot.max_lun();
+    let bot = Rc::new(RefCell::new(bot));
+    let mut luns = Vec::new();
+    for lun in 0..=max_lun {
+        match Lun::new(bot.clone(), lun) {
+            Ok(l) => luns.push(l),
+            // A reader with one slot and no card has no disk; the reader
+            // itself is fine.
+            Err(err) if max_lun > 0 || matches!(err, Error::Timeout("no medium" | "no such LUN")) => {
+                println!("dwc2d: mass storage at address {} LUN {lun}: {err:?}", bot.borrow().f.address)
+            }
+            Err(err) => return Err(err),
+        }
+    }
+    Ok(luns)
