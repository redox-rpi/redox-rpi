diff --git a/drivers/net/bcm2835-sdiod/src/bus.rs b/drivers/net/bcm2835-sdiod/src/bus.rs
new file mode 100644
index 0000000..83746ea
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/bus.rs
@@ -0,0 +1,95 @@
+//! The chip's backplane seen through SDIO function 1.
+//!
+//! Function 1 shows a 32 KiB window of the 32-bit backplane address space;
+//! three registers pick the window. Offsets inside it with bit 15 set make
+//! 32-bit accesses, which core registers need. Memory transfers go in 64-byte
+//! blocks (function 1's block size) and never cross a window.
+
+use crate::host::{Data, Host};
+
+const SBSDIO_FUNC1_SBADDRLOW: u32 = 0x1000a;
+const SBSDIO_FUNC1_SBADDRMID: u32 = 0x1000b;
+const SBSDIO_FUNC1_SBADDRHIGH: u32 = 0x1000c;
+const SB_OFT_ADDR_MASK: u32 = 0x7fff;
+const SB_ACCESS_2_4B_FLAG: u32 = 0x8000;
+const WINDOW: u32 = 0x8000;
+
+/// Function 1 block size.
+pub const F1_BLOCK: u32 = 64;
+/// At most this much per CMD53 (the block count has 9 bits).
+const MAX_BLOCKS: u32 = 256;
+
+pub struct Bus {
+    pub host: Host,
+    window: Option<u32>,
+}
+
+impl Bus {
+    pub fn new(host: Host) -> Self {
+        Bus { host, window: None }
+    }
+
+    fn set_window(&mut self, addr: u32) -> Result<(), String> {
+        let base = addr & !SB_OFT_ADDR_MASK;
+        if self.window == Some(base) {
+            return Ok(());
+        }
+        self.window = None;
+        self.host.write_byte(1, SBSDIO_FUNC1_SBADDRLOW, (base >> 8) as u8 & 0x80)?;
+        self.host.write_byte(1, SBSDIO_FUNC1_SBADDRMID, (base >> 16) as u8)?;
+        self.host.write_byte(1, SBSDIO_FUNC1_SBADDRHIGH, (base >> 24) as u8)?;
+        self.window = Some(base);
+        Ok(())
+    }
+
+    pub fn read32(&mut self, addr: u32) -> Result<u32, String> {
+        let mut b = [0u8; 4];
+        self.read_mem(addr, &mut b)?;
+        Ok(u32::from_le_bytes(b))
+    }
+
+    pub fn write32(&mut self, addr: u32, value: u32) -> Result<(), String> {
+        self.write_mem(addr, &value.to_le_bytes())
+    }
+
+    pub fn read_mem(&mut self, addr: u32, buf: &mut [u8]) -> Result<(), String> {
+        self.transfer(addr, buf.len(), |host, offset, range, block| {
+            host.cmd53(1, offset, Data::Read(&mut buf[range]), block)
+        })
+    }
+
+    pub fn write_mem(&mut self, addr: u32, data: &[u8]) -> Result<(), String> {
+        self.transfer(addr, data.len(), |host, offset, range, block| {
+            host.cmd53(1, offset, Data::Write(&data[range]), block)
+        })
+    }
+
+    /// Splits `len` bytes at `addr` (both multiples of 4) into CMD53s that
+    /// stay inside one window: block mode for whole blocks, byte mode for
+    /// the rest.
+    fn transfer(
+        &mut self,
+        addr: u32,
+        len: usize,
+        mut op: impl FnMut(&mut Host, u32, std::ops::Range<usize>, Option<u32>) -> Result<(), String>,
+    ) -> Result<(), String> {
+        assert!(addr % 4 == 0 && len % 4 == 0);
+        let mut done = 0usize;
+        while done < len {
+            let at = addr + done as u32;
+            self.set_window(at)?;
+            let in_window = (WINDOW - (at & SB_OFT_ADDR_MASK)) as usize;
+            let left = (len - done).min(in_window);
+            let offset = at & SB_OFT_ADDR_MASK | SB_ACCESS_2_4B_FLAG;
+            let blocks = (left as u32 / F1_BLOCK).min(MAX_BLOCKS);
+            let (n, block) = if blocks > 0 {
+                ((blocks * F1_BLOCK) as usize, Some(F1_BLOCK))
+            } else {
+                (left, None)
+            };
+            op(&mut self.host, offset, done..done + n, block)?;
+            done += n;
+        }
+        Ok(())
+    }
+}
diff --git a/drivers/net/bcm2835-sdiod/src/chip.rs b/drivers/net/bcm2835-sdiod/src/chip.rs
new file mode 100644
index 0000000..bf2d8fd
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/chip.rs
@@ -0,0 +1,165 @@
+//! Cores on the chip's backplane: finding them, resetting them, and the
+//! RAM of the ARM Cortex-R4 that runs the firmware.
+
+use std::thread;
+use std::time::Duration;
+
+use crate::bus::Bus;
+use crate::erom::{self, Core, CORE_80211, CORE_ARM_CR4, CORE_CHIPCOMMON, CORE_SDIO_DEV};
+use crate::host::wait_until;
+
+const CHIPCOMMON_BASE: u32 = 0x1800_0000;
+/// ChipCommon register with the address of the enumeration ROM.
+const CC_EROMPTR: u32 = 0xfc;
+
+// Wrapper registers (AI backplane).
+const AI_IOCTL: u32 = 0x408;
+const AI_RESETCTRL: u32 = 0x800;
+const IOCTL_CLK: u32 = 0x1;
+const IOCTL_FGC: u32 = 0x2;
+const RESETCTRL_RESET: u32 = 0x1;
+
+/// ARM CR4 wrapper IOCTL: hold the CPU.
+const ARMCR4_IOCTL_CPUHALT: u32 = 0x20;
+// ARM CR4 core registers: bank count and per-bank size.
+const ARMCR4_CAP: u32 = 0x04;
+const ARMCR4_BANKIDX: u32 = 0x40;
+const ARMCR4_BANKINFO: u32 = 0x44;
+const ARMCR4_BSZ_MASK: u32 = 0x7f;
+const ARMCR4_BLK_1K: u32 = 0x200;
+
+// 802.11 core wrapper IOCTL.
+const D11_IOCTL_PHYCLOCKEN: u32 = 0x4;
+const D11_IOCTL_PHYRESET: u32 = 0x8;
+
+pub struct Chip {
+    pub cr4: Core,
+    pub d11: Core,
+    pub sdio: Core,
+    /// Backplane address and size of the firmware's RAM.
+    pub rambase: u32,
+    pub ramsize: u32,
+}
+
+impl Chip {
+    /// Reads the enumeration ROM and the RAM size.
+    pub fn attach(bus: &mut Bus, chipid: u32) -> Result<Chip, String> {
+        let erom_addr = bus.read32(CHIPCOMMON_BASE + CC_EROMPTR)?;
+        let mut words = Vec::new();
+        for i in 0..1024 {
+            let w = bus.read32(erom_addr + 4 * i)?;
+            words.push(w);
+            if w & 0xf == 0xf {
+                break;
+            }
+        }
+        let cores = erom::parse(&words);
+        for c in &cores {
+            println!(
+                "bcm2835-sdiod: core 0x{:03x} rev {} at 0x{:08x}, wrapper 0x{:08x}",
+                c.id, c.rev, c.base, c.wrap
+            );
+        }
+        let find = |id: u16| {
+            cores
+                .iter()
+                .copied()
+                .find(|c| c.id == id)
+                .ok_or(format!("no core 0x{id:03x} in the EROM at 0x{erom_addr:08x}"))
+        };
+        find(CORE_CHIPCOMMON)?;
+        let (cr4, d11, sdio) = (find(CORE_ARM_CR4)?, find(CORE_80211)?, find(CORE_SDIO_DEV)?);
+        let id = chipid as u16;
+        // Where the CR4's RAM starts on the backplane depends on the chip.
+        let rambase = match id {
+            0x4345 => 0x0019_8000,
+            _ => return Err(format!("RAM base of chip 0x{id:04x} unknown")),
+        };
+        let ramsize = cr4_ramsize(bus, &cr4)?;
+        println!("bcm2835-sdiod: RAM 0x{rambase:08x}, {} KiB", ramsize / 1024);
+        Ok(Chip {
+            cr4,
+            d11,
+            sdio,
+            rambase,
+            ramsize,
+        })
+    }
+
+    /// Holds the ARM and resets the 802.11 core, for a firmware download.
+    pub fn set_passive(&self, bus: &mut Bus) -> Result<(), String> {
+        let halted = bus.read32(self.cr4.wrap + AI_IOCTL)? & ARMCR4_IOCTL_CPUHALT;
+        core_reset(bus, &self.cr4, halted, ARMCR4_IOCTL_CPUHALT, ARMCR4_IOCTL_CPUHALT)?;
+        core_reset(
+            bus,
+            &self.d11,
+            D11_IOCTL_PHYRESET | D11_IOCTL_PHYCLOCKEN,
+            D11_IOCTL_PHYCLOCKEN,
+            D11_IOCTL_PHYCLOCKEN,
+        )
+    }
+
+    /// Writes the reset vector to address 0 and lets the ARM run.
+    pub fn set_active(&self, bus: &mut Bus, reset_vector: u32) -> Result<(), String> {
+        bus.write32(0, reset_vector)?;
+        core_reset(bus, &self.cr4, ARMCR4_IOCTL_CPUHALT, 0, 0)
+    }
+}
+
+fn cr4_ramsize(bus: &mut Bus, cr4: &Core) -> Result<u32, String> {
+    let cap = bus.read32(cr4.base + ARMCR4_CAP)?;
+    let banks = (cap & 0xf) + (cap >> 4 & 0xf);
+    let mut size = 0;
+    for idx in 0..banks {
+        bus.write32(cr4.base + ARMCR4_BANKIDX, idx)?;
+        let info = bus.read32(cr4.base + ARMCR4_BANKINFO)?;
+        let unit = if info & ARMCR4_BLK_1K != 0 { 1024 } else { 8192 };
+        size += ((info & ARMCR4_BSZ_MASK) + 1) * unit;
+    }
+    if size == 0 {
+        return Err(format!("ARM CR4 reports no RAM (cap 0x{cap:08x})"));
+    }
+    Ok(size)
+}
+
+/// Puts a core into reset with clocks forced on; `prereset` and `reset`
+/// are core-specific IOCTL bits before and during the reset.
+fn core_disable(bus: &mut Bus, core: &Core, prereset: u32, reset: u32) -> Result<(), String> {
+    if bus.read32(core.wrap + AI_RESETCTRL)? & RESETCTRL_RESET == 0 {
+        bus.write32(core.wrap + AI_IOCTL, prereset | IOCTL_FGC | IOCTL_CLK)?;
+        bus.read32(core.wrap + AI_IOCTL)?;
+        bus.write32(core.wrap + AI_RESETCTRL, RESETCTRL_RESET)?;
+        thread::sleep(Duration::from_micros(20));
+        let mut ctl = 0;
+        if !wait_until(Duration::from_millis(10), || {
+            ctl = bus.read32(core.wrap + AI_RESETCTRL).unwrap_or(0);
+            ctl & RESETCTRL_RESET != 0
+        }) {
+            return Err(format!("core 0x{:03x} does not enter reset", core.id));
+        }
+    }
+    bus.write32(core.wrap + AI_IOCTL, reset | IOCTL_FGC | IOCTL_CLK)?;
+    bus.read32(core.wrap + AI_IOCTL)?;
+    Ok(())
+}
+
+/// Resets a core and takes it out of reset with its clock on;
+/// `postreset` are the IOCTL bits afterwards.
+fn core_reset(bus: &mut Bus, core: &Core, prereset: u32, reset: u32, postreset: u32) -> Result<(), String> {
+    core_disable(bus, core, prereset, reset)?;
+    let mut ctl = RESETCTRL_RESET;
+    for _ in 0..50 {
+        bus.write32(core.wrap + AI_RESETCTRL, 0)?;
+        ctl = bus.read32(core.wrap + AI_RESETCTRL)?;
+        if ctl & RESETCTRL_RESET == 0 {
+            break;
+        }
+        thread::sleep(Duration::from_micros(40));
+    }
+    if ctl & RESETCTRL_RESET != 0 {
+        return Err(format!("core 0x{:03x} stays in reset", core.id));
+    }
+    bus.write32(core.wrap + AI_IOCTL, postreset | IOCTL_CLK)?;
+    bus.read32(core.wrap + AI_IOCTL)?;
+    Ok(())
+}
diff --git a/drivers/net/bcm2835-sdiod/src/erom.rs b/drivers/net/bcm2835-sdiod/src/erom.rs
new file mode 100644
index 0000000..0d11227
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/erom.rs
@@ -0,0 +1,152 @@
+//! The enumeration ROM of a Broadcom AI ("AXI") backplane: the list of
+//! cores, with the address of each core's registers and of its wrapper
+//! (reset and clock control).
+//!
+//! Each core starts with two component descriptors (designer, part number,
+//! class; revision and the number of ports and wrappers), followed by
+//! master port descriptors and address descriptors. The table ends with an
+//! end-of-table entry. Layout as documented in OpenBSD's bwfm(4) and
+//! Linux' brcmfmac (both ISC).
+
+const DESC_TYPE_MASK: u32 = 0xf;
+const DESC_COMPONENT: u32 = 0x1;
+const DESC_ADDRESS: u32 = 0x5;
+const DESC_ADDRSIZE_GT32: u32 = 0x8;
+const DESC_EOT: u32 = 0xf;
+
+const SLAVE_TYPE_SLAVE: u32 = 0;
+const SLAVE_TYPE_SWRAP: u32 = 2;
+const SLAVE_TYPE_MWRAP: u32 = 3;
+const SLAVE_SIZE_DESC: u32 = 3;
+
+pub const CORE_CHIPCOMMON: u16 = 0x800;
+pub const CORE_80211: u16 = 0x812;
+pub const CORE_SDIO_DEV: u16 = 0x829;
+pub const CORE_ARM_CR4: u16 = 0x83e;
+
+/// Broadcom's designer code. ARM's (0x43b) entries are bus components.
+const DESIGNER_BROADCOM: u32 = 0x4bf;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Core {
+    pub id: u16,
+    pub rev: u8,
+    /// Backplane address of the core's registers.
+    pub base: u32,
+    /// Backplane address of its wrapper.
+    pub wrap: u32,
+}
+
+/// Parses the EROM entries (32-bit words, read from the chip until and
+/// including the end-of-table entry).
+pub fn parse(words: &[u32]) -> Vec<Core> {
+    let mut cores = Vec::new();
+    let mut i = 0;
+    let next = |i: &mut usize| -> Option<u32> {
+        let w = *words.get(*i)?;
+        *i += 1;
+        Some(w)
+    };
+    while let Some(a) = next(&mut i) {
+        match a & DESC_TYPE_MASK {
+            DESC_EOT => break,
+            DESC_COMPONENT => {}
+            _ => continue,
+        }
+        let Some(b) = next(&mut i) else { break };
+        if b & DESC_TYPE_MASK != DESC_COMPONENT {
+            continue;
+        }
+        let designer = a >> 20;
+        let id = (a >> 8 & 0xfff) as u16;
+        let rev = (b >> 24) as u8;
+        let master_wraps = b >> 14 & 0x1f;
+        let slave_wraps = b >> 19 & 0x1f;
+
+        let mut base = None;
+        let mut wrap = None;
+        // The descriptors of this core run until the next component.
+        while let Some(&d) = words.get(i) {
+            let kind = d & DESC_TYPE_MASK;
+            if kind == DESC_COMPONENT || kind == DESC_EOT {
+                break;
+            }
+            i += 1;
+            if kind != DESC_ADDRESS {
+                continue;
+            }
+            if d & DESC_ADDRSIZE_GT32 != 0 {
+                i += 1; // upper half of the address
+            }
+            if d >> 4 & 3 == SLAVE_SIZE_DESC {
+                let size = next(&mut i).unwrap_or(0);
+                if size & DESC_ADDRSIZE_GT32 != 0 {
+                    i += 1;
+                }
+            }
+            let addr = d & 0xffff_f000;
+            let port = d >> 8 & 0xf;
+            match d >> 6 & 3 {
+                SLAVE_TYPE_SLAVE if port == 0 && base.is_none() => base = Some(addr),
+                SLAVE_TYPE_MWRAP if master_wraps > 0 && wrap.is_none() => wrap = Some(addr),
+                SLAVE_TYPE_SWRAP if master_wraps == 0 && wrap.is_none() => wrap = Some(addr),
+                _ => {}
+            }
+        }
+        if designer != DESIGNER_BROADCOM || master_wraps + slave_wraps == 0 {
+            continue;
+        }
+        if let (Some(base), Some(wrap)) = (base, wrap) {
+            cores.push(Core { id, rev, base, wrap });
+        }
+    }
+    cores
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn comp_a(designer: u32, id: u32) -> u32 {
+        designer << 20 | id << 8 | DESC_COMPONENT
+    }
+    fn comp_b(rev: u32, mwraps: u32, swraps: u32) -> u32 {
+        rev << 24 | swraps << 19 | mwraps << 14 | DESC_COMPONENT
+    }
+    fn addr(a: u32, kind: u32, port: u32) -> u32 {
+        a | port << 8 | kind << 6 | DESC_ADDRESS
+    }
+
+    #[test]
+    fn two_cores_and_a_bridge() {
+        let words = [
+            // ChipCommon: one master port, slave at 0x18000000, master wrapper.
+            comp_a(DESIGNER_BROADCOM, 0x800),
+            comp_b(43, 1, 0),
+            0x0000_0103, // master port descriptor (type 3)
+            addr(0x1800_0000, SLAVE_TYPE_SLAVE, 0),
+            addr(0x1810_0000, SLAVE_TYPE_MWRAP, 0),
+            // A bus component of another designer: skipped.
+            comp_a(0x43b, 0x367),
+            comp_b(0, 0, 1),
+            addr(0x1810_9000, SLAVE_TYPE_SWRAP, 0),
+            // ARM CR4 with a sized second slave region and slave wrapper only.
+            comp_a(DESIGNER_BROADCOM, 0x83e),
+            comp_b(7, 0, 1),
+            addr(0x1800_2000, SLAVE_TYPE_SLAVE, 0),
+            addr(0x0000_0000, SLAVE_TYPE_SLAVE, 1) | SLAVE_SIZE_DESC << 4,
+            0x0000_8000, // size descriptor
+            addr(0x1810_2000, SLAVE_TYPE_SWRAP, 0),
+            DESC_EOT,
+            comp_a(DESIGNER_BROADCOM, 0x812), // after the end: ignored
+        ];
+        let cores = parse(&words);
+        assert_eq!(
+            cores,
+            [
+                Core { id: 0x800, rev: 43, base: 0x1800_0000, wrap: 0x1810_0000 },
+                Core { id: 0x83e, rev: 7, base: 0x1800_2000, wrap: 0x1810_2000 },
+            ]
+        );
+    }
+}
diff --git a/drivers/net/bcm2835-sdiod/src/host.rs b/drivers/net/bcm2835-sdiod/src/host.rs
index dd82689..70ce25a 100644
