+++ b/drivers/net/bcm2835-sdiod/src/host.rs
@@ -30,6 +30,8 @@ const CMD_RSPNS_48_BUSY: u32 = 3 << 16;
 const CMD_CRCCHK_EN: u32 = 1 << 19;
 const CMD_IXCHK_EN: u32 = 1 << 20;
 const TM_DAT_DIR_READ: u32 = 1 << 4;
+const TM_MULTI_BLOCK: u32 = 1 << 5;
+const TM_BLKCNT_EN: u32 = 1 << 1;
 
 const SR_DAT_INHIBIT: u32 = 1 << 1;
 const SR_CMD_INHIBIT: u32 = 1 << 0;
@@ -46,18 +48,34 @@ const C1_CLK_INTLEN: u32 = 1 << 0;
 
 const INT_CMD_DONE: u32 = 1 << 0;
 const INT_DATA_DONE: u32 = 1 << 1;
+const INT_WRITE_RDY: u32 = 1 << 4;
 const INT_READ_RDY: u32 = 1 << 5;
 const INT_ERROR: u32 = 1 << 15;
 const INT_CMD_TIMEOUT: u32 = 1 << 16;
 const INT_ERROR_MASK: u32 = 0x017f_8000;
 
+/// The data of a CMD53 transfer.
+pub enum Data<'a> {
+    Read(&'a mut [u8]),
+    Write(&'a [u8]),
+}
+
+impl Data<'_> {
+    fn len(&self) -> usize {
+        match self {
+            Data::Read(buf) => buf.len(),
+            Data::Write(buf) => buf.len(),
+        }
+    }
+}
+
 /// What went wrong with a command.
 #[derive(Debug)]
 pub enum CmdError {
     /// No response: no card, or the card does not know the command.
     Timeout,
     /// Error interrupt flags (CRC, end bit, index, data errors).
-    Flags(u32),
+    Flags(#[allow(dead_code)] u32), // shown through Debug
     /// The controller stayed busy.
     Busy,
 }
@@ -215,26 +233,69 @@ impl Host {
     /// `buf.len()` bytes (a multiple of 4, at most 512) of function `func`
     /// from `addr`.
     pub fn cmd53_read(&mut self, func: u32, addr: u32, buf: &mut [u8]) -> Result<(), String> {
-        let len = buf.len() as u32;
-        assert!(len > 0 && len <= 512 && len % 4 == 0);
+        self.cmd53(func, addr, Data::Read(buf), None)
+    }
+
+    /// CMD53 with incrementing address. Without `block`, byte mode: one
+    /// transfer of up to 512 bytes. With `block`, block mode: the length is
+    /// a multiple of the function's block size `block` (set in its FBR), at
+    /// most 511 blocks. Lengths are multiples of 4: the data port is 32 bits.
+    pub fn cmd53(&mut self, func: u32, addr: u32, mut data: Data, block: Option<u32>) -> Result<(), String> {
+        let len = data.len() as u32;
+        let what = |e: &dyn std::fmt::Debug| format!("CMD53 F{func} 0x{addr:05x} {len} bytes: {e:?}");
+        let (size, count) = match block {
+            None => {
+                assert!(len > 0 && len <= 512 && len % 4 == 0);
+                (len, 1)
+            }
+            Some(size) => {
+                assert!(len > 0 && len % size == 0 && len / size <= 511 && size % 4 == 0);
+                (size, len / size)
+            }
+        };
         if !wait_until(Duration::from_millis(100), || self.read(STATUS) & SR_DAT_INHIBIT == 0) {
             self.reset_lines();
-            return Err("CMD53: data lines busy".into());
+            return Err(what(&"data lines busy"));
         }
-        self.write(BLKSIZECNT, 1 << 16 | len);
-        // Byte count 512 is written as 0.
-        let arg = (func & 7) << 28 | 1 << 26 | (addr & 0x1_ffff) << 9 | (len & 0x1ff);
-        let r5 = self
-            .command(53, RSP_48_CHECKED | CMD_ISDATA | TM_DAT_DIR_READ, arg)
-            .map_err(|e| format!("CMD53 F{func} 0x{addr:05x}: {e:?}"))?;
-        check_r5(r5).map_err(|e| format!("CMD53 F{func} 0x{addr:05x}: {e}"))?;
-        self.wait_flag(INT_READ_RDY)
-            .map_err(|e| format!("CMD53 F{func} 0x{addr:05x}: no data: {e:?}"))?;
-        for chunk in buf.chunks_mut(4) {
-            chunk.copy_from_slice(&self.read(DATA).to_le_bytes());
+        self.write(BLKSIZECNT, count << 16 | size);
+        let write = matches!(data, Data::Write(_));
+        // Byte mode: count 512 is written as 0. Block mode: the block count.
+        let mut arg = (func & 7) << 28 | 1 << 26 | (addr & 0x1_ffff) << 9;
+        arg |= match block {
+            None => len & 0x1ff,
+            Some(_) => 1 << 27 | count,
+        };
+        if write {
+            arg |= 1 << 31;
+        }
+        let mut flags = RSP_48_CHECKED | CMD_ISDATA;
+        if !write {
+            flags |= TM_DAT_DIR_READ;
+        }
+        if count > 1 {
+            flags |= TM_MULTI_BLOCK | TM_BLKCNT_EN;
+        }
+        let r5 = self.command(53, flags, arg).map_err(|e| what(&e))?;
+        check_r5(r5).map_err(|e| what(&e))?;
+        for chunk in 0..count as usize {
+            let range = chunk * size as usize..(chunk + 1) * size as usize;
+            match &mut data {
+                Data::Read(buf) => {
+                    self.wait_flag(INT_READ_RDY).map_err(|e| what(&("no data", e)))?;
+                    for word in buf[range].chunks_mut(4) {
+                        word.copy_from_slice(&self.read(DATA).to_le_bytes());
+                    }
+                }
+                Data::Write(buf) => {
+                    self.wait_flag(INT_WRITE_RDY).map_err(|e| what(&("not ready for data", e)))?;
+                    for word in buf[range].chunks(4) {
+                        self.write(DATA, u32::from_le_bytes(word.try_into().unwrap()));
+                    }
+                }
+            }
         }
         self.wait_flag(INT_DATA_DONE)
-            .map_err(|e| format!("CMD53 F{func} 0x{addr:05x}: transfer did not end: {e:?}"))?;
+            .map_err(|e| what(&("transfer did not end", e)))?;
         Ok(())
     }
 }
