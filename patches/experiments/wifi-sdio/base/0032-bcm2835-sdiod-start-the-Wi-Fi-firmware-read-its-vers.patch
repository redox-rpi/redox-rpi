diff --git a/drivers/net/bcm2835-sdiod/src/nvram.rs b/drivers/net/bcm2835-sdiod/src/nvram.rs
new file mode 100644
index 0000000..66e12af
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/nvram.rs
@@ -0,0 +1,67 @@
+//! The board settings ("NVRAM") file, made ready for the chip.
+//!
+//! The file is text, one `key=value` per line with `#` comments. The chip
+//! wants the entries NUL-terminated one after another, an extra NUL, zeros
+//! to a multiple of 4 bytes, and a last 32-bit word with the length in words
+//! in the low half and its complement in the high half. The firmware finds
+//! the block by that word at the very end of its RAM.
+
+/// Converts the NVRAM text into the block the chip reads.
+pub fn prepare(text: &[u8]) -> Vec<u8> {
+    let mut out = Vec::new();
+    for line in text.split(|&b| b == b'\n') {
+        let line = trim(line);
+        if line.is_empty() || line[0] == b'#' || !line.contains(&b'=') {
+            continue;
+        }
+        out.extend_from_slice(line);
+        out.push(0);
+    }
+    out.push(0);
+    while out.len() % 4 != 0 {
+        out.push(0);
+    }
+    let words = (out.len() / 4) as u32;
+    out.extend_from_slice(&(!words << 16 | words & 0xffff).to_le_bytes());
+    out
+}
+
+fn trim(mut line: &[u8]) -> &[u8] {
+    while let [first, rest @ ..] = line {
+        if !first.is_ascii_whitespace() {
+            break;
+        }
+        line = rest;
+    }
+    while let [rest @ .., last] = line {
+        if !last.is_ascii_whitespace() {
+            break;
+        }
+        line = rest;
+    }
+    line
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn entries_padding_token() {
+        let text = b"# comment\r\nsromrev=11\r\n\n  boardtype=0x6e4  \nnoequals\n#macaddr=1\nxtalfreq=37400\n";
+        let out = prepare(text);
+        let body = b"sromrev=11\0boardtype=0x6e4\0xtalfreq=37400\0\0";
+        assert_eq!(&out[..body.len()], body);
+        // 44 bytes of entries are 11 words; padded already.
+        assert_eq!(out.len(), 44 + 4);
+        assert_eq!(&out[44..], &(0xfff4_000bu32).to_le_bytes());
+    }
+
+    #[test]
+    fn pads_to_words() {
+        let out = prepare(b"a=1\n");
+        // "a=1\0\0" is 5 bytes, padded to 8: 2 words.
+        assert_eq!(&out[..8], b"a=1\0\0\0\0\0");
+        assert_eq!(&out[8..], &(0xfffd_0002u32).to_le_bytes());
+    }
+}
diff --git a/drivers/net/bcm2835-sdiod/src/sdpcm.rs b/drivers/net/bcm2835-sdiod/src/sdpcm.rs
new file mode 100644
index 0000000..193b3f2
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/sdpcm.rs
@@ -0,0 +1,157 @@
+//! Frames on SDIO function 2: the SDPCM header and, on the control
+//! channel, the BCDC header of a firmware command ("dcmd").
+//!
+//! An SDPCM frame starts with a 4-byte hardware header (length and its
+//! complement) and an 8-byte software header: sequence number, channel,
+//! next length, data offset, flow control and the highest sequence number
+//! the firmware takes (its credit). Control frames carry a 16-byte BCDC
+//! header (command, length, flags with request ID, status) and the command
+//! data. Layout as in OpenBSD's bwfm(4) and Linux' brcmfmac (both ISC).
+
+pub const HEADER_LEN: usize = 12;
+pub const BCDC_LEN: usize = 16;
+
+pub const CHANNEL_CONTROL: u8 = 0;
+pub const CHANNEL_EVENT: u8 = 1;
+pub const CHANNEL_DATA: u8 = 2;
+
+const BCDC_FLAG_ERROR: u32 = 0x01;
+const BCDC_FLAG_SET: u32 = 0x02;
+
+/// Firmware commands.
+pub const WLC_GET_VAR: u32 = 262;
+
+/// A control frame for command `cmd` with request ID `id`. `data` goes out
+/// as is (for WLC_GET_VAR: the variable name, a NUL and room for the
+/// answer). The frame is padded to a multiple of 4 bytes.
+pub fn control_frame(seq: u8, id: u16, cmd: u32, set: bool, data: &[u8]) -> Vec<u8> {
+    let len = HEADER_LEN + BCDC_LEN + data.len();
+    let mut f = Vec::with_capacity(len + 3);
+    f.extend_from_slice(&(len as u16).to_le_bytes());
+    f.extend_from_slice(&(!(len as u16)).to_le_bytes());
+    f.extend_from_slice(&[seq, CHANNEL_CONTROL, 0, HEADER_LEN as u8, 0, 0, 0, 0]);
+    let flags = (id as u32) << 16 | if set { BCDC_FLAG_SET } else { 0 };
+    for word in [cmd, data.len() as u32, flags, 0] {
+        f.extend_from_slice(&word.to_le_bytes());
+    }
+    f.extend_from_slice(data);
+    while f.len() % 4 != 0 {
+        f.push(0);
+    }
+    f
+}
+
+/// The hardware header: the frame length, or `None` for no frame (0) or a
+/// broken header.
+pub fn frame_len(head: &[u8]) -> Option<usize> {
+    let len = u16::from_le_bytes([head[0], head[1]]);
+    let check = u16::from_le_bytes([head[2], head[3]]);
+    if len == 0 || len ^ check != 0xffff || (len as usize) < HEADER_LEN {
+        return None;
+    }
+    Some(len as usize)
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct Frame<'a> {
+    pub seq: u8,
+    pub channel: u8,
+    /// Highest sequence number the firmware takes now.
+    pub max_seq: u8,
+    pub payload: &'a [u8],
+}
+
+/// Splits a received frame (`frame_len` bytes) into header and payload.
+pub fn parse(frame: &[u8]) -> Result<Frame<'_>, String> {
+    let len = frame_len(frame).ok_or("bad frame header")?;
+    if len > frame.len() {
+        return Err(format!("frame of {len} bytes, only {} read", frame.len()));
+    }
+    let offset = frame[7] as usize;
+    if offset < HEADER_LEN || offset > len {
+        return Err(format!("data offset {offset} in a frame of {len} bytes"));
+    }
+    Ok(Frame {
+        seq: frame[4],
+        channel: frame[5] & 0x0f,
+        max_seq: frame[9],
+        payload: &frame[offset..len],
+    })
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct Reply<'a> {
+    pub cmd: u32,
+    pub id: u16,
+    /// Firmware error code when it failed (negative values as u32).
+    pub status: Option<u32>,
+    pub data: &'a [u8],
+}
+
+/// The BCDC header and data of a control frame's payload.
+pub fn parse_reply(payload: &[u8]) -> Result<Reply<'_>, String> {
+    if payload.len() < BCDC_LEN {
+        return Err(format!("control reply of {} bytes", payload.len()));
+    }
+    let word = |i: usize| u32::from_le_bytes(payload[i * 4..i * 4 + 4].try_into().unwrap());
+    let (cmd, len, flags, status) = (word(0), word(1) as usize, word(2), word(3));
+    let data = &payload[BCDC_LEN..];
+    Ok(Reply {
+        cmd,
+        id: (flags >> 16) as u16,
+        status: (flags & BCDC_FLAG_ERROR != 0).then_some(status),
+        data: &data[..len.min(data.len())],
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn get_var_frame() {
+        let mut data = b"ver\0".to_vec();
+        data.resize(8, 0);
+        let f = control_frame(3, 1, WLC_GET_VAR, false, &data);
+        assert_eq!(f.len(), 36);
+        assert_eq!(&f[..4], &[36, 0, !36u8, 0xff]);
+        assert_eq!(&f[4..12], &[3, 0, 0, 12, 0, 0, 0, 0]);
+        assert_eq!(&f[12..16], &262u32.to_le_bytes());
+        assert_eq!(&f[16..20], &8u32.to_le_bytes());
+        assert_eq!(&f[20..24], &0x0001_0000u32.to_le_bytes());
+        assert_eq!(&f[28..32], b"ver\0");
+        assert_eq!(frame_len(&f), Some(36));
+    }
+
+    #[test]
+    fn pads_odd_lengths() {
+        let f = control_frame(0, 2, WLC_GET_VAR, true, b"abcde");
+        assert_eq!(frame_len(&f), Some(33));
+        assert_eq!(f.len(), 36);
+        assert_eq!(&f[20..24], &0x0002_0002u32.to_le_bytes());
+    }
+
+    #[test]
+    fn reply_round_trip() {
+        // A reply looks like a request with the answer in the data.
+        let mut f = control_frame(0, 7, WLC_GET_VAR, false, b"wl0: version 7.45\0\0\0");
+        f[9] = 0x14; // credit
+        let frame = parse(&f).unwrap();
+        assert_eq!((frame.seq, frame.channel, frame.max_seq), (0, CHANNEL_CONTROL, 0x14));
+        let reply = parse_reply(frame.payload).unwrap();
+        assert_eq!((reply.cmd, reply.id, reply.status), (WLC_GET_VAR, 7, None));
+        assert!(reply.data.starts_with(b"wl0: version 7.45\0"));
+    }
+
+    #[test]
+    fn error_reply_and_bad_headers() {
+        let mut f = control_frame(0, 9, WLC_GET_VAR, false, b"xxxx");
+        f[20] |= 1; // error flag
+        f[24..28].copy_from_slice(&(-23i32 as u32).to_le_bytes());
+        let reply = parse_reply(parse(&f).unwrap().payload).unwrap();
+        assert_eq!(reply.status, Some(-23i32 as u32));
+        assert_eq!(frame_len(&[0, 0, 0xff, 0xff]), None);
+        assert_eq!(frame_len(&[36, 0, 0, 0]), None);
+        assert_eq!(frame_len(&[8, 0, 0xf7, 0xff]), None);
+    }
+}
diff --git a/drivers/net/bcm2835-sdiod/src/wifi.rs b/drivers/net/bcm2835-sdiod/src/wifi.rs
new file mode 100644
index 0000000..870da12
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/wifi.rs
@@ -0,0 +1,264 @@
+//! Starting the firmware and talking to it.
+//!
+//! The sequence of OpenBSD's bwfm(4) and Linux' brcmfmac (both ISC): hold
+//! the ARM, write the firmware to the start of its RAM and the NVRAM block
+//! to the end, write the reset vector, let the ARM run, ask for the HT
+//! clock, tell the firmware our protocol version, enable function 2 and
+//! wait until the firmware says it is ready. After that, firmware commands
+//! go over function 2 as SDPCM control frames (see `sdpcm`).
+
+use std::thread;
+use std::time::{Duration, Instant};
+
+use crate::bus::Bus;
+use crate::chip::Chip;
+use crate::host::{wait_until, Data};
+use crate::sdpcm;
+
+// Function 1 registers.
+const SBSDIO_WATERMARK: u32 = 0x10008;
+const SBSDIO_FUNC1_FRAMECTRL: u32 = 0x1000d;
+const SBSDIO_FUNC1_CHIPCLKCSR: u32 = 0x1000e;
+const SBSDIO_FUNC1_RFRAMEBCLO: u32 = 0x1001b;
+const SBSDIO_FUNC1_RFRAMEBCHI: u32 = 0x1001c;
+const SFC_RF_TERM: u8 = 0x01;
+const SBSDIO_HT_AVAIL_REQ: u8 = 0x10;
+const SBSDIO_HT_AVAIL: u8 = 0x80;
+const F2_WATERMARK: u8 = 8;
+
+// SDIO device core registers.
+const SD_INTSTATUS: u32 = 0x20;
+const SD_HOSTINTMASK: u32 = 0x24;
+const SD_TOSBMAILBOX: u32 = 0x40;
+const SD_TOSBMAILBOXDATA: u32 = 0x48;
+const SD_TOHOSTMAILBOXDATA: u32 = 0x4c;
+/// Interrupt status: the firmware has a frame for us / a mailbox message.
+const I_HMB_FRAME_IND: u32 = 1 << 6;
+const I_HMB_HOST_INT: u32 = 1 << 7;
+const I_HMB_SW_MASK: u32 = 0xf0;
+const SMB_INT_ACK: u32 = 1 << 1;
+/// SDPCM protocol version, sent in the to-chip mailbox data.
+const SDPCM_PROT_VERSION: u32 = 4;
+const SMB_DATA_VERSION_SHIFT: u32 = 16;
+
+// CCCR.
+const CCCR_IOEX: u32 = 0x02;
+const CCCR_IORX: u32 = 0x03;
+const CCCR_IOABORT: u32 = 0x06;
+const FUNC2: u8 = 0x04;
+
+/// Function 2 address for frames (a FIFO; the offset is what brcmfmac uses).
+const F2_ADDR: u32 = 0x8000;
+/// Function 2 block size.
+pub const F2_BLOCK: u32 = 512;
+/// The first read of a frame; the rest follows once the length is known.
+const FIRST_READ: usize = 64;
+
+/// Writes firmware and NVRAM and starts the ARM.
+pub fn download(bus: &mut Bus, chip: &Chip, firmware: &[u8], nvram: &[u8]) -> Result<(), String> {
+    if firmware.len() < 4 || firmware.len() as u32 + nvram.len() as u32 > chip.ramsize {
+        return Err(format!(
+            "firmware ({} bytes) and NVRAM ({} bytes) do not fit into {} bytes of RAM",
+            firmware.len(),
+            nvram.len(),
+            chip.ramsize
+        ));
+    }
+    chip.set_passive(bus)?;
+
+    let mut image = firmware.to_vec();
+    image.resize(firmware.len().next_multiple_of(4), 0);
+    let start = Instant::now();
+    bus.write_mem(chip.rambase, &image)?;
+    let written = start.elapsed();
+    let mut back = vec![0u8; image.len()];
+    bus.read_mem(chip.rambase, &mut back)?;
+    if let Some(at) = image.iter().zip(&back).position(|(a, b)| a != b) {
+        return Err(format!("firmware read back differs at byte {at}"));
+    }
+    println!(
+        "bcm2835-sdiod: firmware written ({} bytes in {} ms) and read back",
+        image.len(),
+        written.as_millis()
+    );
+
+    let nvram_addr = chip.rambase + chip.ramsize - nvram.len() as u32;
+    bus.write_mem(nvram_addr, nvram)?;
+    let mut back = vec![0u8; nvram.len()];
+    bus.read_mem(nvram_addr, &mut back)?;
+    if back != nvram {
+        return Err("NVRAM read back differs".into());
+    }
+    println!("bcm2835-sdiod: NVRAM written at 0x{nvram_addr:08x} ({} bytes)", nvram.len());
+
+    bus.write32(chip.sdio.base + SD_INTSTATUS, 0xffff_ffff)?;
+    let reset_vector = u32::from_le_bytes(firmware[..4].try_into().unwrap());
+    chip.set_active(bus, reset_vector)?;
+    println!("bcm2835-sdiod: ARM started, reset vector 0x{reset_vector:08x}");
+    Ok(())
+}
+
+/// Waits for the HT clock and function 2: the firmware is up.
+pub fn wait_ready(bus: &mut Bus, chip: &Chip) -> Result<(), String> {
+    bus.host.write_byte(1, SBSDIO_FUNC1_CHIPCLKCSR, SBSDIO_HT_AVAIL_REQ)?;
+    let mut csr = 0;
+    if !wait_until(Duration::from_secs(2), || {
+        csr = bus.host.read_byte(1, SBSDIO_FUNC1_CHIPCLKCSR).unwrap_or(0);
+        csr & SBSDIO_HT_AVAIL != 0
+    }) {
+        return Err(format!("no HT clock after the firmware start (CHIPCLKCSR 0x{csr:02x})"));
+    }
+    println!("bcm2835-sdiod: HT clock on (CHIPCLKCSR 0x{csr:02x})");
+
+    bus.write32(chip.sdio.base + SD_TOSBMAILBOXDATA, SDPCM_PROT_VERSION << SMB_DATA_VERSION_SHIFT)?;
+    let ioe = bus.host.read_byte(0, CCCR_IOEX)?;
+    bus.host.write_byte(0, CCCR_IOEX, ioe | FUNC2)?;
+    let mut ior = 0;
+    if !wait_until(Duration::from_secs(3), || {
+        ior = bus.host.read_byte(0, CCCR_IORX).unwrap_or(0);
+        ior & FUNC2 != 0
+    }) {
+        return Err(format!("function 2 not ready: the firmware did not start (IORx 0x{ior:02x})"));
+    }
+    bus.write32(chip.sdio.base + SD_HOSTINTMASK, I_HMB_SW_MASK)?;
+    bus.host.write_byte(1, SBSDIO_WATERMARK, F2_WATERMARK)?;
+    println!("bcm2835-sdiod: function 2 ready, firmware running");
+    Ok(())
+}
+
+/// The control channel: firmware commands and their replies.
+pub struct Control {
+    sdio_base: u32,
+    seq: u8,
+    /// Highest sequence number the firmware takes, from its last frame.
+    max_seq: u8,
+    id: u16,
+}
+
+impl Control {
+    pub fn new(chip: &Chip) -> Self {
+        Control {
+            sdio_base: chip.sdio.base,
+            seq: 0,
+            max_seq: 4,
+            id: 0,
+        }
+    }
+
+    /// Reads firmware variable `name` (WLC_GET_VAR) into at most `len`
+    /// bytes.
+    pub fn get_var(&mut self, bus: &mut Bus, name: &str, len: usize) -> Result<Vec<u8>, String> {
+        let mut data = name.as_bytes().to_vec();
+        data.push(0);
+        data.resize(data.len().max(len), 0);
+        self.command(bus, sdpcm::WLC_GET_VAR, false, &data)
+            .map_err(|e| format!("{name}: {e}"))
+    }
+
+    fn command(&mut self, bus: &mut Bus, cmd: u32, set: bool, data: &[u8]) -> Result<Vec<u8>, String> {
+        self.id = self.id.wrapping_add(1);
+        let credit = self.max_seq.wrapping_sub(self.seq);
+        if credit == 0 || credit & 0x80 != 0 {
+            println!(
+                "bcm2835-sdiod: no credit (seq {}, max {}), sending anyway",
+                self.seq, self.max_seq
+            );
+        }
+        let frame = sdpcm::control_frame(self.seq, self.id, cmd, set, data);
+        self.seq = self.seq.wrapping_add(1);
+        if frame.len() > F2_BLOCK as usize {
+            return Err(format!("control frame of {} bytes", frame.len()));
+        }
+        bus.host.cmd53(2, F2_ADDR, Data::Write(&frame), None)?;
+
+        let deadline = Instant::now() + Duration::from_secs(3);
+        while Instant::now() < deadline {
+            let status = bus.read32(self.sdio_base + SD_INTSTATUS)?;
+            if status & (I_HMB_FRAME_IND | I_HMB_HOST_INT) == 0 {
+                thread::sleep(Duration::from_millis(1));
+                continue;
+            }
+            bus.write32(self.sdio_base + SD_INTSTATUS, status & (I_HMB_FRAME_IND | I_HMB_HOST_INT))?;
+            if status & I_HMB_HOST_INT != 0 {
+                let mail = bus.read32(self.sdio_base + SD_TOHOSTMAILBOXDATA)?;
+                bus.write32(self.sdio_base + SD_TOSBMAILBOX, SMB_INT_ACK)?;
+                println!("bcm2835-sdiod: mailbox from the firmware 0x{mail:08x}");
+            }
+            if status & I_HMB_FRAME_IND == 0 {
+                continue;
+            }
+            // Read frames until the firmware has no more.
+            while let Some(frame) = self.read_frame(bus)? {
+                let parsed = sdpcm::parse(&frame)?;
+                self.max_seq = parsed.max_seq;
+                if parsed.channel != sdpcm::CHANNEL_CONTROL {
+                    let channel = match parsed.channel {
+                        sdpcm::CHANNEL_EVENT => "event",
+                        sdpcm::CHANNEL_DATA => "data",
+                        _ => "other",
+                    };
+                    println!(
+                        "bcm2835-sdiod: {channel} frame (channel {}), {} bytes",
+                        parsed.channel,
+                        parsed.payload.len()
+                    );
+                    continue;
+                }
+                let reply = sdpcm::parse_reply(parsed.payload)?;
+                if reply.id != self.id {
+                    println!("bcm2835-sdiod: reply {} while waiting for {}", reply.id, self.id);
+                    continue;
+                }
+                if let Some(status) = reply.status {
+                    return Err(format!("firmware error {}", status as i32));
+                }
+                return Ok(reply.data.to_vec());
+            }
+        }
+        Err("no reply from the firmware".into())
+    }
+
+    /// Reads one frame from function 2, or `None` when there is none.
+    fn read_frame(&mut self, bus: &mut Bus) -> Result<Option<Vec<u8>>, String> {
+        let mut frame = vec![0u8; FIRST_READ];
+        bus.host.cmd53(2, F2_ADDR, Data::Read(&mut frame), None)?;
+        if frame[..4] == [0; 4] {
+            return Ok(None);
+        }
+        let Some(len) = sdpcm::frame_len(&frame) else {
+            println!("bcm2835-sdiod: bad frame header {:02x?}", &frame[..4]);
+            self.abort_read(bus)?;
+            return Ok(None);
+        };
+        if len > FIRST_READ {
+            let rest = (len - FIRST_READ).next_multiple_of(4);
+            frame.resize(FIRST_READ + rest, 0);
+            let mut done = FIRST_READ;
+            while done < frame.len() {
+                let left = frame.len() - done;
+                let (n, block) = if left >= F2_BLOCK as usize {
+                    (left / F2_BLOCK as usize * F2_BLOCK as usize, Some(F2_BLOCK))
+                } else {
+                    (left, None)
+                };
+                bus.host.cmd53(2, F2_ADDR, Data::Read(&mut frame[done..done + n]), block)?;
+                done += n;
+            }
+        }
+        Ok(Some(frame))
+    }
+
+    /// Drops the rest of a frame the firmware is sending.
+    fn abort_read(&mut self, bus: &mut Bus) -> Result<(), String> {
+        bus.host.write_byte(0, CCCR_IOABORT, 2)?;
+        bus.host.write_byte(1, SBSDIO_FUNC1_FRAMECTRL, SFC_RF_TERM)?;
+        for _ in 0..10 {
+            let hi = bus.host.read_byte(1, SBSDIO_FUNC1_RFRAMEBCHI)?;
+            let lo = bus.host.read_byte(1, SBSDIO_FUNC1_RFRAMEBCLO)?;
+            if hi == 0 && lo == 0 {
+                break;
+            }
+        }
+        Ok(())
+    }
+}
