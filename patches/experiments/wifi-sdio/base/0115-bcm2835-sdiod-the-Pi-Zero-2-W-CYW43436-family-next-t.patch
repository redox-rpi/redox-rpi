+/// The chips this driver knows: CYW43455 (Pi 3B+), CYW43430 and CYW43436
+/// (the Pi Zero 2 W has one of these, depending on the board revision).
+const CHIP_43455: u16 = 0x4345;
+const CHIP_43430: u16 = 0xa9a6;
+const CHIP_43436: u16 = 0xaa6c;
+
+#[derive(Clone, Copy, PartialEq)]
+enum Board {
+    Pi3BPlus,
+    Zero2W,
+}
+
+impl Board {
+    fn name(self) -> &'static str {
+        match self {
+            Board::Pi3BPlus => "Pi 3B+",
+            Board::Zero2W => "Pi Zero 2 W",
+        }
+    }
+}
+
+/// The board, from the devicetree's root `compatible`.
+fn board(fdt: &Fdt) -> Board {
+    let zero = fdt
+        .root()
+        .compatible()
+        .all()
+        .any(|c| c == "raspberrypi,model-zero-2-w");
+    if zero {
+        Board::Zero2W
+    } else {
+        Board::Pi3BPlus
+    }
+}
+
+/// Firmware, NVRAM and regulatory data for a chip.
+struct Files {
+    firmware: String,
+    nvram: String,
+    /// The CYW43455 needs it; for the others it is used when present.
+    clm: String,
+    clm_needed: bool,
+    label: String,
+}
+
+/// Picks the files as Raspberry Pi OS does: by chip ID and revision, the
+/// board's own file first (`<name>.raspberrypi,model-zero-2-w.<ext>`),
+/// else the plain one. `fw=<name>` on the command line overrides the name.
+fn files(board: Board, id: u16, rev: u32) -> Result<Files, String> {
+    let mut variant = "minimal".to_string();
+    let mut name = None;
+    for arg in std::env::args().skip(1) {
+        match arg.strip_prefix("fw=") {
+            Some(n) => name = Some(n.to_string()),
+            None => variant = arg,
+        }
+    }
+    if id == CHIP_43455 && name.is_none() {
+        return Ok(Files {
+            firmware: format!("{FIRMWARE_DIR}/cyfmac43455-sdio-{variant}.bin"),
+            nvram: format!("{FIRMWARE_DIR}/brcmfmac43455-sdio.raspberrypi,3-model-b-plus.txt"),
+            clm: format!("{FIRMWARE_DIR}/cyfmac43455-sdio.clm_blob"),
+            clm_needed: true,
+            label: format!("{variant} firmware"),
+        });
+    }
+    // Raspberry Pi OS (firmware-nonfree) links the CYW43430 revision 1 name
+    // to the 43436S files and the B0 (revision 2 and later) name to the
+    // 43436 files for the Zero 2 W; a CYW43436 chip ID takes the 43436 files.
+    let name = match name {
+        Some(n) => n,
+        None => match (id, rev) {
+            (CHIP_43436, _) => "brcmfmac43436-sdio".into(),
+            (CHIP_43430, 1) => "brcmfmac43436s-sdio".into(),
+            (CHIP_43430, r) if r >= 2 => "brcmfmac43436-sdio".into(),
+            _ => return Err(format!("no firmware known for chip 0x{id:04x} rev {rev}")),
+        },
+    };
+    let pick = |ext: &str| {
+        let own = format!("{FIRMWARE_DIR}/{name}.raspberrypi,model-zero-2-w.{ext}");
+        if board == Board::Zero2W && fs::metadata(&own).is_ok() {
+            own
+        } else {
+            format!("{FIRMWARE_DIR}/{name}.{ext}")
+        }
+    };
+    Ok(Files {
+        firmware: pick("bin"),
+        nvram: pick("txt"),
+        clm: pick("clm_blob"),
+        clm_needed: false,
+        label: name,
+    })
+}
 
