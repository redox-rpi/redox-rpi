+/// A core runs: clock on, not forced, not in reset.
+fn core_is_up(bus: &mut Bus, core: &Core) -> Result<bool, String> {
+    let ioctl = bus.read32(core.wrap + AI_IOCTL)?;
+    let reset = bus.read32(core.wrap + AI_RESETCTRL)?;
+    Ok(ioctl & (IOCTL_FGC | IOCTL_CLK) == IOCTL_CLK && reset & RESETCTRL_RESET == 0)
+}
+
+/// The SOCRAM size: the sum of its RAM banks (brcmfmac
+/// brcmf_chip_socram_ramsize, core revision 8 and later).
+fn socram_ramsize(bus: &mut Bus, socram: &Core) -> Result<u32, String> {
+    let info = bus.read32(socram.base + SOCRAM_COREINFO)?;
+    let banks = (info & SOCRAM_SRNB_MASK) >> 4;
+    let mut size = 0;
+    for idx in 0..banks {
+        bus.write32(socram.base + SOCRAM_BANKIDX, idx)?;
+        let bank = bus.read32(socram.base + SOCRAM_BANKINFO)?;
+        size += ((bank & SOCRAM_BSZ_MASK) + 1) * SOCRAM_BANK_UNIT;
+    }
+    if size == 0 {
+        return Err(format!("SOCRAM reports no RAM (core info 0x{info:08x})"));
+    }
+    Ok(size)
+}
+
 fn cr4_ramsize(bus: &mut Bus, cr4: &Core) -> Result<u32, String> {
     let cap = bus.read32(cr4.base + ARMCR4_CAP)?;
     let banks = (cap & 0xf) + (cap >> 4 & 0xf);
