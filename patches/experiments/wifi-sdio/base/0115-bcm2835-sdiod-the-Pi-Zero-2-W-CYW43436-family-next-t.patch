+/// Pi Zero 2 W: WL_REG_ON is GPIO 41. Low, then high, so the chip starts
+/// from reset.
+fn power_cycle_gpio(gpio: &Gpio) {
+    const PIN: usize = 41;
+    const GPSET1: usize = 0x20;
+    const GPCLR1: usize = 0x2c;
+    const GPLEV1: usize = 0x38;
+    let bit = 1 << (PIN - 32);
+    println!(
+        "bcm2835-sdiod: WL_ON (GPIO 41) function {} level {}",
+        gpio.function(PIN),
+        gpio.read(GPLEV1) & bit != 0
+    );
+    gpio.set_function(PIN, 1); // output
+    gpio.write(GPCLR1, bit);
+    thread::sleep(Duration::from_millis(20));
+    gpio.write(GPSET1, bit);
+    // brcmfmac waits for the chip's internal regulators after power-on.
+    thread::sleep(Duration::from_millis(150));
+    println!("bcm2835-sdiod: WL_ON cycled, level {}", gpio.read(GPLEV1) & bit != 0);
+}
+
+/// Pi Zero 2 W: the chip's 32.768 kHz sleep clock (LPO) comes from GPCLK2
+/// on GPIO 43 (ALT0). If the firmware did not start it, start it from the
+/// 19.2 MHz oscillator (divisor 585 + 3840/4096, MASH 1).
+fn sleep_clock(gpio: &Gpio, cm: *mut ()) {
+    const PIN: usize = 43;
+    const GPFSEL_ALT0: u32 = 4;
+    const CM_GP2CTL: usize = 0x80;
+    const CM_GP2DIV: usize = 0x84;
+    const PASSWD: u32 = 0x5a00_0000;
+    const ENAB: u32 = 1 << 4;
+    const BUSY: u32 = 1 << 7;
+    const SRC_OSC: u32 = 1;
+    const MASH_1: u32 = 1 << 9;
+    let reg = |off: usize| unsafe { (cm as *mut u32).add(off / 4) };
+    let ctl = unsafe { reg(CM_GP2CTL).read_volatile() };
+    let div = unsafe { reg(CM_GP2DIV).read_volatile() };
+    println!(
+        "bcm2835-sdiod: GPIO 43 function {}, GPCLK2 ctl 0x{ctl:08x} div 0x{div:08x}",
+        gpio.function(PIN)
+    );
+    if ctl & ENAB == 0 || ctl & 0xf != SRC_OSC {
+        unsafe {
+            reg(CM_GP2CTL).write_volatile(PASSWD | (ctl & !ENAB & 0xffff));
+            let _ = wait_until(Duration::from_millis(10), || reg(CM_GP2CTL).read_volatile() & BUSY == 0);
+            reg(CM_GP2DIV).write_volatile(PASSWD | 585 << 12 | 3840);
+            reg(CM_GP2CTL).write_volatile(PASSWD | MASH_1 | SRC_OSC);
+            reg(CM_GP2CTL).write_volatile(PASSWD | MASH_1 | SRC_OSC | ENAB);
+        }
+        println!("bcm2835-sdiod: GPCLK2 started at 32768 Hz");
+    }
+    if gpio.function(PIN) != GPFSEL_ALT0 {
+        gpio.set_function(PIN, GPFSEL_ALT0);
+        println!("bcm2835-sdiod: GPIO 43 set to GPCLK2");
+    }
+}
