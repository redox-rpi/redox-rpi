+        let (ssid, psk) = parse_config("ssid=Open net\n").unwrap();
+        assert_eq!((ssid, psk), (b"Open net".to_vec(), None));
+        assert!(parse_config("psk=secret123\n").is_err());
+        assert!(parse_config("ssid_hex=4x\n").is_err());
+    }
+
+    #[test]
+    fn pmk_key_is_hex() {
+        let key = pmk_key(b"password", b"IEEE").unwrap();
+        assert_eq!(key, b"f42c6fc52df0ebef9ebb4b90b38a5f902e83fe1b135a70e23aed762e9710a12e");
+        assert!(pmk_key(b"short", b"IEEE").is_err());
+        assert!(pmk_key(&[b'a'; 64], b"IEEE").is_err());
+    }
+}
