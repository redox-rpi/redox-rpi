diff --git a/drivers/net/bcm2835-sdiod/src/scan.rs b/drivers/net/bcm2835-sdiod/src/scan.rs
new file mode 100644
index 0000000..c7bd08c
--- /dev/null
+++ b/drivers/net/bcm2835-sdiod/src/scan.rs
@@ -0,0 +1,233 @@
+//! Scanning ("escan") and the structures for joining a network.
+//!
+//! An escan starts with the `escan` variable; the firmware answers with
+//! ESCAN_RESULT events, status PARTIAL with one or more BSS descriptions
+//! each, then SUCCESS when it is done. Layouts as in OpenBSD's bwfm(4) and
+//! Linux' brcmfmac (both ISC).
+
+/// Escan parameters: version 1, action start, a sync ID, then the scan
+/// parameters (any SSID, any BSSID, any BSS type, active scan, firmware
+/// defaults for the times, all channels).
+pub fn escan_params(sync_id: u16) -> Vec<u8> {
+    let mut p = Vec::with_capacity(72);
+    p.extend_from_slice(&1u32.to_le_bytes()); // version
+    p.extend_from_slice(&1u16.to_le_bytes()); // action: start
+    p.extend_from_slice(&sync_id.to_le_bytes());
+    p.extend_from_slice(&[0; 36]); // SSID length and SSID: any
+    p.extend_from_slice(&[0xff; 6]); // BSSID: any
+    p.push(2); // BSS type: any
+    p.push(0); // scan type: active
+    for value in [-1i32, -1, -1, -1] {
+        // probes, active, passive and home time: firmware defaults
+        p.extend_from_slice(&value.to_le_bytes());
+    }
+    p.extend_from_slice(&0u32.to_le_bytes()); // channel count: all
+    p
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Security {
+    Open,
+    Wep,
+    Wpa,
+    Wpa2,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Bss {
+    pub bssid: [u8; 6],
+    pub ssid: Vec<u8>,
+    pub rssi: i16,
+    pub channel: u8,
+    pub security: Security,
+}
+
+/// Offsets in a BSS description that differ between the naturally aligned
+/// layout (what the firmware is expected to send) and a packed one.
+struct Layout {
+    rssi: usize,
+    chanspec: usize,
+    ctl_ch: usize,
+    ie_offset: usize,
+    ie_length: usize,
+    size: usize,
+}
+
+const NATURAL: Layout = Layout {
+    rssi: 78,
+    chanspec: 72,
+    ctl_ch: 88,
+    ie_offset: 116,
+    ie_length: 120,
+    size: 126,
+};
+const PACKED: Layout = Layout {
+    rssi: 76,
+    chanspec: 71,
+    ctl_ch: 84,
+    ie_offset: 109,
+    ie_length: 111,
+    size: 117,
+};
+
+const CAPABILITY_PRIVACY: u16 = 1 << 4;
+const IE_RSN: u8 = 48;
+const IE_VENDOR: u8 = 221;
+const WPA_OUI_TYPE: [u8; 4] = [0x00, 0x50, 0xf2, 0x01];
+
+/// The BSS descriptions in the data of an ESCAN_RESULT event.
+pub fn parse_result(data: &[u8]) -> Vec<Bss> {
+    let mut list = Vec::new();
+    if data.len() < 12 {
+        return list;
+    }
+    let count = u16::from_le_bytes([data[10], data[11]]) as usize;
+    let mut rest = &data[12..];
+    for _ in 0..count {
+        if rest.len() < 8 {
+            break;
+        }
+        let len = u32::from_le_bytes(rest[4..8].try_into().unwrap()) as usize;
+        if len < PACKED.size || len > rest.len() {
+            break;
+        }
+        if let Some(bss) = parse_bss(&rest[..len]) {
+            list.push(bss);
+        }
+        rest = &rest[len..];
+    }
+    list
+}
+
+fn parse_bss(b: &[u8]) -> Option<Bss> {
+    let le16 = |i: usize| u16::from_le_bytes([b[i], b[i + 1]]);
+    let le32 = |i: usize| u32::from_le_bytes(b[i..i + 4].try_into().unwrap()) as usize;
+    let fits = |l: &Layout| {
+        b.len() >= l.size && {
+            let (off, len) = (le16(l.ie_offset) as usize, le32(l.ie_length));
+            off >= l.size && off + len <= b.len()
+        }
+    };
+    let layout = [NATURAL, PACKED].into_iter().find(|l| fits(l))?;
+    let ssid_len = (b[18] as usize).min(32);
+    let ie_start = le16(layout.ie_offset) as usize;
+    let ies = &b[ie_start..ie_start + le32(layout.ie_length)];
+    let channel = match b[layout.ctl_ch] {
+        0 => le16(layout.chanspec) as u8,
+        ch => ch,
+    };
+    Some(Bss {
+        bssid: b[8..14].try_into().unwrap(),
+        ssid: b[19..19 + ssid_len].to_vec(),
+        rssi: le16(layout.rssi) as i16,
+        channel,
+        security: security(le16(16), ies),
+    })
+}
+
+fn security(capability: u16, ies: &[u8]) -> Security {
+    let mut wpa = false;
+    let mut rest = ies;
+    while let [id, len, tail @ ..] = rest {
+        let len = *len as usize;
+        if tail.len() < len {
+            break;
+        }
+        let body = &tail[..len];
+        if *id == IE_RSN {
+            return Security::Wpa2;
+        }
+        if *id == IE_VENDOR && body.starts_with(&WPA_OUI_TYPE) {
+            wpa = true;
+        }
+        rest = &tail[len..];
+    }
+    match (wpa, capability & CAPABILITY_PRIVACY != 0) {
+        (true, _) => Security::Wpa,
+        (false, true) => Security::Wep,
+        (false, false) => Security::Open,
+    }
+}
+
+/// An SSID as the firmware takes it: 32-bit length and 32 bytes.
+pub fn ssid_le(ssid: &[u8]) -> Vec<u8> {
+    let mut s = (ssid.len() as u32).to_le_bytes().to_vec();
+    s.extend_from_slice(ssid);
+    s.resize(36, 0);
+    s
+}
+
+/// A WPA passphrase for the firmware supplicant (WLC_SET_WSEC_PMK): length,
+/// flag "passphrase", 64 bytes.
+pub fn wsec_pmk(passphrase: &[u8]) -> Vec<u8> {
+    let mut k = (passphrase.len() as u16).to_le_bytes().to_vec();
+    k.extend_from_slice(&1u16.to_le_bytes());
+    k.extend_from_slice(passphrase);
+    k.resize(68, 0);
+    k
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bss(layout: &Layout, ssid: &[u8], cap: u16, ies: &[u8]) -> Vec<u8> {
+        let ie_offset = (layout.size + 1) & !1;
+        let mut b = vec![0u8; ie_offset];
+        b[0..4].copy_from_slice(&109u32.to_le_bytes());
+        b[8..14].copy_from_slice(&[0xdc, 0x39, 0x6f, 1, 2, 3]);
+        b[16..18].copy_from_slice(&cap.to_le_bytes());
+        b[18] = ssid.len() as u8;
+        b[19..19 + ssid.len()].copy_from_slice(ssid);
+        b[layout.rssi..layout.rssi + 2].copy_from_slice(&(-57i16).to_le_bytes());
+        b[layout.chanspec..layout.chanspec + 2].copy_from_slice(&0x1006u16.to_le_bytes());
+        b[layout.ie_offset..layout.ie_offset + 2].copy_from_slice(&(ie_offset as u16).to_le_bytes());
+        b[layout.ie_length..layout.ie_length + 4].copy_from_slice(&(ies.len() as u32).to_le_bytes());
+        b.extend_from_slice(ies);
+        let len = b.len() as u32;
+        b[4..8].copy_from_slice(&len.to_le_bytes());
+        b
+    }
+
+    fn result(entries: &[Vec<u8>]) -> Vec<u8> {
+        let mut d = vec![0u8; 12];
+        d[10..12].copy_from_slice(&(entries.len() as u16).to_le_bytes());
+        for e in entries {
+            d.extend_from_slice(e);
+        }
+        d
+    }
+
+    #[test]
+    fn natural_and_packed_layouts() {
+        let rsn = [IE_RSN, 2, 1, 0];
+        let wpa = [IE_VENDOR, 6, 0x00, 0x50, 0xf2, 0x01, 1, 0];
+        let data = result(&[
+            bss(&NATURAL, b"FRITZ!Box 7590", CAPABILITY_PRIVACY, &[&[0, 2, b'x', b'y'][..], &rsn].concat()),
+            bss(&PACKED, b"old", CAPABILITY_PRIVACY, &wpa),
+            bss(&NATURAL, b"cafe", 0, &[]),
+            bss(&NATURAL, b"wep", CAPABILITY_PRIVACY, &[]),
+        ]);
+        let list = parse_result(&data);
+        assert_eq!(list.len(), 4);
+        assert_eq!(list[0].ssid, b"FRITZ!Box 7590");
+        assert_eq!((list[0].rssi, list[0].channel, &list[0].security), (-57, 6, &Security::Wpa2));
+        assert_eq!(list[1].security, Security::Wpa);
+        assert_eq!(list[1].rssi, -57);
+        assert_eq!(list[2].security, Security::Open);
+        assert_eq!(list[3].security, Security::Wep);
+    }
+
+    #[test]
+    fn params_and_structs() {
+        let p = escan_params(0x1234);
+        assert_eq!(p.len(), 72);
+        assert_eq!(&p[6..8], &[0x34, 0x12]);
+        assert_eq!(&p[44..50], &[0xff; 6]);
+        assert_eq!(p[50], 2);
+        assert_eq!(&p[52..56], &[0xff; 4]);
+        assert_eq!(ssid_le(b"ab")[..6], [2, 0, 0, 0, b'a', b'b']);
+        let k = wsec_pmk(b"secret12");
+        assert_eq!((k.len(), &k[..4], &k[4..12]), (68, &[8, 0, 1, 0][..], &b"secret12"[..]));
+    }
+}
