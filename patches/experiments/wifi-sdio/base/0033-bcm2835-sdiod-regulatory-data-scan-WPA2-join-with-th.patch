+//! The steps after the firmware runs: regulatory data, events, scanning
+//! and joining a network with the firmware's own WPA2 supplicant.
+
+use std::fs;
+use std::time::Duration;
+
+use crate::bus::Bus;
+use crate::event::{self, Event};
+use crate::scan::{self, Bss};
+use crate::sdpcm;
+use crate::wifi::{CmdError, Control};
+
+/// CLM download: chunks of at most this size, with a 12-byte header
+/// (flags, type, length, CRC).
+const CLM_CHUNK: usize = 1400;
+const DL_BEGIN: u16 = 0x0002;
+const DL_END: u16 = 0x0004;
+const DLOAD_HANDLER_VER: u16 = 1 << 12;
+const DL_TYPE_CLM: u16 = 2;
+
+/// Security settings for WLC_SET_WSEC / WLC_SET_WPA_AUTH.
+const AES_ENABLED: u32 = 0x4;
+const WPA2_AUTH_PSK: u32 = 0x80;
+
+/// The settings file: `ssid=…` and, for WPA2, `psk=…` (8 to 63 characters).
+pub const CONFIG_PATH: &str = "/etc/net/wifi";
+
+/// Loads the regulatory data (country and channel rules) into the
+/// firmware. Without it, firmware 7.45 scans no channels.
+pub fn load_clm(control: &mut Control, bus: &mut Bus, clm: &[u8]) -> Result<(), String> {
+    let chunks: Vec<&[u8]> = clm.chunks(CLM_CHUNK).collect();
+    for (i, chunk) in chunks.iter().enumerate() {
+        let mut flags = DLOAD_HANDLER_VER;
+        if i == 0 {
+            flags |= DL_BEGIN;
+        }
+        if i == chunks.len() - 1 {
+            flags |= DL_END;
+        }
+        let mut data = Vec::with_capacity(12 + chunk.len());
+        data.extend_from_slice(&flags.to_le_bytes());
+        data.extend_from_slice(&DL_TYPE_CLM.to_le_bytes());
+        data.extend_from_slice(&(chunk.len() as u32).to_le_bytes());
+        data.extend_from_slice(&0u32.to_le_bytes()); // CRC not used
+        data.extend_from_slice(chunk);
+        control
+            .set_var(bus, "clmload", &data)
+            .map_err(|e| format!("clmload chunk {i}: {e}"))?;
+    }
+    let status = control.get_var_u32(bus, "clmload_status")?;
+    if status != 0 {
+        return Err(format!("clmload_status {status}"));
+    }
+    println!("bcm2835-sdiod: CLM loaded ({} bytes, {} chunks)", clm.len(), chunks.len());
+    Ok(())
+}
+
+/// Turns on the events this driver handles and brings the radio up.
+pub fn up(control: &mut Control, bus: &mut Bus) -> Result<(), String> {
+    let mut mask = control.get_var(bus, "event_msgs", 18)?;
+    for kind in [
+        event::E_SET_SSID,
+        event::E_JOIN,
+        event::E_AUTH,
+        event::E_DEAUTH,
+        event::E_DEAUTH_IND,
+        event::E_ASSOC,
+        event::E_DISASSOC,
+        event::E_DISASSOC_IND,
+        event::E_LINK,
+        event::E_PSK_SUP,
+        event::E_ESCAN_RESULT,
+    ] {
+        let (byte, bit) = (kind as usize / 8, kind % 8);
+        if byte < mask.len() {
+            mask[byte] |= 1 << bit;
+        }
+    }
+    control.set_var(bus, "event_msgs", &mask)?;
+    // Raspberry Pi OS turns roaming off "for WLAN stability"; one access
+    // point is all this driver handles anyway.
+    if let Err(e) = control.set_var_u32(bus, "roam_off", 1) {
+        println!("bcm2835-sdiod: roam_off: {e}");
+    }
+    control.command(bus, sdpcm::WLC_UP, true, &0u32.to_le_bytes())?;
+    println!("bcm2835-sdiod: radio up");
+    Ok(())
+}
+
+/// Scans all channels and returns the networks found, strongest first, one
+/// entry per BSSID.
+pub fn scan(control: &mut Control, bus: &mut Bus) -> Result<Vec<Bss>, String> {
+    let sync_id = 0x5a17;
+    control.set_var(bus, "escan", &scan::escan_params(sync_id))?;
+    let mut found: Vec<Bss> = Vec::new();
+    let done = control.wait_event(bus, Duration::from_secs(10), |e: &Event| {
+        if e.kind != event::E_ESCAN_RESULT {
+            return None;
+        }
+        match e.status {
+            event::STATUS_PARTIAL => {
+                for bss in scan::parse_result(&e.data) {
+                    if !found.iter().any(|f| f.bssid == bss.bssid) {
+                        found.push(bss);
+                    }
+                }
+                None
+            }
+            status => Some(status),
+        }
+    })?;
+    match done {
+        Some(event::STATUS_SUCCESS) => {}
+        Some(status) => return Err(format!("scan ended with status {status}")),
+        None => return Err("scan did not end within 10 s".into()),
+    }
+    found.sort_by_key(|b| -b.rssi);
+    Ok(found)
+}
+
+pub fn print_networks(list: &[Bss]) {
+    println!("bcm2835-sdiod: {} networks", list.len());
+    for b in list {
+        println!(
+            "bcm2835-sdiod:   {} ch {:3} {:4} dBm {:?} {}",
+            mac(&b.bssid),
+            b.channel,
+            b.rssi,
+            b.security,
+            String::from_utf8_lossy(&b.ssid)
+        );
+    }
+}
+
+/// Network name and passphrase from the settings file, if there is one.
+pub fn read_config() -> Option<(Vec<u8>, Option<Vec<u8>>)> {
+    let text = fs::read_to_string(CONFIG_PATH).ok()?;
+    let mut ssid = None;
+    let mut psk = None;
+    for line in text.lines() {
+        let line = line.trim_end_matches('\r');
+        if let Some(v) = line.strip_prefix("ssid=") {
+            ssid = Some(v.as_bytes().to_vec());
+        } else if let Some(v) = line.strip_prefix("psk=") {
+            psk = Some(v.as_bytes().to_vec());
+        }
+    }
+    Some((ssid?, psk))
+}
+
+/// Joins `ssid`, with WPA2-PSK through the firmware supplicant when a
+/// passphrase is given, and waits until the link is up (and keyed).
+pub fn join(control: &mut Control, bus: &mut Bus, ssid: &[u8], psk: Option<&[u8]>) -> Result<(), String> {
+    if ssid.is_empty() || ssid.len() > 32 {
+        return Err(format!("network name of {} bytes", ssid.len()));
+    }
+    control.set_u32(bus, sdpcm::WLC_SET_INFRA, 1)?;
+    control.set_u32(bus, sdpcm::WLC_SET_AUTH, 0)?;
+    match psk {
+        Some(psk) => {
+            if !(8..=63).contains(&psk.len()) {
+                return Err(format!("passphrase of {} characters, needs 8 to 63", psk.len()));
+            }
+            control.set_u32(bus, sdpcm::WLC_SET_WSEC, AES_ENABLED)?;
+            control.set_u32(bus, sdpcm::WLC_SET_WPA_AUTH, WPA2_AUTH_PSK)?;
+            match control.set_var_u32(bus, "sup_wpa", 1) {
+                Ok(()) => {}
+                Err(CmdError::Firmware(code)) => {
+                    return Err(format!(
+                        "sup_wpa: firmware error {code}: this firmware has no supplicant (use the minimal one)"
+                    ))
+                }
+                Err(e) => return Err(e.into()),
+            }
+            control.command(bus, sdpcm::WLC_SET_WSEC_PMK, true, &scan::wsec_pmk(psk))?;
+        }
+        None => {
+            control.set_u32(bus, sdpcm::WLC_SET_WSEC, 0)?;
+            control.set_u32(bus, sdpcm::WLC_SET_WPA_AUTH, 0)?;
+            let _ = control.set_var_u32(bus, "sup_wpa", 0);
+        }
+    }
+    control.command(bus, sdpcm::WLC_SET_SSID, true, &scan::ssid_le(ssid))?;
+    println!("bcm2835-sdiod: joining {}", String::from_utf8_lossy(ssid));
+
+    let mut link = false;
+    let mut keyed = psk.is_none();
+    let result = control.wait_event(bus, Duration::from_secs(20), |e: &Event| {
+        match e.kind {
+            event::E_SET_SSID if e.status != event::STATUS_SUCCESS => {
+                return Some(Err(format!("join failed: SET_SSID status {}", e.status)))
+            }
+            event::E_LINK => {
+                link = e.flags & event::LINK_UP != 0;
+                println!(
+                    "bcm2835-sdiod: link {} ({})",
+                    if link { "up" } else { "down" },
+                    mac(&e.addr)
+                );
+                if !link && e.reason != 0 {
+                    return Some(Err(format!("link down, reason {}", e.reason)));
+                }
+            }
+            event::E_PSK_SUP => {
+                if e.status == event::SUP_KEYED {
+                    keyed = true;
+                    println!("bcm2835-sdiod: WPA2 keys in place");
+                } else if e.status != 0 {
+                    return Some(Err(format!(
+                        "WPA2 handshake failed: PSK_SUP status {}, reason {} (wrong passphrase?)",
+                        e.status, e.reason
+                    )));
+                }
+            }
+            event::E_DEAUTH | event::E_DEAUTH_IND | event::E_DISASSOC_IND => {
+                return Some(Err(format!("{} from the access point, reason {}", event::name(e.kind), e.reason)))
+            }
+            _ => return None,
+        }
+        (link && keyed).then_some(Ok(()))
+    })?;
+    match result {
+        Some(r) => r,
+        None => Err(format!("no link within 20 s (link {link}, keyed {keyed})")),
+    }
+}
+
+pub fn mac(a: &[u8; 6]) -> String {
+    a.iter().map(|b| format!("{b:02x}")).collect::<Vec<_>>().join(":")
+}
