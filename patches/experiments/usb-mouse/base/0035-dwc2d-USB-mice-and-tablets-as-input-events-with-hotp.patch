@@ -0,0 +1,471 @@
+//! USB mice and tablets (HID): polled on their interrupt endpoint, movement,
+//! buttons and the wheel go to inputd like those of usbhidd.
+//!
+//! The report descriptor says where X, Y, the wheel and the buttons are in a
+//! report and whether X and Y are relative (a mouse) or absolute (a tablet,
+//! such as QEMU's usb-tablet). A boot protocol mouse whose descriptor does
+//! not parse falls back to the boot report: buttons, X, Y.
+
+use std::time::{Duration, Instant};
+
+use common::dma::Dma;
+use inputd::ProducerHandle;
+use orbclient::{ButtonEvent, MouseEvent, MouseRelativeEvent, ScrollEvent};
+
+use crate::dwc2::{Dwc2, Error, Phase, Speed};
+use crate::enumerate::{Bus, Device};
+use crate::regs::*;
+
+const CLASS_HID: u8 = 0x03;
+const SUBCLASS_BOOT: u8 = 0x01;
+const PROTOCOL_KEYBOARD: u8 = 0x01;
+const PROTOCOL_MOUSE: u8 = 0x02;
+
+const REQ_GET_DESCRIPTOR: u8 = 0x06;
+const REQ_SET_CONFIGURATION: u8 = 0x09;
+const DESC_CONFIGURATION: u8 = 0x02;
+const DESC_HID: u8 = 0x21;
+const DESC_REPORT: u8 = 0x22;
+// HID class requests (HID 1.11, 7.2)
+const REQ_SET_IDLE: u8 = 0x0A;
+const REQ_SET_PROTOCOL: u8 = 0x0B;
+const PROTOCOL_BOOT: u16 = 0;
+const PROTOCOL_REPORT: u16 = 1;
+
+const PAGE_GENERIC_DESKTOP: u16 = 0x01;
+const PAGE_BUTTON: u16 = 0x09;
+const USAGE_X: u16 = 0x30;
+const USAGE_Y: u16 = 0x31;
+const USAGE_WHEEL: u16 = 0x38;
+
+/// The host channel for mouse reports; the keyboard uses 3, USB sticks 4
+/// and 5.
+const CHANNEL: usize = 6;
+const POLL_INTERVAL: Duration = Duration::from_millis(10);
+/// The largest report read; mice send 3 to 8 bytes.
+const REPORT_MAX: usize = 64;
+
+/// One value in a report: its bits and range.
+#[derive(Clone, Copy, Debug)]
+struct Field {
+    /// Bit offset after the report ID byte, if any.
+    offset: usize,
+    size: usize,
+    min: i32,
+    max: i32,
+}
+
+impl Field {
+    fn get(&self, data: &[u8]) -> Option<i32> {
+        if self.size == 0 || self.size > 32 || self.offset + self.size > data.len() * 8 {
+            return None;
+        }
+        let mut raw = 0u64;
+        for bit in 0..self.size {
+            let at = self.offset + bit;
+            if data[at / 8] & (1 << (at % 8)) != 0 {
+                raw |= 1 << bit;
+            }
+        }
+        Some(if self.min < 0 && raw & (1 << (self.size - 1)) != 0 {
+            (raw as i64 - (1i64 << self.size)) as i32
+        } else {
+            raw as i32
+        })
+    }
+}
+
+/// Where a pointer's values are in its reports.
+#[derive(Clone, Debug)]
+struct Layout {
+    report_id: Option<u8>,
+    x: Field,
+    y: Field,
+    absolute: bool,
+    wheel: Option<Field>,
+    /// Buttons 1, 2, 3: left, right, middle.
+    buttons: [Option<Field>; 3],
+}
+
+impl Layout {
+    /// The boot protocol report: buttons, X, Y (HID 1.11, appendix B.2).
+    fn boot() -> Self {
+        let button = |n| Some(Field { offset: n, size: 1, min: 0, max: 1 });
+        Self {
+            report_id: None,
+            x: Field { offset: 8, size: 8, min: -127, max: 127 },
+            y: Field { offset: 16, size: 8, min: -127, max: 127 },
+            absolute: false,
+            wheel: None,
+            buttons: [button(0), button(1), button(2)],
+        }
+    }
+
+    /// Find X and Y in a report descriptor (HID 1.11, 6.2.2), with the
+    /// buttons and the wheel of the same report.
+    fn parse(desc: &[u8]) -> Option<Self> {
+        #[derive(Clone, Copy, Default)]
+        struct Globals {
+            page: u16,
+            min: i32,
+            max: i32,
+            max_unsigned: u32,
+            size: usize,
+            count: usize,
+            id: Option<u8>,
+        }
+        let mut g = Globals::default();
+        let mut stack = Vec::new();
+        let mut usages: Vec<(u16, u16)> = Vec::new();
+        let mut usage_range: (Option<u32>, Option<u32>) = (None, None);
+        // Bits so far per report ID.
+        let mut offsets: Vec<(Option<u8>, usize)> = Vec::new();
+        // (report ID, page, usage, field, relative)
+        let mut fields: Vec<(Option<u8>, u16, u16, Field, bool)> = Vec::new();
+
+        let mut pos = 0;
+        while pos < desc.len() {
+            let prefix = desc[pos];
+            if prefix == 0xFE {
+                // Long item: data size in the next byte.
+                pos += 3 + usize::from(*desc.get(pos + 1)?);
+                continue;
+            }
+            let len = [0, 1, 2, 4][usize::from(prefix & 3)];
+            let data = desc.get(pos + 1..pos + 1 + len)?;
+            pos += 1 + len;
+            let mut bytes = [0; 4];
+            bytes[..len].copy_from_slice(data);
+            let unsigned = u32::from_le_bytes(bytes);
+            let signed = match len {
+                1 => i32::from(data[0] as i8),
+                2 => i32::from(i16::from_le_bytes([data[0], data[1]])),
+                4 => unsigned as i32,
+                _ => 0,
+            };
+            match (prefix >> 2) & 3 {
+                // Main
+                0 => {
+                    let tag = prefix >> 4;
+                    if tag == 0x8 {
+                        let constant = unsigned & 1 != 0;
+                        let variable = unsigned & 2 != 0;
+                        let relative = unsigned & 4 != 0;
+                        let at = match offsets.iter_mut().find(|(id, _)| *id == g.id) {
+                            Some((_, at)) => at,
+                            None => {
+                                offsets.push((g.id, 0));
+                                &mut offsets.last_mut().unwrap().1
+                            }
+                        };
+                        // A logical maximum below the minimum is meant
+                        // unsigned (255 written as the byte 0xFF).
+                        let max = if g.max < g.min { g.max_unsigned as i32 } else { g.max };
+                        for i in 0..g.count {
+                            if variable && !constant {
+                                let usage = match usage_range {
+                                    (Some(lo), Some(hi)) if lo + i as u32 <= hi => {
+                                        let u = lo + i as u32;
+                                        Some(((u >> 16) as u16, u as u16))
+                                    }
+                                    _ => usages.get(i).or(usages.last()).copied(),
+                                };
+                                if let Some((page, usage)) = usage {
+                                    let page = if page == 0 { g.page } else { page };
+                                    let field = Field { offset: *at, size: g.size, min: g.min, max };
+                                    fields.push((g.id, page, usage, field, relative));
+                                }
+                            }
+                            *at += g.size;
+                        }
+                    }
+                    usages.clear();
+                    usage_range = (None, None);
+                }
+                // Global
+                1 => match prefix >> 4 {
+                    0x0 => g.page = unsigned as u16,
+                    0x1 => g.min = signed,
+                    0x2 => (g.max, g.max_unsigned) = (signed, unsigned),
+                    0x7 => g.size = unsigned as usize,
+                    0x8 => g.id = Some(unsigned as u8),
+                    0x9 => g.count = unsigned as usize,
+                    0xA => stack.push(g),
+                    0xB => g = stack.pop()?,
+                    _ => {}
+                },
+                // Local
+                2 => {
+                    // A 4-byte usage carries its page in the high half.
+                    let page = if len == 4 { (unsigned >> 16) as u16 } else { 0 };
+                    let full = if len == 4 { unsigned } else { (u32::from(g.page) << 16) | unsigned };
+                    match prefix >> 4 {
+                        0x0 => usages.push((page, unsigned as u16)),
+                        0x1 => usage_range.0 = Some(full),
+                        0x2 => usage_range.1 = Some(full),
+                        _ => {}
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        let find = |id: Option<u8>, page: u16, usage: u16| {
+            fields.iter().find(|f| f.0 == id && f.1 == page && f.2 == usage).map(|f| (f.3, f.4))
+        };
+        // The first report with both X and Y.
+        let (id, x, x_relative) = fields
+            .iter()
+            .filter(|f| f.1 == PAGE_GENERIC_DESKTOP && f.2 == USAGE_X)
+            .find(|f| find(f.0, PAGE_GENERIC_DESKTOP, USAGE_Y).is_some())
+            .map(|f| (f.0, f.3, f.4))?;
+        let (y, _) = find(id, PAGE_GENERIC_DESKTOP, USAGE_Y)?;
+        Some(Self {
+            report_id: id,
+            x,
+            y,
+            absolute: !x_relative,
+            wheel: find(id, PAGE_GENERIC_DESKTOP, USAGE_WHEEL).map(|f| f.0),
+            buttons: [1, 2, 3].map(|n| find(id, PAGE_BUTTON, n).map(|f| f.0)),
+        })
+    }
+
+    fn describe(&self) -> String {
+        format!(
+            "{}, {} button(s){}",
+            if self.absolute { "absolute" } else { "relative" },
+            self.buttons.iter().filter(|b| b.is_some()).count(),
+            if self.wheel.is_some() { ", wheel" } else { "" }
+        )
+    }
+}
+
+/// A mouse interface, its interrupt IN endpoint and its report layout.
+pub struct MouseFunction {
+    address: u8,
+    speed: Speed,
+    max_packet0: u16,
+    tt: Option<(u8, u8)>,
+    configuration: u8,
+    interface: u8,
+    /// A boot protocol mouse.
+    boot: bool,
+    /// Its descriptor did not parse: use the boot protocol report.
+    boot_reports: bool,
+    endpoint: u8,
+    max_packet: u16,
+    layout: Layout,
+}
+
+/// Find a pointer among the device's HID interfaces (not a boot keyboard).
+pub fn find(bus: &mut Bus, device: &Device) -> Option<MouseFunction> {
+    let config = bus
+        .request(
+            device.address,
+            device.max_packet,
+            device.speed,
+            0x80,
+            REQ_GET_DESCRIPTOR,
+            u16::from(DESC_CONFIGURATION) << 8,
+            0,
+            512,
+        )
+        .ok()?;
+    let configuration = *config.get(5)?;
+
+    // (interface, boot mouse, report descriptor length)
+    let mut current: Option<(u8, bool, u16)> = None;
+    let mut candidates = Vec::new();
+    let mut pos = 0;
+    while pos + 2 <= config.len() && config[pos] >= 2 {
+        let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+        match desc[1] {
+            4 if desc.len() >= 9 => {
+                let hid = desc[5] == CLASS_HID && !(desc[6] == SUBCLASS_BOOT && desc[7] == PROTOCOL_KEYBOARD);
+                current = hid.then_some((desc[2], desc[6] == SUBCLASS_BOOT && desc[7] == PROTOCOL_MOUSE, 0));
+            }
+            DESC_HID if desc.len() >= 9 => {
+                if let Some(c) = current.as_mut() {
+                    c.2 = u16::from_le_bytes([desc[7], desc[8]]);
+                }
+            }
+            5 if desc.len() >= 7 => {
+                if let Some((interface, boot, report_len)) = current.take() {
+                    if desc[2] & 0x80 != 0 && desc[3] & 3 == 3 {
+                        candidates.push((interface, boot, report_len, desc[2] & 0x0F, u16::from_le_bytes([desc[4], desc[5]]) & 0x7FF));
+                    }
+                }
+            }
+            _ => {}
+        }
+        pos += desc.len();
+    }
+
+    for (interface, boot, report_len, endpoint, max_packet) in candidates {
+        let report = bus
+            .request(
+                device.address,
+                device.max_packet,
+                device.speed,
+                0x81,
+                REQ_GET_DESCRIPTOR,
+                u16::from(DESC_REPORT) << 8,
+                u16::from(interface),
+                report_len.max(64),
+            )
+            .ok();
+        let (layout, boot_reports) = match report.as_deref().and_then(Layout::parse) {
+            Some(layout) => (layout, false),
+            None if boot => (Layout::boot(), true),
+            None => continue,
+        };
+        return Some(MouseFunction {
+            address: device.address,
+            speed: device.speed,
+            max_packet0: device.max_packet,
+            tt: device.tt,
+            configuration,
+            interface,
+            boot,
+            boot_reports,
+            endpoint,
+            max_packet,
+            layout,
+        });
+    }
+    None
+}
+
+/// Configure the device (unless a keyboard function of it already did) and
+/// the interface for the reports the layout describes.
+pub fn init(bus: &mut Bus, f: &MouseFunction, configure: bool) -> Result<(), Error> {
+    let index = u16::from(f.interface);
+    if configure {
+        bus.request(f.address, f.max_packet0, f.speed, 0x00, REQ_SET_CONFIGURATION, u16::from(f.configuration), 0, 0)?;
+    }
+    // Only boot devices know SET_PROTOCOL; the report protocol is their
+    // default after configuration, but a keyboard function's setup may
+    // have touched the device.
+    if f.boot {
+        let protocol = if f.boot_reports { PROTOCOL_BOOT } else { PROTOCOL_REPORT };
+        bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_PROTOCOL, protocol, index, 0)?;
+    }
+    // Report only on changes. Optional: some mice stall it.
+    let _ = bus.request(f.address, f.max_packet0, f.speed, 0x21, REQ_SET_IDLE, 0, index, 0);
+    Ok(())
+}
+
+impl MouseFunction {
+    pub fn describe(&self) -> String {
+        self.layout.describe()
+    }
+}
+
+pub struct Mouse {
+    hc: Dwc2,
+    f: MouseFunction,
+    buf: Dma<[u8; REPORT_MAX]>,
+    pid: u32,
+    buttons: [bool; 3],
+    position: Option<(i32, i32)>,
+    input: ProducerHandle,
+    next_poll: Instant,
+    /// Print every event (tests without a person).
+    pub log: bool,
+}
+
+impl Mouse {
+    pub fn new(hc: Dwc2, f: MouseFunction) -> Option<Self> {
+        let input = ProducerHandle::new()
+            .inspect_err(|err| println!("dwc2d: cannot open the input scheme: {err}"))
+            .ok()?;
+        Some(Self {
+            hc,
+            f,
+            buf: Dma::new([0; REPORT_MAX]).expect("dwc2d: DMA allocation failed"),
+            pid: PID_DATA0,
+            buttons: [false; 3],
+            position: None,
+            input,
+            next_poll: Instant::now(),
+            log: false,
+        })
+    }
+
+    pub fn address(&self) -> u8 {
+        self.f.address
+    }
+
+    /// Fetch a report when the poll interval has passed and send what
+    /// changed. Errors are dropped: the next poll tries again. Returns the
+    /// time until the next call is due.
+    pub fn poll(&mut self) -> Duration {
+        let now = Instant::now();
+        if now >= self.next_poll {
+            self.next_poll = now + POLL_INTERVAL;
+            self.poll_now();
+        }
+        self.next_poll.saturating_duration_since(Instant::now())
+    }
+
+    fn poll_now(&mut self) {
+        let phase = Phase {
+            dev_addr: self.f.address,
+            endpoint: self.f.endpoint,
+            dir_in: true,
+            ep_type: EPTYPE_INTERRUPT,
+            max_packet: self.f.max_packet,
+            low_speed: self.f.speed == Speed::Low,
+            pid: self.pid,
+            buf_phys: self.buf.physical(),
+            len: usize::from(self.f.max_packet).min(REPORT_MAX),
+        };
+        if let Ok(Some((len, next_pid))) = self.hc.interrupt_in(CHANNEL, &phase, self.f.tt, Duration::from_millis(5)) {
+            self.pid = next_pid;
+            let report = self.buf[..len].to_vec();
+            self.update(&report);
+        }
+    }
+
+    fn update(&mut self, report: &[u8]) {
+        let layout = self.f.layout.clone();
+        let data = match layout.report_id {
+            Some(id) if report.first() != Some(&id) => return,
+            Some(_) => &report[1..],
+            None => report,
+        };
+        let (Some(x), Some(y)) = (layout.x.get(data), layout.y.get(data)) else {
+            return;
+        };
+        if layout.absolute {
+            // inputd and Orbital take 0..=65535 for the whole screen.
+            let scale = |v: i32, f: &Field| {
+                let span = (f.max - f.min).max(1) as i64;
+                ((i64::from(v - f.min).clamp(0, span) * 65535) / span) as i32
+            };
+            let at = (scale(x, &layout.x), scale(y, &layout.y));
+            if self.position != Some(at) {
+                self.position = Some(at);
+                self.send(MouseEvent { x: at.0, y: at.1 }.to_event(), format_args!("move to {} {}", at.0, at.1));
+            }
+        } else if x != 0 || y != 0 {
+            self.send(MouseRelativeEvent { dx: x, dy: y }.to_event(), format_args!("move by {x} {y}"));
+        }
+        if let Some(wheel) = layout.wheel.and_then(|f| f.get(data)).filter(|&w| w != 0) {
+            self.send(ScrollEvent { x: 0, y: wheel }.to_event(), format_args!("wheel {wheel}"));
+        }
+        let buttons = layout.buttons.map(|b| b.and_then(|f| f.get(data)).is_some_and(|v| v != 0));
+        if buttons != self.buttons {
+            self.buttons = buttons;
+            let event = ButtonEvent { left: buttons[0], right: buttons[1], middle: buttons[2] };
+            self.send(event.to_event(), format_args!("buttons {buttons:?}"));
+        }
+    }
+
+    fn send(&mut self, event: orbclient::Event, what: std::fmt::Arguments) {
+        if self.log {
+            println!("dwc2d: mouse: {what}");
+        }
+        let _ = self.input.write_event(event);
+    }
+}
