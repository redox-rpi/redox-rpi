From 4c8462954a359b304561f74a6a1a9494c3d59bc9 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Sat, 31 Oct 2026 16:43:01 +0000
Subject: [PATCH] aarch64: clean and invalidate caches for executable file maps
 and page faults

Two more ways code reaches an executable page without mprotect or exec:
- an fmap with PROT_EXEC: the scheme filled the pages as data;
- a page fault in an executable grant that copies a frame (copy on
  write) or takes a frame from a scheme.
Clean the frame to the point of unification and invalidate the
instruction cache before it is mapped (redox-rpi #3). Fresh zeroed
frames are left alone: exec fills a new program through such faults and
syncs the whole address space at the switch, so a sync per fault only
cost time (QEMU loop 18 % slower instead of 3 %).
---
 src/context/memory.rs | 59 ++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 53 insertions(+), 6 deletions(-)

diff --git a/src/context/memory.rs b/src/context/memory.rs
index 6ffa19b..48c63c7 100644
--- a/src/context/memory.rs
+++ b/src/context/memory.rs
@@ -847,15 +847,33 @@ pub fn clean_dcache_to_pou(mapper: &PageMapper, span: PageSpan) {
         let Some((phys, _)) = mapper.translate(page) else {
             continue;
         };
-        let start = RmmA::phys_to_virt(phys).data();
-        let mut address = start;
-        while address < start + PAGE_SIZE {
-            unsafe { core::arch::asm!("dc cvau, {}", in(reg) address, options(nostack)) };
-            address += line;
-        }
+        clean_frame_to_pou(Frame::containing(phys), line);
+    }
+}
+
+/// Clean one frame to the point of unification through the kernel's linear
+/// mapping; `line` is the smallest data cache line size from `CTR_EL0`.
+#[cfg(target_arch = "aarch64")]
+fn clean_frame_to_pou(frame: Frame, line: usize) {
+    let start = RmmA::phys_to_virt(frame.base()).data();
+    let mut address = start;
+    while address < start + PAGE_SIZE {
+        unsafe { core::arch::asm!("dc cvau, {}", in(reg) address, options(nostack)) };
+        address += line;
     }
 }
 
+/// Clean and invalidate the caches for one frame that is about to be mapped
+/// executable: a frame the kernel just copied on a page fault, or one a
+/// scheme filled.
+#[cfg(target_arch = "aarch64")]
+pub fn sync_icache_frame(frame: Frame) {
+    let ctr: usize;
+    unsafe { core::arch::asm!("mrs {}, ctr_el0", out(reg) ctr, options(nomem, nostack)) };
+    clean_frame_to_pou(frame, 4 << ((ctr >> 16) & 0xf));
+    invalidate_icache();
+}
+
 /// Invalidate all instruction caches of the inner shareable domain. The
 /// Cortex-A53's instruction cache is VIPT and may alias, so invalidating by
 /// address through the linear mapping is not enough.
@@ -1680,6 +1698,12 @@ impl Grant {
                     flusher.queue(frame, None, TlbShootdownActions::NEW_MAPPING);
                 }
             }
+            // The scheme wrote these pages as data (redox-rpi #3).
+            #[cfg(target_arch = "aarch64")]
+            if new_flags.has_execute() {
+                clean_dcache_to_pou(mapper, span);
+                invalidate_icache();
+            }
         }
 
         Ok(Self {
@@ -2687,6 +2711,10 @@ fn correct_inner<'l>(
     // TODO: Readahead backwards, i.e. MAP_GROWSDOWN.
 
     let mut allow_writable = true;
+    // The frame got its contents as data on this fault: copied by the kernel
+    // or supplied by a scheme (redox-rpi #3).
+    #[cfg(target_arch = "aarch64")]
+    let mut filled_as_data = false;
 
     let frame = match grant_info.provider {
         Provider::Allocated { .. } | Provider::AllocatedShared { .. }
@@ -2701,6 +2729,10 @@ fn correct_inner<'l>(
                         let result = cow(frame, info, RefKind::Cow)?;
                         if let Some(old_frame) = result.old_frame {
                             flusher.queue(old_frame, None, TlbShootdownActions::FREE);
+                            #[cfg(target_arch = "aarch64")]
+                            {
+                                filled_as_data = true;
+                            }
                         }
                         result.new_frame
                     }
@@ -2820,6 +2852,10 @@ fn correct_inner<'l>(
                             if let Some(old_frame) = old_frame {
                                 flusher.queue(old_frame, None, TlbShootdownActions::FREE);
                                 flusher.flush();
+                                #[cfg(target_arch = "aarch64")]
+                                {
+                                    filled_as_data = true;
+                                }
                             }
 
                             let mut guard = RwLockUpgradableGuard::upgrade(guard);
@@ -2906,12 +2942,23 @@ fn correct_inner<'l>(
             flusher = Flusher::with_cpu_set(&addr_space_lock.used_by, &addr_space_lock.tlb_ack);
 
             info!("Got frame {:?} from external fmap", frame);
+            #[cfg(target_arch = "aarch64")]
+            {
+                filled_as_data = true;
+            }
 
             frame
         }
     };
 
     let new_flags = grant_flags.write(grant_flags.has_write() && allow_writable);
+    // Fresh zeroed frames need nothing: code written into them later is
+    // either loaded by exec (synced at the switch), made executable by
+    // mprotect, or maintained by the program that writes it.
+    #[cfg(target_arch = "aarch64")]
+    if filled_as_data && new_flags.has_execute() {
+        sync_icache_frame(frame);
+    }
     let Some(flush) = (unsafe {
         addr_space
             .table
