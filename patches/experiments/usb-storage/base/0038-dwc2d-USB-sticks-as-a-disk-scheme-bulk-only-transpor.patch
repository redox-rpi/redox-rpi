diff --git a/drivers/usb/dwc2d/src/storage.rs b/drivers/usb/dwc2d/src/storage.rs
new file mode 100644
index 00000000..260a380d
--- /dev/null
+++ b/drivers/usb/dwc2d/src/storage.rs
@@ -0,0 +1,419 @@
+//! USB mass storage (USB sticks, card readers): bulk-only transport with
+//! SCSI commands, served as a disk scheme through driver-block.
+//!
+//! One command is a command block wrapper (CBW) on the bulk OUT endpoint,
+//! the data on bulk IN or OUT, and a command status wrapper (CSW) on bulk
+//! IN (USB Mass Storage Class Bulk-Only Transport 1.0). Only LUN 0 is used.
+
+use std::time::Duration;
+
+use common::dma::Dma;
+use driver_block::Disk;
+use syscall::error::{Error as SysError, Result as SysResult, EIO, ENODEV};
+
+use crate::dwc2::{Dwc2, Error, Phase, Speed};
+use crate::enumerate::{Bus, Device};
+use crate::regs::{EPTYPE_BULK, PID_DATA0};
+
+const CLASS_MASS_STORAGE: u8 = 0x08;
+const SUBCLASS_SCSI: u8 = 0x06;
+const PROTOCOL_BULK_ONLY: u8 = 0x50;
+
+const REQ_GET_DESCRIPTOR: u8 = 0x06;
+const REQ_SET_CONFIGURATION: u8 = 0x09;
+const REQ_CLEAR_FEATURE: u8 = 0x01;
+const DESC_CONFIGURATION: u8 = 0x02;
+const FEATURE_ENDPOINT_HALT: u16 = 0;
+/// Bulk-Only Mass Storage Reset (BOT 3.1).
+const REQ_BULK_ONLY_RESET: u8 = 0xFF;
+
+const CBW_SIGNATURE: u32 = 0x4342_5355;
+const CSW_SIGNATURE: u32 = 0x5342_5355;
+const CBW_LEN: usize = 31;
+const CSW_LEN: usize = 13;
+
+// SCSI operation codes
+const TEST_UNIT_READY: u8 = 0x00;
+const REQUEST_SENSE: u8 = 0x03;
+const INQUIRY: u8 = 0x12;
+const READ_CAPACITY_10: u8 = 0x25;
+const READ_10: u8 = 0x28;
+const WRITE_10: u8 = 0x2A;
+const READ_16: u8 = 0x88;
+const WRITE_16: u8 = 0x8A;
+const SERVICE_ACTION_IN_16: u8 = 0x9E;
+const READ_CAPACITY_16: u8 = 0x10;
+
+/// The host channels for the stick: 0 does control transfers, the network
+/// adapters use 1 and 2, the keyboard 3.
+const CHANNEL_IN: usize = 4;
+const CHANNEL_OUT: usize = 5;
+/// The largest data stage of one command.
+const MAX_TRANSFER: usize = 64 * 1024;
+/// Sticks may take a while for a write or after a reset.
+const DATA_TIMEOUT: Duration = Duration::from_secs(10);
+const WRAPPER_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// A bulk-only SCSI interface and its endpoints.
+#[derive(Clone)]
+pub struct StorageFunction {
+    pub address: u8,
+    speed: Speed,
+    max_packet0: u16,
+    configuration: u8,
+    interface: u8,
+    ep_in: u8,
+    ep_out: u8,
+    max_packet_in: u16,
+    max_packet_out: u16,
+}
+
+/// Search the first configuration of a device for a bulk-only SCSI
+/// interface.
+pub fn find(bus: &mut Bus, device: &Device) -> Option<StorageFunction> {
+    let config = bus
+        .request(device.address, device.max_packet, device.speed, 0x80, REQ_GET_DESCRIPTOR, u16::from(DESC_CONFIGURATION) << 8, 0, 512)
+        .ok()?;
+    let mut function = None::<StorageFunction>;
+    let mut in_storage = false;
+    let mut pos = 0;
+    while pos + 2 <= config.len() && config[pos] >= 2 {
+        let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+        match desc[1] {
+            4 if desc.len() >= 9 => {
+                in_storage = function.is_none()
+                    && desc[5] == CLASS_MASS_STORAGE
+                    && desc[6] == SUBCLASS_SCSI
+                    && desc[7] == PROTOCOL_BULK_ONLY;
+                if in_storage {
+                    function = Some(StorageFunction {
+                        address: device.address,
+                        speed: device.speed,
+                        max_packet0: device.max_packet,
+                        configuration: config[5],
+                        interface: desc[2],
+                        ep_in: 0,
+                        ep_out: 0,
+                        max_packet_in: 0,
+                        max_packet_out: 0,
+                    });
+                }
+            }
+            5 if desc.len() >= 7 && in_storage && desc[3] & 3 == 2 => {
+                let f = function.as_mut().unwrap();
+                let max_packet = u16::from_le_bytes([desc[4], desc[5]]) & 0x7FF;
+                if desc[2] & 0x80 != 0 {
+                    f.ep_in = desc[2] & 0xF;
+                    f.max_packet_in = max_packet;
+                } else {
+                    f.ep_out = desc[2] & 0xF;
+                    f.max_packet_out = max_packet;
+                }
+            }
+            _ => {}
+        }
+        pos += desc.len();
+    }
+    let function = function.filter(|f| f.ep_in != 0 && f.ep_out != 0)?;
+    // dwc2d has no split bulk transfers: a full-speed stick behind the Pi's
+    // high-speed hubs cannot be reached.
+    if device.tt.is_some() {
+        println!("dwc2d: mass storage at address {}: full speed behind a high-speed hub, not supported", device.address);
+        return None;
+    }
+    Some(function)
+}
+
+/// A USB stick, ready for reads and writes of whole blocks.
+pub struct Stick {
+    hc: Dwc2,
+    f: StorageFunction,
+    tag: u32,
+    in_pid: u32,
+    out_pid: u32,
+    cbw: Dma<[u8; CBW_LEN]>,
+    csw: Dma<[u8; CSW_LEN]>,
+    data: Dma<[u8; MAX_TRANSFER]>,
+    setup: Dma<[u8; 8]>,
+    control: Dma<[u8; 512]>,
+    block_size: u32,
+    blocks: u64,
+    /// Vendor and product from INQUIRY, for the log.
+    pub name: String,
+}
+
+/// How a command ended.
+enum Status {
+    Passed(usize),
+    Failed,
+}
+
+impl Stick {
+    /// Configure the stick and read its size. Waits up to a few seconds
+    /// for a stick that is not ready yet after it was plugged in.
+    pub fn new(bus: &mut Bus, hc: Dwc2, f: StorageFunction) -> Result<Self, Error> {
+        bus.request(f.address, f.max_packet0, f.speed, 0x00, REQ_SET_CONFIGURATION, u16::from(f.configuration), 0, 0)?;
+        let mut stick = Self {
+            hc,
+            f,
+            tag: 1,
+            in_pid: PID_DATA0,
+            out_pid: PID_DATA0,
+            cbw: Dma::new([0; CBW_LEN]).expect("dwc2d: DMA allocation failed"),
+            csw: Dma::new([0; CSW_LEN]).expect("dwc2d: DMA allocation failed"),
+            data: Dma::new([0; MAX_TRANSFER]).expect("dwc2d: DMA allocation failed"),
+            setup: Dma::new([0; 8]).expect("dwc2d: DMA allocation failed"),
+            control: Dma::new([0; 512]).expect("dwc2d: DMA allocation failed"),
+            block_size: 0,
+            blocks: 0,
+            name: String::new(),
+        };
+
+        if let Status::Passed(len) = stick.command(&[INQUIRY, 0, 0, 0, 36, 0], true, 36)? {
+            if len >= 32 {
+                let text = |b: &[u8]| String::from_utf8_lossy(b).trim().to_string();
+                stick.name = format!("{} {}", text(&stick.data[8..16]), text(&stick.data[16..32]));
+            }
+        }
+
+        // A stick reports "not ready" for a while after power-on.
+        let mut ready = false;
+        for _ in 0..50 {
+            if let Status::Passed(_) = stick.command(&[TEST_UNIT_READY, 0, 0, 0, 0, 0], false, 0)? {
+                ready = true;
+                break;
+            }
+            stick.request_sense()?;
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        if !ready {
+            return Err(Error::Timeout("stick not ready"));
+        }
+
+        let Status::Passed(8) = stick.command(&[READ_CAPACITY_10, 0, 0, 0, 0, 0, 0, 0, 0, 0], true, 8)? else {
+            return Err(Error::Timeout("READ CAPACITY failed"));
+        };
+        let last = u32::from_be_bytes(stick.data[0..4].try_into().unwrap());
+        stick.block_size = u32::from_be_bytes(stick.data[4..8].try_into().unwrap());
+        stick.blocks = u64::from(last) + 1;
+        if last == u32::MAX {
+            // Larger than 2 TiB with 512-byte blocks.
+            let mut cdb = [0u8; 16];
+            cdb[0] = SERVICE_ACTION_IN_16;
+            cdb[1] = READ_CAPACITY_16;
+            cdb[13] = 32;
+            let Status::Passed(len) = stick.command(&cdb, true, 32)? else {
+                return Err(Error::Timeout("READ CAPACITY (16) failed"));
+            };
+            if len < 12 {
+                return Err(Error::Timeout("READ CAPACITY (16) too short"));
+            }
+            stick.blocks = u64::from_be_bytes(stick.data[0..8].try_into().unwrap()) + 1;
+            stick.block_size = u32::from_be_bytes(stick.data[8..12].try_into().unwrap());
+        }
+        if stick.block_size == 0 || stick.block_size as usize > MAX_TRANSFER {
+            return Err(Error::Timeout("unusable block size"));
+        }
+        Ok(stick)
+    }
+
+    pub fn size(&self) -> u64 {
+        self.blocks * u64::from(self.block_size)
+    }
+
+    fn phase(&self, dir_in: bool, buf_phys: usize, len: usize) -> Phase {
+        Phase {
+            dev_addr: self.f.address,
+            endpoint: if dir_in { self.f.ep_in } else { self.f.ep_out },
+            dir_in,
+            ep_type: EPTYPE_BULK,
+            max_packet: if dir_in { self.f.max_packet_in } else { self.f.max_packet_out },
+            low_speed: false,
+            pid: if dir_in { self.in_pid } else { self.out_pid },
+            buf_phys,
+            len,
+        }
+    }
+
+    /// One bulk transfer; returns the bytes moved.
+    fn bulk(&mut self, dir_in: bool, buf_phys: usize, len: usize, timeout: Duration) -> Result<usize, Error> {
+        let phase = self.phase(dir_in, buf_phys, len);
+        let channel = if dir_in { CHANNEL_IN } else { CHANNEL_OUT };
+        let (moved, next_pid) = self.hc.transfer_on(channel, &phase, timeout)?;
+        if dir_in {
+            self.in_pid = next_pid;
+        } else {
+            self.out_pid = next_pid;
+        }
+        Ok(moved)
+    }
+
+    fn control_request(&mut self, request_type: u8, request: u8, value: u16, index: u16) -> Result<(), Error> {
+        let [v0, v1] = value.to_le_bytes();
+        let [i0, i1] = index.to_le_bytes();
+        *self.setup = [request_type, request, v0, v1, i0, i1, 0, 0];
+        self.hc
+            .control(self.f.address, self.f.max_packet0, false, None, &mut self.setup, &mut self.control)
+            .map(|_| ())
+    }
+
+    /// Clear a stalled endpoint; its data toggle starts over.
+    fn clear_halt(&mut self, dir_in: bool) -> Result<(), Error> {
+        let endpoint = if dir_in { 0x80 | self.f.ep_in } else { self.f.ep_out };
+        self.control_request(0x02, REQ_CLEAR_FEATURE, FEATURE_ENDPOINT_HALT, u16::from(endpoint))?;
+        if dir_in {
+            self.in_pid = PID_DATA0;
+        } else {
+            self.out_pid = PID_DATA0;
+        }
+        Ok(())
+    }
+
+    /// Reset recovery after a phase error or a stalled command (BOT 5.3.4).
+    fn reset_recovery(&mut self) -> Result<(), Error> {
+        self.control_request(0x21, REQ_BULK_ONLY_RESET, 0, u16::from(self.f.interface))?;
+        self.clear_halt(true)?;
+        self.clear_halt(false)
+    }
+
+    /// Run one SCSI command. The data stage uses `self.data`: filled by the
+    /// caller for `dir_in == false`, by the stick otherwise.
+    fn command(&mut self, cdb: &[u8], dir_in: bool, len: usize) -> Result<Status, Error> {
+        let tag = self.tag;
+        self.tag = self.tag.wrapping_add(1);
+        let mut cbw = [0u8; CBW_LEN];
+        cbw[0..4].copy_from_slice(&CBW_SIGNATURE.to_le_bytes());
+        cbw[4..8].copy_from_slice(&tag.to_le_bytes());
+        cbw[8..12].copy_from_slice(&(len as u32).to_le_bytes());
+        cbw[12] = if dir_in { 0x80 } else { 0 };
+        cbw[14] = cdb.len() as u8;
+        cbw[15..15 + cdb.len()].copy_from_slice(cdb);
+        *self.cbw = cbw;
+
+        let cbw_phys = self.cbw.physical();
+        if let Err(err) = self.bulk(false, cbw_phys, CBW_LEN, WRAPPER_TIMEOUT) {
+            if let Error::Stall = err {
+                self.reset_recovery()?;
+            }
+            return Err(err);
+        }
+
+        let mut moved = 0;
+        if len > 0 {
+            let data_phys = self.data.physical();
+            match self.bulk(dir_in, data_phys, len, DATA_TIMEOUT) {
+                Ok(n) => moved = n,
+                // The stick ends the data stage early with a stall; the
+                // status still follows.
+                Err(Error::Stall) => self.clear_halt(dir_in)?,
+                Err(err) => return Err(err),
+            }
+        }
+
+        let csw_phys = self.csw.physical();
+        let got = match self.bulk(true, csw_phys, CSW_LEN, WRAPPER_TIMEOUT) {
+            Err(Error::Stall) => {
+                self.clear_halt(true)?;
+                self.bulk(true, csw_phys, CSW_LEN, WRAPPER_TIMEOUT)?
+            }
+            other => other?,
+        };
+        let csw = *self.csw;
+        if got != CSW_LEN
+            || u32::from_le_bytes(csw[0..4].try_into().unwrap()) != CSW_SIGNATURE
+            || u32::from_le_bytes(csw[4..8].try_into().unwrap()) != tag
+        {
+            self.reset_recovery()?;
+            return Err(Error::Timeout("bad command status"));
+        }
+        match csw[12] {
+            0 => Ok(Status::Passed(moved)),
+            1 => Ok(Status::Failed),
+            _ => {
+                self.reset_recovery()?;
+                Err(Error::Timeout("phase error"))
+            }
+        }
+    }
+
+    /// Fetch the sense data after a failed command, which also clears it.
+    /// Returns sense key, additional sense code and qualifier.
+    fn request_sense(&mut self) -> Result<(u8, u8, u8), Error> {
+        match self.command(&[REQUEST_SENSE, 0, 0, 0, 18, 0], true, 18)? {
+            Status::Passed(len) if len >= 14 => Ok((self.data[2] & 0xF, self.data[12], self.data[13])),
+            _ => Ok((0, 0, 0)),
+        }
+    }
+
+    /// A READ or WRITE command for `count` blocks at `lba`.
+    fn rw_cdb(write: bool, lba: u64, count: u32) -> ([u8; 16], usize) {
+        let mut cdb = [0u8; 16];
+        if lba + u64::from(count) <= u64::from(u32::MAX) && count <= u32::from(u16::MAX) {
+            cdb[0] = if write { WRITE_10 } else { READ_10 };
+            cdb[2..6].copy_from_slice(&(lba as u32).to_be_bytes());
+            cdb[7..9].copy_from_slice(&(count as u16).to_be_bytes());
+            (cdb, 10)
+        } else {
+            cdb[0] = if write { WRITE_16 } else { READ_16 };
+            cdb[2..10].copy_from_slice(&lba.to_be_bytes());
+            cdb[10..14].copy_from_slice(&count.to_be_bytes());
+            (cdb, 16)
+        }
+    }
+
+    /// Read or write whole blocks starting at `lba`, in chunks of at most
+    /// [`MAX_TRANSFER`] bytes.
+    fn transfer(&mut self, write: bool, lba: u64, mut buf: Option<&mut [u8]>, out: Option<&[u8]>) -> SysResult<usize> {
+        let total = buf.as_ref().map(|b| b.len()).or(out.map(<[u8]>::len)).unwrap_or(0);
+        let block = self.block_size as usize;
+        let per_chunk = MAX_TRANSFER / block * block;
+        let mut done = 0;
+        while done < total {
+            let len = (total - done).min(per_chunk);
+            if len % block != 0 {
+                return Err(SysError::new(EIO));
+            }
+            let at = lba + (done / block) as u64;
+            let (cdb, cdb_len) = Self::rw_cdb(write, at, (len / block) as u32);
+            if let Some(out) = out {
+                self.data[..len].copy_from_slice(&out[done..done + len]);
+            }
+            match self.command(&cdb[..cdb_len], !write, len) {
+                Ok(Status::Passed(moved)) if moved == len => {}
+                Ok(Status::Passed(_)) | Ok(Status::Failed) => {
+                    let sense = self.request_sense().unwrap_or_default();
+                    eprintln!("dwc2d: mass storage: {} at block {at} failed, sense {sense:02x?}", if write { "write" } else { "read" });
+                    return Err(SysError::new(EIO));
+                }
+                // The stick does not answer at all: most likely unplugged.
+                Err(err) => {
+                    eprintln!("dwc2d: mass storage: {err:?}");
+                    return Err(SysError::new(ENODEV));
+                }
+            }
+            if let Some(buf) = buf.as_mut() {
+                buf[done..done + len].copy_from_slice(&self.data[..len]);
+            }
+            done += len;
+        }
+        Ok(done)
+    }
+}
+
+impl Disk for Stick {
+    fn block_size(&self) -> u32 {
+        self.block_size
+    }
+
+    fn size(&self) -> u64 {
+        Stick::size(self)
+    }
+
+    async fn read(&mut self, block: u64, buffer: &mut [u8]) -> SysResult<usize> {
+        self.transfer(false, block, Some(buffer), None)
+    }
+
+    async fn write(&mut self, block: u64, buffer: &[u8]) -> SysResult<usize> {
+        self.transfer(true, block, None, Some(buffer))
+    }
+}
