+fn start_disk(bus: &mut Bus, hc: &Dwc2, f: StorageFunction, events: &EventQueue<Source>) -> Option<UsbDisk> {
+    let address = f.address;
+    let stick = Stick::new(bus, hc.clone(), f)
+        .inspect_err(|err| println!("dwc2d: mass storage at address {address}: {err:?}"))
+        .ok()?;
+    let name = format!("disk.usb-dwc2+{}-scsi", bus.port_path(address));
+    println!(
+        "dwc2d: mass storage /scheme/{name}: {}, {} MiB, {}-byte blocks",
+        stick.name,
+        stick.size() / (1024 * 1024),
+        driver_block::Disk::block_size(&stick)
+    );
+    let scheme = DiskScheme::new(None, name.clone(), [(0, stick)].into(), &FuturesExecutor);
+    events
+        .subscribe(scheme.event_handle().raw(), Source::Disk, event::EventFlags::READ)
+        .expect("dwc2d: failed to subscribe to the disk scheme");
+    Some(UsbDisk { address, name, scheme })
+}
