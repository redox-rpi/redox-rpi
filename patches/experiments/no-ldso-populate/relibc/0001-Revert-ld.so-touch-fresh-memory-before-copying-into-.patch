From 2cdf11ad25251ad90194691930e2dc94c42fa01a Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Wed, 28 Oct 2026 19:01:51 +0000
Subject: [PATCH] Revert "ld.so: touch fresh memory before copying into it
 (aarch64 workaround)"

This reverts commit 3004f4fb377d6f184e3bf4e6a9270788d1ac45e8.
---
 src/ld_so/dso.rs    | 13 -------------
 src/ld_so/linker.rs |  1 -
 2 files changed, 14 deletions(-)

diff --git a/src/ld_so/dso.rs b/src/ld_so/dso.rs
index b840714d..832d82c7 100644
--- a/src/ld_so/dso.rs
+++ b/src/ld_so/dso.rs
@@ -716,7 +716,6 @@ impl DSO {
                     0,
                 )
                 .map_err(|e| format!("failed to map {}. errno: {}", path, e.0))?;
-                populate(ptr.cast::<u8>(), size);
 
                 if !(start as *mut c_void).is_null() {
                     assert_eq!(
@@ -1673,15 +1672,3 @@ pub unsafe fn apply_relr(base: *const u8, relr: &[Relr]) {
 // TODO: Add safety comment.
 unsafe impl Send for DSO {}
 unsafe impl Sync for DSO {}
-
-/// Touch every page of fresh anonymous memory once, before it is written.
-///
-/// Workaround (redox-rpi, docs/debugging-random-crashes.md): on aarch64,
-/// programs whose segments were copied into memory that was populated
-/// lazily, page by page during the copy, sometimes started with corrupted
-/// state. Reading each page first avoids it; the kernel cause is not found yet.
-pub(crate) fn populate(ptr: *const u8, len: usize) {
-    for offset in (0..len).step_by(4096) {
-        unsafe { ptr.add(offset).read_volatile() };
-    }
-}
diff --git a/src/ld_so/linker.rs b/src/ld_so/linker.rs
index 77c96072..1ef106f8 100644
--- a/src/ld_so/linker.rs
+++ b/src/ld_so/linker.rs
@@ -106,7 +106,6 @@ impl MmapFile {
         // contents (redox-rpi docs/debugging-random-crashes.md).
         let anonymous = Self::anonymous(size.max(1))?;
         let ptr = anonymous.ptr;
-        super::dso::populate(ptr.cast::<u8>(), size);
         core::mem::forget(anonymous);
         let this = Self { fd, ptr, size };
         let buf = this.as_mut_slice();
-- 
2.53.0

