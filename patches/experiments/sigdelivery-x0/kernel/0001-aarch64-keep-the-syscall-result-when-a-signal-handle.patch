From 638a95971146af92c0aa57883c4684031d64acc1 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Wed, 28 Oct 2026 07:29:45 +0000
Subject: [PATCH] aarch64: keep the syscall result when a signal handler is set
 up during the syscall

---
 src/arch/aarch64/interrupt/exception.rs |  5 +++++
 src/context/signal.rs                   | 14 ++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/src/arch/aarch64/interrupt/exception.rs b/src/arch/aarch64/interrupt/exception.rs
index 793a6191..c6ec44b1 100644
--- a/src/arch/aarch64/interrupt/exception.rs
+++ b/src/arch/aarch64/interrupt/exception.rs
@@ -190,12 +190,17 @@ exception_stack!(synchronous_exception_at_el0, |stack| {
         match code {
             0b010101 => {
                 let scratch = &stack.scratch;
+                let elr = stack.iret.elr_el1;
                 let mut token = CleanLockToken::new();
                 let ret = syscall::syscall(
                     scratch.x8, scratch.x0, scratch.x1, scratch.x2, scratch.x3, scratch.x4,
                     scratch.x5, &mut token,
                 );
                 stack.scratch.x0 = ret;
+                if stack.iret.elr_el1 != elr {
+                    // A signal handler was set up during the syscall.
+                    crate::context::signal::set_saved_syscall_ret(ret, &mut token);
+                }
             }
 
             ty => {
diff --git a/src/context/signal.rs b/src/context/signal.rs
index 07953e04..cd6215c6 100644
--- a/src/context/signal.rs
+++ b/src/context/signal.rs
@@ -8,6 +8,20 @@ use crate::{
     syscall::flag::SigcontrolFlags,
 };
 
+/// On aarch64, x0 is both the syscall return register and the register that
+/// `signal_handler` saves as `saved_archdep_reg`, which the signal entry in
+/// user space restores. When a signal handler is set up during a syscall, x0
+/// still holds the first argument at that point, and the program would get
+/// it back instead of the syscall's result. Store the result instead.
+#[cfg(target_arch = "aarch64")]
+pub fn set_saved_syscall_ret(ret: usize, token: &mut CleanLockToken) {
+    let context_lock = context::current();
+    let context = context_lock.read(token.token());
+    if let Some((thread_ctl, _, _)) = context.sigcontrol() {
+        thread_ctl.saved_archdep_reg.set(ret);
+    }
+}
+
 pub fn signal_handler(token: &mut CleanLockToken) {
     let context_lock = context::current();
     let context = context_lock.upgradeable_read(token.token());
-- 
2.53.0

