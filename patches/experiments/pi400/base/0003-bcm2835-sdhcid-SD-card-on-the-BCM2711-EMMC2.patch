From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 12 Nov 2026 18:00:00 +0000
Subject: [PATCH] bcm2835-sdhcid: SD card on the BCM2711 EMMC2

On the Pi 4 and Pi 400 the card slot is wired to EMMC2, a standard SDHCI
3.0 controller under /emmc2bus. Use it when the devicetree has a
brcm,bcm2711-emmc2 node: no pin routing, Power Control set to 3.3 V and
bus power on after the reset (the Arasan EMMC needs neither), and the SD
clock divided from the EMMC2 clock (rpi-firmwared, or an assumed 250 MHz
that keeps the card in spec at any lower rate). Started again at boot;
without an EMMC2 node (Pi 3: bcm2835-sdhostd has the card) it reports
ready and exits; the Arasan EMMC only when started by hand with
"arasan". NOP tokens are dropped from the devicetree before parsing:
the fdt crate loses every node after NOPs at the end of a node (QEMU
raspi4b leaves them under avs-monitor, which hid /emmc2bus).
(redox-rpi #307)
---
--- a/drivers/storage/bcm2835-sdhcid/src/main.rs
+++ b/drivers/storage/bcm2835-sdhcid/src/main.rs
@@ -21,13 +21,74 @@
     }
 }
 
+/// QEMU (and libfdt's fdt_nop_node) leave FDT_NOP tokens where a node or
+/// property was deleted. fdt 059bb23 stops walking the tree at NOPs that sit
+/// between a node's last property and its end, and every node after that is
+/// lost (in QEMU raspi4b: the removed thermal node under avs-monitor hides
+/// /emmc2bus). Copy the blob without NOP tokens; return it unchanged if the
+/// layout is not the usual header, reserve map, structure, strings order.
+fn strip_fdt_nops(dtb: &[u8]) -> Vec<u8> {
+    strip_fdt_nops_inner(dtb).unwrap_or_else(|| dtb.to_vec())
+}
+
+fn strip_fdt_nops_inner(dtb: &[u8]) -> Option<Vec<u8>> {
+    let be = |o: usize| -> Option<usize> {
+        Some(u32::from_be_bytes(dtb.get(o..o + 4)?.try_into().ok()?) as usize)
+    };
+    let align4 = |x: usize| (x + 3) & !3;
+    if be(0)? != 0xd00d_feed {
+        return None;
+    }
+    let (off_struct, off_strings) = (be(8)?, be(12)?);
+    let (size_strings, size_struct) = (be(32)?, be(36)?);
+    let end = off_struct.checked_add(size_struct)?;
+    if off_struct % 4 != 0 || off_strings < end || off_strings + size_strings > dtb.len() {
+        return None;
+    }
+    let mut out = dtb[..off_struct].to_vec();
+    let mut p = off_struct;
+    loop {
+        let next = match be(p)? {
+            // FDT_BEGIN_NODE: token, NUL-terminated name, padding
+            1 => align4(p + 4 + dtb.get(p + 4..end)?.iter().position(|&b| b == 0)? + 1),
+            // FDT_PROP: token, length, name offset, value, padding
+            3 => align4(p + 12 + be(p + 4)?),
+            // FDT_END_NODE
+            2 => p + 4,
+            // FDT_NOP: drop it
+            4 => {
+                p += 4;
+                continue;
+            }
+            // FDT_END
+            9 => {
+                out.extend_from_slice(&dtb[p..p + 4]);
+                break;
+            }
+            _ => return None,
+        };
+        if next > end {
+            return None;
+        }
+        out.extend_from_slice(&dtb[p..next]);
+        p = next;
+    }
+    let new_size_struct = out.len() - off_struct;
+    out.extend_from_slice(&dtb[off_strings..off_strings + size_strings]);
+    let total = out.len();
+    out[4..8].copy_from_slice(&(total as u32).to_be_bytes());
+    out[12..16].copy_from_slice(&((off_struct + new_size_struct) as u32).to_be_bytes());
+    out[36..40].copy_from_slice(&(new_size_struct as u32).to_be_bytes());
+    Some(out)
+}
+
