+[unit]
+description = "SD card on EMMC2 (BCM2711: Pi 4, Pi 400)"
+# rpi-firmwared first: the clock divider needs the EMMC2 clock when it is
+# there. On other boards the driver reports ready and exits.
+requires_weak = ["10_inputd.service", "10_lived.service", "20_graphics.target", "40_rpi-firmwared.service"]
+condition_architecture = ["aarch64"]
+condition_board = ["raspi3bp"]
+
+[service]
+cmd = "bcm2835-sdhcid"
+type = "notify"
