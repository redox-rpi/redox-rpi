+/// The CPU address of a register block at `bus_addr`: through the ranges of
+/// /emmc2bus (BCM2711 EMMC2) or /soc.
+fn cpu_address(fdt: &Fdt, bus_addr: usize, emmc2: bool) -> usize {
+    let buses: &[&str] = if emmc2 { &["/emmc2bus", "/soc"] } else { &["/soc"] };
+    for bus in buses {
+        let Some(mut ranges) = fdt.find_node(bus).and_then(|node| node.ranges()) else {
+            continue;
+        };
+        if let Some(range) = ranges.find(|r| {
+            r.child_bus_address <= bus_addr && bus_addr - r.child_bus_address < r.size
+        }) {
+            return range.parent_bus_address + (bus_addr - range.child_bus_address);
+        }
+    }
+    bus_addr
+}
+
+/// The EMMC2 clock from rpi-firmwared (`/scheme/rpi-firmware/clocks`, a line
+/// "emmc2 <now> <max>"), its maximum since U-Boot raises it there; without
+/// it, the assumed highest rate, which keeps the card clock in spec.
+fn emmc2_clock() -> u32 {
+    let from_firmware = std::fs::read_to_string("/scheme/rpi-firmware/clocks")
+        .ok()
+        .and_then(|clocks| {
+            clocks.lines().find_map(|line| {
+                let mut words = line.split_whitespace();
+                if words.next() != Some("emmc2") {
+                    return None;
+                }
+                let now = words.next()?.parse::<u32>().ok()?;
+                let max = words.next()?.parse::<u32>().ok()?;
+                Some(now.max(max))
+            })
+        })
+        .filter(|&rate| rate > 0);
+    match from_firmware {
+        Some(rate) => {
+            println!("bcm2835-sdhcid: EMMC2 clock up to {} MHz", rate / 1_000_000);
+            rate
+        }
+        None => {
+            println!(
+                "bcm2835-sdhcid: no EMMC2 clock from rpi-firmwared, assuming {} MHz",
+                sd::EMMC2_ASSUMED_CLOCK / 1_000_000
+            );
+            sd::EMMC2_ASSUMED_CLOCK
+        }
+    }
+}
+
 /// Connect the SD card slot to this controller.
 ///
 /// The BCM2837 has two SD controllers: this one (Arasan "EMMC") and
--- a/drivers/storage/bcm2835-sdhcid/src/sd/mod.rs
+++ b/drivers/storage/bcm2835-sdhcid/src/sd/mod.rs
@@ -164,6 +164,18 @@
 const EMMC_BASE_CLOCK: u32 = 41_666_666;
 /// The highest clock the firmware can run EMMC at.
 const EMMC_MAX_CLOCK: u32 = 250_000_000;
+/// The clock assumed for EMMC2 (BCM2711) when the firmware does not tell:
+/// U-Boot raises EMMC2 to its maximum before it starts us, and the divisor
+/// for that keeps the card in spec at any lower rate too.
+pub const EMMC2_ASSUMED_CLOCK: u32 = 250_000_000;
+
+/// Power Control (byte 1 of control0) of a standard SDHCI controller: 3.3 V
+/// and SD bus power on. The BCM2835 EMMC (Arasan) has no such register and
+/// powers the card itself; EMMC2 is a standard SDHCI 3.0 controller and
+/// leaves the card unpowered after a reset until this is set.
+const C0_POWER_3V3_ON: u32 = 0x0000_0f00;
+/// Capabilities register: base clock in MHz in bits 15:8.
+const CAPS_OFFSET: usize = 0x40;
 
 /// Attempts for a block transfer, with a reset of the command and data
 /// lines in between.
@@ -233,11 +245,31 @@
     size: u64,
     /// The SD clock in Hz, as set by `set_clock`.
     sd_clock: u32,
+    /// The clock the SD clock is divided from, in Hz.
+    base_clock: u32,
+    /// The highest rate that clock may have been raised to by the boot
+    /// chain; the data clock divisor is picked for it.
+    max_clock: u32,
+    /// Standard SDHCI: switch on SD bus power (EMMC2 on the BCM2711).
+    bus_power: bool,
+    /// Address of the register block, for registers outside the struct.
+    address: usize,
 }
 
 impl SdHostCtrl {
     pub fn new(address: usize) -> Self {
+        Self::with_clock(address, EMMC_BASE_CLOCK, EMMC_MAX_CLOCK, false)
+    }
+
+    /// A controller whose SD clock is divided from `base_clock` (which the
+    /// boot chain may have raised up to `max_clock`); `bus_power` for a
+    /// standard SDHCI controller that needs Power Control set.
+    pub fn with_clock(address: usize, base_clock: u32, max_clock: u32, bus_power: bool) -> Self {
         SdHostCtrl {
+            base_clock,
+            max_clock: max_clock.max(base_clock),
+            bus_power,
+            address,
             regs: RwLock::new(unsafe { &mut *(address as *mut SdHostCtrlRegs) }),
             host_spec_ver: 0,
             cid: [0; 4],
@@ -273,6 +305,21 @@
             return;
         }
         println!("EMMC: reset OK");
+        if self.bus_power {
+            let caps = unsafe { ((self.address + CAPS_OFFSET) as *const u32).read_volatile() };
+            println!(
+                "EMMC: SDHCI version {}, capabilities 0x{:08x} (base clock {} MHz), dividing {} MHz",
+                self.host_spec_ver + 1,
+                caps,
+                (caps >> 8) & 0xff,
+                self.base_clock / 1_000_000
+            );
+            // The reset switched the card off: 3.3 V, bus power on, and give
+            // the card time to come up.
+            regs.control0.write(C0_POWER_3V3_ON);
+            settle(self.sd_clock);
+            wait_msec(10);
+        }
         reg_val = regs.control1.read();
         regs.control1.write(reg_val | C1_CLK_INTLEN | C1_TOUNIT_MAX);
         settle(self.sd_clock);
@@ -375,7 +422,7 @@
         // its 250 MHz maximum before it starts us, and a divisor picked for
         // 41.67 MHz then clocks the card at 62.5 MHz: data CRC errors. Pick
         // the divisor as if it ran at 250 MHz: at most 12.5 MHz either way.
-        let freq = (25_000_000u64 * EMMC_BASE_CLOCK as u64 / EMMC_MAX_CLOCK as u64) as u32;
+        let freq = (25_000_000u64 * self.base_clock as u64 / self.max_clock as u64) as u32;
         if let Err(_) = self.set_clock(freq) {
             println!("failed to set clock {freq} Hz");
             return;
@@ -430,7 +477,8 @@
                 return;
             }
             let regs = self.regs.get_mut().unwrap();
-            regs.control0.write(C0_HCTL_DWITDH);
+            let power = if self.bus_power { C0_POWER_3V3_ON } else { 0 };
+            regs.control0.write(C0_HCTL_DWITDH | power);
             settle(self.sd_clock);
         }
 
@@ -472,7 +520,7 @@
         settle(self.sd_clock);
         wait_msec(10);
 
-        let c = EMMC_BASE_CLOCK / freq;
+        let c = (self.base_clock / freq).max(1);
         let mut x: u32 = c - 1;
         let mut s: u32 = 32;
 
@@ -519,9 +567,9 @@
         }
         println!("sd clk divisor: 0x{:08x}, shift: 0x{:08x}", d, s);
         self.sd_clock = if self.host_spec_ver > HOST_SPEC_V2 {
-            EMMC_BASE_CLOCK / (2 * d)
+            self.base_clock / (2 * d)
