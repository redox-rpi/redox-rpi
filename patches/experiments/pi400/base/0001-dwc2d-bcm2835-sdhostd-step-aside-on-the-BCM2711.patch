From d8acd1e4c594a96fde7d42450237c90531389405 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 9 Nov 2026 15:57:54 +0000
Subject: [PATCH] dwc2d, bcm2835-sdhostd: step aside on the BCM2711

On the Pi 4 and Pi 400 the card slot is wired to EMMC2 (an SDHCI
controller), not to sdhost, and the DWC2 controller is only the USB-C
power port. sdhostd waited forever for a card that is not there, and
dwc2d crashed while parsing the devicetree. Both now report ready and
exit when the root compatible names brcm,bcm2711.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/storage/bcm2835-sdhostd/src/main.rs | 9 +++++++++
 drivers/usb/dwc2d/src/main.rs               | 7 +++++++
 2 files changed, 16 insertions(+)

diff --git a/drivers/storage/bcm2835-sdhostd/src/main.rs b/drivers/storage/bcm2835-sdhostd/src/main.rs
index 7725b894..eee71a2c 100644
--- a/drivers/storage/bcm2835-sdhostd/src/main.rs
+++ b/drivers/storage/bcm2835-sdhostd/src/main.rs
@@ -130,6 +130,15 @@ fn daemon(daemon: Option<daemon::Daemon>) -> ! {
         process::exit(0);
     }
     let fdt = Fdt::new(&dtb_data).unwrap();
+    // On the BCM2711 (Pi 4, Pi 400) the card slot is wired to EMMC2, an
+    // SDHCI controller; sdhost has no card and its pins must stay as they are.
+    if fdt.root().compatible().all().any(|c| c == "brcm,bcm2711") {
+        println!("bcm2835-sdhostd: BCM2711, the card is on EMMC2; not starting");
+        if let Some(daemon) = daemon {
+            daemon.ready();
+        }
+        process::exit(0);
+    }
     let phys = sdhost_phys(&fdt);
     println!("bcm2835-sdhostd: controller at 0x{phys:08x}");
 
diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index a9b077e2..b947ffba 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -432,6 +432,13 @@ fn daemon(daemon: daemon::Daemon) -> ! {
     common::init();
 
     let dtb = get_dtb();
+    // On the BCM2711 (Pi 4, Pi 400) the DWC2 controller is only the USB-C
+    // power port; the USB ports and the keyboard are behind PCIe (VL805).
+    if Fdt::new(&dtb).is_ok_and(|fdt| fdt.root().compatible().all().any(|c| c == "brcm,bcm2711")) {
+        eprintln!("dwc2d: BCM2711, the DWC2 port is the power input; not starting");
+        daemon.ready();
+        process::exit(0);
+    }
     let dt_mac = Fdt::new(&dtb).ok().and_then(|fdt| find_mac(&fdt));
     let led_modes = Fdt::new(&dtb).map(|fdt| find_led_modes(&fdt)).unwrap_or_default();
     let Some((phys, size)) = Fdt::new(&dtb).ok().and_then(|fdt| find_controller(&fdt)) else {
