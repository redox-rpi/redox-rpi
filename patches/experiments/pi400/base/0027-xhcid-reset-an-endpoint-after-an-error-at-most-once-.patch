From d38a694de147e442cb9161e366923398b2fcbccb Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Wed, 25 Nov 2026 17:34:52 +0000
Subject: [PATCH 27/29] xhcid: reset an endpoint after an error at most once a
 second (#749)

A device that answers nothing any more fails every transfer at once,
and its driver retries several times a second. On the Pi 400 a hub
whose endpoint 0 stopped answering after several replugs on one of its
ports got about six Reset Endpoint and Set TR Dequeue Pointer commands
a second, which filled the command ring (pi-tests Test 665). Reset each
endpoint at most once a second; in between its transfers fail or time
out as they would without a reset.

A stall is not limited: it is the device's answer to one request, and
the Pi 400 keyboard stalls SET_INTERFACE for both its interfaces within
a second at boot (pi-tests Test 669).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/usb/xhcid/src/xhci/scheme.rs | 46 +++++++++++++++++++++++++---
 1 file changed, 41 insertions(+), 5 deletions(-)

diff --git a/drivers/usb/xhcid/src/xhci/scheme.rs b/drivers/usb/xhcid/src/xhci/scheme.rs
index 635d6ccc..1ccfddb4 100644
--- a/drivers/usb/xhcid/src/xhci/scheme.rs
+++ b/drivers/usb/xhcid/src/xhci/scheme.rs
@@ -711,7 +711,7 @@ impl<const N: usize> Xhci<N> {
                     // transaction error). Reset it, which also moves the
                     // dequeue pointer past this transfer.
                     warn!("port {}: endpoint 0 not stopped ({}), resetting it", port_num, err);
-                    if let Err(err) = self.recover_default_control_endpoint(port_num).await {
+                    if let Err(err) = self.recover_default_control_endpoint(port_num, true).await {
                         warn!("port {}: endpoint 0 not reset: {}", port_num, err);
                     }
                     return Err(Error::new(ETIMEDOUT));
@@ -741,7 +741,7 @@ impl<const N: usize> Xhci<N> {
             // split transaction or babble error halts it too (section
             // 4.10.2): a hub whose endpoint 0 got one was lost for good
             // (pi-tests Test 662).
-            if let Err(err) = self.recover_default_control_endpoint(port_num).await {
+            if let Err(err) = self.recover_default_control_endpoint(port_num, event_trb.completion_code() != TrbCompletionCode::Stall as u8).await {
                 warn!("port {}: endpoint 0 not recovered after an error: {}", port_num, err);
             }
         }
@@ -851,7 +851,7 @@ impl<const N: usize> Xhci<N> {
             // (the Pi 400 keyboard after a mouse replug, pi-tests Test 662).
             // Reset the endpoint and move its dequeue pointer past this
             // transfer, so the driver's next read works.
-            if let Err(err) = self.recover_endpoint(port_num, endp_num).await {
+            if let Err(err) = self.recover_endpoint(port_num, endp_num, event_trb.completion_code() != TrbCompletionCode::Stall as u8).await {
                 warn!("port {}: endpoint {:?} not recovered after an error: {}", port_num, endp_num, err);
             }
         }
@@ -2598,7 +2598,10 @@ impl<const N: usize> Xhci<N> {
     }
     /// Reset Endpoint on the default control endpoint (DCI 1) after a
     /// stall, then set its dequeue pointer past the stalled transfer.
-    async fn recover_default_control_endpoint(&self, port_num: PortId) -> Result<()> {
+    async fn recover_default_control_endpoint(&self, port_num: PortId, limited: bool) -> Result<()> {
+        if limited && !reset_allowed(port_num, 0) {
+            return Ok(());
+        }
         let slot = self
             .port_states
             .get(&port_num)
@@ -2614,7 +2617,10 @@ impl<const N: usize> Xhci<N> {
     }
     /// Reset Endpoint on a halted endpoint other than endpoint 0, then set
     /// its dequeue pointer to the enqueue pointer, past the failed transfer.
-    async fn recover_endpoint(&self, port_num: PortId, endp_num: EndpNum) -> Result<()> {
+    async fn recover_endpoint(&self, port_num: PortId, endp_num: EndpNum, limited: bool) -> Result<()> {
+        if limited && !reset_allowed(port_num, endp_num.get()) {
+            return Ok(());
+        }
         self.reset_endpoint(port_num, endp_num, false).await?;
         let deque_ptr_and_cycle = {
             let mut port_state = self
@@ -3085,6 +3091,36 @@ pub fn handle_event_trb(name: &str, event_trb: &Trb, command_trb: &Trb) -> Resul
         Err(Error::new(EIO))
     }
 }
+/// Whether an endpoint may be reset after an error now: at most once a
+/// second per endpoint. A device that no longer answers at all fails every
+/// transfer at once, and its driver retries several times a second: a hub
+/// on the Pi 400 after several replugs on one of its ports got about six
+/// Reset Endpoint and Set TR Dequeue Pointer commands a second, which
+/// filled the command ring (pi-tests Test 665). Until the next reset its
+/// transfers fail or time out, as without a reset.
+///
+/// Not for a stall: a stall is the device's answer to one request, and
+/// the next request may come at once. The Pi 400 keyboard stalls
+/// SET_INTERFACE for both its interfaces within a second; with the second
+/// reset held back, its endpoint 0 stayed halted and its next request
+/// timed out after 5 s on every boot (pi-tests Test 669).
+fn reset_allowed(port_num: PortId, endp: u8) -> bool {
+    static LAST: Mutex<Vec<(PortId, u8, std::time::Instant)>> = Mutex::new(Vec::new());
+    let now = std::time::Instant::now();
+    let mut last = LAST.lock().unwrap();
+    match last.iter_mut().find(|(p, e, _)| *p == port_num && *e == endp) {
+        Some((_, _, at)) if now.duration_since(*at) < Duration::from_secs(1) => false,
+        Some((_, _, at)) => {
+            *at = now;
+            true
+        }
+        None => {
+            last.push((port_num, endp, now));
+            true
+        }
+    }
+}
+
 /// Completion codes after which the xHC halts the endpoint (xHCI 1.2
 /// section 4.10.2): it then needs a Reset Endpoint command.
 fn halts_endpoint(completion_code: u8) -> bool {
