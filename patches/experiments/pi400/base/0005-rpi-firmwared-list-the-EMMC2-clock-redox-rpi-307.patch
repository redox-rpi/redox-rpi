From 25585f25ec9c99840cfcad30da47aee793968ea5 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 20 Nov 2026 08:47:30 +0000
Subject: [PATCH] rpi-firmwared: list the EMMC2 clock (redox-rpi #307)

The clocks file never asked the firmware for clock 12, EMMC2, so
bcm2835-sdhcid found no emmc2 line and divided the SD clock from an
assumed 250 MHz, while the controller reports 100 MHz (Test 363).
Boards without the clock answer 0 and stay out of the file.
---
 drivers/rpi-firmwared/src/mbox.rs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/rpi-firmwared/src/mbox.rs b/drivers/rpi-firmwared/src/mbox.rs
index 39ad30e7..d7756c24 100644
--- a/drivers/rpi-firmwared/src/mbox.rs
+++ b/drivers/rpi-firmwared/src/mbox.rs
@@ -62,6 +62,9 @@ pub const CLOCKS: &[(u32, &str)] = &[
     (8, "sdram"),
     (9, "pixel"),
     (10, "pwm"),
+    (11, "hevc"),
+    // BCM2711 only (Pi 4, 400); other boards answer 0 and are left out.
+    (12, "emmc2"),
 ];
 
 pub struct Mailbox {
-- 
2.53.0

