+
+/// A read request handed to a worker thread. The buffer it points to is
+/// the caller's, mapped by the kernel until the response is written, which
+/// the worker does.
+struct BlockingRead(Op, CallerCtx);
+unsafe impl Send for BlockingRead {}
+
+/// The scheme's request loop. It works like scheme_utils::Blocking, one
+/// request after the other, except that a read on an endpoint's data handle
+/// (other than the default control pipe) goes to a worker thread: such a
+/// read waits until the device sends a report. Handled in line, a mouse that
+/// lies still held up every other request, the keyboard's reads and the hub
+/// driver's port polls included (Pi 400, #592).
+fn serve_requests<const N: usize>(socket: &Arc<Socket>, hci: &Arc<Xhci<N>>) -> ! {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    let (sender, receiver) = crossbeam_channel::unbounded::<BlockingRead>();
+    let idle_workers = Arc::new(AtomicUsize::new(0));
+    let mut state = SchemeState::new();
+
+    loop {
+        let request = match socket.next_request(SignalBehavior::Restart) {
+            Ok(Some(request)) => request,
+            Ok(None) => {
+                log::error!("xhcid: scheme socket closed");
+                std::process::exit(1);
+            }
+            Err(err) => panic!("xhcid: failed to read scheme request: {err}"),
+        };
+        let response = match request.kind() {
+            RequestKind::Call(call) => {
+                let caller = call.caller();
+                match call.op() {
+                    Ok(op) => {
+                        let blocking = matches!(&op, Op::Read(read) if hci.is_blocking_data_handle(read.fd));
+                        if blocking {
+                            if idle_workers.load(Ordering::Acquire) == 0 {
+                                spawn_worker(&receiver, socket, hci, &idle_workers);
+                            }
+                            sender
+                                .send(BlockingRead(op, caller))
+                                .expect("xhcid: worker channel closed");
+                            None
+                        } else {
+                            Some(op.handle_sync(caller, &mut &**hci, &mut state))
+                        }
+                    }
+                    Err(call) => Some(Response::new(Err(syscall::Error::new(syscall::ENOSYS)), call)),
+                }
+            }
+            RequestKind::OnClose { id } => {
+                (&**hci).on_close(id);
+                None
+            }
+            RequestKind::SendFd(request) => {
+                let result = (&**hci).on_sendfd(&request);
+                Some(Response::new(result, request))
+            }
+            RequestKind::RecvFd(request) => {
+                let result = (&**hci).on_recvfd(&request);
+                Some(Response::open_dup_like(result, request))
+            }
+            RequestKind::Cancellation(_)
+            | RequestKind::OnDetach { .. }
+            | RequestKind::MsyncMsg
+            | RequestKind::MunmapMsg
+            | RequestKind::MmapMsg => None,
+        };
+        if let Some(response) = response {
+            socket
+                .write_response(response, SignalBehavior::Restart)
+                .expect("xhcid: failed to write scheme response");
+        }
+    }
+}
+
+/// One more worker for blocking reads. Workers stay; a new one starts only
+/// when a read comes in while all of them wait for their devices.
+fn spawn_worker<const N: usize>(
+    receiver: &crossbeam_channel::Receiver<BlockingRead>,
+    socket: &Arc<Socket>,
+    hci: &Arc<Xhci<N>>,
+    idle_workers: &Arc<std::sync::atomic::AtomicUsize>,
+) {
+    use std::sync::atomic::Ordering;
+
+    let receiver = receiver.clone();
+    let socket = Arc::clone(socket);
+    let hci = Arc::clone(hci);
+    let idle_workers = Arc::clone(idle_workers);
+    idle_workers.fetch_add(1, Ordering::AcqRel);
+    std::thread::spawn(move || {
+        let mut state = SchemeState::new();
+        loop {
+            let BlockingRead(op, caller) = match receiver.recv() {
+                Ok(read) => read,
+                Err(_) => return,
+            };
+            idle_workers.fetch_sub(1, Ordering::AcqRel);
+            let response = op.handle_sync(caller, &mut &*hci, &mut state);
+            socket
+                .write_response(response, SignalBehavior::Restart)
+                .expect("xhcid: failed to write scheme response");
+            idle_workers.fetch_add(1, Ordering::AcqRel);
+        }
+    });
 }
 
