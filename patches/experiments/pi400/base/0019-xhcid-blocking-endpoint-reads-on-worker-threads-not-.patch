 }
 
+impl<const N: usize> Xhci<N> {
+    /// Whether `fd` is a data handle of an endpoint other than the default
+    /// control pipe: a read on it waits for the device (an interrupt IN
+    /// endpoint answers only when the device has a report).
+    pub fn is_blocking_data_handle(&self, fd: usize) -> bool {
+        match self.handles.get(&fd) {
+            Some(guard) => matches!(
+                *guard,
+                Handle::Endpoint(_, endp_num, EndpointHandleTy::Data) if endp_num.get() != 0
+            ),
+            None => false,
+        }
+    }
+}
+
 impl<const N: usize> SchemeSync for &Xhci<N> {
     fn scheme_root(&mut self) -> Result<usize> {
         let fd = self.next_handle.fetch_add(1, atomic::Ordering::Relaxed);
@@ -552,6 +567,13 @@ impl<const N: usize> SchemeSync for &Xhci<N> {
             buf.as_ptr(),
             buf.len()
         );
+        // A data read waits until the device sends something, which for an
+        // interrupt endpoint can take as long as the user leaves the mouse
+        // alone. Don't hold the handle table entry while it waits.
+        if let Handle::Endpoint(port_num, endp_num, EndpointHandleTy::Data) = *guard {
+            drop(guard);
+            return block_on(self.on_read_endp_data(port_num, endp_num, buf));
+        }
         match &mut *guard {
             Handle::TopLevel(ref src_buf)
             | Handle::Port(_, ref src_buf)
