From a5d0149b58212b93edc6dd45e1810aca213d65ec Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Wed, 25 Nov 2026 16:36:49 +0000
Subject: [PATCH 25/25] usbhidd: a failed report read is tried again, not the
 end of the driver (#749)

usbhidd ended its report loop on the first failed interrupt read. A
split transaction error while another device on the same hub is
replugged then left the keyboard without a reader until it was
replugged itself. Log the error and read again after 100 ms; xhcid now
resets the halted endpoint. When the device is gone, usbhubd ends the
driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/usbhidd/src/main.rs | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/input/usbhidd/src/main.rs b/drivers/input/usbhidd/src/main.rs
index 86b8f63f..d2cfd7ed 100644
--- a/drivers/input/usbhidd/src/main.rs
+++ b/drivers/input/usbhidd/src/main.rs
@@ -441,9 +441,16 @@ fn main() -> Result<()> {
 
         if let Some(endpoint) = &mut endpoint_opt {
             // interrupt transfer
-            endpoint
-                .transfer_read(&mut report_buffer)
-                .context("failed to get report")?;
+            if let Err(err) = endpoint.transfer_read(&mut report_buffer) {
+                // One failed read (a split transaction error while another
+                // device on the same hub is replugged; xhcid resets the
+                // endpoint) must not end the driver: it would leave the
+                // device without a reader until the next replug (#749).
+                // When the device is gone, usbhubd ends this process.
+                log::warn!("failed to get report: {}, trying again", err);
+                thread::sleep(time::Duration::from_millis(100));
+                continue;
+            }
         } else {
             // control transfer
             reqs::get_report(
