--- a/drivers/hwd/src/main.rs
+++ b/drivers/hwd/src/main.rs
@@ -37,8 +37,11 @@ fn daemon(daemon: daemon::Daemon) -> ! {
 
     //TODO: launch pcid based on backend information?
     // Must launch after acpid but before probe calls /scheme/acpi/symbols
-    // The Raspberry Pi 3 has no PCI bus
-    if option_env!("BOARD") != Some("raspi3bp") {
+    // The Raspberry Pi 3 has no PCI bus. Our images are built with
+    // BOARD=raspi3bp for the whole Pi family, so look for the Pi 4's PCIe
+    // bridge in the devicetree too (a byte search: hwd's devicetree walk
+    // fails on some trees).
