From 48091897b0faccc9f826433191466128f3d65b09 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Mon, 16 Nov 2026 08:17:36 +0000
Subject: [PATCH] xhcid: go on after a stalled SET_INTERFACE and recover
 endpoint 0

After Configure Endpoint, xhcid sends SET_INTERFACE for the interface
the driver asked for. An interface with a single alternate setting may
stall it (USB 2.0 section 9.4.10); the Pi 400's keyboard does for its
second interface, and that usbhidd exited at "Failed to configure
endpoints" (test 452). As Linux's usb_set_interface does, the stall is
now taken as success when the interface has only alternate setting 0.

A STALL also halts the default control endpoint (xHCI 1.2 section
4.8.3), so every later request on it failed. execute_control_transfer
now resets endpoint 0 after a stall (Reset Endpoint, then Set TR
Dequeue Pointer past the stalled transfer), so the next request works.
restart_endpoint and set_tr_deque_ptr cannot be used for it: they look
the endpoint up in the configuration, where endpoint 0 is not.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/usb/xhcid/src/xhci/scheme.rs | 91 +++++++++++++++++++++++++++-
 1 file changed, 89 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/xhcid/src/xhci/scheme.rs b/drivers/usb/xhcid/src/xhci/scheme.rs
index 01fece53..9bbe847d 100644
--- a/drivers/usb/xhcid/src/xhci/scheme.rs
+++ b/drivers/usb/xhcid/src/xhci/scheme.rs
@@ -687,6 +687,17 @@ impl<const N: usize> Xhci<N> {
         let event_trb = trbs.event_trb;
         let status_trb = trbs.src_trb.ok_or(Error::new(EIO))?;
 
+        if event_trb.completion_code() == TrbCompletionCode::Stall as u8 {
+            // A STALL halts the default control endpoint (xHCI 1.2 section
+            // 4.8.3), and every later request on it would fail. A device
+            // stalls a request it does not support (a single alternate
+            // setting's SET_INTERFACE, SET_IDLE); the next one must still
+            // work. Reset and restart it, as Linux does.
+            if let Err(err) = self.recover_default_control_endpoint(port_num).await {
+                warn!("port {}: endpoint 0 not recovered after a stall: {}", port_num, err);
+            }
+        }
+
         handle_transfer_event_trb("CONTROL_TRANSFER", &event_trb, &status_trb)?;
 
         //self.event_handler_finished();
@@ -1242,8 +1253,42 @@ impl<const N: usize> Xhci<N> {
 
         if let Some(interface_num) = req.interface_desc {
             if let Some(alternate_setting) = req.alternate_setting {
-                self.set_interface(port, interface_num, alternate_setting)
-                    .await?;
+                // An interface with a single alternate setting may stall
+                // SET_INTERFACE (USB 2.0 section 9.4.10); the Pi 400's
+                // keyboard does for its second interface (test 452). Linux
+                // (usb_set_interface) takes that as success, and so does
+                // this: alternate setting 0 is the only one there is.
+                let alternates = {
+                    let port_state = self.port_states.get(&port).ok_or(Error::new(EBADFD))?;
+                    port_state
+                        .dev_desc
+                        .as_ref()
+                        .and_then(|dev| {
+                            dev.config_descs
+                                .iter()
+                                .find(|desc| desc.configuration_value == req.config_desc)
+                        })
+                        .map_or(0, |config| {
+                            config
+                                .interface_descs
+                                .iter()
+                                .filter(|if_desc| if_desc.number == interface_num)
+                                .count()
+                        })
+                };
+                match self
+                    .set_interface(port, interface_num, alternate_setting)
+                    .await
+                {
+                    Ok(()) => {}
+                    Err(err) if alternates == 1 && alternate_setting == 0 => {
+                        warn!(
+                            "port {}: SET_INTERFACE {} refused ({}); it has one alternate setting, going on",
+                            port, interface_num, err
+                        );
+                    }
+                    Err(err) => return Err(err),
+                }
             }
         }
 
@@ -2467,6 +2512,48 @@ impl<const N: usize> Xhci<N> {
         }
         Ok(())
     }
+    /// Reset Endpoint on the default control endpoint (DCI 1) after a
+    /// stall, then set its dequeue pointer past the stalled transfer.
+    async fn recover_default_control_endpoint(&self, port_num: PortId) -> Result<()> {
+        let slot = self
+            .port_states
+            .get(&port_num)
+            .ok_or(Error::new(EBADFD))?
+            .slot;
+        let (event_trb, command_trb) = self
+            .execute_command(|trb, cycle| {
+                trb.reset_endpoint(slot, 1, false, cycle);
+            })
+            .await;
+        handle_event_trb("RESET_ENDPOINT", &event_trb, &command_trb)?;
+        // `restart_endpoint` and `set_tr_deque_ptr` look the endpoint up in
+        // the configuration, where endpoint 0 is not; DCI 1 is its index.
+        let deque_ptr_and_cycle = {
+            let mut port_state = self
+                .port_states
+                .get_mut(&port_num)
+                .ok_or(Error::new(EBADFD))?;
+            let mut endpoint_state = port_state
+                .endpoint_states
+                .get_mut(&EndpNum::new(0))
+                .ok_or(Error::new(EIO))?;
+            endpoint_state.ring().ok_or(Error::new(EIO))?.register()
+        };
+        let (event_trb, command_trb) = self
+            .execute_command(|trb, cycle| {
+                // No streams on endpoint 0: stream ID 0, SCT ignored.
+                trb.set_tr_deque_ptr(
+                    deque_ptr_and_cycle,
+                    cycle,
+                    StreamContextType::SecondaryRing,
+                    0,
+                    1,
+                    slot,
+                )
+            })
+            .await;
+        handle_event_trb("SET_TR_DEQUEUE_PTR", &event_trb, &command_trb)
+    }
     pub async fn restart_endpoint(&self, port_num: PortId, endp_num: EndpNum) -> Result<()> {
         let mut port_state = self
             .port_states
-- 
2.53.0

