From 19eb715d6cd369892c93571a5f024350a81476f0 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 29 Oct 2026 11:33:40 +0100
Subject: [PATCH] bcm2835-gpiod: spin instead of sleeping while the pull
 setting settles
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A 10 µs nanosleep never returned in QEMU, so writing a pull hung.

Refs #38

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bcm2835-gpiod/src/gpio.rs | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/drivers/bcm2835-gpiod/src/gpio.rs b/drivers/bcm2835-gpiod/src/gpio.rs
index 4cfa52a..8128ca7 100644
--- a/drivers/bcm2835-gpiod/src/gpio.rs
+++ b/drivers/bcm2835-gpiod/src/gpio.rs
@@ -1,8 +1,7 @@
 //! The GPIO registers of the BCM2835 and BCM2837 (BCM2835 ARM Peripherals,
 //! chapter 6).
 
-use std::thread::sleep;
-use std::time::Duration;
+use std::time::{Duration, Instant};
 
 pub const PINS: u32 = 54;
 
@@ -145,14 +144,24 @@ impl Gpio {
     pub fn set_pull(&self, pin: u32, pull: Pull) {
         let (reg, bit) = Self::bank(GPPUDCLK0, pin);
         self.write(GPPUD, pull as u32);
-        sleep(Duration::from_micros(10));
+        settle();
         self.write(reg, bit);
-        sleep(Duration::from_micros(10));
+        settle();
         self.write(GPPUD, 0);
         self.write(reg, 0);
     }
 }
 
+/// The 150 cycles the pull control signal needs to settle (BCM2835 ARM
+/// Peripherals, GPPUDCLK), as 10 µs. A spin, not a sleep: in QEMU a 10 µs
+/// `nanosleep` did not come back.
+fn settle() {
+    let end = Instant::now() + Duration::from_micros(10);
+    while Instant::now() < end {
+        std::hint::spin_loop();
+    }
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
