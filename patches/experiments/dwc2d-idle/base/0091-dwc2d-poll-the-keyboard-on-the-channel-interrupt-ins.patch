     /// halts. Returns the HCINT bits. Interrupt endpoints go out in the next
     /// (micro)frame.
     fn packet(&self, ch: usize, phase: &Phase, hcsplt_value: u32, timeout: Duration) -> Result<u32, Error> {
+        self.start_packet(ch, phase, hcsplt_value);
+
+        let start = Instant::now();
+        loop {
+            if let Some(status) = self.halted(ch) {
+                return Ok(status);
+            }
+            if start.elapsed() > timeout {
+                let value = self.read(hcchar(ch));
+                self.write(hcchar(ch), value | HCCHAR_CHDIS);
+                return Err(Error::Timeout("channel halt"));
+            }
+            std::hint::spin_loop();
+        }
+    }
+
+    /// The HCINT bits of a channel once it has halted, cleared; `None`
