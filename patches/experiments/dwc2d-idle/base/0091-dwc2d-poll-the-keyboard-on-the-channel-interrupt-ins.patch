diff --git a/drivers/usb/dwc2d/src/hid.rs b/drivers/usb/dwc2d/src/hid.rs
index 7e55d02a..1b840641 100644
--- a/drivers/usb/dwc2d/src/hid.rs
+++ b/drivers/usb/dwc2d/src/hid.rs
@@ -25,8 +25,11 @@ const PROTOCOL_BOOT: u16 = 0;
 
 /// The host channel for keyboard reports; 0 does control transfers, the
 /// network adapters use 1 and 2.
-const CHANNEL: usize = 3;
+pub const CHANNEL: usize = 3;
 const POLL_INTERVAL: Duration = Duration::from_millis(10);
+/// A poll whose channel has not halted by then (a lost interrupt) is
+/// stopped, and the next one starts.
+const POLL_TIMEOUT: Duration = Duration::from_millis(50);
 /// Auto-repeat of a held key, as keyboards in the boot protocol leave it to
 /// the host.
 const REPEAT_DELAY: Duration = Duration::from_millis(500);
@@ -104,6 +107,29 @@ pub fn init(bus: &mut Bus, f: &KeyboardFunction) -> Result<(), Error> {
     Ok(())
 }
 
+/// Where the running poll is, when the channel's halt raises the
+/// controller's interrupt.
+#[derive(Clone, Copy, PartialEq)]
+enum Stage {
+    Idle,
+    /// The IN packet, or the start split to the keyboard's hub, is out.
+    Start,
+    /// The complete split that fetches the hub's result is out.
+    Complete,
+}
+
+/// Counts for `/tmp/dwc2d-wakeups`.
+#[derive(Clone, Copy, Default)]
+pub struct Stats {
+    pub polls: u64,
+    pub reports: u64,
+    /// Polls stopped after [`POLL_TIMEOUT`].
+    pub timeouts: u64,
+    /// Time spent starting polls, including the wait for the start split
+    /// window.
+    pub start_busy: Duration,
+}
+
 pub struct Keyboard {
     hc: Dwc2,
     f: KeyboardFunction,
@@ -115,6 +141,12 @@ pub struct Keyboard {
     next_poll: Instant,
     /// The key that repeats while held and when it repeats next.
     repeat: Option<(u8, Instant)>,
+    /// Whether the channel's halt raises the controller's interrupt; if
+    /// not, each poll waits for its channel.
+    use_irq: bool,
+    stage: Stage,
+    started: Instant,
+    pub stats: Stats,
 }
 
 impl Keyboard {
@@ -131,6 +163,10 @@ impl Keyboard {
             input,
             next_poll: Instant::now(),
             repeat: None,
+            use_irq: false,
+            stage: Stage::Idle,
+            started: Instant::now(),
+            stats: Stats::default(),
         })
     }
 
@@ -138,6 +174,12 @@ impl Keyboard {
         self.f.address
     }
 
+    /// Wait for the poll's channel on the controller's interrupt (see
+    /// [`Keyboard::interrupt`]) instead of spinning on it.
+    pub fn use_interrupt(&mut self, on: bool) {
+        self.use_irq = on;
+    }
+
     /// Fetch a report when the poll interval has passed and send the key
     /// changes. Errors are dropped: the next poll tries again.
     /// Poll the keyboard and repeat a held key when due. Returns the time
@@ -159,12 +201,80 @@ impl Keyboard {
                 self.repeat = Some((key, now + REPEAT_INTERVAL));
             }
         }
-        if now < self.next_poll {
+        if self.stage != Stage::Idle {
+            // The interrupt may have been lost: look at the channel, and
+            // stop a poll that takes far too long.
+            self.interrupt();
+            if self.stage != Stage::Idle && now.duration_since(self.started) > POLL_TIMEOUT {
+                self.hc.halt(CHANNEL);
+                self.stage = Stage::Idle;
+                self.stats.timeouts += 1;
+            }
+        }
+        if now < self.next_poll || self.stage != Stage::Idle {
             return;
         }
         self.next_poll = now + POLL_INTERVAL;
+        self.stats.polls += 1;
+
+        if self.use_irq {
+            // Only start the transfer; its channel's halt raises the
+            // interrupt, see [`Keyboard::interrupt`].
+            let phase = self.phase();
+            match self.f.tt {
+                Some(tt) => {
+                    self.hc.wait_split_window();
+                    self.hc.start_packet(CHANNEL, &phase, Dwc2::split_value(tt, false));
+                }
+                None => self.hc.start_packet(CHANNEL, &phase, 0),
+            }
+            self.stage = Stage::Start;
+            self.started = now;
+            self.stats.start_busy += now.elapsed();
+            return;
+        }
+
+        let phase = self.phase();
+        match self.hc.interrupt_in(CHANNEL, &phase, self.f.tt, Duration::from_millis(5)) {
+            Ok(Some((len, next_pid))) => self.received(len, next_pid),
+            Ok(None) | Err(_) => {}
+        }
+    }
 
-        let phase = Phase {
+    /// The channel of a running poll may have halted: take its result, or
+    /// send the complete split once the hub has the start split. Called on
+    /// the controller's interrupt and from the timer.
+    pub fn interrupt(&mut self) {
+        if self.stage == Stage::Idle {
+            return;
+        }
+        let Some(status) = self.hc.halted(CHANNEL) else {
+            return;
+        };
+        if let Some(tt) = self.f.tt {
+            let complete = match self.stage {
+                // The hub took the start split.
+                Stage::Start => status & HCINT_ACK != 0,
+                // The hub has no result yet.
+                _ => status & HCINT_NYET != 0,
+            };
+            if complete {
+                self.hc.start_packet(CHANNEL, &self.phase(), Dwc2::split_value(tt, true));
+                self.stage = Stage::Complete;
+                return;
+            }
+        }
+        // Otherwise the poll is over: data, or a NAK (no key change),
+        // stall or error, which the next poll tries again.
+        self.stage = Stage::Idle;
+        if status & HCINT_XFER_COMPL != 0 {
+            let (len, next_pid) = self.hc.moved(CHANNEL, self.phase().len);
+            self.received(len, next_pid);
+        }
+    }
+
+    fn phase(&self) -> Phase {
+        Phase {
             dev_addr: self.f.address,
             endpoint: self.f.endpoint,
             dir_in: true,
@@ -174,17 +284,16 @@ impl Keyboard {
             pid: self.pid,
             buf_phys: self.buf.physical(),
             len: usize::from(self.f.max_packet).min(8),
-        };
-        match self.hc.interrupt_in(CHANNEL, &phase, self.f.tt, Duration::from_millis(5)) {
-            Ok(Some((len, next_pid))) => {
-                self.pid = next_pid;
-                if len >= 3 {
-                    let mut report = [0; 8];
-                    report[..len].copy_from_slice(&self.buf[..len]);
-                    self.update(report);
-                }
-            }
-            Ok(None) | Err(_) => {}
+        }
+    }
+
+    fn received(&mut self, len: usize, next_pid: u32) {
+        self.pid = next_pid;
+        if len >= 3 {
+            self.stats.reports += 1;
+            let mut report = [0; 8];
+            report[..len].copy_from_slice(&self.buf[..len]);
+            self.update(report);
         }
     }
 
