+        let value = HCSPLT_SPLTENA | HCSPLT_XACTPOS_ALL | (u32::from(tt.0) << HCSPLT_HUBADDR_SHIFT) | u32::from(tt.1);
+        if complete {
+            value | HCSPLT_COMPSPLT
+        } else {
+            value
+        }
+    }
+
+    /// Wait until a periodic start split may go out: not in the last
+    /// microframes, which leave the hub too little of the frame for the
+    /// transaction.
+    pub fn wait_split_window(&self) {
