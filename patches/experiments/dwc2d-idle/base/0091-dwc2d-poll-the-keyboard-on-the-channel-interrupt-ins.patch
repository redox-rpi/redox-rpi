+            std::hint::spin_loop();
+        }
+    }
+
+    /// Program a single packet like [`Dwc2::packet`] and enable the
+    /// channel without waiting for it; see [`Dwc2::halted`].
+    pub fn start_packet(&self, ch: usize, phase: &Phase, hcsplt_value: u32) {
         self.write(hcint(ch), u32::MAX);
         self.write(hcsplt(ch), hcsplt_value);
         self.write(
@@ -282,26 +333,11 @@ impl Dwc2 {
