+/// The first interrupt IN endpoint in a configuration descriptor: number
+/// and max packet size.
+fn interrupt_in_endpoint(config: &[u8]) -> Option<(u8, u16)> {
+    let mut pos = 0;
+    while pos + 2 <= config.len() && config[pos] >= 2 {
+        let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+        if desc[1] == 5 && desc.len() >= 7 && desc[2] & 0x80 != 0 && desc[3] & 3 == 3 {
+            return Some((desc[2] & 0x0F, u16::from_le_bytes([desc[4], desc[5]]) & 0x7FF));
+        }
+        pos += desc.len();
+    }
+    None
+}
