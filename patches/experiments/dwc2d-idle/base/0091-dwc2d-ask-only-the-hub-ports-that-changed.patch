+    /// The ports with a status change, as a bitmap (bit n for port n), from
+    /// the hub's status change endpoint; `None` when the hub can't tell (no
+    /// such endpoint, an error), so all ports are asked.
+    fn hub_changes(&mut self, hub: Hub) -> Option<u32> {
+        let (endpoint, max_packet) = hub.status_endpoint?;
+        let len = usize::from(max_packet).min(4).min(usize::from(hub.ports) / 8 + 1);
+        let pid = self.hub_pids.get(&hub.address).copied().unwrap_or(PID_DATA0);
+        let phase = Phase {
+            dev_addr: hub.address,
+            endpoint,
+            dir_in: true,
+            ep_type: EPTYPE_INTERRUPT,
+            max_packet,
+            low_speed: false,
+            pid,
+            buf_phys: self.data.physical(),
+            len,
+        };
+        match self.hc.interrupt_in(HUB_STATUS_CHANNEL, &phase, hub.tt, Duration::from_millis(5)) {
+            // NAK: nothing changed.
+            Ok(None) => {
+                HUB_STATUS[1].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                Some(0)
+            }
+            Ok(Some((moved, next_pid))) => {
+                HUB_STATUS[0].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                self.hub_pids.insert(hub.address, next_pid);
+                let mut bits = [0; 4];
+                bits[..moved.min(4)].copy_from_slice(&self.data[..moved.min(4)]);
+                Some(u32::from_le_bytes(bits))
+            }
+            Err(_) => {
+                HUB_STATUS[2].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                None
+            }
+        }
+    }
