+/// Class, subclass and protocol of each interface descriptor (alternate
+/// setting 0) in a configuration.
+fn interfaces(config: &[u8]) -> Vec<(u8, u8, u8)> {
+    let mut found = Vec::new();
+    let mut pos = 0;
+    while pos + 2 <= config.len() && config[pos] >= 2 {
+        let desc = &config[pos..(pos + config[pos] as usize).min(config.len())];
+        if desc[1] == 4 && desc.len() >= 9 && desc[3] == 0 {
+            found.push((desc[5], desc[6], desc[7]));
+        }
+        pos += desc.len();
+    }
+    found
+}
