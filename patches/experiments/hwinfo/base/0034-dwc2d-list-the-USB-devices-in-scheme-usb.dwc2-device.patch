diff --git a/drivers/usb/dwc2d/src/usbinfo.rs b/drivers/usb/dwc2d/src/usbinfo.rs
new file mode 100644
index 0000000..7fcbeef
--- /dev/null
+++ b/drivers/usb/dwc2d/src/usbinfo.rs
@@ -0,0 +1,191 @@
+//! `/scheme/usb.dwc2/devices`: the devices found during enumeration, for
+//! `lsusb`. Read-only, one line per device:
+//!
+//! ```text
+//! address hub port vendor product class usb speed interfaces
+//! 2 1 1 0424 7800 ff 0210 high ff.00.ff
+//! ```
+//!
+//! `hub` and `port` are 0 for the device on the root port. Numbers are
+//! hexadecimal except address, hub and port; `interfaces` lists class,
+//! subclass and protocol of each interface, separated by commas, or `-`.
+//!
+//! `set` replaces the list after the boot enumeration and after each
+//! hotplug scan that found a change; the first call starts the scheme.
+
+use std::fmt::Write as _;
+use std::sync::{Arc, Mutex, OnceLock};
+use std::thread;
+
+use redox_scheme::scheme::{register_sync_scheme, SchemeSync};
+use redox_scheme::{CallerCtx, OpenResult, Socket};
+use scheme_utils::{Blocking, FpathWriter, HandleMap};
+use syscall::dirent::{DirEntry, DirentBuf, DirentKind};
+use syscall::error::{Error, Result, EACCES, EBADF, EISDIR, ENOENT, ENOTDIR, EROFS};
+use syscall::schemev2::NewFdFlags;
+use syscall::{MODE_DIR, MODE_FILE, O_WRONLY};
+
+use crate::dwc2::Speed;
+use crate::enumerate::Device;
+
+const SCHEME: &str = "usb.dwc2";
+
+static DEVICES: OnceLock<Arc<Mutex<String>>> = OnceLock::new();
+
+/// Replaces the device list; the first call starts serving it from its own
+/// thread.
+pub fn set(devices: &[Device]) {
+    let text = format(devices);
+    if let Some(shared) = DEVICES.get() {
+        *shared.lock().unwrap() = text;
+        return;
+    }
+    let shared = Arc::new(Mutex::new(text));
+    let _ = DEVICES.set(shared.clone());
+    thread::spawn(move || {
+        let socket = match Socket::create() {
+            Ok(socket) => socket,
+            Err(err) => return eprintln!("dwc2d: cannot create the {SCHEME} scheme: {err}"),
+        };
+        let mut scheme = InfoScheme {
+            devices: shared,
+            handles: HandleMap::new(),
+        };
+        if let Err(err) = register_sync_scheme(&socket, SCHEME, &mut scheme) {
+            return eprintln!("dwc2d: cannot register the {SCHEME} scheme: {err}");
+        }
+        let handler = Blocking::new(Box::new(socket), 16);
+        if let Err(err) = handler.process_requests_blocking(scheme) {
+            eprintln!("dwc2d: {SCHEME} scheme failed: {err}");
+        }
+    });
+}
+
+fn format(devices: &[Device]) -> String {
+    let mut text = String::new();
+    for device in devices {
+        let (hub, port) = device.parent.unwrap_or((0, 0));
+        let speed = match device.speed {
+            Speed::High => "high",
+            Speed::Full => "full",
+            Speed::Low => "low",
+        };
+        let interfaces: Vec<String> = device
+            .interfaces
+            .iter()
+            .map(|(class, subclass, protocol)| format!("{class:02x}.{subclass:02x}.{protocol:02x}"))
+            .collect();
+        let interfaces = if interfaces.is_empty() { "-".to_string() } else { interfaces.join(",") };
+        let _ = writeln!(
+            text,
+            "{} {hub} {port} {:04x} {:04x} {:02x} {:04x} {speed} {interfaces}",
+            device.address, device.vendor, device.product, device.class, device.usb
+        );
+    }
+    text
+}
+
+enum Handle {
+    Root,
+    Dir,
+    /// The list as it was when the file was opened.
+    File(Vec<u8>),
+}
+
+struct InfoScheme {
+    devices: Arc<Mutex<String>>,
+    handles: HandleMap<Handle>,
+}
+
+impl SchemeSync for InfoScheme {
+    fn scheme_root(&mut self) -> Result<usize> {
+        Ok(self.handles.insert(Handle::Root))
+    }
+
+    fn openat(
+        &mut self,
+        dirfd: usize,
+        path: &str,
+        flags: usize,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<OpenResult> {
+        if !matches!(self.handles.get(dirfd)?, Handle::Root) {
+            return Err(Error::new(EACCES));
+        }
+        let handle = match path.trim_matches('/') {
+            "" => Handle::Dir,
+            "devices" if flags & O_WRONLY != 0 => return Err(Error::new(EROFS)),
+            "devices" => Handle::File(self.devices.lock().unwrap().clone().into_bytes()),
+            _ => return Err(Error::new(ENOENT)),
+        };
+        Ok(OpenResult::ThisScheme {
+            number: self.handles.insert(handle),
+            flags: NewFdFlags::POSITIONED,
+        })
+    }
+
+    fn read(
+        &mut self,
+        id: usize,
+        buf: &mut [u8],
+        offset: u64,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<usize> {
+        let Handle::File(data) = self.handles.get(id)? else {
+            return Err(Error::new(EISDIR));
+        };
+        let start = usize::try_from(offset).unwrap_or(usize::MAX).min(data.len());
+        let len = buf.len().min(data.len() - start);
+        buf[..len].copy_from_slice(&data[start..start + len]);
+        Ok(len)
+    }
+
+    fn getdents<'buf>(
+        &mut self,
+        id: usize,
+        mut buf: DirentBuf<&'buf mut [u8]>,
+        opaque_offset: u64,
+    ) -> Result<DirentBuf<&'buf mut [u8]>> {
+        if !matches!(self.handles.get(id)?, Handle::Dir) {
+            return Err(Error::new(ENOTDIR));
+        }
+        if opaque_offset == 0 {
+            buf.entry(DirEntry {
+                inode: 0,
+                name: "devices",
+                kind: DirentKind::Regular,
+                next_opaque_id: 1,
+            })?;
+        }
+        Ok(buf)
+    }
+
+    fn fstat(&mut self, id: usize, stat: &mut syscall::Stat, _ctx: &CallerCtx) -> Result<()> {
+        match self.handles.get(id)? {
+            Handle::File(data) => {
+                stat.st_mode = 0o444 | MODE_FILE;
+                stat.st_size = data.len() as u64;
+            }
+            Handle::Dir | Handle::Root => stat.st_mode = 0o555 | MODE_DIR,
+        }
+        Ok(())
+    }
+
+    fn fsize(&mut self, id: usize, _ctx: &CallerCtx) -> Result<u64> {
+        match self.handles.get(id)? {
+            Handle::File(data) => Ok(data.len() as u64),
+            _ => Ok(0),
+        }
+    }
+
+    fn fpath(&mut self, id: usize, buf: &mut [u8], _ctx: &CallerCtx) -> Result<usize> {
+        self.handles.get(id).map_err(|_| Error::new(EBADF))?;
+        FpathWriter::with(buf, SCHEME, |_| Ok(()))
+    }
+
+    fn on_close(&mut self, id: usize) {
+        self.handles.remove(id);
+    }
+}
