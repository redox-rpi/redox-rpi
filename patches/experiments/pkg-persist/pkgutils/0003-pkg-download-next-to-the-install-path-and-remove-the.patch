From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Mon, 23 Nov 2026 19:52:06 +0000
Subject: [PATCH] pkg: download next to the install path and remove the
 downloads afterwards

pkg always downloaded into /tmp/pkg_download, also with --root, and never removed the files. On a network-boot image the root filesystem is in RAM: pkg-persist install of a 65 MB package set filled / and stopped with "No space left on device", and / stayed full after the rollback (redox-rpi Test 586).

Now pkg downloads into <install path>/tmp/pkg_download (for / this is /tmp/pkg_download, as before) and removes that directory when the command ends, after a commit or a rollback.
---
 pkg-cli/src/main.rs | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/pkg-cli/src/main.rs b/pkg-cli/src/main.rs
index cdaa1ed..bf6c995 100644
--- a/pkg-cli/src/main.rs
+++ b/pkg-cli/src/main.rs
@@ -185,8 +185,18 @@ fn main() {
         }
     }
 
-    let mut library =
-        LibraryBuilder::new(install_path).with_callback(Rc::new(RefCell::new(callback)));
+    // Download next to the install path, not always to /tmp: with --root on
+    // a data partition the packages must not fill a small root filesystem in
+    // RAM. For / this is /tmp/pkg_download, as before; --user keeps its
+    // runtime directory.
+    let mut path_index = pkg::PathIndex::from_base_path(install_path.clone());
+    if !path_index.use_xdg {
+        path_index.download_dir = download_dir(&install_path);
+    }
+    let download = path_index.download_dir.clone();
+    let mut library = LibraryBuilder::new(&install_path)
+        .with_install_path_index(path_index)
+        .with_callback(Rc::new(RefCell::new(callback)));
     if args.nocheck {
         library = library.with_nocheck(args.nocheck)
     }
@@ -218,6 +228,9 @@ fn main() {
             Err(e) => break Err(e),
         }
     };
+    // The downloaded packages are installed (or the transaction was rolled
+    // back): either way they only take space now, so remove them.
+    let _ = std::fs::remove_dir_all(&download);
     if let Err(err) = err {
         report_error(color_support_stderr, &err);
         if matches!(err, pkg::backend::Error::MissingPermissions) {
@@ -241,6 +254,11 @@ fn main() {
     }
 }
 
+/// Where pkg downloads packages for an install path.
+fn download_dir(install_path: &std::path::Path) -> std::path::PathBuf {
+    install_path.join("tmp/pkg_download")
+}
+
 fn report_error(color_support_stderr: bool, err: &Error) {
     if color_support_stderr {
         eprintln!(
-- 
