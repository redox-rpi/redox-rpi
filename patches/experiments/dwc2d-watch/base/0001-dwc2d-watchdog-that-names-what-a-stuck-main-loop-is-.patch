From 3e0242434d46a4628e3cad74a87a239d856115a2 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Wed, 4 Nov 2026 14:46:25 +0000
Subject: [PATCH] dwc2d: watchdog that names what a stuck main loop is doing

For redox-rpi #92: netstack hangs waiting for a read from dwc2d while dwc2d uses almost no CPU. A thread writes to the serial console when the main loop has spent over 5 s on one thing, and a heartbeat with event counts every 60 s.
---
 drivers/usb/dwc2d/src/main.rs    |  14 ++-
 drivers/usb/dwc2d/src/stats.rs   |   1 +
 drivers/usb/dwc2d/src/usbdiag.rs |   2 +
 drivers/usb/dwc2d/src/watch.rs   | 167 +++++++++++++++++++++++++++++++
 4 files changed, 183 insertions(+), 1 deletion(-)
 create mode 100644 drivers/usb/dwc2d/src/watch.rs

diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index 9de69c6c..61ef3227 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -24,6 +24,7 @@ mod regs;
 mod rtl8152;
 mod stats;
 mod usbdiag;
+mod watch;
 
 use driver_network::{NetworkAdapter, NetworkScheme};
 use dwc2::Dwc2;
@@ -425,6 +426,7 @@ fn main() {
 
 fn daemon(daemon: daemon::Daemon) -> ! {
     common::init();
+    watch::spawn();
 
     let dtb = get_dtb();
     let dt_mac = Fdt::new(&dtb).ok().and_then(|fdt| find_mac(&fdt));
@@ -572,6 +574,7 @@ fn daemon(daemon: daemon::Daemon) -> ! {
     for event in events.map(|e| e.expect("dwc2d: failed to get event")) {
         match event.user_data {
             Source::Irq => {
+                watch::event(watch::Stage::Irq);
                 let file = irq_file.as_mut().unwrap();
                 let mut irq = [0; 8];
                 stats::IRQS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
@@ -583,16 +586,19 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                 }
             }
             Source::Scheme => {
+                watch::event(watch::Stage::Scheme);
                 stats::TICKS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
                 scheme.tick().expect("dwc2d: network scheme failed")
             }
             Source::Stats => {
+                watch::event(watch::Stage::Stats);
                 let t = stats_timer.as_mut().unwrap();
                 t.fired();
                 stats::write();
                 t.arm(STATS_EVERY);
             }
             Source::Time => {
+                watch::event(watch::Stage::Timer);
                 timer.fired();
                 let mut next = None;
                 if irq_file.is_none() {
@@ -608,6 +614,7 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                 }
             }
             Source::Hotplug => {
+                watch::event(watch::Stage::Hotplug);
                 hotplug.fired();
                 usbdiag::step("scan");
                 let mut cycled = Vec::new();
@@ -645,7 +652,10 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                         None => println!("dwc2d: cycle: no port for {request:?}"),
                     }
                 }
-                let mut changes = if restart { Default::default() } else { bus.scan() };
+                let mut changes = if restart { Default::default() } else {
+                    let _scan = watch::Guard::new(watch::Stage::Scan);
+                    bus.scan()
+                };
                 changes.removed.extend(cycled);
                 // A stuck controller (every request times out) does not come
                 // back by itself: restart it and find the devices again.
@@ -691,6 +701,7 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                         continue;
                     };
                     usbdiag::step(&format!("probe address {address}"));
+                    let _probe = watch::Guard::new(watch::Stage::Probe);
                     match probe(&mut bus, &hc, &device, dt_mac, &led_modes, Duration::ZERO) {
                         Some(Found::Net(adapter, _, link)) => net.adapters.push((adapter, link)),
                         Some(Found::Keyboard(f)) if keyboard.is_none() => {
@@ -708,6 +719,7 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                 hotplug.arm(HOTPLUG_INTERVAL);
             }
         }
+        watch::set(watch::Stage::Idle);
     }
     unreachable!()
 }
