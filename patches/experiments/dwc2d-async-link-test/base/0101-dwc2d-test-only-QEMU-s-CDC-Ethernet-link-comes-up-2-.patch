From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Tue, 17 Nov 2026 06:22:16 +0000
Subject: [PATCH] dwc2d: test only, QEMU's CDC Ethernet link comes up 2 s after
 the first held frame

QEMU's card has its link at once, so the frames held for the link
(dwc2d-async-link) are never seen there. For the QEMU test the card
reports no link at boot, and its link comes up 2 s after the first frame
was held, like the LAN7800's autonegotiation on the Pi 3B+.
---
 drivers/usb/dwc2d/src/main.rs | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index 27018e8..9a84600 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -179,7 +179,11 @@ impl UsbNet {
             let (now, name, address) = match adapter {
                 Adapter::Rtl8152(a) => (rtl8152::link(bus, a.function()), "RTL815x", a.function().address),
                 Adapter::Lan78xx(a) => (lan78xx::link(bus, a.function()), "LAN7800", a.function().address),
-                Adapter::Ecm(_) => continue,
+                Adapter::Ecm(a) => (
+                    Ok(ECM_TEST_START.get().is_some_and(|t| t.elapsed() >= ECM_TEST_LINK_DELAY)),
+                    "CDC Ethernet",
+                    a.address(),
+                ),
             };
             if let Ok(now) = now {
                 if now != *link {
@@ -276,6 +280,7 @@ impl NetworkAdapter for UsbNet {
                     held.pop_front();
                 }
                 held.push_back((Instant::now(), buf.to_vec()));
+                let _ = ECM_TEST_START.set(Instant::now());
                 return Ok(buf.len());
             }
         }
@@ -337,7 +342,12 @@ fn probe(
     if let Some(f) = ecm::find(bus, device) {
         println!("dwc2d: CDC Ethernet at address {address}");
         return match ecm::activate(bus, device.max_packet, &f) {
-            Ok(mac) => Some(Found::Net(Adapter::Ecm(Ecm::new(hc.clone(), f, mac)), mac, true)),
+            Ok(mac) => {
+                // Test only (experiment dwc2d-async-link-test): QEMU's card
+                // has its link at once; pretend it comes up 2 s after the
+                // first frame was held, so the held frames are seen.
+                Some(Found::Net(Adapter::Ecm(Ecm::new(hc.clone(), f, mac)), mac, false))
+            }
             Err(err) => {
                 println!("dwc2d: CDC Ethernet: {err:?}");
                 None
@@ -503,6 +513,10 @@ const INPUT_LOG: &str = "/tmp/dwc2d-input-log";
 const BOOT_LINK_WAIT: Duration = Duration::from_secs(10);
 /// How long to look for devices at boot when there is no network adapter.
 const BOOT_CONNECT_WAIT: Duration = Duration::from_secs(1);
+/// Test only: when the first frame was held for the link, and how long after
+/// that the link of QEMU's CDC Ethernet card counts as up.
+static ECM_TEST_START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+const ECM_TEST_LINK_DELAY: Duration = Duration::from_secs(2);
 /// How often the link is read after boot while frames wait for it.
 const LINK_WATCH: Duration = Duration::from_millis(100);
 /// Frames held for the link at most; the oldest go first.
-- 
