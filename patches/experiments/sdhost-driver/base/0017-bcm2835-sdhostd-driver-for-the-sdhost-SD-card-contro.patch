+//! The sdhost controller and the SD card protocol on top of it.
+//!
+//! sdhost has no DMA in this driver and no interrupts: a command goes into
+//! SDARG/SDCMD, the controller clears SDCMD_NEW when the card answered, and
+//! data moves through a 16-word FIFO in SDDATA. Every wait below has a time
+//! limit, so a card that stops answering gives an error instead of a hang.
+
+use std::fmt;
+use std::thread;
+use std::time::{Duration, Instant};
+
+use driver_block::Disk;
+use syscall::{Error, EIO};
+
+// Registers, as byte offsets.
+const SDCMD: usize = 0x00;
+const SDARG: usize = 0x04;
+const SDTOUT: usize = 0x08;
+const SDCDIV: usize = 0x0c;
+const SDRSP0: usize = 0x10;
+const SDHSTS: usize = 0x20;
+const SDVDD: usize = 0x30;
+const SDEDM: usize = 0x34;
+const SDHCFG: usize = 0x38;
+const SDHBCT: usize = 0x3c;
+const SDDATA: usize = 0x40;
+const SDHBLC: usize = 0x50;
+
+// SDCMD
+const CMD_NEW: u32 = 0x8000;
+const CMD_FAIL: u32 = 0x4000;
+const CMD_BUSYWAIT: u32 = 0x800;
+const CMD_NO_RESPONSE: u32 = 0x400;
+const CMD_LONG_RESPONSE: u32 = 0x200;
+const CMD_WRITE: u32 = 0x80;
+const CMD_READ: u32 = 0x40;
+const CMD_INDEX: u32 = 0x3f;
+
+// SDHSTS
+const HSTS_BUSY: u32 = 0x400;
+const HSTS_BLOCK: u32 = 0x200;
+const HSTS_SDIO: u32 = 0x100;
+const HSTS_REW_TIMEOUT: u32 = 0x80;
+const HSTS_CMD_TIMEOUT: u32 = 0x40;
+const HSTS_CRC16: u32 = 0x20;
+const HSTS_CRC7: u32 = 0x10;
+const HSTS_FIFO: u32 = 0x08;
+const HSTS_CLEAR: u32 = HSTS_BUSY
+    | HSTS_BLOCK
+    | HSTS_SDIO
+    | HSTS_REW_TIMEOUT
+    | HSTS_CMD_TIMEOUT
+    | HSTS_CRC16
+    | HSTS_CRC7
+    | HSTS_FIFO;
+const HSTS_DATA_ERRORS: u32 = HSTS_CRC16 | HSTS_FIFO | HSTS_REW_TIMEOUT;
+const HSTS_ERRORS: u32 = HSTS_DATA_ERRORS | HSTS_CRC7 | HSTS_CMD_TIMEOUT;
+
+// SDHCFG
+const HCFG_BUSY_IRPT_EN: u32 = 1 << 10;
+/// Use the full clock divider in data mode too, not only its low 3 bits.
+const HCFG_SLOW_CARD: u32 = 1 << 3;
+const HCFG_WIDE_EXT_BUS: u32 = 1 << 2;
+const HCFG_WIDE_INT_BUS: u32 = 1 << 1;
+
+// SDEDM
+const EDM_FORCE_DATA_MODE: u32 = 1 << 19;
+const EDM_FIFO_FILL_SHIFT: u32 = 4;
+const EDM_FIFO_FILL_MASK: u32 = 0x1f;
+const EDM_WRITE_THRESHOLD_SHIFT: u32 = 9;
+const EDM_READ_THRESHOLD_SHIFT: u32 = 14;
+const EDM_THRESHOLD_MASK: u32 = 0x1f;
+const EDM_FSM_MASK: u32 = 0xf;
+const FSM_IDENTMODE: u32 = 0x0;
+const FSM_DATAMODE: u32 = 0x1;
+const FSM_READDATA: u32 = 0x2;
+const FSM_READWAIT: u32 = 0x4;
+const FSM_WRITESTART1: u32 = 0xa;
+
+const FIFO_WORDS: u32 = 16;
+/// The FIFO thresholds Linux and U-Boot use; larger ones run into a
+/// silicon bug.
+const FIFO_THRESHOLD: u32 = 4;
+const FIFO_BURST: usize = 8;
+const MAX_CDIV: u32 = 0x7ff;
+
+/// The divider runs off the VPU core clock. It is 400 MHz on the Pi 3B+
+/// and may drop to 250 MHz when idle; dividing for 400 MHz keeps the SD
+/// clock at or below the target either way.
+const CORE_CLOCK: u32 = 400_000_000;
+const IDENT_CLOCK: u32 = 400_000;
+const DATA_CLOCK: u32 = 25_000_000;
+
+const BLOCK_SIZE: usize = 512;
+/// Blocks per read or write command (SDHBLC has 9 bits).
+const MAX_BLOCKS: usize = 128;
+const TRANSFER_ATTEMPTS: usize = 3;
+
+const CMD_TIMEOUT: Duration = Duration::from_millis(500);
+const BUSY_TIMEOUT: Duration = Duration::from_secs(2);
+const FIFO_TIMEOUT: Duration = Duration::from_millis(500);
+
+#[derive(Clone, Copy, PartialEq)]
+enum Response {
+    None,
+    Short,
+    /// Short response, then wait until the card no longer signals busy.
+    ShortBusy,
+    Long,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Data {
+    None,
+    Read,
+    Write,
+}
+
+#[derive(Debug)]
+pub enum SdError {
+    Timeout(&'static str),
+    Command { index: u32, hsts: u32 },
+    Data { hsts: u32 },
+    Card(&'static str),
+}
+
+impl fmt::Display for SdError {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            SdError::Timeout(what) => write!(f, "timeout waiting for {what}"),
+            SdError::Command { index, hsts } => {
+                write!(f, "CMD{index} failed, SDHSTS 0x{hsts:03x}")
+            }
+            SdError::Data { hsts } => write!(f, "data transfer failed, SDHSTS 0x{hsts:03x}"),
+            SdError::Card(what) => write!(f, "{what}"),
+        }
+    }
+}
+
+type SdResult<T> = Result<T, SdError>;
+
+pub struct SdHost {
+    regs: *mut u32,
+    hcfg: u32,
+    /// Relative card address, already shifted into the upper 16 bits.
+    rca: u32,
+    /// Block addressing (SDHC/SDXC); byte addressing otherwise.
+    high_capacity: bool,
+    size: u64,
+}
+
+// The registers belong to this driver alone.
+unsafe impl Send for SdHost {}
+
+impl SdHost {
+    pub fn new(regs: *mut u32) -> Self {
+        SdHost {
+            regs,
+            hcfg: 0,
+            rca: 0,
+            high_capacity: false,
+            size: 0,
+        }
+    }
+
+    fn reg(&self, offset: usize) -> u32 {
+        unsafe { self.regs.add(offset / 4).read_volatile() }
+    }
+
+    fn set_reg(&self, offset: usize, value: u32) {
+        unsafe { self.regs.add(offset / 4).write_volatile(value) }
+    }
+
+    fn reset_controller(&mut self) {
+        self.set_reg(SDVDD, 0);
+        self.set_reg(SDCMD, 0);
+        self.set_reg(SDARG, 0);
+        self.set_reg(SDTOUT, 0xf0_0000);
+        self.set_reg(SDCDIV, 0);
+        self.set_reg(SDHSTS, HSTS_CLEAR);
+        self.set_reg(SDHCFG, 0);
+        self.set_reg(SDHBCT, 0);
+        self.set_reg(SDHBLC, 0);
+
+        let thresholds = (EDM_THRESHOLD_MASK << EDM_READ_THRESHOLD_SHIFT)
+            | (EDM_THRESHOLD_MASK << EDM_WRITE_THRESHOLD_SHIFT);
+        let edm = self.reg(SDEDM) & !thresholds
+            | FIFO_THRESHOLD << EDM_READ_THRESHOLD_SHIFT
+            | FIFO_THRESHOLD << EDM_WRITE_THRESHOLD_SHIFT;
+        self.set_reg(SDEDM, edm);
+        thread::sleep(Duration::from_millis(20));
+        self.set_reg(SDVDD, 1);
+        thread::sleep(Duration::from_millis(20));
+
+        self.hcfg = HCFG_BUSY_IRPT_EN | HCFG_WIDE_INT_BUS | HCFG_SLOW_CARD;
+        self.set_reg(SDHCFG, self.hcfg);
+        self.set_reg(SDCDIV, MAX_CDIV);
+    }
+
+    /// Set the SD clock to at most `hz`, and the data timeout to about
+    /// half a second.
+    fn set_clock(&mut self, hz: u32) {
+        let div = CORE_CLOCK.div_ceil(hz).max(2) - 2;
+        let div = div.min(MAX_CDIV);
+        let clock = CORE_CLOCK / (div + 2);
+        self.set_reg(SDCDIV, div);
+        self.set_reg(SDTOUT, clock / 2);
+    }
+
+    fn wait_command_done(&self) -> SdResult<u32> {
+        let start = Instant::now();
+        loop {
+            let sdcmd = self.reg(SDCMD);
+            if sdcmd & CMD_NEW == 0 {
+                return Ok(sdcmd);
+            }
+            if start.elapsed() > CMD_TIMEOUT {
+                return Err(SdError::Timeout("command completion"));
+            }
+        }
+    }
+
+    fn command(&mut self, index: u32, arg: u32, response: Response, data: Data) -> SdResult<[u32; 4]> {
+        self.wait_command_done()
+            .map_err(|_| SdError::Timeout("the previous command"))?;
+
+        let hsts = self.reg(SDHSTS);
+        if hsts & HSTS_ERRORS != 0 {
+            self.set_reg(SDHSTS, hsts);
+        }
+
+        let mut sdcmd = index & CMD_INDEX;
+        sdcmd |= match response {
+            Response::None => CMD_NO_RESPONSE,
+            Response::Short => 0,
+            Response::ShortBusy => CMD_BUSYWAIT,
+            Response::Long => CMD_LONG_RESPONSE,
+        };
+        sdcmd |= match data {
+            Data::None => 0,
+            Data::Read => CMD_READ,
+            Data::Write => CMD_WRITE,
+        };
+        self.set_reg(SDARG, arg);
+        self.set_reg(SDCMD, sdcmd | CMD_NEW);
+
+        let sdcmd = self.wait_command_done()?;
+        if sdcmd & CMD_FAIL != 0 {
+            let hsts = self.reg(SDHSTS);
+            self.set_reg(SDHSTS, HSTS_ERRORS);
+            // The answer to ACMD41 (R3) carries no valid CRC.
+            let crc_only = hsts & HSTS_ERRORS == HSTS_CRC7;
+            if !(crc_only && (index == 41 || index == 1)) {
+                return Err(SdError::Command { index, hsts });
+            }
+        }
+
+        let resp = match response {
+            Response::None => [0; 4],
+            Response::Long => [
+                self.reg(SDRSP0 + 12),
+                self.reg(SDRSP0 + 8),
+                self.reg(SDRSP0 + 4),
+                self.reg(SDRSP0),
+            ],
+            Response::Short | Response::ShortBusy => [self.reg(SDRSP0), 0, 0, 0],
+        };
+
+        if response == Response::ShortBusy {
+            let start = Instant::now();
+            loop {
+                let hsts = self.reg(SDHSTS);
+                if hsts & HSTS_BUSY != 0 {
+                    self.set_reg(SDHSTS, HSTS_BUSY);
+                    break;
+                }
+                if hsts & HSTS_ERRORS != 0 {
+                    self.set_reg(SDHSTS, hsts);
+                    return Err(SdError::Command { index, hsts });
+                }
+                if start.elapsed() > BUSY_TIMEOUT {
+                    return Err(SdError::Timeout("the card to finish (busy)"));
+                }
+            }
+        }
+        Ok(resp)
+    }
+
+    fn app_command(&mut self, index: u32, arg: u32, response: Response) -> SdResult<[u32; 4]> {
+        self.command(55, self.rca, Response::Short, Data::None)?;
+        self.command(index, arg, response, Data::None)
+    }
+
+    /// Reset the controller and take the card from any state through
+    /// identification into the transfer state, 4-bit bus, 25 MHz.
+    pub fn init_card(&mut self) -> SdResult<()> {
+        self.reset_controller();
+        self.set_clock(IDENT_CLOCK);
+        self.rca = 0;
+        // At least 74 clock cycles before the first command.
+        thread::sleep(Duration::from_millis(1));
+
+        self.command(0, 0, Response::None, Data::None)?;
+        // CMD8: only version 2 cards answer, with the check pattern.
+        let v2 = self
+            .command(8, 0x1aa, Response::Short, Data::None)
+            .map(|r| r[0] & 0xfff == 0x1aa)
+            .unwrap_or(false);
+
+        let op_cond = if v2 { 0x40ff_8000 } else { 0x00ff_8000 };
+        let start = Instant::now();
+        let ocr = loop {
+            let ocr = self.app_command(41, op_cond, Response::Short)?[0];
+            if ocr & 0x8000_0000 != 0 {
+                break ocr;
+            }
+            if start.elapsed() > Duration::from_secs(2) {
+                return Err(SdError::Timeout("the card to power up (ACMD41)"));
+            }
+            thread::sleep(Duration::from_millis(10));
+        };
+        self.high_capacity = ocr & 0x4000_0000 != 0;
+
+        self.command(2, 0, Response::Long, Data::None)?;
+        self.rca = self.command(3, 0, Response::Short, Data::None)?[0] & 0xffff_0000;
+        let csd = self.command(9, self.rca, Response::Long, Data::None)?;
+        self.size = csd_capacity(&csd).ok_or(SdError::Card("unknown CSD version"))?;
+
+        self.command(7, self.rca, Response::ShortBusy, Data::None)?;
+        // Every SD memory card supports the 4-bit bus.
+        self.app_command(6, 2, Response::Short)?;
+        self.hcfg |= HCFG_WIDE_EXT_BUS;
+        self.set_reg(SDHCFG, self.hcfg);
+        if !self.high_capacity {
+            self.command(16, BLOCK_SIZE as u32, Response::Short, Data::None)?;
+        }
+        self.set_clock(DATA_CLOCK);
+
+        println!(
+            "bcm2835-sdhostd: {} card, {} MiB, 4-bit bus, up to {} MHz",
+            if self.high_capacity { "SDHC/SDXC" } else { "SDSC" },
+            self.size >> 20,
+            DATA_CLOCK / 1_000_000
+        );
+        Ok(())
+    }
+
+    /// Wait until the controller's state machine is back in data mode
+    /// after a transfer, nudging it there where Linux does too.
+    fn wait_transfer_complete(&self) -> SdResult<()> {
+        let start = Instant::now();
+        loop {
+            let edm = self.reg(SDEDM);
+            match edm & EDM_FSM_MASK {
+                FSM_IDENTMODE | FSM_DATAMODE => return Ok(()),
+                FSM_READWAIT | FSM_WRITESTART1 | FSM_READDATA => {
+                    self.set_reg(SDEDM, edm | EDM_FORCE_DATA_MODE);
+                    return Ok(());
+                }
+                _ => {}
+            }
+            if start.elapsed() > CMD_TIMEOUT {
+                return Err(SdError::Timeout("the end of the transfer"));
+            }
+        }
+    }
+
+    /// Move `words` 32-bit words through the FIFO, in bursts.
+    fn pio(&self, words: usize, mut word: impl FnMut(usize, Option<u32>) -> u32, read: bool) -> SdResult<()> {
+        let mut done = 0;
+        let mut last_progress = Instant::now();
+        while done < words {
+            let fill = self.reg(SDEDM) >> EDM_FIFO_FILL_SHIFT & EDM_FIFO_FILL_MASK;
+            let available = if read { fill } else { FIFO_WORDS - fill } as usize;
+            let burst = FIFO_BURST.min(words - done);
+            if available < burst {
+                let hsts = self.reg(SDHSTS);
+                if hsts & HSTS_DATA_ERRORS != 0 {
+                    return Err(SdError::Data { hsts });
+                }
+                if last_progress.elapsed() > FIFO_TIMEOUT {
+                    return Err(SdError::Timeout("the data FIFO"));
+                }
+                continue;
+            }
+            for _ in 0..available.min(words - done) {
+                if read {
+                    word(done, Some(self.reg(SDDATA)));
+                } else {
+                    self.set_reg(SDDATA, word(done, None));
+                }
+                done += 1;
+            }
+            last_progress = Instant::now();
+        }
+        let hsts = self.reg(SDHSTS);
+        if hsts & HSTS_DATA_ERRORS != 0 {
+            return Err(SdError::Data { hsts });
+        }
+        Ok(())
+    }
+
+    fn card_address(&self, block: u64) -> u32 {
+        if self.high_capacity {
+            block as u32
+        } else {
+            (block * BLOCK_SIZE as u64) as u32
+        }
+    }
+
+    /// Wait until the card has finished programming and is back in the
+    /// transfer state.
+    fn wait_card_ready(&mut self) -> SdResult<()> {
+        let start = Instant::now();
+        loop {
+            let status = self.command(13, self.rca, Response::Short, Data::None)?[0];
+            let ready_for_data = status & 0x100 != 0;
+            let state = status >> 9 & 0xf;
+            if ready_for_data && state == 4 {
+                return Ok(());
+            }
+            if start.elapsed() > BUSY_TIMEOUT {
+                return Err(SdError::Timeout("the card to finish writing"));
+            }
+        }
+    }
+
+    fn read_blocks(&mut self, block: u64, buffer: &mut [u8]) -> SdResult<()> {
+        let blocks = buffer.len() / BLOCK_SIZE;
+        self.set_reg(SDHBCT, BLOCK_SIZE as u32);
+        self.set_reg(SDHBLC, blocks as u32);
+        let index = if blocks == 1 { 17 } else { 18 };
+        self.command(index, self.card_address(block), Response::Short, Data::Read)?;
+        self.pio(
+            buffer.len() / 4,
+            |i, value| {
+                buffer[i * 4..i * 4 + 4].copy_from_slice(&value.unwrap_or(0).to_le_bytes());
+                0
+            },
+            true,
+        )?;
+        self.wait_transfer_complete()?;
+        if blocks > 1 {
+            self.command(12, 0, Response::ShortBusy, Data::None)?;
+        }
+        Ok(())
+    }
+
+    fn write_blocks(&mut self, block: u64, buffer: &[u8]) -> SdResult<()> {
+        let blocks = buffer.len() / BLOCK_SIZE;
+        self.set_reg(SDHBCT, BLOCK_SIZE as u32);
+        self.set_reg(SDHBLC, blocks as u32);
+        let index = if blocks == 1 { 24 } else { 25 };
+        self.command(index, self.card_address(block), Response::Short, Data::Write)?;
+        self.pio(
+            buffer.len() / 4,
+            |i, _| u32::from_le_bytes(buffer[i * 4..i * 4 + 4].try_into().unwrap()),
+            false,
+        )?;
+        self.wait_transfer_complete()?;
+        if blocks > 1 {
+            self.command(12, 0, Response::ShortBusy, Data::None)?;
+        }
+        self.wait_card_ready()
+    }
+
+    /// After a failed transfer: clear the errors, stop the card's transfer
+    /// and get controller and card back into data and transfer state. If
+    /// that fails too, set everything up again.
+    fn recover(&mut self) {
+        self.set_reg(SDHSTS, HSTS_CLEAR);
+        let edm = self.reg(SDEDM);
+        if !matches!(edm & EDM_FSM_MASK, FSM_IDENTMODE | FSM_DATAMODE) {
+            self.set_reg(SDEDM, edm | EDM_FORCE_DATA_MODE);
+        }
+        let _ = self.command(12, 0, Response::ShortBusy, Data::None);
+        if self.wait_card_ready().is_err() {
+            println!("bcm2835-sdhostd: card not ready, initializing it again");
+            if let Err(err) = self.init_card() {
+                println!("bcm2835-sdhostd: initialization failed: {err}");
+            }
+        }
+    }
+
+    /// Run `transfer` on each chunk of at most MAX_BLOCKS blocks, retrying
+    /// a failed chunk after `recover`.
+    fn chunked<B>(
+        &mut self,
+        block: u64,
+        mut buffer: B,
+        len: usize,
+        mut transfer: impl FnMut(&mut Self, u64, &mut B, std::ops::Range<usize>) -> SdResult<()>,
+        what: &str,
+    ) -> syscall::Result<usize> {
+        if len % BLOCK_SIZE != 0 {
+            return Err(Error::new(syscall::EINVAL));
+        }
+        let mut offset = 0;
+        while offset < len {
+            let end = (offset + MAX_BLOCKS * BLOCK_SIZE).min(len);
+            let lba = block + (offset / BLOCK_SIZE) as u64;
+            let mut attempt = 1;
+            loop {
+                match transfer(self, lba, &mut buffer, offset..end) {
+                    Ok(()) => break,
+                    Err(err) => {
+                        println!("bcm2835-sdhostd: {what} of block {lba}: {err}");
+                        self.recover();
+                        if attempt >= TRANSFER_ATTEMPTS {
+                            return Err(Error::new(EIO));
+                        }
+                        attempt += 1;
+                    }
+                }
+            }
+            offset = end;
+        }
+        Ok(len)
+    }
+}
+
+/// Card capacity in bytes from the CSD register (128 bits, most
+/// significant word first).
+fn csd_capacity(csd: &[u32; 4]) -> Option<u64> {
+    let bits = |high: u32, low: u32| -> u64 {
+        let mut value = 0u64;
+        for bit in (low..=high).rev() {
+            let word = csd[3 - (bit / 32) as usize];
+            value = value << 1 | (word >> (bit % 32) & 1) as u64;
+        }
+        value
+    };
+    match bits(127, 126) {
+        // CSD version 1.0: SDSC
+        0 => {
+            let c_size = bits(73, 62);
+            let c_size_mult = bits(49, 47);
+            let read_bl_len = bits(83, 80);
+            Some((c_size + 1) << (c_size_mult + 2) << read_bl_len)
+        }
+        // CSD version 2.0: SDHC/SDXC, in units of 512 KiB
+        1 => Some((bits(69, 48) + 1) * 512 * 1024),
+        _ => None,
+    }
+}
+
+impl Disk for SdHost {
+    fn block_size(&self) -> u32 {
+        BLOCK_SIZE as u32
+    }
+
+    fn size(&self) -> u64 {
+        self.size
+    }
+
+    async fn read(&mut self, block: u64, buffer: &mut [u8]) -> syscall::Result<usize> {
+        let len = buffer.len();
+        self.chunked(
+            block,
+            buffer,
+            len,
+            |host, lba, buffer, range| host.read_blocks(lba, &mut buffer[range]),
+            "read",
+        )
+    }
+
+    async fn write(&mut self, block: u64, buffer: &[u8]) -> syscall::Result<usize> {
+        self.chunked(
+            block,
+            buffer,
+            buffer.len(),
+            |host, lba, buffer, range| host.write_blocks(lba, &buffer[range]),
+            "write",
+        )
+    }
+}
diff --git a/drivers/storage/bcm2835-sdhostd/src/main.rs b/drivers/storage/bcm2835-sdhostd/src/main.rs
new file mode 100644
index 00000000..929f8297
--- /dev/null
+++ b/drivers/storage/bcm2835-sdhostd/src/main.rs
@@ -0,0 +1,191 @@
+//! Driver for the "sdhost" SD card controller of the BCM2835/BCM2837.
+//!
+//! The Raspberry Pi 3 has two SD controllers: the Arasan "EMMC" controller
+//! (bcm2835-sdhcid) and this Broadcom one, which Linux uses for the card
+//! slot. GPIO 48-53 decide which of the two the slot is wired to; this
+//! driver switches them to sdhost (ALT0) and sets the card up from scratch,
+//! whatever the firmware or U-Boot did with it before.
+//!
+//! Usage: `bcm2835-sdhostd [scheme]`, scheme name default `disk.mmc`. Started
+//! by hand next to bcm2835-sdhcid, use another name, e.g. `disk.sdhost`;
+//! the card then no longer answers bcm2835-sdhcid until the next boot.
+
+use std::{env, process};
+
+use driver_block::{DiskScheme, ExecutorTrait, TrivialExecutor};
+use event::{EventFlags, RawEventQueue};
+use fdt::Fdt;
+
+mod host;
+
+/// Bus address of sdhost on all BCM283x, used if the devicetree has no node.
+const SDHOST_BUS_ADDR: usize = 0x7e20_2000;
+const SDHOST_SIZE: usize = 0x100;
+/// GPIO sits 8 KiB below sdhost.
+const GPIO_OFFSET: usize = 0x2000;
+
+#[cfg(target_os = "redox")]
+fn get_dtb() -> Vec<u8> {
+    std::fs::read("kernel.dtb:").unwrap()
+}
+
+#[cfg(target_os = "linux")]
+fn get_dtb() -> Vec<u8> {
+    use std::env;
+    if let Some(arg1) = env::args().nth(1) {
+        std::fs::read(arg1).unwrap()
+    } else {
+        Vec::new()
+    }
+}
+
+fn main() {
+    // Started by init: report readiness through it. Started by hand with a
+    // scheme name: stay in the foreground, there is no init to notify.
+    if cfg!(target_os = "redox") && env::args().nth(1).is_some() {
+        daemon(None);
+    }
+    daemon::Daemon::new(|daemon_handle| daemon(Some(daemon_handle)));
+}
+
+/// The CPU physical address of sdhost, from the devicetree. The node is
+/// there even when an overlay (`dtoverlay=mmc`) disabled it.
+fn sdhost_phys(fdt: &Fdt) -> usize {
+    let bus_addr = fdt
+        .find_compatible(&["brcm,bcm2835-sdhost"])
+        .and_then(|node| node.reg())
+        .and_then(|mut reg| reg.next())
+        .map(|reg| reg.starting_address as usize)
+        .unwrap_or(SDHOST_BUS_ADDR);
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.ranges())
+        .and_then(|mut ranges| {
+            ranges.find(|r| {
+                r.child_bus_address <= bus_addr && bus_addr - r.child_bus_address < r.size
+            })
+        })
+        .map(|r| r.parent_bus_address + (bus_addr - r.child_bus_address))
+        .unwrap_or(bus_addr)
+}
+
+/// Name of the disk scheme to serve, from the first argument.
+#[cfg(target_os = "redox")]
+fn scheme_name() -> String {
+    env::args().nth(1).unwrap_or_else(|| "disk.mmc".to_string())
+}
+
+#[cfg(target_os = "linux")]
+fn scheme_name() -> String {
+    "disk.mmc".to_string()
+}
+
+fn daemon(daemon: Option<daemon::Daemon>) -> ! {
+    common::init();
+    let scheme_name = scheme_name();
+    let dtb_data = get_dtb();
+    if dtb_data.is_empty() {
+        println!("bcm2835-sdhostd: no devicetree");
+        process::exit(0);
+    }
+    let fdt = Fdt::new(&dtb_data).unwrap();
+    let phys = sdhost_phys(&fdt);
+    println!("bcm2835-sdhostd: controller at 0x{phys:08x}");
+
+    let regs = unsafe {
+        common::physmap(
+            phys,
+            SDHOST_SIZE,
+            common::Prot::RW,
+            common::MemoryType::DeviceMemory,
+        )
+        .expect("bcm2835-sdhostd: failed to map registers") as *mut u32
+    };
+    unsafe { route_sd_pins(phys - GPIO_OFFSET) };
+
+    let mut sdhost = host::SdHost::new(regs);
+    if let Err(err) = sdhost.init_card() {
+        println!("bcm2835-sdhostd: no usable card: {err}");
+        process::exit(1);
+    }
+
+    println!("bcm2835-sdhostd: serving /scheme/{scheme_name}");
+    let mut scheme = DiskScheme::new(
+        daemon,
+        scheme_name,
+        [(0, sdhost)].into_iter().collect(),
+        &TrivialExecutor,
+    );
+
+    let event_queue = RawEventQueue::new().expect("bcm2835-sdhostd: failed to open event file");
+    event_queue
+        .subscribe(scheme.event_handle().raw(), 0, EventFlags::READ)
+        .expect("bcm2835-sdhostd: failed to watch the disk scheme");
+
+    libredox::call::setrens(0, 0).expect("bcm2835-sdhostd: failed to enter null namespace");
+
+    for event in event_queue {
+        let event = event.unwrap();
+        if event.fd == scheme.event_handle().raw() {
+            TrivialExecutor.block_on(scheme.tick()).unwrap();
+        }
+    }
+    process::exit(0);
+}
+
+/// Connect the SD card slot (GPIO 48-53) to sdhost and pull CMD and DAT0-3
+/// up. sdhost could also use GPIO 22-27; make sure it does not.
+unsafe fn route_sd_pins(gpio_phys: usize) {
+    let gpio = match unsafe {
+        common::physmap(
+            gpio_phys,
+            0x1000,
+            common::Prot::RW,
+            common::MemoryType::DeviceMemory,
+        )
+    } {
+        Ok(addr) => addr as *mut u32,
+        Err(err) => {
+            println!("bcm2835-sdhostd: failed to map GPIO: {err:?}");
+            return;
+        }
+    };
+    let read = |offset: usize| unsafe { gpio.add(offset / 4).read_volatile() };
+    let write = |offset: usize, value: u32| unsafe { gpio.add(offset / 4).write_volatile(value) };
+    // GPFSELn holds the function of GPIO 10n..10n+9, three bits each.
+    let function = |pin: usize| read(pin / 10 * 4) >> (pin % 10 * 3) & 7;
+    let set_function = |pin: usize, function: u32| {
+        let offset = pin / 10 * 4;
+        let shift = pin % 10 * 3;
+        write(offset, read(offset) & !(7 << shift) | function << shift);
+    };
+
+    const INPUT: u32 = 0;
+    const ALT0: u32 = 4;
+    for pin in 22..=27 {
+        if function(pin) == ALT0 {
+            set_function(pin, INPUT);
+        }
+    }
+    for pin in 48..=53 {
+        set_function(pin, ALT0);
+    }
+
+    // Pull-up on GPIO 49-53: set GPPUD, clock it into the pins with
+    // GPPUDCLK1, wait 150 cycles each step, then clear both.
+    const GPPUD: usize = 0x94;
+    const GPPUDCLK1: usize = 0x9c;
+    const PULL_UP: u32 = 2;
+    write(GPPUD, PULL_UP);
+    std::thread::sleep(std::time::Duration::from_micros(10));
+    write(GPPUDCLK1, 0x1f << (49 - 32));
+    std::thread::sleep(std::time::Duration::from_micros(10));
+    write(GPPUD, 0);
+    write(GPPUDCLK1, 0);
+
+    println!(
+        "bcm2835-sdhostd: GPFSEL2 0x{:08x} GPFSEL4 0x{:08x} GPFSEL5 0x{:08x}",
+        read(0x08),
+        read(0x10),
+        read(0x14)
+    );
+}
