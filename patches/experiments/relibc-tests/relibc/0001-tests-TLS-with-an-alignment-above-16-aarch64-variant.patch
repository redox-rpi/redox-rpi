From 579ba1c7a4693e772730eea1299f23bb13482f4c Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 29 Oct 2026 10:44:43 +0000
Subject: [PATCH 1/3] tests: TLS with an alignment above 16 (aarch64 variant I
 layout)

Thread-local data aligned to 128, like crossbeam's CachePadded on
aarch64, checked in the main thread and a new thread: initial values and
alignment.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/Makefile.tests.mk                      |  3 +-
 tests/expected/bins_dynamic/tls_align.stdout |  3 ++
 tests/expected/bins_static/tls_align.stdout  |  3 ++
 tests/tls_align.c                            | 34 ++++++++++++++++++++
 4 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 tests/expected/bins_dynamic/tls_align.stdout
 create mode 100644 tests/expected/bins_static/tls_align.stdout
 create mode 100644 tests/tls_align.c

diff --git a/tests/Makefile.tests.mk b/tests/Makefile.tests.mk
index a3a45a00..69aa7864 100644
--- a/tests/Makefile.tests.mk
+++ b/tests/Makefile.tests.mk
@@ -362,7 +362,8 @@ STATIC_CHECK_EXPECT_NAMES=\
 	pthread/init_cpp \
 	stdlib/env \
 	unistd/brk \
-	tls
+	tls \
+	tls_align
 
 # Tests run with `expect` (require a .c file and an .exp file
 # that takes the produced binary as the first argument)
diff --git a/tests/expected/bins_dynamic/tls_align.stdout b/tests/expected/bins_dynamic/tls_align.stdout
new file mode 100644
index 00000000..aaff9508
--- /dev/null
+++ b/tests/expected/bins_dynamic/tls_align.stdout
@@ -0,0 +1,3 @@
+main: small 5, big[0] 7, after 9, big aligned 1
+thread: small 5, big[0] 7, after 9, big aligned 1
+main: small 2, big[0] 3, after 9, big aligned 1
diff --git a/tests/expected/bins_static/tls_align.stdout b/tests/expected/bins_static/tls_align.stdout
new file mode 100644
index 00000000..aaff9508
--- /dev/null
+++ b/tests/expected/bins_static/tls_align.stdout
@@ -0,0 +1,3 @@
+main: small 5, big[0] 7, after 9, big aligned 1
+thread: small 5, big[0] 7, after 9, big aligned 1
+main: small 2, big[0] 3, after 9, big aligned 1
diff --git a/tests/tls_align.c b/tests/tls_align.c
new file mode 100644
index 00000000..d783dcbc
--- /dev/null
+++ b/tests/tls_align.c
@@ -0,0 +1,34 @@
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+
+// Thread-local data with an alignment above 16, the size of the aarch64
+// thread control block, like crossbeam's CachePadded (128 on aarch64).
+// With variant I TLS the linker places it at align_up(16, 128) from the
+// thread pointer; the loader must put the initial data there too.
+_Thread_local int small = 5;
+_Alignas(128) _Thread_local char big[200] = {7};
+_Thread_local int after = 9;
+
+static void check(const char *who) {
+    printf("%s: small %d, big[0] %d, after %d, big aligned %d\n", who, small,
+           big[0], after, (int)((uintptr_t)big % 128 == 0));
+}
+
+static void *thread_main(void *arg) {
+    (void)arg;
+    check("thread");
+    small = 1;
+    return NULL;
+}
+
+int main(void) {
+    check("main");
+    small = 2;
+    big[0] = 3;
+    pthread_t thread;
+    pthread_create(&thread, NULL, thread_main, NULL);
+    pthread_join(thread, NULL);
+    check("main");
+    return 0;
+}
