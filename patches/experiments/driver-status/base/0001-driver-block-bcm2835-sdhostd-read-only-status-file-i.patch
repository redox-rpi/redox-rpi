     async fn read(&mut self, block: u64, buffer: &mut [u8]) -> syscall::Result<usize>;
     async fn write(&mut self, block: u64, buffer: &[u8]) -> syscall::Result<usize>;
 
+    /// Text for the scheme's read-only `status` file: registers, clocks
+    /// and counters, one `name: value` per line. Reading it must not change
+    /// the hardware state. `None`: the driver has no status file.
+    fn status(&self) -> Option<String> {
+        None
+    }
+
     #[allow(unused_variables)]
     async unsafe fn read_dma(
         &mut self,
@@ -127,6 +134,10 @@ impl<T: Disk + ?Sized> Disk for Box<T> {
     async fn write(&mut self, block: u64, buffer: &[u8]) -> syscall::Result<usize> {
         (**self).write(block, buffer).await
     }
+
+    fn status(&self) -> Option<String> {
+        (**self).status()
+    }
 }
 
 pub struct DiskWrapper<T> {
@@ -387,6 +398,7 @@ enum Handle {
