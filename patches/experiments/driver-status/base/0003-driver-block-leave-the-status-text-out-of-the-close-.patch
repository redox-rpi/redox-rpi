From 7b1f5cad2979718f48cb6de1f1a9888927d10405 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 20 Nov 2026 08:58:46 +0000
Subject: [PATCH] driver-block: leave the status text out of the close log
 (redox-rpi #571)

on_close printed each removed handle with Debug, so closing a status
handle put the whole text as decimal bytes on the console (Test 521).
---
 drivers/storage/driver-block/src/lib.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/storage/driver-block/src/lib.rs b/drivers/storage/driver-block/src/lib.rs
index f268315c..b98551cc 100644
--- a/drivers/storage/driver-block/src/lib.rs
+++ b/drivers/storage/driver-block/src/lib.rs
@@ -731,6 +731,9 @@ impl<T: Disk> SchemeAsync for DiskSchemeInner<T> {
 impl<D: Disk> DiskSchemeInner<D> {
     pub fn on_close(&mut self, id: usize) {
         let _handle = self.handles.remove(id);
-        println!("removing handle: id: {}, {:?}", id, _handle);
+        // A status handle holds the whole text; leave it out of the log.
+        if !matches!(_handle, Some(Handle::Status(_))) {
+            println!("removing handle: id: {}, {:?}", id, _handle);
+        }
     }
 }
