+++ b/drivers/audio/bcm2835-hdmiaudiod/src/iec958.rs
@@ -0,0 +1,193 @@
+//! IEC958 (S/PDIF) subframes, the only sample format the VC4 HDMI audio
+//! path takes (Linux `vc4_hdmi.c` offers only `IEC958_SUBFRAME_LE`). No
+//! hardware here, so it is tested on the build host.
+//!
+//! One 32-bit word per channel and frame:
+//!
+//! | Bits | Field |
+//! |---|---|
+//! | 0–3 | preamble: `B` (block start, left), `M` (left), `W` (right) |
+//! | 4–27 | the sample, left-aligned (a 16-bit sample is in 12–27) |
+//! | 28 | V, validity: 0 = the sample is valid PCM |
+//! | 29 | U, user data: 0 |
+//! | 30 | C, one bit of the channel status |
+//! | 31 | P, parity: bits 4–31 hold an even number of ones |
+//!
+//! The channel status is 192 bits, one per frame, the same for both
+//! channels; a block of 192 frames carries it once and starts with a `B`
+//! preamble. The HDMI core finds the block starts by that preamble
+//! (`AUDIO_PACKET_CONFIG`, B-frame identifier 0x8).
+
+/// Frames per channel-status block.
+pub const BLOCK_FRAMES: usize = 192;
+
+/// Preamble codes as ALSA's `iec958` plugin writes them (alsa-lib
+/// `pcm_iec958.c`: Z = 0x08, X = 0x02, Y = 0x04).
+pub const PREAMBLE_B: u32 = 0x8;
+pub const PREAMBLE_M: u32 = 0x2;
+pub const PREAMBLE_W: u32 = 0x4;
+
+const BIT_C: u32 = 1 << 30;
+const BIT_P: u32 = 1 << 31;
+
+/// The consumer channel status (IEC 60958-3) for linear PCM, 16 bits, no
+/// copyright: the bytes Linux's `snd_pcm_create_iec958_consumer` makes.
+pub fn channel_status(sample_rate: u32) -> [u8; 24] {
+    let mut cs = [0u8; 24];
+    // Byte 0: consumer (bit 0 = 0), linear PCM (bit 1 = 0), no copyright
+    // asserted (bit 2), no pre-emphasis, mode 0.
+    cs[0] = 1 << 2;
+    // Byte 1: category general (0). Byte 2: source and channel unspecified.
+    // Byte 3: sampling frequency in bits 0–3, clock accuracy level II (0).
+    cs[3] = match sample_rate {
+        44_100 => 0x0,
+        48_000 => 0x2,
+        32_000 => 0x3,
+        88_200 => 0x8,
+        96_000 => 0xa,
+        _ => 0x1, // not indicated
+    };
+    // Byte 4: word length: maximum 20 bits (bit 0 = 0), 16 bits (bits 1–3
+    // = 0b001).
+    cs[4] = 0b001 << 1;
+    cs
+}
+
+/// Bit `n` (0–191) of a channel-status block, LSB of byte 0 first.
+fn cs_bit(cs: &[u8; 24], n: usize) -> bool {
+    cs[n / 8] >> (n % 8) & 1 != 0
+}
+
+/// Set the parity bit so bits 4–31 hold an even number of ones.
+pub fn with_parity(word: u32) -> u32 {
+    let word = word & !BIT_P;
+    if (word >> 4).count_ones() % 2 == 1 {
+        word | BIT_P
+    } else {
+        word
+    }
+}
+
+/// One subframe: `sample` (s16) with `preamble` and channel-status bit `c`.
+pub fn subframe(sample: i16, preamble: u32, c: bool) -> u32 {
+    let mut word = (u32::from(sample as u16) << 12) | preamble;
+    if c {
+        word |= BIT_C;
+    }
+    with_parity(word)
+}
+
+/// Turns stereo s16 frames into subframes. The place in the
+/// channel-status block follows from the frame's number since the start, so
+/// slots can be filled in any order (sound, silence after it) and the
+/// blocks still line up.
+pub struct Encoder {
+    cs: [u8; 24],
+}
+
+impl Encoder {
+    pub fn new(sample_rate: u32) -> Self {
+        Encoder {
+            cs: channel_status(sample_rate),
+        }
+    }
+
+    /// The two words of frame number `n`, left then right.
+    pub fn frame(&self, n: u64, left: i16, right: i16) -> [u32; 2] {
+        let position = (n % BLOCK_FRAMES as u64) as usize;
+        let c = cs_bit(&self.cs, position);
+        let first = if position == 0 { PREAMBLE_B } else { PREAMBLE_M };
+        [subframe(left, first, c), subframe(right, PREAMBLE_W, c)]
+    }
+
+    /// Fill `words` (two per frame) with silence, the first frame being
+    /// number `first`.
+    pub fn silence(&self, words: &mut [u32], first: u64) {
+        for (i, pair) in words.chunks_exact_mut(2).enumerate() {
+            pair.copy_from_slice(&self.frame(first + i as u64, 0, 0));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn even(word: u32) -> bool {
+        (word >> 4).count_ones() % 2 == 0
+    }
+
+    #[test]
+    fn sample_bits_and_parity() {
+        let w = subframe(0x1234, PREAMBLE_M, false);
+        assert_eq!(w & 0xf, PREAMBLE_M);
+        assert_eq!(w >> 12 & 0xffff, 0x1234);
+        assert_eq!(w >> 4 & 0xff, 0, "bits below the 16-bit sample stay 0");
+        assert_eq!(w >> 28 & 0x7, 0, "V and U are 0, C as given");
+        assert!(even(w));
+        let w = subframe(-1, PREAMBLE_W, true);
+        assert_eq!(w >> 12 & 0xffff, 0xffff);
+        assert_ne!(w & BIT_C, 0);
+        assert!(even(w));
+        // 16 + 1 ones: odd, so P is set.
+        assert_ne!(w & BIT_P, 0);
+        assert_eq!(subframe(0, PREAMBLE_M, false), PREAMBLE_M, "silence: no bits, P = 0");
+    }
+
+    #[test]
+    fn every_word_has_even_parity() {
+        let enc = Encoder::new(44_100);
+        for i in 0..1000i32 {
+            let s = (i * 977 - 30000) as i16;
+            for w in enc.frame(i as u64, s, s.wrapping_neg()) {
+                assert!(even(w), "word {w:08x}");
+            }
+        }
+    }
+
+    #[test]
+    fn block_start_every_192_frames() {
+        let enc = Encoder::new(48_000);
+        for n in 0..3 * BLOCK_FRAMES {
+            let [l, r] = enc.frame(n as u64, 0, 0);
+            let want = if n % BLOCK_FRAMES == 0 { PREAMBLE_B } else { PREAMBLE_M };
+            assert_eq!(l & 0xf, want, "frame {n}");
+            assert_eq!(r & 0xf, PREAMBLE_W);
+        }
+    }
+
+    #[test]
+    fn channel_status_comes_back_from_the_c_bits() {
+        for rate in [44_100, 48_000] {
+            let enc = Encoder::new(rate);
+            let mut got = [0u8; 24];
+            // From the second block on: the same bits.
+            for n in 0..BLOCK_FRAMES {
+                let [l, r] = enc.frame((BLOCK_FRAMES + n) as u64, 100, -100);
+                assert_eq!(l & BIT_C, r & BIT_C, "both channels carry the same bit");
+                if l & BIT_C != 0 {
+                    got[n / 8] |= 1 << (n % 8);
+                }
+            }
+            assert_eq!(got, channel_status(rate));
+        }
+        let cs = channel_status(44_100);
+        assert_eq!(cs[0], 0x04);
+        assert_eq!(cs[3], 0x00);
+        assert_eq!(cs[4], 0x02);
+        assert_eq!(channel_status(48_000)[3], 0x02);
+    }
+
+    #[test]
+    fn silence_slots_line_up_with_sound() {
+        // A ring slot of 512 frames is not a whole number of blocks: slot 1
+        // starts at frame 512 = 2 × 192 + 128.
+        let enc = Encoder::new(44_100);
+        let mut slot = vec![0u32; 2 * 512];
+        enc.silence(&mut slot, 512);
+        assert_eq!(slot[0] & 0xf, PREAMBLE_M);
+        assert_eq!(slot[2 * 64] & 0xf, PREAMBLE_B, "frame 576 starts a block");
+        assert_eq!(slot[2 * 64 + 1] & 0xf, PREAMBLE_W);
+        assert!(slot.iter().all(|w| w >> 4 & 0xff_ffff == 0), "silence");
+    }
+}
