+[unit]
+description = "Raspberry Pi HDMI sound"
+condition_architecture = ["aarch64"]
+condition_board = ["raspi3bp"]
+# rpi-firmwared first: CTS needs the pixel clock.
+requires_weak = ["40_rpi-firmwared.service"]
+
+[service]
+cmd = "bcm2835-hdmiaudiod"
+type = { scheme = "audiohw" }
