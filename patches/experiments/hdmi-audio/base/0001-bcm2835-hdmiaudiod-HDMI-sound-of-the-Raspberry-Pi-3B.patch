diff --git a/drivers/audio/bcm2835-hdmiaudiod/src/dma.rs b/drivers/audio/bcm2835-hdmiaudiod/src/dma.rs
new file mode 100644
index 00000000..fdfeb19b
--- /dev/null
+++ b/drivers/audio/bcm2835-hdmiaudiod/src/dma.rs
@@ -0,0 +1,221 @@
+//! The BCM2835 DMA controller playing a ring of slots into the HDMI MAI
+//! FIFO (docs/topics/dma.md in redox-rpi, step 1: one fixed channel,
+//! uncached buffers, polling instead of the interrupt). The same as in
+//! `bcm2835-pwmaudiod`, with the channel and the DREQ line as parameters.
+//!
+//! Each slot has one control block, and the last block points back to the
+//! first, so the controller plays the ring forever. The FIFO paces it
+//! through its DREQ line: a word moves only when the FIFO has room.
+//! `CONBLK_AD` says which block, and so which slot, is playing.
+
+use common::dma::Dma;
+use fdt::Fdt;
+
+use crate::ring::SLOT_FRAMES;
+
+/// Bus address of the controller on all BCM283x, if the devicetree has none.
+const DMA_BUS_ADDR: usize = 0x7e00_7000;
+/// The channel this driver owns (docs/topics/dma.md, channel table: 2 and 0
+/// are free for SPI or audio; `bcm2835-pwmaudiod` has 2).
+pub const CHANNEL: usize = 0;
+const CHANNEL_SIZE: usize = 0x100;
+/// RAM as the controller sees it when the devicetree has no dma-ranges.
+const RAM_BUS_OFFSET: usize = 0xc000_0000;
+
+// Channel registers, as byte offsets.
+const CS: usize = 0x00;
+const CONBLK_AD: usize = 0x04;
+const DEBUG: usize = 0x20;
+/// Global register: one enable bit per channel.
+const ENABLE: usize = 0xff0;
+
+// CS
+const CS_ACTIVE: u32 = 1 << 0;
+const CS_END: u32 = 1 << 1;
+const CS_INT: u32 = 1 << 2;
+const CS_ERROR: u32 = 1 << 8;
+const CS_WAIT_FOR_OUTSTANDING_WRITES: u32 = 1 << 28;
+const CS_ABORT: u32 = 1 << 30;
+const CS_RESET: u32 = 1 << 31;
+/// AXI priority 8, panic priority 15.
+const CS_PRIORITY: u32 = 8 << 16 | 15 << 20;
+
+// TI, in the control block
+const TI_WAIT_RESP: u32 = 1 << 3;
+const TI_DEST_DREQ: u32 = 1 << 6;
+const TI_SRC_INC: u32 = 1 << 8;
+const TI_PERMAP_SHIFT: u32 = 16;
+
+// DEBUG; each bit is cleared by writing 1
+const DEBUG_ERRORS: u32 = 0x7;
+
+/// Slots in the ring: 8 × 512 frames, about 93 ms.
+pub const SLOTS: usize = 8;
+/// FIFO words per slot: one per channel and frame.
+pub const SLOT_WORDS: usize = SLOT_FRAMES * 2;
+
+/// One control block; the controller needs them aligned to 32 bytes.
+#[repr(C, align(32))]
+#[derive(Clone, Copy)]
+struct ControlBlock {
+    ti: u32,
+    source: u32,
+    dest: u32,
+    len: u32,
+    stride: u32,
+    next: u32,
+    _reserved: [u32; 2],
+}
+
+pub struct DmaRing {
+    /// The channel's registers.
+    regs: *mut u32,
+    /// The controller's register page, for ENABLE.
+    page: *mut u32,
+    /// Only read by the controller.
+    _cbs: Dma<[ControlBlock; SLOTS]>,
+    buf: Dma<[[u32; SLOT_WORDS]; SLOTS]>,
+    cbs_bus: u32,
+}
+
+// The channel and the buffers belong to this driver alone.
+unsafe impl Send for DmaRing {}
+
+impl DmaRing {
+    /// Set up the channel and the ring, not started yet. `fifo_bus` is the
+    /// bus address of the FIFO, `dreq` its DREQ line. Fails if the
+    /// devicetree does not leave the channel free.
+    pub fn new(fdt: &Fdt, fifo_bus: u32, dreq: u32) -> Result<Self, String> {
+        let node = fdt.find_compatible(&["brcm,bcm2835-dma"]);
+        let mask = node
+            .and_then(|node| node.property("brcm,dma-channel-mask"))
+            .and_then(|prop| prop.as_usize())
+            .ok_or("no brcm,dma-channel-mask in the devicetree")?;
+        if mask & 1 << CHANNEL == 0 {
+            return Err(format!("DMA channel {CHANNEL} not free (mask 0x{mask:x})"));
+        }
+        let bus_addr = node
+            .and_then(|node| node.reg())
+            .and_then(|mut reg| reg.next())
+            .map(|reg| reg.starting_address as usize)
+            .unwrap_or(DMA_BUS_ADDR);
+        let phys = crate::soc_phys(fdt, bus_addr);
+        let page = unsafe {
+            common::physmap(phys, 0x1000, common::Prot::RW, common::MemoryType::DeviceMemory)
+                .map_err(|err| format!("failed to map the DMA controller: {err:?}"))? as *mut u32
+        };
+        let mut cbs = unsafe {
+            Dma::<[ControlBlock; SLOTS]>::zeroed()
+                .map_err(|err| format!("failed to allocate the control blocks: {err}"))?
+                .assume_init()
+        };
+        let buf = unsafe {
+            Dma::<[[u32; SLOT_WORDS]; SLOTS]>::zeroed()
+                .map_err(|err| format!("failed to allocate the ring: {err}"))?
+                .assume_init()
+        };
+        let offset = ram_bus_offset(fdt);
+        let bus = |phys: usize| (phys + offset) as u32;
+        let cbs_bus = bus(cbs.physical());
+        let buf_bus = bus(buf.physical());
+        for (i, cb) in cbs.iter_mut().enumerate() {
+            *cb = ControlBlock {
+                ti: dreq << TI_PERMAP_SHIFT | TI_DEST_DREQ | TI_SRC_INC | TI_WAIT_RESP,
+                source: buf_bus + (i * SLOT_WORDS * 4) as u32,
+                dest: fifo_bus,
+                len: (SLOT_WORDS * 4) as u32,
+                stride: 0,
+                next: cbs_bus + (((i + 1) % SLOTS) * size_of::<ControlBlock>()) as u32,
+                _reserved: [0; 2],
+            };
+        }
+        let ring = DmaRing {
+            regs: unsafe { page.add(CHANNEL * CHANNEL_SIZE / 4) },
+            page,
+            _cbs: cbs,
+            buf,
+            cbs_bus,
+        };
+        let enable = ring.page_reg(ENABLE);
+        ring.set_page_reg(ENABLE, enable | 1 << CHANNEL);
+        ring.reset();
+        Ok(ring)
+    }
+
+    pub fn slot_mut(&mut self, index: usize) -> &mut [u32; SLOT_WORDS] {
+        &mut self.buf[index]
+    }
+
+    /// Start the ring at slot 0.
+    pub fn start(&self) {
+        self.reset();
+        barrier();
+        self.set_reg(CONBLK_AD, self.cbs_bus);
+        self.set_reg(CS, CS_ACTIVE | CS_END | CS_INT | CS_PRIORITY | CS_WAIT_FOR_OUTSTANDING_WRITES);
+    }
+
+    /// The slot whose control block the controller holds, if any.
+    pub fn position(&self) -> Option<usize> {
+        let cb = self.reg(CONBLK_AD).wrapping_sub(self.cbs_bus) as usize;
+        let size = size_of::<ControlBlock>();
+        (cb % size == 0 && cb / size < SLOTS).then_some(cb / size)
+    }
+
+    /// CS and DEBUG if the channel stopped with an error or is not running.
+    pub fn fault(&self) -> Option<(u32, u32)> {
+        let cs = self.reg(CS);
+        (cs & CS_ERROR != 0 || cs & CS_ACTIVE == 0).then(|| (cs, self.reg(DEBUG)))
+    }
+
+    /// Stop whatever the channel does and clear its errors.
+    pub fn reset(&self) {
+        if self.reg(CS) & CS_ACTIVE != 0 {
+            self.set_reg(CS, CS_ABORT);
+            let start = std::time::Instant::now();
+            while self.reg(CS) & CS_ACTIVE != 0 && start.elapsed() < std::time::Duration::from_millis(10) {}
+        }
+        self.set_reg(CS, CS_RESET);
+        self.set_reg(DEBUG, DEBUG_ERRORS);
+    }
+
+    fn reg(&self, offset: usize) -> u32 {
+        unsafe { self.regs.add(offset / 4).read_volatile() }
+    }
+
+    fn set_reg(&self, offset: usize, value: u32) {
+        unsafe { self.regs.add(offset / 4).write_volatile(value) }
+    }
+
+    fn page_reg(&self, offset: usize) -> u32 {
+        unsafe { self.page.add(offset / 4).read_volatile() }
+    }
+
+    fn set_page_reg(&self, offset: usize, value: u32) {
+        unsafe { self.page.add(offset / 4).write_volatile(value) }
+    }
+}
+
+/// Bus address minus physical address of RAM, from the first entry of
+/// `/soc`'s dma-ranges (one cell each for bus address, physical address and
+/// size on the BCM283x).
+fn ram_bus_offset(fdt: &Fdt) -> usize {
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.property("dma-ranges"))
+        .filter(|prop| prop.value.len() >= 12)
+        .map(|prop| {
+            let cell = |i: usize| u32::from_be_bytes(prop.value[i * 4..i * 4 + 4].try_into().unwrap());
+            (cell(0) as usize).wrapping_sub(cell(1) as usize)
+        })
+        .unwrap_or(RAM_BUS_OFFSET)
+}
+
+/// Make the CPU's writes to the ring visible before the register write that
+/// starts the controller.
+pub fn barrier() {
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!("dsb sy", options(nostack, preserves_flags));
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    std::sync::atomic::fence(std::sync::atomic::Ordering::SeqCst);
+}
diff --git a/drivers/audio/bcm2835-hdmiaudiod/src/hdmi.rs b/drivers/audio/bcm2835-hdmiaudiod/src/hdmi.rs
new file mode 100644
index 00000000..749f0d98
--- /dev/null
+++ b/drivers/audio/bcm2835-hdmiaudiod/src/hdmi.rs
@@ -0,0 +1,499 @@
+//! The audio part of the VC4 HDMI block of the BCM2835/2837, as Linux
+//! `vc4_hdmi.c` (v6.12) programs it. The firmware keeps the picture; this
+//! driver touches only the MAI FIFO, the audio clock regeneration (N/CTS),
+//! the audio packet set-up and the audio info frame.
+//!
+//! Two register blocks: the HD block (`MAI_*`, bus 0x7e808000) holds the
+//! FIFO the DMA fills; the HDMI core (bus 0x7e902000) packs the samples
+//! into HDMI audio packets.
+//!
+//! The value functions are pure and tested on the build host; `Hdmi` does
+//! the register accesses.
+
+use std::time::{Duration, Instant};
+
+// HD block.
+pub const MAI_CTL: usize = 0x14;
+pub const MAI_THR: usize = 0x18;
+pub const MAI_FMT: usize = 0x1c;
+/// The FIFO: the DMA target.
+pub const MAI_DATA: usize = 0x20;
+pub const MAI_SMP: usize = 0x2c;
+
+// HDMI core.
+pub const HOTPLUG: usize = 0x0c;
+pub const MAI_CHANNEL_MAP: usize = 0x90;
+pub const MAI_CONFIG: usize = 0x94;
+pub const AUDIO_PACKET_CONFIG: usize = 0x9c;
+pub const RAM_PACKET_CONFIG: usize = 0xa0;
+pub const RAM_PACKET_STATUS: usize = 0xa4;
+pub const CRP_CFG: usize = 0xa8;
+pub const CTS_0: usize = 0xac;
+pub const CTS_1: usize = 0xb0;
+pub const SCHEDULER_CONTROL: usize = 0xc0;
+pub const RAM_PACKET_START: usize = 0x400;
+/// Bytes of packet RAM per packet (9 words).
+pub const PACKET_STRIDE: usize = 0x24;
+
+pub const HOTPLUG_CONNECTED: u32 = 1 << 0;
+pub const SCHEDULER_MODE_HDMI: u32 = 1 << 0;
+pub const SCHEDULER_HDMI_ACTIVE: u32 = 1 << 1;
+pub const RAM_PACKET_ENABLE: u32 = 1 << 16;
+
+pub const MAI_CTL_RESET: u32 = 1 << 0;
+pub const MAI_CTL_ERRORF: u32 = 1 << 1;
+pub const MAI_CTL_ERRORE: u32 = 1 << 2;
+pub const MAI_CTL_ENABLE: u32 = 1 << 3;
+pub const MAI_CTL_FLUSH: u32 = 1 << 9;
+pub const MAI_CTL_WHOLSMP: u32 = 1 << 12;
+pub const MAI_CTL_CHALIGN: u32 = 1 << 13;
+pub const MAI_CTL_DLATE: u32 = 1 << 15;
+
+const CRP_CFG_EXTERNAL_CTS_EN: u32 = 1 << 24;
+const MAI_CONFIG_FORMAT_REVERSE: u32 = 1 << 27;
+const MAI_CONFIG_BIT_REVERSE: u32 = 1 << 26;
+const AUDIO_PACKET_ZERO_DATA_ON_SAMPLE_FLAT: u32 = 1 << 29;
+const AUDIO_PACKET_ZERO_DATA_ON_INACTIVE_CHANNELS: u32 = 1 << 24;
+const AUDIO_PACKET_B_FRAME_SHIFT: u32 = 10;
+const MAI_FORMAT_PCM: u32 = 2;
+
+/// The audio info frame's type; it sits in packet RAM slot 0x84 − 0x80.
+pub const INFOFRAME_AUDIO: u8 = 0x84;
+pub const AUDIO_PACKET_ID: usize = (INFOFRAME_AUDIO - 0x80) as usize;
+
+/// The DMA request line of the HDMI MAI FIFO (BCM2835 devicetree:
+/// `dmas = <&dma 17>`).
+pub const DREQ_HDMI: u32 = 17;
+
+fn mask(channels: u32) -> u32 {
+    (1 << channels) - 1
+}
+
+/// `MAI_CTL` while playing.
+pub fn mai_ctl_play(channels: u32) -> u32 {
+    channels << 4 | MAI_CTL_WHOLSMP | MAI_CTL_CHALIGN | MAI_CTL_ENABLE
+}
+
+/// `MAI_CTL` to reset the FIFO and clear its error flags (Linux
+/// `vc4_hdmi_audio_startup`).
+pub const MAI_CTL_START: u32 = MAI_CTL_RESET | MAI_CTL_FLUSH | MAI_CTL_DLATE | MAI_CTL_ERRORE | MAI_CTL_ERRORF;
+
+/// DREQ high 6, low 8; panic 8 and 8.
+pub const MAI_THR_VALUE: u32 = 0x08 << 24 | 0x08 << 16 | 0x06 << 8 | 0x08;
+
+/// The `MAI_FMT` sample-rate code, 0 = not indicated.
+pub fn mai_rate_code(sample_rate: u32) -> u32 {
+    match sample_rate {
+        8_000 => 1,
+        11_025 => 2,
+        12_000 => 3,
+        16_000 => 4,
+        22_050 => 5,
+        24_000 => 6,
+        32_000 => 7,
+        44_100 => 8,
+        48_000 => 9,
+        64_000 => 10,
+        88_200 => 11,
+        96_000 => 12,
+        128_000 => 13,
+        176_400 => 14,
+        192_000 => 15,
+        _ => 0,
+    }
+}
+
+pub fn mai_fmt(sample_rate: u32) -> u32 {
+    MAI_FORMAT_PCM << 16 | mai_rate_code(sample_rate) << 8
+}
+
+pub fn mai_config(channels: u32) -> u32 {
+    MAI_CONFIG_BIT_REVERSE | MAI_CONFIG_FORMAT_REVERSE | mask(channels)
+}
+
+/// Channel `i` of the FIFO to HDMI channel `i` (3 bits each on VC4).
+pub fn channel_map(channels: u32) -> u32 {
+    (0..8).filter(|i| mask(channels) & 1 << i != 0).map(|i| i << (3 * i)).sum()
+}
+
+pub fn audio_packet_config(channels: u32) -> u32 {
+    AUDIO_PACKET_ZERO_DATA_ON_SAMPLE_FLAT
+        | AUDIO_PACKET_ZERO_DATA_ON_INACTIVE_CHANNELS
+        | crate::iec958::PREAMBLE_B << AUDIO_PACKET_B_FRAME_SHIFT
+        | mask(channels)
+}
+
+/// N of the audio clock regeneration, as Linux picks it: 128 × fs / 1000.
+pub fn acr_n(sample_rate: u32) -> u32 {
+    128 * sample_rate / 1000
+}
+
+/// CTS = pixel clock × N / (128 × fs).
+pub fn acr_cts(pixel_hz: u64, n: u32, sample_rate: u32) -> u32 {
+    (pixel_hz * u64::from(n) / (128 * u64::from(sample_rate))) as u32
+}
+
+pub fn crp_cfg(n: u32) -> u32 {
+    CRP_CFG_EXTERNAL_CTS_EN | (n & 0xf_ffff)
+}
+
+/// Linux `rational_best_approximation`: the fraction n/d closest to
+/// `num`/`den` with n ≤ `max_n` and d ≤ `max_d`.
+pub fn best_approximation(num: u64, den: u64, max_n: u64, max_d: u64) -> (u64, u64) {
+    let (mut n, mut d) = (num, den);
+    let (mut n0, mut d1, mut n1, mut d0) = (0u64, 0u64, 1u64, 1u64);
+    loop {
+        if d == 0 {
+            break;
+        }
+        let dp = d;
+        let a = n / d;
+        d = n % d;
+        n = dp;
+        let n2 = n0 + a * n1;
+        let d2 = d0 + a * d1;
+        if n2 > max_n || d2 > max_d {
+            let mut t = u64::MAX;
+            if d1 != 0 {
+                t = (max_d - d0) / d1;
+            }
+            if n1 != 0 {
+                t = t.min((max_n - n0) / n1);
+            }
+            // Take the semi-convergent if it is closer than the last
+            // convergent (always on the first step).
+            if d1 == 0 || 2 * t > a || (2 * t == a && d0 * dp > d1 * d) {
+                n1 = n0 + t * n1;
+                d1 = d0 + t * d1;
+            }
+            break;
+        }
+        n0 = n1;
+        n1 = n2;
+        d0 = d1;
+        d1 = d2;
+    }
+    (n1, d1)
+}
+
+/// `MAI_SMP`: the FIFO takes a sample every HSM / (N / M) clocks. N has 24
+/// bits, M − 1 has 8.
+pub fn mai_smp(hsm_hz: u64, sample_rate: u32) -> (u32, u32) {
+    let (n, m) = best_approximation(hsm_hz, u64::from(sample_rate), 0xff_ffff, 0x100);
+    (n as u32, m as u32)
+}
+
+pub fn mai_smp_value(n: u32, m: u32) -> u32 {
+    n << 8 | (m - 1)
+}
+
+/// The audio info frame (CEA-861 type 0x84, version 1, 10 bytes) for
+/// `channels` channels; coding, rate and size come from the stream.
+pub fn audio_infoframe(channels: u32) -> [u8; 14] {
+    let mut frame = [0u8; 14];
+    frame[0] = INFOFRAME_AUDIO;
+    frame[1] = 1;
+    frame[2] = 10;
+    frame[4] = (channels - 1) as u8;
+    let sum = frame.iter().fold(0u8, |s, b| s.wrapping_add(*b));
+    frame[3] = sum.wrapping_neg();
+    frame
+}
+
+/// The packet RAM words of an info frame, as Linux
+/// `vc4_hdmi_write_infoframe` writes them: groups of 7 bytes as a 3-byte
+/// and a 4-byte word, the rest of the slot zero.
+pub fn packet_words(frame: &[u8]) -> [u32; PACKET_STRIDE / 4] {
+    let b = |i: usize| u32::from(*frame.get(i).unwrap_or(&0));
+    let mut words = [0u32; PACKET_STRIDE / 4];
+    let (mut i, mut w) = (0, 0);
+    while i < frame.len() && w + 1 < words.len() {
+        words[w] = b(i) | b(i + 1) << 8 | b(i + 2) << 16;
+        words[w + 1] = b(i + 3) | b(i + 4) << 8 | b(i + 5) << 16 | b(i + 6) << 24;
+        i += 7;
+        w += 2;
+    }
+    words
+}
+
+/// The HSM clock from the clock manager (`CM_HSMCTL` 0x88, `CM_HSMDIV`
+/// 0x8c, 12.12 fixed-point divisor), if its source has a known rate: the
+/// oscillator (19.2 MHz) or PLLD_PER (500 MHz on the BCM2837).
+pub fn hsm_from_cprman(ctl: u32, div: u32) -> Option<u64> {
+    let source: u64 = match ctl & 0xf {
+        1 => 19_200_000,
+        6 => 500_000_000,
+        _ => return None,
+    };
+    let div = u64::from(div & 0xff_ffff);
+    (ctl & 1 << 4 != 0 && div >= 1 << 12).then(|| source * 4096 / div)
+}
+
+/// Clock manager offsets (from its base, 0x7e101000) of PLLH and its pixel
+/// channel, as Linux `clk-bcm2835.c` reads them.
+pub const A2W_PLLH_ANA1: usize = 0x1074;
+pub const A2W_PLLH_CTRL: usize = 0x1160;
+pub const A2W_PLLH_FRAC: usize = 0x1260;
+pub const A2W_PLLH_PIX: usize = 0x1560;
+const OSC_HZ: u64 = 19_200_000;
+
+/// The HDMI pixel clock, PLLH_PIX: PLLH = 19.2 MHz × (NDIV + FRAC / 2^20)
+/// / PDIV (NDIV and FRAC doubled when the feedback prediv bit 11 of ANA1
+/// is set), then the channel divider (8 bits, 0 = 256) and a fixed 10.
+/// `None` if PDIV is 0 or the channel is off (bit 8).
+pub fn pixel_from_pllh(ctrl: u32, frac: u32, ana1: u32, pix: u32) -> Option<u64> {
+    let (mut ndiv, mut fdiv) = (u64::from(ctrl & 0x3ff), u64::from(frac & 0xf_ffff));
+    let pdiv = u64::from(ctrl >> 12 & 0x7);
+    if pdiv == 0 || pix & 1 << 8 != 0 {
+        return None;
+    }
+    if ana1 & 1 << 11 != 0 {
+        ndiv *= 2;
+        fdiv *= 2;
+    }
+    let pll = (OSC_HZ * ((ndiv << 20) + fdiv) / pdiv) >> 20;
+    let div = match u64::from(pix & 0xff) {
+        0 => 256,
+        d => d,
+    };
+    Some(pll / div / 10)
+}
+
+/// What the driver found in the HDMI core at start.
+pub struct State {
+    pub hotplug: bool,
+    pub scheduler: u32,
+}
+
+impl State {
+    pub fn hdmi_mode(&self) -> bool {
+        self.scheduler & SCHEDULER_MODE_HDMI != 0
+    }
+}
+
+pub struct Hdmi {
+    /// HDMI core registers.
+    core: *mut u32,
+    /// HD block registers.
+    hd: *mut u32,
+}
+
+unsafe impl Send for Hdmi {}
+
+impl Hdmi {
+    /// # Safety
+    /// `core` and `hd` map the two register blocks.
+    pub unsafe fn new(core: *mut u32, hd: *mut u32) -> Self {
+        Hdmi { core, hd }
+    }
+
+    pub fn core(&self, offset: usize) -> u32 {
+        unsafe { self.core.add(offset / 4).read_volatile() }
+    }
+
+    pub fn set_core(&self, offset: usize, value: u32) {
+        unsafe { self.core.add(offset / 4).write_volatile(value) }
+    }
+
+    pub fn hd(&self, offset: usize) -> u32 {
+        unsafe { self.hd.add(offset / 4).read_volatile() }
+    }
+
+    pub fn set_hd(&self, offset: usize, value: u32) {
+        unsafe { self.hd.add(offset / 4).write_volatile(value) }
+    }
+
+    pub fn state(&self) -> State {
+        State {
+            hotplug: self.core(HOTPLUG) & HOTPLUG_CONNECTED != 0,
+            scheduler: self.core(SCHEDULER_CONTROL),
+        }
+    }
+
+    /// Switch the output from DVI to HDMI mode, as Linux does when the sink
+    /// says it takes HDMI. True once the core reports HDMI active.
+    pub fn force_hdmi_mode(&self) -> bool {
+        self.set_core(SCHEDULER_CONTROL, self.core(SCHEDULER_CONTROL) | SCHEDULER_MODE_HDMI);
+        wait(|| self.core(SCHEDULER_CONTROL) & SCHEDULER_HDMI_ACTIVE != 0, 1000)
+    }
+
+    /// Program the audio path for `channels` channels of PCM at
+    /// `sample_rate` (Linux `vc4_hdmi_audio_startup` and `_prepare`), with
+    /// the DMA not yet running.
+    pub fn setup(&self, channels: u32, sample_rate: u32, hsm_hz: u64, pixel_hz: u64) {
+        self.set_hd(MAI_CTL, MAI_CTL_START);
+        let (n, m) = mai_smp(hsm_hz, sample_rate);
+        self.set_hd(MAI_SMP, mai_smp_value(n, m));
+        self.set_hd(MAI_CTL, mai_ctl_play(channels));
+        self.set_hd(MAI_FMT, mai_fmt(sample_rate));
+        self.set_hd(MAI_THR, MAI_THR_VALUE);
+        self.set_core(MAI_CONFIG, mai_config(channels));
+        self.set_core(MAI_CHANNEL_MAP, channel_map(channels));
+        self.set_core(AUDIO_PACKET_CONFIG, audio_packet_config(channels));
+        let acr = acr_n(sample_rate);
+        self.set_core(CRP_CFG, crp_cfg(acr));
+        let cts = acr_cts(pixel_hz, acr, sample_rate);
+        self.set_core(CTS_0, cts);
+        self.set_core(CTS_1, cts);
+    }
+
+    /// Only the sample clock, after a measurement corrected the HSM rate.
+    pub fn set_sample_clock(&self, hsm_hz: u64, sample_rate: u32) {
+        let (n, m) = mai_smp(hsm_hz, sample_rate);
+        self.set_hd(MAI_SMP, mai_smp_value(n, m));
+    }
+
+    /// Write the audio info frame into packet RAM and send it with every
+    /// frame. False if the core did not take it within 100 ms.
+    pub fn send_audio_infoframe(&self, channels: u32) -> bool {
+        let bit = 1 << AUDIO_PACKET_ID;
+        let config = self.core(RAM_PACKET_CONFIG) | RAM_PACKET_ENABLE;
+        self.set_core(RAM_PACKET_CONFIG, config & !bit);
+        wait(|| self.core(RAM_PACKET_STATUS) & bit == 0, 100);
+        let base = RAM_PACKET_START + PACKET_STRIDE * AUDIO_PACKET_ID;
+        for (i, word) in packet_words(&audio_infoframe(channels)).iter().enumerate() {
+            self.set_core(base + i * 4, *word);
+        }
+        self.set_core(RAM_PACKET_CONFIG, config | bit);
+        wait(|| self.core(RAM_PACKET_STATUS) & bit != 0, 100)
+    }
+
+    pub fn infoframe_active(&self) -> bool {
+        self.core(RAM_PACKET_STATUS) & 1 << AUDIO_PACKET_ID != 0
+    }
+
+    /// The FIFO's error flags (underflow, overflow), cleared on read.
+    pub fn take_errors(&self) -> u32 {
+        let ctl = self.hd(MAI_CTL);
+        let errors = ctl & (MAI_CTL_ERRORE | MAI_CTL_ERRORF);
+        if errors != 0 {
+            // Write-1-to-clear; RESET and FLUSH stay 0.
+            self.set_hd(MAI_CTL, (ctl & !(MAI_CTL_RESET | MAI_CTL_FLUSH)) | errors);
+        }
+        errors
+    }
+
+    /// Stop the FIFO and the info frame (Linux `vc4_hdmi_audio_reset`).
+    pub fn stop(&self) {
+        self.set_core(RAM_PACKET_CONFIG, self.core(RAM_PACKET_CONFIG) & !(1 << AUDIO_PACKET_ID));
+        self.set_hd(MAI_CTL, MAI_CTL_RESET);
+        self.set_hd(MAI_CTL, MAI_CTL_ERRORF);
+        self.set_hd(MAI_CTL, MAI_CTL_FLUSH);
+    }
+}
+
+fn wait(done: impl Fn() -> bool, ms: u64) -> bool {
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_millis(ms) {
+        if done() {
+            return true;
+        }
+        std::thread::yield_now();
+    }
+    done()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn register_values_as_linux_writes_them() {
+        assert_eq!(mai_ctl_play(2), 0x3028);
+        assert_eq!(MAI_CTL_START, 0x8207);
+        assert_eq!(MAI_THR_VALUE, 0x0808_0608);
+        assert_eq!(mai_fmt(44_100), 0x0002_0800);
+        assert_eq!(mai_fmt(48_000), 0x0002_0900);
+        assert_eq!(mai_config(2), 0x0c00_0003);
+        assert_eq!(channel_map(2), 0x8);
+        assert_eq!(channel_map(8), 0o76543210);
+        assert_eq!(audio_packet_config(2), 0x2100_2003);
+        assert_eq!(crp_cfg(6144), 0x0100_1800);
+    }
+
+    #[test]
+    fn n_and_cts() {
+        assert_eq!(acr_n(48_000), 6144);
+        assert_eq!(acr_n(44_100), 5644);
+        // 1080p60 and 720p60, 48 kHz: the HDMI spec's CTS values.
+        assert_eq!(acr_cts(148_500_000, 6144, 48_000), 148_500);
+        assert_eq!(acr_cts(74_250_000, 6144, 48_000), 74_250);
+        // 44.1 kHz: CTS × 128 × fs = pixel × N to within one CTS step.
+        let cts = acr_cts(148_500_000, 5644, 44_100);
+        let lhs = u64::from(cts) * 128 * 44_100;
+        assert!(lhs <= 148_500_000 * 5644 && 148_500_000 * 5644 - lhs < 128 * 44_100);
+    }
+
+    #[test]
+    fn best_approximation_as_linux() {
+        assert_eq!(best_approximation(3, 4, 100, 100), (3, 4));
+        assert_eq!(best_approximation(31_415_926, 10_000_000, 400, 400), (355, 113));
+        // 10230179/3000 reduced: the denominator must shrink to 256 or less.
+        let (n, d) = best_approximation(163_682_864, 48_000, 0xff_ffff, 0x100);
+        assert!(d <= 0x100 && n <= 0xff_ffff);
+        assert!((n as f64 / d as f64 - 163_682_864.0 / 48_000.0).abs() < 1e-4);
+    }
+
+    #[test]
+    fn mai_smp_hits_the_rate() {
+        for hsm in [163_682_864u64, 120_000_000, 148_500_000, 500_000_000 / 3] {
+            for fs in [44_100u32, 48_000] {
+                let (n, m) = mai_smp(hsm, fs);
+                assert!(n <= 0xff_ffff && (1..=256).contains(&m));
+                let got = hsm as f64 * f64::from(m) / f64::from(n);
+                assert!((got - f64::from(fs)).abs() / f64::from(fs) < 1e-6, "{hsm} {fs}: {got}");
+                assert_eq!(mai_smp_value(n, m) & 0xff, m - 1);
+            }
+        }
+    }
+
+    #[test]
+    fn audio_infoframe_and_packet_ram() {
+        let f = audio_infoframe(2);
+        assert_eq!(&f[..3], &[0x84, 1, 10]);
+        assert_eq!(f[4], 1, "two channels");
+        assert_eq!(f.iter().fold(0u8, |s, b| s.wrapping_add(*b)), 0, "checksum");
+        assert_eq!(f[3], 0x70);
+        let w = packet_words(&f);
+        assert_eq!(w[0], 0x000a_0184);
+        assert_eq!(w[1], 0x0000_0170, "checksum, PB1 = 1, PB2, PB3");
+        assert_eq!(w[2], 0);
+        assert_eq!(&w[3..], &[0; 6]);
+        // A frame that fills more groups lands in the same 3/4 pattern.
+        let long: Vec<u8> = (1..=17).collect();
+        let w = packet_words(&long);
+        assert_eq!(w[0], 0x0003_0201);
+        assert_eq!(w[1], 0x0706_0504);
+        assert_eq!(w[2], 0x000a_0908);
+        assert_eq!(w[3], 0x0e0d_0c0b);
+        assert_eq!(w[4], 0x0011_100f);
+        assert_eq!(w[5], 0);
+    }
+
+    #[test]
+    fn hsm_from_the_clock_manager() {
+        // PLLD_PER / 3, enabled.
+        assert_eq!(hsm_from_cprman(0x16, 3 << 12), Some(166_666_666));
+        assert_eq!(hsm_from_cprman(0x06, 3 << 12), None, "not enabled");
+        assert_eq!(hsm_from_cprman(0x15, 3 << 12), None, "PLLC: rate unknown");
+    }
+
+    #[test]
+    fn pixel_clock_from_pllh() {
+        // 2970 MHz = 19.2 MHz × 154.6875; / 2 / 10 = 148.5 MHz (1080p60).
+        let frac = (0.6875 * f64::from(1 << 20)) as u32;
+        assert_eq!(pixel_from_pllh(1 << 12 | 154, frac, 0, 2), Some(148_500_000));
+        // The same with the prediv bit: half NDIV and FRAC.
+        assert_eq!(pixel_from_pllh(1 << 12 | 77, frac / 2, 1 << 11, 2), Some(148_500_000));
+        // 720p60: divider 4.
+        assert_eq!(pixel_from_pllh(1 << 12 | 154, frac, 0, 4), Some(74_250_000));
+        assert_eq!(pixel_from_pllh(154, frac, 0, 2), None, "PDIV 0");
+        assert_eq!(pixel_from_pllh(1 << 12 | 154, frac, 0, 1 << 8 | 2), None, "channel off");
+    }
+
+    #[test]
+    fn state_mode() {
+        let s = State { hotplug: true, scheduler: 0x3 };
+        assert!(s.hdmi_mode());
+    }
+}
