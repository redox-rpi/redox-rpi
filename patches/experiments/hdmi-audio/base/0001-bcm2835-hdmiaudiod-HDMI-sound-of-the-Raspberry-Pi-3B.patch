@@ -0,0 +1,878 @@
+//! HDMI sound of the Raspberry Pi 3B+ and Zero 2 W as the `audiohw` scheme
+//! for `audiod` (issue #423). The firmware sets up the picture; this driver
+//! programs only the audio part of the VC4 HDMI block (`hdmi.rs`), so no
+//! display driver is needed.
+//!
+//! - `/scheme/audiohw`: writes of exactly 2048 bytes, one chunk of 512
+//!   frames, signed 16-bit little endian, stereo, 44.1 kHz, as
+//!   `bcm2835-pwmaudiod` takes them. When the ring is full the write waits,
+//!   or fails with `EWOULDBLOCK` on a non-blocking handle.
+//! - `/scheme/audiohw/stats`: what the driver found in the HDMI block,
+//!   clocks, ring and error counters, `loud_chunks` and `peak`.
+//! - `/scheme/audiohw/tone`: writing `<seconds> [<hz>]` plays a sine
+//!   through the ring (a quarter of full scale), mixed in place of chunks.
+//! - `/scheme/audiohw/stop`: any write stops the FIFO and the audio info
+//!   frame (`reboot` writes it). Later chunks are taken and dropped.
+//!
+//! The DMA controller (channel 0, DREQ 17) plays a ring of 8 slots of 512
+//! frames, as IEC958 subframes (`iec958.rs`), into the MAI FIFO; a timer
+//! every 10 ms follows it, fills played slots with silence, counts FIFO
+//! errors and programs the audio part again if the firmware reset it (a
+//! hotplug). Without an HDMI output (QEMU, or no display at boot) the ring
+//! is played by the clock instead, so `audiod` and the scheme still run.
+
+use std::fmt::Write as _;
+use std::fs::{File, OpenOptions};
+use std::io::{Read, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::os::unix::io::AsRawFd;
+use std::process;
+use std::time::{Duration, Instant};
+
+use event::{user_data, EventQueue};
+use fdt::Fdt;
+use redox_scheme::scheme::SchemeSync;
+use redox_scheme::{CallerCtx, OpenResult, Socket};
+use scheme_utils::{FpathWriter, HandleMap, ReadinessBased};
+use syscall::error::{Error, Result, EACCES, EBADF, EINVAL, EISDIR, ENODEV, ENOENT, EROFS, EWOULDBLOCK};
+use syscall::schemev2::NewFdFlags;
+use syscall::{MODE_DIR, MODE_FILE};
+
+mod dma;
+mod hdmi;
+mod iec958;
+mod ring;
+
+use dma::{DmaRing, SLOTS, SLOT_WORDS};
+use hdmi::Hdmi;
+use iec958::Encoder;
+use ring::{Ring, CHUNK_BYTES, SLOT_FRAMES};
+
+/// Bus addresses on the BCM283x, if the devicetree has none.
+const HDMI_BUS_ADDR: usize = 0x7e90_2000;
+const HD_BUS_ADDR: usize = 0x7e80_8000;
+const CPRMAN_BUS_ADDR: usize = 0x7e10_1000;
+const CM_HSMCTL: usize = 0x88;
+const CM_HSMDIV: usize = 0x8c;
+const PAGE_SIZE: usize = 4096;
+const SAMPLE_RATE: u32 = 44_100;
+const CHANNELS: u32 = 2;
+/// The HSM clock Linux used to set on the BCM2835 (vc4_hdmi.c before 5.x),
+/// if the clock manager's source is not one with a known rate.
+const DEFAULT_HSM_HZ: u64 = 163_682_864;
+/// If rpi-firmwared knows no pixel clock: 1080p60.
+const DEFAULT_PIXEL_HZ: u64 = 148_500_000;
+const POLL: Duration = Duration::from_millis(10);
+/// Length of one rate measurement. Two in a row that agree within
+/// `RATE_AGREE` correct the HSM rate once, if they are off by more than
+/// `RATE_TOLERANCE`.
+const MEASURE_AFTER: Duration = Duration::from_secs(3);
+const RATE_TOLERANCE: f64 = 0.005;
+const RATE_AGREE: f64 = 0.002;
+/// The ring's position is only seen at a refresh. A gap longer than a turn
+/// of the ring (8 x 512 frames, 93 ms) loses whole turns, so a gap longer
+/// than this starts the measurement over (row 417: busy boot, 12.6 % lost).
+const MAX_GAP: Duration = Duration::from_millis(60);
+const MAX_TONE_SECONDS: f64 = 10.0;
+/// The tone's amplitude, a quarter of full scale, to spare ears.
+const TONE_AMPLITUDE: f64 = 0.25;
+/// A chunk counts as loud when a sample reaches 1/256 of full scale (as in
+/// `bcm2835-pwmaudiod`; tests tell sound from silence by it).
+const LOUD: u16 = 128;
+
+enum Output {
+    Hdmi { hdmi: Hdmi, dma: DmaRing, phys: usize },
+    /// No HDMI output: slots count as played by the clock.
+    Clock { start: Instant, buf: Vec<[u32; SLOT_WORDS]> },
+}
+
+impl Output {
+    fn slot_mut(&mut self, index: usize) -> &mut [u32; SLOT_WORDS] {
+        match self {
+            Output::Hdmi { dma, .. } => dma.slot_mut(index),
+            Output::Clock { buf, .. } => &mut buf[index],
+        }
+    }
+
+    fn position(&self) -> Option<usize> {
+        match self {
+            Output::Hdmi { dma, .. } => dma.position(),
+            Output::Clock { start, .. } => {
+                let frames = start.elapsed().as_nanos() * u128::from(SAMPLE_RATE) / 1_000_000_000;
+                Some((frames / SLOT_FRAMES as u128 % SLOTS as u128) as usize)
+            }
+        }
+    }
+}
+
+/// How the driver came by the HSM rate.
+#[derive(Clone, Copy)]
+enum HsmSource {
+    Cprman,
+    Default,
+    Measured,
+}
+
+impl HsmSource {
+    fn name(self) -> &'static str {
+        match self {
+            HsmSource::Cprman => "cprman",
+            HsmSource::Default => "default",
+            HsmSource::Measured => "measured",
+        }
+    }
+}
+
+/// What the driver found and set at start.
+struct Setup {
+    hotplug: bool,
+    hdmi_mode: bool,
+    /// The driver switched the output from DVI to HDMI mode.
+    forced_hdmi_mode: bool,
+    scheduler: u32,
+    pixel_hz: u64,
+    pixel_source: &'static str,
+    pllh_regs: [u32; 4],
+    hsm_hz: u64,
+    hsm_source: HsmSource,
+    hsm_regs: (u32, u32),
+    infoframe: bool,
+}
+
+/// A sine played through the ring.
+struct Tone {
+    hz: f64,
+    frames_left: u64,
+    phase: u64,
+}
+
+enum Handle {
+    Root,
+    Pcm,
+    Stats(Vec<u8>),
+    Tone,
+    Stop,
+}
+
+struct Driver {
+    out: Output,
+    setup: Option<Setup>,
+    ring: Ring,
+    enc: Encoder,
+    started: Instant,
+    /// Start of the rate measurement (time, slot), the previous
+    /// measurement, and whether the HSM rate was settled already.
+    window: (Instant, u64),
+    previous_rate: Option<f64>,
+    corrected: bool,
+    last_refresh: Instant,
+    /// Refreshes after a gap over `MAX_GAP`.
+    long_gaps: u64,
+    chunks: u64,
+    loud_chunks: u64,
+    peak: u16,
+    dma_faults: u64,
+    last_fault: Option<(u32, u32)>,
+    mai_underflows: u64,
+    mai_overflows: u64,
+    /// Times the audio registers were found reset and programmed again.
+    reprogrammed: u64,
+    tone: Option<Tone>,
+    tones: u64,
+    stopped: bool,
+    handles: HandleMap<Handle>,
+}
+
+impl Driver {
+    fn new(out: Output, setup: Option<Setup>) -> Self {
+        let now = Instant::now();
+        Driver {
+            out,
+            setup,
+            ring: Ring::new(SLOTS, 1),
+            enc: Encoder::new(SAMPLE_RATE),
+            started: now,
+            window: (now, 0),
+            previous_rate: None,
+            corrected: false,
+            last_refresh: now,
+            long_gaps: 0,
+            chunks: 0,
+            loud_chunks: 0,
+            peak: 0,
+            dma_faults: 0,
+            last_fault: None,
+            mai_underflows: 0,
+            mai_overflows: 0,
+            reprogrammed: 0,
+            tone: None,
+            tones: 0,
+            stopped: false,
+            handles: HandleMap::new(),
+        }
+    }
+
+    /// Fill the whole ring with silence, slot `i` being number `i`.
+    fn fill_silence(&mut self) {
+        for i in 0..SLOTS {
+            let first = (i * SLOT_FRAMES) as u64;
+            self.enc.silence(self.out.slot_mut(i), first);
+        }
+    }
+
+    /// Follow the controller: silence the slots it has played, count errors,
+    /// restart the channel after a fault, keep the audio set-up in place.
+    fn refresh(&mut self) {
+        if self.stopped {
+            return;
+        }
+        if let Some(index) = self.out.position() {
+            let (out, enc) = (&mut self.out, &self.enc);
+            self.ring.advance(index, |n| {
+                let next = n + SLOTS as u64;
+                enc.silence(out.slot_mut((n % SLOTS as u64) as usize), next * SLOT_FRAMES as u64);
+            });
+        }
+        let now = Instant::now();
+        if now - self.last_refresh > MAX_GAP {
+            // Turns may have gone uncounted: measure from here.
+            self.long_gaps += 1;
+            self.window = (now, self.ring.current());
+        }
+        self.last_refresh = now;
+        self.feed_tone();
+        let Output::Hdmi { hdmi, dma, .. } = &self.out else {
+            return;
+        };
+        let errors = hdmi.take_errors();
+        if errors & hdmi::MAI_CTL_ERRORE != 0 {
+            self.mai_underflows += 1;
+        }
+        if errors & hdmi::MAI_CTL_ERRORF != 0 {
+            self.mai_overflows += 1;
+        }
+        if let Some(setup) = &self.setup {
+            let want = hdmi::crp_cfg(hdmi::acr_n(SAMPLE_RATE));
+            if hdmi.hd(hdmi::MAI_CTL) & hdmi::MAI_CTL_ENABLE == 0 || hdmi.core(hdmi::CRP_CFG) != want {
+                self.reprogrammed += 1;
+                if self.reprogrammed <= 3 {
+                    eprintln!("bcm2835-hdmiaudiod: audio set-up was reset (hotplug?), programming it again");
+                }
+                hdmi.setup(CHANNELS, SAMPLE_RATE, setup.hsm_hz, setup.pixel_hz);
+                hdmi.send_audio_infoframe(CHANNELS);
+            }
+        }
+        if let Some((cs, debug)) = dma.fault() {
+            self.dma_faults += 1;
+            self.last_fault = Some((cs, debug));
+            if self.dma_faults <= 3 {
+                eprintln!("bcm2835-hdmiaudiod: DMA stopped (CS 0x{cs:08x}, DEBUG 0x{debug:08x}), restarting");
+            }
+            self.fill_silence();
+            self.ring = Ring::new(SLOTS, 1);
+            self.window = (Instant::now(), 0);
+            if let Output::Hdmi { dma, .. } = &self.out {
+                dma::barrier();
+                dma.start();
+            }
+        }
+        self.correct_rate();
+    }
+
+    /// Once two measurements of `MEASURE_AFTER` without a long gap agree:
+    /// if the DMA progress shows another sample rate than set, the HSM rate
+    /// was wrong; set the sample clock from the corrected rate.
+    fn correct_rate(&mut self) {
+        let (since, first) = self.window;
+        let elapsed = since.elapsed();
+        if self.corrected || elapsed < MEASURE_AFTER {
+            return;
+        }
+        let frames = (self.ring.current() - first) * SLOT_FRAMES as u64;
+        let measured = frames as f64 / elapsed.as_secs_f64();
+        self.window = (Instant::now(), self.ring.current());
+        let agrees = self
+            .previous_rate
+            .is_some_and(|prev| prev > 0.0 && (measured / prev - 1.0).abs() < RATE_AGREE);
+        self.previous_rate = Some(measured);
+        if !agrees {
+            return;
+        }
+        self.corrected = true;
+        let (Output::Hdmi { hdmi, .. }, Some(setup)) = (&self.out, &mut self.setup) else {
+            return;
+        };
+        if measured < f64::from(SAMPLE_RATE) / 4.0 {
+            eprintln!("bcm2835-hdmiaudiod: the FIFO takes only {measured:.0} frames/s; HSM clock off?");
+            return;
+        }
+        let error = measured / f64::from(SAMPLE_RATE) - 1.0;
+        if error.abs() > RATE_TOLERANCE {
+            let hsm = (setup.hsm_hz as f64 * measured / f64::from(SAMPLE_RATE)) as u64;
+            println!(
+                "bcm2835-hdmiaudiod: measured {measured:.0} frames/s, HSM clock {} Hz rather than {}; correcting",
+                hsm, setup.hsm_hz
+            );
+            setup.hsm_hz = hsm;
+            setup.hsm_source = HsmSource::Measured;
+            hdmi.set_sample_clock(hsm, SAMPLE_RATE);
+        } else {
+            println!("bcm2835-hdmiaudiod: measured {measured:.0} frames/s");
+        }
+    }
+
+    /// Put `frames` (left, right) into the next free slot.
+    fn put(&mut self, frames: &mut dyn Iterator<Item = (i16, i16)>) -> Result<()> {
+        let number = self.ring.reserve_numbered().ok_or(Error::new(EWOULDBLOCK))?;
+        let first = number * SLOT_FRAMES as u64;
+        let enc = &self.enc;
+        let slot = self.out.slot_mut((number % SLOTS as u64) as usize);
+        for (i, words) in slot.chunks_exact_mut(2).enumerate() {
+            let (left, right) = frames.next().unwrap_or((0, 0));
+            words.copy_from_slice(&enc.frame(first + i as u64, left, right));
+        }
+        Ok(())
+    }
+
+    fn play(&mut self, chunk: &[u8]) -> Result<usize> {
+        if chunk.len() != CHUNK_BYTES {
+            return Err(Error::new(EINVAL));
+        }
+        let peak = chunk
+            .chunks_exact(2)
+            .map(|s| i16::from_le_bytes([s[0], s[1]]).unsigned_abs())
+            .max()
+            .unwrap_or(0);
+        if self.stopped {
+            self.chunks += 1;
+            return Ok(chunk.len());
+        }
+        self.refresh();
+        if self.tone.is_some() {
+            return Err(Error::new(EWOULDBLOCK));
+        }
+        let mut frames = chunk.chunks_exact(4).map(|f| {
+            (i16::from_le_bytes([f[0], f[1]]), i16::from_le_bytes([f[2], f[3]]))
+        });
+        self.put(&mut frames)?;
+        self.chunks += 1;
+        if peak >= LOUD {
+            self.loud_chunks += 1;
+        }
+        self.peak = self.peak.max(peak);
+        Ok(chunk.len())
+    }
+
+    /// Fill free slots with the tone while it lasts.
+    fn feed_tone(&mut self) {
+        while let Some(mut tone) = self.tone.take() {
+            if tone.frames_left == 0 {
+                break;
+            }
+            let n = tone.frames_left.min(SLOT_FRAMES as u64);
+            let amplitude = TONE_AMPLITUDE * f64::from(i16::MAX);
+            let (hz, phase) = (tone.hz, tone.phase);
+            let mut frames = (0..n).map(|i| {
+                let t = (phase + i) as f64 / f64::from(SAMPLE_RATE);
+                let s = (amplitude * (2.0 * std::f64::consts::PI * hz * t).sin()) as i16;
+                (s, s)
+            });
+            if self.put(&mut frames).is_err() {
+                self.tone = Some(tone);
+                break;
+            }
+            self.loud_chunks += 1;
+            self.peak = self.peak.max(amplitude as u16);
+            tone.phase += n;
+            tone.frames_left -= n;
+            self.tone = Some(tone);
+        }
+        if self.tone.as_ref().is_some_and(|t| t.frames_left == 0) {
+            self.tone = None;
+        }
+    }
+
+    /// `<seconds> [<hz>]`.
+    fn start_tone(&mut self, request: &[u8]) -> Result<()> {
+        let text = std::str::from_utf8(request).map_err(|_| Error::new(EINVAL))?;
+        let mut words = text.split_whitespace();
+        let seconds = match words.next().map(str::parse::<f64>) {
+            Some(Ok(s)) if s > 0.0 && s <= MAX_TONE_SECONDS => s,
+            _ => return Err(Error::new(EINVAL)),
+        };
+        let hz = match words.next().map(str::parse::<f64>) {
+            None => 1000.0,
+            Some(Ok(f)) if f > 0.0 && f < f64::from(SAMPLE_RATE) / 2.0 => f,
+            _ => return Err(Error::new(EINVAL)),
+        };
+        if self.stopped {
+            return Err(Error::new(ENODEV));
+        }
+        self.tone = Some(Tone {
+            hz,
+            frames_left: (seconds * f64::from(SAMPLE_RATE)) as u64,
+            phase: 0,
+        });
+        self.tones += 1;
+        println!("bcm2835-hdmiaudiod: tone {hz} Hz for {seconds} s");
+        self.feed_tone();
+        Ok(())
+    }
+
+    fn stop(&mut self) {
+        if self.stopped {
+            return;
+        }
+        self.stopped = true;
+        self.tone = None;
+        if let Output::Hdmi { hdmi, dma, .. } = &self.out {
+            dma.reset();
+            hdmi.stop();
+        }
+        println!("bcm2835-hdmiaudiod: stopped");
+    }
+
+    fn stats(&mut self) -> String {
+        self.refresh();
+        let mut text = String::new();
+        let uptime = self.started.elapsed().as_secs_f64();
+        let played = self.ring.current();
+        match &self.out {
+            Output::Hdmi { hdmi, phys, .. } => {
+                let _ = writeln!(text, "mode hdmi-dma");
+                let _ = writeln!(text, "hdmi 0x{phys:08x}");
+                let _ = writeln!(text, "dma_channel {}", dma::CHANNEL);
+                let _ = writeln!(text, "dreq {}", hdmi::DREQ_HDMI);
+                let _ = writeln!(text, "mai_ctl 0x{:08x}", hdmi.hd(hdmi::MAI_CTL));
+                let _ = writeln!(text, "mai_smp 0x{:08x}", hdmi.hd(hdmi::MAI_SMP));
+                let _ = writeln!(text, "crp_cfg 0x{:08x}", hdmi.core(hdmi::CRP_CFG));
+                let _ = writeln!(text, "cts 0x{:08x}", hdmi.core(hdmi::CTS_0));
+                let _ = writeln!(text, "ram_packet_config 0x{:08x}", hdmi.core(hdmi::RAM_PACKET_CONFIG));
+                let _ = writeln!(text, "ram_packet_status 0x{:08x}", hdmi.core(hdmi::RAM_PACKET_STATUS));
+                let _ = writeln!(text, "infoframe_active {}", yes(hdmi.infoframe_active()));
+                let _ = writeln!(text, "hotplug_now {}", yes(hdmi.state().hotplug));
+            }
+            Output::Clock { .. } => {
+                let _ = writeln!(text, "mode clock (no HDMI output)");
+            }
+        }
+        if let Some(s) = &self.setup {
+            let _ = writeln!(text, "hotplug {}", yes(s.hotplug));
+            let _ = writeln!(text, "hdmi_mode {}", yes(s.hdmi_mode));
+            let _ = writeln!(text, "forced_hdmi_mode {}", yes(s.forced_hdmi_mode));
+            let _ = writeln!(text, "scheduler 0x{:08x}", s.scheduler);
+            let _ = writeln!(text, "pixel_hz {} {}", s.pixel_hz, s.pixel_source);
+            let [c, f, a, p] = s.pllh_regs;
+            let _ = writeln!(text, "pllh ctrl=0x{c:08x} frac=0x{f:08x} ana1=0x{a:08x} pix=0x{p:08x}");
+            let _ = writeln!(text, "hsm_hz {} {}", s.hsm_hz, s.hsm_source.name());
+            let _ = writeln!(text, "cm_hsm ctl=0x{:08x} div=0x{:08x}", s.hsm_regs.0, s.hsm_regs.1);
+            let _ = writeln!(text, "infoframe_sent {}", yes(s.infoframe));
+        }
+        if self.stopped {
+            let _ = writeln!(text, "stopped");
+        }
+        let _ = writeln!(text, "sample_rate {SAMPLE_RATE}");
+        let _ = writeln!(text, "slots {SLOTS}x{SLOT_FRAMES}");
+        let _ = writeln!(text, "uptime_s {uptime:.1}");
+        let _ = writeln!(text, "played_slots {played}");
+        let rate = if uptime > 0.0 { played as f64 * SLOT_FRAMES as f64 / uptime } else { 0.0 };
+        let _ = writeln!(text, "measured_rate_hz {rate:.0}");
+        let (since, first) = self.window;
+        let window = since.elapsed().as_secs_f64();
+        if window > 0.0 {
+            // Since the last long gap or the last measurement.
+            let recent = (played - first) as f64 * SLOT_FRAMES as f64 / window;
+            let _ = writeln!(text, "rate_window_hz {recent:.0} over {window:.1} s");
+        }
+        if let Some(rate) = self.previous_rate {
+            let _ = writeln!(text, "rate_last_measured_hz {rate:.0}");
+        }
+        let _ = writeln!(text, "rate_settled {}", yes(self.corrected));
+        let _ = writeln!(text, "long_gaps {}", self.long_gaps);
+        let _ = writeln!(text, "chunks {}", self.chunks);
+        let _ = writeln!(text, "loud_chunks {}", self.loud_chunks);
+        let _ = writeln!(text, "peak {}", self.peak);
+        let _ = writeln!(text, "tones {}", self.tones);
+        let _ = writeln!(text, "sound_slots {}", self.ring.played_sound);
+        let _ = writeln!(text, "underruns {}", self.ring.underruns);
+        let _ = writeln!(text, "queued {}", self.ring.queued());
+        let _ = writeln!(text, "dma_faults {}", self.dma_faults);
+        if let Some((cs, debug)) = self.last_fault {
+            let _ = writeln!(text, "last_fault cs=0x{cs:08x} debug=0x{debug:08x}");
+        }
+        let _ = writeln!(text, "mai_underflow_polls {}", self.mai_underflows);
+        let _ = writeln!(text, "mai_overflow_polls {}", self.mai_overflows);
+        let _ = writeln!(text, "reprogrammed {}", self.reprogrammed);
+        text
+    }
+}
+
+fn yes(b: bool) -> &'static str {
+    if b {
+        "yes"
+    } else {
+        "no"
+    }
+}
+
+impl SchemeSync for Driver {
+    fn scheme_root(&mut self) -> Result<usize> {
+        Ok(self.handles.insert(Handle::Root))
+    }
+
+    fn openat(
+        &mut self,
+        dirfd: usize,
+        path: &str,
+        _flags: usize,
+        _fcntl_flags: u32,
+        ctx: &CallerCtx,
+    ) -> Result<OpenResult> {
+        if !matches!(self.handles.get(dirfd)?, Handle::Root) {
+            return Err(Error::new(EACCES));
+        }
+        let handle = match path.trim_matches('/') {
+            "" if ctx.uid == 0 => Handle::Pcm,
+            "tone" if ctx.uid == 0 => Handle::Tone,
+            "stop" if ctx.uid == 0 => Handle::Stop,
+            "" | "tone" | "stop" => return Err(Error::new(EACCES)),
+            "stats" => Handle::Stats(self.stats().into_bytes()),
+            _ => return Err(Error::new(ENOENT)),
+        };
+        Ok(OpenResult::ThisScheme {
+            number: self.handles.insert(handle),
+            flags: NewFdFlags::POSITIONED,
+        })
+    }
+
+    fn read(
+        &mut self,
+        id: usize,
+        buf: &mut [u8],
+        offset: u64,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<usize> {
+        let data = match self.handles.get(id)? {
+            Handle::Stats(data) => data,
+            Handle::Root => return Err(Error::new(EISDIR)),
+            _ => return Err(Error::new(EBADF)),
+        };
+        let start = usize::try_from(offset).unwrap_or(usize::MAX).min(data.len());
+        let len = buf.len().min(data.len() - start);
+        buf[..len].copy_from_slice(&data[start..start + len]);
+        Ok(len)
+    }
+
+    fn write(
+        &mut self,
+        id: usize,
+        buf: &[u8],
+        _offset: u64,
+        _fcntl_flags: u32,
+        _ctx: &CallerCtx,
+    ) -> Result<usize> {
+        match self.handles.get(id)? {
+            Handle::Pcm => self.play(buf),
+            Handle::Tone => self.start_tone(buf).map(|()| buf.len()),
+            Handle::Stop => {
+                self.stop();
+                Ok(buf.len())
+            }
+            _ => Err(Error::new(EBADF)),
+        }
+    }
+
+    // Shells truncate a file before writing to it.
+    fn ftruncate(&mut self, id: usize, _len: u64, _ctx: &CallerCtx) -> Result<()> {
+        match self.handles.get(id)? {
+            Handle::Pcm | Handle::Tone | Handle::Stop => Ok(()),
+            _ => Err(Error::new(EROFS)),
+        }
+    }
+
+    fn fstat(&mut self, id: usize, stat: &mut syscall::Stat, _ctx: &CallerCtx) -> Result<()> {
+        match self.handles.get(id)? {
+            Handle::Stats(data) => {
+                stat.st_mode = 0o444 | MODE_FILE;
+                stat.st_size = data.len() as u64;
+            }
+            Handle::Pcm | Handle::Tone | Handle::Stop => stat.st_mode = 0o200 | MODE_FILE,
+            Handle::Root => stat.st_mode = 0o555 | MODE_DIR,
+        }
+        Ok(())
+    }
+
+    fn fsize(&mut self, id: usize, _ctx: &CallerCtx) -> Result<u64> {
+        match self.handles.get(id)? {
+            Handle::Stats(data) => Ok(data.len() as u64),
+            _ => Ok(0),
+        }
+    }
+
+    fn fpath(&mut self, id: usize, buf: &mut [u8], _ctx: &CallerCtx) -> Result<usize> {
+        self.handles.get(id).map_err(|_| Error::new(EBADF))?;
+        FpathWriter::with(buf, "audiohw", |_| Ok(()))
+    }
+
+    fn on_close(&mut self, id: usize) {
+        self.handles.remove(id);
+    }
+}
+
+/// The CPU physical address of a device at `bus_addr`, through `/soc`'s
+/// ranges.
+fn soc_phys(fdt: &Fdt, bus_addr: usize) -> usize {
+    fdt.find_node("/soc")
+        .and_then(|soc| soc.ranges())
+        .and_then(|mut ranges| {
+            ranges.find(|r| r.child_bus_address <= bus_addr && bus_addr - r.child_bus_address < r.size)
+        })
+        .map(|r| r.parent_bus_address + (bus_addr - r.child_bus_address))
+        .unwrap_or(bus_addr)
+}
+
+/// Bus address of entry `n` of the `reg` of the first device with one of
+/// `compatible`, or `fallback`.
+fn bus_addr(fdt: &Fdt, compatible: &[&str], n: usize, fallback: usize) -> usize {
+    fdt.find_compatible(compatible)
+        .and_then(|node| node.reg())
+        .and_then(|mut reg| reg.nth(n))
+        .map(|reg| reg.starting_address as usize)
+        .unwrap_or(fallback)
+}
+
+/// Map the page holding `phys`; the pointer points at `phys` itself.
+fn map(phys: usize) -> *mut u32 {
+    map_len(phys, PAGE_SIZE)
+}
+
+/// Map `len` bytes from `phys` (rounded out to pages).
+fn map_len(phys: usize, len: usize) -> *mut u32 {
+    let page = phys & !(PAGE_SIZE - 1);
+    let size = (phys - page + len).div_ceil(PAGE_SIZE) * PAGE_SIZE;
+    unsafe {
+        let base = common::physmap(page, size, common::Prot::RW, common::MemoryType::DeviceMemory)
+            .expect("bcm2835-hdmiaudiod: failed to map registers") as *mut u8;
+        base.add(phys - page) as *mut u32
+    }
+}
+
+/// The pixel clock from rpi-firmwared (`clocks`: name, current and maximum
+/// rate per line).
+fn pixel_clock() -> std::result::Result<u64, String> {
+    let clocks = std::fs::read_to_string("/scheme/rpi-firmware/clocks").map_err(|err| format!("no clocks file ({err})"))?;
+    let line = clocks
+        .lines()
+        .find(|line| line.split_whitespace().next() == Some("pixel"))
+        .ok_or("no pixel line in the clocks file")?;
+    match line.split_whitespace().nth(1).and_then(|w| w.parse::<u64>().ok()) {
+        Some(hz) if hz > 0 => Ok(hz),
+        _ => Err(format!("clocks file says \"{line}\"")),
+    }
+}
+
+/// Find the HDMI output and program its audio part, or the clock stand-in.
+fn open_output(fdt: &Fdt) -> (Output, Option<Setup>) {
+    let compatible = ["brcm,bcm2835-hdmi"];
+    let core_bus = bus_addr(fdt, &compatible, 0, HDMI_BUS_ADDR);
+    let hd_bus = bus_addr(fdt, &compatible, 1, HD_BUS_ADDR);
+    let core_phys = soc_phys(fdt, core_bus);
+    let hdmi = unsafe { Hdmi::new(map(core_phys), map(soc_phys(fdt, hd_bus))) };
+    let state = hdmi.state();
+
+    let clock_only = |why: String| {
+        println!("bcm2835-hdmiaudiod: {why}, playing to the clock");
+        Output::Clock {
+            start: Instant::now(),
+            buf: vec![[0; SLOT_WORDS]; SLOTS],
+        }
+    };
+    // QEMU has no HDMI block (reads give 0); a Pi whose firmware found no
+    // display leaves it off.
+    if !state.hotplug && state.scheduler == 0 {
+        return (clock_only(format!("no HDMI output at 0x{core_phys:08x} (QEMU, or no display at boot?)")), None);
+    }
+    let mut forced = false;
+    if !state.hdmi_mode() {
+        forced = hdmi.force_hdmi_mode();
+        println!(
+            "bcm2835-hdmiaudiod: output was in DVI mode; HDMI mode {}",
+            if forced { "now active" } else { "did not come up" }
+        );
+    }
+    // The clock manager, up to the PLLH registers.
+    let cm = map_len(
+        soc_phys(fdt, bus_addr(fdt, &["brcm,bcm2835-cprman"], 0, CPRMAN_BUS_ADDR)),
+        0x2000,
+    );
+    let cm_reg = |offset: usize| unsafe { cm.add(offset / 4).read_volatile() };
+    let hsm_regs = (cm_reg(CM_HSMCTL), cm_reg(CM_HSMDIV));
+    let pllh_regs = [
+        cm_reg(hdmi::A2W_PLLH_CTRL),
+        cm_reg(hdmi::A2W_PLLH_FRAC),
+        cm_reg(hdmi::A2W_PLLH_ANA1),
+        cm_reg(hdmi::A2W_PLLH_PIX),
+    ];
+    let pllh_hz = hdmi::pixel_from_pllh(pllh_regs[0], pllh_regs[1], pllh_regs[2], pllh_regs[3])
+        .filter(|hz| (20_000_000..=200_000_000).contains(hz));
+    // The firmware's answer first (the 3B+ firmware gives none), then PLLH,
+    // then 1080p60.
+    let (pixel_hz, pixel_source) = match (pixel_clock(), pllh_hz) {
+        (Ok(hz), _) => (hz, "rpi-firmwared"),
+        (Err(why), Some(hz)) => {
+            println!("bcm2835-hdmiaudiod: no pixel clock from rpi-firmwared ({why}), using PLLH_PIX");
+            (hz, "pllh")
+        }
+        (Err(why), None) => {
+            println!(
+                "bcm2835-hdmiaudiod: no pixel clock from rpi-firmwared ({why}) nor PLLH (ctrl=0x{:08x} frac=0x{:08x} ana1=0x{:08x} pix=0x{:08x}), assuming {} MHz",
+                pllh_regs[0], pllh_regs[1], pllh_regs[2], pllh_regs[3],
+                DEFAULT_PIXEL_HZ as f64 / 1e6
+            );
+            (DEFAULT_PIXEL_HZ, "default")
+        }
+    };
+    let (hsm_hz, hsm_source) = match hdmi::hsm_from_cprman(hsm_regs.0, hsm_regs.1) {
+        Some(hz) => (hz, HsmSource::Cprman),
+        None => (DEFAULT_HSM_HZ, HsmSource::Default),
+    };
+
+    let dma = match DmaRing::new(fdt, (hd_bus + hdmi::MAI_DATA) as u32, hdmi::DREQ_HDMI) {
+        Ok(dma) => dma,
+        Err(err) => {
+            eprintln!("bcm2835-hdmiaudiod: {err}");
+            process::exit(1);
+        }
+    };
+    hdmi.setup(CHANNELS, SAMPLE_RATE, hsm_hz, pixel_hz);
+    let infoframe = hdmi.send_audio_infoframe(CHANNELS);
+    let setup = Setup {
+        hotplug: state.hotplug,
+        hdmi_mode: state.hdmi_mode(),
+        forced_hdmi_mode: forced,
+        scheduler: state.scheduler,
+        pixel_hz,
+        pixel_source,
+        pllh_regs,
+        hsm_hz,
+        hsm_source,
+        hsm_regs,
+        infoframe,
+    };
+    println!(
+        "bcm2835-hdmiaudiod: HDMI at 0x{core_phys:08x}, hotplug {}, {} mode, pixel clock {:.3} MHz ({pixel_source}), HSM {:.3} MHz ({}), N {} CTS {}, info frame {}, DMA channel {} (DREQ {}), {SLOTS} x {SLOT_FRAMES} frames",
+        yes(state.hotplug),
+        if state.hdmi_mode() || forced { "HDMI" } else { "DVI" },
+        pixel_hz as f64 / 1e6,
+        hsm_hz as f64 / 1e6,
+        hsm_source.name(),
+        hdmi::acr_n(SAMPLE_RATE),
+        hdmi::acr_cts(pixel_hz, hdmi::acr_n(SAMPLE_RATE), SAMPLE_RATE),
+        if infoframe { "sent" } else { "NOT taken" },
+        dma::CHANNEL,
+        hdmi::DREQ_HDMI,
+    );
+    (Output::Hdmi { hdmi, dma, phys: core_phys }, Some(setup))
+}
+
+/// A one-shot timer on the monotonic clock, delivered as an event.
+struct Timer(File);
+
+impl Timer {
+    fn new() -> std::io::Result<Self> {
+        OpenOptions::new()
+            .read(true)
+            .write(true)
+            .custom_flags(syscall::O_NONBLOCK as i32)
+            .open(format!("/scheme/time/{}", syscall::CLOCK_MONOTONIC))
+            .map(Self)
+    }
+
+    fn arm(&mut self, after: Duration) {
+        let mut time = syscall::TimeSpec::default();
+        if self.0.read(&mut time).is_err() {
+            return;
+        }
+        let nsec = time.tv_nsec as u64 + u64::from(after.subsec_nanos());
+        time.tv_sec += after.as_secs() as i64 + (nsec / 1_000_000_000) as i64;
+        time.tv_nsec = (nsec % 1_000_000_000) as i32;
+        let _ = self.0.write(&time);
+    }
+
+    /// Consume the event.
+    fn fired(&mut self) {
+        let mut time = syscall::TimeSpec::default();
+        let _ = self.0.read(&mut time);
+    }
+}
+
+user_data! {
+    enum Source {
+        Scheme,
+        Time,
+    }
+}
+
+fn main() {
+    daemon::SchemeDaemon::new(daemon);
+}
+
+fn daemon(daemon: daemon::SchemeDaemon) -> ! {
+    common::init();
+    let dtb = std::fs::read("/scheme/kernel.dtb").unwrap_or_default();
+    let Ok(fdt) = Fdt::new(&dtb) else {
+        eprintln!("bcm2835-hdmiaudiod: no devicetree");
+        process::exit(1);
+    };
+    let (out, setup) = open_output(&fdt);
+    let mut driver = Driver::new(out, setup);
+    driver.fill_silence();
+    if let Output::Hdmi { dma, .. } = &driver.out {
+        dma::barrier();
+        dma.start();
+    }
+    driver.window = (Instant::now(), 0);
+    driver.last_refresh = Instant::now();
+
+    let mut timer = Timer::new().expect("bcm2835-hdmiaudiod: failed to open /scheme/time");
+    let socket = Socket::nonblock().expect("bcm2835-hdmiaudiod: failed to create the audiohw scheme");
+    let mut readiness = ReadinessBased::new(Box::new(socket), 16);
+
+    let events = EventQueue::<Source>::new().expect("bcm2835-hdmiaudiod: failed to create an event queue");
+    events
+        .subscribe(readiness.socket().inner().raw(), Source::Scheme, event::EventFlags::READ)
+        .expect("bcm2835-hdmiaudiod: failed to subscribe to the scheme");
+    events
+        .subscribe(timer.0.as_raw_fd() as usize, Source::Time, event::EventFlags::READ)
+        .expect("bcm2835-hdmiaudiod: failed to subscribe to the timer");
+    timer.arm(POLL);
+
+    let _ = daemon.ready_sync_scheme(readiness.socket(), &mut driver);
+    libredox::call::setrens(0, 0).expect("bcm2835-hdmiaudiod: failed to enter the null namespace");
+
+    for source in [Source::Scheme]
+        .into_iter()
+        .chain(events.map(|e| e.expect("bcm2835-hdmiaudiod: failed to get an event").user_data))
+    {
+        match source {
+            Source::Scheme => {
+                readiness
+                    .read_and_process_requests(&mut driver)
+                    .expect("bcm2835-hdmiaudiod: failed to read the scheme");
+            }
+            Source::Time => {
+                timer.fired();
+                timer.arm(POLL);
+                driver.refresh();
+                readiness
+                    .poll_all_requests(&mut driver)
+                    .expect("bcm2835-hdmiaudiod: failed to poll requests");
+            }
+        }
+        readiness
+            .write_responses()
+            .expect("bcm2835-hdmiaudiod: failed to write to the scheme");
+    }
+    process::exit(0);
+}
diff --git a/drivers/audio/bcm2835-hdmiaudiod/src/ring.rs b/drivers/audio/bcm2835-hdmiaudiod/src/ring.rs
new file mode 100644
index 00000000..72c8bec2
--- /dev/null
+++ b/drivers/audio/bcm2835-hdmiaudiod/src/ring.rs
@@ -0,0 +1,139 @@
+//! Bookkeeping for the ring of slots the DMA controller plays in a loop:
+//! which slot it plays now, which slots hold new sound, which slot the next
+//! chunk goes into. No hardware here, so it is tested on the build host.
+//!
+//! Slots are counted without wrapping (`u64`); slot `n` lives at index
+//! `n % slots` of the ring. After a slot has been played, the driver fills
+//! it with silence, so when no new chunk arrives in time the ring plays
+//! silence instead of old sound.
+
+/// Frames per slot: one chunk from `audiod`.
+pub const SLOT_FRAMES: usize = 512;
+/// Bytes of one chunk: 512 frames, two channels, s16le.
+pub const CHUNK_BYTES: usize = SLOT_FRAMES * 2 * 2;
+
+pub struct Ring {
+    slots: u64,
+    /// The slot being played.
+    current: u64,
+    /// The next slot to fill. Slots below it and above `current` hold new
+    /// sound.
+    written: u64,
+    /// Played slots that held new sound.
+    pub played_sound: u64,
+    /// Times the ring ran out of new sound (the end of each sound counts too).
+    pub underruns: u64,
+}
+
+impl Ring {
+    /// The ring starts at slot 0; slots below `first_free` hold the start-up
+    /// ramp and must not be written over.
+    pub fn new(slots: usize, first_free: usize) -> Self {
+        assert!(slots >= 4 && first_free < slots);
+        Ring {
+            slots: slots as u64,
+            current: 0,
+            written: first_free as u64,
+            played_sound: 0,
+            underruns: 0,
+        }
+    }
+
+    /// The slot being played, counted without wrapping.
+    pub fn current(&self) -> u64 {
+        self.current
+    }
+
+    /// Slots after the one being played that hold new sound.
+    pub fn queued(&self) -> u64 {
+        self.written.saturating_sub(self.current + 1)
+    }
+
+    /// The controller now plays ring index `index`. Calls `played` with the
+    /// number of every slot finished since the last call (its ring index is
+    /// the number modulo the ring size; it plays next as number + ring
+    /// size), so the caller can silence it. Must be called at least once per
+    /// turn of the ring.
+    pub fn advance(&mut self, index: usize, mut played: impl FnMut(u64)) {
+        let index = index as u64 % self.slots;
+        let delta = (index + self.slots - self.current % self.slots) % self.slots;
+        for _ in 0..delta {
+            if self.current < self.written {
+                self.played_sound += 1;
+                if self.current + 1 == self.written {
+                    self.underruns += 1;
+                }
+            }
+            played(self.current);
+            self.current += 1;
+        }
+    }
+
+    /// The ring index for the next chunk, or `None` while the ring is full.
+    #[cfg(test)]
+    pub fn reserve(&mut self) -> Option<usize> {
+        self.reserve_numbered().map(|n| (n % self.slots) as usize)
+    }
+
+    /// The number of the slot for the next chunk, or `None` while the ring
+    /// is full.
+    pub fn reserve_numbered(&mut self) -> Option<u64> {
+        if self.written < self.current + 2 {
+            // Out of sound: start two slots ahead, since the controller may
+            // be about to finish the current one.
+            self.written = self.current + 2;
+        }
+        if self.written >= self.current + self.slots {
+            return None;
+        }
+        self.written += 1;
+        Some(self.written - 1)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fills_until_full_then_frees_slots() {
+        let mut ring = Ring::new(8, 2);
+        let got: Vec<_> = std::iter::from_fn(|| ring.reserve()).collect();
+        // Slot 0 plays; 2..=7 are free (0 and 1 hold the ramp, which counts
+        // as sound).
+        assert_eq!(got, vec![2, 3, 4, 5, 6, 7]);
+        assert_eq!(ring.queued(), 7);
+
+        let mut silenced = Vec::new();
+        ring.advance(3, |i| silenced.push(i));
+        assert_eq!(silenced, vec![0, 1, 2]);
+        assert_eq!(ring.played_sound, 3);
+        assert_eq!(ring.reserve(), Some(0));
+        assert_eq!(ring.reserve(), Some(1));
+        assert_eq!(ring.reserve(), Some(2));
+        assert_eq!(ring.reserve(), None);
+    }
+
+    #[test]
+    fn underrun_restarts_two_slots_ahead() {
+        let mut ring = Ring::new(8, 1);
+        assert_eq!(ring.reserve(), Some(2));
+        ring.advance(2, |_| {});
+        ring.advance(6, |_| {});
+        assert_eq!(ring.underruns, 1);
+        assert_eq!(ring.played_sound, 3);
+        assert_eq!(ring.queued(), 0);
+        // Slot 6 plays, 7 may be about to start: the next chunk goes to 0.
+        assert_eq!(ring.reserve(), Some(0));
+    }
+
+    #[test]
+    fn wraps_around() {
+        let mut ring = Ring::new(4, 1);
+        for turn in 0..10u64 {
+            assert!(ring.reserve().is_some());
+            ring.advance(((turn + 1) % 4) as usize, |_| {});
+        }
+        assert_eq!(ring.current(), 10);
+    }
+}
