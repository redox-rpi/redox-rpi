index 00000000..39921d9a
--- /dev/null
+++ b/drivers/audio/bcm2835-hdmiaudiod/src/dt.rs
@@ -0,0 +1,152 @@
+//! Devicetree helpers: address translation through `/soc`'s `ranges` and
+//! `dma-ranges` with their real cell counts (the BCM2711 has one address
+//! cell below `/soc` and two above it), and `reg` entries by name.
+//!
+//! The cell functions are pure and tested on the build host.
+
+use fdt::node::FdtNode;
+use fdt::Fdt;
+
+/// The property as big-endian 32-bit cells.
+pub fn cells(node: &FdtNode, name: &str) -> Option<Vec<u32>> {
+    let prop = node.property(name)?;
+    Some(prop.value.chunks_exact(4).map(|c| u32::from_be_bytes([c[0], c[1], c[2], c[3]])).collect())
+}
+
+fn number(cells: &[u32]) -> u64 {
+    cells.iter().fold(0u64, |n, c| n << 32 | u64::from(*c))
+}
+
+fn cell_count(node: Option<FdtNode>, name: &str, default: usize) -> usize {
+    node.and_then(|n| n.property(name)).and_then(|p| p.as_usize()).unwrap_or(default)
+}
+
+/// `addr` (a child address) through `ranges`, given the child and parent
+/// address cells and the size cells. `None` if no entry covers it.
+pub fn translate(addr: u64, ranges: &[u32], child: usize, parent: usize, size: usize) -> Option<u64> {
+    let entry = child + parent + size;
+    if entry == 0 {
+        return None;
+    }
+    ranges.chunks_exact(entry).find_map(|e| {
+        let (c, p, s) = (number(&e[..child]), number(&e[child..child + parent]), number(&e[child + parent..]));
+        (c <= addr && addr - c < s).then(|| p + (addr - c))
+    })
+}
+
+/// The other way: a parent address back to the child side (`dma-ranges`:
+/// CPU physical address of RAM to the bus address a DMA controller uses).
+pub fn translate_back(addr: u64, ranges: &[u32], child: usize, parent: usize, size: usize) -> Option<u64> {
+    let entry = child + parent + size;
+    if entry == 0 {
+        return None;
+    }
+    ranges.chunks_exact(entry).find_map(|e| {
+        let (c, p, s) = (number(&e[..child]), number(&e[child..child + parent]), number(&e[child + parent..]));
+        (p <= addr && addr - p < s).then(|| c + (addr - p))
+    })
+}
+
+/// (child address cells, parent address cells, size cells) of `/soc`.
+fn soc_cells(fdt: &Fdt) -> (usize, usize, usize) {
+    let soc = fdt.find_node("/soc");
+    (
+        cell_count(soc, "#address-cells", 1),
+        cell_count(fdt.find_node("/"), "#address-cells", 1),
+        cell_count(soc, "#size-cells", 1),
+    )
+}
+
+/// The CPU physical address of a device at `bus_addr` below `/soc`; the bus
+/// address itself if `/soc` has no `ranges` that cover it.
+pub fn soc_phys(fdt: &Fdt, bus_addr: usize) -> usize {
+    let (child, parent, size) = soc_cells(fdt);
+    fdt.find_node("/soc")
+        .and_then(|soc| cells(&soc, "ranges"))
+        .and_then(|ranges| translate(bus_addr as u64, &ranges, child, parent, size))
+        .map(|phys| phys as usize)
+        .unwrap_or(bus_addr)
+}
+
+/// The bus address a `/soc` DMA controller uses for RAM at CPU address
+/// `phys`, through `/soc`'s `dma-ranges`; `None` without one that covers it.
+pub fn dma_bus(fdt: &Fdt, phys: usize) -> Option<usize> {
+    let (child, parent, size) = soc_cells(fdt);
+    let ranges = fdt.find_node("/soc").and_then(|soc| cells(&soc, "dma-ranges"))?;
+    translate_back(phys as u64, &ranges, child, parent, size).map(|bus| bus as usize)
+}
+
+/// The position of `name` in a `reg-names` string list.
+pub fn name_index(names: &[u8], name: &str) -> Option<usize> {
+    names.split(|b| *b == 0).filter(|s| !s.is_empty()).position(|s| s == name.as_bytes())
+}
+
+/// Bus address of the `reg` entry called `name` (by `reg-names`) of the
+/// first node with one of `compatible`.
+pub fn reg_by_name(fdt: &Fdt, compatible: &[&str], name: &str) -> Option<usize> {
+    let node = fdt.find_compatible(compatible)?;
+    let index = name_index(node.property("reg-names")?.value, name)?;
+    node.reg()?.nth(index).map(|reg| reg.starting_address as usize)
+}
+
+/// The DREQ line (bits 0..4) of a `dmas` specifier cell. The Raspberry Pi
+/// devicetrees put flags above it: the cell is 0x09000011 on the 3B+ and
+/// 0x41fa000a on the Pi 400.
+pub fn dreq_line(cell: u32) -> u32 {
+    cell & 0x1f
+}
+
+/// The DREQ line in the first `dmas` entry (`<&dma n>`) of the first node
+/// with one of `compatible`.
+pub fn dreq(fdt: &Fdt, compatible: &[&str]) -> Option<u32> {
+    let node = fdt.find_compatible(compatible)?;
+    cells(&node, "dmas")?.get(1).copied().map(dreq_line)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bcm2711_soc_ranges() {
+        // Pi 4 / Pi 400: <0x7e000000  0x0 0xfe000000  0x01800000>, ...
+        let ranges = [0x7e00_0000, 0x0, 0xfe00_0000, 0x0180_0000, 0x7c00_0000, 0x0, 0xfc00_0000, 0x0200_0000];
+        assert_eq!(translate(0x7ef0_0700, &ranges, 1, 2, 1), Some(0xfef0_0700));
+        assert_eq!(translate(0x7ef2_0000, &ranges, 1, 2, 1), Some(0xfef2_0000));
+        assert_eq!(translate(0x7c00_0010, &ranges, 1, 2, 1), Some(0xfc00_0010));
+        assert_eq!(translate(0x4000_0000, &ranges, 1, 2, 1), None);
+    }
+
+    #[test]
+    fn bcm2837_soc_ranges() {
+        let ranges = [0x7e00_0000, 0x3f00_0000, 0x0100_0000, 0x4000_0000, 0x4000_0000, 0x1000];
+        assert_eq!(translate(0x7e90_2000, &ranges, 1, 1, 1), Some(0x3f90_2000));
+    }
+
+    #[test]
+    fn dma_ranges_back() {
+        // BCM2711: <0xc0000000  0x0 0x00000000  0x40000000>.
+        let ranges = [0xc000_0000, 0x0, 0x0, 0x4000_0000];
+        assert_eq!(translate_back(0x3b40_0000, &ranges, 1, 2, 1), Some(0xfb40_0000));
+        assert_eq!(translate_back(0x4000_0000, &ranges, 1, 2, 1), None, "above 1 GB");
+        // BCM2837: <0xc0000000 0x00000000 0x3f000000>.
+        assert_eq!(translate_back(0x1000, &[0xc000_0000, 0, 0x3f00_0000], 1, 1, 1), Some(0xc000_1000));
+    }
+
+    #[test]
+    fn dreq_flags_masked() {
+        // Seen in Test 500 (3B+) and Test 498 (Pi 400).
+        assert_eq!(dreq_line(0x0900_0011), 17);
+        assert_eq!(dreq_line(0x41fa_000a), 10);
+        assert_eq!(dreq_line(17), 17);
+    }
+
+    #[test]
+    fn reg_names() {
+        let names = b"hdmi\0dvp\0phy\0rm\0packet\0metadata\0csc\0cec\0hd\0";
+        assert_eq!(name_index(names, "hdmi"), Some(0));
+        assert_eq!(name_index(names, "packet"), Some(4));
+        assert_eq!(name_index(names, "hd"), Some(8));
+        assert_eq!(name_index(names, "audio"), None);
+    }
+}
