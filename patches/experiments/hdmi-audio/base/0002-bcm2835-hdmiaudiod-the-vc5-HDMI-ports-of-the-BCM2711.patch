+/// BCM2711: the first port the firmware sends video on. Its devicetree
+/// nodes are `disabled` (no KMS), but their `reg` entries are there.
+fn open_vc5(fdt: &Fdt) -> (Output, Option<Setup>) {
+    if !dvp_answers() {
+        return (clock_only("the BCM2711 DVP block does not answer (QEMU raspi4b has no HDMI)".to_string()), None);
+    }
+    let (sw_init, misc_config) = read_dvp(fdt);
+    let mut skipped = Vec::new();
+    for port in &VC5_PORTS {
+        let name = port.regs.name;
+        if !hdmi::vc5_port_clocked(port.index, sw_init, misc_config) {
+            // Reading it could hang the bus.
+            skipped.push(format!("{name} in reset or unclocked"));
+            continue;
+        }
+        let compatible = [port.compatible];
+        let addr = |i: usize, reg: &str| dt::reg_by_name(fdt, &compatible, reg).unwrap_or(port.fallback[i]);
+        let [core_bus, phy_bus, rm_bus, packet_bus, hd_bus] =
+            [(0, "hdmi"), (1, "phy"), (2, "rm"), (3, "packet"), (4, "hd")].map(|(i, reg)| addr(i, reg));
+        let core_phys = soc_phys(fdt, core_bus);
