+            skipped.push(format!("{name} sends no video"));
+            continue;
+        }
+        let phy = map(soc_phys(fdt, phy_bus));
+        let rm = map(soc_phys(fdt, rm_bus));
+        let read = |base: *mut u32, offset: usize| unsafe { base.add(offset / 4).read_volatile() };
+        let (rm_offset, clk_div) = (read(rm, hdmi::RM_OFFSET), read(phy, hdmi::PHY_CLK_DIV));
