+/// The register offsets of one HDMI port, and what else differs between the
+/// VC4 (BCM2835/2837) and the vc5 ports (BCM2711).
+pub struct Regs {
+    pub name: &'static str,
+    // HD block.
+    pub mai_ctl: usize,
+    pub mai_thr: usize,
+    pub mai_fmt: usize,
+    /// The FIFO: the DMA target.
+    pub mai_data: usize,
+    pub mai_smp: usize,
+    /// `VID_CTL`, whose bit 31 says the port sends video (vc5 only; the VC4
+    /// driver goes by hotplug and the scheduler).
+    pub vid_ctl: Option<usize>,
+    // HDMI core.
+    pub hotplug: usize,
+    pub mai_channel_map: usize,
+    pub mai_config: usize,
+    pub audio_packet_config: usize,
+    pub ram_packet_config: usize,
+    pub ram_packet_status: usize,
+    pub crp_cfg: usize,
+    pub cts_0: usize,
+    pub cts_1: usize,
+    pub scheduler_control: usize,
+    /// Packet RAM, from the core on VC4 and from the "packet" block on vc5.
+    pub ram_packet_start: usize,
+    /// Bits per channel in `MAI_CHANNEL_MAP`.
+    pub channel_bits: u32,
+    pub mai_thr_value: u32,
+    /// The DREQ line of the FIFO, if the devicetree has no `dmas`.
+    pub dreq: u32,
+}
+
+/// BCM2835/2837.
