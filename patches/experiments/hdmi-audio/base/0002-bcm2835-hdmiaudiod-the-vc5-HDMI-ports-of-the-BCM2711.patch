+        let powerdown = read(phy, hdmi::PHY_POWERDOWN_CTL);
+        unsafe {
+            phy.add(hdmi::PHY_POWERDOWN_CTL / 4).write_volatile(powerdown & !hdmi::PHY_POWERDOWN_RNDGEN);
+        }
+        let clock_regs = format!(
+            "dvp sw_init=0x{sw_init:08x} misc_config=0x{misc_config:08x}\nphy rm_offset=0x{rm_offset:08x} clk_div=0x{clk_div:08x} powerdown=0x{powerdown:08x}->0x{:08x}\n",
+            read(phy, hdmi::PHY_POWERDOWN_CTL)
+        );
