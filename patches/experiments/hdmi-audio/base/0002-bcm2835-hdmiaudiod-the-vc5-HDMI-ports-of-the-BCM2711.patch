+    name: "vc4",
+    mai_ctl: 0x14,
+    mai_thr: 0x18,
+    mai_fmt: 0x1c,
+    mai_data: 0x20,
+    mai_smp: 0x2c,
+    vid_ctl: None,
+    hotplug: 0x0c,
+    mai_channel_map: 0x90,
+    mai_config: 0x94,
+    audio_packet_config: 0x9c,
+    ram_packet_config: 0xa0,
+    ram_packet_status: 0xa4,
+    crp_cfg: 0xa8,
+    cts_0: 0xac,
+    cts_1: 0xb0,
+    scheduler_control: 0xc0,
+    ram_packet_start: 0x400,
+    channel_bits: 3,
+    mai_thr_value: MAI_THR_VC4,
