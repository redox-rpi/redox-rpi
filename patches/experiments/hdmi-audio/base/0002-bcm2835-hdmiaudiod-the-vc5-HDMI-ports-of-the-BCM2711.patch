+/// `SW_INIT` and `MISC_CONFIG` of the BCM2711 DVP block.
+fn read_dvp(fdt: &Fdt) -> (u32, u32) {
+    let dvp = map(soc_phys(fdt, bus_addr(fdt, &["brcm,brcm2711-dvp"], 0, DVP_BUS_ADDR)));
+    let dvp_reg = |offset: usize| unsafe { dvp.add(offset / 4).read_volatile() };
+    (dvp_reg(hdmi::DVP_SW_INIT), dvp_reg(hdmi::DVP_MISC_CONFIG))
+}
