+        // The firmware reports no pixel clock on the Pi 400 (Test 494); the PHY
+        // PLL is what runs.
+        let (pixel_hz, pixel_source) = match phy_hz {
+            Some(hz) => (hz, "phy"),
+            None => pixel_clock_or(None, "phy", &clock_regs),
+        };
+        let dreq = dt::dreq(fdt, &compatible).unwrap_or(port.regs.dreq);
+        if !skipped.is_empty() {
+            println!("bcm2835-hdmiaudiod: {}", skipped.join(", "));
+        }
+        return start(fdt, hdmi, core_phys, hd_bus, dreq, pixel_hz, pixel_source, hdmi::VC5_AUDIO_HZ, HsmSource::Dvp, clock_regs);
+    }
+    (clock_only(format!("no BCM2711 HDMI port sends video ({}; QEMU, or no display at boot?)", skipped.join(", "))), None)
+}
