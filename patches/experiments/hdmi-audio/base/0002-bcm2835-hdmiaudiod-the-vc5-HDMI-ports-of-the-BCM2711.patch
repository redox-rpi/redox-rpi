+const VC5_PORTS: [Vc5Port; 2] = [
+    Vc5Port {
+        index: 0,
+        regs: &hdmi::VC5_HDMI0,
+        compatible: "brcm,bcm2711-hdmi0",
+        fallback: [0x7ef0_0700, 0x7ef0_0f00, 0x7ef0_0f80, 0x7ef0_1b00, 0x7ef2_0000],
+    },
+    Vc5Port {
+        index: 1,
+        regs: &hdmi::VC5_HDMI1,
+        compatible: "brcm,bcm2711-hdmi1",
