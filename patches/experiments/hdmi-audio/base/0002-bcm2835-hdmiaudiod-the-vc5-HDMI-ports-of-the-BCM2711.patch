+/// Whether reading the DVP block works. QEMU's raspi4b answers it with a
+/// synchronous external abort, which ends the process, and no devicetree
+/// property tells it from a Pi: so a child process (this program with
+/// `PROBE_ARG`) reads it first.
+const PROBE_ARG: &str = "--probe-dvp";
+
+fn dvp_answers() -> bool {
+    let program = std::env::args().next().unwrap_or_else(|| "bcm2835-hdmiaudiod".to_string());
+    match std::process::Command::new(&program)
+        .arg(PROBE_ARG)
+        // Inherited: /dev/null does not exist in the initfs (ENODEV).
+        .status()
+    {
+        Ok(status) => status.success(),
+        Err(err) => {
+            // A Pi answers it (Test 494); without the probe, read it here.
+            eprintln!("bcm2835-hdmiaudiod: cannot start the DVP probe ({err}); reading it directly");
+            true
+        }
+    }
+}
+
+/// The child side of `dvp_answers`.
+fn probe_dvp() -> ! {
+    common::init();
+    let dtb = std::fs::read("/scheme/kernel.dtb").unwrap_or_default();
+    let Ok(fdt) = Fdt::new(&dtb) else {
+        process::exit(1);
+    };
+    let (sw_init, misc_config) = read_dvp(&fdt);
+    println!("dvp sw_init=0x{sw_init:08x} misc_config=0x{misc_config:08x}");
+    process::exit(0);
+}
