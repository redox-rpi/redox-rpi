 /// Bytes of packet RAM per packet (9 words).
 pub const PACKET_STRIDE: usize = 0x24;
 
+/// `VID_CTL`: the port sends video.
+pub const VID_CTL_ENABLE: u32 = 1 << 31;
+
+// vc5 PHY block (`TX_PHY_*`) and its rate manager (`RM_*`).
+pub const PHY_POWERDOWN_CTL: usize = 0x04;
+pub const PHY_CLK_DIV: usize = 0x28;
+pub const RM_OFFSET: usize = 0x18;
+/// The PHY's random generator; Linux powers it up before audio
+/// (`vc5_hdmi_phy_rng_enable`).
+pub const PHY_POWERDOWN_RNDGEN: u32 = 1 << 4;
+
+/// The BCM2711 DVP block (bus 0x7ef00000, Linux `clk-bcm2711-dvp.c`): one
+/// reset bit per port in `SW_INIT`, one stopped-clock bit per port (bit 3 +
+/// port) in `MISC_CONFIG`. A port in reset or without its clock must not be
+/// touched: its registers can hang the bus.
+pub const DVP_SW_INIT: usize = 0x04;
+pub const DVP_MISC_CONFIG: usize = 0x08;
+
+pub fn vc5_port_clocked(port: usize, sw_init: u32, misc_config: u32) -> bool {
+    sw_init & 1 << port == 0 && misc_config & 1 << (3 + port) == 0
+}
+
+/// The vc5 audio clock: the DVP gate on the fixed 108 MHz.
+pub const VC5_AUDIO_HZ: u64 = 108_000_000;
+const VC5_PHY_REF_HZ: u64 = 54_000_000;
+
+/// The pixel clock of a vc5 port from its PHY PLL: `RM_OFFSET` (bits 30:0)
+/// = VCO × 2^21 / 54 MHz, and `TX_PHY_CLK_DIV` bits 15:8 the VCO divider;
+/// TMDS = VCO / (divider × 10), the pixel clock at 8 bits per channel.
+pub fn pixel_from_vc5_phy(rm_offset: u32, clk_div: u32) -> Option<u64> {
+    let offset = u64::from(rm_offset & 0x7fff_ffff);
+    let div = u64::from(clk_div >> 8 & 0xff);
+    if offset == 0 || div == 0 {
+        return None;
+    }
+    Some(offset * VC5_PHY_REF_HZ / (1 << 21) / (div * 10))
+}
