 /// This function can only be called if no lock is held by the calling thread/task
 #[inline]
 pub fn check_no_locks(_: LockToken<'_, L0>) {}
+
+/// Debug (issue #207): report a lock wait that spins for more than 3 s,
+/// again every 10 s, with the lock address and the type it guards.
+#[cfg(target_arch = "aarch64")]
+#[cold]
+fn lock_stall(stall: &mut crate::arch::misc::StallWatch, lock: *const u8, what: &str) {
+    if stall.stalled() {
+        error!(
+            "lock wait stalled on CPU {}: lock {:p} ({})",
+            crate::cpu_id(),
+            lock,
+            what
+        );
+        *stall = crate::arch::misc::StallWatch::start(10);
+    }
+}
