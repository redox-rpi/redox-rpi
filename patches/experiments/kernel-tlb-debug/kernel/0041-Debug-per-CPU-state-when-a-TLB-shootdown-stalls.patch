From: chaos session <noreply@anthropic.com>
Subject: [PATCH] Debug: per-CPU state when a TLB shootdown stalls, where a fault lacks a grant (issue #207)

---
diff --git a/src/context/memory.rs b/src/context/memory.rs
index 74ef9e74..52939cbd 100644
--- a/src/context/memory.rs
+++ b/src/context/memory.rs
@@ -2589,7 +2589,13 @@ fn correct_inner<'l>(
     let mut flusher = Flusher::with_cpu_set(&addr_space_lock.used_by, &addr_space_lock.tlb_ack);
 
     let Some((grant_base, grant_info)) = addr_space.grants.contains(faulting_page) else {
-        debug!("Lacks grant");
+        // Debug (issue #207): where, and from which CPU.
+        debug!(
+            "Lacks grant: page {:#x}, {:?}, CPU {}",
+            faulting_page.start_address().data(),
+            access,
+            crate::cpu_id()
+        );
         return Err(PfError::Segv);
     };
 
@@ -3052,6 +3058,27 @@ impl<'a, 'addrsp> Flusher<'a, 'addrsp> {
                     self.state.ackword.load(Ordering::SeqCst),
                     affected_cpu_count
                 );
+                // Debug (issue #207): what every CPU did with its shootdown.
+                // A CPU with `wants` still set never took the IPI; one with
+                // `wants` clear whose last ack is not our ack word
+                // acknowledged on another address space.
+                error!(
+                    "  waiting ack word {:#x}",
+                    self.state.ackword as *const _ as usize
+                );
+                for block in crate::percpu::all_percpu_blocks() {
+                    error!(
+                        "  CPU {}: in set {}, wants {}, handled {}, last ack {:#x}, in syscall {}",
+                        block.cpu_id,
+                        self.active_cpus.contains(block.cpu_id),
+                        block.wants_tlb_shootdown.load(Ordering::SeqCst),
+                        block.dbg_tlb_handled.load(Ordering::Relaxed),
+                        block.dbg_tlb_last_ack.load(Ordering::Relaxed),
+                        block.inside_syscall.get()
+                    );
+                }
+                // Report again in 5 s, to see whether anything moves.
+                stall_watch = crate::arch::misc::StallWatch::start(5);
             }
             core::hint::spin_loop();
         }
diff --git a/src/percpu.rs b/src/percpu.rs
index 558f9672..a6143bd5 100644
--- a/src/percpu.rs
+++ b/src/percpu.rs
@@ -38,6 +38,10 @@ pub struct PercpuBlock {
     pub new_addrsp_tmp: Cell<Option<Arc<AddrSpaceWrapper>>>,
     pub new_addrsp_guard: Cell<Option<AddrSpaceSwitchReadGuard>>,
     pub wants_tlb_shootdown: AtomicBool,
+    /// Debug (issue #207): TLB shootdowns this CPU handled, and the ack
+    /// word it last acknowledged on (0: none, 1: no address space).
+    pub dbg_tlb_handled: core::sync::atomic::AtomicU64,
+    pub dbg_tlb_last_ack: core::sync::atomic::AtomicUsize,
 
     // TODO: Put mailbox queues here, e.g. for TLB shootdown? Just be sure to 128-byte align it
     // first to avoid cache invalidation.
@@ -138,8 +142,13 @@ impl PercpuBlock {
         // TODO: Finer-grained flush
         crate::memory::RmmA::invalidate_all();
 
+        self.dbg_tlb_handled.fetch_add(1, Ordering::Relaxed);
         if let Some(addrsp) = &*self.current_addrsp.borrow() {
+            self.dbg_tlb_last_ack
+                .store(&addrsp.tlb_ack as *const _ as usize, Ordering::Relaxed);
             addrsp.tlb_ack.fetch_add(1, Ordering::Release);
+        } else {
+            self.dbg_tlb_last_ack.store(1, Ordering::Relaxed);
         }
     }
 }
@@ -224,6 +233,8 @@ impl PercpuBlock {
             new_addrsp_tmp: Cell::new(None),
             new_addrsp_guard: Cell::new(None),
             wants_tlb_shootdown: AtomicBool::new(false),
+            dbg_tlb_handled: core::sync::atomic::AtomicU64::new(0),
+            dbg_tlb_last_ack: core::sync::atomic::AtomicUsize::new(0),
             ptrace_flags: Cell::new(PtraceFlags::empty()),
             ptrace_session: RefCell::new(None),
             inside_syscall: Cell::new(false),
