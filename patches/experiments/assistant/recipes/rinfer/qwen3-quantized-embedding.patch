 use std::io::{Read, Seek};
 use std::sync::Arc;
 
+/// Token embedding that stays quantized: only the rows of the tokens in
+/// the input are dequantized. Dequantizing the whole table (151936 x 1024
+/// for Qwen3 0.6B) takes 622 MB as f32, more than a 1 GiB board can spare.
+#[derive(Clone)]
+struct QEmbedding {
+    weight: Arc<QTensor>,
+    hidden_size: usize,
+}
+
+impl std::fmt::Debug for QEmbedding {
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        write!(f, "QEmbedding({:?}, {})", self.weight.dtype(), self.hidden_size)
+    }
+}
+
+impl QEmbedding {
+    fn forward(&self, ids: &Tensor) -> Result<Tensor> {
+        let (b, l) = ids.dims2()?;
+        let dtype = self.weight.dtype();
+        let device = self.weight.device();
+        let row_bytes = self.hidden_size / dtype.block_size() * dtype.type_size();
+        let data = self.weight.data()?;
+        let mut rows = Vec::with_capacity(b * l);
+        for id in ids.flatten_all()?.to_vec1::<u32>()? {
+            let start = id as usize * row_bytes;
+            let raw = data
+                .get(start..start + row_bytes)
+                .ok_or_else(|| candle::Error::Msg(format!("token id {id} out of range")))?;
+            let row = candle::quantized::ggml_file::qtensor_from_ggml(
+                dtype,
+                raw,
+                vec![self.hidden_size],
+                &device,
+            )?;
+            rows.push(row.dequantize(&device)?);
+        }
+        Tensor::stack(&rows, 0)?.reshape((b, l, self.hidden_size))
+    }
+}
