+/// Element type of an interleaved key/value cache: f32, or bf16 for half the
+/// memory (bf16 to f32 is a shift, cheap on CPUs without fp16 support).
+pub trait KvElem: WithDType {
+    const ZERO: Self;
+    /// Write `src` into `dst`, converting.
+    fn store(dst: &mut [Self], src: &[f32]);
+    /// `src` as f32: itself, or converted into `buf`.
+    fn row<'a>(src: &'a [Self], buf: &'a mut [f32]) -> &'a [f32];
+}
+
+impl KvElem for f32 {
+    const ZERO: Self = 0.0;
+    fn store(dst: &mut [Self], src: &[f32]) {
+        dst.copy_from_slice(src);
+    }
+    #[inline(always)]
+    fn row<'a>(src: &'a [Self], _buf: &'a mut [f32]) -> &'a [f32] {
+        src
+    }
+}
+
+impl KvElem for half::bf16 {
+    const ZERO: Self = half::bf16::ZERO;
+    fn store(dst: &mut [Self], src: &[f32]) {
+        dst.iter_mut().zip(src).for_each(|(d, s)| *d = half::bf16::from_f32(*s));
+    }
+    #[inline(always)]
+    fn row<'a>(src: &'a [Self], buf: &'a mut [f32]) -> &'a [f32] {
+        buf.iter_mut()
+            .zip(src)
+            .for_each(|(b, s)| *b = f32::from_bits((s.to_bits() as u32) << 16));
+        &buf[..src.len()]
+    }
+}
