+/// How long idle Redox workers yield before they sleep:
+/// `CANDLE_POOL_IDLE_MS`, default 100 ms.
+#[cfg(target_os = "redox")]
+fn redox_pool_idle() -> std::time::Duration {
+    let ms = std::env::var("CANDLE_POOL_IDLE_MS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(100);
+    std::time::Duration::from_millis(ms)
+}
