+// Without the dotprod extension (Cortex-A53, A72: Raspberry Pi 3 and 4) SDOT
+// is an illegal instruction. The fallback below gives the same result in
+// every lane (lane i = sum of the products of bytes 4i..4i+3), so callers
+// that rely on the lane layout stay correct: widening multiply to 16 bits,
+// pairwise add to 32 bits, pairwise add again.
+#[cfg(all(target_arch = "aarch64", not(target_feature = "dotprod")))]
+#[inline(always)]
+unsafe fn sdot_fallback(acc: int32x4_t, a: int8x16_t, b: int8x16_t) -> int32x4_t {
+    let lo = vmull_s8(vget_low_s8(a), vget_low_s8(b));
+    let hi = vmull_high_s8(a, b);
+    vaddq_s32(acc, vpaddq_s32(vpaddlq_s16(lo), vpaddlq_s16(hi)))
+}
+
+#[cfg(all(target_arch = "aarch64", not(target_feature = "dotprod")))]
+#[inline(always)]
+unsafe fn vdotq_s32(a: int8x16_t, b: int8x16_t) -> int32x4_t {
+    sdot_fallback(vdupq_n_s32(0), a, b)
+}
+
+#[cfg(all(target_arch = "aarch64", not(target_feature = "dotprod")))]
+#[inline(always)]
+unsafe fn vdotq_s32_pair(a0: int8x16_t, b0: int8x16_t, a1: int8x16_t, b1: int8x16_t) -> int32x4_t {
+    sdot_fallback(sdot_fallback(vdupq_n_s32(0), a0, b0), a1, b1)
+}
+
+#[cfg(all(target_arch = "aarch64", not(target_feature = "dotprod")))]
+#[inline(always)]
+unsafe fn sdot_acc(acc: int32x4_t, a: int8x16_t, b: int8x16_t) -> int32x4_t {
+    sdot_fallback(acc, a, b)
+}
