diff --git a/netstack/src/stats.rs b/netstack/src/stats.rs
new file mode 100644
index 0000000..158ac67
--- /dev/null
+++ b/netstack/src/stats.rs
@@ -0,0 +1,113 @@
+//! Counters for diagnosis (redox-rpi #566), read from
+//! `/scheme/netcfg/stats` (`netdiag`): one `name value` per line.
+//!
+//! They count where frames go between the network drivers and the sockets:
+//! frames read and written, frames dropped and why, ARP, the router's
+//! queues, and a summary of the TCP connections, refreshed by the main loop
+//! at most twice a second.
+
+use std::collections::BTreeMap;
+use std::fmt::Write;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+use smoltcp::iface::SocketSet;
+use smoltcp::socket::Socket;
+
+macro_rules! counters {
+    ($($name:ident: $doc:literal),* $(,)?) => {
+        $(#[doc = $doc] pub static $name: AtomicU64 = AtomicU64::new(0);)*
+        const ALL: &[(&str, &AtomicU64)] = &[$((stringify!($name), &$name)),*];
+    };
+}
+
+counters! {
+    FRAMES_IN: "Frames read from network drivers",
+    FRAMES_IN_IPV4: "Of them, IPv4 for this host, passed on",
+    FRAMES_IN_ARP: "Of them, ARP",
+    FRAMES_IN_NOT_OURS: "Of them, for another MAC address, dropped",
+    FRAMES_IN_MALFORMED: "Of them, not a valid Ethernet frame, dropped",
+    FRAMES_IN_OTHER: "Of them, another protocol (IPv6 ...), dropped",
+    READ_ERRORS: "Reads from a driver that failed (not counting would-block)",
+    FRAMES_OUT: "Frames written to network drivers",
+    WRITE_ERRORS: "Writes to a driver that failed, frame dropped",
+    ARP_REQUESTS: "ARP requests sent",
+    ARP_EXPIRED: "Neighbor entries found expired when sending",
+    ARP_QUEUE_FULL: "Packets dropped: the queue waiting for ARP was full",
+    ARP_UNRESOLVED: "Packets dropped: no ARP answer after 3 tries",
+    ROUTER_RX_FULL: "Times the router's receive queue was full (frames wait in the driver)",
+    ROUTER_TX_FULL: "Times smoltcp found the router's transmit queue full",
+    NO_ROUTE: "Packets dropped: no route",
+}
+
+pub fn inc(counter: &AtomicU64) {
+    counter.fetch_add(1, Relaxed);
+}
+
+/// TCP summary lines and when they were made.
+static TCP: Mutex<Option<(Instant, String)>> = Mutex::new(None);
+
+/// Refresh the socket summary if it is older than half a second: the
+/// number of sockets of each kind and of TCP sockets in each state (a
+/// socket that is never freed shows as a growing count, REQ-NET-4), and one
+/// line per TCP connection.
+pub fn refresh_tcp(sockets: &SocketSet) {
+    let Ok(mut tcp) = TCP.lock() else { return };
+    if tcp.as_ref().is_some_and(|(at, _)| at.elapsed() < Duration::from_millis(500)) {
+        return;
+    }
+    let mut lines = String::new();
+    let mut kinds: BTreeMap<&'static str, u64> = BTreeMap::new();
+    let mut states: BTreeMap<String, u64> = BTreeMap::new();
+    for (_, socket) in sockets.iter() {
+        let kind = match socket {
+            Socket::Tcp(_) => "tcp",
+            Socket::Udp(_) => "udp",
+            Socket::Icmp(_) => "icmp",
+            #[allow(unreachable_patterns)]
+            _ => "other",
+        };
+        *kinds.entry(kind).or_default() += 1;
+        let Socket::Tcp(socket) = socket else { continue };
+        let state = socket.state().to_string().to_ascii_lowercase().replace('-', "_");
+        *states.entry(state).or_default() += 1;
+        let (Some(local), Some(remote)) = (socket.local_endpoint(), socket.remote_endpoint()) else {
+            continue;
+        };
+        let _ = writeln!(
+            lines,
+            "tcp_{}_{}_{} {} rx_queue {}/{} tx_queue {}/{}",
+            local.port,
+            remote.addr,
+            remote.port,
+            socket.state(),
+            socket.recv_queue(),
+            socket.recv_capacity(),
+            socket.send_queue(),
+            socket.send_capacity()
+        );
+    }
+    let mut s = String::new();
+    for kind in ["tcp", "udp", "icmp", "other"] {
+        let _ = writeln!(s, "sockets_{kind} {}", kinds.get(kind).copied().unwrap_or(0));
+    }
+    for (state, n) in &states {
+        let _ = writeln!(s, "tcp_state_{state} {n}");
+    }
+    s.push_str(&lines);
+    *tcp = Some((Instant::now(), s));
+}
+
+pub fn text() -> String {
+    let mut s = String::new();
+    for (name, value) in ALL {
+        let _ = writeln!(s, "{} {}", name.to_ascii_lowercase(), value.load(Relaxed));
+    }
+    if let Ok(tcp) = TCP.lock() {
+        if let Some((_, lines)) = tcp.as_ref() {
+            s.push_str(lines);
+        }
+    }
+    s
+}
