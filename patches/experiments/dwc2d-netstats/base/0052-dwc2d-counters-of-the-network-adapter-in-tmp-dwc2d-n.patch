index 00000000..9508ff80
--- /dev/null
+++ b/drivers/usb/dwc2d/src/stats.rs
@@ -0,0 +1,100 @@
+//! Counters of the network adapter for diagnosis, written to
+//! `/tmp/dwc2d-netstats` every few seconds. They tell whether frames still
+//! arrive from the adapter when the network stops working.
+//!
+//! Error codes: the HCINT bits of a halted channel, or `0x10000` for a
+//! stall, `0x20000` for a timeout, `0x30000` for a short reply.
+
+use std::fmt::Write;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+use crate::dwc2::Error;
+
+pub static RX_FRAMES: AtomicU64 = AtomicU64::new(0);
+pub static RX_ERRORS: AtomicU64 = AtomicU64::new(0);
+static RX_LAST_ERROR: AtomicU64 = AtomicU64::new(0);
+static RX_LAST_MS: AtomicU64 = AtomicU64::new(0);
+pub static TX_FRAMES: AtomicU64 = AtomicU64::new(0);
+pub static TX_ERRORS: AtomicU64 = AtomicU64::new(0);
+static TX_LAST_ERROR: AtomicU64 = AtomicU64::new(0);
+static TX_LAST_MS: AtomicU64 = AtomicU64::new(0);
+pub static IRQS: AtomicU64 = AtomicU64::new(0);
+pub static TICKS: AtomicU64 = AtomicU64::new(0);
+
+static START: OnceLock<Instant> = OnceLock::new();
+
+/// Milliseconds since the counters started.
+fn now_ms() -> u64 {
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+
+fn code(err: &Error) -> u64 {
+    match err {
+        Error::Transfer(bits) => u64::from(*bits),
+        Error::Stall => 0x1_0000,
+        Error::Timeout(_) => 0x2_0000,
+        Error::Short(_) => 0x3_0000,
+    }
+}
+
+pub fn start() {
+    now_ms();
+}
+
+/// One transfer on the bulk IN endpoint ended, with frames or an error.
+pub fn rx(result: Result<u64, &Error>) {
+    match result {
+        Ok(frames) => {
+            RX_FRAMES.fetch_add(frames, Relaxed);
+            RX_LAST_MS.store(now_ms(), Relaxed);
+        }
+        Err(err) => {
+            RX_ERRORS.fetch_add(1, Relaxed);
+            RX_LAST_ERROR.store(code(err), Relaxed);
+        }
+    }
+}
+
+/// One frame went out on the bulk OUT endpoint, or failed.
+pub fn tx(result: Result<(), &Error>) {
+    match result {
+        Ok(()) => {
+            TX_FRAMES.fetch_add(1, Relaxed);
+            TX_LAST_MS.store(now_ms(), Relaxed);
+        }
+        Err(err) => {
+            TX_ERRORS.fetch_add(1, Relaxed);
+            TX_LAST_ERROR.store(code(err), Relaxed);
+        }
+    }
+}
+
+/// Write the counters, one `name value` per line. Errors are ignored: the
+/// file is only for diagnosis.
+pub fn write() {
+    let now = now_ms();
+    let mut s = String::new();
+    let _ = writeln!(s, "uptime_ms {now}");
+    for (name, value) in [
+        ("rx_frames", &RX_FRAMES),
+        ("rx_errors", &RX_ERRORS),
+        ("rx_last_error", &RX_LAST_ERROR),
+        ("rx_last_ms", &RX_LAST_MS),
+        ("tx_frames", &TX_FRAMES),
+        ("tx_errors", &TX_ERRORS),
+        ("tx_last_error", &TX_LAST_ERROR),
+        ("tx_last_ms", &TX_LAST_MS),
+        ("irqs", &IRQS),
+        ("ticks", &TICKS),
+    ] {
+        let value = value.load(Relaxed);
+        if name.ends_with("_error") {
+            let _ = writeln!(s, "{name} {value:#x}");
+        } else {
+            let _ = writeln!(s, "{name} {value}");
+        }
+    }
+    let _ = std::fs::write("/tmp/dwc2d-netstats", s);
+}
