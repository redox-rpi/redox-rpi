From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Fri, 6 Nov 2026 16:31:45 +0000
Subject: [PATCH] Build daemons and drivers with opt-level 3, fat LTO, one
 codegen unit, for the Cortex-A53 (redox-rpi opt-a53)

---
 Makefile | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 00c38a18..fada7eb3 100644
--- a/Makefile
+++ b/Makefile
@@ -73,14 +73,18 @@ $(SYSROOT)/bin/redoxfs:
 base:
 	@mkdir -pv "$(BUILD_DIR)"
 # Build daemons and drivers
-	CARGO_PROFILE_RELEASE_OPT_LEVEL=s CARGO_PROFILE_RELEASE_PANIC=abort \
+	CARGO_PROFILE_RELEASE_OPT_LEVEL=3 CARGO_PROFILE_RELEASE_PANIC=abort \
+	CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
+	CARGO_TARGET_AARCH64_UNKNOWN_REDOX_RUSTFLAGS="$$CARGO_TARGET_AARCH64_UNKNOWN_REDOX_RUSTFLAGS -Ctarget-cpu=cortex-a53" \
 		$(CARGO) build $(BUILD_FLAGS) \
 		--manifest-path "$(SRC_DIR)/Cargo.toml" \
 		$(BASE_CARGO_ARGS) $(DRIVERS_CARGO_ARGS)
 # Build initfs daemons and drivers
 # FIXME fix whatever issue (feature unification?) causes most logs to be omitted
 # if this is merged with the above build command.
-	CARGO_PROFILE_RELEASE_OPT_LEVEL=s CARGO_PROFILE_RELEASE_PANIC=abort \
+	CARGO_PROFILE_RELEASE_OPT_LEVEL=3 CARGO_PROFILE_RELEASE_PANIC=abort \
+	CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
+	CARGO_TARGET_AARCH64_UNKNOWN_REDOX_RUSTFLAGS="$$CARGO_TARGET_AARCH64_UNKNOWN_REDOX_RUSTFLAGS -Ctarget-cpu=cortex-a53" \
 		$(CARGO) build $(BUILD_FLAGS) \
 		--manifest-path "$(SRC_DIR)/Cargo.toml" \
 		$(INITFS_CARGO_ARGS) $(INITFS_DRIVERS_CARGO_ARGS)
