+/// Waits up to `timeout` for a reply of type `want` (or a NAK).
+fn receive(
+    socket: &UdpSocket,
+    tid: u32,
+    mac: &MacAddr,
+    want: u8,
+    timeout: Duration,
+    verbose: bool,
+) -> Result<Reply, String> {
+    let deadline = Instant::now() + timeout;
+    let mut buf = [0; 65536];
+    loop {
+        let left = deadline.saturating_duration_since(Instant::now());
+        if left.is_zero() {
+            return Err("timed out".into());
+        }
+        try_fmt!(socket.set_read_timeout(Some(left)), "failed to set read timeout");
+        let n = match socket.recv(&mut buf) {
+            Ok(n) => n,
+            Err(err) if matches!(err.kind(), ErrorKind::WouldBlock | ErrorKind::TimedOut) => {
+                return Err("timed out".into());
+            }
+            Err(err) => return Err(format!("failed to receive: {err}")),
+        };
+        match parse_reply(&buf[..n], tid, mac, verbose) {
+            Some(reply) if reply.msg_type == want => return Ok(reply),
+            Some(reply) if reply.msg_type == 6 => return Err("server sent NAK".into()),
+            Some(_) => (),
+            None => {
+                if verbose {
+                    println!("DHCP: ignored a reply for another request");
+                }
+            }
+        }
+    }
+}
 
