+fn ipv4(data: &[u8]) -> Option<[u8; 4]> {
+    (data.len() >= 4).then(|| [data[0], data[1], data[2], data[3]])
+}
+
+fn fmt_ip(ip: [u8; 4]) -> String {
+    format!("{}.{}.{}.{}", ip[0], ip[1], ip[2], ip[3])
+}
+
+/// Parses a reply to our request: right transaction and our MAC, else None.
+/// A reply for another interface, or another client, is not ours.
+fn parse_reply(data: &[u8], tid: u32, mac: &MacAddr, verbose: bool) -> Option<Reply> {
+    if data.len() < size_of::<Dhcp>() - 308 + 4 {
+        return None;
+    }
+    let mut buf = [0u8; size_of::<Dhcp>()];
+    let n = data.len().min(buf.len());
+    buf[..n].copy_from_slice(&data[..n]);
+    let dhcp = unsafe { std::ptr::read_unaligned(buf.as_ptr() as *const Dhcp) };
+    let (op, reply_tid, chaddr, yiaddr) = (dhcp.op, dhcp.tid, dhcp.chaddr, dhcp.yiaddr);
+    if op != 2 || reply_tid != tid || chaddr[..6] != mac.bytes {
+        return None;
+    }
+
+    let mut reply = Reply {
+        yiaddr,
+        ..Reply::default()
+    };
+    let options = dhcp.options;
+    let mut i = 0;
+    while i < options.len() {
+        let option = options[i];
+        match option {
+            0 => i += 1,
+            255 => break,
+            _ => {
+                let Some(&len) = options.get(i + 1) else { break };
+                let Some(data) = options.get(i + 2..i + 2 + len as usize) else {
+                    break;
+                };
+                i += 2 + len as usize;
+                if verbose {
+                    println!("DHCP: option {option}: {data:?}");
+                }
+                match option {
+                    1 if reply.subnet.is_none() => reply.subnet = ipv4(data),
+                    3 if reply.router.is_none() => reply.router = ipv4(data),
+                    6 if reply.dns.is_none() => reply.dns = ipv4(data),
+                    53 if !data.is_empty() => reply.msg_type = data[0],
+                    54 => reply.server_id = ipv4(data),
+                    _ => (),
+                }
+            }
+        }
+    }
+    Some(reply)
+}
 
