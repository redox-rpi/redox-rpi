+//! Network adapters: the `network.*` schemes the drivers register.
+//!
+//! netstack looks for them at start and again from time to time, so an
+//! adapter that comes up after boot (a Wi-Fi driver that joins a network,
+//! USB Ethernet plugged in later) gets its own interface. The `/scheme`
+//! directory is opened once before netstack enters the null namespace;
+//! later lookups go through that handle.
+
+use std::collections::BTreeSet;
+
+use libredox::flag::{O_DIRECTORY, O_NONBLOCK, O_RDONLY, O_RDWR};
+use libredox::Fd;
+use smoltcp::wire::EthernetAddress;
+use syscall::dirent::DirentIter;
+
+pub struct Adapter {
+    /// The driver's scheme, such as `network.usb_lan78xx`.
+    pub scheme: String,
+    /// The interface name: `eth0`, `eth1`, …, `wlan0` for `network.wlan*`.
+    pub name: String,
+    pub file: Fd,
+    pub mac: EthernetAddress,
+}
+
+pub struct Adapters {
+    root: Option<Fd>,
+    /// Schemes already in use, or that failed to open (logged once).
+    seen: BTreeSet<String>,
+    eth: usize,
+    wlan: usize,
+}
+
+impl Adapters {
+    pub fn new() -> Self {
+        let root = Fd::open("/scheme", O_DIRECTORY | O_RDONLY, 0)
+            .map_err(|e| warn!("cannot open /scheme ({e}); no adapters after start"))
+            .ok();
+        Adapters {
+            root,
+            seen: BTreeSet::new(),
+            eth: 0,
+            wlan: 0,
+        }
+    }
+
+    /// Opens the adapters that appeared since the last call. Wired ones
+    /// come first, so the first Ethernet adapter stays `eth0`.
+    pub fn scan(&mut self) -> Vec<Adapter> {
+        let mut new: Vec<String> = self
+            .list()
+            .into_iter()
+            .filter(|s| s.starts_with("network") && !self.seen.contains(s))
+            .collect();
+        new.sort_by_key(|s| (is_wlan(s), s.clone()));
+        let mut adapters = Vec::new();
+        for scheme in new {
+            self.seen.insert(scheme.clone());
+            match self.open(&scheme) {
+                Ok((file, mac)) => {
+                    let name = if is_wlan(&scheme) {
+                        self.wlan += 1;
+                        format!("wlan{}", self.wlan - 1)
+                    } else {
+                        self.eth += 1;
+                        format!("eth{}", self.eth - 1)
+                    };
+                    info!("adapter {scheme} as {name}, MAC {mac}");
+                    adapters.push(Adapter { scheme, name, file, mac });
+                }
+                Err(e) => warn!("cannot use adapter {scheme}: {e}"),
+            }
+        }
+        adapters
+    }
+
+    /// Names in `/scheme`.
+    fn list(&self) -> Vec<String> {
+        let Some(root) = &self.root else {
+            return Vec::new();
+        };
+        let mut names = Vec::new();
+        let mut buf = [0u8; 4096];
+        let mut opaque = 0;
+        loop {
+            let n = match libredox::call::getdents(root.raw(), &mut buf, opaque) {
+                Ok(0) => break,
+                Ok(n) => n,
+                Err(e) => {
+                    warn!("cannot list /scheme: {e}");
+                    break;
+                }
+            };
+            let mut last = None;
+            for entry in DirentIter::new(&buf[..n]) {
+                let Ok((header, name)) = entry else { break };
+                last = Some(header.next_opaque_id);
+                if let Ok(name) = std::str::from_utf8(name) {
+                    names.push(name.to_string());
+                }
+            }
+            match last {
+                Some(next) if next != opaque => opaque = next,
+                _ => break,
+            }
+        }
+        names
+    }
+
+    fn open(&self, scheme: &str) -> Result<(Fd, EthernetAddress), String> {
+        let open = |path: &str, flags: i32| -> Result<Fd, String> {
+            match &self.root {
+                Some(root) => root.openat(path, flags, 0),
+                None => Fd::open(&format!("/scheme/{path}"), flags, 0),
+            }
+            .map_err(|e| format!("open {path}: {e}"))
+        };
+        let file = open(scheme, O_RDWR | O_NONBLOCK)?;
+        let mac_file = open(&format!("{scheme}/mac"), O_RDONLY)?;
+        let mut mac = [0u8; 6];
+        let n = mac_file.read(&mut mac).map_err(|e| format!("read {scheme}/mac: {e}"))?;
+        if n != 6 {
+            return Err(format!("{scheme}/mac: {n} bytes"));
+        }
+        Ok((file, EthernetAddress::from_bytes(&mac)))
+    }
+}
+
+fn is_wlan(scheme: &str) -> bool {
+    scheme.starts_with("network.wlan")
+}
