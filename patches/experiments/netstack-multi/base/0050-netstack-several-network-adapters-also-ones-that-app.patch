+
+impl IfacesNode {
+    fn new_ref(
+        iface: Interface,
+        notifier: NotifierRef,
+        route_table: Rc<RefCell<RouteTable>>,
+        devices: Rc<RefCell<DeviceList>>,
+    ) -> CfgNodeRef {
+        Rc::new(RefCell::new(IfacesNode {
+            iface,
+            notifier,
+            route_table,
+            devices,
+        }))
+    }
+}
+
+impl CfgNode for IfacesNode {
+    fn is_dir(&self) -> bool {
+        true
+    }
+
+    fn read(&self) -> String {
+        let names: Vec<String> = self
+            .devices
+            .borrow()
+            .iter()
+            .map(|dev| dev.name().to_string())
+            .filter(|name| name != "loopback")
+            .collect();
+        names.join("\n")
+    }
+
+    fn open(&self, file: &str) -> Option<CfgNodeRef> {
+        let name = Rc::clone(self.devices.borrow().get(file)?.name());
+        if name.as_ref() == "loopback" {
+            return None;
         }
+        Some(mk_iface_node(
+            name,
+            Rc::clone(&self.iface),
+            Rc::clone(&self.notifier),
+            Rc::clone(&self.route_table),
+            Rc::clone(&self.devices),
+        ))
     }
 }
 
+/// smoltcp takes the first address as source for destinations outside all
+/// local subnets; make that the address of the default route's interface,
+/// so the source matches the interface the router sends from.
+fn prefer_default_source(iface: &Interface, route_table: &RouteTable) {
+    let Some(src) = route_table.lookup_src_addr(&IpAddress::v4(8, 8, 8, 8)) else {
+        return;
+    };
+    iface.borrow_mut().update_ip_addrs(|addrs| {
+        if let Some(pos) = addrs.iter().position(|cidr| cidr.address() == src) {
+            if pos != 0 {
+                let cidr = addrs.remove(pos);
+                let _ = addrs.insert(0, cidr);
+            }
+        }
+    });
+}
