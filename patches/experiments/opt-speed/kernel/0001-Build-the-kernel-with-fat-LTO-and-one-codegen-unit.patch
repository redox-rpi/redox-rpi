From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Sat, 7 Nov 2026 09:00:00 +0000
Subject: [PATCH] Build the kernel with fat LTO and one codegen unit (redox-rpi opt-speed)

---

diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -115,5 +115,6 @@ panic = "abort"
 [profile.release]
 # Avoids having to define the eh_personality lang item and reduces kernel size
 panic = "abort"
-#lto = true
+lto = "fat"
+codegen-units = 1
 debug = "full"
-- 
