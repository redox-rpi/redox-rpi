new file mode 100644
index 0000000..fa3e00c
--- /dev/null
+++ b/drivers/bcm2835-btuartd/src/uart.rs
@@ -0,0 +1,99 @@
+//! The mini UART of the BCM2835 and BCM2837 (BCM2835 ARM Peripherals,
+//! chapter 2): a 16550-like UART in the AUX block with 8-byte FIFOs. Its
+//! baud rate is derived from the core clock. Polled, no interrupts.
+
+use std::time::{Duration, Instant};
+
+/// Offsets from the start of the AUX block.
+const AUX_ENABLES: usize = 0x04;
+const MU_IO: usize = 0x40;
+const MU_IER: usize = 0x44;
+const MU_IIR: usize = 0x48;
+const MU_LCR: usize = 0x4c;
+const MU_MCR: usize = 0x50;
+const MU_LSR: usize = 0x54;
+const MU_CNTL: usize = 0x60;
+const MU_BAUD: usize = 0x68;
+
+const ENABLE_MINI_UART: u32 = 1 << 0;
+/// Both FIFOs cleared (bits 1 and 2), FIFOs on (bits 6 and 7).
+const IIR_CLEAR_FIFOS: u32 = 0xc6;
+/// 8 data bits. The datasheet says bit 0 alone, but both bits are needed.
+const LCR_8BIT: u32 = 0b11;
+const LSR_DATA_READY: u32 = 1 << 0;
+const LSR_RX_OVERRUN: u32 = 1 << 1;
+/// Despite its name: the transmit FIFO can take a byte.
+const LSR_TX_EMPTY: u32 = 1 << 5;
+const CNTL_RX: u32 = 1 << 0;
+const CNTL_TX: u32 = 1 << 1;
+/// RTS follows the receive FIFO, so the other side stops before it overflows.
+const CNTL_AUTO_RTS: u32 = 1 << 2;
+/// The transmitter waits while CTS is not asserted.
+const CNTL_AUTO_CTS: u32 = 1 << 3;
+/// Deassert RTS when only 4 places are left in the receive FIFO.
+const CNTL_RTS_AT_4: u32 = 0b11 << 4;
+
+pub struct MiniUart {
+    regs: *mut u32,
+}
+
+// The registers are only touched with single volatile accesses; the RX
+// thread reads, the scheme thread writes.
+unsafe impl Send for MiniUart {}
+unsafe impl Sync for MiniUart {}
+
+impl MiniUart {
+    /// `regs` points at the start of the AUX block. Turns the mini UART on:
+    /// 8N1, hardware flow control, FIFOs cleared.
+    pub fn new(regs: *mut u32) -> Self {
+        let uart = Self { regs };
+        uart.write(AUX_ENABLES, uart.read(AUX_ENABLES) | ENABLE_MINI_UART);
+        uart.write(MU_CNTL, 0);
+        uart.write(MU_IER, 0);
+        uart.write(MU_LCR, LCR_8BIT);
+        uart.write(MU_MCR, 0);
+        uart.write(MU_IIR, IIR_CLEAR_FIFOS);
+        uart.write(MU_CNTL, CNTL_RX | CNTL_TX | CNTL_AUTO_RTS | CNTL_AUTO_CTS | CNTL_RTS_AT_4);
+        uart
+    }
+
+    fn read(&self, offset: usize) -> u32 {
+        unsafe { self.regs.add(offset / 4).read_volatile() }
+    }
+
+    fn write(&self, offset: usize, value: u32) {
+        unsafe { self.regs.add(offset / 4).write_volatile(value) }
+    }
+
+    /// Sets the baud rate as close to `baud` as the divider allows, for a
+    /// core clock of `core_hz`; returns the rate it got.
+    pub fn set_baud(&self, core_hz: u32, baud: u32) -> u32 {
+        // baud = core / (8 * (divider + 1)), rounded to the nearest.
+        let divider = ((core_hz + 4 * baud) / (8 * baud.max(1))).clamp(1, 0x1_0000) - 1;
+        self.write(MU_BAUD, divider);
+        core_hz / (8 * (divider + 1))
+    }
+
+    /// The next received byte, if there is one; also whether bytes were lost
+    /// before it.
+    pub fn try_read(&self) -> Option<(u8, bool)> {
+        let lsr = self.read(MU_LSR);
+        (lsr & LSR_DATA_READY != 0).then(|| (self.read(MU_IO) as u8, lsr & LSR_RX_OVERRUN != 0))
+    }
+
+    /// Sends `data`; gives up when the transmitter does not take a byte
+    /// within `timeout` (CTS held off).
+    pub fn send(&self, data: &[u8], timeout: Duration) -> Result<(), ()> {
+        for &byte in data {
+            let deadline = Instant::now() + timeout;
+            while self.read(MU_LSR) & LSR_TX_EMPTY == 0 {
+                if Instant::now() > deadline {
+                    return Err(());
+                }
+                std::hint::spin_loop();
+            }
+            self.write(MU_IO, u32::from(byte));
+        }
+        Ok(())
+    }
+}
