 pub enum Flow {
     /// The hardware handles RTS and CTS, assert levels as reset (clear).
+    /// The Pi 3B+ chip never answers with these (Pi test #109 step 9).
     Auto,
-    /// The hardware handles RTS and CTS, both asserted when low.
+    /// The hardware handles RTS and CTS, both asserted when low, as UART
+    /// flow control normally is. The start setting.
     AutoLow,
     /// No flow control; RTS held low (the other side may send).
     None,
@@ -82,7 +84,7 @@ unsafe impl Sync for MiniUart {}
 
 impl MiniUart {
     /// `regs` points at the start of the AUX block. Turns the mini UART on:
-    /// 8N1, hardware flow control, FIFOs cleared.
+    /// 8N1, hardware flow control (asserted low), FIFOs cleared.
     pub fn new(regs: *mut u32) -> Self {
         let uart = Self { regs };
         uart.write(AUX_ENABLES, uart.read(AUX_ENABLES) | ENABLE_MINI_UART);
@@ -91,7 +93,7 @@ impl MiniUart {
         uart.write(MU_LCR, LCR_8BIT);
         uart.write(MU_MCR, 0);
         uart.write(MU_IIR, IIR_CLEAR_FIFOS);
-        uart.set_flow(Flow::Auto);
+        uart.set_flow(Flow::AutoLow);
