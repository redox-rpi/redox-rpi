From 17418324391d669e20ff7000fb38aae6c19070ca Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 30 Oct 2026 21:22:04 +0100
Subject: [PATCH] bcm2835-btuartd: lpo file, the 32 kHz sleep clock of the chip
 on GPIO 43

Reads GP2CTL and GP2DIV from the clock manager (mapped read only) and
shows whether the clock is enabled and running, its source, divider and
rate. Linux's devicetree for the 3B+ routes GPIO 43 to GPCLK2 for the
Bluetooth chip; without that clock the chip may not start.
---
 drivers/bcm2835-btuartd/src/main.rs | 54 +++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/drivers/bcm2835-btuartd/src/main.rs b/drivers/bcm2835-btuartd/src/main.rs
index ef0283a..c5eef12 100644
--- a/drivers/bcm2835-btuartd/src/main.rs
+++ b/drivers/bcm2835-btuartd/src/main.rs
@@ -15,6 +15,9 @@
 //!   control, RTS held asserted). For finding out what the chip needs.
 //! - `/scheme/btuart/status`: CTS line, RTS, FIFO levels and the raw
 //!   registers.
+//! - `/scheme/btuart/lpo`: the general-purpose clock 2 on GPIO 43, the
+//!   chip's 32 kHz sleep clock on the 3B+ (`gpclk2_gpio43` in Linux's
+//!   devicetree): enabled, running, source, divider and the rate it gives.
 //!
 //! The serial console keeps the PL011 (`dtoverlay=disable-bt`), so this is
 //! the split of Linux's `miniuart-bt` overlay. At start the driver sets
@@ -46,6 +49,11 @@ use uart::{Flow, MiniUart};
 
 /// Bus address of the AUX block, used if the devicetree has no mini UART.
 const AUX_BUS_ADDR: usize = 0x7e21_5000;
+/// Bus address of the clock manager page with the general-purpose clocks.
+const CM_BUS_ADDR: usize = 0x7e10_1000;
+/// GP2CTL and GP2DIV in that page.
+const CM_GP2CTL: usize = 0x80;
+const CM_GP2DIV: usize = 0x84;
 const PAGE_SIZE: usize = 4096;
 /// CTS, RTS, TX, RX and their pulls: the inputs pulled up, as in Linux.
 const PINS: &[(u32, &str)] = &[(30, "up"), (31, "none"), (32, "none"), (33, "up")];
@@ -93,7 +101,7 @@ fn check_sleep() -> bool {
     false
 }
 
-const FILES: &[&str] = &["baud", "clock", "data", "flow", "status"];
+const FILES: &[&str] = &["baud", "clock", "data", "flow", "lpo", "status"];
 
 #[derive(Clone, Copy)]
 enum Setting {
@@ -119,6 +127,8 @@ struct Received {
 
 struct BtUartScheme {
     uart: Arc<MiniUart>,
+    /// Address of the clock manager page, if it could be mapped.
+    cm: Option<usize>,
     received: Arc<Mutex<Received>>,
     core_hz: u32,
     baud: u32,
@@ -154,6 +164,31 @@ impl BtUartScheme {
         Ok(())
     }
 
+    /// GP2CTL and GP2DIV decoded (BCM2835 ARM Peripherals, 6.3).
+    fn lpo(&self) -> String {
+        let Some(cm) = self.cm else { return "unknown (clock manager not mapped)\n".to_string() };
+        let cm = cm as *const u32;
+        let (ctl, div) = unsafe { (cm.add(CM_GP2CTL / 4).read_volatile(), cm.add(CM_GP2DIV / 4).read_volatile()) };
+        let src = ctl & 0xf;
+        let src_hz: Option<u64> = match src {
+            1 => Some(19_200_000),
+            4 => Some(1_000_000_000),
+            5 => Some(1_000_000_000),
+            6 => Some(500_000_000),
+            _ => None,
+        };
+        let (divi, divf) = (div >> 12 & 0xfff, div & 0xfff);
+        let rate = src_hz
+            .filter(|_| divi > 0)
+            .map(|hz| (hz * 4096 / (u64::from(divi) * 4096 + u64::from(divf))).to_string())
+            .unwrap_or_else(|| "?".to_string());
+        format!(
+            "enabled {}\nbusy {}\nsource {src}\ndivi {divi}\ndivf {divf}\nrate_hz {rate}\nctl 0x{ctl:08x}\ndiv 0x{div:08x}\n",
+            ctl >> 4 & 1,
+            ctl >> 7 & 1,
+        )
+    }
+
     fn receive(&self, buf: &mut [u8]) -> Result<usize> {
         // Polls with yields: neither a timed Condvar wait nor a sleep came
         // back in this (the scheme's) thread on Redox; the RX thread can
@@ -201,6 +236,8 @@ impl SchemeSync for BtUartScheme {
             "data" => Handle::Data,
             "status" if write => return Err(Error::new(EROFS)),
             "status" => Handle::File(self.uart.status().into_bytes()),
+            "lpo" if write => return Err(Error::new(EROFS)),
+            "lpo" => Handle::File(self.lpo().into_bytes()),
             name @ ("baud" | "clock" | "flow") => {
                 let setting = match name {
                     "baud" => Setting::Baud,
@@ -351,13 +388,19 @@ fn receive_loop(uart: Arc<MiniUart>, received: Arc<Mutex<Received>>) -> ! {
 /// The CPU physical address of the AUX block, from the devicetree's mini
 /// UART node (`reg` is its registers at AUX + 0x40).
 fn aux_phys(fdt: &Fdt) -> usize {
-    let bus_addr = fdt
+    let bus_addr: usize = fdt
         .all_nodes()
         .filter(|node| node.compatible().is_some_and(|c| c.all().any(|c| c == "brcm,bcm2835-aux-uart")))
         .filter_map(|node| node.reg()?.next())
         .map(|reg| reg.starting_address as usize & !(PAGE_SIZE - 1))
         .next()
         .unwrap_or(AUX_BUS_ADDR);
+    bus_to_phys(fdt, bus_addr)
+}
+
+/// The CPU physical address of a peripheral bus address, through `/soc`
+/// `ranges`.
+fn bus_to_phys(fdt: &Fdt, bus_addr: usize) -> usize {
     fdt.find_node("/soc")
         .and_then(|soc| soc.ranges())
         .and_then(|mut ranges| {
@@ -400,6 +443,12 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
         common::physmap(phys, PAGE_SIZE, common::Prot::RW, common::MemoryType::DeviceMemory)
             .expect("bcm2835-btuartd: failed to map registers")
     } as *mut u32;
+    // Read only; the clock itself is the firmware's.
+    let cm = unsafe {
+        common::physmap(bus_to_phys(&fdt, CM_BUS_ADDR), PAGE_SIZE, common::Prot::RO, common::MemoryType::DeviceMemory)
+    }
+    .ok()
+    .map(|ptr| ptr as usize);
     route_pins();
     let core_hz = core_clock().unwrap_or(DEFAULT_CORE_HZ);
     let uart = Arc::new(MiniUart::new(regs));
@@ -414,6 +463,7 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
 
     let mut scheme = BtUartScheme {
         uart,
+        cm,
         received,
         core_hz,
         baud,
