From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 30 Oct 2026 22:07:20 +0100
Subject: [PATCH 78/81] rpi-firmwared: bt_power switches BT_ON as an output
 (SET_GPIO_CONFIG), bt_power_config; wifi_power for WL_ON

---
 drivers/rpi-firmwared/src/main.rs | 62 ++++++++++++++++++++++++-------
 drivers/rpi-firmwared/src/mbox.rs |  2 +
 2 files changed, 50 insertions(+), 14 deletions(-)

diff --git a/drivers/rpi-firmwared/src/main.rs b/drivers/rpi-firmwared/src/main.rs
index 165902e..1754d00 100644
--- a/drivers/rpi-firmwared/src/main.rs
+++ b/drivers/rpi-firmwared/src/main.rs
@@ -23,9 +23,14 @@
 //!   `on` or `off`; writing sets it. It hangs on the firmware's GPIO
 //!   expander, so only the firmware can switch it. Other boards do not have
 //!   this file.
+//! - `/scheme/rpi-firmware/bt_power_config`: direction, polarity and
+//!   state of that line as the firmware reports them
 //! - `/scheme/rpi-firmware/bt_power`: the BT_ON line of the Pi 3B+
 //!   Bluetooth chip, `1` (on) or `0` (off); writing sets it. Also on the
 //!   GPIO expander; other boards do not have this file.
+//! - `/scheme/rpi-firmware/wifi_power`, `wifi_power_config`: the same for WL_ON,
+//!   the line that powers the Wi-Fi half of the chip (expander pin 1). Linux
+//!   switches it on at boot before Bluetooth starts.
 //!
 //! At start it sets the ARM clock to its maximum; then the governor
 //! (`governor.rs`) lets it follow the load. The firmware lowers it by itself
@@ -60,10 +65,11 @@ const MBOX_BUS_ADDR: usize = 0x7e00_b880;
 const PAGE_SIZE: usize = 4096;
 
 const FILES: &[&str] = &[
-    "arm_clock", "board", "bt_power", "clocks", "governor", "power_led", "temperature", "throttled",
+    "arm_clock", "board", "bt_power", "bt_power_config", "clocks", "governor", "power_led", "temperature", "throttled",
+    "wifi_power", "wifi_power_config",
 ];
 /// Files that can be written: settings.
-const WRITABLE: &[&str] = &["arm_clock", "bt_power", "governor", "power_led"];
+const WRITABLE: &[&str] = &["arm_clock", "bt_power", "governor", "power_led", "wifi_power"];
 
 const THROTTLE_POLL: Duration = Duration::from_secs(5);
 
@@ -105,14 +111,24 @@ impl FirmwareScheme {
                 // Active low: the LED is on when the pin is low.
                 writeln!(text, "{}", if state == 0 { "on" } else { "off" }).unwrap();
             }
-            "bt_power" => {
-                let gpio = bt_power_gpio(mbox).ok_or(Error::new(ENOENT))?;
+            "bt_power" | "wifi_power" => {
+                let gpio = expander_power_gpio(mbox, name).ok_or(Error::new(ENOENT))?;
                 let state = match mbox.property(TAG_GET_GPIO_STATE, &[gpio, 0], 2).map_err(log)?[..] {
                     [0, state] => state,
-                    _ => return Err(log(format!("Bluetooth power: firmware refused GPIO {gpio}"))),
+                    _ => return Err(log(format!("{name}: firmware refused GPIO {gpio}"))),
                 };
                 writeln!(text, "{state}").unwrap();
             }
+            "bt_power_config" | "wifi_power_config" => {
+                let gpio = expander_power_gpio(mbox, name).ok_or(Error::new(ENOENT))?;
+                let [direction, polarity, term_en, pull_up] = gpio_config(mbox, gpio)?;
+                let state = match mbox.property(TAG_GET_GPIO_STATE, &[gpio, 0], 2).map_err(log)?[..] {
+                    [0, state] => state.to_string(),
+                    _ => "?".to_string(),
+                };
+                let direction = if direction == 1 { "out" } else { "in" };
+                writeln!(text, "direction {direction}\npolarity {polarity}\nterm_en {term_en}\npull_up {pull_up}\nstate {state}").unwrap();
+            }
             "temperature" => {
                 let value = mbox.value_of(TAG_GET_TEMPERATURE, 0).map_err(log)?;
                 writeln!(text, "{value}").unwrap();
@@ -165,16 +181,22 @@ impl FirmwareScheme {
                 println!("rpi-firmwared: governor {value}");
                 Ok(())
             }
-            "bt_power" => {
-                let gpio = bt_power_gpio(mbox).ok_or(Error::new(ENOENT))?;
+            "bt_power" | "wifi_power" => {
+                let gpio = expander_power_gpio(mbox, name).ok_or(Error::new(ENOENT))?;
                 let state = match value {
                     "1" => 1,
                     "0" => 0,
                     _ => return Err(Error::new(EINVAL)),
                 };
-                match mbox.set_property(TAG_SET_GPIO_STATE, &[gpio, state]).map_err(log)?[..] {
+                // As Linux's raspberrypi-exp-gpio: make the pin an output with
+                // the state in one SET_GPIO_CONFIG, keeping the polarity the
+                // firmware reports. SET_GPIO_STATE alone left BT_ON reading 1
+                // with the chip silent (Pi tests #90, #109), as for a pin the
+                // firmware keeps as an input.
+                let polarity = gpio_config(mbox, gpio).map(|c| c[1]).unwrap_or(0);
+                match mbox.set_property(TAG_SET_GPIO_CONFIG, &[gpio, 1, polarity, 0, 0, state]).map_err(log)?[..] {
                     [] | [0, ..] => Ok(()),
-                    _ => Err(log(format!("Bluetooth power: firmware refused GPIO {gpio}"))),
+                    _ => Err(log(format!("{name}: firmware refused GPIO {gpio}"))),
                 }
             }
             "arm_clock" => {
@@ -293,15 +315,27 @@ fn power_led_gpio(mbox: &mut Mailbox) -> Option<u32> {
     (revision & (1 << 23) != 0 && (revision >> 4) & 0xff == 0x0d).then_some(130)
 }
 
-/// The firmware GPIO of BT_ON: pin 0 of the GPIO expander (128 + 0) on the
-/// Pi 3B+ (`shutdown-gpios` of the bluetooth node in Linux's devicetree).
-/// High powers the Bluetooth half of the chip.
-fn bt_power_gpio(mbox: &mut Mailbox) -> Option<u32> {
+/// GET_GPIO_CONFIG of a firmware GPIO: direction (1 = out), polarity,
+/// termination on, pull-up.
+fn gpio_config(mbox: &mut Mailbox, gpio: u32) -> Result<[u32; 4]> {
+    match mbox.property(TAG_GET_GPIO_CONFIG, &[gpio, 0, 0, 0, 0], 5).map_err(log)?[..] {
+        [0, direction, polarity, term_en, pull_up] => Ok([direction, polarity, term_en, pull_up]),
+        _ => Err(log(format!("GPIO {gpio}: firmware gave no configuration"))),
+    }
+}
+
+/// The firmware GPIO of BT_ON (`bt_*` files) or WL_ON (`wifi_*`) on the Pi
+/// 3B+, from Linux's devicetree: BT_ON is pin 0 of the GPIO expander
+/// (128 + 0, `shutdown-gpios` of the bluetooth node), WL_ON pin 1 (129,
+/// `reset-gpios` of `wifi_pwrseq`, active low). High powers that half of
+/// the chip.
+fn expander_power_gpio(mbox: &mut Mailbox, name: &str) -> Option<u32> {
     let [revision] = mbox.property(TAG_BOARD_REVISION, &[], 1).ok()?[..] else {
         return None;
     };
     // New-style code (bit 23), type 0x0d: Pi 3 Model B+.
-    (revision & (1 << 23) != 0 && (revision >> 4) & 0xff == 0x0d).then_some(128)
+    let pi3bp = revision & (1 << 23) != 0 && (revision >> 4) & 0xff == 0x0d;
+    pi3bp.then_some(if name.starts_with("wifi") { 129 } else { 128 })
 }
 
 /// Model and memory size from a new-style revision code (bit 23 set):
diff --git a/drivers/rpi-firmwared/src/mbox.rs b/drivers/rpi-firmwared/src/mbox.rs
index 39ad30e..479c054 100644
--- a/drivers/rpi-firmwared/src/mbox.rs
+++ b/drivers/rpi-firmwared/src/mbox.rs
@@ -46,6 +46,8 @@ pub const TAG_GET_MIN_CLOCK_RATE: u32 = 0x0003_0007;
 pub const TAG_SET_CLOCK_RATE: u32 = 0x0003_8002;
 pub const TAG_GET_GPIO_STATE: u32 = 0x0003_0041;
 pub const TAG_SET_GPIO_STATE: u32 = 0x0003_8041;
+pub const TAG_GET_GPIO_CONFIG: u32 = 0x0003_0043;
+pub const TAG_SET_GPIO_CONFIG: u32 = 0x0003_8043;
 
 /// Clock id of the ARM cores.
 pub const CLOCK_ARM: u32 = 3;
