From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 29 Oct 2026 18:49:29 +0100
Subject: [PATCH 75/81] bcm2835-btuartd: yield instead of sleeping while a read
 waits

A 1 ms sleep in the scheme thread never came back in QEMU (as in
bcm2835-gpiod), so reads on data hung; the sleep in the RX thread is
fine.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bcm2835-btuartd/src/main.rs | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/bcm2835-btuartd/src/main.rs b/drivers/bcm2835-btuartd/src/main.rs
index d4f8afe..588991b 100644
--- a/drivers/bcm2835-btuartd/src/main.rs
+++ b/drivers/bcm2835-btuartd/src/main.rs
@@ -141,8 +141,9 @@ impl BtUartScheme {
     }
 
     fn receive(&self, buf: &mut [u8]) -> Result<usize> {
-        // Polls instead of a timed Condvar wait, which did not come back
-        // on Redox.
+        // Polls with yields: neither a timed Condvar wait nor a sleep came
+        // back in this (the scheme's) thread on Redox; the RX thread can
+        // sleep.
         let deadline = Instant::now() + READ_WAIT;
         let mut received = loop {
             let received = self.received.lock().unwrap();
@@ -153,7 +154,7 @@ impl BtUartScheme {
             if Instant::now() > deadline {
                 return Ok(0);
             }
-            pause();
+            thread::yield_now();
         };
         let len = buf.len().min(received.bytes.len());
         for (slot, byte) in buf.iter_mut().zip(received.bytes.drain(..len)) {
