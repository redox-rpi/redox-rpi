From 6da156b89aed7335a4dae492ec60af5ae1c26547 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 29 Oct 2026 18:04:12 +0100
Subject: [PATCH 47/48] bcm2835-btuartd: poll instead of a timed Condvar wait,
 check that sleeping works

In QEMU the first read on data never came back. Reads now poll the
buffer until their deadline. The polling loops sleep 1 ms only if a
test sleep after setrens comes back, and yield otherwise.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bcm2835-btuartd/src/main.rs | 84 ++++++++++++++++++++++-------
 1 file changed, 65 insertions(+), 19 deletions(-)

diff --git a/drivers/bcm2835-btuartd/src/main.rs b/drivers/bcm2835-btuartd/src/main.rs
index 0a66e16..d5b016a 100644
--- a/drivers/bcm2835-btuartd/src/main.rs
+++ b/drivers/bcm2835-btuartd/src/main.rs
@@ -20,9 +20,10 @@
 
 use std::collections::VecDeque;
 use std::process;
-use std::sync::{Arc, Condvar, Mutex};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
 use std::thread;
-use std::time::Duration;
+use std::time::{Duration, Instant};
 
 use fdt::Fdt;
 use redox_scheme::scheme::SchemeSync;
@@ -52,6 +53,40 @@ const READ_WAIT: Duration = Duration::from_millis(100);
 const SEND_TIMEOUT: Duration = Duration::from_millis(500);
 const POLL: Duration = Duration::from_millis(1);
 
+/// Whether a short sleep comes back; if not, the polling loops yield.
+static SLEEP_WORKS: AtomicBool = AtomicBool::new(false);
+
+/// Waits a little between polls: sleeps for POLL, or only yields where
+/// sleeping does not work.
+fn pause() {
+    if SLEEP_WORKS.load(Ordering::Relaxed) {
+        thread::sleep(POLL);
+    } else {
+        thread::yield_now();
+    }
+}
+
+/// A short nanosleep once never came back in QEMU (bcm2835-gpiod), so
+/// check it in a thread before relying on it.
+fn check_sleep() -> bool {
+    let done = Arc::new(AtomicBool::new(false));
+    {
+        let done = done.clone();
+        thread::spawn(move || {
+            thread::sleep(POLL);
+            done.store(true, Ordering::Relaxed);
+        });
+    }
+    let deadline = Instant::now() + Duration::from_millis(200);
+    while Instant::now() < deadline {
+        if done.load(Ordering::Relaxed) {
+            return true;
+        }
+        thread::yield_now();
+    }
+    false
+}
+
 const FILES: &[&str] = &["baud", "clock", "data"];
 
 #[derive(Clone, Copy)]
@@ -77,7 +112,7 @@ struct Received {
 
 struct BtUartScheme {
     uart: Arc<MiniUart>,
-    received: Arc<(Mutex<Received>, Condvar)>,
+    received: Arc<Mutex<Received>>,
     core_hz: u32,
     baud: u32,
     handles: HandleMap<Handle>,
@@ -105,14 +140,20 @@ impl BtUartScheme {
     }
 
     fn receive(&self, buf: &mut [u8]) -> Result<usize> {
-        let (lock, arrived) = &*self.received;
-        let mut received = lock.lock().unwrap();
-        if received.bytes.is_empty() {
-            received = arrived.wait_timeout(received, READ_WAIT).unwrap().0;
-        }
-        if received.bytes.is_empty() {
-            return Err(Error::new(EAGAIN));
-        }
+        // Polls instead of a timed Condvar wait, which did not come back
+        // on Redox.
+        let deadline = Instant::now() + READ_WAIT;
+        let mut received = loop {
+            let received = self.received.lock().unwrap();
+            if !received.bytes.is_empty() {
+                break received;
+            }
+            drop(received);
+            if Instant::now() > deadline {
+                return Err(Error::new(EAGAIN));
+            }
+            pause();
+        };
         let len = buf.len().min(received.bytes.len());
         for (slot, byte) in buf.iter_mut().zip(received.bytes.drain(..len)) {
             *slot = byte;
@@ -257,14 +298,13 @@ impl SchemeSync for BtUartScheme {
     }
 }
 
-/// Moves received bytes into the buffer and wakes a waiting reader.
-fn receive_loop(uart: Arc<MiniUart>, received: Arc<(Mutex<Received>, Condvar)>) -> ! {
+/// Moves received bytes into the buffer.
+fn receive_loop(uart: Arc<MiniUart>, received: Arc<Mutex<Received>>) -> ! {
     let mut reported = 0;
     loop {
         let mut got = false;
         while let Some((byte, overrun)) = uart.try_read() {
-            let (lock, arrived) = &*received;
-            let mut buffer = lock.lock().unwrap();
+            let mut buffer = received.lock().unwrap();
             if overrun {
                 buffer.lost += 1;
             }
@@ -273,16 +313,15 @@ fn receive_loop(uart: Arc<MiniUart>, received: Arc<(Mutex<Received>, Condvar)>)
                 buffer.lost += 1;
             }
             buffer.bytes.push_back(byte);
-            arrived.notify_one();
             got = true;
         }
         if !got {
-            let lost = received.0.lock().unwrap().lost;
+            let lost = received.lock().unwrap().lost;
             if lost != reported {
                 eprintln!("bcm2835-btuartd: {lost} received bytes lost so far");
                 reported = lost;
             }
-            thread::sleep(POLL);
+            pause();
         }
     }
 }
@@ -345,7 +384,7 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
     let baud = uart.set_baud(core_hz, DEFAULT_BAUD);
     println!("bcm2835-btuartd: mini UART at 0x{phys:08x}, {baud} baud (core {} MHz)", core_hz / 1_000_000);
 
-    let received = Arc::new((Mutex::new(Received::default()), Condvar::new()));
+    let received = Arc::new(Mutex::new(Received::default()));
     {
         let (uart, received) = (uart.clone(), received.clone());
         thread::spawn(move || receive_loop(uart, received));
@@ -364,6 +403,13 @@ fn daemon(daemon: daemon::SchemeDaemon) -> ! {
 
     libredox::call::setrens(0, 0).expect("bcm2835-btuartd: failed to enter the null namespace");
 
+    // In the namespace the driver runs in from now on; until then the
+    // polling loops yield.
+    SLEEP_WORKS.store(check_sleep(), Ordering::Relaxed);
+    if !SLEEP_WORKS.load(Ordering::Relaxed) {
+        eprintln!("bcm2835-btuartd: a 1 ms sleep did not come back, polling with yields");
+    }
+
     handler
         .process_requests_blocking(scheme)
         .expect("bcm2835-btuartd: failed to process requests");
