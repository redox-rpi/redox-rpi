From: stephan-xyz <stephan@zehrer.xyz>
Subject: [PATCH] aarch64: heartbeat on the serial console from each CPU timer interrupt

Diagnostic for #14: every 10 s each CPU writes [hb <cpu> <n>] straight to
the PL011, without the COM1 lock.
---
diff -ruN a/src/arch/aarch64/device/generic_timer.rs b/src/arch/aarch64/device/generic_timer.rs
--- a/src/arch/aarch64/device/generic_timer.rs
+++ b/src/arch/aarch64/device/generic_timer.rs
@@ -1,3 +1,4 @@
+use core::sync::atomic::{AtomicU32, Ordering};
 use spin::Once;
 
 use super::{cpu::registers::control_regs, ic_for_chip, irqchip};
@@ -193,6 +194,54 @@
     write_ctrl(config, ctrl);
 }
 
+// Heartbeat (experiment pi-heartbeat, #14): every HEARTBEAT_TICKS timer
+// interrupts each CPU writes "[hb <cpu> <n>]" straight to the PL011, without
+// the console lock. If the machine stops, the last lines show which CPUs
+// still took timer interrupts.
+const HEARTBEAT_TICKS: u32 = 1000; // 10 s at 100 Hz
+static HEARTBEAT: [AtomicU32; 8] = [const { AtomicU32::new(0) }; 8];
+
+fn heartbeat(cpu: u32) {
+    let Some(counter) = HEARTBEAT.get(cpu as usize) else {
+        return;
+    };
+    let ticks = counter.fetch_add(1, Ordering::Relaxed) + 1;
+    if ticks % HEARTBEAT_TICKS != 0 {
+        return;
+    }
+    let mut buf = [0u8; 32];
+    let mut len = 0;
+    for &b in b"\r\n[hb " {
+        buf[len] = b;
+        len += 1;
+    }
+    buf[len] = b'0' + (cpu % 10) as u8;
+    len += 1;
+    buf[len] = b' ';
+    len += 1;
+    let mut digits = [0u8; 10];
+    let mut n = ticks / HEARTBEAT_TICKS;
+    let mut d = 0;
+    loop {
+        digits[d] = b'0' + (n % 10) as u8;
+        d += 1;
+        n /= 10;
+        if n == 0 {
+            break;
+        }
+    }
+    while d > 0 {
+        d -= 1;
+        buf[len] = digits[d];
+        len += 1;
+    }
+    for &b in b"]\r\n" {
+        buf[len] = b;
+        len += 1;
+    }
+    crate::devices::uart_pl011::raw_write(&buf[..len]);
+}
+
 pub(crate) fn handle(hwirq: u32, raw_iar: u32, token: &mut CleanLockToken) -> bool {
     let Some(config) = TIMER.get().filter(|config| config.hwirq == hwirq) else {
         return false;
@@ -215,6 +264,7 @@
     // switch to a context which may subsequently resume on another CPU.
     irqchip::end_root(raw_iar);
     program_current(config);
+    heartbeat(cpu_id.get());
 
     if cpu_id == crate::cpu_set::LogicalCpuId::BSP {
         timeout::trigger(token);
diff -ruN a/src/devices/uart_pl011.rs b/src/devices/uart_pl011.rs
--- a/src/devices/uart_pl011.rs
+++ b/src/devices/uart_pl011.rs
@@ -1,6 +1,9 @@
 #![allow(unused)]
 
-use core::ptr;
+use core::{
+    ptr,
+    sync::atomic::{AtomicUsize, Ordering},
+};
 
 use crate::{
     scheme::debug::{debug_input, debug_notify},
@@ -98,6 +101,24 @@
 // longer writes, such as a shell redrawing its line after each key.
 const RX_STASH_SIZE: usize = 1024;
 
+// Base address of the PL011, for raw_write(): a diagnostic writer that takes
+// no lock, so it still works when a CPU holds the COM1 lock.
+static RAW_BASE: AtomicUsize = AtomicUsize::new(0);
+
+/// Write bytes straight to the PL011 data register without the COM1 lock.
+/// Output may interleave with locked writes. For diagnostics only.
+pub fn raw_write(bytes: &[u8]) {
+    let base = RAW_BASE.load(Ordering::Relaxed);
+    if base == 0 {
+        return;
+    }
+    for &b in bytes {
+        // FR (0x18) bit 5: transmit FIFO full.
+        while unsafe { ptr::read_volatile((base + 0x18) as *const u32) } & (1 << 5) != 0 {}
+        unsafe { ptr::write_volatile(base as *mut u32, b as u32) };
+    }
+}
+
 pub struct SerialPort {
     base: usize,
     data_reg: u8,
@@ -156,6 +177,8 @@
     }
 
     pub fn init(&mut self, with_irq: bool) {
+        RAW_BASE.store(self.base, Ordering::Relaxed);
+
         //Disable UART first
         self.write_reg(self.ctrl_reg, 0x0);
 
