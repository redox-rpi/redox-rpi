From: stephan-xyz <stephan@zehrer.xyz>
Subject: [PATCH] aarch64: heartbeat on the serial console from each CPU timer interrupt

Diagnostic for #14: every 10 s each CPU writes [hb <cpu> <n> s.. w.. i..
p..] straight to the PL011, without the COM1 lock: schedule() calls, real
switches, idle results since the last beat, and pit_ticks.
---
diff -ruN a/src/arch/aarch64/device/generic_timer.rs b/src/arch/aarch64/device/generic_timer.rs
--- a/src/arch/aarch64/device/generic_timer.rs
+++ b/src/arch/aarch64/device/generic_timer.rs
@@ -1,3 +1,4 @@
+use core::sync::atomic::{AtomicU32, Ordering};
 use spin::Once;
 
 use super::{cpu::registers::control_regs, ic_for_chip, irqchip};
@@ -193,6 +194,77 @@
     write_ctrl(config, ctrl);
 }
 
+// Heartbeat (experiment pi-heartbeat, #14): every HEARTBEAT_TICKS timer
+// interrupts each CPU writes "[hb <cpu> <n> s<sched> w<switch> i<idle>
+// p<pit>]" straight to the PL011, without the console lock: schedule()
+// calls, real context switches and idle results since its last beat, and
+// its pit_ticks (timer ticks since the last schedule()). If the machine
+// stops, the last lines show which CPUs still took timer interrupts and
+// whether their scheduler still ran.
+const HEARTBEAT_TICKS: u32 = 1000; // 10 s at 100 Hz
+static HEARTBEAT: [AtomicU32; 8] = [const { AtomicU32::new(0) }; 8];
+static HB_LAST: [[AtomicU32; 3]; 8] = [const { [const { AtomicU32::new(0) }; 3] }; 8];
+
+fn push_bytes(buf: &mut [u8; 96], len: &mut usize, bytes: &[u8]) {
+    for &b in bytes {
+        if *len < buf.len() {
+            buf[*len] = b;
+            *len += 1;
+        }
+    }
+}
+
+fn push_num(buf: &mut [u8; 96], len: &mut usize, mut n: u32) {
+    let mut digits = [0u8; 10];
+    let mut d = 0;
+    loop {
+        digits[d] = b'0' + (n % 10) as u8;
+        d += 1;
+        n /= 10;
+        if n == 0 {
+            break;
+        }
+    }
+    while d > 0 {
+        d -= 1;
+        push_bytes(buf, len, &[digits[d]]);
+    }
+}
+
+fn heartbeat(cpu: u32) {
+    let idx = cpu as usize;
+    let (Some(counter), Some(last)) = (HEARTBEAT.get(idx), HB_LAST.get(idx)) else {
+        return;
+    };
+    let ticks = counter.fetch_add(1, Ordering::Relaxed) + 1;
+    if ticks % HEARTBEAT_TICKS != 0 {
+        return;
+    }
+    use crate::context::switch::{HB_IDLE, HB_SCHED, HB_SWITCH};
+    let now = [
+        HB_SCHED[idx].load(Ordering::Relaxed),
+        HB_SWITCH[idx].load(Ordering::Relaxed),
+        HB_IDLE[idx].load(Ordering::Relaxed),
+    ];
+    let pit = crate::context::switch::hb_pit_ticks();
+
+    let mut buf = [0u8; 96];
+    let mut len = 0;
+    push_bytes(&mut buf, &mut len, b"\r\n[hb ");
+    push_num(&mut buf, &mut len, cpu);
+    push_bytes(&mut buf, &mut len, b" ");
+    push_num(&mut buf, &mut len, ticks / HEARTBEAT_TICKS);
+    for (k, tag) in [b" s", b" w", b" i"].iter().enumerate() {
+        push_bytes(&mut buf, &mut len, *tag);
+        push_num(&mut buf, &mut len, now[k].wrapping_sub(last[k].load(Ordering::Relaxed)));
+        last[k].store(now[k], Ordering::Relaxed);
+    }
+    push_bytes(&mut buf, &mut len, b" p");
+    push_num(&mut buf, &mut len, pit as u32);
+    push_bytes(&mut buf, &mut len, b"]\r\n");
+    crate::devices::uart_pl011::raw_write(&buf[..len]);
+}
+
