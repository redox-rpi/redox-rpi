From: stephan-xyz <stephan@zehrer.xyz>
Subject: [PATCH] aarch64: heartbeat on the serial console from each CPU timer interrupt

Diagnostic for #14 and #157: every 60 s each CPU writes [hb <cpu> <n> ...]
straight to the PL011, without the COM1 lock, and reports a CPU that stops
taking timer interrupts or stops scheduling. CPU 0 dumps the context list
([hbctx ...] lines) at its second beat and when user space stops switching.
---
diff -ruN a/src/arch/aarch64/device/generic_timer.rs b/src/arch/aarch64/device/generic_timer.rs
--- a/src/arch/aarch64/device/generic_timer.rs	2026-10-31 22:36:40.922237049 +0000
+++ b/src/arch/aarch64/device/generic_timer.rs	2026-11-01 08:26:53.761782163 +0000
@@ -1,3 +1,4 @@
+use core::sync::atomic::{AtomicU32, Ordering};
 use spin::Once;
 
 use super::{cpu::registers::control_regs, ic_for_chip, irqchip};
@@ -193,6 +194,329 @@
     write_ctrl(config, ctrl);
 }
 
+// Heartbeat (experiment pi-heartbeat, #14, #157): every HEARTBEAT_TICKS
+// timer interrupts each CPU writes "[hb <cpu> <n> s<sched> w<switch>
+// i<idle> p<pit>]" straight to the PL011, without the console lock:
+// schedule() calls, real context switches and idle results since its last
+// beat, and its pit_ticks (timer ticks since the last schedule()).
+// Between beats each CPU watches the others: when another CPU took no
+// timer interrupt, or did not run schedule(), for STALL_TICKS, it writes
+// "[hb stall <cpu> ...]" or "[hb nosched <cpu> ...]" once.
+// CPU 0 also dumps the context list, one "[hbctx ...]" line per context,
+// once at its second beat (a baseline) and, at most DUMP_MAX times, when
+// all CPUs together made fewer than DUMP_SWITCHES context switches since its
+// last beat, or when a CPU made no switch since then while a user context
+// on that CPU is runnable (a runnable context the CPU never picks).
+const HEARTBEAT_TICKS: u32 = 6000; // 60 s at 100 Hz
+const STALL_TICKS: u32 = 200; // 2 s
+const DUMP_SWITCHES: u32 = 100;
+const DUMP_MAX: u32 = 3;
+static DUMP_LAST_SWITCHES: [AtomicU32; 8] = [const { AtomicU32::new(0) }; 8];
+static DUMPS: AtomicU32 = AtomicU32::new(0);
+static HEARTBEAT: [AtomicU32; 8] = [const { AtomicU32::new(0) }; 8];
+static HB_LAST: [[AtomicU32; 3]; 8] = [const { [const { AtomicU32::new(0) }; 3] }; 8];
+// Per watching CPU and watched CPU: last seen tick and schedule() counts,
+// own ticks when they last changed, and whether a stall was reported.
+static WATCH_SEEN: [[[AtomicU32; 4]; 8]; 8] =
+    [const { [const { [const { AtomicU32::new(0) }; 4] }; 8] }; 8];
+
+fn push_bytes(buf: &mut [u8; 96], len: &mut usize, bytes: &[u8]) {
+    for &b in bytes {
+        if *len < buf.len() {
+            buf[*len] = b;
+            *len += 1;
+        }
+    }
+}
+
+fn push_num(buf: &mut [u8; 96], len: &mut usize, mut n: u32) {
+    let mut digits = [0u8; 10];
+    let mut d = 0;
+    loop {
+        digits[d] = b'0' + (n % 10) as u8;
+        d += 1;
+        n /= 10;
+        if n == 0 {
+            break;
+        }
+    }
+    while d > 0 {
+        d -= 1;
+        push_bytes(buf, len, &[digits[d]]);
+    }
+}
+
+fn watch_others(idx: usize, my_ticks: u32) {
+    use crate::context::switch::HB_SCHED;
+    let cpus = crate::CPU_COUNT.load(Ordering::Relaxed) as usize;
+    for other in 0..cpus.min(8) {
+        if other == idx {
+            continue;
+        }
+        let seen = &WATCH_SEEN[idx][other];
+        let t = HEARTBEAT[other].load(Ordering::Relaxed);
+        let sc = HB_SCHED[other].load(Ordering::Relaxed);
+        if t == 0 {
+            // not started yet
+            continue;
+        }
+        // seen: [0] ticks, [1] schedule() count, [2] own ticks at the last
+        // change of [0], [3] own ticks at the last change of [1]
+        if t != seen[0].load(Ordering::Relaxed) {
+            seen[0].store(t, Ordering::Relaxed);
+            seen[2].store(my_ticks, Ordering::Relaxed);
+        }
+        if sc != seen[1].load(Ordering::Relaxed) {
+            seen[1].store(sc, Ordering::Relaxed);
+            seen[3].store(my_ticks, Ordering::Relaxed);
+        }
+        let tick_age = my_ticks.wrapping_sub(seen[2].load(Ordering::Relaxed));
+        let sched_age = my_ticks.wrapping_sub(seen[3].load(Ordering::Relaxed));
+        let what: &[u8] = if tick_age == STALL_TICKS {
+            b"stall"
+        } else if sched_age == STALL_TICKS && tick_age < STALL_TICKS {
+            b"nosched"
+        } else {
+            continue;
+        };
+        let mut buf = [0u8; 96];
+        let mut len = 0;
+        push_bytes(&mut buf, &mut len, b"\r\n[hb ");
+        push_bytes(&mut buf, &mut len, what);
+        push_bytes(&mut buf, &mut len, b" ");
+        push_num(&mut buf, &mut len, other as u32);
+        push_bytes(&mut buf, &mut len, b" seen-by ");
+        push_num(&mut buf, &mut len, idx as u32);
+        push_bytes(&mut buf, &mut len, b" t");
+        push_num(&mut buf, &mut len, t);
+        push_bytes(&mut buf, &mut len, b" s");
+        push_num(&mut buf, &mut len, sc);
+        push_bytes(&mut buf, &mut len, b"]\r\n");
+        crate::devices::uart_pl011::raw_write(&buf[..len]);
+    }
+}
+
+struct LineBuf {
+    buf: [u8; 160],
+    len: usize,
+}
+
+impl core::fmt::Write for LineBuf {
+    fn write_str(&mut self, s: &str) -> core::fmt::Result {
+        for &b in s.as_bytes() {
+            if self.len < self.buf.len() {
+                self.buf[self.len] = b;
+                self.len += 1;
+            }
+        }
+        Ok(())
+    }
+}
+
+fn dump_contexts(beat: u32, switches: &[u32; 8], why: &str, token: &mut CleanLockToken) {
+    use core::fmt::Write;
+    let mut line = LineBuf { buf: [0; 160], len: 0 };
+    let _ = write!(line, "\r\n[hbctx begin beat {beat} {why}]\r\n");
+    crate::devices::uart_pl011::raw_write(&line.buf[..line.len]);
+    let cpus = crate::CPU_COUNT.load(Ordering::Relaxed) as usize;
+    for cpu in 0..cpus.min(8) {
+        let queue_len = crate::percpu::get_percpu_block(crate::cpu_set::LogicalCpuId::new(cpu as u32))
+            .map_or(99, |p| p.switch_internals.queue_len.load(Ordering::Relaxed));
+        line.len = 0;
+        let skips = |c: &[AtomicU32; 8]| c[cpu].load(Ordering::Relaxed);
+        let _ = write!(
+            line,
+            "[hbcpu {cpu} w{} q{queue_len} sl{} sa{} sr{} sv{} ss{}]\r\n",
+            switches[cpu],
+            skips(&crate::context::switch::HB_SKIP_LOCK),
+            skips(&crate::context::switch::HB_SKIP_ADDR),
+            skips(&crate::context::switch::HB_SKIP_RUN),
+            skips(&crate::context::switch::HB_SKIP_VTIME),
+            skips(&crate::context::switch::HB_SKIP_SELF),
+        );
+        crate::devices::uart_pl011::raw_write(&line.buf[..line.len]);
+    }
+    for cpu in 0..cpus.min(8) {
+        let mut out = |args: core::fmt::Arguments| {
+            let mut line = LineBuf { buf: [0; 160], len: 0 };
+            let _ = line.write_fmt(args);
+            let _ = line.write_str("\r\n");
+            crate::devices::uart_pl011::raw_write(&line.buf[..line.len]);
+        };
+        let cpu_id = crate::cpu_set::LogicalCpuId::new(cpu as u32);
+        if !crate::context::switch::hb_dump_queue(cpu_id, token, &mut out) {
+            crate::devices::uart_pl011::raw_write(b"[hbq locked]\r\n");
+        }
+    }
+    let Some(mut contexts) = context::try_contexts(token.downgrade()) else {
+        crate::devices::uart_pl011::raw_write(b"[hbctx list locked]\r\n");
+        return;
+    };
+    let (contexts, mut token) = contexts.token_split();
+    for context_ref in contexts.iter() {
+        line.len = 0;
+        match context_ref.try_read(token.token()) {
+            Some(c) => {
+                let stat = match &c.status {
+                    context::Status::Runnable => "R",
+                    context::Status::Blocked if c.wake.is_some() => "S",
+                    context::Status::Blocked => "B",
+                    context::Status::HardBlocked { .. } => "H",
+                    context::Status::Dead { .. } => "Z",
+                };
+                let _ = write!(
+                    line,
+                    "[hbctx {} {} {}{}{}{}{}{} cpu{} {}",
+                    c.pid,
+                    c.name.as_str(),
+                    stat,
+                    if c.running { "+" } else { "" },
+                    if c.currently_scheduled { "c" } else { "" },
+                    if c.queue_key.is_some() { "q" } else { "" },
+                    if c.is_active { "a" } else { "" },
+                    if c.inside_syscall { " sys" } else { "" },
+                    c.cpu_id.map_or(99, |id| id.get()),
+                    c.status_reason,
+                );
+                if let context::Status::HardBlocked { reason } = &c.status {
+                    let _ = write!(line, " {:?}", reason);
+                }
+                let _ = write!(line, "]\r\n");
+            }
+            None => {
+                let _ = write!(line, "[hbctx locked]\r\n");
+            }
+        }
+        if line.len == line.buf.len() {
+            line.buf[line.len - 3..].copy_from_slice(b"]\r\n");
+        }
+        crate::devices::uart_pl011::raw_write(&line.buf[..line.len]);
+    }
+    crate::devices::uart_pl011::raw_write(b"[hbctx end]\r\n");
+}
+
+// Whether a user context that is runnable but not running sits on a CPU in
+// `idle_cpus` (a bit mask).
+fn runnable_on(idle_cpus: u32, token: &mut CleanLockToken) -> bool {
+    let Some(mut contexts) = context::try_contexts(token.downgrade()) else {
+        return false;
+    };
+    let (contexts, mut token) = contexts.token_split();
+    contexts.iter().any(|context_ref| {
+        context_ref.try_read(token.token()).is_some_and(|c| {
+            c.userspace
+                && !c.running
+                && c.status.is_runnable()
+                && c.cpu_id.is_some_and(|id| id.get() < 32 && idle_cpus & (1 << id.get()) != 0)
+        })
+    })
+}
+
+// Check points of HB_VWRAP already written to serial (bit mask).
+static VWRAP_SHOWN: AtomicU32 = AtomicU32::new(0);
+// Timed dumps: every DUMP_EVERY beats after the baseline, at most TIMED_MAX.
+const DUMP_EVERY: u32 = 2;
+const TIMED_MAX: u32 = 12;
+
+fn show_vwrap() {
+    use core::fmt::Write;
+    use crate::context::switch::HB_VWRAP;
+    for (point, slot) in HB_VWRAP.iter().enumerate() {
+        let value = slot[0].load(Ordering::Relaxed);
+        if value == 0 || VWRAP_SHOWN.load(Ordering::Relaxed) & (1 << point) != 0 {
+            continue;
+        }
+        VWRAP_SHOWN.fetch_or(1 << point, Ordering::Relaxed);
+        let mut line = LineBuf { buf: [0; 160], len: 0 };
+        let _ = write!(
+            line,
+            "\r\n[hbv {point} cpu{} {value} {} {} {}]\r\n",
+            slot[4].load(Ordering::Relaxed),
+            slot[1].load(Ordering::Relaxed),
+            slot[2].load(Ordering::Relaxed),
+            slot[3].load(Ordering::Relaxed),
+        );
+        crate::devices::uart_pl011::raw_write(&line.buf[..line.len]);
+    }
+}
+
+fn maybe_dump(beat: u32, token: &mut CleanLockToken) {
+    use crate::context::switch::HB_SWITCH;
+    show_vwrap();
+    let cpus = crate::CPU_COUNT.load(Ordering::Relaxed) as usize;
+    let mut switches = [0u32; 8];
+    let mut idle_cpus = 0u32;
+    for cpu in 0..cpus.min(8) {
+        let now = HB_SWITCH[cpu].load(Ordering::Relaxed);
+        switches[cpu] = now.wrapping_sub(DUMP_LAST_SWITCHES[cpu].swap(now, Ordering::Relaxed));
+        if switches[cpu] == 0 {
+            idle_cpus |= 1 << cpu;
+        }
+    }
+    let total = switches.iter().fold(0u32, |sum, w| sum.wrapping_add(*w));
+    if beat == 2 {
+        dump_contexts(beat, &switches, "baseline", token);
+        return;
+    }
+    if beat < 2 {
+        return;
+    }
+    if beat % DUMP_EVERY == 0 && beat / DUMP_EVERY <= TIMED_MAX {
+        dump_contexts(beat, &switches, "timed", token);
+        return;
+    }
+    if DUMPS.load(Ordering::Relaxed) >= DUMP_MAX {
+        return;
+    }
+    let why = if total < DUMP_SWITCHES {
+        "few-switches"
+    } else if idle_cpus != 0 && runnable_on(idle_cpus, token) {
+        "runnable-on-idle-cpu"
+    } else {
+        return;
+    };
+    DUMPS.fetch_add(1, Ordering::Relaxed);
+    dump_contexts(beat, &switches, why, token);
+}
+
+fn heartbeat(cpu: u32, token: &mut CleanLockToken) {
+    let idx = cpu as usize;
+    let (Some(counter), Some(last)) = (HEARTBEAT.get(idx), HB_LAST.get(idx)) else {
+        return;
+    };
+    let ticks = counter.fetch_add(1, Ordering::Relaxed) + 1;
+    watch_others(idx, ticks);
+    if ticks % HEARTBEAT_TICKS != 0 {
+        return;
+    }
+    use crate::context::switch::{HB_IDLE, HB_SCHED, HB_SWITCH};
+    let now = [
+        HB_SCHED[idx].load(Ordering::Relaxed),
+        HB_SWITCH[idx].load(Ordering::Relaxed),
+        HB_IDLE[idx].load(Ordering::Relaxed),
+    ];
+    let pit = crate::context::switch::hb_pit_ticks();
+
+    let mut buf = [0u8; 96];
+    let mut len = 0;
+    push_bytes(&mut buf, &mut len, b"\r\n[hb ");
+    push_num(&mut buf, &mut len, cpu);
+    push_bytes(&mut buf, &mut len, b" ");
+    push_num(&mut buf, &mut len, ticks / HEARTBEAT_TICKS);
+    for (k, tag) in [b" s", b" w", b" i"].iter().enumerate() {
+        push_bytes(&mut buf, &mut len, *tag);
+        push_num(&mut buf, &mut len, now[k].wrapping_sub(last[k].load(Ordering::Relaxed)));
+        last[k].store(now[k], Ordering::Relaxed);
+    }
+    push_bytes(&mut buf, &mut len, b" p");
+    push_num(&mut buf, &mut len, pit as u32);
+    push_bytes(&mut buf, &mut len, b"]\r\n");
+    crate::devices::uart_pl011::raw_write(&buf[..len]);
+    if idx == 0 {
+        maybe_dump(ticks / HEARTBEAT_TICKS, token);
+    }
+}
