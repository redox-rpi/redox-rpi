 use crate::{
     scheme::debug::{debug_input, debug_notify},
@@ -98,6 +101,24 @@
 // longer writes, such as a shell redrawing its line after each key.
 const RX_STASH_SIZE: usize = 1024;
 
+// Base address of the PL011, for raw_write(): a diagnostic writer that takes
+// no lock, so it still works when a CPU holds the COM1 lock.
+static RAW_BASE: AtomicUsize = AtomicUsize::new(0);
+
+/// Write bytes straight to the PL011 data register without the COM1 lock.
+/// Output may interleave with locked writes. For diagnostics only.
+pub fn raw_write(bytes: &[u8]) {
+    let base = RAW_BASE.load(Ordering::Relaxed);
+    if base == 0 {
+        return;
+    }
+    for &b in bytes {
+        // FR (0x18) bit 5: transmit FIFO full.
+        while unsafe { ptr::read_volatile((base + 0x18) as *const u32) } & (1 << 5) != 0 {}
+        unsafe { ptr::write_volatile(base as *mut u32, b as u32) };
+    }
+}
+
 pub struct SerialPort {
     base: usize,
     data_reg: u8,
@@ -257,6 +278,7 @@
     }
 
     pub fn enable_irq(&mut self) {
+        RAW_BASE.store(self.base, Ordering::Relaxed);
         self.clear_all_irqs();
 
         self.drain_fifo();
