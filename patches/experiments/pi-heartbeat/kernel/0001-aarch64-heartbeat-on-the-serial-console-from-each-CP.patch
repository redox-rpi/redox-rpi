 /// switch if the counter reaches a set threshold (e.g., every 3 ticks).
 ///
 /// The function also calls the signal handler after switching contexts.
+// Per-CPU scheduler counters for the heartbeat (experiment pi-heartbeat,
+// #14): schedule() calls, real switches to another context, and idle results.
+pub static HB_SCHED: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+pub static HB_SWITCH: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+pub static HB_IDLE: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+// Why select_next_context passed over a queued context (#157): its context
+// lock was taken, its address space lock was taken, or update_runnable said
+// Skip (running elsewhere, currently scheduled, affinity).
+pub static HB_SKIP_LOCK: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+pub static HB_SKIP_ADDR: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+pub static HB_SKIP_RUN: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+// The silent skips before those: the vtime filter, and the entry being the
+// idle or the current sched context.
+pub static HB_SKIP_VTIME: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+pub static HB_SKIP_SELF: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+
+// The first value above 2^62 at each place that changes virtual time (#157):
+// v and vtime stay near uptime scale, so a value this big wrapped or
+// underflowed. Per check point: value, three inputs, CPU. Written once,
+// printed by the heartbeat as `[hbv …]`.
+pub static HB_VWRAP: [[AtomicU64; 5]; 6] = [const { [const { AtomicU64::new(0) }; 5] }; 6];
+
+fn hb_vcheck(point: usize, value: u64, a: u64, b: u64, c: u64) {
+    if value <= 1 << 62 {
+        return;
+    }
+    let Some(slot) = HB_VWRAP.get(point) else {
+        return;
+    };
+    if slot[0]
+        .compare_exchange(0, value, Ordering::Relaxed, Ordering::Relaxed)
+        .is_ok()
+    {
+        slot[1].store(a, Ordering::Relaxed);
+        slot[2].store(b, Ordering::Relaxed);
+        slot[3].store(c, Ordering::Relaxed);
+        slot[4].store(crate::cpu_id().get() as u64, Ordering::Relaxed);
+    }
+}
+
+/// Writes a CPU's run queue for the heartbeat dump (#157): `v`, length and
+/// total weight, then per entry (at most 8) its vtime and the context's pid
+/// and name, with `own` if the context's queue_key is this entry and `stale`
+/// if not. Returns false if the queue lock is taken.
+pub fn hb_dump_queue(
+    cpu: LogicalCpuId,
+    token: &mut CleanLockToken,
+    out: &mut dyn FnMut(core::fmt::Arguments),
+) -> bool {
+    let Some(percpu) = get_percpu_block(cpu) else {
+        return false;
+    };
+    let Some(queue) = percpu.switch_internals.run_queue.try_lock() else {
+        return false;
+    };
+    let id = cpu.get();
+    out(format_args!(
+        "[hbq {id} v{} n{} tw{}]",
+        queue.v,
+        queue.queue.len(),
+        queue.total_weight
+    ));
+    for (key, value) in queue.queue.iter().take(8) {
+        let Some(lock) = value.context_ref.upgrade() else {
+            out(format_args!("[hbq {id} vt{} id{} gone]", value.vtime, key.ctxt_id));
+            continue;
+        };
+        match lock.try_read(token.token()) {
+            Some(c) => out(format_args!(
+                "[hbq {id} vt{} id{} {} {} {}]",
+                value.vtime,
+                key.ctxt_id,
+                c.pid,
+                c.name.as_str(),
+                if c.queue_key == Some(*key) { "own" } else { "stale" }
+            )),
+            None => out(format_args!("[hbq {id} vt{} id{} locked]", value.vtime, key.ctxt_id)),
+        }
+    }
+    true
+}
+
+/// Timer ticks since this CPU last ran schedule().
+pub fn hb_pit_ticks() -> usize {
+    PercpuBlock::current().switch_internals.pit_ticks.get()
+}
+
+fn hb_count(counters: &[core::sync::atomic::AtomicU32; 8]) {
+    if let Some(c) = counters.get(crate::cpu_id().get() as usize) {
+        c.fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+    }
+}
