 use crate::{
@@ -124,10 +124,21 @@ pub(super) unsafe fn ioctl(fd: c_int, func: u8, buf: IoctlBuffer) -> Result<c_in
         0x00 => unsafe { dev.read_write_ioctl::<drm_version>(buf, VERSION) },
         0x01 => unsafe { dev.read_write_ioctl::<drm_unique>(buf, GET_UNIQUE) },
         0x07 => unsafe { dev.read_write_ioctl::<drm_set_version>(buf, SET_VERSION) },
+        0x09 => unsafe { dev.write_ioctl::<drm_gem_close>(buf, GEM_CLOSE) },
         0x0C => unsafe { dev.read_write_ioctl::<drm_get_cap>(buf, GET_CAP) },
         0x0D => unsafe { dev.write_ioctl::<drm_set_client_cap>(buf, SET_CLIENT_CAP) },
         0x2D => unsafe { dev.prime_handle_to_fd(buf) },
         0x2E => unsafe { dev.prime_fd_to_handle(buf) },
+        // Driver ioctls (DRM_COMMAND_BASE and up): V3D, served by v3dd.
+        0x40 => unsafe { dev.read_write_ioctl::<v3d::drm_v3d_submit_cl>(buf, v3d::SUBMIT_CL) },
+        0x41 => unsafe { dev.read_write_ioctl::<v3d::drm_v3d_wait_bo>(buf, v3d::WAIT_BO) },
+        0x42 => unsafe { dev.read_write_ioctl::<v3d::drm_v3d_create_bo>(buf, v3d::CREATE_BO) },
+        0x43 => unsafe { dev.read_write_ioctl::<v3d::drm_v3d_mmap_bo>(buf, v3d::MMAP_BO) },
+        0x44 => unsafe { dev.read_write_ioctl::<v3d::drm_v3d_get_param>(buf, v3d::GET_PARAM) },
+        0x45 => unsafe {
+            dev.read_write_ioctl::<v3d::drm_v3d_get_bo_offset>(buf, v3d::GET_BO_OFFSET)
+        },
+        0x47 => unsafe { dev.write_ioctl::<v3d::drm_v3d_submit_csd>(buf, v3d::SUBMIT_CSD) },
         0xA0 => unsafe { dev.read_write_ioctl::<drm_mode_card_res>(buf, MODE_CARD_RES) },
         0xA1 => unsafe { dev.read_write_ioctl::<drm_mode_crtc>(buf, MODE_GET_CRTC) },
         0xA2 => unsafe { dev.read_write_ioctl::<drm_mode_crtc>(buf, MODE_SET_CRTC) },
