diff --git a/redox-ioctl/src/v3d.rs b/redox-ioctl/src/v3d.rs
new file mode 100644
index 00000000..cfcae94a
--- /dev/null
+++ b/redox-ioctl/src/v3d.rs
@@ -0,0 +1,236 @@
+//! The V3D (Broadcom VideoCore VI, Raspberry Pi 4) driver ioctls of
+//! Linux's `include/uapi/drm/v3d_drm.h`, as far as a Redox V3D daemon
+//! implements them. The function numbers are DRM_COMMAND_BASE (0x40) plus
+//! the driver's number, as in the ioctl request.
+
+use alloc::vec::Vec;
+use core::{cmp, iter, mem, slice};
+
+pub const SUBMIT_CL: u64 = 0x40;
+pub const WAIT_BO: u64 = 0x41;
+pub const CREATE_BO: u64 = 0x42;
+pub const MMAP_BO: u64 = 0x43;
+pub const GET_PARAM: u64 = 0x44;
+pub const GET_BO_OFFSET: u64 = 0x45;
+pub const SUBMIT_CSD: u64 = 0x47;
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_submit_cl {
+    pub bcl_start: u32,
+    pub bcl_end: u32,
+    pub rcl_start: u32,
+    pub rcl_end: u32,
+    pub in_sync_bcl: u32,
+    pub in_sync_rcl: u32,
+    pub out_sync: u32,
+    pub qma: u32,
+    pub qms: u32,
+    pub qts: u32,
+    pub bo_handles: u64,
+    pub bo_handle_count: u32,
+    pub flags: u32,
+    pub perfmon_id: u32,
+    pub pad: u32,
+    pub extensions: u64,
+}
+
+define_ioctl_data! {
+    struct drm_v3d_submit_cl, DrmV3dSubmitCl {
+        bcl_start: u32,
+        bcl_end: u32,
+        rcl_start: u32,
+        rcl_end: u32,
+        in_sync_bcl: u32,
+        in_sync_rcl: u32,
+        out_sync: u32,
+        qma: u32,
+        qms: u32,
+        qts: u32,
+        bo_handles: u64 [array<u32, bo_handle_count>],
+        bo_handle_count: u32,
+        flags: u32,
+        perfmon_id: u32,
+        pad: u32,
+        extensions: u64,
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_wait_bo {
+    pub handle: u32,
+    pub pad: u32,
+    pub timeout_ns: u64,
+}
+
+define_ioctl_data! {
+    struct drm_v3d_wait_bo, DrmV3dWaitBo {
+        handle: u32,
+        pad: u32,
+        timeout_ns: u64,
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_create_bo {
+    pub size: u32,
+    pub flags: u32,
+    pub handle: u32,
+    pub offset: u32,
+}
+
+define_ioctl_data! {
+    struct drm_v3d_create_bo, DrmV3dCreateBo {
+        size: u32,
+        flags: u32,
+        handle: u32,
+        offset: u32,
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_mmap_bo {
+    pub handle: u32,
+    pub flags: u32,
+    pub offset: u64,
+}
+
+define_ioctl_data! {
+    struct drm_v3d_mmap_bo, DrmV3dMmapBo {
+        handle: u32,
+        flags: u32,
+        offset: u64,
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_get_param {
+    pub param: u32,
+    pub pad: u32,
+    pub value: u64,
+}
+
+define_ioctl_data! {
+    struct drm_v3d_get_param, DrmV3dGetParam {
+        param: u32,
+        pad: u32,
+        value: u64,
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_get_bo_offset {
+    pub handle: u32,
+    pub offset: u32,
+}
+
+define_ioctl_data! {
+    struct drm_v3d_get_bo_offset, DrmV3dGetBoOffset {
+        handle: u32,
+        offset: u32,
+    }
+}
+
+/// The C struct has padding after `coef` (before the u64 `bo_handles`),
+/// and its wire form without `bo_handles` has padding before
+/// `extensions`, so it is (de)serialised by hand: the wire form is
+/// `SubmitCsdWire` with zeroed padding, then the handles.
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct drm_v3d_submit_csd {
+    pub cfg: [u32; 7],
+    pub coef: [u32; 4],
+    pub bo_handles: u64,
+    pub bo_handle_count: u32,
+    pub in_sync: u32,
+    pub out_sync: u32,
+    pub perfmon_id: u32,
+    pub extensions: u64,
+    pub flags: u32,
+    pub pad: u32,
+}
+
+/// The fixed part of SUBMIT_CSD on the wire; `pad0` stands for the
+/// alignment gap before `extensions` and is always zero.
+#[repr(C)]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct SubmitCsdWire {
+    pub cfg: [u32; 7],
+    pub coef: [u32; 4],
+    pub bo_handle_count: u32,
+    pub in_sync: u32,
+    pub out_sync: u32,
+    pub perfmon_id: u32,
+    pub pad0: u32,
+    pub extensions: u64,
+    pub flags: u32,
+    pub pad: u32,
+}
+
+impl SubmitCsdWire {
+    fn bytes(&self) -> [u8; size_of::<SubmitCsdWire>()] {
+        // No implicit padding: every byte belongs to a field.
+        unsafe { mem::transmute::<SubmitCsdWire, [u8; size_of::<SubmitCsdWire>()]>(*self) }
+    }
+}
+
+impl crate::ioctl_data::IoctlData for drm_v3d_submit_csd {
+    unsafe fn write(&self) -> Vec<u8> {
+        let fixed = SubmitCsdWire {
+            cfg: self.cfg,
+            coef: self.coef,
+            bo_handle_count: self.bo_handle_count,
+            in_sync: self.in_sync,
+            out_sync: self.out_sync,
+            perfmon_id: self.perfmon_id,
+            pad0: 0,
+            extensions: self.extensions,
+            flags: self.flags,
+            pad: self.pad,
+        };
+        let size = self.bo_handle_count as usize * size_of::<u32>();
+        let mut data = Vec::with_capacity(size_of::<SubmitCsdWire>() + size);
+        data.extend_from_slice(&fixed.bytes());
+        if self.bo_handles != 0 {
+            data.extend_from_slice(unsafe {
+                slice::from_raw_parts(self.bo_handles as usize as *const u8, size)
+            });
+        } else {
+            data.extend(iter::repeat(0u8).take(size));
+        }
+        data
+    }
+
+    unsafe fn read_from(&mut self, buf: &[u8]) {
+        // SUBMIT_CSD sends only; nothing comes back but the fixed part.
+        let n = cmp::min(buf.len(), size_of::<SubmitCsdWire>());
+        let mut fixed = SubmitCsdWire::default();
+        unsafe {
+            slice::from_raw_parts_mut(core::ptr::from_mut(&mut fixed).cast::<u8>(), n)
+                .copy_from_slice(&buf[..n]);
+        }
+        self.cfg = fixed.cfg;
+        self.coef = fixed.coef;
+        self.in_sync = fixed.in_sync;
+        self.out_sync = fixed.out_sync;
+        self.perfmon_id = fixed.perfmon_id;
+        self.extensions = fixed.extensions;
+        self.flags = fixed.flags;
+        self.pad = fixed.pad;
+    }
+}
+
+// The sizes of Linux's structs, which are part of the ioctl requests.
+const _: () = assert!(size_of::<drm_v3d_submit_cl>() == 72);
+const _: () = assert!(size_of::<drm_v3d_wait_bo>() == 16);
+const _: () = assert!(size_of::<drm_v3d_create_bo>() == 16);
+const _: () = assert!(size_of::<drm_v3d_mmap_bo>() == 16);
+const _: () = assert!(size_of::<drm_v3d_get_param>() == 16);
+const _: () = assert!(size_of::<drm_v3d_get_bo_offset>() == 8);
+const _: () = assert!(size_of::<drm_v3d_submit_csd>() == 88);
+const _: () = assert!(size_of::<SubmitCsdWire>() == 80);
