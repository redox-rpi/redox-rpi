+fn gl_target(
+    renderer: &Rc<RefCell<gl::Renderer>>,
+    display_handle: &DrmHandle,
+    map: &V2DisplayMap,
+) -> Option<(Rc<RefCell<gl::Renderer>>, gl::Target)> {
