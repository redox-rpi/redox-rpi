+    let flags = syscall::flag::O_RDWR as u32 | 1;
+    let fd = match display_handle.buffer_to_prime_fd(buffer.handle(), flags) {
+        Ok(fd) => fd,
+        Err(err) => {
+            error!("PRIME export of the display buffer failed, drawing with the CPU: {err}");
+            return None;
+        }
+    };
+    match renderer.borrow_mut().target(fd, width, height, buffer.pitch()) {
+        Ok(target) => Some((renderer.clone(), target)),
+        Err(err) => {
+            error!("GL import of the display buffer failed, drawing with the CPU: {err}");
+            None
+        }
+    }
