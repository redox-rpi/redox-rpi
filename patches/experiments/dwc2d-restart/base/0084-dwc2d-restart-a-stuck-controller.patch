From 2d8fa79d2fe6c786f7bb49d4e0b77ae46fa12264 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Sun, 1 Nov 2026 10:25:06 +0000
Subject: [PATCH] dwc2d: restart a stuck controller (#151)

In Pi test 189 every hub request timed out for good after a network
write failed: dwc2d spun through one-second timeouts and the network
was gone. A channel that timed out was only told to stop; now dwc2d
waits until it halts (and counts the channels that do not), and after
four control requests in a row time out it logs the controller state,
forgets every device, resets and sets up the controller again, and the
next rescan enumerates the devices anew. "restart" in
/tmp/dwc2d-cycle does the same, for tests.
---
 drivers/usb/dwc2d/src/dwc2.rs      | 64 ++++++++++++++++++++++++++++--
 drivers/usb/dwc2d/src/enumerate.rs | 39 +++++++++++++++++-
 drivers/usb/dwc2d/src/main.rs      | 25 +++++++++++-
 drivers/usb/dwc2d/src/regs.rs      |  6 +++
 drivers/usb/dwc2d/src/usbdiag.rs   |  6 +++
 5 files changed, 133 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/dwc2d/src/dwc2.rs b/drivers/usb/dwc2d/src/dwc2.rs
index 959bba87..69092c5f 100644
--- a/drivers/usb/dwc2d/src/dwc2.rs
+++ b/drivers/usb/dwc2d/src/dwc2.rs
@@ -341,15 +341,72 @@ impl Dwc2 {
                 return Ok(status);
             }
             if start.elapsed() > timeout {
-                let value = self.read(hcchar(ch));
-                self.write(hcchar(ch), value | HCCHAR_CHDIS);
                 self.note_timeout(ch);
+                self.stop_channel(ch);
                 return Err(Error::Timeout("channel halt"));
             }
             std::hint::spin_loop();
         }
     }
 
+    /// Stop a channel whose transfer timed out and wait until it halts, so
+    /// the next transfer does not start on a channel that is still busy. A
+    /// channel that does not halt even then means the controller is stuck
+    /// (#151, Pi test 189); counted in `/tmp/dwc2d-usbstats`.
+    fn stop_channel(&self, ch: usize) {
+        let value = self.read(hcchar(ch));
+        if value & HCCHAR_CHENA != 0 {
+            self.write(hcchar(ch), value | HCCHAR_CHDIS);
+            if self
+                .wait("channel halt", Duration::from_millis(10), |s| s.read(hcint(ch)) & HCINT_CH_HLTD != 0)
+                .is_err()
+            {
+                crate::usbdiag::HALT_FAILURES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            }
+        }
+        self.write(hcint(ch), u32::MAX);
+    }
+
+    /// The controller's state in one line, for the log before a restart.
+    pub fn dump(&self) -> String {
+        let mut s = format!(
+            "GINTSTS {:#x} HPRT0 {:#x} HFNUM {:#x} GNPTXSTS {:#x} HPTXSTS {:#x} HAINT {:#x} GRSTCTL {:#x}",
+            self.read(GINTSTS),
+            self.read(HPRT0),
+            self.read(HFNUM),
+            self.read(GNPTXSTS),
+            self.read(HPTXSTS),
+            self.read(HAINT),
+            self.read(GRSTCTL),
+        );
+        for ch in 0..self.channels {
+            let c = self.read(hcchar(ch));
+            if c != 0 {
+                s += &format!(
+                    "; ch{ch} HCCHAR {c:#x} HCINT {:#x} HCTSIZ {:#x}",
+                    self.read(hcint(ch)),
+                    self.read(hctsiz(ch))
+                );
+            }
+        }
+        s
+    }
+
+    /// Start the controller over after it got stuck: disable every channel,
+    /// then the same reset and setup as at start. The devices are enumerated
+    /// again by the next rescan.
+    pub fn restart(&mut self) -> Result<(), Error> {
+        for ch in 0..self.channels {
+            let value = self.read(hcchar(ch));
+            if value & HCCHAR_CHENA != 0 {
+                self.write(hcchar(ch), value | HCCHAR_CHDIS);
+            }
+        }
+        delay(Duration::from_millis(10));
+        self.write(GAHBCFG, 0);
+        self.init_host()
+    }
+
     /// Bytes moved by the last transfer on a channel and the data PID for
     /// the next one.
     fn moved(&self, ch: usize, len: usize) -> (usize, u32) {
@@ -512,9 +569,8 @@ impl Dwc2 {
             }
             if start.elapsed() > timeout {
                 // Halt the channel so it can be reused.
-                let value = self.read(hcchar(ch));
-                self.write(hcchar(ch), value | HCCHAR_CHDIS);
                 self.note_timeout(ch);
+                self.stop_channel(ch);
                 return Err(Error::Timeout("channel halt"));
             }
             std::hint::spin_loop();
