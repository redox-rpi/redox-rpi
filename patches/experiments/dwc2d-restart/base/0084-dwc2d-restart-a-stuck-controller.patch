     retries: HashMap<Option<(u8, u16)>, u8>,
+    /// Requests that timed out since the last one that did not.
+    timeouts_in_a_row: u32,
 }
 
+/// Requests timing out in a row after which the controller counts as stuck
+/// (#151, Pi test 189: every hub request timed out, for good).
+const STUCK_AFTER_TIMEOUTS: u32 = 4;
+
 impl Bus {
     pub fn new(hc: &Dwc2) -> Self {
         Self {
@@ -130,9 +136,30 @@ impl Bus {
             hubs: Vec::new(),
             failed: HashSet::new(),
             retries: HashMap::new(),
+            timeouts_in_a_row: 0,
         }
     }
 
+    /// Whether the controller seems stuck: control requests keep timing
+    /// out. (A device that is unplugged makes its own polls time out, not
+    /// the hub requests of a rescan.)
+    pub fn stuck(&self) -> bool {
+        self.timeouts_in_a_row >= STUCK_AFTER_TIMEOUTS
+    }
+
+    /// Forget every device, before the controller is restarted; returns
+    /// their addresses.
+    pub fn forget_all(&mut self) -> Vec<u8> {
+        let removed = self.devices.iter().map(|d| d.address).collect();
+        self.devices.clear();
+        self.hubs.clear();
+        self.tts.clear();
+        self.failed.clear();
+        self.retries.clear();
+        self.timeouts_in_a_row = 0;
+        removed
+    }
+
     /// The lowest address no device uses.
     fn free_address(&self) -> Result<u8, Error> {
         (1..=127)
@@ -169,12 +196,20 @@ impl Bus {
                 &mut self.setup,
                 &mut self.data,
             ) {
-                Ok(len) => return Ok(self.data[..len].to_vec()),
+                Ok(len) => {
+                    self.timeouts_in_a_row = 0;
+                    return Ok(self.data[..len].to_vec());
+                }
                 Err(Error::Stall) if attempt < ATTEMPTS => {
                     attempt += 1;
                     delay(Duration::from_millis(10));
                 }
                 Err(err) => {
+                    if matches!(err, Error::Timeout(_)) {
+                        self.timeouts_in_a_row += 1;
+                    } else {
+                        self.timeouts_in_a_row = 0;
+                    }
                     println!(
                         "dwc2d: request {:02x?} to address {address} (max packet {max_packet}, {speed:?} speed) failed: {err:?}",
                         *self.setup
@@ -554,7 +589,7 @@ impl Bus {
         hubs.sort_by_key(|h| h.depth);
         for hub in hubs {
             for port in 1..=hub.ports {
-                if !self.hubs.iter().any(|h| h.address == hub.address) {
+                if !self.hubs.iter().any(|h| h.address == hub.address) || self.stuck() {
                     break;
                 }
                 if let Err(err) = self.scan_port(hub, port, &mut changes.removed) {
diff --git a/drivers/usb/dwc2d/src/main.rs b/drivers/usb/dwc2d/src/main.rs
index 7ebbee56..57631779 100644
--- a/drivers/usb/dwc2d/src/main.rs
+++ b/drivers/usb/dwc2d/src/main.rs
@@ -604,11 +604,15 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                 hotplug.fired();
                 usbdiag::step("scan");
                 let mut cycled = Vec::new();
+                let mut restart = false;
                 if let Ok(request) = std::fs::read_to_string(CYCLE_REQUEST) {
                     let _ = std::fs::remove_file(CYCLE_REQUEST);
                     let net = scheme.adapter_mut();
                     let request = request.trim();
+                    restart = request == "restart";
                     let port = match request {
+                        // A controller restart, for tests (see below).
+                        "restart" => None,
                         "network" => net.active.and_then(|a| bus.port_of(a)),
                         "keyboard" => keyboard.as_ref().and_then(|k| bus.port_of(k.address())),
                         _ => {
@@ -630,11 +634,30 @@ fn daemon(daemon: daemon::Daemon) -> ! {
                                 println!("dwc2d: cycle: {err:?}");
                             }
                         }
+                        None if restart => {}
                         None => println!("dwc2d: cycle: no port for {request:?}"),
                     }
                 }
-                let mut changes = bus.scan();
+                let mut changes = if restart { Default::default() } else { bus.scan() };
                 changes.removed.extend(cycled);
+                // A stuck controller (every request times out) does not come
+                // back by itself: restart it and find the devices again.
+                if restart || bus.stuck() {
+                    usbdiag::step("restart");
+                    println!("dwc2d: controller stuck, restarting it: {}", hc.dump());
+                    println!("dwc2d: errors so far: {}", usbdiag::summary());
+                    usbdiag::RESTARTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                    changes.removed.extend(bus.forget_all());
+                    match hc.restart() {
+                        Ok(()) => {
+                            if irq_file.is_some() {
+                                hc.enable_rx_interrupt(RX_CHANNEL);
+                            }
+                            println!("dwc2d: controller restarted");
+                        }
+                        Err(err) => println!("dwc2d: controller restart failed: {err:?}"),
+                    }
+                }
                 let net = scheme.adapter_mut();
                 for &address in &changes.removed {
                     net.remove(address);
