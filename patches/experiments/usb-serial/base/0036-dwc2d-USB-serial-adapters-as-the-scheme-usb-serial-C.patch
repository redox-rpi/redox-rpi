+    /// The ports from the root to a device, e.g. `1.3` for port 3 of the hub
+    /// on port 1 of the root hub; `0` for the device on the root port.
+    pub fn port_path(&self, address: u8) -> String {
+        let mut ports = Vec::new();
+        let mut current = address;
+        while let Some((hub, port)) = self.port_of(current) {
+            ports.push(port.to_string());
+            current = hub;
+        }
+        if ports.is_empty() {
+            return "0".to_string();
+        }
+        ports.reverse();
+        ports.join(".")
+    }
+
