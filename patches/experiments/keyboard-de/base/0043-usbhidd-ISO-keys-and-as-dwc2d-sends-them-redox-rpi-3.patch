From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Fri, 20 Nov 2026 10:44:21 +0000
Subject: [PATCH] usbhidd: ISO keys # and < > as dwc2d sends them (redox-rpi
 #36)

The xHCI keyboard path (Pi 4/400) sent the key left of Enter as 0x56
and the key right of the left Shift as K_APP. inputd keymaps expect
K_BACKSLASH and 0x56, as dwc2d sends them. Now German and UK
keyboards type # ~ and < > on the Pi 400 too.
---
 drivers/input/usbhidd/src/input/keyboard.rs | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/input/usbhidd/src/input/keyboard.rs b/drivers/input/usbhidd/src/input/keyboard.rs
index 33ba90d1..8d8ec2b1 100644
--- a/drivers/input/usbhidd/src/input/keyboard.rs
+++ b/drivers/input/usbhidd/src/input/keyboard.rs
@@ -55,8 +55,9 @@ pub(crate) fn send_key_event(
             0x2F => orbclient::K_BRACE_OPEN,
             0x30 => orbclient::K_BRACE_CLOSE,
             0x31 => orbclient::K_BACKSLASH,
-            // 0x32 non-us # and ~
-            0x32 => 0x56,
+            // 0x32 non-US # and ~: the key left of Enter on ISO keyboards,
+            // K_BACKSLASH as in dwc2d, where the gb and de keymaps put # and ~
+            0x32 => orbclient::K_BACKSLASH,
             0x33 => orbclient::K_SEMICOLON,
             0x34 => orbclient::K_QUOTE,
             0x35 => orbclient::K_TICK,
@@ -106,8 +107,9 @@ pub(crate) fn send_key_event(
             0x61 => orbclient::K_NUM_9,
             0x62 => orbclient::K_NUM_0,
             // 0x62 num .
-            // 0x64 non-us \ and |
-            0x64 => orbclient::K_APP,
+            // 0x64 non-US \ and |: the key right of the left Shift on ISO
+            // keyboards (< > on German ones), 0x56 in the keymaps as in dwc2d
+            0x64 => 0x56,
             0x66 => orbclient::K_POWER,
             // 0x67 num =
             // unmapped values
-- 
