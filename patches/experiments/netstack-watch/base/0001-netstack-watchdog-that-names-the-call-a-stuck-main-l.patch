index 00000000..379d5ae2
--- /dev/null
+++ b/netstack/src/watch.rs
@@ -0,0 +1,133 @@
+//! Watchdog for a main loop that stops (redox-rpi #92).
+//!
+//! netstack runs on one thread, so one call that never returns stops the
+//! whole stack. The main loop records what it is doing; a second thread
+//! writes to the serial console when that has taken longer than 5 s, and
+//! again every 30 s, so a hang shows which call it is in.
+
+use std::fs::File;
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, AtomicU8, Ordering};
+use std::sync::OnceLock;
+use std::thread;
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum Stage {
+    Idle = 0,
+    NetworkEvent,
+    TimeEvent,
+    IpScheme,
+    UdpScheme,
+    TcpScheme,
+    IcmpScheme,
+    NetcfgScheme,
+    DeviceWrite,
+    DeviceRead,
+}
+
+impl Stage {
+    fn from_u8(v: u8) -> Self {
+        match v {
+            1 => Stage::NetworkEvent,
+            2 => Stage::TimeEvent,
+            3 => Stage::IpScheme,
+            4 => Stage::UdpScheme,
+            5 => Stage::TcpScheme,
+            6 => Stage::IcmpScheme,
+            7 => Stage::NetcfgScheme,
+            8 => Stage::DeviceWrite,
+            9 => Stage::DeviceRead,
+            _ => Stage::Idle,
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Stage::Idle => "idle",
+            Stage::NetworkEvent => "network device event",
+            Stage::TimeEvent => "timer event",
+            Stage::IpScheme => "ip scheme request",
+            Stage::UdpScheme => "udp scheme request",
+            Stage::TcpScheme => "tcp scheme request",
+            Stage::IcmpScheme => "icmp scheme request",
+            Stage::NetcfgScheme => "netcfg scheme request",
+            Stage::DeviceWrite => "write to the network device",
+            Stage::DeviceRead => "read from the network device",
+        }
+    }
+}
+
+static STAGE: AtomicU8 = AtomicU8::new(0);
+// Milliseconds since START when STAGE was last set.
+static SINCE: AtomicU64 = AtomicU64::new(0);
+static START: OnceLock<Instant> = OnceLock::new();
+
+fn now_ms() -> u64 {
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+
+/// Records that the main loop now does `stage`; returns what it did before.
+pub fn set(stage: Stage) -> Stage {
+    SINCE.store(now_ms(), Ordering::Relaxed);
+    Stage::from_u8(STAGE.swap(stage as u8, Ordering::Relaxed))
+}
+
+/// Sets `stage` until the guard is dropped, then goes back to the stage before.
+pub struct Guard(Stage);
+
+impl Guard {
+    pub fn new(stage: Stage) -> Self {
+        Guard(set(stage))
+    }
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        set(self.0);
+    }
+}
+
+/// Starts the watchdog thread. `debug` is the serial console, opened before
+/// netstack leaves its namespace.
+pub fn spawn(mut debug: File) {
+    now_ms();
+    thread::spawn(move || {
+        // Start of the stall that was last reported, and when.
+        let mut reported: Option<(u64, u64)> = None;
+        loop {
+            thread::sleep(Duration::from_secs(1));
+            let stage = Stage::from_u8(STAGE.load(Ordering::Relaxed));
+            let since = SINCE.load(Ordering::Relaxed);
+            let now = now_ms();
+            match reported {
+                Some((start, _)) if start != since || stage == Stage::Idle => {
+                    let _ = writeln!(
+                        debug,
+                        "netstack-watch: main loop back after {} s",
+                        (now.saturating_sub(start)) / 1000
+                    );
+                    reported = None;
+                }
+                _ => {}
+            }
+            if stage == Stage::Idle || now.saturating_sub(since) < 5000 {
+                continue;
+            }
+            let due = match reported {
+                None => true,
+                Some((_, last)) => now.saturating_sub(last) >= 30_000,
+            };
+            if due {
+                let _ = writeln!(
+                    debug,
+                    "netstack-watch: main loop stuck in {} for {} s",
+                    stage.name(),
+                    (now - since) / 1000
+                );
+                reported = Some((since, now));
+            }
+        }
+    });
+}
