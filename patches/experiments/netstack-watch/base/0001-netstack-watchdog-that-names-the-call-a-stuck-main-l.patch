diff --git a/netstack/src/watch.rs b/netstack/src/watch.rs
new file mode 100644
index 00000000..9192bb76
--- /dev/null
+++ b/netstack/src/watch.rs
@@ -0,0 +1,214 @@
+//! Watchdog for a main loop that stops (redox-rpi #92).
+//!
+//! netstack runs on one thread, so one call that never returns stops the
+//! whole stack. The main loop records what it is doing; a second thread
+//! writes to the serial console when that has taken longer than 5 s, and
+//! again every 30 s, so a hang shows which call it is in.
+//!
+//! The main loop re-arms its timer at least every 500 ms, so it never waits
+//! long for an event. When no timer event has come for 10 s, and the loop is
+//! not stuck in a call, the thread writes that too: the loop waits for events
+//! that do not come (Pi test 213 showed nothing, because the first version
+//! did not report this). Every 10 min it also writes a heartbeat with the
+//! event counts; if those stop, the watchdog thread itself is not running.
+
+use std::fs::File;
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, AtomicU8, Ordering};
+use std::sync::OnceLock;
+use std::thread;
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum Stage {
+    Idle = 0,
+    NetworkEvent,
+    TimeEvent,
+    IpScheme,
+    UdpScheme,
+    TcpScheme,
+    IcmpScheme,
+    NetcfgScheme,
+    DeviceWrite,
+    DeviceRead,
+}
+
+impl Stage {
+    fn from_u8(v: u8) -> Self {
+        match v {
+            1 => Stage::NetworkEvent,
+            2 => Stage::TimeEvent,
+            3 => Stage::IpScheme,
+            4 => Stage::UdpScheme,
+            5 => Stage::TcpScheme,
+            6 => Stage::IcmpScheme,
+            7 => Stage::NetcfgScheme,
+            8 => Stage::DeviceWrite,
+            9 => Stage::DeviceRead,
+            _ => Stage::Idle,
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Stage::Idle => "idle",
+            Stage::NetworkEvent => "network device event",
+            Stage::TimeEvent => "timer event",
+            Stage::IpScheme => "ip scheme request",
+            Stage::UdpScheme => "udp scheme request",
+            Stage::TcpScheme => "tcp scheme request",
+            Stage::IcmpScheme => "icmp scheme request",
+            Stage::NetcfgScheme => "netcfg scheme request",
+            Stage::DeviceWrite => "write to the network device",
+            Stage::DeviceRead => "read from the network device",
+        }
+    }
+}
+
+static STAGE: AtomicU8 = AtomicU8::new(0);
+// Milliseconds since START when STAGE was last set.
+static SINCE: AtomicU64 = AtomicU64::new(0);
+static START: OnceLock<Instant> = OnceLock::new();
+// Events the main loop took, all and from the network device.
+static EVENTS: AtomicU64 = AtomicU64::new(0);
+static NETWORK_EVENTS: AtomicU64 = AtomicU64::new(0);
+// Frames read from the network device.
+static FRAMES_IN: AtomicU64 = AtomicU64::new(0);
+// Milliseconds since START of the last timer event.
+static LAST_TIMER: AtomicU64 = AtomicU64::new(0);
+
+const HEARTBEAT_MS: u64 = 600_000;
+const NO_TIMER_MS: u64 = 10_000;
+
+fn now_ms() -> u64 {
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+
+/// Counts an event the main loop took.
+pub fn event(stage: Stage) {
+    EVENTS.fetch_add(1, Ordering::Relaxed);
+    if stage == Stage::NetworkEvent {
+        NETWORK_EVENTS.fetch_add(1, Ordering::Relaxed);
+    }
+    if stage == Stage::TimeEvent {
+        LAST_TIMER.store(now_ms(), Ordering::Relaxed);
+    }
+}
+
+/// Counts a frame read from the network device.
+pub fn frame_in() {
+    FRAMES_IN.fetch_add(1, Ordering::Relaxed);
+}
+
+/// Records that the main loop now does `stage`; returns what it did before.
+pub fn set(stage: Stage) -> Stage {
+    SINCE.store(now_ms(), Ordering::Relaxed);
+    Stage::from_u8(STAGE.swap(stage as u8, Ordering::Relaxed))
+}
+
+/// Sets `stage` until the guard is dropped, then goes back to the stage before.
+pub struct Guard(Stage);
+
+impl Guard {
+    pub fn new(stage: Stage) -> Self {
+        Guard(set(stage))
+    }
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        set(self.0);
+    }
+}
+
+/// Starts the watchdog thread. `debug` is the serial console, opened before
+/// netstack leaves its namespace.
+pub fn spawn(mut debug: File) {
+    now_ms();
+    thread::spawn(move || {
+        // Start of the stall that was last reported, and when.
+        let mut reported: Option<(u64, u64)> = None;
+        let mut heartbeat = 0u64;
+        // Start of the timer gap that was last reported, and when.
+        let mut no_timer: Option<(u64, u64)> = None;
+        loop {
+            thread::sleep(Duration::from_secs(1));
+            let stage = Stage::from_u8(STAGE.load(Ordering::Relaxed));
+            let since = SINCE.load(Ordering::Relaxed);
+            let now = now_ms();
+            if now.saturating_sub(heartbeat) >= HEARTBEAT_MS {
+                heartbeat = now;
+                let _ = writeln!(
+                    debug,
+                    "netstack-watch: alive at {} s, {} for {} s, {} events ({} network), {} frames in",
+                    now / 1000,
+                    stage.name(),
+                    now.saturating_sub(since) / 1000,
+                    EVENTS.load(Ordering::Relaxed),
+                    NETWORK_EVENTS.load(Ordering::Relaxed),
+                    FRAMES_IN.load(Ordering::Relaxed)
+                );
+            }
+            match reported {
+                Some((start, _)) if start != since || stage == Stage::Idle => {
+                    let _ = writeln!(
+                        debug,
+                        "netstack-watch: main loop back after {} s",
+                        (now.saturating_sub(start)) / 1000
+                    );
+                    reported = None;
+                }
+                _ => {}
+            }
+            let last_timer = LAST_TIMER.load(Ordering::Relaxed);
+            match no_timer {
+                Some((start, _)) if start != last_timer => {
+                    let _ = writeln!(
+                        debug,
+                        "netstack-watch: timer events again after {} s",
+                        last_timer.saturating_sub(start) / 1000
+                    );
+                    no_timer = None;
+                }
+                _ => {}
+            }
+            let gap = now.saturating_sub(last_timer);
+            if reported.is_none() && gap >= NO_TIMER_MS {
+                let due = match no_timer {
+                    None => true,
+                    Some((_, last)) => now.saturating_sub(last) >= HEARTBEAT_MS,
+                };
+                if due {
+                    let _ = writeln!(
+                        debug,
+                        "netstack-watch: no timer event for {} s, {} for {} s, {} events ({} network), {} frames in",
+                        gap / 1000,
+                        stage.name(),
+                        now.saturating_sub(since) / 1000,
+                        EVENTS.load(Ordering::Relaxed),
+                        NETWORK_EVENTS.load(Ordering::Relaxed),
+                        FRAMES_IN.load(Ordering::Relaxed)
+                    );
+                    no_timer = Some((last_timer, now));
+                }
+            }
+            if stage == Stage::Idle || now.saturating_sub(since) < 5000 {
+                continue;
+            }
+            let due = match reported {
+                None => true,
+                Some((_, last)) => now.saturating_sub(last) >= 30_000,
+            };
+            if due {
+                let _ = writeln!(
+                    debug,
+                    "netstack-watch: main loop stuck in {} for {} s",
+                    stage.name(),
+                    (now - since) / 1000
+                );
+                reported = Some((since, now));
+            }
+        }
+    });
+}
-- 
