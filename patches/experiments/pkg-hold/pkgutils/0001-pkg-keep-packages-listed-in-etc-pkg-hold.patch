From c812af3d8be54c084b3b37ca70ff86bd01b25c5c Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Thu, 29 Oct 2026 12:29:41 +0000
Subject: [PATCH] pkg: keep packages listed in /etc/pkg/hold

A system with its own builds of some packages (kernel, relibc, base)
lists them in /etc/pkg/hold. pkg install and pkg update then keep the
installed version of these packages instead of the remote one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg-lib/src/library.rs | 39 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/pkg-lib/src/library.rs b/pkg-lib/src/library.rs
index 2bd6ea9..7d644ed 100644
--- a/pkg-lib/src/library.rs
+++ b/pkg-lib/src/library.rs
@@ -3,7 +3,7 @@ use crate::callback::Callback;
 use crate::package::{PackageInfo, PackageName, RemotePackage};
 use crate::repo_manager::RepoManager;
 use crate::{sorensen, LibraryBuilder, PackageState};
-use std::collections::{btree_map, BTreeMap};
+use std::collections::{btree_map, BTreeMap, BTreeSet};
 use std::{cell::RefCell, cmp::Ordering, path::Path, rc::Rc};
 
 pub struct Library {
@@ -12,6 +12,25 @@ pub struct Library {
     cached_info: BTreeMap<PackageName, RemotePackage>,
     backend: Box<dyn Backend>,
     callback: Rc<RefCell<dyn Callback>>,
+    /// installed packages that `install` and `update` leave alone
+    held: BTreeSet<PackageName>,
+}
+
+/// Packages to keep as installed, one name per line (`#` starts a comment):
+/// for a system whose own builds of some packages must not be replaced by
+/// the remote versions.
+const HOLD_PATH: &str = "etc/pkg/hold";
+
+fn read_held(install_path: &Path) -> BTreeSet<PackageName> {
+    let path = install_path.join(HOLD_PATH);
+    let Ok(data) = std::fs::read_to_string(&path) else {
+        return BTreeSet::new();
+    };
+    data.lines()
+        .map(|line| line.split('#').next().unwrap_or("").trim())
+        .filter(|name| !name.is_empty())
+        .filter_map(|name| PackageName::new(name).ok())
+        .collect()
 }
 
 impl Library {
@@ -21,12 +40,14 @@ impl Library {
         remotes_fn: impl Fn(&mut RepoManager) -> Result<(), Error>, // TODO: move to builder
     ) -> Result<Self, Error> {
         let callback = builder.callback.clone();
+        let held = read_held(&builder.install_path());
         let backend = builder.build(remotes_fn)?;
         Ok(Library {
             package_state: backend.get_package_state(),
             backend,
             cached_info: BTreeMap::new(),
             callback,
+            held,
         })
     }
 
@@ -81,6 +102,7 @@ impl Library {
     }
 
     pub fn install(&mut self, packages: Vec<PackageName>) -> Result<(), Error> {
+        let packages = self.without_held(packages);
         self.callback.borrow_mut().fetch_start(packages.len());
         self.install_inner(packages.clone(), 100)?;
         self.package_state.mark_as_manual(true, &packages);
@@ -129,6 +151,21 @@ impl Library {
         Ok(())
     }
 
+    /// Drops installed packages listed in /etc/pkg/hold, with a note.
+    fn without_held(&self, packages: Vec<PackageName>) -> Vec<PackageName> {
+        packages
+            .into_iter()
+            .filter(|p| {
+                let keep = !(self.held.contains(p)
+                    && self.package_state.installed.contains_key(p));
+                if !keep {
+                    eprintln!("{} is held ({}), keeping the installed version", p.as_str(), HOLD_PATH);
+                }
+                keep
+            })
+            .collect()
+    }
+
     /// if packages is empty then update all installed packages
     pub fn update(&mut self, mut packages: Vec<PackageName>) -> Result<(), Error> {
         let repo_list = self.backend.get_repository_detail()?;
