From aa42ec1ed802daa8d51f681049db64e131fe83f9 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Thu, 29 Oct 2026 11:00:06 +0100
Subject: [PATCH] dwc2d: switch a hub port off and on on request, for hotplug
 tests

A test without a person writes `network`, `keyboard` or `<hub> <port>`
to /tmp/dwc2d-cycle. The next rescan switches that hub port's power off,
waits until the port reports the disconnection (at most 2 s), forgets the
device, and switches the power on again; the rescans after it find the
device anew. A hub that powers its ports only together leaves the device
connected; it is then forgotten and reset, which runs the same code in
dwc2d without the electrical removal. The log says which one happened,
and the hub line now says whether the hub switches power per port.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/usb/dwc2d/src/dwc2.rs      | 38 +++++++++++++++++++++
 drivers/usb/dwc2d/src/enumerate.rs | 55 +++++++++++++++++++++++++++++-
 drivers/usb/dwc2d/src/main.rs      | 37 +++++++++++++++++++-
 3 files changed, 128 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/dwc2d/src/dwc2.rs b/drivers/usb/dwc2d/src/dwc2.rs
index 0f4dfe3..279d8eb 100644
--- a/drivers/usb/dwc2d/src/dwc2.rs
+++ b/drivers/usb/dwc2d/src/dwc2.rs
@@ -155,6 +155,44 @@ impl Dwc2 {
         self.write(hcint(ch), u32::MAX);
     }
 
+    /// Halt every channel whose last transfer went to a device, before the
+    /// device is reset or forgotten: a receive or a transmit that timed out
+    /// may still be enabled.
+    ///
+    /// QEMU's DWC2 marks a halted channel halted but goes on retrying the
+    /// packet it NAKed, and aborts once the device is gone after its reset.
+    /// A SETUP packet on the channel, which a device always takes, replaces
+    /// that packet. Channels already halted (by the driver that used them)
+    /// get it too. On real hardware it is harmless: the device is about to
+    /// be reset, or is gone and the packet times out.
+    pub fn halt_device(&self, address: u8) {
+        let mut setup = None;
+        for ch in 0..self.channels {
+            let value = self.read(hcchar(ch));
+            if (value >> HCCHAR_DEVADDR_SHIFT) & 0x7F != u32::from(address) {
+                continue;
+            }
+            self.halt(ch);
+            // GET_STATUS of the device; no data or status stage follows.
+            let buf = setup.get_or_insert_with(|| {
+                Dma::new([0x80u8, 0x00, 0, 0, 0, 0, 2, 0]).expect("dwc2d: DMA allocation failed")
+            });
+            let phase = Phase {
+                dev_addr: address,
+                endpoint: 0,
+                dir_in: false,
+                ep_type: EPTYPE_CONTROL,
+                max_packet: 8,
+                low_speed: false,
+                pid: PID_SETUP,
+                buf_phys: buf.physical(),
+                len: 8,
+            };
+            let _ = self.packet(ch, &phase, 0, Duration::from_millis(10));
+            self.halt(ch);
+        }
+    }
+
     /// Whether a device is connected to the root port.
     pub fn root_connected(&self) -> bool {
         self.read(HPRT0) & HPRT0_CONN_STS != 0
diff --git a/drivers/usb/dwc2d/src/enumerate.rs b/drivers/usb/dwc2d/src/enumerate.rs
index 06ebceb..1b97738 100644
--- a/drivers/usb/dwc2d/src/enumerate.rs
+++ b/drivers/usb/dwc2d/src/enumerate.rs
@@ -270,7 +270,11 @@ impl Bus {
         let desc = self.request(hub, max_packet, speed, 0xA0, REQ_GET_DESCRIPTOR, u16::from(DESC_HUB) << 8, 0, 71)?;
         let ports = u16::from(desc[2]);
         let power_on_delay = Duration::from_millis(u64::from(desc[5]) * 2);
-        println!("dwc2d: {indent}hub at address {hub}: {ports} ports");
+        // wHubCharacteristics, bits 1:0: 00 all ports powered together,
+        // 01 each port on its own.
+        let per_port_power = desc[3] & 0x3 == 0x1;
+        let power = if per_port_power { "per port" } else { "ganged" };
