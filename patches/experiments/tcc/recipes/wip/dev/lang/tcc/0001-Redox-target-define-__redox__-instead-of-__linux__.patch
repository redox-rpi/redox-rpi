From d3047b7e0a0711bc7d344ac0181336dded52cadf Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Sat, 7 Nov 2026 16:03:20 +0000
Subject: [PATCH 1/4] Redox target: define __redox__ instead of __linux__

Build tcc with -DTARGETOS_Redox=1 for a Redox target. relibc's headers
choose Redox values (open flags, suseconds_t) on __redox__ and Linux
values on __linux__, so a Redox tcc must not define __linux__. 64-bit
types are as on Linux.
---
 include/tccdefs.h | 2 +-
 tccpp.c           | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/include/tccdefs.h b/include/tccdefs.h
index 2655c1dd..c4baf1f8 100644
--- a/include/tccdefs.h
+++ b/include/tccdefs.h
@@ -38,7 +38,7 @@
     #define __SIZE_TYPE__ unsigned long
     #define __PTRDIFF_TYPE__ long
     #define __LP64__ 1
-# if defined __linux__
+# if defined __linux__ || defined __redox__
     #define __INT64_TYPE__ long
 # else /* APPLE, BSD */
     #define __INT64_TYPE__ long long
diff --git a/tccpp.c b/tccpp.c
index 214e9cd4..b841a2a2 100644
--- a/tccpp.c
+++ b/tccpp.c
@@ -3559,6 +3559,8 @@ static const char * const target_os_defs =
     "__NetBSD__\0"
 # elif TARGETOS_OpenBSD
     "__OpenBSD__\0"
+# elif TARGETOS_Redox
+    "__redox__\0"
 # else
     "__linux__\0"
     "__linux\0"
