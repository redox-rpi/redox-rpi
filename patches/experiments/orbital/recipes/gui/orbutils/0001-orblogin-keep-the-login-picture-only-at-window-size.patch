         btn_color_active: Color::rgb(59, 102, 135),
@@ -164,6 +171,114 @@ fn build_ui_config() -> Result<UiConfig, Box<dyn Error + 'static>> {
     })
 }
 
+/// The login picture as drawn in a window of `size`: scaled and already
+/// cropped to the window, at `x`, `y`.
+struct Background {
+    size: (u32, u32),
+    image: Image,
+    x: i32,
+    y: i32,
+}
+
+impl Default for Background {
+    fn default() -> Self {
+        Background {
+            size: (0, 0),
+            image: Image::new(0, 0),
+            x: 0,
+            y: 0,
+        }
+    }
+}
+
+impl Background {
+    fn new(path: &str, mode: BackgroundMode, w: u32, h: u32) -> Self {
+        let image = match Image::from_path(path) {
+            Ok(image) => image,
+            Err(err) => {
+                eprintln!("orblogin: cannot load {}: {:?}", path, err);
+                return Background {
+                    size: (w, h),
+                    ..Background::default()
+                };
+            }
+        };
+
+        let (width, height) = find_scale(&image, mode, w, h);
+        let (crop_x, crop_w) = if width > w {
+            ((width - w) / 2, w)
+        } else {
+            (0, width)
+        };
+        let (crop_y, crop_h) = if height > h {
+            ((height - h) / 2, h)
+        } else {
+            (0, height)
+        };
+
+        // Scale straight into the visible part: no copy of the whole scaled
+        // picture (it is larger than the window in zoom mode), since freed
+        // memory is not given back and the peak stays.
+        let cropped = scale_crop(&image, width, height, crop_x, crop_y, crop_w, crop_h);
+        drop(image);
+
+        Background {
+            size: (w, h),
+            image: cropped,
+            x: (w as i32 - crop_w as i32) / 2,
+            y: (h as i32 - crop_h as i32) / 2,
+        }
+    }
+}
+
+/// The part (`crop_x`, `crop_y`, `crop_w` x `crop_h`) of `image` scaled to
+/// `width` x `height`, bilinear.
+fn scale_crop(
+    image: &Image,
+    width: u32,
+    height: u32,
+    crop_x: u32,
+    crop_y: u32,
+    crop_w: u32,
+    crop_h: u32,
+) -> Image {
+    let (iw, ih) = (image.width() as usize, image.height() as usize);
+    let (cw, ch) = (crop_w as usize, crop_h as usize);
+    if iw == 0 || ih == 0 || width == 0 || height == 0 || cw == 0 || ch == 0 {
+        return Image::new(0, 0);
+    }
+    let src = Renderer::data(image);
+    let sx = iw as f32 / width as f32;
+    let sy = ih as f32 / height as f32;
+    let mut out = vec![Color { data: 0 }; cw * ch].into_boxed_slice();
+    let lerp = |a: u8, b: u8, t: f32| a as f32 + (b as f32 - a as f32) * t;
+    let mix = |a: Color, b: Color, t: f32| -> [f32; 4] {
+        [
+            lerp(a.r(), b.r(), t),
+            lerp(a.g(), b.g(), t),
+            lerp(a.b(), b.b(), t),
+            lerp(a.a(), b.a(), t),
+        ]
+    };
+    for y in 0..ch {
+        let fy = (((y as u32 + crop_y) as f32 + 0.5) * sy - 0.5).max(0.0);
+        let y0 = (fy as usize).min(ih - 1);
+        let y1 = (y0 + 1).min(ih - 1);
+        let ty = fy - y0 as f32;
+        for x in 0..cw {
+            let fx = (((x as u32 + crop_x) as f32 + 0.5) * sx - 0.5).max(0.0);
+            let x0 = (fx as usize).min(iw - 1);
+            let x1 = (x0 + 1).min(iw - 1);
+            let tx = fx - x0 as f32;
+            let top = mix(src[y0 * iw + x0], src[y0 * iw + x1], tx);
+            let bottom = mix(src[y1 * iw + x0], src[y1 * iw + x1], tx);
+            let c = |i: usize| (top[i] + (bottom[i] - top[i]) * ty).round().clamp(0.0, 255.0) as u8;
+            out[y * cw + x] = Color::rgba(c(0), c(1), c(2), c(3));
+        }
+    }
+    Image::from_data(crop_w, crop_h, out).unwrap_or_else(|| Image::new(0, 0))
+}
+
 struct UiLayout {
     s_u: u32,
     s_i: i32,
