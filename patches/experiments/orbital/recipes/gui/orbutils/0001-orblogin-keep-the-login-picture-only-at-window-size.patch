+        .roi(&Rect::new(0, 0, bg_w, bg_h))
+        .draw(window, scaled_image.x, scaled_image.y);
 
     let x = (window.width() as i32 - 216 * s_i) / 2;
     let y = (window.height() as i32 - 164 * s_i) / 2;
