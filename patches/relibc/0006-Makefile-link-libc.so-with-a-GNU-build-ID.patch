From d5187a2344c2fe3839a51761f6f80ac61caa0082 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Tue, 27 Oct 2026 07:21:06 +0100
Subject: [PATCH] Makefile: link libc.so with a GNU build ID

The build ID is a hash of the linked contents: the same code always gets
the same ID, and readelf -n or the build manifest tell which libc.so a
system runs (redox-rpi docs/versioning.md).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Makefile | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Makefile b/Makefile
index 4534cf8..f67f7af 100644
--- a/Makefile
+++ b/Makefile
@@ -148,6 +148,7 @@ $(BUILD)/$(PROFILE)/libc.so: $(BUILD)/$(PROFILE)/ld_so.o $(BUILD)/$(PROFILE)/lib
 		-Wl,--sort-common \
 		-Wl,--whole-archive $^ -Wl,--no-whole-archive \
 		-Wl,-soname,libc.so.6 \
+		-Wl,--build-id=sha1 \
 		$(LINKFLAGS) \
 		-o $@
 
