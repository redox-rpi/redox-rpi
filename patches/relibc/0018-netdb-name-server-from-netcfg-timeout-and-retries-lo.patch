     let dns_addr = parse_ipv4_string(&dns_string).ok_or(Errno(EINVAL))?;
 
+    // A name without a dot is tried in the local domain first (DHCP option
+    // 15, e.g. "homenodellm" as "homenodellm.fritz.box"), then as it is. A
+    // trailing dot means the name is complete.
+    let mut names = Vec::new();
+    if let Some(full) = host.strip_suffix('.') {
+        names.push(full.to_string());
+    } else {
+        if !host.contains('.') {
+            if let Ok(domain) = get_search_domain() {
+                let domain = domain.trim();
+                if !domain.is_empty() {
+                    names.push(format!("{host}.{domain}"));
+                }
+            }
+        }
+        names.push(host.to_string());
+    }
+
+    let mut error = None;
+    for name in names {
+        match query(dns_addr, name, 0x0001) {
+            Ok(response) => {
+                let addrs: Vec<_> = response
+                    .answers
+                    .into_iter()
+                    .filter_map(|answer| {
+                        if answer.a_type == 0x0001 && answer.a_class == 0x0001 && answer.data.len() == 4
+                        {
+                            Some(in_addr {
+                                s_addr: u32::from_ne_bytes([
+                                    answer.data[0],
+                                    answer.data[1],
+                                    answer.data[2],
+                                    answer.data[3],
+                                ]),
+                            })
+                        } else {
+                            None
+                        }
+                    })
+                    .collect();
+                if !addrs.is_empty() {
+                    return Ok(addrs);
+                }
+            }
+            Err(err) => error = Some(err),
+        }
+    }
+    match error {
+        Some(err) => Err(err),
+        None => Ok(Vec::new()),
+    }
+}
+
+/// How long to wait for the name server's reply, per try. Without a
+/// timeout a lost reply (or a server that never answers, like a public
+/// resolver asked for "fritz.box") blocked the caller for good
+/// (redox-rpi #290).
+const QUERY_TIMEOUTS_MS: [i64; 3] = [1000, 2000, 3000];
+
+/// Sends one query to the name server and waits for the reply with the
+/// same transaction id, asking again after each timeout.
+fn query(dns_addr: u32, name: String, q_type: u16) -> Result<Dns, Errno> {
     let mut timespec = timespec::default();
     Sys::clock_gettime(
         time::constants::CLOCK_REALTIME,
@@ -44,13 +111,12 @@ pub fn lookup_host(host: &str) -> Result<LookupHost, Errno> {
         transaction_id: tid,
         flags: 0x0100,
         queries: vec![DnsQuery {
-            name: host.to_string(),
-            q_type: 0x0001,
+            name,
+            q_type,
             q_class: 0x0001,
         }],
         answers: vec![],
     };
-
     let packet_data = packet.compile();
 
     let mut dest = [0_u8; size_of::<sockaddr_in>()];
@@ -62,110 +128,63 @@ pub fn lookup_host(host: &str) -> Result<LookupHost, Errno> {
     };
 
     let sock = Sys::socket(AF_INET, SOCK_DGRAM, i32::from(IPPROTO_UDP))?;
-    let _ = Sys::connect(sock, &dest)?;
-    Sys::sendto(sock, &packet_data, 0, None)?;
+    let result = (|| {
+        Sys::connect(sock, &dest)?;
+        let mut buf = vec![0u8; 65536];
+        for timeout_ms in QUERY_TIMEOUTS_MS {
+            let timeout = timeval {
+                tv_sec: (timeout_ms / 1000) as _,
+                tv_usec: ((timeout_ms % 1000) * 1000) as _,
+            };
+            // SAFETY: timeval is plain data (repr(C), impl Plain).
+            let timeout = unsafe { plain::as_bytes(&timeout) };
+            Sys::setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, timeout)?;
+            Sys::sendto(sock, &packet_data, 0, None)?;
+            // Replies to an earlier query (another id) are skipped; a
+            // timeout or error ends this try.
+            while let Ok((count, _)) = Sys::recvfrom(sock, Out::from_mut(&mut buf), 0, None) {
+                if let Ok(response) = Dns::parse(&buf[..count]) {
+                    if response.transaction_id == tid {
+                        return Ok(response);
+                    }
+                }
+            }
+        }
+        Err(Errno(ETIMEDOUT))
+    })();
+    let _ = Sys::close(sock);
+    result
+}
 
