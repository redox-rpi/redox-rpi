From bcb9c988b0064857fe64ae1c8c16beaee6374472 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.xyz>
Date: Wed, 11 Nov 2026 15:27:44 +0000
Subject: [PATCH] netdb: name server from netcfg, timeout and retries, local
 domain

Name lookups read /etc/net/dns only, so the name server from DHCP was
never used and local names like "fritz.box" did not resolve; a server
that never answered blocked the caller for good (redox-rpi #290).

- The name server comes from /scheme/netcfg/resolv/nameserver (DHCP,
  else the default netstack took from /etc/net/dns); /etc/net/dns only
  when netcfg gives none.
- Each query waits 1, 2 and 3 s for its reply, asking again after each
  timeout, and takes only the reply with its transaction id. The socket
  is closed afterwards (it leaked before).
- A name without a dot is tried in the local domain first
  (/scheme/netcfg/resolv/domain, DHCP option 15), then as it is.
- parse_ipv4_string accepts only numbers: a four-part name like
  "www.example.co.uk" was taken for 0.0.0.0.
---
 src/header/netdb/linux.rs  |  15 +++
 src/header/netdb/lookup.rs | 225 ++++++++++++++++++++-----------------
 src/header/netdb/redox.rs  |  21 +++-
 3 files changed, 156 insertions(+), 105 deletions(-)

diff --git a/src/header/netdb/linux.rs b/src/header/netdb/linux.rs
index 26010511..1a4ad1d1 100644
--- a/src/header/netdb/linux.rs
+++ b/src/header/netdb/linux.rs
@@ -17,3 +17,18 @@ pub fn get_dns_server() -> Result<String, Errno> {
 
     Err(Errno(errno::EIO).sync())
 }
+
+pub fn get_search_domain() -> Result<String, Errno> {
+    let file = File::open(c"/etc/resolv.conf".into(), fcntl::O_RDONLY).map(BufReader::new)?;
+
+    for line in file.lines().map_while(Result::ok) {
+        if let Some(domain) = line
+            .strip_prefix("search ")
+            .or_else(|| line.strip_prefix("domain "))
+        {
+            return Ok(domain.split_whitespace().next().unwrap_or("").into());
+        }
+    }
+
+    Err(Errno(errno::EIO).sync())
+}
