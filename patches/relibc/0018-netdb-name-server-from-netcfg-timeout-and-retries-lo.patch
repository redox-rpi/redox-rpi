+/// The name server netstack uses: from DHCP once there is a lease, else
+/// the image's default. /etc/net/dns only when netstack has none to give
+/// (redox-rpi #290: the DHCP name server was never used, so local names
+/// like "fritz.box" did not resolve).
+pub fn get_dns_server() -> Result<String, Errno> {
+    match read_file(c"/scheme/netcfg/resolv/nameserver") {
+        Ok(server) if !server.trim().is_empty() && server.trim() != "0.0.0.0" => Ok(server),
+        _ => read_file(c"/etc/net/dns"),
+    }
+}
+
+/// The local domain from DHCP (option 15), empty if none.
+pub fn get_search_domain() -> Result<String, Errno> {
+    read_file(c"/scheme/netcfg/resolv/domain")
+}
