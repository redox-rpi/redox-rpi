From: stephan-xyz <stephan@zehrer.xyz>
Date: Mon, 26 Oct 2026 16:55:05 +0100
Subject: [PATCH 3/3] DIAGNOSTIC: dump the stack of a process without filetable
 fd

---
 src/start.rs | 31 ++++++++++++++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/start.rs b/src/start.rs
index 0fb3c8f..0af18fd 100644
--- a/src/start.rs
+++ b/src/start.rs
@@ -180,7 +180,7 @@ pub unsafe extern "C" fn relibc_start_v1(
                     redox_rt::auxv_defs::AT_REDOX_FILETABLE_FD,
                 )
             }
-            .expect("no filetable fd present");
+            .unwrap_or_else(|| unsafe { filetable_missing(sp) });
             let filetable_guard = redox_rt::proc::FdGuard::new(filetable_fd)
                 .to_upper()
                 .expect("failed to move filetable fd to upper table");
@@ -275,3 +275,32 @@ pub unsafe extern "C" fn relibc_start_v1(
 
     unreachable!();
 }
+
+// DIAGNOSTIC (temporary): show what a process that misses its filetable fd
+// sees, through the kernel's register dump of the brk exception.
+#[cfg(all(target_os = "redox", target_arch = "aarch64"))]
+#[cold]
+#[inline(never)]
+unsafe fn filetable_missing(sp: &Stack) -> ! {
+    unsafe {
+        let base = ptr::from_ref(sp).cast::<usize>();
+        let argc = sp.argc() as usize;
+        let envp = sp.envp_raw().cast::<usize>();
+        let mut n = 0;
+        while *envp.add(n) != 0 && n < 4096 {
+            n += 1;
+        }
+        let auxv = envp.add(n + 1);
+        let mut pairs = 0;
+        while pairs < 64 && *auxv.add(2 * pairs) != 0 {
+            pairs += 1;
+        }
+        core::arch::asm!("mov x17, #8", "ldr x16, [x17]", "brk #2",
+            in("x0") base, in("x1") argc, in("x2") n, in("x3") auxv,
+            in("x4") *auxv, in("x5") *auxv.add(1), in("x6") *auxv.add(2),
+            in("x7") *auxv.add(3), in("x9") *auxv.add(4), in("x10") *auxv.add(5),
+            in("x11") pairs, in("x12") *auxv.sub(1), in("x13") *base.add(1),
+            in("x14") *envp, in("x15") sp.envp_raw() as usize,
+            options(noreturn));
+    }
+}
