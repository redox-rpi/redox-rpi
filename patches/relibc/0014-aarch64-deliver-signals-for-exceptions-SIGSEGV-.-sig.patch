+    // aarch64 returns through `svc #0x5352` like the signal entry
+    // (redox-rpi #1): the kernel sets pc and x0 from these fields and clears
+    // INHIBIT_DELIVERY when SIGRETURN_UNINHIBIT is set.
+    #[cfg(target_arch = "aarch64")]
+    {
+        os.control.saved_ip.set(stack.regs.pc);
+        os.control.saved_archdep_reg.set(stack.regs.x0);
+        core::sync::atomic::compiler_fence(Ordering::Release);
+        control_flags.store(
+            (control_flags.load(Ordering::Relaxed) & !SigcontrolFlags::HANDLING_EXCEPTION.bits())
+                | SIGRETURN_UNINHIBIT,
+            Ordering::Relaxed,
+        );
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    {
+        core::sync::atomic::compiler_fence(Ordering::Release);
+        control_flags.store(
+            control_flags.load(Ordering::Relaxed)
+                & !SigcontrolFlags::HANDLING_EXCEPTION.bits()
+                & !SigcontrolFlags::INHIBIT_DELIVERY.bits(),
+            Ordering::Relaxed,
+        );
+    }
 }
 
