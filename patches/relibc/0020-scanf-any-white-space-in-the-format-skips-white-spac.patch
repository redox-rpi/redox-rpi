+2 1 2
diff --git a/tests/stdio/fscanf_newline.c b/tests/stdio/fscanf_newline.c
new file mode 100644
index 0000000..107f8f6
--- /dev/null
+++ b/tests/stdio/fscanf_newline.c
@@ -0,0 +1,18 @@
+//first line
+//	second line
+
+#include <stdio.h>
+int main() {
+    // "\n" in the format skips white space like " " does, so each call
+    // reads the next line (tuxtype reads its word lists this way).
+    FILE *f = fopen("stdio/fscanf_newline.c", "r");
+    char line[256];
+    int i;
+    for (i = 0; i < 3; i++) {
+        int n = fscanf(f, "%[^\n]\n", line);
+        printf("%d %s\n", n, line);
+    }
+    int a, b;
+    int n = sscanf("1\n\t 2", "%d\n%d", &a, &b);
+    printf("%d %d %d\n", n, a, b);
+}
