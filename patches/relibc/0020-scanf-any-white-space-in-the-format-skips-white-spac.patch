From f1aaab2b77289a3e6ac1b9ab7099769b2b111377 Mon Sep 17 00:00:00 2001
From: stephan-xyz <stephan@zehrer.net>
Date: Tue, 17 Nov 2026 00:02:06 +0000
Subject: [PATCH] scanf: any white space in the format skips white space, not
 only a space

POSIX: a directive of one or more white-space characters reads input
up to the first non-white-space character. scanf only did that for
" ". A "\n" or "\t" in the format was matched as a literal, and the
matched character stayed unread, so a loop over
fscanf(f, "%[^\n]\n", line) returned 0 and the same line forever
(Tux Typing hangs reading keyboard.lst this way).

Test: tests/stdio/fscanf_newline.c, same output as glibc.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/header/stdio/scanf.rs                  |  4 +++-
 tests/Makefile                             |  1 +
 tests/Makefile.tests.mk                    |  1 +
 tests/expected/stdio/fscanf_newline.stdout |  4 ++++
 tests/stdio/fscanf_newline.c               | 18 ++++++++++++++++++
 5 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 tests/expected/stdio/fscanf_newline.stdout
 create mode 100644 tests/stdio/fscanf_newline.c

diff --git a/src/header/stdio/scanf.rs b/src/header/stdio/scanf.rs
index 7b6c3aa..8a30451 100644
--- a/src/header/stdio/scanf.rs
+++ b/src/header/stdio/scanf.rs
@@ -80,7 +80,9 @@ pub unsafe fn inner_scanf<T: Kind>(
     while format.peek().is_some() {
         let mut c = next_char(&mut format)?;
 
-        if c == ' ' {
+        // Any white-space character in the format (space, newline, tab, ...)
+        // skips white space in the input, not only a space (POSIX).
+        if c.is_ascii_whitespace() {
             maybe_read!(noreset);
 
             while (character).is_whitespace() {
