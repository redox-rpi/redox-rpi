+/// Consecutive small writes to one handle, not yet written.
+///
+/// Every write is its own transaction, and a transaction rewrites the whole
+/// record it touches (up to `RECORD_SIZE`, 128 KiB) plus the node, the tree
+/// path to it, the allocator log and the header. Writing a file in 4 KiB
+/// calls this way sends about 28 times the data to the disk. Collecting the
+/// calls and writing whole records brings that close to 1.
+struct PendingWrite {
+    id: usize,
+    /// Where the next write of the run must start to join it.
+    offset: u64,
+    /// Data from `offset - data.len()` on, not yet written.
+    data: Vec<u8>,
+}
+
 pub struct FileScheme<'sock, D: Disk> {
     scheme_name: RedoxScheme<'sock>,
     mounted_path: String,
@@ -97,6 +112,11 @@ pub struct FileScheme<'sock, D: Disk> {
     other_scheme_fd_map: BTreeMap<u32, Fd>,
 
     proc_creds_capability: Fd,
+
+    pending: Option<PendingWrite>,
+    /// A failed write of collected data, reported by the next `write` or
+    /// `fsync` of that handle.
+    pending_error: Option<(usize, Error)>,
 }
 
 impl<'sock, D: Disk> FileScheme<'sock, D> {
@@ -123,9 +143,48 @@ impl<'sock, D: Disk> FileScheme<'sock, D> {
                     0,
                 )?
             },
+            pending: None,
+            pending_error: None,
         })
     }
 
+    /// Write the collected data of the current run, if any. The run itself
+    /// goes on, so the next consecutive write still joins it.
+    pub fn flush_pending(&mut self) {
+        let Some(pending) = self.pending.as_mut() else {
+            return;
+        };
+        if pending.data.is_empty() {
+            return;
+        }
+        let data = mem::take(&mut pending.data);
+        let id = pending.id;
+        let offset = pending.offset - data.len() as u64;
+        let result = match Handle::get_resource_mut(self.handles.get_mut(&id)) {
+            Ok(file) => self
+                .fs
+                .tx(|tx| file.write(&mut self.fmap, &data, offset, tx))
+                .and_then(|n| if n == data.len() { Ok(()) } else { Err(Error::new(EIO)) }),
+            Err(err) => Err(err),
+        };
+        if let Err(err) = result {
+            log::error!("failed to write {} bytes at {} of handle {}: {}", data.len(), offset, id, err);
+            self.pending = None;
+            self.pending_error = Some((id, err));
+        }
+    }
+
+    /// The error of a failed write of collected data for handle `id`.
+    fn take_pending_error(&mut self, id: usize) -> Result<()> {
+        match self.pending_error {
+            Some((err_id, err)) if err_id == id => {
+                self.pending_error = None;
+                Err(err)
+            }
+            _ => Ok(()),
+        }
+    }
+
     /// Resolve a symbolic link of given `node`. `full_path` must be non-canonicalized path from root node.
     fn resolve_symlink<'a>(
         scheme_name: &RedoxScheme<'sock>,
@@ -946,8 +1005,37 @@ impl<'sock, D: Disk> SchemeSync for FileScheme<'sock, D> {
         _ctx: &CallerCtx,
     ) -> Result<usize> {
         // println!("Write {}, {:X} {}", id, buf.as_ptr() as usize, buf.len());
+        self.take_pending_error(id)?;
+
+        // Join the current run: the handle wrote just before this offset.
+        let small = (buf.len() as u64) < RECORD_SIZE;
+        if let Some(pending) = self.pending.as_mut() {
+            if small && pending.id == id && pending.offset == offset {
+                pending.data.extend_from_slice(buf);
+                pending.offset += buf.len() as u64;
+                // Write when a record is complete or enough has come together.
+                if pending.offset % RECORD_SIZE == 0 || pending.data.len() as u64 >= RECORD_SIZE {
+                    self.flush_pending();
+                    self.take_pending_error(id)?;
+                }
+                return Ok(buf.len());
+            }
+        }
+        self.flush_pending();
+        self.pending = None;
+
+        // The first write of a run goes to the disk at once, so its errors
+        // (no write access, a directory) come back to the caller.
         let file = Handle::get_resource_mut(self.handles.get_mut(&id))?;
-        self.fs.tx(|tx| file.write(&mut self.fmap, buf, offset, tx))
+        let written = self.fs.tx(|tx| file.write(&mut self.fmap, buf, offset, tx))?;
+        if small && written == buf.len() {
+            self.pending = Some(PendingWrite {
+                id,
+                offset: offset + written as u64,
+                data: Vec::new(),
+            });
+        }
+        Ok(written)
     }
 
     fn fsize(&mut self, id: usize, _ctx: &CallerCtx) -> Result<u64> {
@@ -1092,6 +1180,7 @@ impl<'sock, D: Disk> SchemeSync for FileScheme<'sock, D> {
 
