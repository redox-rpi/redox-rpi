+        self.take_pending_error(id)?;
         let file = Handle::get_resource_mut(self.handles.get_mut(&id))?;
         let fmaps = &mut self.fmap;
 
@@ -1148,6 +1237,13 @@ impl<'sock, D: Disk> SchemeSync for FileScheme<'sock, D> {
     }
 
