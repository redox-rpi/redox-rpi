+    // Without the timer, collected writes wait for the next request.
+    let mut wakeup = match Wakeup::open() {
+        Ok(wakeup) => Some(wakeup),
+        Err(err) => {
+            log::warn!("no timer for collected writes: {}", err);
+            None
+        }
+    };
     let socket = Socket::create()?;
 
     let scheme_name = format!("{}", mountpoint.display());
@@ -37,10 +131,38 @@ where
         &mut scheme,
     )?;
 
+    // The timer also has to see when a request comes in.
+    if let Some(waker) = wakeup.as_mut() {
+        if let Err(err) = waker.watch(socket.inner().raw()) {
+            log::warn!("no timer for collected writes: {}", err);
+            wakeup = None;
+        }
+    }
+
     let res = callback(Path::new(&mounted_path));
 
     while IS_UMT.load(Ordering::SeqCst) == 0 {
-        let req = match socket.next_request(SignalBehavior::Restart)? {
+        // With collected data waiting, look for a request without blocking,
+        // so the data can still go out in time when none comes.
+        let pending = wakeup.is_some().then(|| scheme.pending_since()).flatten();
+        let next = match pending {
+            Some(since) => match try_next_request(&socket) {
+                Ok(Some(next)) => next,
+                Ok(None) => {
+                    let due = since + FLUSH_AFTER;
+                    if Instant::now() >= due {
+                        scheme.flush_pending();
+                    } else if let Some(wakeup) = wakeup.as_mut() {
+                        wakeup.arm(due);
+                        wakeup.wait()?;
+                    }
+                    continue;
+                }
+                Err(err) => return Err(err),
+            },
+            None => socket.next_request(SignalBehavior::Restart)?,
+        };
+        let req = match next {
             None => break,
             Some(req) => {
                 match req.kind() {
@@ -82,11 +204,15 @@ where
         let caller = req.caller();
         let response = match req.op() {
             Ok(op) => {
-                let flush = match &op {
-                    Op::Write(_) => false,
-                    Op::Read(read) => scheme.read_needs_flush(read.fd),
-                    _ => true,
-                };
+                let due = scheme
+                    .pending_since()
+                    .is_some_and(|since| since.elapsed() >= FLUSH_AFTER);
+                let flush = due
+                    || match &op {
+                        Op::Write(_) => false,
+                        Op::Read(read) => scheme.read_needs_flush(read.fd),
+                        _ => true,
+                    };
                 if flush {
                     scheme.flush_pending();
                 }
