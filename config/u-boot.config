# Additions to U-Boot's rpi_arm64_defconfig, merged by scripts/build-uboot.sh.

# Network boot: DHCP, TFTP and HTTP (wget) over the Pi 3B+ onboard Ethernet
# (LAN7800) and common USB Ethernet chips on HATs. The lwIP network stack has
# the reliable wget; rpi_arm64_defconfig already uses it, qemu_arm64 not.
CONFIG_NET_LWIP=y
CONFIG_CMD_WGET=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_USB_ETHER_LAN78XX=y
CONFIG_USB_ETHER_SMSC95XX=y
CONFIG_USB_ETHER_RTL8152=y
CONFIG_USB_ETHER_ASIX=y

# Expose an image loaded into RAM as a block device, so the Redox bootloader
# can boot an image fetched over the network.
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y

# Boot menu (#243, config/bootmenu.cmd): on HDMI and serial, keys from a USB
# keyboard or the serial console.
CONFIG_CMD_BOOTMENU=y
# U-Boot tries the EFI boot manager before any boot script, and it starts a
# card's EFI/BOOT/BOOTAA64.EFI on its own, so the menu in the card's
# boot.scr would never show. Redox sets no EFI boot variables; without the
# boot manager U-Boot runs boot.scr first and EFI/BOOT/BOOTAA64.EFI after it.
# CONFIG_BOOTMETH_EFI_BOOTMGR is not set
