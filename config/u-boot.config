# Additions to U-Boot's rpi_arm64_defconfig, merged by scripts/build-uboot.sh.

# Network boot: DHCP, TFTP and HTTP (wget) over the Pi 3B+ onboard Ethernet
# (LAN7800) and common USB Ethernet chips on HATs. The lwIP network stack has
# the reliable wget; rpi_arm64_defconfig already uses it, qemu_arm64 not.
CONFIG_NET_LWIP=y
CONFIG_CMD_WGET=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_USB_ETHER_LAN78XX=y
CONFIG_USB_ETHER_SMSC95XX=y
CONFIG_USB_ETHER_RTL8152=y
CONFIG_USB_ETHER_ASIX=y

# Expose an image loaded into RAM as a block device, so the Redox bootloader
# can boot an image fetched over the network.
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y

# The environment (saveenv) in uboot.env on the card's first partition.
# The default "0:1" does not exist on our Pis: config.txt has dtoverlay=mmc,
# which disables the sdhost controller that the devicetree's alias mmc0
# names, and the SD card on the other controller (alias "mmc", no number)
# becomes mmc 2. U-Boot then printed "Bad device specification mmc 0" at
# every boot and could not save settings.
CONFIG_ENV_FAT_DEVICE_AND_PART="2:1"
