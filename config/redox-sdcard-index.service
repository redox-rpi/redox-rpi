# Started by redox-sdcard-index.path; see there.
[Unit]
Description=Rewrite the redox-rpi SD image index.json

[Service]
Type=oneshot
# sdcard-index.py writes only when the index changes, so its own write
# does not start it again for ever.
ExecStart=/bin/bash -c '%h/redox-rpi-stable/scripts/pi-tests-queue.sh > /tmp/redox-sdcard-plan.md 2>/dev/null; exec python3 %h/redox-rpi-stable/scripts/sdcard-index.py /srv/tftp/sdcard /tmp/redox-sdcard-plan.md'
